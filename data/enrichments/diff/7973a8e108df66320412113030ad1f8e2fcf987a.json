{"id":"7973a8e108df66320412113030ad1f8e2fcf987a","axis":"silent","repo":"comet-ml/comet-llm","sha":"7973a8e108df66320412113030ad1f8e2fcf987a","parsed":{"files":[{"path":"apps/opik-documentation/documentation/fern/docs-v2/administration/workspace-settings/ai_providers.mdx","lines":["@@ -295,7 +295,7 @@ Opik connects to [Ollama](https://ollama.com/) using the OpenAI-compatible API,","    - **Provider name**: A name for this instance (e.g., \"Ollama local\")","    - **URL**: Base URL of your Ollama instance, ending with `/v1` (e.g., `http://localhost:11434/v1`)","    - **API Key** (optional): Leave blank unless your Ollama instance requires authentication","-   - Use **\"Test connection\"** to verify Opik can reach the instance, then **\"Discover models\"** to load the model list","+   - Click **Connect**: Opik checks that it can reach the instance and loads its model list"," 5. Click **Save** to store the configuration"," "," You can configure multiple Ollama instances with different provider names and URLs."],"additions":1,"deletions":1,"truncated":false},{"path":"apps/opik-frontend/src/constants/explainers.ts","lines":["@@ -318,9 +318,8 @@ export const EXPLAINERS_MAP: Record<EXPLAINER_ID, Explainer> = {","   },","   [EXPLAINER_ID.whats_these_configuration_things]: {","     id: EXPLAINER_ID.whats_these_configuration_things,","-    title: \"Model parameters\",","     description:","-      \"The model configuration parameters allow you to control output behavior. Tuning these lets you balance between deterministic answers and more diverse, exploratory outputs.\",","+      \"Settings sent to the model on every run. They shape the answer, for example how long or how varied it is.\",","   },","   [EXPLAINER_ID.why_do_i_need_an_ai_provider]: {","     id: EXPLAINER_ID.why_do_i_need_an_ai_provider,"],"additions":1,"deletions":2,"truncated":false},{"path":"apps/opik-frontend/src/shared/SliderInputControl/SliderInputControl.tsx","lines":["@@ -4,6 +4,7 @@ import { Info, RotateCcw } from \"lucide-react\";"," import { Input } from \"@/ui/input\";"," import toNumber from \"lodash/toNumber\";"," import { Slider } from \"@/ui/slider\";","+import { cn } from \"@/lib/utils\";"," import React, { useEffect, useState } from \"react\";"," import TooltipWrapper, {","   TooltipWrapperProps,","@@ -107,8 +108,16 @@ const SliderInputControl = ({","         </div>"," ","         <div className=\"flex items-center\">","-          {!resetDisabled && (value ?? defaultValue) !== defaultValue && (","-            <Button variant=\"minimal\" size=\"icon-sm\" onClick={handleResetValue}>","+          {!resetDisabled && (","+            <Button","+              type=\"button\"","+              variant=\"minimal\"","+              size=\"icon-sm\"","+              onClick={handleResetValue}","+              className={cn({","+                invisible: (value ?? defaultValue) === defaultValue,","+              })}","+            >","               <RotateCcw />","             </Button>","           )}"],"additions":11,"deletions":2,"truncated":false},{"path":"apps/opik-frontend/src/ui/arrow-scroll-area.test.tsx","lines":["@@ -0,0 +1,328 @@","+import { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";","+import { act, fireEvent, render, screen } from \"@testing-library/react\";","+","+import { ArrowScrollArea } from \"./arrow-scroll-area\";","+","+const VIEWPORT_HEIGHT = 200;","+const CONTENT_HEIGHT = 1000;","+const MAX_SCROLL_TOP = CONTENT_HEIGHT - VIEWPORT_HEIGHT;","+","+// happy-dom has no layout engine, so the heights the component reads are stubbed.","+const stubHeights = (contentHeight: number) => {","+  vi.spyOn(Element.prototype, \"scrollHeight\", \"get\").mockReturnValue(","+    contentHeight,","+  );","+  vi.spyOn(HTMLElement.prototype, \"clientHeight\", \"get\").mockReturnValue(","+    VIEWPORT_HEIGHT,","+  );","+};","+","+const renderArea = () => {","+  render(","+    <ArrowScrollArea>","+      <div>Rows</div>","+    </ArrowScrollArea>,","+  );","+  return screen.getByTestId(\"arrow-scroll-viewport\");","+};","+","+const scrollViewportTo = (viewport: HTMLElement, scrollTop: number) => {","+  viewport.scrollTop = scrollTop;","+  fireEvent.scroll(viewport);","+};","+","+// happy-dom's ResizeObserver never calls back, so this one lets a test fire it.","+const stubResizeObserver = () => {","+  const callbacks: ResizeObserverCallback[] = [];","+  vi.stubGlobal(","+    \"ResizeObserver\",","+    class {","+      constructor(callback: ResizeObserverCallback) {","+        callbacks.push(callback);","+      }","+      observe() {}","+      disconnect() {}","+    },","+  );","+  return () =>","+    callbacks.forEach((callback) => callback([], {} as ResizeObserver));","+};","+","+const upArrow = () => screen.queryByTestId(\"scroll-up-arrow\");","+const downArrow = () => screen.queryByTestId(\"scroll-down-arrow\");","+","+describe(\"ArrowScrollArea\", () => {","+  let scrollBy: ReturnType<typeof vi.fn>;","+","+  beforeEach(() => {","+    // happy-dom runs a smooth scrollBy on a real timer that fake timers can't","+    // advance, so it is replaced by a spy and the hold tests see only the hold.","+    scrollBy = vi.fn();","+    vi.spyOn(Element.prototype, \"scrollBy\").mockImplementation(scrollBy);","+  });","+","+  afterEach(() => {","+    vi.useRealTimers();","+    vi.restoreAllMocks();","+    vi.unstubAllGlobals();","+  });","+","+  describe(\"arrows\", () => {","+    it(\"shows no arrows when the content fits\", () => {","+      stubHeights(VIEWPORT_HEIGHT);","+      renderArea();","+","+      expect(upArrow()).not.toBeInTheDocument();","+      expect(downArrow()).not.toBeInTheDocument();","+    });","+","+    it(\"shows only the down arrow at the top\", () => {","+      stubHeights(CONTENT_HEIGHT);","+      renderArea();","+","+      expect(upArrow()).not.toBeInTheDocument();","+      expect(downArrow()).toBeInTheDocument();","+    });","+","+    it(\"shows both arrows in the middle\", () => {","+      stubHeights(CONTENT_HEIGHT);","+      const viewport = renderArea();","+","+      scrollViewportTo(viewport, MAX_SCROLL_TOP / 2);","+","+      expect(upArrow()).toBeInTheDocument();","+      expect(downArrow()).toBeInTheDocument();","+    });","+","+    it(\"shows only the up arrow at the bottom\", () => {","+      stubHeights(CONTENT_HEIGHT);","+      const viewport = renderArea();","+","+      scrollViewportTo(viewport, MAX_SCROLL_TOP);","+","+      expect(upArrow()).toBeInTheDocument();","+      expect(downArrow()).not.toBeInTheDocument();","+    });","+","+    it(\"treats a fractional scroll position less than a pixel from the end as the bottom\", () => {","+      stubHeights(CONTENT_HEIGHT);","+      const viewport = renderArea();","+","+      scrollViewportTo(viewport, MAX_SCROLL_TOP - 0.5);","+","+      expect(upArrow()).toBeInTheDocument();","+      expect(downArrow()).not.toBeInTheDocument();","+    });","+","+    it(\"keeps the down arrow a full pixel from the end\", () => {","+      stubHeights(CONTENT_HEIGHT);","+      const viewport = renderArea();","+","+      scrollViewportTo(viewport, MAX_SCROLL_TOP - 1);","+","+      expect(downArrow()).toBeInTheDocument();","+    });","+  });","+","+  describe(\"click\", () => {","+    it(\"scrolls down smoothly\", () => {","+      stubHeights(CONTENT_HEIGHT);","+      renderArea();","+","+      fireEvent.pointerDown(downArrow()!);","+      fireEvent.pointerUp(downArrow()!);","+","+      expect(scrollBy).toHaveBeenCalledOnce();","+      expect(scrollBy).toHaveBeenCalledWith({","+        top: expect.toSatisfy((top: number) => top > 0),","+        behavior: \"smooth\",","+      });","+    });","+","+    it(\"scrolls up smoothly\", () => {","+      stubHeights(CONTENT_HEIGHT);","+      const viewport = renderArea();","+      scrollViewportTo(viewport, MAX_SCROLL_TOP);","+","+      fireEvent.pointerDown(upArrow()!);","+      fireEvent.pointerUp(upArrow()!);","+","+      expect(scrollBy).toHaveBeenCalledOnce();","+      expect(scrollBy).toHaveBeenCalledWith({","+        top: expect.toSatisfy((top: number) => top < 0),","+        behavior: \"smooth\",","+      });","+    });","+","+    it(\"does not keep scrolling after a quick click\", () => {","+      vi.useFakeTimers();","+      stubHeights(CONTENT_HEIGHT);","+      const viewport = renderArea();","+","+      fireEvent.pointerDown(downArrow()!);","+      fireEvent.pointerUp(downArrow()!);","+      act(() => {","+        vi.advanceTimersByTime(1000);","+      });","+","+      expect(viewport.scrollTop).toBe(0);","+    });","+  });","+","+  describe(\"press and hold\", () => {","+    it(\"keeps scrolling while held and stops on release\", () => {","+      vi.useFakeTimers();","+      stubHeights(CONTENT_HEIGHT);","+      const viewport = renderArea();","+","+      fireEvent.pointerDown(downArrow()!);","+      act(() => {","+        vi.advanceTimersByTime(500);","+      });","+      const scrollTopAfterHalfSecond = viewport.scrollTop;","+      act(() => {","+        vi.advanceTimersByTime(500);","+      });","+      const scrollTopAfterOneSecond = viewport.scrollTop;","+      fireEvent.pointerUp(downArrow()!);","+      act(() => {","+        vi.advanceTimersByTime(1000);","+      });","+","+      expect(scrollTopAfterHalfSecond).toBeGreaterThan(0);","+      expect(scrollTopAfterOneSecond).toBeGreaterThan(scrollTopAfterHalfSecond);","+      expect(viewport.scrollTop).toBe(scrollTopAfterOneSecond);","+    });","+","+    it(\"scrolls up while the up arrow is held\", () => {","+      vi.useFakeTimers();","+      stubHeights(CONTENT_HEIGHT);","+      const viewport = renderArea();","+      scrollViewportTo(viewport, MAX_SCROLL_TOP);","+","+      fireEvent.pointerDown(upArrow()!);","+      act(() => {","+        vi.advanceTimersByTime(1000);","+      });","+","+      expect(viewport.scrollTop).toBeLessThan(MAX_SCROLL_TOP);","+    });","+","+    it(\"stops when the pointer leaves the arrow\", () => {","+      vi.useFakeTimers();","+      stubHeights(CONTENT_HEIGHT);","+      const viewport = renderArea();","+","+      fireEvent.pointerDown(downArrow()!);","+      act(() => {","+        vi.advanceTimersByTime(1000);","+      });","+      fireEvent.pointerLeave(downArrow()!);","+      const scrollTopOnLeave = viewport.scrollTop;","+      act(() => {","+        vi.advanceTimersByTime(1000);","+      });","+","+      expect(viewport.scrollTop).toBe(scrollTopOnLeave);","+    });","+","+    it(\"stops scrolling at the end of the list while still held\", () => {","+      vi.useFakeTimers();","+      stubHeights(CONTENT_HEIGHT);","+      const viewport = renderArea();","+","+      fireEvent.pointerDown(downArrow()!);","+      act(() => {","+        vi.advanceTimersByTime(5000);","+      });","+      const scrollTopAtEnd = viewport.scrollTop;","+      act(() => {","+        vi.advanceTimersByTime(1000);","+      });","+","+      expect(scrollTopAtEnd).toBeGreaterThanOrEqual(MAX_SCROLL_TOP);","+      expect(viewport.scrollTop).toBe(scrollTopAtEnd);","+    });","+","+    it(\"stops scrolling at the top of the list while the up arrow is still held\", () => {","+      vi.useFakeTimers();","+      stubHeights(CONTENT_HEIGHT);","+      const viewport = renderArea();","+      scrollViewportTo(viewport, MAX_SCROLL_TOP / 2);","+","+      fireEvent.pointerDown(upArrow()!);","+      act(() => {","+        vi.advanceTimersByTime(5000);","+      });","+      const scrollTopAtTop = viewport.scrollTop;","+      act(() => {","+        vi.advanceTimersByTime(1000);","+      });","+","+      expect(scrollTopAtTop).toBeLessThanOrEqual(0);","+      expect(viewport.scrollTop).toBe(scrollTopAtTop);","+    });","+","+    it(\"does not move a held arrow from a fractional bottom\", () => {","+      vi.useFakeTimers();","+      stubHeights(CONTENT_HEIGHT);","+      const viewport = renderArea();","+      scrollViewportTo(viewport, MAX_SCROLL_TOP - 2);","+","+      fireEvent.pointerDown(downArrow()!);","+      scrollViewportTo(viewport, MAX_SCROLL_TOP - 0.5);","+      act(() => {","+        vi.advanceTimersByTime(1000);","+      });","+","+      expect(viewport.scrollTop).toBe(MAX_SCROLL_TOP - 0.5);","+    });","+","+    it.each([","+      {","+        when: \"after the end scroll event fired\",","+        endScrollEventFired: true,","+      },","+      {","+        when: \"when the end scroll event did not fire\",","+        endScrollEventFired: false,","+      },","+    ])(","+      \"resumes when the list grows under an arrow held at the end, $when\",","+      ({ endScrollEventFired }) => {","+        vi.useFakeTimers();","+        const fireResize = stubResizeObserver();","+        stubHeights(CONTENT_HEIGHT);","+        const viewport = renderArea();","+","+        fireEvent.pointerDown(downArrow()!);","+        act(() => {","+          vi.advanceTimersByTime(5000);","+        });","+        // A browser fires this scroll event as the hold reaches the end, unless the list grows","+        // first; happy-dom never fires it.","+        if (endScrollEventFired) fireEvent.scroll(viewport);","+        const scrollTopAtEnd = viewport.scrollTop;","+        stubHeights(2 * CONTENT_HEIGHT);","+        act(() => fireResize());","+        act(() => {","+          vi.advanceTimersByTime(1000);","+        });","+","+        expect(viewport.scrollTop).toBeGreaterThan(scrollTopAtEnd);","+      },","+    );","+","+    it(\"keeps a held arrow at the end of the list until release\", () => {","+      stubHeights(CONTENT_HEIGHT);","+      const viewport = renderArea();","+","+      fireEvent.pointerDown(downArrow()!);","+      scrollViewportTo(viewport, MAX_SCROLL_TOP);","+      expect(downArrow()).toBeInTheDocument();","+","+      fireEvent.pointerUp(downArrow()!);","+      expect(downArrow()).not.toBeInTheDocument();","+    });","+  });","+});"],"additions":328,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/ui/arrow-scroll-area.tsx","lines":["@@ -0,0 +1,152 @@","+import * as React from \"react\";","+import { ChevronDown, ChevronUp } from \"lucide-react\";","+","+import { cn } from \"@/lib/utils\";","+","+const CLICK_SCROLL_PX = 120;","+const HOLD_DELAY_MS = 300;","+const HOLD_SCROLL_PX_PER_MS = 0.5;","+","+type ScrollDirection = \"up\" | \"down\";","+","+const SCROLL_SIGN: Record<ScrollDirection, number> = { up: -1, down: 1 };","+","+// scrollTop can be fractional while scrollHeight and clientHeight are whole","+// pixels, so at the very bottom a raw comparison would still see room left.","+const canScroll = (viewport: HTMLElement, direction: ScrollDirection) =>","+  direction === \"up\"","+    ? viewport.scrollTop > 0","+    : Math.ceil(viewport.scrollTop) <","+      viewport.scrollHeight - viewport.clientHeight;","+","+interface ScrollArrowProps {","+  direction: ScrollDirection;","+  onPress: (direction: ScrollDirection) => void;","+  onRelease: () => void;","+}","+","+const ScrollArrow: React.FC<ScrollArrowProps> = ({","+  direction,","+  onPress,","+  onRelease,","+}) => {","+  const Icon = direction === \"up\" ? ChevronUp : ChevronDown;","+","+  return (","+    <div","+      aria-hidden","+      data-testid={`scroll-${direction}-arrow`}","+      className={cn(","+        \"absolute inset-x-0 flex h-6 cursor-default items-center justify-center bg-background\",","+        direction === \"up\" ? \"top-0\" : \"bottom-0\",","+      )}","+      onPointerDown={() => onPress(direction)}","+      onPointerUp={onRelease}","+      onPointerLeave={onRelease}","+      onPointerCancel={onRelease}","+    >","+      <Icon className=\"size-3.5\" />","+    </div>","+  );","+};","+","+interface ArrowScrollAreaProps {","+  className?: string;","+  children?: React.ReactNode;","+}","+","+const ArrowScrollArea: React.FC<ArrowScrollAreaProps> = ({","+  className,","+  children,","+}) => {","+  const viewportRef = React.useRef<HTMLDivElement>(null);","+  const contentRef = React.useRef<HTMLDivElement>(null);","+  const [canScrollUp, setCanScrollUp] = React.useState(false);","+  const [canScrollDown, setCanScrollDown] = React.useState(false);","+  const [heldDirection, setHeldDirection] =","+    React.useState<ScrollDirection | null>(null);","+","+  const updateArrows = React.useCallback(() => {","+    const viewport = viewportRef.current;","+    if (!viewport) return;","+","+    setCanScrollUp(canScroll(viewport, \"up\"));","+    setCanScrollDown(canScroll(viewport, \"down\"));","+  }, []);","+","+  React.useLayoutEffect(() => {","+    const viewport = viewportRef.current;","+    const content = contentRef.current;","+    if (!viewport || !content) return;","+","+    updateArrows();","+    const observer = new ResizeObserver(updateArrows);","+    observer.observe(viewport);","+    observer.observe(content);","+    return () => observer.disconnect();","+  }, [updateArrows]);","+","+  React.useEffect(() => {","+    const viewport = viewportRef.current;","+    if (!heldDirection || !viewport) return;","+","+    let frame = 0;","+    let previousTime: number | undefined;","+    // The loop keeps running at the end of the list so that it moves on when the","+    // list grows under the held arrow. Restarting it from the arrow state instead","+    // misses growth that lands before a scroll event reports the end.","+    const scrollWhileHeld = (time: number) => {","+      if (previousTime !== undefined && canScroll(viewport, heldDirection)) {","+        viewport.scrollTop +=","+          SCROLL_SIGN[heldDirection] *","+          HOLD_SCROLL_PX_PER_MS *","+          (time - previousTime);","+      }","+      previousTime = time;","+      frame = requestAnimationFrame(scrollWhileHeld);","+    };","+    const holdTimer = window.setTimeout(() => {","+      frame = requestAnimationFrame(scrollWhileHeld);","+    }, HOLD_DELAY_MS);","+","+    return () => {","+      window.clearTimeout(holdTimer);","+      cancelAnimationFrame(frame);","+    };","+  }, [heldDirection]);","+","+  const press = (direction: ScrollDirection) => {","+    viewportRef.current?.scrollBy({","+      top: SCROLL_SIGN[direction] * CLICK_SCROLL_PX,","+      behavior: \"smooth\",","+    });","+    setHeldDirection(direction);","+  };","+","+  const release = () => setHeldDirection(null);","+","+  // A held arrow stays until release even at the end of the list: Radix Select","+  // picks whatever item a pointer is released over, so a vanished arrow would","+  // turn the release into a selection.","+  const renderArrow = (direction: ScrollDirection, canScroll: boolean) =>","+    (canScroll || heldDirection === direction) && (","+      <ScrollArrow direction={direction} onPress={press} onRelease={release} />","+    );","+","+  return (","+    <div className={cn(\"relative flex min-h-0 flex-col\", className)}>","+      <div","+        ref={viewportRef}","+        data-testid=\"arrow-scroll-viewport\"","+        className=\"min-h-0 flex-1 scroll-py-6 overflow-y-auto\"","+        onScroll={updateArrows}","+      >","+        <div ref={contentRef}>{children}</div>","+      </div>","+      {renderArrow(\"up\", canScrollUp)}","+      {renderArrow(\"down\", canScrollDown)}","+    </div>","+  );","+};","+","+export { ArrowScrollArea };"],"additions":152,"deletions":0,"truncated":false},{"path":"apps/opik-frontend/src/v2/pages-shared/llm/ManageAIProviderDialog/OllamaProviderDetails.tsx","lines":["@@ -314,8 +314,8 @@ const OllamaProviderDetails: React.FC<OllamaProviderDetailsProps> = ({","               </FormControl>","               <FormMessage />","               <Description>","-                Comma-separated list of available models. Use &ldquo;Discover","-                Models&rdquo; to auto-populate this field.","+                Comma-separated list of models. Click &ldquo;Connect&rdquo; to","+                fill it with the models found on the instance.","               </Description>","             </FormItem>","           );"],"additions":2,"deletions":2,"truncated":false},{"path":"apps/opik-frontend/src/v2/pages-shared/llm/PromptModelSelect/PromptModelSelect.test.tsx","lines":["@@ -0,0 +1,129 @@","+import { afterEach, beforeEach, describe, expect, it, vi } from \"vitest\";","+import { fireEvent, render, screen, within } from \"@testing-library/react\";","+","+import PromptModelSelect from \"./PromptModelSelect\";","+import {","+  PROVIDER_MODEL_TYPE,","+  PROVIDER_TYPE,","+  ProviderModelsMap,","+  ProviderObject,","+} from \"@/types/providers\";","+import { TooltipProvider } from \"@/ui/tooltip\";","+","+const createProvider = (provider: PROVIDER_TYPE): ProviderObject =>","+  ({","+    id: provider,","+    created_at: \"\",","+    provider,","+    ui_composed_provider: provider,","+    configuration: {},","+    read_only: false,","+  }) as ProviderObject;","+","+const PROVIDERS = [","+  createProvider(PROVIDER_TYPE.OPEN_AI),","+  createProvider(PROVIDER_TYPE.ANTHROPIC),","+];","+","+const PROVIDER_MODELS: ProviderModelsMap = {","+  [PROVIDER_TYPE.OPEN_AI]: [","+    { label: \"GPT-4o\", value: PROVIDER_MODEL_TYPE.GPT_4O },","+    { label: \"GPT-4o Mini\", value: PROVIDER_MODEL_TYPE.GPT_4O_MINI },","+  ],","+  [PROVIDER_TYPE.ANTHROPIC]: [","+    { label: \"Claude Haiku 4.5\", value: PROVIDER_MODEL_TYPE.CLAUDE_HAIKU_4_5 },","+    { label: \"Claude Opus 4.1\", value: PROVIDER_MODEL_TYPE.CLAUDE_OPUS_4_1 },","+  ],","+};","+","+vi.mock(\"@/api/provider-keys/useProviderKeys\", () => ({","+  default: () => ({ data: { content: PROVIDERS } }),","+}));","+vi.mock(\"@/hooks/useLLMProviderModelsData\", () => ({","+  default: () => ({ providerModels: PROVIDER_MODELS }),","+}));","+vi.mock(\"@/contexts/PermissionsContext\", () => ({","+  usePermissions: () => ({ permissions: { canUpdateAIProviders: true } }),","+}));","+vi.mock(","+  \"@/v2/pages-shared/llm/ManageAIProviderDialog/ManageAIProviderDialog\",","+  () => ({ default: () => null }),","+);","+","+const renderPicker = () => {","+  const onChange = vi.fn();","+  render(","+    <TooltipProvider>","+      <PromptModelSelect","+        value=\"\"","+        provider=\"\"","+        workspaceName=\"default\"","+        onChange={onChange}","+      />","+    </TooltipProvider>,","+  );","+  fireEvent.keyDown(screen.getByRole(\"combobox\"), { key: \"Enter\" });","+  return {","+    onChange,","+    listViewport: screen.getByTestId(\"arrow-scroll-viewport\"),","+  };","+};","+","+// happy-dom has no layout engine, so the list is given the heights of an overflowing one.","+const makeOverflow = (listViewport: HTMLElement) => {","+  Object.defineProperty(listViewport, \"scrollHeight\", { value: 1000 });","+  Object.defineProperty(listViewport, \"clientHeight\", { value: 200 });","+  fireEvent.scroll(listViewport);","+};","+","+describe(\"PromptModelSelect\", () => {","+  let scrollBy: ReturnType<typeof vi.fn>;","+","+  beforeEach(() => {","+    scrollBy = vi.fn();","+    vi.spyOn(Element.prototype, \"scrollBy\").mockImplementation(scrollBy);","+  });","+","+  afterEach(() => {","+    vi.restoreAllMocks();","+  });","+","+  it(\"keeps the search box and Manage AI providers outside the scrolling provider list\", () => {","+    const { listViewport } = renderPicker();","+","+    expect(listViewport).toContainElement(screen.getByText(\"OpenAI\"));","+    expect(listViewport).toContainElement(screen.getByText(\"Anthropic\"));","+    expect(listViewport).not.toContainElement(","+      screen.getByPlaceholderText(\"Search model\"),","+    );","+    expect(listViewport).not.toContainElement(","+      screen.getByRole(\"button\", { name: \"Manage AI providers\" }),","+    );","+  });","+","+  it(\"scrolls the provider list with its down arrow\", () => {","+    const { listViewport } = renderPicker();","+    makeOverflow(listViewport);","+","+    fireEvent.pointerDown(screen.getByTestId(\"scroll-down-arrow\"));","+","+    expect(scrollBy).toHaveBeenCalledOnce();","+    expect(scrollBy.mock.contexts[0]).toBe(listViewport);","+  });","+","+  it(\"picks a model from a provider row's side menu\", () => {","+    const { onChange } = re