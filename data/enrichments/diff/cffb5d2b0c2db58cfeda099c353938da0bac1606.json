en could expire while","+    /// the login that issues it is still verifying the password.","+    pub const MIN_LIFETIME: Duration = Duration::from_mins(1);","+}","+","+impl Default for TokensConfig {","+    fn default() -> Self {","+        Self { file: None, default_lifetime: Self::DEFAULT_LIFETIME, max_lifetime: None }","+    }"," }"," "," /// Three-state cap on `auth.users.max_users`:","@@ -210,25 +229,52 @@ pub(super) fn build_identity_config(","     }","     Ok(IdentityConfig {","         admins: build_admins(&file.admins)?,","-        auth: build_auth_config(file, base_dir),","+        auth: build_auth_config(file, base_dir)?,","         backend,","     })"," }"," ","-pub(super) fn build_auth_config(file: &AuthFile, base_dir: &Path) -> AuthConfig {","+pub(super) fn build_auth_config(","+    file: &AuthFile,","+    base_dir: &Path,","+) -> Result<AuthConfig, RegistryError> {","     let users_file = file.users.file.as_deref().map(|raw| resolve_relative(raw, base_dir));","     let tokens_file = file.tokens.file","         .as_deref()","         .map(|raw| resolve_relative(raw, base_dir))","         .or_else(|| users_file.as_deref().map(default_tokens_path_sibling_of));","-    AuthConfig {","+    Ok(AuthConfig {","         oidc: file.oidc.clone(),","         users: UsersConfig {","             file: users_file,","             max_users: file.users.max_users.map_or(MaxUsers::Disabled, MaxUsers::from_yaml),","         },","-        tokens: TokensConfig { file: tokens_file },","+        tokens: TokensConfig {","+            file: tokens_file,","+            default_lifetime: build_token_lifetime(","+                \"defaultLifetime\",","+                file.tokens.default_lifetime.as_ref(),","+            )?","+            .unwrap_or(TokensConfig::DEFAULT_LIFETIME),","+            max_lifetime: build_token_lifetime(\"maxLifetime\", file.tokens.max_lifetime.as_ref())?,","+        },","         scim: file.scim.clone(),","+    })","+}","+","+/// The `auth.tokens.{key