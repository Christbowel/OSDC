  assert!(created_token.get(\"expires\").is_none());","+    assert!(created_token[\"expires\"].is_string(), \"{created_token}\");","     assert_eq!(whoami(&app, created_token[\"token\"].as_str().unwrap()).await, StatusCode::OK);","     auth.users.set_password(id, \"secret123\").await.unwrap();","     assert_eq!(log_in(&app, \"alice\").await.0, StatusCode::CREATED);"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/tests/token_management.rs","lines":["@@ -8,7 +8,7 @@ use axum::{","     body::{Body, to_bytes},","     http::{Request, StatusCode, header},"," };","-use pnpr::{AuthState, Config, MaxUsers, router, router_with_auth};","+use pnpr::{AuthState, Config, MaxUsers, TokensConfig, router, router_with_auth};"," use pnpr_fixtures::MockConfigPresets;"," use serde_json::{Value, json};"," use tempfile::TempDir;","@@ -654,3 +654,83 @@ async fn passwordless_token_creation_stays_within_the_calling_token() {","     assert_eq!(status, StatusCode::OK, \"{body}\");","     assert!(rfc3339_unix_seconds(body[\"expires\"].as_str().unwrap()) < caller_expires);"," }","+","+const DAY_SECS: i64 = 86_400;","+","+async fn assert_token_lifetimes(","+    tokens: TokensConfig,","+    login_lifetime: i64,","+    created: &[(Value, i64)],","+) {","+    let tmp = TempDir::new().unwrap();","+    let mut config = static_config(tmp.path().to_path_buf());","+    config.identity.auth.tokens = tokens;","+    let app = router(config);","+    let assert_expires_after = |body: &Value, issued: (i64, i64), lifetime: i64| {","+        let expires = rfc3339_unix_seconds(body[\"expires\"].as_str().unwrap());","+        assert!(","+            (issued.0 + lifetime..=issued.1 + lifetime).contains(&expires),","+            \"expected {lifetime}s after {issued:?}, got {expires}\",","+        );","+    };","+","+    let before = chrono::Utc::now().timestamp();","+    let login_token = add_user_and_get_token(&app, \"alice\", \"secret123\").await;","+    let login_issued = (before, chrono::Utc::now().timestamp());","+    let listed = app","+        .clone()","+        .oneshot(get_with_bearer(\"/-/npm/v1/tokens\", &login_token))","+        .await","+        .unwrap();","+    assert_expires_after(","+        &body_json(listed.into_body()).await[\"objects\"][0],","+        login_issued,","+        login_lifetime,","+    );","+","+    for (requested, lifetime) in created {","+        let mut payload = requested.clone();","+        payload[\"password\"] = json!(\"secret123\");","+        let before = chrono::Utc::now().timestamp();","+        let response = app","+            .clone()","+            .oneshot(post_json(\"/-/npm/v1/tokens\", &login_token, payload))","+            .await","+            .unwrap();","+        let issued = (before, chrono::Utc::now().timestamp());","+        assert_eq!(response.status(), StatusCode::OK, \"{requested}\");","+        assert_expires_after(&body_json(response.into_body()).await, issued, *lifetime);","+    }","+}","+","+#[tokio::test]","+async fn tokens_without_a_requested_expiry_take_the_default_lifetime() {","+    assert_token_lifetimes(","+        TokensConfig::default(),","+        90 * DAY_SECS,","+        &[","+            (json!({}), 90 * DAY_SECS),","+            (json!({ \"expires\": null }), 90 * DAY_SECS),","+            (json!({ \"expires\": 365 }), 365 * DAY_SECS),","+            (json!({ \"expires\": 1 }), DAY_SECS),","+        ],","+    )","+    .await;","+}","+","+#[tokio::test]","+async fn max_lifetime_caps_login_and_created_tokens() {","+    assert_token_lifetimes(","+        TokensConfig {","+            max_lifetime: Some(std::time::Duration::from_hours(7 * 24)),","+            ..TokensConfig::default()","+        },","+        7 * DAY_SECS,","+        &[","+            (json!({}), 7 * DAY_SECS),","+            (json!({ \"expires\": 30 }), 7 * DAY_SECS),","+            (json!({ \"expires\": 1 }), DAY_SECS),","+        ],","+    )","+    .await;","+}"],"additions":81,"deletions":1,"truncated":false},{"path":"pnpr/docs/configuration.md","lines":["@@ -734,6 +734,27 @@ auth:","     file: ./tokens.db"," ```"," ","+Two settings limit how long a token from a password login or","+`npm token create` stays valid:","+","+- `auth.tokens.defaultLifetime`: the lifetime of a login token, and of a","+  created token that sets no expiry. Defaults to `90d`.","+- `auth.tokens.maxLifetime`: the longest a token stays valid. A token with a","+  later expiry expires after the maximum instead. Without the setting, a","+  created token can set any expiry.","+","+Both apply when pnpr issues a token. A token keeps the expiry it was issued","+with, so changing either setting does not affect existing tokens. Each must be","+at least `1m`. Units are `s`, `m`, `h`, `d`, and `w`. A","+[browser sign-in](oidc.md) keeps its session's expiry of at most an hour.","+","+```yaml title=\"pnpr.yaml\"","+auth:","+  tokens:","+    defaultLifetime: 30d","+    maxLifetime: 52w","+```","+"," Omitted `maxUsers` means registration disabled, not unlimited registration."," Existing users can still log in. When `auth.tokens.file` is omitted and"," `auth.users.file` is set, the token database defaults to `tokens.db` next to"],"additions":21,"deletions":0,"truncated":false},{"path":"pnpr/docs/endpoints.md","lines":["@@ -785,12 +785,12 @@ resolver-only server that exposes no registry surface."," | `GET` | `/-/v1/login/device` | Browser page for SSO login (`loginUrl`). Asks for the code that `/-/v1/login` sent in its `npm-notice` header. |"," | `POST` | `/-/v1/login/device` | Takes the page's form. With one OIDC login provider, or with `provider` set, claims the login with `code` and redirects to the provider. With several providers and no `provider`, checks `code` and returns a page that asks which provider to sign in with. A code works once. pnpr refuses a request without `Sec-Fetch-Site: same-origin`, which current browsers send for a form on a pnpr page. Wrong codes are rate-limited per client address; accepted codes do not count. |"," | `GET` | `/-/v1/login/poll/{session}` | CLI polling endpoint (`doneUrl`). Returns `202 Accepted` with `Retry-After: 1` while pending, or `200 OK` with the bearer token once authenticated. |","-| `PUT` | `/-/user/{name}` | npm adduser/login endpoint. Also accepts legacy `/-/user/org.couchdb.user:{name}`. Creates a user only when `auth.users.maxUsers` allows registration. Passwords must contain at least 8 characters and at most 71 bytes. Returns a bearer token. |","+| `PUT` | `/-/user/{name}` | npm adduser/login endpoint. Also accepts legacy `/-/user/org.couchdb.user:{name}`. Creates a user only when `auth.users.maxUsers` allows registration. Passwords must contain at least 8 characters and at most 71 bytes. Returns a bearer token, which expires after [`auth.tokens.defaultLifetime`](configuration.md#auth), or after `auth.tokens.maxLifetime` when that is shorter. |"," | `GET` | `/-/user/{name}` | Requires authentication. Also accepts legacy `/-/user/org.couchdb.user:{name}`. Returns the public user document when the account exists. |"," | `GET` | `/-/whoami` | Returns `{\"username\": ...}` for the authenticated caller. |"," | `GET` | `/-/npm/v1/user` | npm profile endpoint. Returns the authenticated username and placeholder profile fields. |"," | `POST` | `/-/npm/v1/user` | Change the authenticated user's password. Accepts `{\"password\":{\"old\":\"current-password\",\"new\":\"new-password\"}}`. Revokes the account's existing bearer tokens. Also revokes browser sessions on the serving replica. |","-| `POST` | `/-/npm/v1/tokens` | Creates a bearer token for the authenticated caller. Personal tokens use the `pnpr_` prefix with a base62 payload and CRC-32 checksum. An account with a password must send it as `password`. For an account without one, the caller must authenticate with a browser session or a token, and the new token expires no later than the calling session or token and stays within its CIDR whitelist. Accepts `kind` (`\"classic\"` or `\"granular\"`), `readonly` (`true` or `false`) or `packages_and_scopes_permission` (`\"read-only\"` or `\"read-write\"`), `cidr_whitelist`, `name`, `expires` (positive integer days or an RFC 3339 timestamp), and `expires_in` (positive integer seconds). Unsupported package, scope, organization, and stage-only restrictions return `400`. Expired tokens are rejected at lookup and swept from storage on startup and hourly. |","+| `POST` | `/-/npm/v1/tokens` | Creates a bearer token for the authenticated caller. Personal tokens use the `pnpr_` prefix with a base62 payload and CRC-32 checksum. An account with a password must send it as `password`. For an account without one, the caller must authenticate with a browser session or a token, and the new token expires no later than the calling session or token and stays within its CIDR whitelist. Accepts `kind` (`\"classic\"` or `\"granular\"`), `readonly` (`true` or `false`) or `packages_and_scopes_permission` (`\"read-only\"` or `\"read-write\"`), `cidr_whitelist`, `name`, `expires` (positive integer days or an RFC 3339 timestamp), and `expires_in` (positive integer seconds). Without `expires` or `expires_in`, the token expires after [`auth.tokens.defaultLifetime`](configuration.md#auth). The token expires no later than `auth.tokens.maxLifetime` allows. Unsupported package, scope, organization, and stage-only restrictions return `400`. Expired tokens are rejected at lookup and swept from storage on startup and hourly. |"," | `GET` | `/-/npm/v1/tokens` | Lists bearer tokens for the authenticated caller in npm-compatible shape. The server records a token's last use at most once a minute. |"," | `DELETE` | `/-/npm/v1/tokens/token/{key}` | Revokes one of the caller's tokens by listing-side token key. |"],"additions":2,"deletions":2,"truncated":false}],"additions":301,"deletions":44,"truncated":true,"file_count":16},"error":null,"fetched_at":"2026-11-12T17:12:37.311665+00:00"}