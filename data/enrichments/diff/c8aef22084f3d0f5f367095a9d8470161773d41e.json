Cache->set('page', ['dummy'], ['pageId_2']);","+    }","+","+    #[Test]","+    public function flushCachePageActionFlushesCacheOfThePageAndLogsTheCommand(): void","+    {","+        $response = $this->get(ClearCacheController::class)->flushCachePageAction(","+            new ServerRequest()->withParsedBody(['id' => 2])","+        );","+","+        $pageCache = $this->get(CacheManager::class)->getCache('pages');","+        self::assertTrue(json_decode((string)$response->getBody(), true)['success']);","+        self::assertTrue($pageCache->has('root'));","+        self::assertFalse($pageCache->has('page'));","+        self::assertSame(1, $this->getConnectionPool()->getConnectionForTable('sys_log')->count('*', 'sys_log', ['type' => 3]));","+    }","+","+    #[Test]","+    public function flushCacheGroupPagesActionFlushesAllPageCaches(): void","+    {","+        $this->get(ClearCacheController::class)->flushCacheGroupPagesAction(new ServerRequest());","+","+        $pageCache = $this->get(CacheManager::class)->getCache('pages');","+        self::assertFalse($pageCache->has('root'));","+        self::assertFalse($pageCache->has('page'));","+    }","+}"],"additions":77,"deletions":0,"truncated":false},{"path":"typo3/sysext/backend/Tests/Functional/Controller/Fixtures/ClearCacheController/pages.csv","lines":["@@ -0,0 +1,4 @@","+\"pages\"","+,\"uid\",\"pid\",\"sorting\",\"title\",\"deleted\",\"perms_everybody\"","+,1,0,128,\"Root\",0,31","+,2,1,128,\"Page\",0,31"],"additions":4,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Cache/CacheManager.php","lines":["@@ -141,6 +141,23 @@ public function flushCaches(): void","         }","     }"," ","+    /**","+     * Flushes the registered caches that are not part of any group, such as","+     * the runtime cache. Flushing all groups does not reach them.","+     *","+     * @internal","+     */","+    public function flushCachesWithoutGroup(): void","+    {","+        $this->createAllCaches();","+        $cacheIdentifiersInGroups = array_merge(...array_values($this->cacheGroups));","+        foreach ($this->caches as $cacheIdentifier => $cache) {","+            if (!in_array($cacheIdentifier, $cacheIdentifiersInGroups, true)) {","+                $cache->flush();","+            }","+        }","+    }","+","     /**","      * Flushes all registered caches of a specific group","      *","@@ -233,7 +250,7 @@ public function getCacheGroups(): array","     {","         $groups = array_keys($this->cacheGroups);","         foreach ($this->cacheConfigurations as $config) {","-            foreach ($config['groups'] ?? [] as $group) {","+            foreach ($config['groups'] ?? $this->defaultCacheConfiguration['groups'] as $group) {","                 if (!in_array($group, $groups, true)) {","                     $groups[] = $group;","                 }"],"additions":18,"deletions":1,"truncated":false},{"path":"typo3/sysext/core/Classes/Cache/Event/AfterCacheFlushedEvent.php","lines":["@@ -0,0 +1,33 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Cache\\Event;","+","+use TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlushResult;","+","+/**","+ * Dispatched once after CacheFlusher flushed caches, e.g. for changed records","+ * in DataHandler or via the clear cache actions of the backend. Use it for","+ * follow-up work such as purging a reverse proxy or CDN by the flushed cache","+ * tags. The \"cache:flush\" command only dispatches CacheFlushEvent.","+ */","+final readonly class AfterCacheFlushedEvent","+{","+    public function __construct(","+        public CacheFlushResult $result,","+    ) {}","+}"],"additions":33,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Cache/Event/BeforeCacheFlushEvent.php","lines":["@@ -0,0 +1,35 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Cache\\Event;","+","+use TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlushPlan;","+","+/**","+ * Dispatched once per cache flush with the complete plan of cache tags and","+ * cache groups, which listeners may change before anything is flushed.","+ *","+ * The event is also dispatched by CacheFlusher::resolve(), which flushes","+ * nothing. Listeners must only change the plan, follow-up work belongs into","+ * a listener of AfterCacheFlushedEvent.","+ */","+final readonly class BeforeCacheFlushEvent","+{","+    public function __construct(","+        public CacheFlushPlan $plan,","+    ) {}","+}"],"additions":35,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Cache/Event/BeforeRecordRelatedCachesAreFlushedEvent.php","lines":["@@ -0,0 +1,125 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Cache\\Event;","+","+use TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlushingContext;","+use TYPO3\\CMS\\Core\\Cache\\Flush\\CacheFlushSkipReason;","+","+/**","+ * Dispatched once for every changed record, after the pages, cache tags and","+ * cache commands related to it have been resolved from the page tree and","+ * Page TSconfig \"TCEMAIN.clearCache_*\" and \"TCEMAIN.clearCacheCmd\".","+ *","+ * Page ids are flushed by their \"pageId_<uid>\" cache tag. A record skipped","+ * by \"TCEMAIN.clearCache_disable\" or because a workspace version changed","+ * comes without page ids and tags, but still with its cache commands.","+ *","+ * The event is also dispatched by CacheFlusher::resolve(), which flushes","+ * nothing. Listeners must only change what is flushed, follow-up work","+ * belongs into a listener of AfterCacheFlushedEvent.","+ */","+final class BeforeRecordRelatedCachesAreFlushedEvent","+{","+    /**","+     * @param int $pageId The page the record is located on, for \"pages\" the default language page itself. 0 if skipped.","+     * @param int $originalPageId The page whose Page TSconfig applies, the former location of a moved or deleted record","+     * @param array $pageTsConfig Page TSconfig \"TCEMAIN.\"","+     * @param list<int> $pageIds","+     * @param list<string> $tags","+     * @param list<string> $commands","+     */","+    public function __construct(","+        public readonly string $table,","+        public readonly int $uid,","+        public readonly int $pageId,","+        public readonly int $originalPageId,","+        public readonly array $pageTsConfig,","+        public readonly ?CacheFlushSkipReason $skipReason,","+        public readonly CacheFlushingContext $context,","+        private array $pageIds,","+        private array $tags,","+        private array $commands,","+    ) {}","+","+    /**","+     * @return list<int>","+     */","+    public function getPageIds(): array","+    {","+        return $this->pageIds;","+    }","+","+    /**","+     * @param list<int> $pageIds","+     */","+    public function setPageIds(array $pageIds): void","+    {","+        $this->pageIds = array_values(array_unique(array_map(intval(...), $pageIds)));","+    }","+","+    public function addPageId(int $pageId): void","+    {","+        if (!in_array($pageId, $this->pageIds, true)) {","+            $this->pageIds[] = $pageId;","+        }","+    }","+","+    /**","+     * @return list<string>","+     */","+    public function getTags(): array","+    {","+        return $this->tags;","+    }","+","+    /**","+     * @param list<string> $tags","+     */","+    public function setTags(array $tags): void","+    {","+        $this->tags = array_values(array_unique(array_map(strval(...), $tags)));","+    }","+","+    public function addTag(string $tag): void","+    {","+        if (!$this->hasTag($tag)) {","+            $this->tags[] = $tag;","+        }","+    }","+","+    public function hasTag(string $tag): bool","+    {","+        return in_array($tag, $this->tags, true);","+    }","+","+    /**","+     * @return list<string>","+     */","+    public function getCommands(): array","+    {","+        return $this->commands;","+    }","+","+    /**","+     * @param list<string> $commands","+     */","+    public function setCommands(array $commands): void","+    {","+        $this->commands = array_values(array_unique(array_map(strval(...), $commands)));","+    }","+}"],"additions":125,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Cache/Flush/CacheFlushDemand.php","lines":["@@ -0,0 +1,98 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Cache\\Flush;","+","+/**","+ * Describes what should be flushed: changed records, pages, cache tags or","+ * cache commands as known from \"TCEMAIN.clearCacheCmd\".","+ */","+final readonly class CacheFlushDemand","+{","+    /**","+     * @param array<string, array<int, list<int>>> $records table => uid => pages the record was located on before it was moved or deleted","+     * @param list<int> $pageIds","+     * @param list<string> $tags","+     * @param list<string> $commands","+     */","+    private function __construct(","+        public array $records = [],","+        public array $pageIds = [],","+        public array $tags = [],","+        public array $commands = [],","+    ) {}","+","+    public static function create(): self","+    {","+        return new self();","+    }","+","+    /**","+     * Flushes the caches of the page a record is located on, including","+     * the configuration of \"TCEMAIN.clearCache_*\" and \"TCEMAIN.clearCacheCmd\".","+     *","+     * @param int|null $originalPageId The page the record was located on before it was moved or deleted","+     */","+    public static function forRecord(string $table, int $uid, ?int $originalPageId = null): self","+    {","+        return self::create()->withRecord($table, $uid, $originalPageId);","+    }","+","+    /**","+     * Flushes the cache tags \"pageId_<uid>\" of the pages only, without","+     * resolving related pages or Page TSconfig. Use forRecord('pages', $uid)","+     * to flush a page the way DataHandler does when it is saved.","+     */","+    public static function forPageTagsByPageIds(int ...$pageIds): self","+    {","+        return new self(pageIds: array_values(array_unique($pageIds)));","+    }","+","+    public static function forTags(string ...$tags): self","+    {","+        return new self(tags: array_values(array_unique(array_filter($tags, static fn(string $tag): bool => $tag !== ''))));","+    }","+","+    /**","+     * A cache command as known from \"TCEMAIN.clearCacheCmd\": \"pages\", \"all\",","+     * a page id or \"cacheTag:<tag>\". Other commands are passed on untouched,","+     * so event listeners can react to them.","+     */","+    public static function forCommand(int|string $command): self","+    {","+        $command = trim((string)$command);","+        return new self(commands: $command === '' ? [] : [$command]);","+    }","+","+    /**","+     * @param int|null $originalPageId The page the record was located on before it was moved or deleted","+     */","+    public function withRecord(string $table, int $uid, ?int $originalPageId = null): self","+    {","+        $records = $this->records;","+        $records[$table][$uid] ??= [];","+        if ($originalPageId !== null && !in_array($originalPageId, $records[$table][$uid], true)) {","+            $records[$table][$uid][] = $originalPageId;","+        }","+        return new self($records, $this->pageIds, $this->tags, $this->commands);","+    }","+","+    public function isEmpty(): bool","+    {","+        return $this->records === [] && $this->pageIds === [] && $this->tags === [] && $this->commands === [];","+    }","+}"],"additions":98,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Cache/Flush/CacheFlushLogger.php","lines":["@@ -0,0 +1,53 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Cache\\Flush;","+","+use TYPO3\\CMS\\Core\\Authentication\\BackendUserAuthentication;","+use TYPO3\\CMS\\Core\\SysLog\\Action\\Cache as SystemLogCacheAction;","+use TYPO3\\CMS\\Core\\SysLog\\Error as SystemLogErrorClassification;","+use TYPO3\\CMS\\Core\\SysLog\\Repository\\LogEntryRepository;","+use TYPO3\\CMS\\Core\\SysLog\\Type as SystemLogType;","+","+/**","+ * Writes the sys_log entries of cache commands a backend user triggered.","+ *","+ * @internal only to be used by TYPO3 Core","+ */","+readonly class CacheFlushLogger","+{","+    public function __construct(","+        private LogEntryRepository $logEntryRepository,","+    ) {}","+","+    /**","+     * @param list<string> $commands","+     */","+    public function logCommands(BackendUserAuthentication $backendUser, array $commands): void","+    {","+        foreach ($commands as $command) {","+            $this->logEntryRepository->writeLogEntryForBackendUser(","+                $backendUser,","+                SystemLogType::CACHE,","+                SystemLogCacheAction::CLEAR,","+                SystemLogErrorClassification::MESSAGE,","+                'User {username} has cleared the cache (cacheCmd={command})',","+                ['username' => $backendUser->user['username'] ?? '', 'command' => $command]","+            );","+        }","+    }","+}"],"additions":53,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Classes/Cache/Flush/CacheFlushPageResolver.php","lines":["@@ -0,0 +1,195 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Cache\\Flush;","+","+use TYPO3\\CMS\\Backend\\Utility\\BackendUtility;","+use TYPO3\\CMS\\Core\\Database\\Connection;","+use TYPO3\\CMS\\Core\\Database\\ConnectionPool;","+use TYPO3\\CMS\\Core\\Database\\Query\\QueryBuilder;","+use TYPO3\\CMS\\Core\\Database\\Query\\Restriction\\DeletedRestriction;","+use TYPO3\\CMS\\Core\\Schema\\Capability\\TcaSchemaCapability;","+use TYPO3\\CMS\\Core\\Schema\\TcaSchemaFactory;","+","+/**","+ * Looks up the pages whose caches are affected by a changed record.","+ *","+ * @internal only to be used by CacheFlusher","+ */","+readonly class CacheFlushPageResolver","+{","+    public function __construct(","+        private ConnectionPool $connectionPool,","+        private TcaSchemaFactory $tcaSchemaFactory,","+    ) {}","+","+    /**","+     * The page whose Page TSconfig applies to the record: a page itself, the","+     * page a record is located on (0 on root level), for a workspace version","+     * the page of its live record. Null if the record does not exist.","+     */","+    public function getPageTsConfigPageId(string $table, int $uid): ?int","+    {","+        if ($table === 'pages') {","+            return $uid;","+        }","+        $row = $this->fetchPidAndLiveRecordUid($table, $uid);","+        if ($row === null) {","+            return null;","+        }","+        if ($row['liveRecordUid'] > 0) {","+            return $this->fetchPidAndLiveRecordUid($table, $row['liveRecordUid'])['pid'] ?? null;","+        }","+        return $row['pid'];","+    }","+","+    /**","+     * A record changed in a workspace leaves the live record untouched.","+     */","+    public function isWorkspaceVersion(string $table, int $uid): bool","+    {","+        return ($this->fetchPidAndLiveRecordUid($table, $uid)['liveRecordUid'] ?? 0) > 0;","+    }","+","+    /**","+     * @return array{pid: int, liveRecordUid: int}|null","+     */","+    private function fetchPidAndLiveRecordUid(string $table, int $uid): ?array","+    {","+        $isWorkspaceAware = $this->tcaSchemaFactory->get($table)->hasCapability(TcaSchemaCapability::Workspace);","+        $queryBuilder = $this->connectionPool->getQueryBuilderForTable($table);","+        $queryBuilder->getRestrictions()->removeAll();","+        $row = $queryBuilder","+            ->select(...($isWorkspaceAware ? ['pid', 't3ver_oid'] : ['pid']))","+            ->from($table)","+            ->where($queryBuilder->expr()->eq('uid', $queryBuilder->createNamedParameter($uid, Connection::PARAM_INT)))","+            ->executeQuery()","+            ->fetchAssociative();","+        if ($row === false) {","+            return null;","+        }","+        return ['pid' => (int)$row['pid'], 'liveRecordUid' => (int)($row['t3ver_oid'] ?? 0)];","+    }","+","+    /**","+     * The page the record is located on, for \"pages\" the default language page itself.","+     */","+    public function getPageIdOfRecord(string $table, int $uid): int","+    {","+        if ($table !== 'pages') {","+            return (int)(BackendUtility::getRecord($table, $uid, 'pid', '', false)['pid'] ?? 0);","+        }","+        $languageCapability = $this->tcaSchemaFactory->get('pages')->getCapability(TcaSchemaCapability::Language);","+        $localizationParentFieldName = $languageCapability->getTranslationOriginPointerField()->getName();","+        $row = BackendUtility::getRecord('pages', $uid, '*', '', false);","+        $localizationParent = (int)($row[$localizationParentFieldName] ?? 0);","+        return $localizationParent > 0 ? $localizationParent : $uid;","+    }","+","+    /**","+     * For \"pages\", the page itself, its siblings and its parent page are","+     * affected, for other tables the page the record is located on.","+     * \"TCEMAIN.clearCache_pageSiblingChildren\" adds the subpages of the","+     * siblings, \"TCEMAIN.clearCache_pageGrandParent\" the next page upwards.","+     *","+     * @param array $pageTsConfig Page TSconfig \"TCEMAIN.\"","+     * @return list<int>","+     */","+    public function getAffectedPageIds(string $table, int $pageId, array $pageTsConfig): array","+    {","+        if ($table === 'pages') {","+            return $this->getAffectedPageIdsOfPage($pageId, $pageTsConfig);","+        }","+        if ($pageId <= 0) {","+            return [];","+        }","+        $pageIds = [$pageId];","+        if ($pageTsConfig['clearCache_pageGrandParent'] ?? false) {","+            $grandParentPageId = (int)(BackendUtility::getRecord('pages', $pageId, 'pid')['pid'] ?? 0);","+            if ($grandParentPageId > 0) {","+                $pageIds[] = $grandParentPageId;","+            }","+        }","+        return $pageIds;","+    }","+","+    /**","+     * @return list<int>","+     */","+    private function getAffectedPageIdsOfPage(int $pageId, array $pageTsConfig): array","+    {","+        $pageIds = [];","+        $queryBuilder = $this->getQueryBuilderForPages();","+        $siblings = $queryBuilder","+            ->select('A.pid AS pid', 'B.uid AS uid')","+            ->from('pages', 'A')","+            ->from('pages', 'B')","+            ->where(","+                $queryBuilder->expr()->eq('A.uid', $queryBuilder->createNamedParameter($pageId, Connection::PARAM_INT)),","+                $queryBuilder->expr()->eq('B.pid', $queryBuilder->quoteIdentifier('A.pid')),","+                $queryBuilder->expr()->gte('A.pid', $queryBuilder->createNamedParameter(0, Connection::PARAM_INT))","+            )","+            ->executeQuery();","+        $parentPageId = 0;","+        while ($sibling = $siblings->fetchAssociative()) {","+            $pageIds[] = (int)$sibling['uid'];","+            $parentPageId = (int)$sibling['pid'];","+            if ($pageTsConfig['clearCache_pageSiblingChildren'] ?? false) {","+                $childrenQueryBuilder = $this->getQueryBuilderForPages();","+                $children = $childrenQueryBuilder","+                    -