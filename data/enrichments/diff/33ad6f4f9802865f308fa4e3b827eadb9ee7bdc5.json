non_forced_cas,","+        &forced_cas,","+    );","+","+    let partial_target = tmp.path().join(\"pkg-partial\");","+    fs::create_dir_all(partial_target.join(\"sub\")).unwrap();","+    fs::write(partial_target.join(\"stale.txt\"), b\"partial\").unwrap();","+    assert_concurrent_forced_and_non_forced_imports_converge(","+        &partial_target,","+        &non_forced_cas,","+        &forced_cas,","+    );","+","+    let file_target = tmp.path().join(\"pkg-file\");","+    fs::write(&file_target, b\"a file, not a dir\").unwrap();","+    assert_concurrent_forced_and_non_forced_imports_converge(","+        &file_target,","+        &non_forced_cas,","+        &forced_cas,","+    );","+}","+","+fn assert_concurrent_forced_and_non_forced_imports_converge(","+    target: &Path,","+    non_forced_cas: &HashMap<String, PathBuf>,","+    forced_cas: &HashMap<String, PathBuf>,","+) {","+    let cases = [","+        (non_forced_cas, false),","+        (forced_cas, true),","+        (non_forced_cas, false),","+        (forced_cas, true),","+        (non_forced_cas, false),","+        (forced_cas, true),","+    ];","+    let barrier = std::sync::Barrier::new(cases.len());","+    std::thread::scope(|scope| {","+        for (cas, force) in cases {","+            let barrier = &barrier;","+            scope.spawn(move || {","+                let swap_lock = crate::ModulesSwapLock::new(target.parent().unwrap());","+                barrier.wait();","+                import_indexed_dir::<SilentReporter>(","+                    &AtomicU8::new(0),","+                    PackageImportMethod::Copy,","+                    target,","+                    cas,","+                    ImportIndexedDirOpts {","+                        force,","+                        keep_modules_dir: force,","+                        swap_lock: Some(&swap_lock),","+                        ..ImportIndexedDirOpts::default()","+                    },","+                )","+                .expect(\"concurrent 