{"id":"00c89636c48d4f8b9f03781fee1e0a8f0e1a943e","axis":"silent","repo":"sanity-io/sanity","sha":"00c89636c48d4f8b9f03781fee1e0a8f0e1a943e","parsed":{"files":[{"path":"AGENTS.md","lines":["@@ -397,6 +397,37 @@ Rules that follow from this:","   404 on the module host. `pnpm generate:dts-exports` in `packages/@repo/test-dts-exports`","   regenerates the d.ts fixture for the entry after its export list changes."," ","+### An entry's type surface is what its barrel exports, nothing more","+","+A bundled `.d.ts` can only name declarations the entry barrel actually exports. Until","+`rolldown-plugin-dts` 0.28.7 that was not true: a bundled `.d.ts` with no bare `export {…}` clause","+hit TypeScript's rule that every top-level declaration of such a declaration file is implicitly","+exported, so private helpers pulled in for a signature became part of the published type surface —","+including `const`s and `function`s that the emitted `.js` never exported, so importing them","+type-checked and then failed to link. 0.28.7 appends an `export {}` scope marker instead","+([\"prevent implicit exports of private declarations\"](https://github.com/sxzz/rolldown-plugin-dts/commit/004032f)),","+so only explicit exports are public.","+","+That makes `@repo/test-dts-exports` fixtures the authority on the surface, and a fixture listing a","+name no barrel exports is the bug, not the build. When a dts-tooling bump shrinks a fixture, check","+each dropped name before regenerating:","+","+- A **type** the declaring module exports and tags `@public` belongs on the barrel. Add it there as","+  a type-only re-export (`export {type Foo} from '…'`), which leaves the emitted `.js` untouched.","+- A declaration the module keeps private stays private, and a `Name$1` suffix is a bundler dedup","+  artifact that was never API — `sanity/media-library` emitted one because `VideoDefinition` is","+  declared in both `plugin/schemas/index` and `plugin/schemas/types`.","+- A dropped **value** (`const`, `function`) was never importable: the emitted `.js` never exported","+  it, so `import {name}` failed to link. Making it a real export is an API decision, and it can cost","+  more than it looks — re-exporting `videoTypeName` pulled a 44 kB chunk of form and React code into","+  `sanity/media-library`, which `sideEffects: true` keeps a consumer from tree-shaking away.","+- Load-bearing exceptions exist. `@sanity/util`'s `Options` and `Parser` are exported from","+  `createSafeJsonParser` because `@sanity/migrate` imports `Parser` in its own `.d.ts`, and","+  `lib-check.test.ts` runs with `skipLibCheck: false`.","+","+Regenerating needs a full `pnpm build` first: the generator reads each package's built","+`lib/**/*.d.ts`.","+"," ### Effect events: use `use-effect-event`, not React's native hook"," "," Import `useEffectEvent` from `use-effect-event`, never from `react`. On React 19.2 the native hook"],"additions":31,"deletions":0,"truncated":false},{"path":"e2e/tests/document-actions/restore.spec.ts","lines":["@@ -202,12 +202,13 @@ test(`user defined restore actions should not appear in any other document actio"," }) => {","   const actionMenuButton = page.getByTestId('action-menu-button')","   const customRestoreButton = page.getByTestId('action-Customrestore')","-  const paneContextMenu = page.locator('[data-ui=\"MenuButton__popover\"]')"," ","   await createDraftDocument('/content/input-debug;documentActionsTest')"," ","   await actionMenuButton.click()"," ","-  await expect(paneContextMenu).toBeVisible()","+  // `[data-ui=\"MenuButton__popover\"]` also matches the field action menus, which stay mounted","+  // while closed, so whether it resolves to one element depends on what the form rendered first","+  await expect(actionMenuButton).toHaveAttribute('aria-expanded', 'true')","   await expect(customRestoreButton).not.toBeVisible()"," })"],"additions":3,"deletions":2,"truncated":false},{"path":"packages/@repo/test-dts-exports/test/fixtures/@sanity.util.content.test-d.ts","lines":["@@ -4,8 +4,6 @@"," "," import type {","   isDeepEmpty,","-  isDeepEmptyArray,","-  isDeepEmptyObject,","   isEmpty,","   isEmptyArray,","   isEmptyObject,","@@ -19,12 +17,6 @@ describe('@sanity/util/content', () => {","   test('isDeepEmpty', () => {","     expectTypeOf<typeof isDeepEmpty>().toBeFunction()","   })","-  test('isDeepEmptyArray', () => {","-    expectTypeOf<typeof isDeepEmptyArray>().toBeFunction()","-  })","-  test('isDeepEmptyObject', () => {","-    expectTypeOf<typeof isDeepEmptyObject>().toBeFunction()","-  })","   test('isEmpty', () => {","     expectTypeOf<typeof isEmpty>().not.toBeNever()","   })"],"additions":0,"deletions":8,"truncated":false},{"path":"packages/@repo/test-dts-exports/test/fixtures/sanity.media-library.test-d.ts","lines":["@@ -5,10 +5,8 @@"," import type {","   defineVideoField,","   VideoDefinition,","-  VideoDefinition$1,","   VideoOptions,","   VideoRule,","-  videoTypeName,","   VideoValue,"," } from 'sanity/media-library'"," import {describe, expectTypeOf, test} from 'vitest'","@@ -20,18 +18,12 @@ describe('sanity/media-library', () => {","   test('VideoDefinition', () => {","     expectTypeOf<VideoDefinition>().toBeObject()","   })","-  test('VideoDefinition$1', () => {","-    expectTypeOf<VideoDefinition$1>().toBeObject()","-  })","   test('VideoOptions', () => {","     expectTypeOf<VideoOptions>().toBeObject()","   })","   test('VideoRule', () => {","     expectTypeOf<VideoRule>().toBeObject()","   })","-  test('videoTypeName', () => {","-    expectTypeOf<typeof videoTypeName>().not.toBeNever()","-  })","   test('VideoValue', () => {","     expectTypeOf<VideoValue>().toBeObject()","   })"],"additions":0,"deletions":8,"truncated":false},{"path":"packages/@sanity/util/src/_exports/createSafeJsonParser.ts","lines":["@@ -1 +1,3 @@","-export {createSafeJsonParser} from '../createSafeJsonParser'","+// `Options` and `Parser` are part of this entry's published type surface: `@sanity/migrate` imports","+// `Parser`