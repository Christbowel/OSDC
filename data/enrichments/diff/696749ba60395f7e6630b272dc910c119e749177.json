=> this.registrations.deleteAndDispose(scheme));","+\t}","+","+\tprivate createResourceUri(resource: URI): URI {","+\t\tlet id = this.resourceIds.get(resource);","+\t\tif (!id) {","+\t\t\tid = generateUuid();","+\t\t\tthis.resourceIds.set(resource, id);","+\t\t\tthis.resources.set(id, resource);","+\t\t}","+\t\treturn this.resourceUriProvider!(id, resource);","+\t}","+","+\tasync read(resourceId: string): Promise<{ content: VSBuffer; mimeType: string | undefined } | undefined> {","+\t\tconst resource = this.resources.get(resourceId);","+\t\tif (!resource || !this.schemes.has(resource.scheme)) {","+\t\t\treturn undefined;","+\t\t}","+\t\tconst content = await this.fileService.readFile(resource);","+\t\treturn { content: content.value, mimeType: getMediaOrTextMime(resource.path) };","+\t}","+","+\tresolve(resource: URI): Promise<IReference<URI>> | undefined {","+\t\tif (!this.schemes.has(resource.scheme)) {","+\t\t\treturn undefined;","+\t\t}","+\t\tif (this.resourceUriProvider) {","+\t\t\treturn Promise.resolve({ object: this.createResourceUri(resource), dispose: () => { } });","+\t\t}","+\t\treturn this.acquireObjectUrl(resource);","+\t}","+","+\tprivate async acquireObjectUrl(resource: URI): Promise<IReference<URI>> {","+\t\tlet entry = this.objectUrls.get(resource);","+\t\tif (!entry) {","+\t\t\tentry = { value: this.createObjectUrl(resource), references: 0 };","+\t\t\tthis.objectUrls.set(resource, entry);","+\t\t}","+\t\tentry.references++;","+\t\tconst current = entry;","+\t\tconst release = toDisposable(() => {","+\t\t\tcurrent.references--;","+\t\t\t// A synchronous rerender can acquire the same resource before its previous URL is released.","+\t\t\tqueueMicrotask(() => {","+\t\t\t\tif (current.references === 0 && this.objectUrls.get(resource) === current) {","+\t\t\t\t\tthis.objectUrls.delete(resource);","+\t\t\t\t\tvoid current.value.then(uri => URL.revokeObjectURL(uri.toString(true)), () => { /* No URL was created. */ });","+\t\t\t\t}","+\t\t\t});","+\t\t})