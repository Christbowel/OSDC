onst bottom = Math.min(bounds.height, rect.bottom - bounds.top);","+\t\treturn right > left && bottom > top","+\t\t\t? [`${left}px ${top}px, ${right}px ${top}px, ${right}px ${bottom}px, ${left}px ${bottom}px, ${left}px ${top}px, 0 0`]","+\t\t\t: [];","+\t});","+\treturn holes.length ? `polygon(evenodd, 0 0, 100% 0, 100% 100%, 0 100%, 0 0, ${holes.join(', ')})` : '';","+}","+","+/** Keep a small drag-free buffer beside the pane's resize boundaries. */","+export function isSessionDragFromPaneEdge(element: HTMLElement, event: MouseEvent): boolean {","+\tconst pane = element.closest<HTMLElement>('.chat-group-view, .session-view');","+\tif (!pane) {","+\t\treturn false;","+\t}","+\tconst bounds = pane.getBoundingClientRect();","+\tif (bounds.width === 0 || bounds.height === 0) {","+\t\treturn false;","+\t}","+\tconst gap = 6;","+\treturn event.clientX < bounds.left + gap || event.clientX > bounds.right - gap","+\t\t|| event.clientY < bounds.top + gap || event.clientY > bounds.bottom - gap;","+}","+"," /**","  * Identifier used to track a session being dragged via","  * {@link LocalSelectionTransfer}. Mirrors the editor's","@@ -46,15 +90,19 @@ export class DraggedSessionIdentifier {"," export interface IDraggedSessionChat {"," \treadonly sessionId: string;"," \treadonly resource: string;","+\treadonly isDetached?: boolean;"," }"," "," /**","  * Attaches the {@link IDraggedSessionChat} group-placement payload to a chat drag.","  */","-export function fillSessionChatDragData(e: DragEvent, sessionId: string, resource: URI): void {","-\tconst data: IDraggedSessionChat = { sessionId, resource: resource.toString() };","+export function fillSessionChatDragData(e: DragEvent, sessionId: string, resource: URI, isDetached = false): void {","+\tconst data: IDraggedSessionChat = { sessionId, resource: resource.toString(), ...(isDetached ? { isDetached: true } : {}) };"," \te.dataTransfer?.setData(SessionsDataTransfers.CHAT, JSON.stringify(data));"," \te.dataTransfer?.setData(getSessio