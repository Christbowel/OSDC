r/run/kserve/tls:/var/run/secrets/kubernetes.io/serviceaccount:/etc/pki/tls/certs\"","     containers:","+      - name: pvc-evictor","+        image: ghcr.io/llm-d-incubation/kv-cache-evictor@sha256:3a3d2458d89fc40392b47b6e209c60932311c92933d8682505073dcd29b4e499","+        imagePullPolicy: Always","+        resources:","+          requests:","+            cpu: \"1\"","+            memory: 1Gi","+          limits:","+            cpu: \"4\"","+            memory: 2Gi","+        securityContext:","+          allowPrivilegeEscalation: false","+          capabilities:","+            drop:","+              - ALL","+          runAsNonRoot: true","       - image: ghcr.io/llm-d/llm-d-cuda:v0.9.0","         imagePullPolicy: IfNotPresent","         name: main"],"additions":16,"deletions":0,"truncated":false},{"path":"config/llmisvcconfig/config-llm-template.yaml","lines":["@@ -13,6 +13,22 @@ spec:","     serving.kserve.io/model-based-routing-enabled: \"true\"","   template:","     containers:","+      - name: pvc-evictor","+        image: ghcr.io/llm-d-incubation/kv-cache-evictor@sha256:3a3d2458d89fc40392b47b6e209c60932311c92933d8682505073dcd29b4e499","+        imagePullPolicy: Always","+        resources:","+          requests:","+            cpu: \"1\"","+            memory: 1Gi","+          limits:","+            cpu: \"4\"","+            memory: 2Gi","+        securityContext:","+          allowPrivilegeEscalation: false","+          capabilities:","+            drop:","+              - ALL","+          runAsNonRoot: true","       - image: ghcr.io/llm-d/llm-d-cuda:v0.9.0","         imagePullPolicy: IfNotPresent","         name: main"],"additions":16,"deletions":0,"truncated":false},{"path":"config/llmisvcconfig/config-llm-worker-data-parallel.yaml","lines":["@@ -13,6 +13,22 @@ spec:","     serving.kserve.io/model-based-routing-enabled: \"true\"","   template:","     containers:","+      - name: pvc-evictor","+        image: ghcr.io/llm-d-incubation/kv-cache-evictor@sha256:3a3d2458d89fc40392b47b6e209c60932311c92933d8682505073dcd29b4e499","+        imagePullPolicy: Always","+        resources:","+          requests:","+            cpu: \"1\"","+            memory: 1Gi","+          limits:","+            cpu: \"4\"","+            memory: 2Gi","+        securityContext:","+          allowPrivilegeEscalation: false","+          capabilities:","+            drop:","+              - ALL","+          runAsNonRoot: true","       - image: ghcr.io/llm-d/llm-d-cuda:v0.9.0","         imagePullPolicy: IfNotPresent","         name: main"],"additions":16,"deletions":0,"truncated":false},{"path":"config/rbac/llmisvc/role.yaml","lines":["@@ -30,6 +30,7 @@ rules:"," - apiGroups:","   - \"\"","   resources:","+  - persistentvolumeclaims","   - pods","   verbs:","   - get"],"additions":1,"deletions":0,"truncated":false},{"path":"docs/samples/llmisvc/kv-cache-offloading/README.md","lines":["@@ -156,6 +156,58 @@ secondary:","           path: kv-cache/"," ```"," ","+The PVC evictor is created automatically for PVC-backed tiers:","+","+```yaml","+secondary:","+  - fileSystem:","+      pvc:","+        ref:","+          name: my-cephfs-pvc","+          path: kv-cache/","+```","+","+For `pvc.spec`, KServe runs one evictor sidecar in each vLLM pod. For `pvc.ref`,","+KServe creates one evictor Deployment for each referenced PVC and path, avoiding","+multiple evictors deleting the same files. For an RWO PVC, the Deployment uses","+pod affinity to match a vLLM pod using the same PVC and path. It also merges the","+tolerations from all vLLM Pods using that PVC and path, including tolerations","+added by cluster admission, so the evictor can follow them onto tainted nodes.","+For an RWX PVC, the evictor has no same-node affinity","+and receives no workload tolerations; it may run on a CPU node.","+","+PVC-backed tiers must use a writable PVC access mode. Read-only PVCs are not","+supported because the evictor deletes cache files. The evictor runs as a non-root user.","+The referenced cache directory must allow","+that user or its group to read and delete files. The standalone evictor copies","+the effective vLLM PodSecurityContext from `spec.template.securityContext`.","+On OpenShift, leave UID/GID values unset unless they are allowed by the cluster","+security policy. Every service sharing the same PVC and path must resolve","+matching PodSecurityContext values and `pvc-evictor` container templates.","+","+Both evictor forms use a reserved container template named `pvc-evictor`.","+Define that container in `spec.template.containers` to pin its image, image pull","+policy, resources, security context, command, or extra environment variables.","+Prefill workloads and multi-node workers inherit a template from","+`spec.template.containers` unless their own template or worker PodSpec defines","+a `pvc-evictor` container. Omitted image, pull policy, and security context use the KServe","+defaults. If no resources are set, KServe also uses its default requests and","+limits; any resources you set are used as written.","+Omitted fields inside a custom container securityContext are filled with the","+same hardened defaults.","+KServe still owns the final container name, `PVC_MOUNT_PATH`,","+`CACHE_DIRECTORY`, and the cache volume mount. The template is removed from","+the vLLM pod and used only for generated evictor containers.","+Standalone `pvc.ref` evictors use only that generated cache volume mount.","+Workloads sharing the same `pvc.ref` PVC and path must use the same full","+`pvc-evictor` container template. Separate PVC identities are independent.","+","+`pvc.spec` may use `ReadWriteOncePod` because its evictor is a sidecar in the","+same vLLM pod. Do not use `pvc.ref` with a","+`ReadWriteOncePod` PVC. Its evictor uses a separate Deployment, while","+`ReadWriteOncePod` permits only one pod to mount the claim. Use `ReadWriteOnce`","+or `ReadWriteMany` instead.","+"," ### I have a single replica and don't need the cache to survive pod restarts"," "," Use **`emptyDir`**. No StorageClass required; the node provides the disk. The"],"additions":52,"deletions":0,"truncated":false},{"path":"docs/samples/llmisvc/kv-cache-offloading/llm-inference-service-kv-cache-offloading.yaml","lines":["@@ -54,6 +54,17 @@ spec:","       # pvc.ref: pre-existing user-managed PVC. The PVC must exist before the","       # service is created. For a cache shared across replicas, provision an","       # RWX PVC; for per-pod persistent cache, provision a separate PVC per pod.","+      # pvc.spec uses one evictor sidecar per vLLM pod, while pvc.ref creates","+      # one evictor Deployment for the referenced PVC and path.","+      # Add a container named pvc-evictor under spec.template.containers to pin","+      # the evictor image, resources, pull policy, or security context.","+      # Prefill workloads and multi-node workers inherit it unless they define","+      # their own pvc-evictor container.","+      # Do not use the evictor with a pvc.ref claim using ReadWriteOncePod;","+      # use ReadWriteOnce or ReadWriteMany instead.","+      # The standalone evictor uses the effective vLLM PodSecurityContext.","+      # Services sharing this PVC and path must resolve matching PodSecurityContext","+      # values and pvc-evictor container templates.","       # - fileSystem:","       #     pvc:","       #       ref:"],"additions":11,"deletions":0,"truncated":false},{"path":"hack/setup/quick-install/kserve-knative-mode-full-install-with-manifests.sh","lines":["@@ -2673,6 +2673,22 @@ spec:","     serving.kserve.io/llmisvc-revision: placeholder","   template:","     containers:","+    - image: ghcr.io/llm-d-incubation/kv-cache-evictor@sha256:3a3d2458d89fc40392b47b6e209c60932311c92933d8682505073dcd29b4e499","+      imagePullPolicy: Always","+      name: pvc-evictor","+      resources:","+        limits:","+          cpu: \"4\"","+          memory: 2Gi","+        requests:","+          cpu: \"1\"","+          memory: 1Gi","+   