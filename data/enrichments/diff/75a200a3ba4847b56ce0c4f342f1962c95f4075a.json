distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+use std::sync::Arc;","+","+use databend_common_catalog::session_type::SessionType;","+use databend_common_catalog::table::Table;","+use databend_common_storages_fuse::FuseTable;","+use databend_common_storages_fuse::operations::load_last_snapshot_hint;","+use databend_common_version::BUILD_INFO;","+use databend_query::sessions::Session;","+use databend_query::sessions::TableContextTableAccess;","+use databend_query::test_kits::ConfigBuilder;","+use databend_query::test_kits::OSSSetup;","+use databend_query::test_kits::TestFixture;","+use futures::TryStreamExt;","+","+// Single-session behavior is covered by txn_snapshot_hint.test. These tests","+// control concurrent writers to exercise successful and failed commit retries.","+async fn execute(session: &Arc<Session>, sql: &str) -> anyhow::Result<()> {","+    let ctx = session.create_query_context(&BUILD_INFO).await?;","+    TestFixture::execute_query_with_ctx(ctx, sql)","+        .await?","+        .try_collect::<Vec<_>>()","+        .await?;","+    Ok(())","+}","+","+async fn table(fixture: &TestFixture, name: &str) -> anyhow::Result<FuseTable> {","+    let ctx = fixture.new_query_ctx().await?;","+    let table = ctx","+        .get_table(\"default\", &fixture.default_db_name(), name)","+        .await?;","+    Ok(FuseTable::try_from_table(table.as_ref())?.clone())","+}","+","+async fn ids(fixture: &TestFixture, name: &str) -> anyhow::Result<Vec<String>> {","+    let blocks = fixture","+        .execute_query(&format!(","+            \"SELECT id FROM {}.{name} ORDER BY id\",","+            fixture.default_db_name()","+        ))","+        .await?","+        .try_collect::<Vec<_>>()","+        .await?;","+    let mut result = Vec::new();","+    for block in blocks {","+        for row in 0..block.num_rows() {","+            result.push(","+                block","+                    .get_by_offset(0)","+                    .value()","+                    .index(row)","+                    .unwrap()","+                    .to_string(),","+            );","+        }","+    }","+    Ok(result)","+}","+","+fn snapshot_path(table: &FuseTable) -> String {","+    format!(","+        \"{}{}\",","+        table.get_operator().info().root(),","+        table.snapshot_loc().unwrap()","+    )","+}","+","+async fn hint(table: &FuseTable) -> anyhow::Result<Option<String>> {","+    Ok(load_last_snapshot_hint(","+        table.meta_location_generator().prefix(),","+        &table.get_operator(),","+    )","+    .await?","+    .map(|hint| hint.snapshot_full_path))","+}","+","+async fn setup() -> anyhow::Result<TestFixture> {","+    // Temporary tables require a client session rather than SessionType::Dummy.","+    let fixture = TestFixture::setup_with_custom_and_session_type(","+        OSSSetup {","+            config: ConfigBuilder::create().config(),","+        },","+        SessionType::MySQL,","+    )","+    .await?;","+    fixture.create_default_database().await?;","+    fixture","+        .execute_command(\"SET auto_compaction_imperfect_blocks_threshold=0\")","+        .await?;","+    fixture.execute_command(\"SET enable_auto_analyze=0\").await?;","+    Ok(fixture)","+}","+","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_transaction_snapshot_hints_after_retry() -> anyhow::Result<()> {","+    let fixture = setup().await?;","+    let db = fixture.default_db_name();","+    let writer = fixture.new_session_with_type(SessionType::Dummy).await?;","+    let names = [\"hint_retry_a\", \"hint_retry_b\"];","+    for name in names {","+        fixture","+            .execute_command(&format!(\"CREATE TABLE {db}.{name}(id INT, v INT)\"))","+            .await?;","+        fixture","+            .execute_command(&format!(\"INSERT INTO {db}.{name} VALUES (1,10)\"))","+            .await?;","+    }","+    let temp = \"hint_retry_temp\";","+    fixture","+        .execute_command(&format!(\"CREATE TEMP TABLE {db}.{temp}(id INT)\"))","+        .await?;","+    fixture","+        .execute_command(&format!(\"INSERT INTO {db}.{temp} VALUES (0)\"))","+        .await?;","+    let before = table(&fixture, temp).await?;","+    assert_eq!(hint(&before).await?, Some(snapshot_path(&before)));","+","+    fixture.execute_command(\"BEGIN\").await?;","+    fixture","+        .execute_command(&format!(\"INSERT INTO {db}.{temp} VALUES (1)\"))","+        .await?;","+    let temp_buffered = table(&fixture, temp).await?;","+    assert_ne!(temp_buffered.snapshot_loc(), before.snapshot_loc());","+    assert_eq!(hint(&before).await?, Some(snapshot_path(&before)));","+    fixture","+        .execute_command(&format!(","+            \"INSERT ALL INTO {db}.{} INTO {db}.{} SELECT 2,20\",","+            names[0], names[1]","+        ))","+        .await?;","+    let mut buffered = Vec::new();","+    for name in names {","+        fixture","+            .execute_command(&format!(\"INSERT INTO {db}.{name} VALUES (3,30)\"))","+            .await?;","+        buffered.push(table(&fixture, name).await?.snapshot_loc());","+        // Advance both tables from another session to force snapshot rebuilds.","+        execute(&writer, &format!(\"INSERT INTO {db}.{name} VALUES (4,40)\")).await?;","+    }","+    fixture.execute_command(\"COMMIT\").await?;","+    for (index, name) in names.into_iter().enumerate() {","+        let table = table(&fixture, name).await?;","+        assert_ne!(table.snapshot_loc(), buffered[index]);","+        assert_eq!(hint(&table).await?, Some(snapshot_path(&table)));","+        assert_eq!(ids(&fixture, name).await?, [\"1\", \"2\", \"3\", \"4\"]);","+    }","+    let committed = table(&fixture, temp).await?;","+    assert_eq!(","+        committed.get_table_info().meta,","+        temp_buffered.get_table_info().meta","+    );","+    assert_eq!(hint(&committed).await?, Some(snapshot_path(&committed)));","+    assert_eq!(ids(&fixture, temp).await?, [\"0\", \"1\"]);","+    Ok(())","+}","+","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_failed_transaction_commit_preserves_snapshot_hint() -> anyhow::Result<()> {","+    let fixture = setup().await?;","+    let db = fixture.default_db_name();","+    let writer = fixture.new_session_with_type(SessionType::Dummy).await?;","+    // Cover both a missing first hint and an existing committed hint.","+    for (temp, initialized) in [","+        (\"hint_conflict_empty\", false),","+        (\"hint_conflict_existing\", true),","+    ] {","+        let target = format!(\"{db}.{temp}_persistent\");","+        fixture","+            .execute_command(&format!(\"CREATE TABLE {target}(id INT)\"))","+            .await?;","+        fixture","+            .execute_command(&format!(\"INSERT INTO {target} VALUES (1),(2)\"))","+            .await?;","+        fixture","+            .execute_command(&format!(\"CREATE TEMP TABLE {db}.{temp}(id INT)\"))","+            .await?;","+        if initialized {","+            fixture","+                .execute_command(&format!(\"INSERT INTO {db}.{temp} VALUES (0)\"))","+                .await?;","+        }","+        let before = table(&fixture, temp).await?;","+        let expected_temp_hint = hint(&before).await?;","+        assert_eq!(","+            expected_temp_hint,","+            initialized.then(|| snapshot_path(&before))","+        );","+        fixture.execute_command(\"BEGIN\").await?;","+        fixture","+            .execute_command(&format!(\"INSERT INTO {db}.{temp} VALUES (1)\"))","+            .await?;","+        fixture","+            .execute_command(&format!(\"DELETE FROM {target} WHERE id=1\"))","+            .await?;","+        // Both deletes rewrite the same segment, making the conflict unresolvable.","+        execute(&writer, &format!(\"DELETE FROM {target} WHERE id=2\")).await?;","+        let ctx = writer.create_query_context(&BUILD_INFO).await?;","+        let latest = ctx","+            .get_table(\"default\", &db, &format!(\"{temp}_persistent\"))","+            .await?;","+        let latest = FuseTable::try_from_table(latest.as_ref())?;","+        let expected = Some(snapshot_path(latest));","+        assert_eq!(hint(latest).await?, expected);","+","+        let err = fixture.execute_command(\"COMMIT\").await.unwrap_err();","+        assert_eq!(","+            err.code(),","+            databend_common_exception::ErrorCode::UNRESOLVABLE_CONFLICT","+        );","+        assert_eq!(hint(latest).await?, expected);","+        assert_eq!(","+            table(&fixture, &format!(\"{temp}_persistent\"))","+                .await?","+                .snapshot_loc(),","+            latest.snapshot_loc()","+        );","+        assert_eq!(ids(&fixture, &format!(\"{temp}_persistent\")).await?, [\"1\"]);","+        let after = table(&fixture, temp).await?;","+        assert_eq!(after.get_table_info().meta, before.get_table_info().meta);","+        assert_eq!(hint(&after).await?, expected_temp_hint);","+        let expected_ids = if initialized { vec![\"0\"] } else { vec![] };","+        assert_eq!(ids(&fixture, temp).await?, expected_ids);","+    }","+    Ok(())","+}"],"additions":238,"deletions":0,"truncated":false},{"path":"src/query/storages/fuse/src/operations/snapshot_hint.rs","lines":["@@ -143,6 +143,12 @@ impl SnapshotHintWriter<'_> {","         table_meta: &TableMeta,","     ) {","         let ctx = &self.ctx;","+        // Attached tables trust this hint without consulting the catalog. Do not","+        // expose a buffered snapshot; COMMIT publishes the final snapshot after","+        // the metadata update succeeds (and has switched to auto-commit mode).","+        if ctx.txn_mgr().lock().is_active() {","+            return;","+        }","         if let Ok(false) = ctx.get_settings().get_enable_last_snapshot_location_hint() {","             info!(","                 \"Write last_snapshot_location_hint disabled. Snapshot {}\","],"additions":6,"deletions":0,"truncated":false},{"path":"src/query/storages/fuse/src/retry/commit.rs","lines":["@@ -34,6 +34,7 @@ use databend_storages_common_table_meta::meta::Versioned;"," use databend_storages_common_table_meta::readers::snapshot_reader::TableSnapshotAccessor;"," use databend_storages_common_table_meta::table::is_fuse_backed_engine;"," use log::info;","+use log::warn;"," use tokio::time::sleep;"," "," use super::diff::SegmentsDiff;","@@ -66,6 +67,9 @@ pub async fn commit_with_backoff(","             .retryable_update_multi_table_meta(tenant, req.clone())","             .await?;","         let Err(update_failed_tbls) = ret else {","+            // Retries can replace the buffered snapshots with merged snapshots.","+            // Publish only the locations in the request that actually committed.","+            write_snapshot_hints(ctx.as_ref(), &req).await;","             return Ok(());","         };","         let Some(duration) = backoff.next_backoff() else {","@@ -89,6 +93,60 @@ pub async fn commit_with_backoff(","     }"," }"," ","+// Like the hint write itself, operator initialization is best effort: metadata","+// has already committed, so a hint failure must not turn COMMIT into an error.","+async fn write_snapshot_hints(ctx: &dyn TableContext, req: &UpdateMultiTableMetaReq) {","+    let storage_class = match ctx.get_settings().get_s3_storage_class() {","+        Ok(storage_class) => storage_class,","+        Err(e) => {","+            warn!(\"Failed to initialize transaction snapshot hints: {e}\");","+            return;","+        }","+    };","+    let tables = req","+        .update_table_metas","+        .iter()","+        .map(|(update, info)| {","+            (","+                update.table_id,","+                info.ident.seq,","+                &update.new_table_meta,","+                info.desc.as_str(),","+            )","+        })","+        .chain(req.update_temp_tables.iter().map(|update| {","+            (","+                update.table_id,","+                0,","+                &update.new_table_meta,","+                update.desc.as_str(),","+            )","+        }));","+    for (table_id, seq, meta, desc) in tables {","+        if !is_fuse_backed_engine(&meta.engine) {","+            continue;","+        }","+        let table =","+            match FuseTable::from_table_meta(table_id, seq, meta.clone(), storage_class, desc) {","+                Ok(table) => table,","+                Err(e) => {","+                    warn!(\"Failed to initialize snapshot hint for table {table_id}: {e}\");","+                    continue;","+                }","+            };","+        if let Some(location) = table.snapshot_loc() {","+            FuseTable::write_last_snapshot_hint(","+                ctx,","+                &table.get_operator(),","+                table.meta_location_generator(),","+                &location,","+                meta,","+            )","+            .await;","+        }","+    }","+}","+"," async fn compute_table_segments_diffs(","     ctx: Arc<dyn TableContext>,","     req: &UpdateMultiTableMetaReq,"],"additions":58,"deletions":0,"truncated":false},{"path":"tests/sqllogictests/suites/http_handler/transaction/txn_snapshot_hint.test","lines":["@@ -0,0 +1,228 @@","+# Regression for #20752. Inspect the same storage hint used by ATTACH TABLE,","+# without requiring an enterprise license to attach the table. The dedicated","+# fs prefix follows txn_ext.test; clear it so repeated runs see only this table.","+statement ok","+create or replace database txn_snapshot_hint;","+","+statement ok","+use txn_snapshot_hint;","+","+statement ok","+set auto_compaction_imperfect_blocks_threshold=0;","+","+statement ok","+set enable_auto_analyze=0;","+","+statement ok","+create or replace stage txn_hint_stage url='fs:///tmp/http_handler_txn_snapshot_hint/persistent/';","+","+statement ok","+remove @txn_hint_stage;","+","+statement ok","+create table t(id int, v int) 'fs:///tmp/http_handler_txn_snapshot_hint/persistent/';","+","+# A table's first snapshot must not create a hint until COMMIT.","+statement ok","+begin;","+","+statement ok","+insert into t values (1,10);","+","+query I","+select count(*) from @txn_hint_stage (pattern=>'.*last_snapshot_location_hint_v2', file_format=>'ndjson');","+----","+0","+","+statement ok","+rollback;","+","+query I","+select count(*) from @txn_hint_stage (pattern=>'.*last_snapshot_location_hint_v2', file_format=>'ndjson');","+----","+0","+","+statement ok","+begin;","+","+statement ok","+insert into t values (1,10);","+","+statement ok","+commit;","+","+statement ok","+create temp table hint_before as select $1:snapshot_full_path::string as path from @txn_hint_stage (pattern=>'.*last_snapshot_location_hint_v2', file_format=>'ndjson');","+","+statement ok","+begin;","+","+statement ok","+delete from t where id=1;","+","+# The source sees its own DELETE, but the published hint must not change.","+query I","+select count(*) from t;","+----","+0","+","+statement ok","+insert into t values (1,10),(2,20);","+","+statement ok","+update t set v=-1 where id=1;","+","+statement ok","+replace into t on (id) values (1,-2),(5,50);","+","+query B","+select $1:snapshot_full_path::string = (select path from hint_before) from @txn_hint_stage (pattern=>'.*last_snapshot_location_hint_v2', file_format=>'ndjson');","+----","+1","+","+statement ok","+rollback;","+","+query II","+select * from t;","+----","+1 10","+","+query B","+select $1:snapshot_full_path::string = (select path from hint_before) from @txn_hint_stage (pattern=>'.*last_snapshot_location_hint_v2', file_format=>'ndjson');","+----","+1","+","+# Multiple statements must publish only the final snapshot on COMMIT.","+statement ok","+begin;","+","+statement ok","+insert into t values (2,20);","+","+statement ok","+update t set v=11 where id=1;","+","+query B","+select $1:snapshot_full_path::string = (select path from hint_before) from @txn_hint_stage (pattern=>'.*last_snapshot_location_hint_v2', file_format=>'ndjson');","+----","+1","+","+statement ok","+commit;","+","+query II","+select * from t order by id;","+----","+1 11","+2 20","+","+query B","+select right($1:snapshot_full_path::string, length(s.snapshot_location)) = s.snapshot_location","+from @txn_hint_stage (pattern=>'.*last_snapshot_location_hint_v2', file_format=>'ndjson')","+cross join (select snapshot_location from fuse_snapshot('txn_snapshot_hint','t') limit 1) s;","+----","+1","+","+query B","+select $1:snapshot_full_path::string != (select path from hint_before) from @txn_hint_stage (pattern=>'.*last_snapshot_location_hint_v2', file_format=>'ndjson');","+----","+1","+","+# COMMIT must still honor the setting that disables hint writes.","+statement ok","+set enable_last_snapshot_location_hint=0;","+","+statement ok","+begin;","+","+statement ok","+insert into t values (3,30);","+","+statement ok","+commit;","+","+query B","+select right($1:snapshot_full_path::string, length(s.snapshot_location)) = s.snapshot_location","+from @txn_hint_stage (pattern=>'.*last_snapshot_location_hint_v2', file_format=>'ndjson')","+cross join (select snapshot_location from fuse_snapshot('txn_snapshot_hint','t') limit 1) s;","+----","+0","+","+statement ok","+set enable_last_snapshot_location_hint=1;","+","+# Temporary tables use a separate metadata-update list at COMMIT.","+statement ok","+create or replace stage txn_temp_hint_stage url='fs:///tmp/http_handler_txn_snapshot_hint/temporary/';","+","+statement ok","+remove @txn_temp_hint_stage;","+","+statement ok","+create temp table tt(id int) 'fs:///tmp/http_handler_txn_snapshot_hint/temporary/';","+","+statement ok","+insert into tt values (1);","+","+statement ok","+begin;","+","+statement ok","+insert into tt values (2);","+","+query B","+select right($1:snapshot_full_path::string, length(s.snapshot_location)) = s.snapshot_location","+from @txn_temp_hint_stage (pattern=>'.*last_snapshot_location_hint_v2', file_format=>'ndjson')","+cross join (select snapshot_location from fuse_snapshot('txn_snapshot_hint','tt') limit 1) s;","+----","+0","+","+statement ok","+rollback;","+","+query B","+select right($1:snapshot_full_path::string, length(s.snapshot_location)) = s.snapshot_location","+from @txn_temp_hint_stage (pattern=>'.*last_snapshot_location_hint_v2', file_format=>'ndjson')","+cross join (select snapshot_location from fuse_snapshot('txn_snapshot_hint','tt') limit 1) s;","+----","+1","+","+statement ok","+begin;","+","+statement ok","+insert into tt values (2);","+","+statement ok","+commit;","+","+query B","+select right($1:snapshot_full_path::string, length(s.snapshot_location)) = s.snapshot_location","+from @txn_temp_hint_stage (pattern=>'.*last_snapshot_location_hint_v2', file_format=>'ndjson')","+cross join (select snapshot_location from fuse_snapshot('txn_snapshot_hint','tt') limit 1) s;","+----","+1","+","+query I","+select count(*) from tt;","+----","+2","+","+statement ok","+drop table tt;","+","+statement ok","+drop stage txn_temp_hint_stage;","+","+statement ok","+drop table hint_before;","+","+statement ok","+drop table t;","+","+statement ok","+drop stage txn_hint_stage;","+","+statement ok","+drop database txn_snapshot_hint;",""],"additions":228,"deletions":0,"truncated":false}],"additions":539,"deletions":3,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-04T16:06:25.651203+00:00"}