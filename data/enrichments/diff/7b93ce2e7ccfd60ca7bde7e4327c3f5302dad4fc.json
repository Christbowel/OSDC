g. */","+    public static final Target CHARGED_BY_TASK = (nanos, finishNanos) -> {};","+","+    /**","+     * The pool task running on an {@link EsExecutors.EsThread}.","+     */","+    static final class Task {","+        /** Whether this thread runs a tracked task. */","+        boolean running;","+        Target target;","+        /** The time charged with {@link #charge}. */","+        long chargedNanos;","+","+        void reset(boolean running) {","+            this.running = running;","+            target = null;","+            chargedNanos = 0;","+        }","+    }","+","+    private TaskLoadAttribution() {}","+","+    /**","+     * Charges the time of the task running on this thread to {@code target}, unless the task has a target already.","+     */","+    public static void attribute(Target target) {","+        Task task = task();","+        if (task != null && task.running && task.target == null) {","+            task.target = target;","+        }","+    }","+","+    /**","+     * Charges {@code nanos} of the task running on this thread to {@code target}, so its pool charges only the rest of the","+     * task to the task's target.","+     */","+    public static void charge(Target target, long nanos, long finishNanos) {","+        target.charge(nanos, finishNanos);","+        Task task = task();","+        if (task != null && task.running) {","+            task.chargedNanos += nanos;","+        }","+    }","+","+    /**","+     * Whether the time of the task running on this thread is charged by its pool.","+     */","+    public static boolean chargedByPool() {","+        Task task = task();","+        return task != null && task.running;","+    }","+","+    /**","+     * An executor whose tasks are charged to {@code target}.","+     */","+    public static Executor charging(Executor executor, Target target) {","+        return task -> executor.execute(task instanceof AbstractRunnable runnable ? new Charging(runnable, target) : () -> {","+            attribute(target);","+            task.run();","+        });","+    }","+","+    /**","+     * Runs {@code task} charged to {@code target}, forwarding its completion so that it completes once.","+     */","+    private static final class Charging extends AbstractRunnable {","+        private final AbstractRunnable task;","+        private final Target target;","+","+        Charging(AbstractRunnable task, Target target) {","+            this.task = task;","+            this.target = target;","+        }","+","+        @Override","+        protected void doRun() throws Exception {","+            attribute(target);","+            task.doRun();","+        }","+","+        @Override","+        public void onFailure(Exception e) {","+            task.onFailure(e);","+        }","+","+        @Override","+        public void onRejection(Exception e) {","+            task.onRejection(e);","+        }","+","+        @Override","+        public void onAfter() {","+            task.onAfter();","+        }","+","+        @Override","+        public boolean isForceExecution() {","+            return task.isForceExecution();","+        }","+","+        @Override","+        public String toString() {","+            return task.toString();","+        }","+    }","+","+    /**","+     * The pool task running on this thread, or {@code null} if it is not a pool thread.","+     */","+    private static Task task() {","+        return Thread.currentThread() instanceof EsExecutors.EsThread thread ? thread.loadTask : null;","+    }","+","+    /**","+     * Starts tracking a task on this thread, if it is a thread that can track one.","+     */","+    static void taskStarted() {","+        Task task = task();","+        if (task != null) {","+            task.reset(true);","+        }","+    }","+","+    /**","+     * Charges the task that completed on this thread to its target.","+     *","+     * @return the part of its time that was charged","+     */","+    static long taskCompleted(long nanos, long finishNanos) {","+        Task task = task();","+        if (task == null || task.running == false) {","+            return 0;","+        }","+        Target target = task.target;","+        long charged = Math.min(task.chargedNanos, nanos);","+        task.reset(false);","+        if (target == null) {","+            return charged;","+        }","+        if (nanos > charged) {","+            target.charge(nanos - charged, finishNanos);","+        }","+        return nanos;","+    }","+","+    /**","+     * Stops tracking the task on this thread without charging it.","+     */","+    static void taskAbandoned() {","+        Task task = task();","+        if (task != null) {","+            task.reset(false);","+        }","+    }","+}"],"additions":187,"deletions":0,"truncated":false},{"path":"server/src/main/java/org/elasticsearch/index/search/stats/ShardSearchStats.java","lines":["@@ -15,12 +15,16 @@"," import org.elasticsearch.common.regex.Regex;"," import org.elasticsearch.common.util.CollectionUtils;"," import org.elasticsearch.common.util.Maps;","+import org.elasticsearch.common.util.concurrent.TaskLoadAttribution;","+import org.elasticsearch.core.Nullable;"," import org.elasticsearch.index.shard.SearchOperationListener;"," import org.elasticsearch.search.internal.ReaderContext;"," import org.elasticsearch.search.internal.SearchContext;"," ","+import java.util.List;"," import java.util.Map;"," import java.util.concurrent.TimeUnit;","+import java.util.concurrent.atomic.LongAdder;"," import java.util.function.Consumer;"," "," import static java.util.Collections.emptyMap;","@@ -30,6 +34,7 @@ public final class ShardSearchStats implements SearchOperationListener {","     private final CounterMetric openContexts = new CounterMetric();","     private volatile Map<String, StatsHolder> groupsStats = emptyMap();","     private final SearchStatsSettings searchStatsSettings;","+    private final TaskLoadAttribution.Target searchLoadTarget = this::accumulat