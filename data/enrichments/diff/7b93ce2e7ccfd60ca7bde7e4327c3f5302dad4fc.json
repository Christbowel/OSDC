its shard phases, the segment searches they fork and the partial","+ * reduces of their results, is the search load of the shards it searches.","+ */","+@ESIntegTestCase.ClusterScope(scope = ESIntegTestCase.Scope.TEST, numDataNodes = 0)","+public class SearchLoadIT extends ESIntegTestCase {","+","+    public void testShardTasksChargeTheShardsTheySearch() throws Exception {","+        String dataNode = internalCluster().startNode(","+            Settings.builder()","+                // no reaper of search contexts on the search pool while the searches run","+                .put(SearchService.KEEPALIVE_INTERVAL_SETTING.getKey(), TimeValue.timeValueHours(1))","+                // segments searched in parallel, however small: with 4 threads a slice needs a quarter of the shard's documents,","+                // less than each of its 3 segments holds","+                .put(SearchService.MINIMUM_DOCS_PER_SLICE.getKey(), 1)","+                .put(\"thread_pool.search.size\", 4)","+        );","+        String coordinator = internalCluster().startCoordinatingOnlyNode(Settings.EMPTY);","+        // more shards on the data node than the batched reduce size, so it reduces their results in a task of its own","+        createIndex(\"searched\", indexSettings(between(3, 5), 0).build());","+        createIndex(\"other\", indexSettings(1, 0).build());","+        // a refresh after each round, so each shard has several segments to search in parallel","+        for (int segment = 0; segment < 3; segment++) {","+            BulkRequestBuilder bulk = client().prepareBulk().setRefreshPolicy(WriteRequest.RefreshPolicy.IMMEDIATE);","+            for (int i = 0; i < 500; i++) {","+                bulk.add(prepareIndex(randomFrom(\"searched\", \"other\")).setSource(\"k\", \"k\" + (i % 10), \"v\", i));","+            }","+            assertNoFailures(bulk.get());","+        }","+        ThreadPool threadPool = internalCluster().getInstance(ThreadPool.class, dataNode);","+        var search = (TaskExecutionTimeTrackingEsThreadPoolExecutor) threadPool.executor(ThreadPool.Names.SEARCH);","+        long attributedBefore = search.getAttributedTaskExecutionTime();","+        long totalBefore = search.getTotalTaskExecutionTime();","+        long chargedBefore = chargedToShards(dataNode);","+","+        for (int i = between(1, 5); i > 0; i--) {","+            // sorted by score, since sorting on a field searches segments one after the other","+            var request = client(coordinator).prepareSearch(\"searched\")","+                .setQuery(QueryBuilders.rangeQuery(\"v\").gte(between(0, 50)))","+                .setSize(10)","+                .setBatchedReduceSize(2);","+            if (randomBoolean()) {","+                request.addAggregation(AggregationBuilders.terms(\"k\").field(\"k.keyword\"));","+            }","+            var response = request.get();","+            try {","+                assertNoFailures(response);","+            } finally {","+                response.decRef();","+            }","+        }","+","+        assertBusy(() -> {","+            long total = search.getTotalTaskExecutionTime() - totalBefore;","+            assertThat(total, greaterThan(0L));","+            // every task is charged, and charged once","+            assertThat(search.getAttributedTaskExecutionTime() - attributedBefore, equalTo(total));","+            assertThat(chargedToShards(dataNode) - chargedBefore, equalTo(total));","+        });","+        assertThat(searchLoad(\"searched\"), greaterThan(0.0));","+        assertThat(searchLoad(\"other\"), equalTo(0.0));","+    }","+","+    private static long chargedToShards(String node) {","+        long charged = 0;","+        for (IndexService indexService : internalCluster().getInstance(IndicesService.class, node)) {","+            for (IndexShard shard : indexService) {","+                charged += shard.shardSearchStats().totalSearchLoadNanos();","+            }","+        }","+        return charged;","+    }","+","+    private static double searchLoad(String index) {","+        return indicesAdmin().prepareStats(index)","+            .setSearch(true)","+            .get()","+            .getIndex(index)","+            .getTotal()","+            .getSearch()","+            .getTotal()","+            .getSearchLoadRate();","+    }","+}"],"additions":112,"deletions":0,"truncated":false},{"path":"server/src/main/java/org/elasticsearch/action/search/QueryPhaseResultConsumer.java","lines":["@@ -24,6 +24,7 @@"," import org.elasticsearch.common.lucene.Lucene;"," import org.elasticsearch.common.lucene.search.TopDocsAndMaxScore;"," import org.elasticsearch.common.util.concurrent.AbstractRunnable;","+import org.elasticsearch.common.util.concurrent.TaskLoadAttribution;"," import org.elasticsearch.core.Nullable;"," import org.elasticsearch.core.Releasables;"," import org.elasticsearch.core.Tuple;","@@ -67,6 +68,8 @@ public class QueryPhaseResultConsumer extends ArraySearchPhaseResults<SearchPhas","     private static final Logger logger = LogManager.getLogger(QueryPhaseResultConsumer.class);"," ","     private final Executor executor;","+    /** Where the time spent merging results is charged, or {@code null}. */","+    private volatile TaskLoadAttribution.Target mergeLoad;","     private final CircuitBreaker circuitBreaker;","     private final SearchProgressListener progressListener;","     private final AggregationReduceContext.Builder aggReduceContextBuilder;","@@ -136,6 +139,21 @@ public QueryPhaseResultConsumer(","         topDocsStats = new TopDocsStats(request.resolveTrackTotalHitsUpTo());","     }"," ","+    /**","+     * Charges the time spent merging results to {@code mergeLoad}.","+     */","+    public void mergeLoad(TaskLoadAttribution.Target mergeLoad) {","+        this.mergeLoad = mergeLoad;","+    }","+","+    /**","+     * Where the time spent merging results is charged, or {@code null} when it is not charged.","+     */","+    @Nullable","+    TaskLoadAttr