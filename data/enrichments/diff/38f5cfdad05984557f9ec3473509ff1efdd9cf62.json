ethodAssociatedDataNode.","+                sink.Add(factory.MethodEntrypoint(Method), \"Non-unboxing method\");","+            }","+        }","+","         protected override void EmitCode(NodeFactory factory, ref WasmEmitter encoder, bool relocsOnly)","         {","-            WasmFuncType signature = WasmLowering.GetSignature(Method).FuncType;","+            WasmFuncType signature = WasmLowering.GetSignature(this).FuncType;","+            if (IsInstantiating && Method.OwningType.IsByRefLike)","+            {","+                // Byref-like types cannot be boxed; preserve the throwing dummy entrypoint.","+                encoder.FunctionBody = new WasmFunctionBody(signature,","+                [","+                    Local.Get(0),","+                    ControlFlow.Call(factory.MethodEntrypoint(factory.TypeSystemContext.GetHelperEntryPoint(","+                        \"ThrowHelpers\"u8, \"ThrowNullReferenceException\"u8))),","+                    ControlFlow.Unreachable,","+                ]);","+                return;","+            }","+","             int parameterCount = signature.Params.Types.Length;","+            List<WasmExpr> expressions = new List<WasmExpr>(parameterCount + 5);","+            expressions.Add(Local.Get(0));","+            expressions.Add(Local.Get(1));","+            expressions.Add(I32.Const(factory.Target.PointerSize));","+            expressions.Add(I32.Add);"," ","-            WasmExpr[] expressions = new WasmExpr[parameterCount + 3];","-            expressions[0] = Local.Get(0);","-            expressions[1] = Local.Get(1);","-            expressions[2] = I32.Const(factory.Target.PointerSize);","-            expressions[3] = I32.Add;","+            int firstArgument = 2;","+            if (IsInstantiating)","+            {","+                if (WasmLowering.LowerToAbiType(Method.Signature.ReturnType) is null","+                    && !WasmLowering.IsEmptyStruct(Method.Signature.ReturnType))","+                {","+             