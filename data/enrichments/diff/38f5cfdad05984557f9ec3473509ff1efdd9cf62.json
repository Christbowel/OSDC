y) => ObjectNodeSection.ReadOnlyDataSection;","+","+        public override bool StaticDependenciesAreComputed => true;","+","+        public int Offset => 0;","+","+        protected internal override int Phase => (int)ObjectNodePhase.Ordered;","+        public override int ClassCode => (int)ObjectNodeOrder.UnboxingStubMapNode;","+","+        public void AppendMangledName(NameMangler nameMangler, Utf8StringBuilder sb)","+        {","+            sb.Append(nameMangler.CompilationUnitPrefix).Append(\"_unboxing_stub_map\"u8);","+        }","+","+        protected override string GetName(NodeFactory factory) => this.GetMangledName(factory.NameMangler);","+","+        public override ObjectData GetData(NodeFactory factory, bool relocsOnly = false)","+        {","+            // The data emission relies on the set of compiled methods which is incomplete during","+            // dependency tracking. This node doesn't keep anything alive - it only describes stubs","+            // that were generated for other reasons.","+            if (relocsOnly)","+            {","+                return new ObjectData(Array.Empty<byte>(), Array.Empty<Relocation>(), 1, new ISymbolDefinitionNode[] { this });","+            }","+","+            ObjectDataBuilder objData = new ObjectDataBuilder(factory, relocsOnly);","+            objData.RequireInitialPointerAlignment();","+            objData.AddSymbol(this);","+","+            ObjectDataBuilder.Reservation simpleCountReservation = objData.ReserveInt();","+            ObjectDataBuilder.Reservation instantiatingCountReservation = objData.ReserveInt();","+","+            int simpleCount = 0;","+            foreach (UnboxingStubNode stub in factory.MetadataManager.GetUnboxingStubs())","+            {","+                if (!stub.IsInstantiating)","+                {","+                    EmitPair(ref objData, factory, stub);","+                    simpleCount++;","+                }","+            }","+","+            int instantiatingCou