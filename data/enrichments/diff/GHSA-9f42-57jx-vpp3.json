{"id":"GHSA-9f42-57jx-vpp3","axis":"advisories","repo":"sporkmonger/addressable","sha":"f2b27b3ab252e56b3fa3519f7ebb491d54cf7b7c","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -19,6 +19,12 @@","   `?` and `&` expressions (e.g. `{/path*}`) on regex engines without match","   memoization, such as JRuby, TruffleRuby and MRI before 3.2; match results","   are unchanged (GHSA-j82w-28jv-3pmj)","+- fixes denial of service in `Addressable::Template#match` and `#extract`,","+  which backtracked polynomially or exponentially on the same regex engines","+  for expressions with several variables (e.g. `{/owner,repo,ref}`, or","+  `{+a,b,c}` with many variables), for `;` expressions, and for adjacent","+  expressions (e.g. `{+a}{+b}{+c}` or `{+a}{b}`); match results are unchanged","+  (GHSA-9f42-57jx-vpp3)"," - fixes `Addressable::URI#route_from` and `#route_to` raising","   `InvalidURIError` when the route's first segment contains a colon","   (e.g. `/a:b` from `/a`); the route is now `./a:b` ([#625])"],"additions":6,"deletions":0,"truncated":false},{"path":"lib/addressable/template.rb","lines":["@@ -968,6 +968,77 @@ def parse_template_pattern(pattern, processor = nil)","       end","     end"," ","+    ##","+    # Describes what follows each expression in a template pattern.","+    #","+    # @param [String] escaped_pattern The escaped URI template pattern.","+    #","+    # @return [Array<Array>] For each expression, the <tt>MatchData</tt> of","+    #   the expression directly after it (or <tt>nil</tt>), and whether the","+    #   text after it could start with a comma.","+    def expression_followers(escaped_pattern)","+      expressions = escaped_pattern.to_enum(:scan, EXPRESSION).map do","+        Regexp.last_match","+      end","+      expressions.each_with_index.map do |current, index|","+        following = expressions[index + 1]","+        following = nil unless following && following.begin(0) == current.end(0)","+        # Expressions can match nothing, so look past any that can't start","+        # with a comma.","+        position = current.end(0)","+        comma = expressions[(index + 1)..-1].any? do |later|","+          break false unless later.begin(0) == position","+          position = later.end(0)","+          may_start_with_comma?(later[1], later[2])","+        end","+        [following, comma || escaped_pattern[position] == ',']","+      end","+    end","+","+    ##","+    # Whether an expression could match a string that starts with a comma.","+    #","+    # @param [String, nil] operator The expression's operator.","+    # @param [String] varlist The expression's variable list.","+    #","+    # @return [TrueClass, FalseClass]","+    def may_start_with_comma?(operator, varlist)","+      return false unless LEADERS.fetch(operator, '').empty?","+      operator == '+' || !(varlist =~ VARSPEC && $2 != '*')","+    end","+","+    ##","+    # Whether an expression, followed directly by another one, could only","+    # match characters that the other one could also match, in any amount.","+    #","+    # @param [MatchData] following The expression that follows.","+    # @param [String, nil] operator The operator of the first expression.","+    # @param [Array<String>] varspecs The varspecs of the first expression.","+    #","+    # @return [TrueClass, FalseClass]","+    def absorbed_by?(following, operator, varspecs)","+      last = following[2].split(',').last","+      case following[1]","+      when '+'","+        # An unexploded last variable matches any characters that an","+        # expression can, and can end anywhere.","+        last[VARSPEC, 2] != '*'","+      when nil","+        if last[VARSPEC, 2] == '*'","+          # Matches any unreserved characters and commas.","+          operator.nil? || operator == '.'","+        elsif following[2] == last","+          # Matches any unreserved characters.","+          operator == '.' || (operator.nil? && varspecs.size == 1 &&","+            varspecs.first[VARSPEC, 2] != '*')","+        else","+          false","+        end","+      else","+        false","+      end","+    end","+","     ##","     # Generates the <tt>Regexp</tt> that parses a template pattern.","     #","@@ -988,20 +1059,34 @@ def parse_new_template_pattern(pattern, processor = nil)","       end"," ","       expansions = []","+      # Processor patterns can match anything, so they get 2.9.0's choices.","+      plain_processor = !(processor && processor.respond_to?(:match))","+      followers = expression_followers(escaped_pattern)"," ","       # Create a regular expression that captures the values of the","       # variables in the URI.","       regexp_string = escaped_pattern.gsub( EXPRESSION ) do |expansion|"," ","+        index = expansions.size","         expansions << expansion","         _, operator, varlist = *expansion.match(EXPRESSION)","         leader = Regexp.escape(LEADERS.fetch(operator, ''))","         joiner = Regexp.escape(JOINERS.fetch(operator, ','))","         varspecs = varlist.split(',')","-        combined = varspecs.map do |varspec|","+        results = varspecs.map do |varspec|","+          name = varspec[VARSPEC, 1]","+          processor && processor.respond_to?(:match) ? processor.match(name) : nil","+        end","+        # Without processor patterns, any variable in the expression can take","+        # the characters that an earlier variable leaves, which lets the","+        # variables after the first one have fewer choices below.","+        plain = results.compact.empty?","+        not_after_value =","+          \"(?<![#{Addressable::URI::CharacterClasses::UNRESERVED}])\"","+        combined = varspecs.each_with_index.map do |varspec, index|","           _, name, modifier = *varspec.match(VARSPEC)"," ","-          result = processor && processor.respond_to?(:match) ? processor.match(name) : nil","+          result = results[index]","           if result","             \"(?<#{name}>#{ result })\"","           else","@@ -1015,7 +1100,9 @@ def parse_new_template_pattern(pattern, processor = nil)","             when '.'","               \"#{ UNRESERVED.gsub('\\.', '') }*?\"","             when ';'","-              \"#{ UNRESERVED }*=?#{ UNRESERVED }*?\"","+              # The same strings, tried in the same order, as 2.9.0's","+              # \"U*=?U*?\", but a name without \"=\" can only match one way.","+              \"(?:#{UNRESERVED}*=#{UNRESERVED}*?|#{UNRESERVED}*)\"","             when '?'","               \"#{ UNRESERVED }*=#{ UNRESERVED }*?\"","             when '&'","@@ -1039,15 +1126,70 @@ def parse_new_template_pattern(pattern, processor = nil)","               # exponentially many ways, which backtracks catastrophically on","               # engines without match memoization (MRI < 3.2, JRuby,","               # TruffleRuby).","-              \"(?<#{name}>#{seg}(?:#{joiner}#{seg})*)?\"","+              value = \"#{seg}(?:#{joiner}#{seg})*\"","+            end","+            if operator == ';' && plain && index > 0","+              # Values were tried longest first, and splitting an earlier","+              # variable's run of characters with this one never gave a","+              # different result, so this one may only start after that run.","+              \"(?<#{name}>(?:#{not_after_value}#{value || group})?)\"","+            elsif modifier == '*'","+              \"(?<#{name}>#{value})?\"","             elsif varspecs.size > 1 && (operator == '+' || operator == '#') &&","                   varspec != varspecs.last","               \"(?<#{name}>#{RESERVED_NO_COMMA}*+)?\"","+            elsif plain && index < varspecs.size - 1 &&","+                  (operator.nil? || operator == '/' || operator == '.')","+              # Values were tried shortest first, so a run of characters","+              # without a joiner went to a later variable. The only other","+              # value that could change the result is the whole run up to the","+              # next joiner.","+              \"(?<#{name}>(?:#{group}(?=#{joiner}))??)\"","             else","               \"(?<#{name}>#{group})?\"","             end","           end","-        end.join(\"#{joiner}?\")","+        end","+        following, comma_follows = followers[index]","+        single = varspecs.size == 1 && varspecs.first[VARSPEC, 2] != '*'","+        if plain_processor && following &&","+            absorbed_by?(following, operator, varspecs)","+          # Each expression tried its empty alternative first. When the next","+          # one follows it directly and can match anything it could, followed","+          # by anything the next one could match on its own, every other","+          # choice ends where the empty one can also end, so the empty","+          # alternative always gave the first match.","+          leader = \"(?!)#{leader}\"","+          combined = combined.join(\"#{joiner}?\")","+        elsif plain_processor && single && following &&","+            following[1].nil? && following[2] =~ VARSPEC && $2 != '*' &&","+            (operator == '+' || operator == '#')","+          # Values were tried shortest first, and the next expression can","+          # match any unreserved characters, so the value only needs to end","+          # after a character that the next expression couldn't match.","+          combined = \"(?<#{varspecs.first[VARSPEC, 1]}>\" \\","+            \"#{RESERVED}*?#{not_after_value})?\"","+        elsif plain && varspecs.size > 1 &&","+            (operator == '+' || operator == '#') &&","+            !comma_follows &&","+            varspecs.none? { |varspec| varspec[VARSPEC, 2] == '*' } &&","+            !varspecs[0...-1].include?(varspecs.last)","+          # 2.9.0 tried each value with the joiner after it first, then the","+          # value on its own, then skipping the variable, and every other","+          # choice gave a value to a later variable that an earlier one had","+          # already been tried with. A variable after a skipped one is","+          # skipped too. Stopping before a joiner is left out, so this is","+          # only used when no joiner can follow the expression. As in 2.9.0,","+          # a variable is the last one if its varspec is the same as the","+          # last varspec.","+          nested = varspecs[0...-1].reverse.inject(\"\") do |inner, varspec|","+            \"(?:(?<#{varspec[VARSPEC, 1]}>#{RESERVED_NO_COMMA}*+)\" \\","+              \"#{joiner}?+#{inner}|(?=#{RESERVED_NO_COMMA}))\"","+          end","+          combined = nested + combined.last","+        else","+          combined = combined.join(\"#{joiner}?\")","+        end","         \"(?:|#{leader}#{combined})\"","       end"," "],"additions":147,"deletions":5,"truncated":false},{"path":"spec/addressable/template_match_spec.rb","lines":["@@ -21,48 +21,113 @@"," require \"addressable/template\""," "," module TemplateMatchSpec","-  UNRESERVED = Addressable::Template::UNRESERVED","-  RESERVED_NO_COMMA = Addressable::Template::RESERVED_NO_COMMA","-","-  # The exploded member patterns from Addressable 2.9.0. Members were joined","-  # by an optional joiner, except for the default operator.","-  LEGACY_MEMBERS = {","-    nil => \"#{UNRESERVED}*?\",","-    \"+\" => \"#{RESERVED_NO_COMMA}*+\",","-    \"#\" => \"#{RESERVED_NO_COMMA}*+\",","-    \"/\" => \"#{UNRESERVED}*?\",","-    \".\" => \"#{UNRESERVED.gsub('\\.', '')}*?\",","-    \";\" => \"#{UNRESERVED}*=?#{UNRESERVED}*?\",","-    \"?\" => \"#{UNRESERVED}*=#{UNRESERVED}*?\",","-    \"&\" => \"#{UNRESERVED}*=#{UNRESERVED}*?\"","-  }","+  OPERATORS = [nil, \"+\", \"#\", \"/\", \".\", \";\", \"?\", \"&\"]"," ","-  def self.leader(operator)","-    Addressable::Template::LEADERS.fetch(operator, \"\")","+  # Addressable 2.9.0's Template#parse_new_template_pattern, kept verbatim as","+  # a compatibility oracle. The constants it uses have not changed.","+  LEGACY_PARSE_NEW_TEMPLATE_PATTERN = <<-'RUBY'","+    def parse_new_template_pattern(pattern, processor = nil)","+      # Escape the pattern. The two gsubs restore the escaped curly braces","+      # back to their original form. Basically, escape everything that isn't","+      # within an expansion.","+      escaped_pattern = Regexp.escape(","+        pattern","+      ).gsub(/\\\\\\{(.*?)\\\\\\}/) do |escaped|","+        escaped.gsub(/\\\\(.)/, \"\\\\1\")","+      end","+","+      expansions = []","+","+      # Create a regular expression that captures the values of the","+      # variables in the URI.","+      regexp_string = escaped_pattern.gsub( EXPRESSION ) do |expansion|","+","+        expansions << expansion","+        _, operator, varlist = *expansion.match(EXPRESSION)","+        leader = Regexp.escape(LEADERS.fetch(operator, ''))","+        joiner = Regexp.escape(JOINERS.fetch(operator, ','))","+        varspecs = varlist.split(',')","+        combined = varspecs.map do |varspec|","+          _, name, modifier = *varspec.match(VARSPEC)","+","+          result = processor && processor.respond_to?(:match) ? processor.match(name) : nil","+          if result","+            \"(?<#{name}>#{ result })\"","+          else","+            group = case operator","+            when '+'","+              \"#{ RESERVED }*?\"","+            when '#'","+              \"#{ RESERVED }*?\"","+            when '/'","+              \"#{ UNRESERVED }*?\"","+            when '.'","+              \"#{ UNRESERVED.gsub('\\.', '') }*?\"","+            when ';'","+              \"#{ UNRESERVED }*=?#{ UNRESERVED }*?\"","+            when '?'","+              \"#{ UNRESERVED }*=#{ UNRESERVED }*?\"","+            when '&'","+              \"#{ UNRESERVED }*=#{ UNRESERVED }*?\"","+            else","+              \"#{ UNRESERVED }*?\"","+            end","+            if modifier == '*'","+              seg = case operator","+                    when '+', '#' then \"#{RESERVED_NO_COMMA}*+\"","+                    else group","+                    end","+              joiner_pattern = operator.nil? ? joiner : \"#{joiner}?\"","+              \"(?<#{name}>#{seg}(?:#{joiner_pattern}#{seg})*)?\"","+            elsif varspecs.size > 1 && (operator == '+' || operator == '#') &&","+                  varspec != varspecs.last","+              \"(?<#{name}>#{RESERVED_NO_COMMA}*+)?\"","+            else","+              \"(?<#{name}>#{group})?\"","+            end","+          end","+        end.join(\"#{joiner}?\")","+        \"(?:|#{leader}#{combined})\"","+      end","+","+      # Ensure that the regular expression matches the whole URI.","+      regexp_string = \"\\\\A#{regexp_string}\\\\z\"","+      return expansions, Regexp.new(regexp_string)","+    end","+  RUBY","+","+  module Legacy","+    %w[","+      EXPRESSION VARSPEC LEADERS JOINERS RESERVED RESERVED_NO_COMMA UNRESERVED","+    ].each do |name|","+      const_set(name, Addressable::Template.const_get(name))","+    end","+","+    module_eval(LEGACY_PARSE_NEW_TEMPLATE_PATTERN)","+    extend self","   end"," ","-  def self.joiner(operator)","-    Addressable::Template::JOINERS.fetch(operator, \",\")","+  def self.legacy_regexp(pattern)","+    Legacy.parse_new_template_pattern(pattern)[1]","   end"," ","-  # The regular expression 2.9.0 generated for \"{<operator>a*}\".","-  def self.legacy_expression(operator)","-    member = LEGACY_MEMBERS.fetch(operator)","-    joiner = Regexp.escape(joiner(operator))","-    joiner = \"#{joiner}?\" unless operator.nil?","-    \"(?:|#{Regexp.escape(leader(operator))}\" \\","-      \"(?<a>#{member}(?:#{joiner}#{member})*)?)\"","+  def self.regexp(pattern)","+    Addressable::Template.new(pattern).send(:parse_template_pattern, pattern)[1]","   end"," ","-  # The regular expression generated now for \"{<operator>a*}\".","-  def self.expression(operator)","-    pattern = \"{#{operator}a*}\"","-    _, regexp = Addressable::Template.new(pattern).send(","-      :parse_template_pattern, pattern","-    )","+  # The expression without the \\A and \\z anchors around the whole template.","+  def self.unanchored(regexp)","     regexp.source[/\\A\\\\A(.*)\\\\z\\z/m, 1]","   end"," ","+  def self.leader(operator)","+    Addressable::Template::LEADERS.fetch(operator, \"\")","+  end","+","+  def self.joiner(operator)","+    Addressable::Template::JOINERS.fetch(operator, \",\")","+  end","+","   # Every position at which the expression can stop matching a prefix of the","   # string, in the order that the regular expression engine tries them. Two","   # expressions that give the same order behave the same way wherever they","@@ -88,9 +153,14 @@ def self.strings(alphabet, max_length)","       alphabet.repeated_permutation(length).map(&:join)","     end.uniq","   end","+","+  def self.alphabet(operator, *extra)","+    ([leader(operator), joiner(operator), \"a\", \"=\", \"%41\"] + extra).","+      reject(&:empty?).uniq","+  end"," end"," ","-describe Addressable::Template, \"#match with exploded variables\" do","+describe Addressable::Template, \"#match\" do","   context \"compared with 2.9.0\" do","     {","       [\"{;b*}\", \";b==a\"] => {\"b\" => {\"b\" => \"\"}},","@@ -114,7 +184,55 @@ def self.strings(alphabet, max_length)","       },","       [\"{/a*}{/b}\", \"/x/y/z\"] => {\"a\" => [\"x\", \"y\", \"z\"], \"b\" => nil},","       [\"{.a*}{.b}\", \".x.y.z\"] => {\"a\" => [\"x\", \"y\", \"z\"], \"b\" => nil},","-      [\"{a*}{b}\", \"x,y,z\"] => {\"a\" => [\"x,y,\"], \"b\" => \"z\"}","+      [\"{a*}{b}\", \"x,y,z\"] => {\"a\" => [\"x,y,\"], \"b\" => \"z\"},","+      # With several variables, a value without a joiner goes to the last","+      # variable for /, . and the default operator...","+      [\"{/a,b,c}\", \"/x\"] => {\"a\" => \"\", \"b\" => \"\", \"c\" => \"x\"},","+      [\"{/a,b,c}\", \"/x/y\"] => {\"a\" => \"\", \"b\" => \"x\", \"c\" => \"y\"},","+      [\"{.a,b}.json\", \".x.json\"] => {\"a\" => \"\", \"b\" => \"x\"},","+      [\"{a,b,c}\", \"x,y\"] => {\"a\" => \"\", \"b\" => \"x\", \"c\" => \"y\"},","+      [\"{/a,b*}\", \"/x/y\"] => {\"a\" => \"\", \"b\" => [\"x\", \"y\"]},","+      # ...and to the first variable for ;.","+      [\"{;a,b}\", \";a=1\"] => {\"a\" => \"\", \"b\" => nil, \"1\" => \"\"},","+      [\"{;a,b}\", \";a=1;b=2\"] => {\"a\" => \"1\", \"b\" => \"2\"},","+      [\"{;a,b*}x\", \";ax\"] => {\"a\" => \"\", \"b\" => {}},","+      # An expression directly followed by one that can match anything it","+      # could is empty.","+      [\"{+a}{+b}{+c}\", \"xyz\"] => {\"a\" => nil, \"b\" => nil, \"c\" => \"xyz\"},","+      [\"{+a}{+b}{+c}\", \"x,y/z\"] => {\"a\" => nil, \"b\" => nil, \"c\" => \"x,y/z\"},","+      [\"{+a}{+b}x\", \"pqx\"] => {\"a\" => nil, \"b\" => \"pq\"},","+      [\"{a}{b}{c}\", \"xyz\"] => {\"a\" => nil, \"b\" => nil, \"c\" => \"xyz\"},","+      [\"{.a,b}{c}\", \".x.yz\"] => {\"a\" => nil, \"b\" => nil, \"c\" => \".x.yz\"},","+      [\"{/a}{+b}\", \"/x/y\"] => {\"a\" => nil, \"b\" => \"/x/y\"},","+      [\"{a}{+b}{c}{+d}\", \"w/x\"] => {","+        \"a\" => nil, \"b\" => nil, \"c\" => nil, \"d\" => \"w/x\"","+      },","+      [\"{+a,b}{+c,d}\", \"x,y,z\"] => {","+        \"a\" => nil, \"b\" => nil, \"c\" => \"x\", \"d\" => \"y,z\"","+      },","+      [\"{#a,b}{+c,d}\", \"#x,y\"] => {","+        \"a\" => nil, \"b\" => nil, \"c\" => \"#x\", \"d\" => \"y\"","+      },","+      [\"{a,b}{c*}\", \"x,y,z\"] => {\"a\" => nil, \"b\" => nil, \"c\" => [\"x,y,z\"]},","+      [\"{.a}{c*}\", \".x,y\"] => {\"a\" => nil, \"c\" => [\".x,y\"]},","+      [\"{a*}{c,d*}\", \"x,y\"] => {\"a\" => nil, \"c\" => \"\", \"d\" => [\"x,y\"]},","+      # An exploded {+b*} only ends where a run of characters ends.","+      [\"{+a}{+b*}x\", \"p,qx\"] => {\"a\" => \"p,q\", \"b\" => nil},","+      # {b} can't match \"/\", so {+a} isn't always empty.","+      [\"{+a}{b}\", \"p/q\"] => {\"a\" => \"p/\", \"b\" => \"q\"},","+      [\"{+a}{b}\", \"p/qr\"] => {\"a\" => \"p/\", \"b\" => \"qr\"},","+      [\"{#a}{b}\", \"#p/q\"] => {\"a\" => \"p/\", \"b\" => \"q\"},","+      # In + and # expressions, the earlier