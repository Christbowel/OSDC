{"id":"583f02ac6d3731c45305779c8f936159013e290e","axis":"silent","repo":"pnpm/pnpm","sha":"583f02ac6d3731c45305779c8f936159013e290e","parsed":{"files":[{"path":".changeset/pnpr-audit-fixes.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+New auth files default to 0600 permissions on Unix. Login requests on disabled registration return 401 to prevent user enumeration. Passwords exceeding 71 bytes are rejected to prevent bcrypt truncation. Published package versions remain immutable across partial unpublish requests."],"additions":5,"deletions":0,"truncated":false},{"path":"Cargo.lock","lines":["@@ -6992,6 +6992,7 @@ dependencies = [","  \"getrandom 0.4.3\",","  \"libc\",","  \"object_store\",","+ \"percent-encoding\",","  \"pnpm-crypto-hash\",","  \"pnpm-network\",","  \"pnpr-config\","],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/auth/src/htpasswd.rs","lines":["@@ -81,7 +81,24 @@ pub(super) fn write_atomic(path: &Path, bytes: &[u8]) -> Result<()> {","     }","     let tmp = unique_tmp_path(path);","     {","-        let mut file = std::fs::File::create(&tmp)?;","+        #[cfg(unix)]","+        let mut file = {","+            use std::os::unix::fs::{OpenOptionsExt as _, PermissionsExt as _};","+            let mode = match std::fs::symlink_metadata(path) {","+                Ok(meta) if !meta.file_type().is_symlink() => meta.permissions().mode(),","+                _ => 0o600,","+            };","+            std::fs::OpenOptions::new()","+                .write(true)","+                .create_new(true)","+                .mode(mode)","+                .open(&tmp)?","+        };","+        #[cfg(not(unix))]","+        let mut file = std::fs::OpenOptions::new()","+            .write(true)","+            .create_new(true)","+            .open(&tmp)?;","         file.write_all(bytes)?;","         file.sync_all()?;","     }","@@ -108,12 +125,19 @@ pub(super) fn unique_tmp_path(base: &Path) -> PathBuf {"," // bcrypt helpers"," // ---------------------------------------------------------------"," ","+const DUMMY_BCRYPT_BODY: &str = \"L6Bc/AlTQHyd9liGgGEZyOFLPHNgyxeEPfgYfBCVxJ7JIlwxyVU3u\";","+","+pub(super) async fn dummy_verify(password: &str, cost: u32) {","+    let dummy_hash = format!(\"$2y${:02}${DUMMY_BCRYPT_BODY}\", cost.clamp(4, 31));","+    let _ = verify_bcrypt(password.to_string(), dummy_hash).await;","+}","+"," /// Hash a password off the reactor — bcrypt at cost 10 takes"," /// ~50–100 ms and stalls every other async task on the same thread"," /// if run inline."," pub(super) async fn hash_bcrypt(password: String, cost: u32) -> Result<String> {","     tokio::task::spawn_blocking(move || {","-        let parts = bcrypt::hash_with_result(&password, cost)?;","+        let parts = bcrypt::non_truncating_hash_with_result(&password, cost)?;","         // Format as $2y$ for maximum cross-tool compatibility —","         // Apache's `htpasswd -B` writes $2y$, GNU coreutils tools","         // accept it, and bcrypt::verify reads any of $2a/$2b/$2y.","@@ -124,8 +148,10 @@ pub(super) async fn hash_bcrypt(password: String, cost: u32) -> Result<String> {"," "," /// Whether `password` matches the bcrypt `hash`."," pub async fn verify_bcrypt(password: String, hash: String) -> Result<bool> {","-    tokio::task::spawn_blocking(move || {","-        bcrypt::verify(&password, &hash).map_err(RegistryError::from)","+    tokio::task::spawn_blocking(move || match bcrypt::non_truncating_verify(&password, &hash) {","+        Ok(valid) => Ok(valid),","+        Err(bcrypt::BcryptError::Truncation(_)) => Ok(false),","+        Err(err) => Err(RegistryError::from(err)),","     })","     .await?"," }"],"additions":30,"deletions":4,"truncated":false},{"path":"pnpr/crates/auth/src/lib.rs","lines":["@@ -33,9 +33,13 @@ pub use owned_tokens::OwnedTokens;"," pub use token_store::{TokenRecord, TokenStore};"," pub use user_store::UserStore;"," ","+/// Maximum password length accepted by pnpr to prevent bcrypt