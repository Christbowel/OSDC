     .mode()","+        & 0o777;","+    assert_eq!(perms, 0o640);","+}","+","+#[cfg(unix)]","+#[test]","+fn token_store_sets_0600_permissions_on_sqlite_file() {","+    use std::os::unix::fs::PermissionsExt as _;","+","+    let dir = tempfile::tempdir().unwrap();","+    let path = dir.path().join(\"tokens.db\");","+    let _store = TokenStore::open(path.clone()).unwrap();","+","+    let perms = std::fs::metadata(&path)","+        .unwrap()","+        .permissions()","+        .mode()","+        & 0o777;","+    assert_eq!(perms, 0o600);","+","+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o640)).unwrap();","+    let _store2 = TokenStore::open(path.clone()).unwrap();","+    let perms2 = std::fs::metadata(&path)","+        .unwrap()","+        .permissions()","+        .mode()","+        & 0o777;","+    assert_eq!(perms2, 0o640);","+}","+","+#[tokio::test]","+async fn verify_bcrypt_handles_passwords_exceeding_72_bytes() {","+    let password_71 = \"a\".repeat(71);","+    let hash = super::hash_bcrypt(password_71.clone(), TEST_COST).await.unwrap();","+","+    assert!(super::verify_bcrypt(password_71, hash.clone()).await.unwrap());","+","+    // 72-byte password must safely evaluate to false without error or truncation-match.","+    let password_72 = \"a\".repeat(72);","+    assert!(!super::verify_bcrypt(password_72, hash).await.unwrap());","+}"],"additions":66,"deletions":2,"truncated":false},{"path":"pnpr/crates/auth/src/token_store.rs","lines":["@@ -102,6 +102,17 @@ impl TokenStore {","         {","             std::fs::create_dir_all(parent)?;","         }","+        #[cfg(unix)]","+        {","+            use std::os::unix::fs::OpenOptionsExt as _;","+            if !path.exists() {","+                let _ = std::fs::OpenOptions::new()","+                    .write(true)","+                    .create_new(true)","+                    .mode(0o600)","+                    .open(&path);","+            }","+        }","         let conn = Connecti