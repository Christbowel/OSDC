{"id":"a4b0cc65a5654b9685a97483187fd6aeeaf3ea0d","axis":"silent","repo":"electron/electron","sha":"a4b0cc65a5654b9685a97483187fd6aeeaf3ea0d","parsed":{"files":[{"path":"BUILD.gn","lines":["@@ -477,6 +477,102 @@ action(\"electron_generate_node_defines\") {","   args = [ rebase_path(target_gen_dir) ] + rebase_path(inputs)"," }"," ","+action(\"electron_generate_preload_realm_bindings\") {","+  script = \"build/generate_preload_realm_bindings.py\"","+","+  core_idl_files = [","+    \"//third_party/blink/renderer/core/dom/abort_controller.idl\",","+    \"//third_party/blink/renderer/core/dom/abort_signal.idl\",","+    \"//third_party/blink/renderer/core/dom/dom_exception.idl\",","+    \"//third_party/blink/renderer/core/dom/events/custom_event.idl\",","+    \"//third_party/blink/renderer/core/dom/events/event.idl\",","+    \"//third_party/blink/renderer/core/dom/events/event_target.idl\",","+    \"//third_party/blink/renderer/core/dom/observable.idl\",","+    \"//third_party/blink/renderer/core/dom/quota_exceeded_error.idl\",","+    \"//third_party/blink/renderer/core/dom/subscriber.idl\",","+    \"//third_party/blink/renderer/core/dom/void_function.idl\",","+    \"//third_party/blink/renderer/core/events/error_event.idl\",","+    \"//third_party/blink/renderer/core/events/promise_rejection_event.idl\",","+    \"//third_party/blink/renderer/core/frame/universal_global_scope.idl\",","+    \"//third_party/blink/renderer/core/messaging/structured_serialize_options.idl\",","+    \"//third_party/blink/renderer/core/streams/byte_length_queuing_strategy.idl\",","+    \"//third_party/blink/renderer/core/streams/count_queuing_strategy.idl\",","+    \"//third_party/blink/renderer/core/streams/readable_byte_stream_controller.idl\",","+    \"//third_party/blink/renderer/core/streams/readable_stream.idl\",","+    \"//third_party/blink/renderer/core/streams/readable_stream_byob_reader.idl\",","+    \"//third_party/blink/renderer/core/streams/readable_stream_byob_request.idl\",","+    \"//third_party/blink/renderer/core/streams/readable_stream_default_controller.idl\",","+    \"//third_party/blink/renderer/core/streams/readable_stream_default_reader.idl\",","+    \"//third_party/blink/renderer/core/streams/transform_stream.idl\",","+    \"//third_party/blink/renderer/core/streams/transform_stream_default_controller.idl\",","+    \"//third_party/blink/renderer/core/streams/writable_stream.idl\",","+    \"//third_party/blink/renderer/core/streams/writable_stream_default_controller.idl\",","+    \"//third_party/blink/renderer/core/streams/writable_stream_default_writer.idl\",","+    \"//third_party/blink/renderer/core/url/url.idl\",","+    \"//third_party/blink/renderer/core/url/url_search_params.idl\",","+    \"//third_party/blink/renderer/core/url_pattern/url_pattern.idl\",","+  ]","+  modules_idl_files = [","+    \"//third_party/blink/renderer/modules/compression/compression_stream.idl\",","+    \"//third_party/blink/renderer/modules/compression/decompression_stream.idl\",","+    \"//third_party/blink/renderer/modules/encoding/text_decoder.idl\",","+    \"//third_party/blink/renderer/modules/encoding/text_decoder_stream.idl\",","+    \"//third_party/blink/renderer/modules/encoding/text_encoder.idl\",","+    \"//third_party/blink/renderer/modules/encoding/text_encoder_stream.idl\",","+  ]","+  idl_file = \"shell/renderer/preload_realm_global_scope.idl\"","+  runtime_enabled_features =","+      \"//third_party/blink/renderer/platform/runtime_enabled_features.json5\"","+  wrapper_type_info_header =","+      \"//third_party/blink/renderer/platform/bindings/wrapper_type_info.h\"","+","+  inputs = [","+             idl_file,","+             runtime_enabled_features,","+             wrapper_type_info_header,","+           ] + core_idl_files + modules_idl_files","+","+  # Read Blink's own .pydeps files directly instead of using action_with_pydeps","+  # (which expects a checked-in build/generate_preload_realm_bindings.pydeps)","+  # so we automatically pick up upstream Blink bindings script changes on rolls","+  # without manually maintaining a duplicate .pydeps file in //electron.","+  _blink_scripts_dir = \"//third_party/blink/renderer/bindings/scripts\"","+  _pydeps_files = [","+    \"$_blink_scripts_dir/collect_idl_files.pydeps\",","+    \"$_blink_scripts_dir/generate_bindings.pydeps\",","+  ]","+  _pydeps_lines = []","+  foreach(_pydeps_file, _pydeps_files) {","+    _pydeps_lines += read_file(_pydeps_file, \"list lines\")","+  }","+  _pydeps_entries = filter_exclude(_pydeps_lines, [ \"#*\" ])","+  inputs +=","+      rebase_path(_pydeps_entries, \".\", _blink_scripts_dir) + _pydeps_files","+","+  outputs = [","+    \"$target_gen_dir/preload_realm/v8_preload_realm_global_scope.cc\",","+    \"$target_gen_dir/preload_realm/v8_preload_realm_global_scope.h\",","+  ]","+","+  args =","+      [","+        \"--root-src-dir\",","+        rebase_path(\"//\", root_build_dir),","+        \"--root-gen-dir\",","+        rebase_path(root_gen_dir, root_build_dir),","+        \"--output-reldir\",","+        rebase_path(\"$target_gen_dir/preload_realm\", root_gen_dir),","+        \"--idl-file\",","+        rebase_path(idl_file, root_build_dir),","+        \"--runtime-enabled-features\",","+        rebase_path(runtime_enabled_features, root_build_dir),","+        \"--wrapper-type-info-header\",","+        rebase_path(wrapper_type_info_header, root_build_dir),","+        \"--core-idl-files\",","+      ] + rebase_path(core_idl_files, root_build_dir) +","+      [ \"--modules-idl-files\" ] + rebase_path(modules_idl_files, root_build_dir)","+}","+"," source_set(\"electron_lib\") {","   configs += [","     \"//v8:external_startup_data\",","@@ -491,6 +587,7 @@ source_set(\"electron_lib\") {","   deps = [","     \":electron_fuses\",","     \":electron_generate_node_defines\",","+    \":electron_generate_preload_realm_bindings\",","     \":electron_js2c\",","     \":electron_version_header\",","     \":resources\",","@@ -633,7 +730,8 @@ source_set(\"electron_lib\") {"," ","   deps += [ \"//electron/build/config:generate_mas_config\" ]"," ","-  sources = filenames.lib_sources","+  sources = filenames.lib_sources +","+            get_target_outputs(\":electron_generate_preload_realm_bindings\")","   if (is_win) {","     sources += filenames.lib_sources_win","   }"],"additions":99,"deletions":1,"truncated":false},{"path":"build/generate_preload_realm_bindings.py","lines":["@@ -0,0 +1,256 @@","+#!/usr/bin/env python3","+\"\"\"Generates Blink V8 bindings for PreloadRealmGlobalScope.\"\"\"","+","+import argparse","+import os","+import sys","+import tempfile","+","+","+def setup_blink_paths(root_src_dir):","+  module_dirs = (","+      os.path.join(root_src_dir, 'third_party', 'blink', 'renderer', 'bindings',","+                   'scripts'),","+      os.path.join(root_src_dir, 'third_party', 'blink', 'renderer', 'build',","+                   'scripts'),","+      os.path.join(root_src_dir, 'third_party', 'mako', 'mako'),","+      os.path.join(root_src_dir, 'tools'),","+  )","+  for module_dir in reversed(module_dirs):","+    if module_dir not in sys.path:","+      sys.path.insert(1, module_dir)","+","+","+# Interfaces that should be [Exposed=*] per spec (crbug.com/41480387 and","+# crbug.com/40282760) and are exposed on PreloadRealmGlobalScope in addition","+# to constructs already marked [Exposed=*].","+PRELOAD_REALM_EXPOSED_INTERFACES = frozenset([","+    'AbortController',","+    'AbortSignal',","+    'CompressionStream',","+    'CustomEvent',","+    'DOMException',","+    'DecompressionStream',","+    'ErrorEvent',","+    'Event',","+    'EventTarget',","+    'Observable',","+    'PromiseRejectionEvent',","+    'Subscriber',","+    'TextDecoder',","+    'TextDecoderStream',","+    'TextEncoder',","+    'TextEncoderStream',","+    'URL',","+    'URLPattern',","+    'URLSearchParams',","+])","+","+","+def main():","+  parser = argparse.ArgumentParser()","+  parser.add_argument('--root-src-dir', required=True)","+  parser.add_argument('--root-gen-dir', required=True)","+  parser.add_argument('--output-reldir', required=True)","+  parser.add_argument('--idl-file', required=True)","+  parser.add_argument('--runtime-enabled-features', required=True)","+  parser.add_argument('--wrapper-type-info-header', required=True)","+  parser.add_argument('--core-idl-files', nargs='+', required=True)","+  parser.add_argument('--modules-idl-files', nargs='+', required=True)","+  options = parser.parse_args()","+","+  import re","+  with open(options.wrapper_type_info_header, encoding='utf-8') as f:","+    wti_content = f.read()","+  start_match = re.search(","+      r'static_assert\\(kScriptWrappableStartTag\\s*==\\s*(\\d+)\\)', wti_content)","+  last_match = re.search(","+      r'kLastGeneratedScriptWrappableTag\\s*=\\s*(\\d+)', wti_content)","+  assert start_match and last_match, (","+      'Could not parse ScriptWrappable tag bounds from wrapper_type_info.h')","+  start_tag = int(start_match.group(1))","+  last_generated_tag = int(last_match.group(1))","+  assert last_generated_tag - start_tag >= 1600, (","+      f'ScriptWrappable tag range [{start_tag}, {last_generated_tag}) is too '","+      'narrow; verify kLastGeneratedScriptWrappableTag - 1 does not collide.')","+","+  setup_blink_paths(options.root_src_dir)","+","+  import bind_gen","+  from bind_gen import codegen_expr","+  from bind_gen import codegen_utils","+  from bind_gen.interface import generate_class_like","+  from idl_parser import idl_lexer","+  from idl_parser import idl_parser","+  import web_idl","+  from web_idl.idl_compiler import IdlCompiler","+  from web_idl.idl_type import IdlTypeFactory","+  from web_idl.ir_builder import load_and_register_idl_definitions","+  from web_idl.ir_map import IRMap","+  from web_idl.reference import RefByIdFactory","+","+  lexer = idl_lexer.IDLLexer()","+  idl_file_parser = idl_parser.IDLParser(lexer)","+","+  def strip_non_global_defs(ast_node):","+    # Only Interface, InterfaceMixin (for UniversalGlobalScope), Includes,","+    # Dictionary (for StructuredSerializeOptions), and Callback (for","+    # VoidFunction) are needed to compile PreloadRealmGlobalScope. Stripping","+    # members and auxiliary definitions from the exposed interface files avoids","+    # pulling in their transitive argument/attribute types and mixins.","+    children = getattr(ast_node, '_children', None)","+    if not children:","+      return ast_node","+    kept = []","+    for child in children:","+      cls = child.GetClass()","+      name = child.GetName()","+      if cls == 'Interface':","+        if not child.GetProperty('MIXIN') and name != 'PreloadRealmGlobalScope':","+          child._children = [","+              c for c in (child._children or [])","+              if c.GetClass() == 'ExtAttributes'","+          ]","+        kept.append(child)","+      elif cls == 'Includes' and name == 'PreloadRealmGlobalScope':","+        kept.append(child)","+      elif cls == 'Dictionary' and name == 'StructuredSerializeOptions':","+        kept.append(child)","+      elif cls == 'Callback' and name == 'VoidFunction':","+        kept.append(child)","+    ast_node._children = kept","+    return ast_node","+","+  core_ast = web_idl.AstGroup(","+      component=web_idl.Component('core'),","+      for_testing=False,","+  )","+  for filepath in options.core_idl_files:","+    core_ast.add_ast_node(","+        strip_non_global_defs(idl_parser.ParseFile(idl_file_parser, filepath)))","+","+  modules_ast = web_idl.AstGroup(","+      component=web_idl.Component('modules'),","+      for_testing=False,","+  )","+  for filepath in list(options.modules_idl_files) + [options.idl_file]:","+    modules_ast.add_ast_node(","+        strip_non_global_defs(idl_parser.ParseFile(idl_file_parser, filepath)))","+","+  with tempfile.NamedTemporaryFile(suffix='.pickle', delete=False) as tmp_core:","+    tmp_core_path = tmp_core.name","+  with tempfile.NamedTemporaryFile(","+      suffix='.pickle', delete=False) as tmp_modules:","+    tmp_modules_path = tmp_modules.name","+  with tempfile.NamedTemporaryFile(suffix='.pickle', delete=False) as tmp_db:","+    tmp_db_path = tmp_db.name","+","+  try:","+    core_ast.write_to_file(tmp_core_path)","+    modules_ast.write_to_file(tmp_modules_path)","+","+    web_idl.init(","+        runtime_enabled_features_paths=[options.runtime_enabled_features])","+","+    ir_map = IRMap()","+    ref_to_idl_def_factory = RefByIdFactory()","+    idl_type_factory = IdlTypeFactory()","+","+    load_and_register_idl_definitions(","+        filepaths=[tmp_core_path, tmp_modules_path],","+        register_ir=ir_map.register,","+        create_ref_to_idl_def=ref_to_idl_def_factory.create,","+        idl_type_factory=idl_type_factory,","+    )","+","+    for ir in ir_map.irs_of_kind(IRMap.IR.Kind.INTERFACE):","+      if ir.identifier in PRELOAD_REALM_EXPOSED_INTERFACES:","+        ir.exposure.add_global_name_and_feature('PreloadRealm')","+","+    errors = []","+    compiler = IdlCompiler(","+        ir_map=ir_map,","+        ref_to_idl_def_factory=ref_to_idl_def_factory,","+        idl_type_factory=idl_type_factory,","+        report_error=errors.append,","+    )","+    database = compiler.build_database()","+    if errors:","+      sys.exit('\\n'.join(errors))","+","+    preload_iface = database.find(web_idl.Identifier('PreloadRealmGlobalScope'))","+    preload_iface._code_generator_info._blink_headers = (","+        'electron/shell/renderer/preload_realm_global_scope.h',)","+    # Use `blink::kLastGeneratedScriptWrappableTag - 1` so the tag automatically","+    # tracks Blink's generated ScriptWrappable tag upper bound in","+    # wrapper_type_info.h.","+    preload_tag_expr = 'blink::kLastGeneratedScriptWrappableTag - 1'","+    preload_iface._tag = preload_tag_expr","+    preload_iface._max_subclass_tag = preload_tag_expr","+","+    database.write_to_file(tmp_db_path)","+","+    # 3. Configure bind_gen to emit single-component bindings into output_reldir","+    #    without MODULES_EXPORT DLL macro annotations.","+    orig_expr_from_exposure = codegen_expr.expr_from_exposure","+","+    def patched_expr_from_exposure(exposure, **kwargs):","+      if any(e.global_name == 'PreloadRealm'","+             for e in exposure.global_names_and_features) and not kwargs.get(","+                 'global_names'):","+        return codegen_expr._Expr('true')","+      return orig_expr_from_exposure(exposure, **kwargs)","+","+    codegen_expr.expr_from_exposure = patched_expr_from_exposure","+    bind_gen.interface.expr_from_exposure = patched_expr_from_exposure","+    codegen_utils.component_export = lambda component, for_testing: ''","+    bind_gen.interface.component_export = codegen_utils.component_export","+    codegen_utils.component_export_header = lambda component, for_testing: None","+    bind_gen.interface.component_export_header = (","+        codegen_utils.component_export_header)","+","+    from bind_gen.union_name_mapper import UnionNameMapper","+    UnionNameMapper.init = classmethod(","+        lambda cls, filename, database: cls.init_with_config_text('', database))","+","+    component_reldirs = {","+        web_idl.Component('core'):","+            'third_party/blink/renderer/bindings/core/v8',","+        web_idl.Component('modules'):","+            'third_party/blink/renderer/bindings/modules/v8',","+    }","+    bind_gen.init(","+        web_idl_database_path=tmp_db_path,","+        root_src_dir=options.root_src_dir,","+        root_gen_dir=options.root_gen_dir,","+        component_reldirs=component_reldirs,","+        enable_style_format=False,","+        enable_code_generation_tracing=False,","+    )","+","+    # Route PreloadRealmGlobalScope's own output files to Electron's gen dir","+    # while keeping core/modules paths intact for #include references to Blink","+    # interfaces.","+    from bind_gen.path_manager import PathManager","+    orig_path_manager_init = PathManager.__init__","+","+    def patched_path_manager_init(self, idl_definition):","+      orig_path_manager_init(self, idl_definition)","+      if getattr(idl_definition, 'identifier',","+                 None) == 'PreloadRealmGlobalScope':","+        norm_out = os.path.normpath(options.output_reldir).replace('\\\\', '/')","+        self._api_dir = norm_out","+        self._impl_dir = norm_out","+","+    PathManager.__init__ = patched_path_manager_init","+","+    db = bind_gen.package_initializer.package_initializer().web_idl_database()","+    generate_class_like(db.find(web_idl.Identifier('PreloadRealmGlobalScope')))","+  finally:","+    for path in (tmp_core_path, tmp_modules_path, tmp_db_path):","+      if os.path.exists(path):","+        os.remove(path)","+","+","+if __name__ == '__main__':","+  main()"],"additions":256,"deletions":0,"truncated":false},{"path":"filenames.gni","lines":["@@ -829,6 +829,8 @@ filenames = {","     \"shell/renderer/preload_environment.h\",","     \"shell/renderer/preload_realm_context.cc\",","     \"shell/renderer/preload_realm_context.h\",","+    \"shell/renderer/preload_realm_global_scope.cc\",","+    \"shell/renderer/preload_realm_global_scope.h\",","     \"shell/renderer/preload_utils.cc\",","     \"shell/renderer/preload_utils.h\",","     \"shell/renderer/renderer_client_base.cc\","],"additions":2,"deletions":0,"truncated":false},{"path":"patches/chromium/.patches","lines":["@@ -139,4 +139,5 @@ fix_plumb_the_requesting_frame_through_pointer_lock_requests.patch"," feat_let_the_host_of_a_remote_nswindow_set_more_of_its_behavior.patch"," device_make_devicemonitormessagewindow_a_nodestructor.patch"," fix_handle_a_null_pending_call_in_dbus_objectproxy.patch","-feat_add_preloadrealmglobalscope.patch","+feat_update_executioncontext_api.patch","+use_forward_slashes_for_the_default_crdtp_include_dir_in_templates.patch"],"additions":2,"deletions":1,"truncated":false},{"path":"patches/chromium/feat_add_preloadrealmglobalscope.patch","lines":["@@ -1,686 +0,0 @@","-From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001","-From: Samuel Maddock <samuel.maddock@gmail.com>","-Date: Tue, 20 Oct 2026 18:54:12 +0000","-Subject: feat: add PreloadRealmGlobalScope","-","-Electron runs service worker preload scripts in a context of their own on","-the worker's thread. That context used to be a Blink ShadowRealmGlobalScope,","-which exists for the TC39 ShadowRealm proposal. The proposal has stalled, so","-Chromium may remove its implementation.","-","-PreloadRealmGlobalScope is a global scope for that context which does not","-depend on any ShadowRealm code. It is exposed the same interfaces as a","-ShadowRealm, which are the ones the specs mark [Exposed=*], and defers to","-the context that created it for everything else. Unlike a ShadowRealm, it","-reports uncaught errors and console messages through that context instead","-of treating them as unreachable.","-","-Electron creates the context itself, in","-shell/renderer/preload_realm_context.cc. This patch is specific to Electron","-and is not intended to be upstreamed.","-","-diff --git a/third_party/blink/renderer/bindings/core/v8/v8_initializer.cc b/third_party/blink/renderer/bindings/core/v8/v8_initializer.cc","-index 41a5db4e019084d47763a43bd548b29faa070660..3e62033228307ef2474c91e250db08cd72934ad6 100644","-+++ b/third_party/blink/renderer/bindings/core/v8/v8_initializer.cc","-@@ -78,6 +78,7 @@","- #include \"third_party/blink/renderer/core/inspector/inspector_trace_events.h\"","- #include \"third_party/blink/renderer/core/inspector/main_thread_debugger.h\"","- #include \"third_party/blink/renderer/core/page/page.h\"","-+#include \"third_party/blink/renderer/core/preload_realm/preload_realm_global_scope.h\"","- #include \"third_party/blink/renderer/core/script/modulator.h\"","- #include \"third_party/blink/renderer/core/shadow_realm/shadow_realm_global_scope.h\"","- #include \"third_party/blink/renderer/core/timing/time_clamper.h\"","-@@ -448,6 +449,11 @@ static void PromiseRejectHandlerInWorker(v8::PromiseRejectMessage data) {","-   ExecutionContext* execution_context = ExecutionContext::From(script_state);","-   if (!execution_context)","-     return;","-+  // An Electron preload realm has no script controller of its own.","-+  if (auto* preload_realm =","-+          DynamicTo<PreloadRealmGlobalScope>(execution_context)) {","-+    execution_context = preload_realm->GetInitiatorExecutionContext();","-+  }","- ","-   ExecutionContext* root_worker_context =","-       execution_context->IsShadowRealmGlobalScope()","-diff --git a/third_party/blink/renderer/bindings/generated_in_core.gni b/third_party/blink/renderer/bindings/generated_in_core.gni","-index 788f261f96ef65df2bc7fef0fa2a793da22e44ca..7b8efe1bc88c18e3ccf6e9a663c6670f46e8bea6 100644","-+++ b/third_party/blink/renderer/bindings/generated_in_core.gni","-@@ -1530,6 +1530,8 @@ generated_interface_sources_in_core = [","-   \"$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_preference_manager.h\",","-   \"$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_preference_object.cc\",","-   \"$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_preference_object.h\",","-+  \"$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_preload_realm_global_scope.cc\",","-+  \"$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_preload_realm_global_scope.h\",","-   \"$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_progress_event.cc\",","-   \"$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_progress_event.h\",","-   \"$root_gen_dir/third_party/blink/renderer/bindings/core/v8/v8_promise_rejection_event.cc\",","-diff --git a/third_party/blink/renderer/bindings/generated_in_modules.gni b/third_party/blink/renderer/bindings/generated_in_modules.gni","-index b56e9a96ebd3d598e53848fa955d02ac45628900..4f4d8a5ec938f7b4ccd336b64221d62017fb83b4 100644","-+++ b/third_party/blink/renderer/bindings/generated_in_modules.gni