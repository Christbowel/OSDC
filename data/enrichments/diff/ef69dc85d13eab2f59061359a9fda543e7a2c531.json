y\", category, params.getSecurityCategory());","+        isEquals(params + \" strength\", classicalStrength, params.getClassicalSecurityStrength());","+    }","+","+    public static void main(String[] args)","+    {","+        runTest(new PQCParametersTest());","+    }","+}"],"additions":70,"deletions":0,"truncated":false},{"path":"core/src/test/jdk1.4/org/bouncycastle/crypto/test/RegressionTest.java","lines":["@@ -135,7 +135,8 @@ public class RegressionTest","         new BlockCipherResetTest(),","         new StreamCipherResetTest(),","         new SICPositionTest(),","-        new SM3DigestTest()","+        new SM3DigestTest(),","+        new PQCParametersTest()","     };"," ","     public static void main(String[] args)"],"additions":2,"deletions":1,"truncated":false},{"path":"pg/src/main/java/org/bouncycastle/openpgp/operator/jcajce/JcaPGPContentSignerBuilder.java","lines":["@@ -217,8 +217,8 @@ private PGPContentSigner buildPQCSigner(final int signatureType, final long keyI","                     helper.createSignature(keyAlgorithm == PublicKeyAlgorithmTags.MLDSA65_Ed25519 ? \"Ed25519\" : \"Ed448\"),","                     helper.createSignature(\"ML-DSA\")","                 };","-                signatures[0].initSign(comp.getPrivateKeys().get(0), hedge);","-                signatures[1].initSign(comp.getPrivateKeys().get(1), hedge);","+                signatures[0].initSign((PrivateKey)comp.getPrivateKeys().get(0), hedge);","+                signatures[1].initSign((PrivateKey)comp.getPrivateKeys().get(1), hedge);","                 signatureLengths = new int[]{","                     MLDSACompositePublicBCPGKey.getEdDSASignatureLength(keyAlgorithm),","                     MLDSACompositePublicBCPGKey.getMLDSASignatureLength(keyAlgorithm)"],"additions":2,"deletions":2,"truncated":false},{"path":"pg/src/main/java/org/bouncycastle/openpgp/operator/jcajce/JcaPGPContentVerifierBuilderProvider.java","lines":["@@ -189,8 +189,8 @@ private PGPContentVerifier buildPQC