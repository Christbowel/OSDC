.existsSync(output)) &&","+      fs.existsSync(hash_file) && fs.readFileSync(hash_file, \"utf8\") == digest) {","+    return","+  }","+","   const is_windows = process.platform == \"win32\"","   const npx = is_windows ? \"npx.cmd\" : \"npx\"","-  cp.spawnSync(npx, [\"--loglevel=warn\", \"tsc\", \"--project\", \"./make/tsconfig.json\"], {stdio: \"inherit\", shell: is_windows})","+  const {status} = cp.spawnSync(npx, [\"--loglevel=warn\", \"tsc\", \"--project\", \"./make/tsconfig.json\"], {stdio: \"inherit\", shell: is_windows})","+  if (status !== 0) {","+    process.exit(status ?? 1)","+  }","+","+  fs.writeFileSync(hash_file, digest)"," }"," "," compile()"],"additions":46,"deletions":1,"truncated":false},{"path":"bokehjs/make/tasks/lint.ts","lines":["@@ -9,25 +9,27 @@ import * as paths from \"../paths.js\""," "," import {glob} from \"#compiler/sys.js\""," ","-async function eslint(dir: string): Promise<void> {","+async function eslint(dirs: string[]): Promise<void> {","   const {fix} = argv","-  const eslint = new ESLint({cache: true, fix})","+  const eslint = new ESLint({cache: true, cacheStrategy: \"content\", fix})"," ","-  const tsconfig_url = `file://${join(dir, \"tsconfig.json\")}`","-  const {default: tsconfig_json} = await import(tsconfig_url, {with: {type: \"json\"}})","-  const tsconfig = tsconfig_json as {include?: string[], exclude?: string[]}","+  const files = new Set<string>()","+  for (const dir of dirs) {","+    const tsconfig_url = `file://${join(dir, \"tsconfig.json\")}`","+    const {default: tsconfig_json} = await import(tsconfig_url, {with: {type: \"json\"}})","+    const tsconfig = tsconfig_json as {include?: string[], exclude?: string[]}"," ","-  const included_files = new Set(glob(...(tsconfig.include ?? []).map((pat) => normalize(join(dir, pat)))))","-  const excluded_files = new Set(glob(...(tsconfig.exclude ?? []).map((pat) => normalize(join(dir, pat)))))","+    const included_files = new Set(glob(...(tsconfig.include ?? []).map((pat) =>