{"id":"b8dc22876ea54a8892352318d15ad540beeb67de","axis":"silent","repo":"hashicorp/vault","sha":"b8dc22876ea54a8892352318d15ad540beeb67de","parsed":{"files":[{"path":"builtin/logical/pki/backend.go","lines":["@@ -145,6 +145,7 @@ func Backend(conf *logical.BackendConfig) *backend {"," \t\t\t\tlegacyCertBundlePath,"," \t\t\t\tlegacyCertBundleBackupPath,"," \t\t\t\tkeyPrefix,","+\t\t\t\texportKeyPrefix,"," \t\t\t},"," "," \t\t\tWriteForwardedStorage: []string{"],"additions":1,"deletions":0,"truncated":false},{"path":"builtin/logical/pki/export_crypto.go","lines":["@@ -0,0 +1,118 @@","+// Copyright IBM Corp. 2016, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package pki","+","+import (","+\t\"crypto/ecdsa\"","+\t\"crypto/elliptic\"","+\t\"crypto/hmac\"","+\t\"crypto/mlkem\"","+\t\"crypto/rand\"","+\t\"crypto/rsa\"","+\t\"crypto/sha256\"","+\t\"crypto/x509\"","+\t\"encoding/hex\"","+\t\"encoding/pem\"","+\t\"fmt\"","+\t\"strings\"","+","+\t\"github.com/hashicorp/vault/sdk/helper/errutil\"","+)","+","+// generateExportKeypair returns privPEM, pubPEM, and public key bytes for the given keyType.","+// RSA and EC use x509.MarshalPKCS8PrivateKey / x509.MarshalPKIXPublicKey, emitting standard","+// \"PRIVATE KEY\" / \"PUBLIC KEY\" PEM. ML-KEM uses custom PEM labels (\"ML-KEM PRIVATE KEY\" /","+// \"ML-KEM PUBLIC KEY\") with raw bytes because x509.MarshalPKIXPublicKey and","+// x509.MarshalPKCS8PrivateKey do not support *mlkem.EncapsulationKey* / *mlkem.DecapsulationKey*","+// in Go 1.27.","+func generateExportKeypair(keyType string) (privPEM string, pubPEM string, pubDER []byte, err error) {","+\tswitch keyType {","+\tcase \"ml-kem-768\":","+\t\tdk, genErr := mlkem.GenerateKey768()","+\t\tif genErr != nil {","+\t\t\treturn \"\", \"\", nil, errutil.InternalError{Err: fmt.Sprintf(\"failed to generate ML-KEM-768 key: %v\", genErr)}","+\t\t}","+\t\tpubBytes := dk.EncapsulationKey().Bytes()","+\t\tprivPEM = strings.TrimSpace(string(pem.EncodeToMemory(&pem.Block{Type: \"ML-KEM PRIVATE KEY\", Bytes: dk.Bytes()})))","+\t\tpubPEM = strings.TrimSpace(string(pem.EncodeToMemory(&pem.Block{Type: \"ML-KEM PUBLIC KEY\", Bytes: pubBytes})))","+\t\treturn privPEM, pubPEM, pubBytes, nil","+","+\tcase \"ml-kem-1024\":","+\t\tdk, genErr := mlkem.GenerateKey1024()","+\t\tif genErr != nil {","+\t\t\treturn \"\", \"\", nil, errutil.InternalError{Err: fmt.Sprintf(\"failed to generate ML-KEM-1024 key: %v\", genErr)}","+\t\t}","+\t\tpubBytes := dk.EncapsulationKey().Bytes()","+\t\tprivPEM = strings.TrimSpace(string(pem.EncodeToMemory(&pem.Block{Type: \"ML-KEM PRIVATE KEY\", Bytes: dk.Bytes()})))","+\t\tpubPEM = strings.TrimSpace(string(pem.EncodeToMemory(&pem.Block{Type: \"ML-KEM PUBLIC KEY\", Bytes: pubBytes})))","+\t\treturn privPEM, pubPEM, pubBytes, nil","+\t}","+","+\tvar privKey interface{}","+\tvar pubKey interface{}","+","+\tswitch keyType {","+\tcase \"rsa-2048\":","+\t\tk, genErr := rsa.GenerateKey(rand.Reader, 2048)","+\t\tif genErr != nil {","+\t\t\treturn \"\", \"\", nil, errutil.InternalError{Err: fmt.Sprintf(\"failed to generate RSA-2048 key: %v\", genErr)}","+\t\t}","+\t\tprivKey, pubKey = k, &k.PublicKey","+\tcase \"rsa-3072\":","+\t\tk, genErr := rsa.GenerateKey(rand.Reader, 3072)","+\t\tif genErr != nil {","+\t\t\treturn \"\", \"\", nil, errutil.InternalError{Err: fmt.Sprintf(\"failed to generate RSA-3072 key: %v\", genErr)}","+\t\t}","+\t\tprivKey, pubKey = k, &k.PublicKey","+\tcase \"rsa-4096\":","+\t\tk, genErr := rsa.GenerateKey(rand.Reader, 4096)","+\t\tif genErr != nil {","+\t\t\treturn \"\", \"\", nil, errutil.InternalError{Err: fmt.Sprintf(\"failed to generate RSA-4096 key: %v\", genErr)}","+\t\t}","+\t\tprivKey, pubKey = k, &k.PublicKey","+\tcase \"ec-p256\":","+\t\tk, genErr := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)","+\t\tif genErr != nil {","+\t\t\treturn \"\", \"\", nil, errutil.InternalError{Err: fmt.Sprintf(\"failed to generate EC P-256 key: %v\", genErr)}","+\t\t}","+\t\tprivKey, pubKey = k, &k.PublicKey","+\tcase \"ec-p384\":","+\t\tk, genErr := ecdsa.GenerateKey(elliptic.P384(), rand.Reader)","+\t\tif genErr != nil {","+\t\t\treturn \"\", \"\", nil, errutil.InternalError{Err: fmt.Sprintf(\"failed to generate EC P-384 key: %v\", genErr)}","+\t\t}","+\t\tprivKey, pubKey = k, &k.PublicKey","+\tcase \"ec-p521\":","+\t\tk, genErr := ecdsa.GenerateKey(elliptic.P521(), rand.Reader)","+\t\tif genErr != nil {","+\t\t\treturn \"\", \"\", nil, errutil.InternalError{Err: fmt.Sprintf(\"failed to generate EC P-521 key: %v\", genErr)}","+\t\t}","+\t\tprivKey, pubKey = k, &k.PublicKey","+\tdefault:","+\t\treturn \"\", \"\", nil, errutil.UserError{Err: fmt.Sprintf(\"unsupported key_type %q\", keyType)}","+\t}","+","+\tprivDER, marshalErr := x509.MarshalPKCS8PrivateKey(privKey)","+\tif marshalErr != nil {","+\t\treturn \"\", \"\", nil, errutil.InternalError{Err: fmt.Sprintf(\"failed to marshal private key to PKCS8: %v\", marshalErr)}","+\t}","+\tprivPEM = strings.TrimSpace(string(pem.EncodeToMemory(&pem.Block{Type: \"PRIVATE KEY\", Bytes: privDER})))","+","+\tpubDER, marshalErr = x509.MarshalPKIXPublicKey(pubKey)","+\tif marshalErr != nil {","+\t\treturn \"\", \"\", nil, errutil.InternalError{Err: fmt.Sprintf(\"failed to marshal public key to PKIX: %v\", marshalErr)}","+\t}","+\tpubPEM = strings.TrimSpace(string(pem.EncodeToMemory(&pem.Block{Type: \"PUBLIC KEY\", Bytes: pubDER})))","+","+\treturn privPEM, pubPEM, pubDER, nil","+}","+","+// computeExportKeyHMAC returns a deterministic \"sha256:<hex>\" fingerprint over the DER-encoded","+// public key bytes. The fixed HMAC key is intentional — this is a lookup correlator.","+func computeExportKeyHMAC(pubKeyDER []byte) string {","+\tconst hmacKey = \"vault-pki-export-key-hmac-v1\"","+\tmac := hmac.New(sha256.New, []byte(hmacKey))","+\tmac.Write(pubKeyDER)","+\treturn \"sha256:\" + hex.EncodeToString(mac.Sum(nil))","+}"],"additions":118,"deletions":0,"truncated":false},{"path":"builtin/logical/pki/observe/observation_consts.go","lines":["@@ -9