de workerd during the build. Each optimized image is","+// streamed out of the prerender worker on its own request, so nothing here depends on","+// the whole image set fitting in memory.","+//","+// Both the binding and the Node-side fallback emit a valid WEBP, so the generated bytes","+// alone cannot tell them apart. The adapter warns whenever it falls back, so this test","+// raises the log level (fixtures build silently by default), captures stdout, and treats","+// that warning as proof the streaming endpoint did not do its job.","+describe('BindingBuildImageService build-time image generation', () => {","+\tconst FALLBACK_WARNING = 'Falling back to the local image service';","+","+\tasync function buildFixture(outDirName: string) {","+\t\tconst fixture = await loadFixture({","+\t\t\troot: './fixtures/compile-custom-image-service/',","+\t\t\toutDir: `./dist/binding-build-image-service-${outDirName}/`,","+\t\t});","+\t\tconst resetConfig = await fixture.editFile(","+\t\t\t'astro.config.mjs',","+\t\t\t(contents) =>","+\t\t\t\tcontents.replace(","+\t\t\t\t\t\"imageService: 'compile'\",","+\t\t\t\t\t\"imageService: { build: 'cloudflare-binding', runtime: 'cloudflare-binding' }\",","+\t\t\t\t),","+\t\t\tfalse,","+\t\t);","+","+\t\t// Astro's node logger resolves `process.stdout` per write, so patching it here","+\t\t// intercepts the adapter's warnings.","+\t\tconst log: string[] = [];","+\t\tconst originalWrite = process.stdout.write.bind(process.stdout);","+\t\tprocess.stdout.write = ((chunk: any, ...rest: any[]) => {","+\t\t\tlog.push(typeof chunk === 'string' ? chunk : Buffer.from(chunk).toString('utf8'));","+\t\t\treturn (originalWrite as any)(chunk, ...rest);","+\t\t}) as typeof process.stdout.write;","+","+\t\ttry {","+\t\t\tawait fixture.build({ logLevel: 'warn' });","+\t\t\treturn { fixture, html: await fixture.readFile('client/index.html'), log: log.join('') };","+\t\t} finally {","+\t\t\tprocess.stdout.write = originalWrite;","+\t\t\tresetConfig();","+\t\t}","+\t}","+","+\tit('streams IMAGES-binding output into the client directory instead of falling back', async () => {","+\t\tconst { fixture, html, log } = await buildFixture('binding');","+","+\t\t// The binding handled every transform: nothing fell through to the Node side.","+\t\tassert.ok(","+\t\t\t!log.includes(FALLBACK_WARNING),","+\t\t\t`expected the IMAGES binding to transform every image, but the build fell back:\\n${log}`,","+\t\t);","+","+\t\tconst src = cheerio.load(html)('img').attr('src');","+\t\tassert.match(src ?? '', /^\\/_astro\\/.+\\.webp$/, 'expected a hashed .webp asset in the markup');","+","+\t\t// The streamed bytes landed on disk as an intact WEBP container.","+\t\tconst data = (await fixture.readFile(`client${src}`, null)) as unknown as Buffer;","+\t\tassert.equal(data.subarray(0, 4).toString('utf8'), 'RIFF');","+\t\tassert.equal(data.subarray(8, 12).toString('utf8'), 'WEBP');","+\t});","+});"],"additions":68,"deletions":0,"truncated":false},{"path":"packages/integrations/cloudflare/test/image-config.test.ts","lines":["@@ -0,0 +1,27 @@","+import * as assert from 'node:assert/strict';","+import { describe, it } from 'node:test';","+import { normalizeImageServiceConfig } from '../dist/utils/image-config.js';","+","+describe('normalizeImageServiceConfig', () => {","+\tit('keeps the cloudflare-binding shorthand runtime-only', () => {","+\t\tassert.deepEqual(normalizeImageServiceConfig('cloudflare-binding'), {","+\t\t\tbuildService: 'cloudflare-binding',","+\t\t\truntimeService: 'cloudflare-binding',"],"additions":9,"deletions":0,"truncated":false}],"additions":475,"deletions":80,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-08-03T11:10:16.994419+00:00"}