 against the provider.","+func (c *Connection) Test(ctx context.Context) (*provisioning.TestResults, error) {","+\ttoken, err := parseToken(c.secrets.Token)","+\tif err != nil || token.AccessToken == \"\" {","+\t\treturn connection.FailedTestResults(","+\t\t\thttp.StatusUnauthorized,","+\t\t\t[]provisioning.ErrorDetails{{","+\t\t\t\tType:   metav1.CauseTypeFieldValueRequired,","+\t\t\t\tField:  field.NewPath(\"secure\", \"token\").String(),","+\t\t\t\tDetail: \"This connection has not been authorized yet\",","+\t\t\t}},","+\t\t), nil","+\t}","+","+\tif _, err := c.provider.ListRepositories(ctx, token.AccessToken); err != nil {","+\t\tif errors.Is(err, connection.ErrAuthentication) {","+\t\t\treturn connection.FailedTestResults(","+\t\t\t\thttp.StatusUnauthorized,","+\t\t\t\t[]provisioning.ErrorDetails{{","+\t\t\t\t\tType:   metav1.CauseTypeFieldValueInvalid,","+\t\t\t\t\tField:  field.NewPath(\"secure\", \"token\").String(),","+\t\t\t\t\tDetail: \"The provider rejected the connection's access token\",","+\t\t\t\t}},","+\t\t\t), nil","+\t\t}","+\t\treturn connection.FailedTestResults(","+\t\t\thttp.StatusUnprocessableEntity,","+\t\t\t[]provisioning.ErrorDetails{{","+\t\t\t\tType:   metav1.CauseTypeInternal,","+\t\t\t\tDetail: fmt.Errorf(\"failed to list repositories: %w\", err).Error(),","+\t\t\t}},","+\t\t), nil","+\t}","+","+\treturn connection.SuccessTestResults(), nil","+}","+","+// GenerateRepositoryToken returns an access token usable for git operations on","+// the given repository. OAuth app tokens are not repository scoped, so this is","+// the connection-level access token kept fresh by the connection controller.","+func (c *Connection) GenerateRepositoryToken(_ context.Context, repo *provisioning.Repository) (*connection.ExpirableSecureValue, error) {","+\tif repo == nil {","+\t\treturn nil, errors.New(\"a repository is required to generate a token\")","+\t}","+\tif repo.Spec.Type != c.repoType {","+\t\treturn nil, fmt.Errorf(\"repository type %q is not served by this connection (serves %q)\", repo.Spec.Type, c.repoType)","+\t}","+","+\ttoken, err := parseToken(c.secrets.Token)","+\tif err != nil || token.AccessToken == \"\" {","+\t\treturn nil, fmt.Errorf(\"connection access token not available: %w\", connection.ErrAuthentication)","+\t}","+\tif !token.Expiry.IsZero() && time.Now().After(token.Expiry) {","+\t\treturn nil, fmt.Errorf(\"connection access token expired: %w\", connection.ErrAuthentication)","+\t}","+","+\treturn &connection.ExpirableSecureValue{","+\t\tToken:     common.RawSecureValue(token.AccessToken),","+\t\tExpiresAt: token.Expiry,","+\t}, nil","+}","+","+// ListRepositories returns the list of repositories accessible through this connection.","+func (c *Connection) ListRepositories(ctx context.Context) ([]provisioning.ExternalRepository, error) {","+\ttoken, err := parseToken(c.secrets.Token)","+\tif err != nil || token.AccessToken == \"\" {","+\t\treturn nil, fmt.Errorf(\"connection access token not available: %w\", connection.ErrAuthentication)","+\t}","+","+\treturn c.provider.ListRepositories(ctx, token.AccessToken)","+}","+","+// GenerateConnectionToken exchanges the stored refresh token for a new access","+// token via the provider's token endpoint. Providers that rotate refresh tokens","+// (e.g. GitLab) return a new one, which is stored as part of the token; when","+// absent the stored refresh token remains valid and is kept.","+// Implements the connection.TokenConnection interface.","+func (c *Connection) GenerateConnectionToken(ctx context.Context) (common.RawSecureValue, error) {","+\tstored, err := parseToken(c.secrets.Token)","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+\tif stored.RefreshToken == \"\" {","+\t\treturn \"\", errors.New(\"no refresh token available; authorize the OAuth application again\")","+\t}","+","+\tcfg := oauth2.Config{","+\t\tClientID:     c.clientID,","+\t\tClientSecret: string(c.secrets.ClientSecret),","+\t\tEndpoint:     c.provider.Endpoint(),","+\t}","+","+\tnext, err := cfg.TokenSource(ctx, &oauth2.Token{RefreshToken: stored.RefreshToken}).Token()","+\tif err != nil {","+\t\treturn \"\", fmt.Errorf(\"refresh access token: %w\", err)","+\t}","+","+\tif next.RefreshToken == \"\" {","+\t\tnext.RefreshToken = stored.RefreshToken","+\t}","+","+\treturn marshalToken(next)","+}","+","+// ExchangeAuthorizationCode exchanges an OAuth authorization code for tokens.","+// Implements the connection.OAuthConnection interface.","+func (c *Connection) ExchangeAuthorizationCode(ctx context.Context, code, redirectURI string) (common.RawSecureValue, error) {","+\tif code == \"\" {","+\t\treturn \"\", errors.New(\"an authorization code is required\")","+\t}","+","+\tcfg := oauth2.Config{","+\t\tClientID:     c.clientID,","+\t\tClientSecret: string(c.secrets.ClientSecret),","+\t\tEndpoint:     c.provider.Endpoint(),","+\t\tRedirectURL:  redirectURI,","+\t}","+","+\ttoken, err := cfg.Exchange(ctx, code)","+\tif err != nil {","+\t\treturn \"\", fmt.Errorf(\"exchange authorization code: %w\", err)","+\t}","+","+\treturn marshalToken(token)","+}","+","+// ValidateToken checks the stored token. A missing expiry means the provider","+// issued a non-expiring access token (e.g. GitHub OAuth apps).","+func (c *Connection) ValidateToken() (expiresAt time.Time, err error) {","+\ttoken, err := parseToken(c.secrets.Token)","+\tif err != nil {","+\t\treturn time.Time{}, err","+\t}","+\tif token.AccessToken == \"\" {","+\t\treturn time.Time{}, errors.New(\"stored token has no access token\")","+\t}","+\treturn token.Expiry, nil","+}","+","+// parseToken decodes the token stored in the connection's secure token. Unlike","+// a JWT, an OAuth access token is opaque: its expiry and the refresh token","+// used to mint the next one are not recoverable from the token itself, so the","+// whole token is stored and both must survive controller restarts and","+// refresh-token rotation. A zero Expiry means the access token does not","+// expire.","+func parseToken(raw common.RawSecureValue) (*oauth2.Token, error) {","+\tif raw.IsZero() {","+\t\treturn nil, errors.New(\"no token available\")","+\t}","+","+\ttoken := &oauth2.Token{}","+\tif err := json.Unmarshal([]byte(raw), token); err != nil {","+\t\treturn nil, errors.New(\"stored token is not a valid token payload\")","+\t}","+","+\treturn token, nil","+}","+","+// marshalToken encodes a token for storage in the connection's secure token.","+func marshalToken(token *oauth2.Token) (common.RawSecureValue, error) {","+\tb, err := json.Marshal(token) // #nosec G117 -- intentional serialization into a secure value for the secret store","+\tif err != nil {","+\t\treturn \"\", err","+\t}","+\treturn common.RawSecureValue(b), nil","+}","+","+var (","+\t_ connection.Connection      = (*Connection)(nil)","+\t_ connection.TokenConnection = (*Connection)(nil)","+\t_ connection.OAuthConnection = (*Connection)(nil)","+)"],"additions":221,"deletions":0,"truncated":false},{"path":"apps/provisioning/pkg/connection/oauth/connection_test.go","lines":["@@ -0,0 +1,402 @@","+package oauth_test","+","+import (","+\t\"encoding/json\"","+\t\"errors\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/mock\"","+\t\"github.com/stretchr/testify/require\"","+\t\"golang.org/x/oauth2\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+","+\tprovisioning \"github.com/grafana/grafana/apps/provisioning/pkg/apis/provisioning/v0alpha1\"","+\t\"github.com/grafana/grafana/apps/provisioning/pkg/connection\"","+\t\"github.com/grafana/grafana/apps/provisioning/pkg/connection/oauth\"","+\tcommon \"github.com/grafana/grafana/pkg/apimachinery/apis/common/v0alpha1\"","+)","+","+func TestConnection_Test(t *testing.T) {","+\ttests := []struct {","+\t\tname           string","+\t\ttoken          common.RawSecureValue","+\t\tlistErr        error","+\t\texpectedCode   int","+\t\texpectedErrors []