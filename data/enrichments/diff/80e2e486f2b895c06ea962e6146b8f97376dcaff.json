{"id":"80e2e486f2b895c06ea962e6146b8f97376dcaff","axis":"silent","repo":"vllm-project/vllm","sha":"80e2e486f2b895c06ea962e6146b8f97376dcaff","parsed":{"files":[{"path":"docs/features/nixl_connector_usage.md","lines":["@@ -76,6 +76,20 @@ vllm serve <MODEL> \\","   }'"," ```"," ","+#### Extensible KV cache","+","+The extensible KV cache (`--enable-extensible-kv-cache`) maps the KV cache with the driver's virtual memory API. Within a host, UCX can only reach that memory over NVLink through a CUDA fabric handle, which takes an IMEX channel; without one it falls back to TCP. So with NIXL on device memory and no channel, vLLM leaves the extensible KV cache off.","+","+To use both within a host, make a channel available to every prefill and decode process, for example:","+","+```bash","+major=$(awk '$2 == \"nvidia-caps-imex-channels\" {print $1}' /proc/devices)","+mkdir -p /dev/nvidia-caps-imex-channels","+mknod /dev/nvidia-caps-imex-channels/channel0 c \"$major\" 0","+```","+","+Check the transport with `UCX_PROTO_INFO=y`: KV reads should show `cuda_ipc`, not `tcp`. Transfers across hosts use RDMA and need no channel: pass `--enable-extensible-kv-cache` to keep the feature on.","+"," ## Basic Usage (on the same host)"," "," ### Producer (Prefiller) Configuration"],"additions":14,"deletions":0,"truncated":false},{"path":"tests/utils_/test_vmm_driver.py","lines":["@@ -7,7 +7,12 @@"," import pytest"," import torch"," ","-from vllm.utils.vmm_driver import _find_loaded_library","+from vllm.utils.vmm_driver import (","+    _MEM_HANDLE_TYPE_FABRIC,","+    CudaVmmDriver,","+    _find_loaded_library,","+    imex_channel_available,","+)"," "," _CUDART = \"/usr/lib/python3.12/site-packages/nvidia/cuda_runtime/lib/libcudart.so.12\""," _MAPS = [","@@ -139,3 +144,72 @@ def fake_cdll(name: str) -> str:","     opened.clear()","     assert vmm_driver.VmmDriver._load_library(driver) == \"libamdhip64.so.7\"","     assert opened == [\"libamdhip64.so.7\"]","+","+","+@pytest.mark.parametrize(","+    \"device_support, imex_channel, requested\",","+    [(True, True, _MEM_HANDLE_TYPE_FABRIC), (True, False, 0), (False, True, 0)],","+)","+def test_fabric_handle_needs_device_support_and_an_imex_channel(","+    monkeypatch, device_support, imex_channel, requested","+):","+    driver = CudaVmmDriver.__new__(CudaVmmDriver)","+    driver._rdma_capable = {}","+    driver._fabric_capable = {}","+    monkeypatch.setattr(driver, \"_device_attribute\", lambda *args: device_support)","+    monkeypatch.setattr(","+        \"vllm.utils.vmm_driver.imex_channel_available\", lambda: imex_channel","+    )","+","+    assert driver._make_alloc_prop(0).requestedHandleTypes == requested","+","+","+@pytest.mark.parametrize(","+    \"first_result, retries\",","+    [(800, True), (801, True), (2, False)],  # NOT_PERMITTED, NOT_SUPPORTED, OOM","+)","+def test_create_retries_without_fabric_only_if_fabric_was_the_problem(","+    monkeypatch, first_result, retries","+):","+    driver = CudaVmmDriver.__new__(CudaVmmDriver)","+    driver._rdma_capable = {}","+    driver._fabric_capable = {}","+    monkeypatch.setattr(driver, \"_device_attribute\", lambda *args: True)","+    monkeypatch.setattr(\"vllm.utils.vmm_driver.imex_channel_available\", lambda: True)","+    monkeypatch.setattr(driver, \"error_string\", str)","+    requested = []","+","+    def fake_create(handle, size, prop, flags):","+        requested.append(prop._obj.requestedHandleTypes)","+        if requested[-1]:","+            return first_result","+        handle._obj.value = 7","+        return 0","+","+    driver._fns = {\"create\": fake_create}","+","+    if not retries:","+        with pytest.raises(RuntimeError):","+            driver.create(4096, 0)","+        assert requested == [_MEM_HANDLE_TYPE_FABRIC]","+        return","+","+    assert driver.create(4096, 0) == 7","+    assert requested == [_MEM_HANDLE_TYPE_FABRIC, 0]","+    # Later allocations skip the rejected request.","+    assert driver.create(4096, 0) == 7","+    assert requested == [_MEM_HANDLE_TYPE_FABRIC, 0, 0]","+","+","+def test_imex_channel_available_needs_a_channel_that_opens(monkeypatch, tmp_path):","+    monkeypatch.setattr(","+        \"vllm.utils.vmm_driver._IMEX_CHANNELS\", str(tmp_path / \"channel*\")","+    )","+    assert not imex_channel_available()","+","+    # A dangling symlink stands in for a file the process cannot open.","+    (tmp_path / \"channel0\").symlink_to(tmp_path / \"missing\")","+    assert not imex_channel_available()","+","+    (tmp_path / \"channel1\").touch()","+    assert imex_channel_available()"],"additions":75,"deletions":1,"truncated":false},{"path":"tests/v1/engine/test_engine_args.py","lines":["@@ -455,26 +455,21 @@ def test_kv_transfer_registers_kv_cache_memory(","     assert transfer.registers_kv_cache_memory() is registers"," "," ","-@pytest.mark.parametrize(\"rocm\", [False, True])","-@pytest.mark.parametrize(\"requested\", [None, True])","-def test_extensible_kv_cache_off_for_rocm_registering_connector(","-    monkeypatch, rocm, requested","-):","-    \"\"\"UCX and RDMA cannot yet register driver-mapped memory on ROCm, so a","-    connector that registers the KV cache keeps the extensible cache off there","-    by default and an explicit request is an error; CUDA is unaffected.\"\"\"","+def _nixl_config_for_extensible_kv_cache(monkeypatch, *, rocm, requested, imex_channel):","     from types import SimpleNamespace"," ","     import vllm.platforms","     from vllm.config.kv_transfer import KVTransferConfig","-    from vllm.config.vllm import VllmConfig"," ","     monkeypatch.setattr(","         vllm.platforms,","         \"current_platform\",","         SimpleNamespace(is_cuda_alike=lambda: True, is_rocm=lambda: rocm),","     )","-    config = SimpleNamespace(","+    monkeypatch.setattr(","+        \"vllm.utils.vmm_driver.imex_channel_available\", lambda: imex_channel","+    )","+    return SimpleNamespace(","         cache_config=SimpleNamespace(","             _extensible_kv_cache_resolved=False,","             enable_extensible_kv_cache=requested,","@@ -487,6 +482,21 @@ def test_extensible_kv_cache_off_for_rocm_registering_connector(","             kv_connector=\"NixlConnector\", kv_role=\"kv_both\", kv_buffer_device=\"cuda\"","         ),","     )","+","+","+@pytest.mark.parametrize(\"rocm\", [False, True])","+@pytest.mark.parametrize(\"requested\", [None, True])","+def test_extensible_kv_cache_off_for_rocm_registering_connector(","+    monkeypatch, rocm, requested","+):","+    \"\"\"UCX and RDMA cannot yet register driver-mapped memory on ROCm, so a","+    connector that registers the KV cache keeps the extensible cache off there","+    by default and an explicit request is an error; CUDA is unaffected.\"\"\"","+    from vllm.config.vllm import VllmConfig","+","+    config = _nixl_config_for_extensible_kv_cache(","+        monkeypatch, rocm=rocm, requested=requested, imex_channel=True","+    )","     if rocm and requested:","         with pytest.raises(ValueError, match=\"ROCm\"):","             VllmConfig._resolve_extensible_kv_cache(config)","@@ -495,6 +505,26 @@ def test_extensible_kv_cache_off_for_rocm_registering_connector(","     assert config.cache_config.enable_extensible_kv_cache is not rocm"," "," ","+@pytest.mark.parametrize(","+    \"requested, imex_channel, enabled\",","+    [(None, False, False), (True, False, True), (None, True, True)],","+)","+def test_extensible_kv_cache_with_nixl_needs_an_imex_channel_by_default(","+    monkeypatch, caplog_vllm, requested, imex_channel, enabled","+):","+    \"\"\"Without a channel NIXL within a host would fall back to TCP. An explicit","+    request, for transfers across hosts, is honored. Turning the cache off by","+    default says how to get it back.\"\"\"","+    from vllm.config.vllm import VllmConfig","+","+    config = _nixl_config_for_extensible_kv_cache(","+        monkeypatch, rocm=False, requested=requested, imex_channel=imex_channel","+    )","+    VllmConfig._resolve_extensible_kv_cache(config)","+    assert config.cache_config.enable_extensible_kv_cache is enabled","+    assert (\"--enable-extensible-kv-cache\" in caplog_vllm.text) is (not enabled)","+","+"," @pytest.mark.parametrize(\"multi\", [False, True])"," @pytest.mark.parametrize(\"requested\", [None, True])"," def test_extensible_kv_cache_off_with_lmcache_mp(monkeypatch, multi, requested):"],"additions":40,"deletions":10,"truncated":false},{"path":"vllm/config/cache.py","lines":["@@ -389,7 +389,8 @@ def device_memory_utilization(self, value: float | None) -> None:","     \"\"\"Reserve the KV cache address range with device virtual memory and commit","     physical pages after warmup, so the cache is sized from the memory actually","     free after CUDA graph capture rather than from a profiling estimate. If","-    unspecified, enabled on CUDA and ROCm unless kv_cache_memory_bytes is set;","+    unspecified, enabled on CUDA and ROCm unless kv_cache_memory_bytes is set,","+    or NIXL on device memory has no IMEX channel;","     falls back to estimate-based sizing where the driver lacks VMM support.","     Explicitly requesting it where unsupported is an error.\"\"\""," "],"additions":2,"deletions":1,"truncated":false},{"path":"vllm/config/kv_transfer.py","lines":["@@ -165,21 +165,27 @@ def uses_custom_mem_pool(self) -> bool:","             ]","         return any(config.get(\"custom_mem_pool\") for config in configs)"," ","+    def _connector_children(self) -> list[dict[str, Any]]:","+        if self.kv_connector == \"MultiConnector\":","+            return self.kv_connector_extra_config.get(\"connectors\", [])","+        return [{\"kv_connector\": self.kv_connector}]","+","+    def uses_nixl_on_device_memory(self) -> bool:","+        \"\"\"Whether NIXL transfers the device KV cache itself, directly or in","+        MultiConnector. With a CPU kv_buffer_device it uses host staging buffers.\"\"\"","+        return any(","+            (child.get(\"kv_connector\") or \"\").startswith(\"Nixl\")","+            and child.get(\"kv_buffer_device\", self.kv_buffer_device) != \"cpu\"","+            for child in self._connector_children()","+        )","+","     def registers_kv_cache_memory(self) -> bool:","         \"\"\"Whether a connector registers the device KV cache itself with UCX or","-        RDMA (NIXL, Mooncake, MoRIIO, UMBP), directly or in MultiConnector. NIXL with","-        a CPU kv_buffer_device registers only its host staging buffers.\"\"\"","-        children = [{\"kv_connector\": self.kv_connector}]","-        if self.kv_connector == \"MultiConnector\":","-            children = self.kv_connector_extra_config.get(\"connectors\", [])","-        for child in children:","-            name = child.get(\"kv_connector\") or \"\"","-            if name in _KV_CACHE_REGISTERING_CONNECTORS:","-                return True","-            buffer_device = child.get(\"kv_buffer_device\", self.kv_buffer_device)","-            if name.startswith(\"Nixl\") and buffer_device != \"cpu\":","-                return True","-        return False","+        RDMA (NIXL, Mooncake, MoRIIO, UMBP), directly or in MultiConnector.\"\"\"","+        return self.uses_nixl_on_device_memory() or any(","+            child.get(\"kv_connector\") in _KV_CACHE_REGISTERING_CONNECTORS","+            for child in self._connector_children()","+        )"," ","     def has_connector(self, connector_name: str) -> bool:","         \"\"\"Whether ``connector_name`` is configured, directly or in MultiConnector.\"\"\""],"additions":19,"deletions":13,"truncated":false},{"path":"vllm/config/vllm.py","lines":["@@ -3181,6 +3181,7 @@ def _resolve_extensible_kv_cache(self) -> None:","         may pick a different runner, and must not revisit the decision.","         \"\"\"","         from vllm.platforms import current_platform","+        from vllm.utils.vmm_driver import imex_channel_available"," ","         cache_config = self.cache_config","         if cache_config._extensible_kv_cache_resolved:","@@ -3232,10 +3233,29 @@ def _resolve_extensible_kv_cache(self) -> None:","                 \"on ROCm, UCX and RDMA cannot yet register driver-mapped memory, \"","                 \"which the NIXL, Mooncake, MoRIIO and UMBP connectors require\"","             )","+        # NIXL within a host reaches driver-mapped memory through a FABRIC handle.","+        nixl_would_use_tcp = (","+            self.kv_transfer_config is not None","+            and self.kv_transfer_config.uses_nixl_on_device_memory()","+            and not imex_channel_available()","+        )","         if requested is None:","-            cache_config.enable_extensible_kv_cache = unsupported is None","+            cache_config.enable_extensible_kv_cache = (","+                unsupported is None and not nixl_would_use_tcp","+            )","+            if unsupported is None and nixl_would_use_tcp:","+                logger.info(","+                    \"Extensible KV cache off: without an IMEX channel, NIXL within \"","+                    \"a host would lose NVLink and fall back to RDMA or TCP. If \"","+                    \"transfers only cross hosts, pass --enable-extensible-kv-cache.\"","+                )","         elif requested and unsupported is not None:","             raise ValueError(f\"enable_extensible_kv_cache: {unsupported}.\")","+        elif requested and nixl_would_use_tcp:","+            logger.warning(","+                \"No IMEX channel: with the extensible KV cache, NIXL within a host \"","+                \"falls back to TCP. Transfers across hosts use RDMA.\"","+            )"," ","     def _validate_adaptive_verification(self) -> None:","         spec_config = self.speculative_config"],"additions":21,"deletions":1,"truncated":false},{"path":"vllm/utils/vmm_driver.py","lines":["@@ -7,18 +7,29 @@"," from __future__ import annotations"," "," import ctypes","+import glob"," import os"," from collections.abc import Iterable","+from contextlib import suppress"," from functools import cache"," from typing import Any"," ","+from vllm.logger import init_logger","+","+logger = init_logger(__name__)","+"," _SUCCESS = 0","+_ERROR_NOT_PERMITTED = 800","+_ERROR_NOT_SUPPORTED = 801"," _MEM_ALLOCATION_TYPE_PINNED = 1"," _MEM_LOCATION_TYPE_DEVICE = 1"," _MEM_ALLOC_GRANULARITY_MINIMUM = 0"," _MEM_ACCESS_FLAGS_PROT_READWRITE = 3"," _MEM_ALLOCATION_COMP_NONE = 0"," _DEVICE_ATTRIBUTE_GPU_DIRECT_RDMA_WITH_CUDA_VMM_SUPPORTED = 110","+_DEVICE_ATTRIBUTE_HANDLE_TYPE_FABRIC_SUPPORTED = 128","+_MEM_HANDLE_TYPE_FABRIC = 0x8","+_IMEX_CHANNELS = \"/dev/nvidia-caps-imex-channels/channel*\""," "," DevicePtr = ctypes.c_ulonglong"," MemHandle = ctypes.c_ulonglong","@@ -55,6 +66,16 @@ class _MemAccessDesc(ctypes.Structure):","     _fields_ = [(\"location\", _MemLocation), (\"flags\", ctypes.c_int)]"," "," ","+def imex_channel_available() -> bool:","+    \"\"\"Whether this process can open an IMEX channel, which FABRIC handles take.","+    The file alone does not tell: a container's device cgroup can still deny it.\"\"\"","+    for path in glob.glob(_IMEX_CHANNELS):","+        with suppress(OSError):","+            os.close(os.open(path, os.O_RDONLY))","+            return True","+    return False","+","+"," def _find_loaded_library(","     lib_name: str, maps_lines: Iterable[str] | None = None"," ) -> str | None:","@@ -266,6 +287,14 @@ def __init__(self) -> None:","         ]","         lib.cuDeviceGetAttribute.restype = ctypes.c_int","         self._rdma_capable: dict[int, bool] = {}","+        self._fabric_capable: dict[int, bool] = {}","+","+    def _device_attribute(self, attribute: int, device_index: int) -> bool:","+        flag = ctypes.c_int()","+        result = self._lib.cuDeviceGetAttribute(","+            ctypes.byref(flag), attribute, device_index","+        )","+        return result == _SUCCESS and bool(flag.value)"," ","     def _make_alloc_prop(self, device_index: int) -> _MemAllocationProp:","         # Request GPUDirect RDMA support where available, as the sleep-mode","@@ -273,17 +302,45 @@ def _make_alloc_prop(self, device_index: int) -> _MemAllocationProp:","         # memory with RDMA NICs (ibv_reg_mr fails with EFAULT).","         prop = super()._make_alloc_prop(device_index)","         if (capable := self._rdma_capable.get(device_index)) is None:","-            flag = ctypes.c_int()","-            result = self._lib.cuDeviceGetAttribute(","-                ctypes.byref(flag),","-                _DEVICE_ATTRIBUTE_GPU_DIRECT_RDMA_WITH_CUDA_VMM_SUPPORTED,","-                device_index,","+            capable = self._device_attribute(","+                _DEVICE_ATTRIBUTE_GPU_DIRECT_RDMA_WITH_CUDA_VMM_SUPPORTED, device_index","             )","-            capable = result == _SUCCESS and bool(flag.value)","             self._rdma_capable[device_index] = capable","         prop.allocFlags.gpuDirectRDMACapable = int(capable)","+        # UCX's cuda_ipc can only map driver-mapped memory through a FABRIC handle.","+        if (fabric := self._fabric_capable.get(device_index)) is None:","+            fabric = (","+                self._device_attribute(","+                    _DEVICE_ATTRIBUTE_HANDLE_TYPE_FABRIC_SUPPORTED, device_index","+                )","+                and imex_channel_available()","+            )","+            self._fabric_capable[device_index] = fabric","+        if fabric:","+            prop.requestedHandleTypes = _MEM_HANDLE_TYPE_FABRIC","         return prop"," ","+    def create(self, size: int, device_index: int) -> int:","+        prop = self._make_alloc_prop(device_index)","+        handle = MemHandle()","+        result = self._fns[\"create\"](ctypes.byref(handle), size, ctypes.byref(prop), 0)","+        # Device support and an open channel do not guarantee a FABRIC allocation.","+        if prop.requestedHandleTypes and result in (","+            _ERROR_NOT_PERMITTED,","+            _ERROR_NOT_SUPPORTED,","+        ):","+            logger.warning(","+                \"Device %d cannot allocate with a FABRIC handle (%s); allocating \"","+                \"without one. With the extensible KV cache, NIXL then loses NVLink \"","+                \"and falls back to RDMA or TCP.\",","+                device_index,","+                self.error_string(result),","+            )","+            self._fabric_capable[device_index] = False","+            return super().create(size, device_index)","+        self._check(result)","+        return handle.value","+","     def error_string(self, code: int) -> str:","         msg = ctypes.c_char_p()","         self._lib.cuGetErrorString(code, ctypes.byref(msg))",""],"additions":63,"deletions":6,"truncated":false}],"additions":234,"deletions":32,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-09T17:51:28.765207+00:00"}