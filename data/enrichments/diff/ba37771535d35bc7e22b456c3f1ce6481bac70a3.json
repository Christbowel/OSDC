"+}","+","+func (c *searchTestConn) Query(ctx context.Context, query string, args ...any) (driver.Rows, error) {","+\treturn c.query(ctx, query, args...)","+}","+","+type searchTestRows struct {","+\tdriver.Rows","+\tclosed bool","+}","+","+func (r *searchTestRows) Close() error {","+\tr.closed = true","+\treturn r.Rows.Close()","+}","+","+func TestFindTraces_StagedQueries(t *testing.T) {","+\tstart := time.Unix(1700000000, 123456789)","+\tend := start.Add(3*time.Second + 987654321*time.Nanosecond)","+\tcandidateRows := &searchTestRows{Rows: &clickhousetest.Rows[[]any]{","+\t\tData: [][]any{{traceIDHex1}, {traceIDHex2}}, ScanFn: scanTraceIDFn(),","+\t}}","+\ttimestampRows := &searchTestRows{Rows: &clickhousetest.Rows[[]any]{","+\t\t// Metadata order need not match the candidate order.","+\t\tData:   [][]any{{traceIDHex2, start.Add(time.Second), end}, {traceIDHex1, start, end.Add(-time.Second)}},","+\t\tScanFn: scanTraceIDFn(),","+\t}}","+\tspanRows := &searchTestRows{Rows: &clickhousetest.Rows[*dbmodel.SpanRow]{Data: multipleSpans, ScanFn: scanSpanRowFn()}}","+\tquery := tracestore.TraceQueryParams{","+\t\tServiceName: \"serviceA\", Attributes: pcommon.NewMap(), SearchDepth: 2,","+\t\tStartTimeMin: start.Add(time.Second), StartTimeMax: end.Add(-time.Second),","+\t}","+\tcalls := 0","+\tconn := &searchTestConn{query: func(ctx context.Context, q string, args ...any) (driver.Rows, error) {","+\t\trequire.Equal(t, t.Context(), ctx)","+\t\tcalls++","+\t\tswitch calls {","+\t\tcase 1:","+\t\t\trequire.Contains(t, q, sql.SearchTraceIDsBase)","+\t\t\trequire.NotContains(t, q, \"JOIN\")","+\t\t\trequire.NotContains(t, q, \"trace_id_timestamps\")","+\t\t\trequire.Equal(t, []any{\"serviceA\", query.StartTimeMin, query.StartTimeMax, uint32(2)}, args)","+\t\t\treturn candidateRows, nil","+\t\tcase 2:","+\t\t\trequire.True(t, candidateRows.closed)","+\t\t\trequire.Equal(t, sql.SelectTraceIDTimestamps, q)","+\t\t\trequire.Contains(t, q, \"WHERE trace_id IN (?)\")","+\t\t\trequire.Contains(t, q, \"min(start) AS start\")","+\t\t\trequire.Contains(t, q, \"max(end) AS end\")","+\t\t\trequire.Contains(t, q, \"GROUP BY trace_id\")","+\t\t\trequire.Equal(t, []any{[]string{traceIDHex1, traceIDHex2}}, args)","+\t\t\treturn timestampRows, nil","+\t\tcase 3:","+\t\t\trequire.True(t, timestampRows.closed)","+\t\t\trequire.True(t, strings.HasPrefix(q, strings.TrimRight(sql.SelectSpansQuery, \"\\n\")))","+\t\t\trequire.Contains(t, q, \"WHERE (s.trace_id = ? AND s.start_time >= fromUnixTimestamp64Nano(?) AND s.start_time <= fromUnixTimestamp64Nano(?)) OR (s.trace_id = ? AND s.start_time >= fromUnixTimestamp64Nano(?) AND s.start_time <= fromUnixTimestamp64Nano(?))\")","+\t\t\trequire.NotContains(t, q, \"s.service_name =\")","+\t\t\trequire.NotContains(t, q, \"trace_id_timestamps\")","+\t\t\trequire.Equal(t, []any{","+\t\t\t\ttraceIDHex1, start.UnixNano(), end.Add(-time.Second).UnixNano(),","+\t\t\t\ttraceIDHex2, start.Add(time.Second).UnixNano(), end.UnixNano(),","+\t\t\t}, args)","+\t\t\treturn spanRows, nil","+\t\tdefault:","+\t\t\tt.Fatalf(\"unexpected query: %s\", q)","+\t\t\treturn nil, nil","+\t\t}","+\t}}","+\treader := NewReader(conn, testReaderConfig)","+\ttraces, err := jiter.FlattenWithErrors(reader.FindTraces(t.Context(), query))","+\trequire.NoError(t, err)","+\trequireTracesEqual(t, multipleSpans, traces)","+\trequire.Equal(t, 3, calls)","+\trequire.True(t, spanRows.closed)","+}","+","+func TestFindTraces_NoCandidates(t *testing.T) {","+\tfor _, method := range []string{\"FindTraces\", \"FindTraceIDs\"} {","+\t\tt.Run(method, func(t *testing.T) {","+\t\t\trows := &searchTestRows{Rows: &clickhousetest.Rows[[]any]{}}","+\t\t\tcalls := 0","+\t\t\tconn := &searchTestConn{query: func(_ context.Context, q string, _ ...any) (driver.Rows, error) {","+\t\t\t\tcalls++","+\t\t\t\trequire.Contains(t, q, sql.SearchTraceIDsBase)","+\t\t\t\treturn rows, nil","+\t\t\t}}","+\t\t\treader := NewReader(conn, testReaderConfig)","+\t\t\tquery := tracestore.TraceQueryParams{Attributes: pcommon.NewMap()}","+\t\t\tif method == \"FindTraces\" {","+\t\t\t\ttraces, err := jiter.FlattenWithErrors(reader.FindTraces(t.Context(), query))","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.Empty(t, traces)","+\t\t\t} else {","+\t\t\t\tids, err := flattenPageChunks(reader.FindTraceIDs(t.Context(), query))","+\t\t\t\trequire.NoError(t, err)","+\t\t\t\trequire.Empty(t, ids)","+\t\t\t}","+\t\t\trequire.Equal(t, 1, calls)","+\t\t\trequire.True(t, rows.closed)","+\t\t})","+\t}","+}","+","+func TestFindTraceIDs_MissingTimestamps(t *testing.T) {","+\tcandidates := &clickhousetest.Rows[[]any]{Data: [][]any{{traceIDHex1}, {traceIDHex2}}, ScanFn: scanTraceIDFn()}","+\ttimestamps := &clickhousetest.Rows[[]any]{","+\t\tData:   [][]any{{traceIDHex2, now.Add(-time.Hour), now}, {\"00000000000000000000000000000003\", now, now}},","+\t\tScanFn: scanTraceIDFn(),","+\t}","+\tconn := &clickhousetest.Driver{QueryResponses: map[string]*clickhousetest.QueryResponse{","+\t\tsql.SearchTraceIDsBase: {Rows: candidates}, sql.SelectTraceIDTimestamps: {Rows: timestamps},","+\t}}","+\treader := NewReader(conn, testReaderConfig)","+\tids, err := flattenPageChunks(reader.FindTraceIDs(t.Context(), tracestore.TraceQueryParams{Attributes: pcommon.NewMap()}))","+\trequire.NoError(t, err)","+\trequire.Equal(t, []tracestore.FoundTraceID{","+\t\t{TraceID: pcommon.TraceID{15: 1}},","+\t\t{TraceID: pcommon.TraceID{15: 2}, Start: now.Add(-time.Hour), End: now},","+\t}, ids)","+\tq, args := buildFindTracesQuery(ids)","+\trequire.Equal(t, strings.TrimRight(sql.SelectSpansQuery, \"\\n\")+","+\t\t\"\\nWHERE (s.trace_id = ?) OR (s.trace_id = ? AND s.start_time >= fromUnixTimestamp64Nano(?) AND s.start_time <= fromUnixTimestamp64Nano(?))\\nORDER BY s.trace_id\", q)","+\trequire.Equal(t, []any{traceIDHex1, traceIDHex2, now.Add(-time.Hour).UnixNano(), now.UnixNano()}, args)","+}","+","+func TestBuildFindTracesQuery_TimeBounds(t *testing.T) {","+\tstart := time.Unix(1700000000, 123456789)","+\tend := start.Add(3*time.Second + 987654321*time.Nanosecond)","+\tconst boundedTrace = \"(s.trace_id = ? AND s.start_time >= fromUnixTimestamp64Nano(?) AND s.start_time <= fromUnixTimestamp64Nano(?))\"","+\tfor _, tc := range []struct {","+\t\tname      string","+\t\tbounds    []tracestore.FoundTraceID","+\t\tcondition string","+\t\targs      []any","+\t}{","+\t\t{","+\t\t\tname: \"single trace\", bounds: []tracestore.FoundTraceID{{TraceID: pcommon.TraceID{15: 1}, Start: start, End: end}},","+\t\t\tcondition: boundedTrace,","+\t\t\targs:      []any{traceIDHex1, start.UnixNano(), end.UnixNano()},","+\t\t},","+\t\t{","+\t\t\tname: \"long trace does not widen another trace's range\", bounds: []tracestore.FoundTraceID{","+\t\t\t\t{TraceID: pcommon.TraceID{15: 1}, Start: start.Add(time.Second), End: end.Add(-time.Second)},","+\t\t\t\t{TraceID: pcommon.TraceID{15: 2}, Start: start.Add(-24 * time.Hour), End: end.Add(24 * time.Hour)},","+\t\t\t},","+\t\t\tcondition: boundedTrace + \" OR \" + boundedTrace,","+\t\t\targs: []any{","+\t\t\t\ttraceIDHex1, start.Add(time.Second).UnixNano(), end.Add(-time.Second).UnixNano(),","+\t\t\t\ttraceIDHex2, start.Add(-24 * time.Hour).UnixNano(), end.Add(24 * time.Hour).UnixNano(),","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"mixed metadata\", bounds: []tracestore.FoundTraceID{","+\t\t\t\t{TraceID: pcommon.TraceID{15: 1}, Start: start, End: end},","+\t\t\t\t{TraceID: pcommon.TraceID{15: 2}},","+\t\t\t\t{TraceID: pcommon.TraceID{15: 3}, Start: start.Add(-time.Hour), End: end.Add(time.Hour)},","+\t\t\t},","+\t\t\tcondition: boundedTrace + \" OR (s.trace_id = ?) OR \" + boundedTrace,","+\t\t\targs: []any{","+\t\t\t\ttraceIDHex1, start.UnixNano(), end.UnixNano(), traceIDHex2,","+\t\t\t\t\"00000000000000000000000000000003\", start.Add(-time.Hour).UnixNano(), end.Add(time.Hour).UnixNano(),","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"missing start\", bounds: []tracestore.FoundTraceID{{TraceID: pcommon.TraceID{15: 1}, End: end}},","+\t\t\tcondition: \"(s.trace_id = ?)\",","+\t\t\targs:      []any{traceIDHex1},","+\t\t},","+\t\t{","+\t\t\tname: \"missing end\", bounds: []tracestore.FoundTraceID{{TraceID: pcommon.TraceID{15: 1}, Start: start}},","+\t\t\tcondition: \"(s.trace_id = ?)\",","+\t\t\targs:      []any{traceIDHex1},","+\t\t},","+\t\t{","+\t\t\tname: \"all metadata missing\", bounds: []tracestore.FoundTraceID{","+\t\t\t\t{TraceID: pcommon.TraceID{15: 1}}, {TraceID: pcommon.TraceID{15: 2}},","+\t\t\t},","+\t\t\tcondition: \"(s.trace_id = ?) OR (s.trace_id = ?)\",","+\t\t\targs:      []any{traceIDHex1, traceIDHex2},","+\t\t},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tq, args := buildFindTracesQuery(tc.bounds)","+\t\t\trequire.Equal(t, strings.TrimRight(sql.SelectSpansQuery, \"\\n\")+\"\\nWHERE \"+tc.condition+\"\\nORDER BY s.trace_id\", q)","+\t\t\trequire.Equal(t, tc.args, args)","+\t\t})","+\t}","+}","+","+func TestFindTraceIDs_StageErrors(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname     string","+\t\tstage    int","+\t\trows     *clickhousetest.Rows[[]any]","+\t\tqueryErr error","+\t\texpected string","+\t}{","+\t\t{name: \"candidate close\", stage: 1, rows: &clickhousetest.Rows[[]any]{CloseErr: assert.AnError}, expected: \"failed to close rows\"},","+\t\t{name: \"timestamp query\", stage: 2, queryErr: assert.AnError, expected: \"failed to query trace timestamps\"},","+\t\t{name: \"timestamp scan\", stage: 2, rows: &clickhousetest.Rows[[]any]{Data: testTraceIDsData, ScanErr: assert.AnError}, expected: \"failed to scan row\"},","+\t\t{name: \"timestamp decode\", stage: 2, rows: &clickhousetest.Rows[[]any]{Data: [][]any{{\"invalid\", now, now}}, ScanFn: scanTraceIDFn()}, expected: \"failed to decode trace ID\"},","+\t\t{name: \"timestamp iteration\", stage: 2, rows: &clickhousetest.Rows[[]any]{RowsErr: assert.AnError}, expected: \"failed to read trace timestamp rows\"},","+\t\t{name: \"timestamp close\", stage: 2, rows: &clickhousetest.Rows[[]any]{CloseErr: assert.AnError}, expected: \"failed to close rows\"},","+\t\t{name: \"timestamp canceled\", stage: 2, queryErr: context.Canceled, expected: \"failed to query trace timestamps\"},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tcalls := 0","+\t\t\tvar checkedRows *searchTestRows","+\t\t\tcandidateRows := &searchTestRows{Rows: &clickhousetest.Rows[[]any]{Data: testTraceIDsData, ScanFn: scanTraceIDFn()}}","+\t\t\tconn := &searchTestConn{query: func(ctx context.Context, _ string, _ ...any) (driver.Rows, error) {","+\t\t\t\trequire.Equal(t, t.Context(), ctx)","+\t\t\t\tcalls++","+\t\t\t\tif calls == tc.stage {","+\t\t\t\t\tif tc.rows != nil {","+\t\t\t\t\t\tcheckedRows = &searchTestRows{Rows: tc.rows}","+\t\t\t\t\t\treturn checkedRows, nil","+\t\t\t\t\t}","+\t\t\t\t\treturn nil, tc.queryErr","+\t\t\t\t}","+\t\t\t\trequire.Equal(t, 1, calls)","+\t\t\t\treturn candidateRows, nil","+\t\t\t}}","+\t\t\treader := NewReader(conn, testReaderConfig)","+\t\t\t_, err := flattenPageChunks(reader.FindTraceIDs(t.Context(), tracestore.TraceQueryParams{Attributes: pcommon.NewMap()}))"],"additions":250,"deletions":0,"truncated":false}],"additions":462,"deletions":66,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-10-22T13:46:12.410140+00:00"}