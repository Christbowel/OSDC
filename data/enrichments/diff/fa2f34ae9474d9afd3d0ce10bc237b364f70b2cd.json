 = {"," };"," "," export default class ConsoleService extends Service {","+  @service api;","+","   @tracked isOpen = false;","   @tracked commandIndex = null;","   @tracked log = [];","@@ -29,11 +30,6 @@ export default class ConsoleService extends Service {","     return this.log.filter((log) => log.type === 'command');","   }"," ","-  // Not a getter so it can be stubbed in tests","-  adapter() {","-    return getOwner(this).lookup('adapter:console');","-  }","-","   shiftCommandIndex(key, setCommandFn = () => {}) {","     const [newIndex, newCommand] = shiftCommandIndex(key, this.commandHistory, this.commandIndex);","     if (newCommand !== undefined && newIndex !== undefined) {","@@ -66,15 +62,25 @@ export default class ConsoleService extends Service {","     this.log = log;","   }"," ","-  ajax(operation, path, options = {}) {","+  async ajax(operation, path, options = {}) {","     const verb = VERBS[operation];","-    const adapter = this.adapter();","-    const url = adapter.buildURL(encodePath(path));","     const { data, wrapTTL } = options;","-    return adapter.ajax(url, verb, {","-      data,","-      wrapTTL,","-    });","+    const headers = wrapTTL ? { 'X-Vault-Wrap-TTL': wrapTTL } : undefined;","+    let url = encodePath(path);","+","+    // The console accepts arbitrary paths so there is no generated API method to call (pattern guide §1c).","+    let response;","+    if (verb === 'GET') {","+      if (data) {","+        url = `${url}?${new URLSearchParams(data)}`;","+      }","+      response = await this.api.request.get(url, headers);","+    } else {","+      response = await this.api.request[verb.toLowerCase()](url, data, headers);","+    }","+","+    const text = await response.text();","+    return text ? JSON.parse(text) : undefined;","   }"," ","   kvGet(path, data, flags = {}) {"],"additions":20,"deletions":14,"truncated":false},{"path":"ui/e2e/tests/raft/snapshot.spec.ts","lines":["@@ -0,0 +1,133 @@","+/**","+ * Copyright IBM Corp. 2026","+ * SPDX-License-Identifier: BUSL-1.1","+ */","+","+import { expect } from '@playwright/test';","+import { test, holdForVideo, highlightElement } from '../../fixtures/demo';","+import fs from 'fs';","+","+import type { Page } from '@playwright/test';","+","+// The raft persona boots real Raft storage; snapshots are not available for inmem storage.","+// Tests run in order and share one snapshot file taken before the marker mount is created.","+test.describe.configure({ mode: 'serial' });","+","+// Blocking service workers forces the in-memory fetch fallback for downloads instead of the service worker path.","+test.use({ serviceWorkers: 'block' });","+","+const MARKER_MOUNT = 'snapshot-marker';","+let snapshotPath = '';","+","+const runConsoleCommand = async (page: Page, command: string, success: string) => {","+  await page.goto('dashboard');","+  await page.getByRole('button', { name: 'Console toggle' }).click();","+  const repl = page.getByRole('textbox', { name: 'Web R.E.P.L.' });","+  await repl.fill(command);","+  await repl.press('Enter');","+  await expect(page.locator('.console-ui-panel').getByText(success)).toBeVisible();","+  await highlightElement(page, page.locator('.console-ui-panel').getByText(success));","+};","+","+const enginePaths = async (page: Page) => {","+  await page.goto('secrets-engines');","+  await holdForVideo(page);","+  return page.getByRole('gridcell', { name: `${MARKER_MOUNT}/`, exact: true });","+};","+","+const goToRestore = async (page: Page) => {","+  await page.goto('storage/raft');","+  await page.getByRole('button', { name: 'Snapshots' }).click();","+  await page.getByRole('link', { name: 'Restore' }).click();","+  await expect(page.getByRole('heading', { name: 'Restore Snapshot' })).toBeVisible();","+};","+","+test('downloads a raft snapshot', async ({ page }, testInfo) => {","+  await page.goto('storage/raft');","+  await page.getByRole('button', { name: 'Snapshots' }).click();","+","+  const downloadPromise = page.waitForEvent('download');","+  await page.getByRole('button', { name: 'Download' }).click();","+  await expect(page.getByText('The snapshot download has begun.')).toBeVisible();","+  await highlightElement(page, page.getByText('The snapshot download has begun.'));","+  const download = await downloadPromise;","+","+  expect(download.suggestedFilename()).toBe('snapshot.gz');","+  snapshotPath = testInfo.outputPath('snapshot.gz');","+  await download.saveAs(snapshotPath);","+  const bytes = fs.readFileSync(snapshotPath);","+  expect(bytes.length).toBeGreaterThan(0);","+  // gzip magic number","+  expect([bytes[0], bytes[1]]).toEqual([0x1f, 0x8b]);","+});","+","+test('restores a snapshot and discards data written after it was taken', async ({ page }) => {","+  await test.step('create a marker mount after the snapshot was taken', async () => {","+    await runConsoleCommand(page, `write sys/mounts/${MARKER_MOUNT} type=kv`, 'Success! Data written to');","+    await expect(await enginePaths(page)).toBeVisible();","+  });","+","+  await test.step('restore the snapshot through the UI', async () => {","+    await goToRestore(page);","+    await page.locator('input[type=\"file\"]').setInputFiles(snapshotPath);","+    const responsePromise = page.waitForResponse(","+      (response) =>","+        response.url().endsWith('/v1/sys/storage/raft/snapshot') && response.request().method() === 'POST'","+    );","+    await page.getByRole('button', { name: 'Restore' }).click();","+    const response = await responsePromise;","+    expect(response.ok()).toBe(true);","+    await expect(page.getByText('The snapshot was successfully uploaded!')).toBeVisible();","+    await highlightElement(page, page.getByText('The snapshot was successfully uploaded!'));","+  });","+","+  await test.step('the marker mount no longer exists in the backend', async () => {","+    await expect(await enginePaths(page)).toHaveCount(0);","+    await holdForVideo(page);","+  });","+});","+","+test('force restores a snapshot through the force endpoint', async ({ page }) => {","+  await goToRestore(page);","+  await page.locator('input[type=\"file\"]').setInputFiles(snapshotPath);","+  await page.getByText('Force restore', { exact: true }).click();","+  await expect(page.getByRole('checkbox', { name: 'Force restore' })).toBeChecked();","+  await highlightElement(page, page.getByRole('checkbox', { name: 'Force restore' }));","+  const responsePromise = page.waitForResponse(","+    (response) =>","+      response.url().endsWith('/v1/sys/storage/raft/snapshot-force') && response.request().method() === 'POST'","+  );","+  await page.getByRole('button', { name: 'Restore' }).click();","+  const response = await responsePromise;","+  expect(response.ok()).toBe(true);","+  await expect(page.getByText('The snapshot was successfully uploaded!')).toBeVisible();","+  await highlightElement(page, page.getByText('The snapshot was successfully uploaded!'));","+});","+","+test('cancelling an upload aborts the restore without applying it', async ({ page }) => {","+  await test.step('create a marker mount that must survive the aborted restore', async () => {","+    await runConsoleCommand(page, `write sys/mounts/${MARKER_MOUNT} type=kv`, 'Success! Data written to');","+    await expect(await enginePaths(page)).toBeVisible();","+  });","+","+  await test.step('hold the upload open, then cancel it', async () => {","+    // Hold the restore request so the upload is still in flight when it is cancelled.","+    await page.route('**/v1/sys/storage/raft/snapshot', () => new Promise(() => undefined));","+    await goToRestore(page);","+    await page.locator('input[type=\"file\"]').setInputFiles(snapshotPath);","+    await page.getByRole('button', { name: 'Restore' }).click();","+    await expect(page.getByText('Uploading your file...')).toBeVisible();","+    await holdForVideo(page);","+    await page.getByRole('button', { name: 'Cancel upload' }).click();","+    await expect(page.getByText('Uploading your file...')).toBeHidden();","+    await expect(page.getByText('The snapshot was successfully uploaded!')).toBeHidden();","+    await holdForVideo(page);","+    await page.unroute('**/v1/sys/storage/raft/snapshot');","+  });","+","+  await test.step('the marker mount still exists, then clean it up', async () => {","+    await expect(await enginePaths(page)).toBeVisible();","+    await highlightElement(page, page.getByRole('gridcell', { name: `${MARKER_MOUNT}/`, exact: true }));","+    await runConsoleCommand(page, `delete sys/mounts/${MARKER_MOUNT}`, 'Success! Data deleted');","+  });","+});"],"additions":133,"deletions":0,"truncated":false},{"path":"ui/e2e/tests/superuser/console.spec.ts","lines":["@@ -3,7 +3,8 @@","  * SPDX-License-Identifier: BUSL-1.1","  */"," ","-import { test, expect } from '@playwright/test';","+import { expect } from '@playwright/test';","+import { test } from '../../fixtures/demo';"," import { BasePage } from '../../pages/base';"," "," test('console workflow', async ({ page }) => {","@@ -42,3 +43,57 @@ test('console workflow', async ({ page }) => {","     await basePage.disableEngine('console-route-test');","   });"," });","+","+test('console read, list, delete, wrap and error output', async ({ page }) => {","+  const basePage = new BasePage(page);","+  const mount = 'console-crud-test';","+  await page.goto('dashboard');","+  await page.getByRole('button', { name: 'Console toggle' }).click();","+  const repl = page.getByRole('textbox', { name: 'Web R.E.P.L.' });","+  const panel = page.locator('.console-ui-panel');","+  const run = async (command: string) => {","+    await repl.fill(command);","+    await repl.press('Enter');","+  };","+","+  await test.step('write a secret to a new kv mount', async () => {","+    await run(`write sys/mounts/${mount} type=kv`);","+    await expect(panel.getByText(`Success! Data written to: sys/mounts/${mount}`)).toBeVisible();","+    await run(`write ${mount}/my-secret foo=bar`);","+    await expect(panel.getByText(`Success! Data written to: ${mount}/my-secret`)).toBeVisible();","+  });","+","+  await test.step('read returns the stored data', async () => {","+    await run(`read ${mount}/my-secret`);","+    await expect(panel.locator('.console-ui-output').last()).toContainText(/foo\\s+bar/);","+    await run(`read -field=foo ${mount}/my-secret`);","+    await expect(panel.locator('.console-ui-output').last()).toHaveText('bar');","+  });","+","+  await test.step('list returns the secret key', async () => {","+    await run(`list ${mount}/`);","+    await expect(panel.locator('.console-ui-output').last()).toContainText('my-secret');","+  });","+","+  await test.step('read with wrap-ttl returns wrapping info', async () => {","+    await run(`read -wrap-ttl=5m ${mount}/my-secret`);","+    await expect(panel.locator('.console-ui-output').last()).toContainText(`creation_path`);","+    await expect(panel.locator('.console-ui-output').last()).toContainText(`${mount}/my-secret`);","+  });","+","+  await test.step('delete removes the secret and reading it again reports an error', async () => {","+    await run(`delete ${mount}/my-secret`);","+    await expect(","+      panel.getByText(`Success! Data deleted (if it existed) at: ${mount}/my-secret`)","+    ).toBeVisible();","+    await run(`read ${mount}/my-secret`);","+    const error = panel.locator('.console-ui-alert--error').last();","+    await expect(error).toContainText(`Error reading from: ${mount}/my-secret.`);","+    await expect(error).toContainText('Code: 404');","+  });","+","+  await test.step('clean up the mount', async () => {","+    await page.getByRole('button', { name: 'Close console' }).click();","+    await basePage.disableEngine(mount);","+  });","+});"],"additions":56,"deletions":1,"truncated":false},{"path":"ui/tests/integration/components/raft-storage-restore-test.js","lines":["@@ -6,8 +6,9 @@"," import { module, test } from 'qunit';"," import { setupRenderingTest } from 'vault/tests/helpers';"," import { setupMi