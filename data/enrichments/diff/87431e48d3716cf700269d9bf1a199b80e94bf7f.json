{"id":"87431e48d3716cf700269d9bf1a199b80e94bf7f","axis":"silent","repo":"vllm-project/vllm","sha":"87431e48d3716cf700269d9bf1a199b80e94bf7f","parsed":{"files":[{"path":"docs/features/quantization/modelopt.md","lines":["@@ -20,8 +20,14 @@ following `quantization.quant_algo` values:"," - `W4A16_NVFP4`: weight-only ModelOpt NVFP4 checkpoints with 16-bit","   activations (use `quantization=\"modelopt_fp4\"`)."," - `MXFP8`: ModelOpt MXFP8 checkpoints (use `quantization=\"modelopt_mxfp8\"`).","+- `INT8_PB_WO`: block-scaled INT8 weight-only linear layers with 16-bit","+  activations (use `quantization=\"modelopt_int8\"`): a symmetric int8 `weight`","+  and a `weight_scale` per `group_size` input elements (for example 16 or 32).","+  `group_size` is required. vLLM serves these layers with its mixed-precision","+  (WNA16) kernels, such as Marlin and Humming. MoE experts are not supported."," - `MIXED_PRECISION`: per-layer formats specified by `quantized_layers`","-  (use `quantization=\"modelopt_mixed\"`).","+  (use `quantization=\"modelopt_mixed\"`). Each layer may use any format above;","+  `INT8_PB_WO` layers take their own `group_size`."," "," For per-tensor `FP8`, vLLM converts E4M3FN weights and scales to E4M3FNUZ"," when required by the GPU, for example on AMD MI300."],"additions":7,"deletions":1,"truncated":false},{"path":"tests/quantization/test_modelopt.py","lines":["@@ -36,6 +36,7 @@"," from vllm.model_executor.layers.quantization.modelopt import (","     LINEAR_ALGOS,","     ModelOptFp8Config,","+    ModelOptInt8Config,","     ModelOptLinearMethod,","     ModelOptMixedPrecisionConfig,","     ModelOptMxFp8Config,","@@ -311,6 +312,9 @@ def test_modelopt_linear_algos_table_matches_resolve():","     class _Cfg:","         group_size = 16"," ","+        def layer_group_size(self, prefix):","+            return self.group_size","+","     for algo in LINEAR_ALGOS:","         spec, _, _ = resolve(algo, _Cfg(), \"layer\")","         assert spec.weight is not None, algo","@@ -323,6 +327,7 @@ class _Cfg:","     )","     assert algos_owned_by(\"modelopt_fp4\") == (\"NVFP4\", \"W4A16_NVFP4\")","     assert algos_owned_by(\"modelopt_mxfp8\") == (\"MXFP8\",)","+    assert algos_owned_by(\"modelopt_int8\") == (\"INT8_PB_WO\",)"," "," "," @pytest.mark.parametrize(\"algo\", list(LINEAR_ALGOS))","@@ -343,6 +348,7 @@ def test_modelopt_mixed_precision_dispatches_every_linear_algo(algo):","                 \"group_size\": 16,","                 \"quantized_layers\": {","                     \"model.layers.0.mlp.down_proj\": {\"quant_algo\": algo}","+                    | ({\"group_size\": 32} if algo == \"INT8_PB_WO\" else {})","                 },","             }","         }","@@ -385,6 +391,103 @@ def test_modelopt_mixed_precision_dispatches_block_fp8_moe(algo):","     assert fp8_config.activation_scheme == \"dynamic\""," "," ","+@pytest.mark.parametrize(","+    (\"config_cls\", \"quantization\"),","+    [","+        (ModelOptInt8Config, {\"quant_algo\": \"INT8_PB_WO\", \"group_size\": 32}),","+        (","+            ModelOptMixedPrecisionConfig,","+            {","+                \"quant_algo\": \"MIXED_PRECISION\",","+                \"quantized_layers\": {","+                    \"model.layers.0.mlp.experts.0.down_proj\": {","+                        \"quant_algo\": \"INT8_PB_WO\",","+                        \"group_size\": 32,","+                    }","+                },","+            },","+        ),","+    ],","+)","+def test_modelopt_int8_pb_wo_rejects_moe(config_cls, quantization):","+    \"\"\"INT8_PB_WO is linear-only: routed experts must fail rather than load as","+    an unquantized or FP8 MoE.\"\"\"","+    config = config_cls.from_config({\"quantization\": quantization})","+    with pytest.raises(NotImplementedError):","+        config.get_quant_method(","+            MagicMock(spec=RoutedExperts), \"model.layers.0.mlp.experts\"","+        )","+","+","+@pytest.mark.parametrize(\"mixed\", [False, True], ids=[\"whole_model\", \"per_layer\"])","+def test_modelopt_int8_pb_wo_requires_group_size(mixed):","+    \"\"\"An INT8_PB_WO layer without a group_size must fail rather than load","+    with scales of a guessed shape.\"\"\"","+    from vllm.model_executor.layers.linear import LinearBase","+","+    prefix = \"model.layers.0.mlp.down_proj\"","+    layer = {\"quant_algo\": \"INT8_PB_WO\"}","+    with pytest.raises(ValueError):","+        if mixed:","+            quantization = {","+                \"quant_algo\": \"MIXED_PRECISION\",","+                \"quantized_layers\": {prefix: layer},","+            }","+            config = ModelOptMixedPrecisionConfig.from_config(","+                {\"quantization\": quantization}","+            )","+            config.get_quant_method(MagicMock(spec=LinearBase), prefix)","+        else:","+            ModelOptInt8Config.from_config({\"quantization\": layer})","+","+","+@pytest.mark.parametrize(","+    (\"config_file\", \"quant_config\", \"expected\"),","+    [","+        (","+            \"config.json\",","+            {\"quant_method\": \"modelopt\", \"quant_algo\": \"INT8_PB_WO\", \"group_size\": 32},","+            ModelOptInt8Config,","+        ),","+        (","+            \"hf_quant_config.json\",","+            {","+                \"producer\": {\"name\": \"modelopt\"},","+                \"quantization\": {\"quant_algo\": \"INT8_PB_WO\", \"group_size\": 32},","+            },","+            ModelOptInt8Config,","+        ),","+        (","+            \"config.json\",","+            {\"quant_method\": \"modelopt\", \"quant_algo\": \"FP8\"},","+            ModelOptFp8Config,","+        ),","+    ],","+    ids=[\"int8_config_json\", \"int8_hf_quant_config\", \"fp8_config_json\"],","+)","+def test_modelopt_int8_pb_wo_routes_to_its_config(","+    tmp_path, config_file, quant_config, expected","+):","+    \"\"\"An INT8_PB_WO checkpoint declares quant_method \"modelopt\" (or only has a","+    legacy hf_quant_config.json) and must land on ModelOptInt8Config, while FP8","+    stays on ModelOptFp8Config.\"\"\"","+    from transformers import LlamaConfig","+","+    hf_config = LlamaConfig(num_hidden_layers=1, **_TINY_MODEL_CONFIG)","+    if config_file == \"config.json\":","+        hf_config.quantization_config = quant_config","+    hf_config.save_pretrained(tmp_path)","+    if config_file == \"hf_quant_config.json\":","+        (tmp_path / config_file).write_text(json.dumps(quant_config))","+","+    model_config = ModelConfig(","+        str(tmp_path), dtype=\"bfloat16\", skip_tokenizer_init=True","+    )","+    config = get_quant_config(model_config, LoadConfig())","+    assert isinstance(config, expected)","+    assert model_config.quantization == config.get_name()","+","+"," def test_modelopt_nvfp4_leaves_excluded_parallel_lm_head_unquantized():","     config = ModelOptNvFp4Config(","         is_checkpoint_nvfp4_serialized=True,","@@ -731,6 +834,128 @@ def _pack_fp8_weight(weights: dict[str, torch.Tensor], name: str, algorithm: str","         weights[f\"{name}.input_scale\"] = torch.tensor(1.0 / 448)"," "," ","+def _pack_int8_pb_wo_weight(","+    weights: dict[str, torch.Tensor],","+    reference: dict[str, torch.Tensor],","+    name: str,","+    group_size: int,","+    dtype: torch.dtype,","+):","+    \"\"\"Store `name` as ModelOpt INT8_PB_WO in `weights` and the `dtype`","+    weight the kernels dequantize it to in `reference`.\"\"\"","+    value = weights[f\"{name}.weight\"].float()","+    groups = value.reshape(value.shape[0], -1, group_size)","+    scale = groups.abs().amax(dim=-1) / 127","+    q = (groups / scale[..., None]).round().clamp(-128, 127).to(torch.int8)","+    weights[f\"{name}.weight\"] = q.reshape(value.shape)","+    weights[f\"{name}.weight_scale\"] = scale","+    reference[f\"{name}.weight\"] = (q.to(dtype) * scale.to(dtype)[..., None]).reshape(","+        value.shape","+    )","+","+","+@pytest.mark.skipif(not current_platform.is_cuda(), reason=\"WNA16 kernels are CUDA\")","+@pytest.mark.parametrize(","+    (\"quant_algo\", \"dtype\"),","+    [","+        (\"INT8_PB_WO\", \"float16\"),","+        (\"MIXED_PRECISION\", \"bfloat16\"),","+    ],","+)","+def test_modelopt_int8_pb_wo_checkpoint(tmp_path, vllm_runner, quant_algo, dtype):","+    \"\"\"INT8_PB_WO layers (group 16 and 32, fused or not) next to FP8 and","+    unquantized layers match the checkpoint holding their dequantized weights.\"\"\"","+    from transformers import LlamaConfig, LlamaForCausalLM","+","+    from vllm import SamplingParams","+","+    config = LlamaConfig(num_hidden_layers=1, **_TINY_MODEL_CONFIG)","+    with torch.random.fork_rng(devices=[]):","+        torch.manual_seed(0)","+        model = LlamaForCausalLM(config).to(torch.bfloat16)","+        prompt = torch.randint(config.vocab_size, (48,)).tolist()","+    attn, mlp = \"model.layers.0.self_attn\", \"model.layers.0.mlp\"","+    weights = model.state_dict()","+    if quant_algo == \"INT8_PB_WO\":","+        group_sizes = dict.fromkeys(","+            (","+                name.removesuffix(\".weight\")","+                for name in weights","+                if name.endswith(\"_proj.weight\")","+            ),","+            32,","+        )","+        quantization: dict[str, Any] = {\"quant_algo\": \"INT8_PB_WO\", \"group_size\": 32}","+        reference_quantization: dict[str, Any] | None = None","+    else:","+        # q/k/v and lm_head stay unquantized.","+        group_sizes = {","+            f\"{mlp}.gate_proj\": 16,","+            f\"{mlp}.up_proj\": 16,","+            f\"{mlp}.down_proj\": 32,","+        }","+        fp8_layers = {f\"{attn}.o_proj\": {\"quant_algo\": \"FP8\"}}","+        _pack_fp8_weight(weights, f\"{attn}.o_proj\", \"FP8\")","+        quantization = {","+            \"quant_algo\": \"MIXED_PRECISION\",","+            \"quantized_layers\": {","+                **fp8_layers,","+                **{","+                    name: {\"quant_algo\": \"INT8_PB_WO\", \"group_size\": group_size}","+                    for name, group_size in group_sizes.items()","+                },","+            },","+        }","+        reference_quantization = {","+            \"quant_algo\": \"MIXED_PRECISION\",","+            \"quantized_layers\": fp8_layers,","+        }","+    reference = dict(weights)","+    for name, group_size in group_sizes.items():","+        _pack_int8_pb_wo_weight(","+            weights, reference, name, group_size, getattr(torch, dtype)","+        )","+","+    params = SamplingParams(max_tokens=1, prompt_logprobs=0)","+    logprobs = []","+    for name, state_dict, quant in (","+        (\"int8\", weights, quantization),","+        (\"reference\", reference, reference_quantization),","+    ):","+        model_path = tmp_path / name","+        model.config.__dict__.pop(\"quantization_config\", None)","+        if quant is not None:","+            model.config.quantization_config = {","+                \"quant_method\": \"modelopt\",","+                \"kv_cache_quant_algo\": None,","+                \"exclude_modules\": [\"lm_head\"],","+                **quant,","+            }","+        model.save_pretrained(model_path, state_dict=state_dict)","+        with vllm_runner(","+            str(model_path),","+            dtype=dtype,","+            skip_tokenizer_init=True,","+            trust_remote_code=False,","+            enforce_eager=True,","+            enable_flashinfer_autotune=False,","+            max_model_len=64,","+            max_num_seqs=1,","+            kv_cache_memory_bytes=16 << 20,","+        ) as llm:","+            output = llm.llm.generate([{\"prompt_token_ids\": prompt}], params)[0]","+        assert output.prompt_logprobs is not None","+        logprobs.append(","+            torch.tensor(","+                [","+                    position[token].logprob","+                    for position, token in zip(output.prompt_logprobs[1:], prompt[1:])","+                ]","+            )","+        )","+    torch.testing.assert_close(logprobs[0], logprobs[1], rtol=0, atol=0.02)","+","+"," def test_modelopt_nested_mixed_checkpoint(tmp_path, monkeypatch, vllm_runner):","     \"\"\"Native and flattened ModelOpt metadata load the same FP8/BF16 weights.\"\"\"","     from transformers import LlamaConfig, LlamaForCausalLM"],"additions":225,"deletions":0,"truncated":false},{"path":"vllm/config/model.py","lines":["@@ -1436,6 +1436,7 @@ def _verify_quantization(self) -> None:","                 \"modelopt\",","                 \"modelopt_fp4\",","                 \"modelopt_mxfp8\",","+                \"modelopt_int8\",","                 \"mxfp8\",","                 \"modelopt_mixed\",","                 # Ensure heavy backends are probed last to avoid unnecessary"],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/model_executor/kernels/linear/mixed_precision/MPLinearKernel.py","lines":["@@ -8,6 +8,7 @@"," import torch"," "," from vllm.model_executor.layers.quantization.utils import replace_parameter","+from vllm.model_executor.layers.quantization.utils.quant_utils import QuantKey"," from vllm.model_executor.utils import retire_parameter"," from vllm.scalar_type import ScalarType"," ","@@ -57,6 +58,10 @@ def __init__(","             assert w_zp_param_name is not None","         self.w_zp_name: str | None = w_zp_param_name"," ","+    def input_quant_key(self) -> QuantKey | None:","+        \"\"\"Mixed-precision kernels take unquantized inputs.\"\"\"","+        return None","+","     @abstractmethod","     def process_weights_after_loading(self, layer: torch.nn.Module) -> None:","         raise NotImplementedError"],"additions":5,"deletions":0,"truncated":false},{"path":"vllm/model_executor/layers/quantization/__init__.py","lines":["@@ -21,6 +21,7 @@","     \"modelopt\",","     \"modelopt_fp4\",","     \"modelopt_mxfp8\",","+    \"modelopt_int8\",","     \"modelopt_mixed\",","     \"auto_gptq\",","     \"gptq\",","@@ -144,6 +145,7 @@ def get_quantization_config(quantization: str) -> type[QuantizationConfig]:","     from .inc import INCConfig","     from .modelopt import (","         ModelOptFp8Config,","+        ModelOptInt8Config,","         ModelOptMixedPrecisionConfig,","         ModelOptMxFp8Config,","         ModelOptNvFp4Config,","@@ -164,6 +166,7 @@ def get_quantization_config(quantization: str) -> type[QuantizationConfig]:","         \"modelopt\": ModelOptFp8Config,","         \"modelopt_fp4\": ModelOptNvFp4Config,","         \"modelopt_mxfp8\": ModelOptMxFp8Config,","+        \"modelopt_int8\": ModelOptInt8Config,","         \"modelopt_mixed\": ModelOptMixedPrecisionConfig,","         \"auto_gptq\": AutoGPTQConfig,","         \"gptq\": AutoGPTQConfig,"],"additions":3,"deletions":0,"truncated":false},{"path":"vllm/model_executor/layers/quantization/modelopt.py","lines":["@@ -14,6 +14,8 @@"," from vllm.config.quantization import QuantizationConfigArgs, QuantSpec"," from vllm.logger import init_logger"," from vllm.model_executor.kernels.linear import (","+    MPLinearLayerConfig,","+    choose_mp_linear_kernel,","     init_fp8_linear_kernel,","     init_mxfp8_linear_kernel,","     init_nvfp4_linear_kernel,","@@ -99,6 +101,7 @@","     kFp8Static128BlockSym,","     kFp8StaticTensorSym,","     kFp8StaticTokenSym,","+    kInt8Static,","     kMxfp8Dynamic,","     kMxfp8Static,","     kNvfp4Dynamic,","@@ -117,7 +120,9 @@"," from vllm.model_executor.parameter import (","     BlockQuantScaleParameter,","     ChannelQuantScaleParameter,","+    GroupQuantScaleParameter,","     ModelWeightParameter,","+    PackedvLLMParameter,","     PerTensorScaleParameter,"," )"," from vllm.model_executor.utils import (","@@ -143,7 +148,7 @@"," # Each entry is (owning config's name, mixed-precision sub-config attribute)."," # ``resolve`` turns the algo into a QuantSpec; this table only records which"," # config object holds the checkpoint parameters resolve may read -- today just","-# group_size, and only for the NVFP4 family.","+# group_size, for the NVFP4 family and INT8_PB_WO."," #"," # To add a format: one row here plus one row in resolve(). Every consumer below"," # is derived, so nothing else needs editing.","@@ -160,6 +165,9 @@","     \"W4A16_NVFP4\": (\"modelopt_fp4\", \"w4a16_nvfp4_config\"),","     # MXFP8: e4m3 weights with per-32-block e8m0 scales.","     \"MXFP8\": (\"modelopt_mxfp8\", \"mxfp8_config\"),","+    # INT8_PB_WO: int8 weights with per-block (group_size) scales, 16-bit","+    # activations.","+    \"INT8_PB_WO\": (\"modelopt_int8\", \"int8_pb_wo_config\"),"," }"," "," # MIXED_PRECISION is not a linear algo; it selects a per-layer algo from the","@@ -172,6 +180,14 @@ def algos_owned_by(config_name: str) -> tuple[str, ...]:","     return tuple(a for a, (owner, _) in LINEAR_ALGOS.items() if owner == config_name)"," "," ","+def _reject_int8_pb_wo_moe(algo: str | None, prefix: str) -> None:","+    if algo == \"INT8_PB_WO\":","+        raise NotImplementedError(","+            f\"ModelOpt INT8_PB_WO supports linear layers only; {prefix} is a \"","+            \"FusedMoE layer.\"","+        )","+","+"," class ModelOptKVCacheMethod(BaseKVCacheMethod):","     \"\"\"Supports loading kv-cache scaling factors from FP8 or NVFP4 checkpoints.\"\"\""," ","@@ -1664,6 +1680,74 @@ def apply("," ModelOptMxFp8Config.KVCacheMethodCls = ModelOptKVCacheMethod"," "," ","+class ModelOptInt8Config(ModelOptQuantConfigBase):","+    \"\"\"Config class for ModelOpt INT8_PB_WO (per-block INT8 weight-only).\"\"\"","+","+    def __init__(","+        self,","+        group_size: int,","+        kv_cache_quant_algo: str | None,","+        exclude_modules: list[str],","+    ) -> None:","+        super().__init__(exclude_modules)","+        self.quant_method = \"INT8_PB_WO\"","+        self.group_size = group_size","+        self.kv_cache_quant_algo = kv_cache_quant_algo","+","+    def layer_group_size(self, prefix: str) -> int:","+        return self.group_size","+","+    def get_name(self) -> QuantizationMethods:","+        return \"modelopt_int8\"","+","+    def get_supported_act_dtypes(self) -> list[torch.dtype]:","+        return [torch.bfloat16, torch.half]","+","+    @classmethod","+    def get_min_capability(cls) -> int:","+        # Marlin and Humming serve int8 weight groups from Turing (SM75) up.","+        return 75","+","+    @classmethod","+    def override_quantization_method(","+        cls, hf_quant_cfg, user_quant, hf_config=None","+    ) -> QuantizationMethods | None:","+        if cls._extract_modelopt_quant_algo(hf_quant_cfg) == \"INT8_PB_WO\":","+            return \"modelopt_int8\"","+        return None","+","+    @classmethod","+    def _from_config(","+        cls,","+        *,","+        quant_method: str,","+        kv_cache_quant_method: str | None,","+        exclude_modules: list[str],","+        original_config: dict[str, Any],","+        group_size: int | None,","+        **kwargs: Any,","+    ) -> \"ModelOptInt8Config\":","+        supported = algos_owned_by(\"modelopt_int8\")","+        if quant_method not in supported:","+            raise ValueError(","+                f\"Unsupported ModelOpt INT8 quant_algo: {quant_method}. \"","+                f\"Supported: {' / '.join(supported)}.\"","+            )","+        if not group_size:","+            raise ValueError(\"ModelOpt INT8_PB_WO requires a group_size.\")","+        return cls(group_size, kv_cache_quant_method, exclude_modules)","+","+    def get_quant_method(","+        self, layer: torch.nn.Module, prefix: str","+    ) -> \"QuantizeMethodBase | None\":","+        if isinstance(layer, RoutedExperts) and not self.is_layer_excluded(prefix):","+            _reject_int8_pb_wo_moe(self.quant_method, prefix)","+        return super().get_quant_method(layer, prefix)","+","+","+ModelOptInt8Config.KVCacheMethodCls = ModelOptKVCacheMethod","+","+"," class ModelOptMixedPrecisionConfig(ModelOptQuantConfigBase):","     \"\"\"Config class for ModelOpt MIXED_PRECISION."," ","@@ -1738,6 +1822,15 @@ def has_blocked_w