       self.assertTrue(","+                        cross_windows._windows_cross_remote_execution_disabled(args, {}, root)","+                    )","+                    options = cross_windows._windows_cross_user_options(args, {}, root)","+                    if config == \"local\":","+                        for flag in [","+                            \"--remote_cache=\",","+                            \"--experimental_remote_downloader=\",","+                            \"--tls_client_certificate=\",","+                            \"--tls_client_key=\",","+                            \"--bes_backend=\",","+                        ]:","+                            self.assertIn(flag, options)","+                    else:","+                        self.assertNotIn(\"--remote_cache=\", options)","+","+    def test_native_rollback_has_no_remote_only_link_strategies(self):","+        source = constants.REPO_ROOT / \".bazelrc\"","+        with tempfile.TemporaryDirectory() as directory:","+            root = pathlib.Path(directory)","+            (root / \".bazelrc\").write_text(source.read_text(encoding=\"utf-8\"), encoding=\"utf-8\")","+            args = [\"--nosystem_rc\", \"--nohome_rc\", \"test\", \"--config=windows_unittest\", \"//target\"]","+            for switch in [","+                \"MONGO_WINDOWS_CROSS_DEFAULT_CONFIG\",","+                \"MONGO_BAZEL_USE_HERMETIC_CONTAINER\",","+            ]:","+                with self.subTest(switch=switch):","+                    env = {switch: \"0\"}","+                    self.assertFalse(","+                        runner.should_use_hermetic_container(","+                            args=args, env=env, system=\"Windows\", repo_root=root","+                        )","+                    )","+                    options = bazelrc._bazel_effective_options(args, env, root)","+                    self.assertIn(\"--linkstatic=True\", options)","+                    self.assertIn(\"--run_under=//bazel:windows_test_launcher\", options)","+                    self.assertNotIn(\"--//bazel/config:remote_link=True\", options)","+                    for mnemonic in [","+                        \"CppLink\",","+                        \"CppArchive\",","+                        \"SolibSymlink\",","+                        \"ExtractDebugInfo\",","+                        \"StripDebugInfo\",","+                    ]:","+                        self.assertNotIn(f\"--strategy={mnemonic}=remote\", options)","+","+"," class WindowsCrossExecutionTest(CrossPlanningTestCase):","+    def test_automatic_windows_config_activation_follows_option_precedence(self):","+        with tempfile.TemporaryDirectory() as directory:","+            repo_root = pathlib.Path(directory)","+            (repo_root / \".bazelrc\").write_text(","+                \"common --enable_platform_specific_config=false\\n\"","+                \"common:enable-host-config --enable_platform_specific_config\\n\"","+                \"build:windows --platforms=@local_config_platform//:host\\n\",","+                encoding=\"utf-8\",","+            )","+            for flags, expected in [","+                ([], config_module.IntegrationMode.WINDOWS_CROSS_HOST),","+                ([\"--enable_platform_specific_config=true\"], config_module.IntegrationMode.DIRECT),","+                ([\"--config=enable-host-config\"], config_module.IntegrationMode.DIRECT),","+                (","+                    [\"--noenable_platform_specific_config\", \"--enable_platform_specific_config\"],","+                    config_module.IntegrationMode.DIRECT,","+                ),","+                (","+                    [\"--enable_platform_specific_config\", \"--noenable_platform_specific_config\"],","+                    config_module.IntegrationMode.WINDOWS_CROSS_HOST,","+                ),","+            ]:"],"additions":95,"deletions":0,"truncated":false}],"additions":332,"deletions":50,"truncated":true,"file_count":5},"error":null,"fetc