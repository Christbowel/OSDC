rgs, [\"--config=remote_link\"])","     command_index = _bazel_command_index(args)","     if command_index is not None:","         unix_root_option = f\"--host_jvm_args=-Dbazel.windows_unix_root={WINDOWS_CROSS_UNIX_ROOT}\"","@@ -622,7 +737,9 @@ def _windows_cross_host_wrapper_action_args(","     exec_properties = _windows_cross_rbe_exec_properties(selection_env, containers=containers)","     platform_properties = dict(prop.split(\"=\", 1) for prop in exec_properties)","     output_base = _bazel_output_base(args, env)","-    if _remote_link_requested(args, env=env, repo_root=REPO_ROOT):","+    if local_actions:","+        link_options = []","+    elif _remote_link_requested(args, env=env, repo_root=REPO_ROOT):","         link_options = [\"--//bazel/config:remote_link=True\", \"--strategy=CppLink=remote\"]","     else:","         link_options = _windows_container_action_options(output_base)","@@ -671,18 +788,13 @@ def _windows_cross_host_wrapper_action_args(","             \"--shell_executable=/bin/bash\",","             f\"--action_env=PATH={_windows_cross_action_path(env)}\",","             f\"--host_action_env=PATH={_windows_cross_action_path(env)}\",","-            \"--strategy=MongoInstallRule=local\",","+            *[f\"--strategy={mnemonic}=local\" for mnemonic in WINDOWS_HOST_LOCAL_MNEMONICS],","             # Build tools target the Linux execution platform, including Python and Rust","             # helper actions. Native Windows installation/debug actions stay local below.","             \"--spawn_strategy=remote,local\",","             \"--strategy=CppCompile=remote\",","             *link_options,","             \"--strategy=CppArchive=remote\",","-            \"--strategy=SolibSymlink=local\",","-            \"--strategy=ExtractDebugInfo=local\",","-            \"--strategy=StripDebugInfo=local\",","-            \"--strategy=CcGenerateIntermediateDwp=local\",","-            \"--strategy=CcGenerateDwp=local\",","             \"--strategy=ConfigHeaderGen=r