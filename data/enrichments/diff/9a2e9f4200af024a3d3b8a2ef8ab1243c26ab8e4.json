 return [","-        *args[: command_index + 1],","-        f\"--config={WINDOWS_CROSS_CONFIG}\",","-        *args[command_index + 1 :],","-    ]","+    # Materialize automatic Windows options before the cross route disables host","+    # configs, preserving aliases and local cache/auth policies as well as cross selection.","+    configured_args = list(args)","+    if not _config_requested(args, WINDOWS_CROSS_CONFIG, env=env, repo_root=repo_root):","+        configured_args.insert(command_index + 1, f\"--config={WINDOWS_CROSS_CONFIG}\")","+    if automatic_options:","+        # The options are already expanded. Keep their final ordering without","+        # re-expanding aliases or restoring the native Windows executor default.","+        materialized_options = []","+        index = 0","+        while index < len(automatic_options):","+            option = automatic_options[index]","+            if option == \"--config\":","+                index += 2","+                continue","+            if not option.startswith(\"--config=\"):","+                materialized_options.append(option)","+            index += 1","+        configured_args = _append_bazel_command_options_last(configured_args, materialized_options)","+    return configured_args"," "," "," def _windows_cross_repo_env_values(","@@ -465,7 +571,7 @@ def _prepare_windows_cross_env(","     system: str,"," ) -> Mapping[str, str]:","     if system != \"Windows\" or not _windows_cross_config_requested(","-        args, env=env, repo_root=repo_root","+        args, env=env, repo_root=repo_root, system=system","     ):","         return env"," ","@@ -523,6 +629,7 @@ def _windows_cross_host_wrapper_action_candidate(","     args: Sequence[str],","     env: Mapping[str, str],","     system: str,","+    repo_root: pathlib.Path = REPO_ROOT,"," ) -> bool:","     command = _bazel_command(args)","     if command == \"run\" and not _is_cross_default_run_target(_bazel_run_target(args)):","@@ -532,10 +639,11 @@ def _window