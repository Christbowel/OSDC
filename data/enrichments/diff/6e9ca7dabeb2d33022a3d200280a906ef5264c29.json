           dirs.push(project.root_dir.clone());","             manifests.push(&project.manifest);","         }","     }","-    let standalone = select_standalone_ecosystem_dirs(","-        &selection.workspace_root,","-        state.project_dir(),","-        &npm_dirs,","-        &selection.selected_dirs,","-        state.config,","-    )","-    .await?;","-    dirs.extend(standalone.selected);","-    Ok((dirs, manifests))","+    dirs.extend_from_slice(standalone_dirs);","+    (dirs, manifests)"," }"," "," async fn run_ecosystem_updates_on_targets<Reporter: self::Reporter + 'static>(","@@ -140,7 +131,7 @@ async fn run_ecosystem_updates_on_targets<Reporter: self::Reporter + 'static>(","     http_client: &Arc<ThrottledClient>,","     options: EcosystemUpdateStepOptions<'_>,"," ) -> Result<EcosystemUpdateOutcome> {","-    let parsed = parse_update_selectors(options.selectors, config)?;","+    let parsed = selectors::parse_update_selection(options.selectors, config, options.bare_names)?;","     if !config.cargo.enabled && !config.python.enabled {","         return Ok(EcosystemUpdateOutcome {","             updated_any: false,","@@ -152,23 +143,15 @@ async fn run_ecosystem_updates_on_targets<Reporter: self::Reporter + 'static>(","     } else {","         PythonUpdateTargets::default()","     };","-    validate_explicit_requests(target_dirs, &python_targets, config, &parsed)?;","+    if !options.requests_validated {","+        validate_explicit_requests(target_dirs, &python_targets, config, &parsed)?;","+    }","     let all_groups = [DependencyGroup::Prod, DependencyGroup::Dev, DependencyGroup::Optional];","     let python_dep_names = python_targets.declared_names_for_groups(&all_groups);","-    let restrict = !options.selectors.is_empty();","-    let bare_matcher =","-        (!parsed.bare_patterns.is_empty()).then(|| create_matcher(&parsed.bare_patterns));","     let updated_any = update_ecosystem_targets::<Reporter>(","         target_dirs,","         python_targets,"