, graphServiceKey, v1beta1.Stopped, corev1.ConditionFalse)"," \t\t\t})","+","+\t\t\tIt(\"Should recreate the service when it is deleted because the graph controller owns it\", func() {","+\t\t\t\tctx, cancel := context.WithCancel(context.Background())","+\t\t\t\tDeferCleanup(cancel)","+","+\t\t\t\t// Config map","+\t\t\t\tconfigMap := createIGConfigMap()","+\t\t\t\tExpect(k8sClient.Create(context.TODO(), configMap)).NotTo(HaveOccurred())","+\t\t\t\tdefer k8sClient.Delete(context.TODO(), configMap)","+","+\t\t\t\t// Define InferenceGraph","+\t\t\t\tserviceNamespace := \"default\"","+\t\t\t\tgraphName := \"raw-service-recreate-ig\"","+\t\t\t\tgraphServiceKey := types.NamespacedName{Name: graphName, Namespace: serviceNamespace}","+\t\t\t\tig := defaultRawIG(graphServiceKey)","+\t\t\t\tig.Annotations[constants.StopAnnotationKey] = \"false\"","+\t\t\t\tExpect(k8sClient.Create(ctx, ig)).Should(Succeed())","+\t\t\t\tdefer k8sClient.Delete(ctx, ig)","+","+\t\t\t\t// Check the inference graph","+\t\t\t\texpectResourceToExist(context.Background(), &appsv1.Deployment{}, graphServiceKey)","+\t\t\t\texpectDeploymentToBeReady(context.Background(), graphServiceKey)","+\t\t\t\texpectResourceToExist(context.Background(), &corev1.Service{}, graphServiceKey)","+\t\t\t\texpectIGConditionStatus(ctx, graphServiceKey, apis.ConditionReady, corev1.ConditionTrue)","+","+\t\t\t\t// Delete the managed Service directly. Deleting an owned resource must","+\t\t\t\t// re-enqueue the owning InferenceGraph (via the .Owns(&corev1.Service{})","+\t\t\t\t// watch) so the controller recreates it instead of leaving the graph's","+\t\t\t\t// route pointing at a deleted Service.","+\t\t\t\townedService := &corev1.Service{}","+\t\t\t\tExpect(k8sClient.Get(ctx, graphServiceKey, ownedService)).To(Succeed())","+\t\t\t\toriginalUID := ownedService.UID","+\t\t\t\tExpect(k8sClient.Delete(ctx, ownedService.DeepCopy())).NotTo(HaveOccurred())","+","+\t\t\t\t// The controller may recreate the Service before a Get observes","+\t\t\t\t// NotFound, so wait for a replacement with a different UID rather","+\t\t\t\t// than asserting the Service is gone in between.","+\t\t\t\tEventually(func() (types.UID, error) {","+\t\t\t\t\trecreated := &corev1.Service{}","+\t\t\t\t\terr := k8sClient.Get(ctx, graphServiceKey, recreated)","+\t\t\t\t\tif err != nil {","+\t\t\t\t\t\treturn \"\", err","+\t\t\t\t\t}","+\t\t\t\t\treturn recreated.UID, nil","+\t\t\t\t}, timeout, interval).Should(Not(Equal(originalUID)), \"the graph controller should recreate the deleted Service\")","+","+\t\t\t\t// And the graph must report Ready again once its service is restored.","+\t\t\t\texpectIGConditionStatus(ctx, graphServiceKey, apis.ConditionReady, corev1.ConditionTrue)","+\t\t\t})"," \t\t})"," \t})"," "],"additions":49,"deletions":0,"truncated":false},{"path":"pkg/controller/v1alpha1/inferencegraph/suite_test.go","lines":["@@ -29,6 +29,7 @@ import ("," \t\"k8s.io/client-go/rest\""," \t\"k8s.io/client-go/tools/record\""," \tctrl \"sigs.k8s.io/controller-runtime\"","+\t\"sigs.k8s.io/controller-runtime/pkg/cache\""," \t\"sigs.k8s.io/controller-runtime/pkg/client\""," "," \t\"github.com/kserve/kserve/pkg/apis/serving/v1beta1\"","@@ -60,6 +61,10 @@ var _ = BeforeSuite(func(ctx SpecContext) {"," \tExpect(err).ToNot(HaveOccurred())"," "," \tctrlFunc := func(restCfg *rest.Config, mgr ctrl.Manager) error {","+\t\t// Production shares the manager with the InferenceService controller.","+\t\tif _, err := mgr.GetCache().GetInformer(context.Background(), &v1beta1.InferenceService{}, cache.BlockUntilSynced(false)); err != nil {","+\t\t\treturn err","+\t\t}"," \t\tclientset, err := kubernetes.NewForConfig(restCfg)"," \t\tif err != nil {"," \t\t\treturn err","@@ -84,9 +89,11 @@ var _ = BeforeSuite(func(ctx SpecContext) {"," "," \tenvTest := pkgtest.NewEnvTest()."," \t\tWithControllers(ctrlFunc).","-\t\tWithManagerOptions(func(opts *ctrl.Options) {","+\t\tWithManagerOptions(func(opts *ctrl.Options, cfg *rest.Config) {"," \t\t\to