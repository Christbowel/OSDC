o ($router)',","+  ({ pathname, file, content }) => {","+    const { next } = nextTestSetup({","+      files: __dirname,","+    })","+","+    it('shows build errors while the registry request is pending and updates the version once it resolves', async () => {","+      const browser = await next.browser(pathname)","+      expect(await browser.elementByCss('p').text()).toBe(content)","+","+      await next.patchFile(file, (source) =>","+        source!.replace(","+          'export default function Page',","+          \"import 'does-not-exist'\\n\\nexport default function Page\"","+        )","+      )","+","+      await waitForRedbox(browser)","+      expect(await getRedboxDescription(browser)).toBe(","+        \"Module not found: Can't resolve 'does-not-exist'\"","+      )","+      expect(await getVersionStatus(browser)).toContain('(unknown)')","+","+      await next.patchFile('release-registry', '')","+","+      await retry(async () => {","+        expect(await getVersionStatus(browser)).toContain('(outdated)')","+      }, 10_000)","+","+      // A late version update must not clear the current build error.","+      await waitForRedbox(browser)","+      expect(await getRedboxDescription(browser)).toBe(","+        \"Module not found: Can't resolve 'does-not-exist'\"","+      )","+    })","+  }","+)"],"additions":64,"deletions":0,"truncated":false},{"path":"test/development/app-dir/dev-overlay-pending-version-info/next.config.js","lines":["@@ -0,0 +1,42 @@","+const fs = require('fs')","+const path = require('path')","+","+// Simulates a package registry that does not respond: the dev server's","+// version-staleness request hangs until the test creates the marker file.","+// The fake dist-tags then mark the installed version as outdated. The registry","+// comes from the package manager config, so any URL ending in the dist-tags","+// path is intercepted.","+const DIST_TAGS_PATH = '/-/package/next/dist-tags'","+const releaseMarker = path.join(__dirname, 'release-regi