{"id":"e52ab6d17d1a6c07e70b18d5d07e0be65fcf11b7","axis":"silent","repo":"elastic/elasticsearch","sha":"e52ab6d17d1a6c07e70b18d5d07e0be65fcf11b7","parsed":{"files":[{"path":"docs/changelog/167047.yaml","lines":["@@ -0,0 +1,6 @@","+area: ES|QL","+issues:","+ - 167003","+pr: 167047","+summary: Add ES|QL query duration and count metrics by time range filter age and source command","+type: enhancement"],"additions":6,"deletions":0,"truncated":false},{"path":"modules/apm/src/main/java/org/elasticsearch/telemetry/apm/internal/MetricValidator.java","lines":["@@ -134,6 +134,9 @@ private static class Attributes {"," ","         static final Set<String> ESQL_ATTRIBUTES = Set.of(\"feature_name\", \"success\");"," ","+        // Shared with the search metrics, so that one filter covers Query DSL and ES|QL queries.","+        static final Set<String> ESQL_QUERY_ATTRIBUTES = Set.of(\"time_range_filter_from\");","+","         static final Set<String> ESQL_RESOLVED_SETTINGS_ATTRIBUTES = Set.of(\"feature_name\", \"setting_value\", \"success\");"," ","         static final Set<String> DOWNSAMPLE_ATTRIBUTES = Set.of(\"status\");","@@ -206,6 +209,8 @@ private static class Attributes {","             Map.entry(\"es.esql.commands.usages.total\", ESQL_ATTRIBUTES),","             Map.entry(\"es.esql.functions.queries.total\", ESQL_ATTRIBUTES),","             Map.entry(\"es.esql.functions.usages.total\", ESQL_ATTRIBUTES),","+            Map.entry(\"es.esql.query.duration.histogram\", ESQL_QUERY_ATTRIBUTES),","+            Map.entry(\"es.esql.query.total\", ESQL_QUERY_ATTRIBUTES),","             Map.entry(\"es.esql.settings.queries.total\", ESQL_ATTRIBUTES),","             Map.entry(\"es.esql.resolved_settings.queries.total\", ESQL_RESOLVED_SETTINGS_ATTRIBUTES),","             Map.entry(\"es.esql.settings.usages.total\", ESQL_ATTRIBUTES),"],"additions":5,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/internalClusterTest/java/org/elasticsearch/xpack/esql/action/QueryDurationMetricIT.java","lines":["@@ -0,0 +1,152 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.esql.action;","+","+import org.elasticsearch.cluster.metadata.View;","+import org.elasticsearch.common.settings.Settings;","+import org.elasticsearch.common.util.CollectionUtils;","+import org.elasticsearch.common.util.Maps;","+import org.elasticsearch.core.Nullable;","+import org.elasticsearch.index.query.BoolQueryBuilder;","+import org.elasticsearch.index.query.RangeQueryBuilder;","+import org.elasticsearch.plugins.Plugin;","+import org.elasticsearch.plugins.PluginsService;","+import org.elasticsearch.telemetry.Measurement;","+import org.elasticsearch.telemetry.TestTelemetryPlugin;","+import org.elasticsearch.xpack.esql.telemetry.PlanTelemetryManager;","+import org.elasticsearch.xpack.esql.view.DeleteViewAction;","+import org.elasticsearch.xpack.esql.view.PutViewAction;","+import org.junit.Before;","+","+import java.util.Collection;","+import java.util.List;","+import java.util.Map;","+import java.util.function.Function;","+import java.util.stream.StreamSupport;","+","+import static org.elasticsearch.test.hamcrest.ElasticsearchAssertions.assertAcked;","+import static org.elasticsearch.xpack.esql.action.EsqlQueryRequest.syncEsqlQueryRequest;","+import static org.elasticsearch.xpack.esql.telemetry.PlanTelemetryManager.OUTCOME;","+import static org.elasticsearch.xpack.esql.telemetry.PlanTelemetryManager.SOURCE_COMMAND;","+import static org.elasticsearch.xpack.esql.telemetry.PlanTelemetryManager.TIME_RANGE_FILTER_FROM;","+import static org.hamcrest.Matchers.empty;","+import static org.hamcrest.Matchers.equalTo;","+import static org.hamcrest.Matchers.hasSize;","+","+/**","+ * Each ES|QL query is counted once on the coordinator, labelled with its source command, the bucketed age of the lower bound of the","+ * request filter's {@code @timestamp} range and its outcome, whichever node coordinates it and however it is run. Only successful queries","+ * also record their duration.","+ */","+public class QueryDurationMetricIT extends AbstractEsqlIntegTestCase {","+","+    @Override","+    protected Collection<Class<? extends Plugin>> nodePlugins() {","+        return CollectionUtils.appendToCopy(super.nodePlugins(), TestTelemetryPlugin.class);","+    }","+","+    @Before","+    public void createIndices() {","+        assertAcked(prepareCreate(\"logs\").setMapping(\"@timestamp\", \"type=date\", \"message\", \"type=keyword\"));","+        client().prepareIndex(\"logs\").setSource(\"@timestamp\", \"2026-01-01T00:00:00Z\", \"message\", \"hello\").get();","+        refresh(\"logs\");","+        assertAcked(","+            prepareCreate(\"metrics\").setSettings(Settings.builder().put(\"mode\", \"time_series\").putList(\"routing_path\", \"host\"))","+                .setMapping(\"@timestamp\", \"type=date\", \"host\", \"type=keyword,time_series_dimension=true\", \"cpu\", \"type=long\")","+        );","+        ensureGreen(\"logs\", \"metrics\");","+        telemetryPlugins().forEach(TestTelemetryPlugin::resetMeter);","+    }","+","+    public void testSuccess() {","+        // Kibana's nested filter shape. The age is relative to the start derived from the took, which can be a millisecond off the","+        // now that date math resolves against, so the range keeps clear of a bucket threshold.","+        var filter = new BoolQueryBuilder().filter(new RangeQueryBuilder(\"@timestamp\").gte(\"now-30m\").lte(\"now\"));","+        run(syncEsqlQueryRequest(\"TS metrics | LIMIT 1\").filter(filter)).close();","+        assertRecorded(\"TS\", \"1_hour\", \"success\");","+","+        run(syncEsqlQueryRequest(\"FROM logs | LIMIT 1\")).close();","+        assertRecorded(\"FROM\", null, \"success\");","+    }","+","+    public void testSourceCommandThroughView() {","+        String viewName = \"metrics_view\";","+        assertAcked(","+            client().execute(","+                PutViewAction.INSTANCE,","+                new PutViewAction.Request(TEST_REQUEST_TIMEOUT, TEST_REQUEST_TIMEOUT, new View(viewName, \"TS metrics | STATS max(cpu)\"))","+            )","+        );","+        try {","+            // Classify the source inside the resolved view, even though the query uses FROM to read it.","+            run(syncEsqlQueryRequest(\"FROM \" + viewName + \" | LIMIT 1\")).close();","+            assertRecorded(\"TS\", null, \"success\");","+        } finally {","+            assertAcked(","+                client().execute(","+                    DeleteViewAction.INSTANCE,","+                    new DeleteViewAction.Request(TEST_REQUEST_TIMEOUT, TEST_REQUEST_TIMEOUT, new String[] { viewName })","+                )","+            );","+        }","+    }","+","+    public void testFailure() {","+        // A short range that is long past reads old data.","+        var filter = new RangeQueryBuilder(\"@timestamp\").gte(\"2026-01-01T00:00:00Z\").lte(\"2026-01-01T00:15:00Z\");","+        expectThrows(Exception.class, () -> run(syncEsqlQueryRequest(\"FROM logs | EVAL value = COUNT(*)\").filter(filter)));","+        assertRecorded(\"FROM\", \"older_than_14_days\", \"failed\");","+","+        // Execute directly rather than via run(), which may parse client-side to wrap as a PreparedEsqlQueryRequest.","+        expectThrows(","+            Exception.class,","+            () -> client().execute(EsqlQueryAction.INSTANCE, syncEsqlQueryRequest(\"FROM logs | NOT_A_COMMAND\")).actionGet()","+        );","+        assertRecorded(\"UNKNOWN\", null, \"failed\");","+    }","+","+    public void testStreaming() throws Exception {","+        var filter = new RangeQueryBuilder(\"@timestamp\").gte(\"now-2d\").lte(\"now\");","+        var subscriber = new StreamQueryTestUtils.CountingStreamSubscriber();","+        StreamQueryTestUtils.executeStreamRequest(client(), syncEsqlQueryRequest(\"FROM logs | LIMIT 1\").filter(filter), subscriber);","+        // The stream can complete for the client before the coordinator has finished the query.","+        assertBusy(() -> assertRecorded(\"FROM\", \"3_days\", \"success\"));","+    }","+","+    /**","+     * Asserts that exactly one query was counted, across all nodes, with these attributes, that its duration was recorded only if it","+     * succeeded, and resets the meters.","+     */","+    private void assertRecorded(String sourceCommand, @Nullable String timeRangeFilterFrom, String outcome) {","+        Map<String, Object> attributes = timeRangeFilterFrom == null","+            ? Map.of(SOURCE_COMMAND, sourceCommand)","+            : Map.of(SOURCE_COMMAND, sourceCommand, TIME_RANGE_FILTER_FROM, timeRangeFilterFrom);","+        List<Measurement> counts = measurements(p -> p.getLongCounterMeasurement(PlanTelemetryManager.QUERY_TOTAL));","+        assertThat(counts, hasSize(1));","+        assertThat(counts.getFirst().attributes(), equalTo(Maps.copyMapWithAddedEntry(attributes, OUTCOME, outcome)));","+","+        List<Measurement> durations = measurements(p -> p.getLongHistogramMeasurement(PlanTelemetryManager.QUERY_DURATION_HISTOGRAM));","+        if (outcome.equals(\"success\")) {","+            assertThat(durations, hasSize(1));","+            assertThat(durations.getFirst().attributes(), equalTo(attributes));","+        } else {","+            assertThat(durations, empty());","+        }","+        telemetryPlugins().forEach(TestTelemetryPlugin::resetMeter);","+    }","+","+    private List<Measurement> measurements(Function<TestTelemetryPlugin, List<Measurement>> instrument) {","+        return telemetryPlugins().stream().flatMap(p -> instrument.apply(p).stream()).toList();","+    }","+","+    private List<TestTelemetryPlugin> telemetryPlugins() {","+        return StreamSupport.stream(internalCluster().getInstances(PluginsService.class).spliterator(), false)","+            .flatMap(ps -> ps.filterPlugins(TestTelemetryPlugin.class))","+            .toList();","+    }","+}"],"additions":152,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/action/EsqlExecutionInfo.java","lines":["@@ -252,6 +252,15 @@ public TimeValue overallTook() {","         return queryProfile.total().timeTook();","     }"," ","+    /**","+     * The {@link #overallTook()} of a query that has ended, or the time since it started for one that has not reached","+     * {@link #markEndQuery()}, such as a query that failed during planning. Used where a duration is needed on every outcome.","+     */","+    public TimeValue tookOrElapsed() {","+        TimeValue took = overallTook();","+        return took != null ? took : queryProfile.total().timeSinceStarted();","+    }","+","     public Set<String> clusterAliases() {","         return clusterInfo.keySet();","     }"],"additions":9,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/execution/PlanExecutor.java","lines":["@@ -435,6 +435,15 @@ private static ActionListener<Versioned<Result>> bindPlanningReservation(","         return ActionListener.releaseBefore(reservation, listener);","     }"," ","+    private void recordQuery(","+        EsqlQueryRequest request,","+        PlanTelemetry planTelemetry,","+        EsqlExecutionInfo executionInfo,","+        QueryMetricsListener.Outcome outcome","+    ) {","+        planTelemetryManager.recordQuery(planTelemetry, request.requestedTimeRange(), outcome, executionInfo.tookOrElapsed());","+    }","+","     private void onQuerySuccess(","         EsqlQueryRequest request,","         ActionListener<Versioned<Result>> listener,","@@ -446,6 +455,7 @@ private void onQuerySuccess(","         String client","     ) {","         planTelemetryManager.publish(planTelemetry, true);","+        recordQuery(request, planTelemetry, executionInfo, QueryMetricsListener.Outcome.SUCCESS);","         boolean partial = result != null && result.inner().completionInfo().partial();","         recordExternalSourceQuery(","             dataSourceModule.externalSourceMetrics(),","@@ -483,6 +493,7 @@ private void onQueryFailure(","         // X-elastic-product-origin header instead (see clientOf), so the two families can differ for the same query.","         metrics.failed(clientId);","         planTelemetryManager.publish(planTelemetry, false);","+        recordQuery(request, planTelemetry, executionInfo, outcomeOf(ex));","         recordExternalSourceQuery(","             dataSourceModule.externalSourceMetrics(),","             queryLabels(client, planTelemetry),"],"additions":11,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/SourceCommand.java","lines":["@@ -7,6 +7,7 @@"," "," package org.elasticsearch.xpack.esql.plan.logical;"," ","+import org.elasticsearch.core.Nullable;"," import org.elasticsearch.index.IndexMode;"," "," /**","@@ -30,12 +31,20 @@ public enum SourceCommand {","      * @return true if the command is a valid SourceCommand, false otherwise","      */","     public static boolean isSourceCommand(String command) {","+        return fromName(command) != null;","+    }","+","+    /**","+     * The source command named {@code command}, ignoring case, or {@code null} if it names none.","+     */","+    @Nullable","+    public static SourceCommand fromName(@Nullable String command) {","         for (SourceCommand cmd : values()) {","             if (cmd.name().equalsIgnoreCase(command)) {","-                return true;","+                return cmd;","             }","         }","-        return false;","+        return null;","     }"," ","     public IndexMode indexMode() {"],"additions":11,"deletions":2,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plan/logical/UnresolvedRelation.java","lines":["@@ -143,6 +143,15 @@ public String telemetryLabel() {","         return commandName;","     }"," ","+    /**","+     * The source command that reads this relation, or {@code null} for a relation that no source command reads, such as the index","+     * of a {@code LOOKUP JOIN}.","+     */","+    @Nullable","+    public SourceCommand sourceCommand() {","+        return SourceCommand.fromName(commandName);","+    }","+","     @Override","     public boolean expressionsResolved() {","         return false;"],"additions":9,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/plugin/TransportEsqlStreamQueryAction.java","lines":["@@ -640,10 +640,7 @@ public static List<String> footerWarnings(ThreadContext threadContext, DriverCom","     }"," ","     static long tookMillis(EsqlExecutionInfo executionInfo) {","-        if (executionInfo.overallTook() != null) {","-            return executionInfo.overallTook().millis();","-        }","-        return executionInfo.queryProfile().total().timeSinceStarted().millis();","+        return executionInfo.tookOrElapsed().millis();","     }"," ","     static PageStreamPublisher.StreamFooter failureFooter("],"additions":1,"deletions":4,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/session/EsqlSession.java","lines":["@@ -188,6 +188,7 @@"," import org.elasticsearch.xpack.esql.telemetry.FeatureMetric;"," import org.elasticsearch.xpack.esql.telemetry.Metrics;"," import org.elasticsearch.xpack.esql.telemetry.PlanTelemetry;","+import org.elasticsearch.xpack.esql.telemetry.QuerySourceCommand;"," import org.elasticsearch.xpack.esql.view.IndexViewOrigins;"," import org.elasticsearch.xpack.esql.view.ViewBoundaryPreservation;"," import org.elasticsearch.xpack.esql.view.ViewCompaction;","@@ -2128,6 +2129,8 @@ private void analyzedPlanAfterDatasetResolution(","     ) {","         assert ThreadPool.assertCurrentThreadPool(ThreadPool.Names.SEARCH);","         assert planningCpu.isMeteringCurrentThread() : \"analyzedPlanAfterDatasetResolution reached on an unmetered thread\";","+        // Classified here, where views and datasets are resolved but PROMQL is not yet translated into the same plan as TS.","+        planTelemetry.sourceCommand(QuerySourceCommand.of(rewritten));","         // The time range that the query itself restricts each index pattern to prunes index resolution like the request filter","         // does, and next to it: both must match, and the query is often narrower than the time picker.","         Map<IndexPattern, QueryBuilder> queryTimeFilters = queryTimeFilters("],"additions":3,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/telemetry/PlanTelemetry.java","lines":["@@ -40,6 +40,7 @@ public class PlanTelemetry {","     private Integer linkedProjectsCount = null;","     private final Set<String> externalStorageTypes = new TreeSet<>();","     private final Set<String> externalFormats = new TreeSet<>();","+    private QuerySourceCommand sourceCommand = QuerySourceCommand.UNKNOWN;"," ","     public PlanTelemetry(EsqlFunctionRegistry functionRegistry, List<QuerySettingDef<?>> applicableSettings) {","         this.functionRegistry = functionRegistry;","@@ -94,6 +95,17 @@ private static String collapse(Set<String> values) {","         return values.size() == 1 ? values.iterator().next() : ExternalSourceMetrics.MIXED;","     }"," ","+    public void sourceCommand(QuerySourceCommand sourceCommand) {","+        this.sourceCommand = sourceCommand;","+    }","+","+    /**","+     * What the query reads, or {@link QuerySourceCommand#UNKNOWN} if it failed before its sources were known.","+     */","+    public QuerySourceCommand sourceCommand() {","+        return sourceCommand;","+    }","+","     public void command(TelemetryAware command) {","         Check.notNull(command.telemetryLabel(), \"TelemetryAware [{}] has no telemetry label\", command);","         add(commands, command.telemetryLabel());"],"additions":12,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/telemetry/PlanTelemetryManager.java","lines":["@@ -7,9 +7,20 @@"," "," package org.elasticsearch.xpack.esql.telemetry;"," ","+import org.elasticsearch.action.search.SearchRequestAttributesExtractor;","+import org.elasticsearch.action.search.TimeRangeBucket;","+import org.elasticsearch.common.util.Maps;","+import org.elasticsearch.core.Nullable;","+import org.elasticsearch.core.TimeValue;"," import org.elasticsearch.telemetry.metric.LongCounter;","+import org.elasticsearch.telemetry.metric.LongHistogram;"," import org.elasticsearch.telemetry.metric.MeterRegistry;","+import org.elasticsearch.xpack.core.esql.QueryMetricsListener;","+import org.elasticsearch.xpack.esql.action.RequestedTimeRange;"," ","+import java.time.Duration;","+import java.util.List;","+import java.util.Locale;"," import java.util.Map;"," "," /**","@@ -31,6 +42,8 @@ public class PlanTelemetryManager {","     private final LongCounter viewSettingsCounterAll;","     private final LongCounter viewResolvedSettingsCounter;","     private final LongCounter linkedProjectsHistogram;","+    private final LongHistogram queryDurationHistogram;","+    private final LongCounter queryCounter;"," ","     /**","      * Number of times a command is used.","@@ -98,6 +111,63 @@ public class PlanTelemetryManager {","      */","     public static final String LINKED_PROJECTS_HISTOGRAM = \"es.esql.linked_projects.histogram\";"," ","+    /**","+     * Duration in milliseconds of each successful ES|QL query: its {@code took}, as reported in the response and the query logs.","+     * Split by {@link #SOURCE_COMMAND} and {@link #TIME_RANGE_FILTER_FROM}, so latency can be analyzed by how old the data a query","+     * asks for is and by whether it is a metrics query. Failed and cancelled queries are left out, as their duration says little","+     * about query latency; they are counted by {@link #QUERY_TOTAL}, which must be read alongside this histogram: the slowest","+     * queries are the most likely to time out or be cancelled, so the tail of a bucket with many of them is biased low.","+     */","+    public static final String QUERY_DURATION_HISTOGRAM = \"es.esql.query.duration.histogram\";","+","+    /**","+     * Number of ES|QL queries, by {@link #SOURCE_COMMAND}, {@link #TIME_RANGE_FILTER_FROM} and {@link #OUTCOME}, so the share of","+     * queries that failed or were cancelled can be read per bucket of {@link #QUERY_DURATION_HISTOGRAM}.","+     */","+    public static final String QUERY_TOTAL = \"es.esql.query.total\";","+","+    /**","+     * Explicit millisecond bucket boundaries for {@link #QUERY_DURATION_HISTOGRAM}, covering 1 ms up to 10 minutes.","+     * Avoids the default sqrt(2) ladder, which clips above ~131 s and emits 36 buckets per series.","+     */","+    private static final List<Long> QUERY_DURATION_BUCKET_BOUNDARIES = List.of(","+        1L,","+        5L,","+        10L,","+        25L,","+        50L,","+        100L,","+        250L,","+        500L,","+        1_000L,","+        2_500L,","+        5_000L,","+        10_000L,","+        30_000L,","+        60_000L,","+        120_000L,","+        300_000L,","+        600_000L","+    );","+","+    /**","+     * Attribute of {@link #QUERY_DURATION_HISTOGRAM} and {@link #QUERY_TOTAL}: what the query reads, the name of a","+     * {@link QuerySourceCommand}.","+     */","+    public static final String SOURCE_COMMAND = \"es_esql_source_command\";","+","+    /**","+     * Attribute of {@link #QUERY_DURATION_HISTOGRAM} and {@link #QUERY_TOTAL}: the age of the lower bound of the request filter's","+     * {@code @timestamp} range when the query started, bucketed by {@link TimeRangeBucket}. Absent if the request filter has no such","+     * range. Shared with the search metrics, which bucket a Query DSL search's time range the same way, so one filter covers both.","+     */","+    public static final String TIME_RANGE_FILTER_FROM = SearchRequestAttributesExtractor.TIME_RANGE_FILTER_FROM_ATTRIBUTE;","+","+    /**","+     * Attribute of {@link #QUERY_TOTAL}: how the query ended, the lowercase name of a {@link QueryMetricsListener.Outcome}.","+     */","+    public static final String OUTCOME = \"es_esql_outcome\";","+","     public static final String FEATURE_NAME = \"feature_name\";"," ","     /**","@@ -154,6 +224,17 @@ public PlanTelemetryManager(MeterRegistry meterRegistry) {","             \"Histogram of linked projects per esql query\",","             \"unit\"","         );","+        queryDurationHistogram = meterRegistry.registerLongHistogram(","+            QUERY_DURATION_HISTOGRAM,","+            \"ESQL query duration on the coordinator for successful queries, by source command and time range filter age\",","+            \"ms\",","+            QUERY_DURATION_BUCKET_BOUNDARIES","+        );","+        queryCounter = meterRegistry.registerLongCounter(","+            QUERY_TOTAL,","+            \"ESQL queries on the coordinator, by source command, time range filter age and outcome\",","+            \"unit\"","+        );","     }"," ","     /**","@@ -172,6 +253,43 @@ public void publish(PlanTelemetry metrics, boolean success) {","         }","     }"," ","+    /**","+     * Records a query, once per query: counts it by its outcome, and records its duration if it succeeded.","+     *","+     * @param requestedTimeRange the {@code @timestamp} range the request filter asks for, with the now its age is relative to, or","+     *                           {@code null} if unknown","+     */","+    public void recordQuery(","+        PlanTelemetry metrics,","+        @Nullable RequestedTimeRange requestedTimeRange,","+        QueryMetricsListener.Outcome outcome,","+        TimeValue took","+    ) {","+        Map<String, Object> attributes = requestedTimeRange == null","+            ? Map.of(SOURCE_COMMAND, metrics.sourceCommand().name())","+            : Map.of(SOURCE_COMMAND, metrics.sourceCommand().name(), TIME_RANGE_FILTER_FROM, timeRangeFilterFrom(requestedTimeRange));","+        queryCounter.incrementBy(1, Maps.copyMapWithAddedEntry(attributes, OUTCOME, outcome.name().toLowerCase(Locale.ROOT)));","+        if (outcome == QueryMetricsListener.Outcome.SUCCESS) {","+            queryDurationHistogram.record(took.millis(), attributes);","+        }","+    }","+","+    /**","+     * Buckets how long before the query started the requested range starts, as {@link SearchRequestAttributesExtractor} does for","+     * Query DSL searches. A range that starts in the future lands in the first bucket.","+     */","+    private static String timeRangeFilterFrom(RequestedTimeRange requestedTimeRange) {","+        Duration age = Duration.between(requestedTimeRange.bounds().start(), requestedTimeRange.now());","+        long ageMillis;","+        try {","+            ageMillis = age.toMillis();","+        } catch (ArithmeticException e) {","+            // A date far outside the epoch millisecond range is as old, or as far in the future, as can be.","+            ageMillis = age.isNegative() ? Long.MIN_VALUE : Long.MAX_VALUE;","+        }","+        return TimeRangeBucket.resolve(ageMillis);","+    }","+","     private void incCommand(String name, int count, boolean success) {","         this.featuresCounter.incrementBy(1, Map.ofEntries(Map.entry(FEATURE_NAME, name), Map.entry(SUCCESS, success)));","         this.featuresCounterAll.incrementBy(count, Map.ofEntries(Map.entry(FEATURE_NAME, name), Map.entry(SUCCESS, success)));"],"additions":118,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/telemetry/QuerySourceCommand.java","lines":["@@ -0,0 +1,74 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.esql.telemetry;","+","+import org.elasticsearch.xpack.esql.plan.logical.LogicalPlan;","+import org.elasticsearch.xpack.esql.plan.logical.SourceCommand;","+import org.elasticsearch.xpack.esql.plan.logical.UnresolvedEqlRelation;","+import org.elasticsearch.xpack.esql.plan.logical.UnresolvedExternalRelation;","+import org.elasticsearch.xpack.esql.plan.logical.UnresolvedRelation;","+import org.elasticsearch.xpack.esql.plan.logical.join.AbstractInSubqueryJoin;","+","+import java.util.EnumSet;","+import java.util.Set;","+","+/**","+ * What a query reads, as a small closed set of values for metric attributes: the kind of every data source of the query, or","+ * {@link #MIXED} if it reads sources of different kinds. Unlike the command counters, this is about the data sources of the whole","+ * query, wherever they are in it: in a subquery, in the body of a view, or behind a dataset.","+ */","+public enum QuerySourceCommand {","+    FROM,","+    TS,","+    PROMQL,","+    /** External sources, read with {@code EXTERNAL} or with {@code FROM} on a dataset. */","+    EXTERNAL,","+    /** Sources of more than one kind, such as a {@code TS} subquery in a {@code FROM}. */","+    MIXED,","+    /** No data source, such as {@code ROW} or {@code SHOW}, or one of no other kind, such as {@code EQL}. */","+    OTHER,","+    /** The query failed before its sources were known, for instance because it did not parse. */","+    UNKNOWN;","+","+    /**","+     * Classifies a plan whose views and datasets are resolved but which is not analyzed yet. Analysis translates {@code PROMQL} into","+     * the same plan as {@code TS}, while before dataset resolution a dataset still looks like an index read by {@code FROM}.","+     */","+    public static QuerySourceCommand of(LogicalPlan plan) {","+        Set<QuerySourceCommand> sources = EnumSet.noneOf(QuerySourceCommand.class);","+        collect(plan, sources);","+        if (sources.isEmpty()) {","+            return OTHER;","+        }","+        return sources.size() == 1 ? sources.iterator().next() : MIXED;","+    }","+","+    private static void collect(LogicalPlan plan, Set<QuerySourceCommand> sources) {","+        switch (plan) {","+            case UnresolvedRelation relation -> {","+                // A relation without a source command, such as a LOOKUP JOIN index, enriches the query rather than being read by it.","+                if (relation.sourceCommand() != null) {","+                    sources.add(of(relation.sourceCommand()));","+                }","+            }","+            case UnresolvedExternalRelation relation -> sources.add(EXTERNAL);","+            case UnresolvedEqlRelation relation -> sources.add(OTHER);","+            // The subquery of `x IN (subquery)` filters the query, like a lookup, so only the side it filters is a source.","+            case AbstractInSubqueryJoin join -> collect(join.left(), sources);","+            default -> plan.children().forEach(child -> collect(child, sources));","+        }","+    }","+","+    private static QuerySourceCommand of(SourceCommand command) {","+        return switch (command) {","+            case FROM -> FROM;","+            case TS -> TS;","+            case PROMQL -> PROMQL;","+        };","+    }","+}"],"additions":74,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/test/java/org/elasticsearch/xpack/esql/telemetry/PlanTelemetryManagerTests.java","lines":["@@ -0,0 +1,110 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the Elastic License","+ * 2.0; you may not use this file except in compliance with the Elastic License","+ * 2.0.","+ */","+","+package org.elasticsearch.xpack.esql.telemetry;","+","+import org.elasticsearch.core.TimeValue;","+impor