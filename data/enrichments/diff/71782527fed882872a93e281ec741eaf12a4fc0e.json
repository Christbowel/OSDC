portInstallChecks(log$.installCheck, { cwd }),","     reportInstallingConfigDeps(log$.installingConfigDeps),","     reportLockfileVerification(log$.lockfileVerification, {","       cwd,"],"additions":3,"deletions":3,"truncated":false},{"path":"pnpm11/cli/default-reporter/src/reporterForClient/reportInstallChecks.ts","lines":["@@ -1,12 +1,16 @@"," import type { InstallCheckLog } from '@pnpm/core-loggers'","+import type { LogBaseWarn } from '@pnpm/logger'","+import { sanitizeInline } from '@pnpm/text.sanitize'"," import * as Rx from 'rxjs'","-import { filter, map } from 'rxjs/operators'","+import { distinct, filter, map } from 'rxjs/operators'"," "," import { formatWarn } from './utils/formatWarn.js'"," import { autozoom } from './utils/zooming.js'"," ","+export type InstallCheckEvent = InstallCheckLog | ({ name: 'pnpm:install-check' } & LogBaseWarn)","+"," export function reportInstallChecks (","-  installCheck$: Rx.Observable<InstallCheckLog>,","+  installCheck$: Rx.Observable<InstallCheckEvent>,","   opts: {","     cwd: string","   }","@@ -14,18 +18,30 @@ export function reportInstallChecks (","   return installCheck$.pipe(","     map((log) => formatInstallCheck(opts.cwd, log)),","     filter(Boolean),","+    // Several install stages check the same package.","+    distinct(),","     map((msg) => Rx.of({ msg }))","   )"," }"," "," function formatInstallCheck (","   currentPrefix: string,","-  logObj: InstallCheckLog,","+  logObj: InstallCheckEvent,","   opts?: {","     zoomOutCurrent: boolean","   }"," ): string | undefined {","   const zoomOutCurrent = opts?.zoomOutCurrent ?? false","+  if (typeof logObj.message === 'string') {","+    return autozoom(","+      currentPrefix,","+      logObj.prefix,","+      // The message names a package from the lockfile, which a contributor can edit.","+      formatWarn(sanitizeInline(logObj.message)),","+      { zoomOutCurrent }","+    )","+  }","+  if (!('code' in logObj)) return undefined","   switch (logObj.code) {","     case 'EBADPLATFORM':","       return autozoom("],"additions":19,"deletions":3,"truncated":false},{"path":"pnpm11/cli/default-reporter/test/reportingInstallChecks.ts","lines":["@@ -0,0 +1,80 @@","+import { expect, test } from '@jest/globals'","+import { type InstallCheckLog, installCheckLogger } from '@pnpm/core-loggers'","+import { createStreamParser } from '@pnpm/logger'","+import { firstValueFrom, from, timeout, timer } from 'rxjs'","+import { takeUntil, toArray } from 'rxjs/operators'","+","+import { toOutput$ } from '../src/index.js'","+import { type InstallCheckEvent, reportInstallChecks } from '../src/reporterForClient/reportInstallChecks.js'","+import { formatWarn } from '../src/reporterForClient/utils/formatWarn.js'","+import { autozoom } from '../src/reporterForClient/utils/zooming.js'","+import type { ReporterPnpmConfig } from '../src/ReporterPnpmConfig.js'","+","+test.each(['info', 'warn', 'error'] as const)('filters install-check messages at loglevel %s', async (logLevel) => {","+  const prefix = '/home/jane/project'","+  const output$ = toOutput$({","+    context: {","+      argv: ['install'],","+      config: { dir: prefix } as ReporterPnpmConfig,","+    },","+    streamParser: createStreamParser(),","+    reportingOptions: { appendOnly: true, logLevel },","+  })","+  const message = 'Unsupported engine for required@1.0.0: wanted: {\"node\":\">=99\"} (current: {\"node\":\"20.10.0\"})'","+  installCheckLogger.warn({ message, prefix })","+","+  if (logLevel === 'error') {","+    expect(await firstValueFrom(output$.pipe(takeUntil(timer(100)), toArray()))).toEqual([])","+  } else {","+    expect(await firstValueFrom(output$.pipe(timeout(1000)))).toBe(formatWarn(message))","+  }","+})","+","+test('reports a repeated install-check message once', async () => {","+  const prefix = '/home/jane/project'","+  const message = 'Unsupported engine for required@1.0.0'","+  const logs: InstallCheckEvent[] = [","+    { name: 'pnpm:install-check', level: 'warn', prefix, message },","+    { name: 'pnpm:install-check', level: 'warn', prefix, message },","+  ]","+  const outputs = await firstValueFrom(reportInstallChecks(from(logs), { cwd: prefix }).pipe(toArray()))","+","+  expect(outputs).toHaveLength(1)","+})","+","+test('strips control characters from install-check messages', async () => {","+  const prefix = '/home/jane/project'","+  const logs: InstallCheckEvent[] = [","+    { name: 'pnpm:install-check', level: 'warn', prefix, message: 'Unsupported engine for evil\\n\\u001b[2Jpkg@1.0.0' },","+  ]","+  const outputs = await firstValueFrom(reportInstallChecks(from(logs), { cwd: prefix }).pipe(toArray()))","+","+  expect(await firstValueFrom(outputs[0])).toEqual({ msg: formatWarn('Unsupported engine for evil[2Jpkg@1.0.0') })","+})","+","+test('keeps legacy install-check codes and prefixes', async () => {","+  const prefix = '/home/jane/project/packages/app'","+  const cwd = '/home/jane/project'","+  const legacyEngineLog: InstallCheckLog = {","+    name: 'pnpm:install-check',","+    level: 'debug',","+    code: 'ENOTSUP',","+    pkgId: 'required@1.0.0',","+    prefix,","+  }","+  expect(legacyEngineLog.code.toLowerCase()).toBe('enotsup')","+  expect(legacyEngineLog.pkgId.startsWith('required@')).toBe(true)","+  legacyEngineLog.toString = () => 'legacy engine warning'","+  const logs: InstallCheckEvent[] = [","+    { name: 'pnpm:install-check', level: 'debug', code: 'EBADPLATFORM', pkgId: 'optional@1.0.0', prefix },","+    legacyEngineLog,","+    { name: 'pnpm:install-check', level: 'warn', prefix, message: 'Unsupported engine' },","+  ]","+  const outputs = await firstValueFrom(reportInstallChecks(from(logs), { cwd }).pipe(toArray()))","+","+  expect(await Promise.all(outputs.map(async output => firstValueFrom(output)))).toEqual([","+    { msg: autozoom(cwd, prefix, formatWarn('Unsupported system. Skipping dependency optional@1.0.0'), { zoomOutCurrent: false }) },","+    { msg: autozoom(cwd, prefix, 'legacy engine warning', { zoomOu