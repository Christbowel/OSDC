+    skips: HashSet<PackageKey>,","+    warnings: HashSet<PackageKey>,","+}","+"," impl SkipScan<'_, '_> {","     fn classify<Reporter: self::Reporter>(","         &mut self,","@@ -203,7 +208,7 @@ impl SkipScan<'_, '_> {","             self.record_skip::<Reporter>(snapshot_key, &metadata_key, &warn);","             return Ok(());","         }","-        self.report_incompatible_required(","+        self.report_incompatible_required::<Reporter>(","             &metadata_key,","             metadata,","             warn,","@@ -232,7 +237,7 @@ impl SkipScan<'_, '_> {","         warn: &InstallabilityError,","     ) {","         self.skipped.insert_installability(snapshot_key.clone());","-        if self.seen_emit.insert(metadata_key.clone()) {","+        if self.reported.skips.insert(metadata_key.clone()) {","             emit_skipped::<Reporter>(","                 &metadata_key.to_string(),","                 warn.skip_reason(),","@@ -245,7 +250,7 @@ impl SkipScan<'_, '_> {","     /// A package that an installed non-optional edge reaches cannot be","     /// skipped: under `engine-strict` it fails the install, otherwise","     /// it warns.","-    fn report_incompatible_required(","+    fn report_incompatible_required<Reporter: self::Reporter>(","         &mut self,","         metadata_key: &PackageKey,","         metadata: &PackageMetadata,","@@ -269,17 +274,13 @@ impl SkipScan<'_, '_> {","             return Err(Box::new(warn));","         }"," ","-        // Required, non-strict: this should emit a","-        // `pnpm:install-check` warn (TODO: add channel to the","-        // reporter). For now the tracing-level warning is the","-        // user-visible signal that an incompatible required dep slipped","-        // through.","-        tracing::warn!(","-            target: \"pacquet::install\",","-            package = %metadata_key,","-            \"{}\",","-            warn,","-        );","+        if self.reported.warnings.insert(metadata_key.clone()) {","+   