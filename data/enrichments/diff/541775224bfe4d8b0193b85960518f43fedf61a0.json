talf(\"Resolve() returned %d TLSOpts, want 1\", len(result))","+\t\t\t}","+\t\t\tcfg := &tls.Config{} //nolint:gosec // intentionally empty to test TLS opts","+\t\t\tresult[0](cfg)","+\t\t\tif cfg.MinVersion != tt.wantMinVersion {","+\t\t\t\tt.Errorf(\"MinVersion = %d, want %d\", cfg.MinVersion, tt.wantMinVersion)","+\t\t\t}","+\t\t\tif len(cfg.CipherSuites) != tt.wantCiphers {","+\t\t\t\tt.Errorf(\"CipherSuites count = %d, want %d\", len(cfg.CipherSuites), tt.wantCiphers)","+\t\t\t}","+\t\t\tif len(cfg.NextProtos) != 2 || cfg.NextProtos[0] != \"h2\" || cfg.NextProtos[1] != \"http/1.1\" {","+\t\t\t\tt.Errorf(\"NextProtos = %v, want [h2 http/1.1]\", cfg.NextProtos)","+\t\t\t}","+\t\t})","+\t}","+}",""],"additions":188,"deletions":0,"truncated":false}],"additions":421,"deletions":25,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-07-24T10:17:22.433450+00:00"}