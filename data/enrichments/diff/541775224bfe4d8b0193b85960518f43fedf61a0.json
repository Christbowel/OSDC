TLS12,","+\t\"VersionTLS13\": tls.VersionTLS13,","+}","+","+// LegacyHTTP2TLSOpts returns TLS options that restrict NextProtos to http/1.1 only.","+// This preserves the legacy --enable-http2=false behavior for backward compatibility.","+func LegacyHTTP2TLSOpts() []func(*tls.Config) {","+\treturn []func(*tls.Config){","+\t\tfunc(c *tls.Config) {","+\t\t\tc.NextProtos = []string{\"http/1.1\"}","+\t\t},","+\t}","+}","+","+func parseMinVersion(version string) (uint16, error) {","+\tversion = strings.TrimSpace(version)","+\tif version == \"\" {","+\t\treturn tls.VersionTLS12, nil","+\t}","+\tv, ok := tlsVersionMap[version]","+\tif !ok {","+\t\treturn 0, fmt.Errorf(\"unrecognized TLS version %q, valid values: %s\",","+\t\t\tversion, strings.Join(validVersionNames(), \", \"))","+\t}","+\treturn v, nil","+}","+","+func parseCipherSuites(commaSeparated string) ([]uint16, error) {","+\tcommaSeparated = strings.TrimSpace(commaSeparated)","+\tif commaSeparated == \"\" {","+\t\treturn nil, nil","+\t}","+","+\tallCiphers := make(map[string]uint16)","+\tfor _, cs := range tls.CipherSuites() {","+\t\tallCiphers[cs.Name] = cs.ID","+\t}","+","+\tvar ids []uint16","+\tvar unknown []string","+\tfor _, name := range strings.Split(commaSeparated, \",\") {","+\t\tname = strings.TrimSpace(name)","+\t\tif name == \"\" {","+\t\t\tcontinue","+\t\t}","+\t\tif id, ok := allCiphers[name]; ok {","+\t\t\tids = append(ids, id)","+\t\t} else {","+\t\t\tunknown = append(unknown, name)","+\t\t}","+\t}","+\tif len(unknown) > 0 {","+\t\treturn nil, fmt.Errorf(\"unknown TLS cipher suite(s): %s\", strings.Join(unknown, \", \"))","+\t}","+\tif len(ids) == 0 {","+\t\treturn nil, errors.New(\"cipher suites flag was set but no valid suites were specified\")","+\t}","+\treturn ids, nil","+}","+","+func validVersionNames() []string {","+\tnames := make([]string, 0, len(tlsVersionMap))","+\tfor name := range tlsVersionMap {","+\t\tnames = append(names, name)","+\t}","+\treturn names","+}"],"additions":97,"deletions":0,"truncated":false},{"path":"pkg/tls/tls_default.go","lines":["@@ -0,0 +1,57 @@","+//go:build !distro","+","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package tls","+","+import (","+\t\"context\"","+\t\"crypto/tls\"","+\t\"errors\"","+","+\t\"k8s.io/client-go/rest\"","+)","+","+// Resolve builds TLS option functions from the provided min version and cipher","+// suites strings. When both are empty, it returns hardened Intermediate defaults","+// (TLS 1.2, ECDHE AEAD ciphers, ALPN h2/http1.1).","+// In the default (upstream) build, ctx and cfg are unused.","+func Resolve(_ context.Context, _ *rest.Config, tlsMinVersion, tlsCipherSuites string) ([]func(*tls.Config), error) {","+\tminVersion, err := parseMinVersion(tlsMinVersion)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\tciphers, err := parseCipherSuites(tlsCipherSuites)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\tif minVersion >= tls.VersionTLS13 && len(ciphers) > 0 {","+\t\treturn nil, errors.New(\"cipher suites cannot be configured with TLS 1.3 (Go manages TLS 1.3 ciphers internally)\")","+\t}","+","+\treturn []func(*tls.Config){","+\t\tfunc(c *tls.Config) {","+\t\t\tc.MinVersion = minVersion","+\t\t\tif len(ciphers) > 0 {","+\t\t\t\tc.CipherSuites = ciphers","+\t\t\t}","+\t\t\tc.NextProtos = []string{\"h2\", \"http/1.1\"}","+\t\t},","+\t}, nil","+}"],"additions":57,"deletions":0,"truncated":false},{"path":"pkg/tls/tls_test.go","lines":["@@ -0,0 +1,188 @@","+/*","+Copyright 2026 The KServe Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package tls","+","+import (","+\t\"context\"","+\t\"crypto/tls\"","+\t\"strings\"","+\t\"testing\"","+)","+","+func TestParseMinVersion(t *testing.T) {","+\ttests := []struct {","+\t\tname    string","+\t\tinput   string","+\t\twant    uint16","+\t\twantErr bool","+\t}{","+\t\t{\"empty defaults to TLS 1.2\", \"\", tls.VersionTLS12, false},","+\t\t{\"TLS 1.0 rejected\", \"VersionTLS10\", 0, true},","+\t\t{\"TLS 1.1 rejected\", \"VersionTLS11\", 0, true},","+\t\t{\"TLS 1.2\", \"VersionTLS12\", tls.VersionTLS12, false},","+\t\t{\"TLS 1.3\", \"VersionTLS13\", tls.VersionTLS13, false},","+\t\t{\"whitespace trimmed\", \" VersionTLS12 \", tls.VersionTLS12, false},","+\t\t{\"unknown version\", \"VersionTLS99\", 0, true},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tgot, err := parseMinVersion(tt.input)","+\t\t\tif tt.wantErr {","+\t\t\t\tif err == nil {","+\t\t\t\t\tt.Errorf(\"parseMinVersion(%q) expected error, got nil\", tt.input)","+\t\t\t\t}","+\t\t\t\treturn","+\t\t\t}","+\t\t\tif err != nil {","+\t\t\t\tt.Errorf(\"parseMinVersion(%q) unexpected error: %v\", tt.input, err)","+\t\t\t\treturn","+\t\t\t}","+\t\t\tif got != tt.want {","+\t\t\t\tt.Errorf(\"parseMinVersion(%q) = %d, want %d\", tt.input, got, tt.want)","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestParseCipherSuites(t *testing.T) {","+\ttests := []struct {","+\t\tname      string","+\t\tinput     string","+\t\twantCount int","+\t\twantErr   bool","+\t}{","+\t\t{\"empty returns nil\", \"\", 0, false},","+\t\t{\"whitespace only returns nil\", \"   \", 0, false},","+\t\t{\"single valid cipher\", \"TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256\", 1, false},","+\t\t{\"multiple valid ciphers\", \"TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384\", 2, false},","+\t\t{\"whitespace trimmed\", \" TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 , TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 \", 2, false},","+\t\t{\"unknown cipher is error\", \"BOGUS_CIPHER\", 0, true},","+\t\t{\"mixed valid and invalid is error\", \"TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,BOGUS\", 0, true},","+\t\t{\"only commas is error\", \",,\", 0, true},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tgot, err := parseCipherSuites(tt.input)","+\t\t\tif tt.wantErr {","+\t\t\t\tif err == nil {","+\t\t\t\t\tt.Errorf(\"parseCipherSuites(%q) expected error, got nil\", tt.input)","+\t\t\t\t}","+\t\t\t\treturn","+\t\t\t}","+\t\t\tif err != nil {","+\t\t\t\tt.Errorf(\"parseCipherSuites(%q) unexpected error: %v\", tt.input, err)","+\t\t\t\treturn","+\t\t\t}","+\t\t\tif len(got) != tt.wantCount {","+\t\t\t\tt.Errorf(\"parseCipherSuites(%q) returned %d ciphers, want %d\", tt.input, len(got), tt.wantCount)","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestResolve(t *testing.T) {","+\ttests := []struct {","+\t\tname           string","+\t\tminVersion     string","+\t\tcipherSuites   string","+\t\twantErr        bool","+\t\terrContains    string","+\t\twantMinVersion uint16","+\t\twantCiphers    int","+\t}{","+\t\t{","+\t\t\tname:           \"defaults: TLS 1.2, no ciphers\",","+\t\t\twantMinVersion: tls.VersionTLS12,","+\t\t},","+\t\t{","+\t\t\tname:           \"explicit TLS 1.2\",","+\t\t\tminVersion:     \"VersionTLS12\",","+\t\t\twantMinVersion: tls.VersionTLS12,","+\t\