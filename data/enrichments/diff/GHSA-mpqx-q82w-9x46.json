ingErrorRule])","+        assert all(isinstance(e, ValidationAbortedError) for e in aborted_errors)","+        assert len(refs) == 6","+        assert all(ref() is None for ref in refs)","+","+    def aborted_error_accepts_the_arguments_of_graphql_error():","+        node = doc.definitions[0]","+        error = ValidationAbortedError(","+            \"Validation aborted.\", node, extensions={\"code\": \"ABORTED\"}","+        )","+        assert error.message == \"Validation aborted.\"","+        assert error.nodes == [node]","+        assert error.extensions == {\"code\": \"ABORTED\"}","+","     def pass_through_exceptions_from_rules():","         class CustomRule(ValidationRule):","             def enter_field(self, *_args):",""],"additions":83,"deletions":1,"truncated":false}],"additions":123,"deletions":10,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-31T14:35:25.525552+00:00"}