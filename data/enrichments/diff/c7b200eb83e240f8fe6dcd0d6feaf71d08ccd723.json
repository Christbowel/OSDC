{"id":"c7b200eb83e240f8fe6dcd0d6feaf71d08ccd723","axis":"silent","repo":"symfony/symfony","sha":"c7b200eb83e240f8fe6dcd0d6feaf71d08ccd723","parsed":{"files":[{"path":"src/Symfony/Bundle/SecurityBundle/CHANGELOG.md","lines":["@@ -4,6 +4,7 @@ CHANGELOG"," 8.2"," ---"," ","+ * Add the `recent_authentication_lifetime` option, the number of seconds an interactive authentication keeps granting `IS_AUTHENTICATED_RECENTLY`","  * Add the `security.expression_language_provider` service to evaluate the security functions outside of authorization expressions","  * Add the `debug:roles` command to inspect the role hierarchy","  * Add `allowed_time_drift` option to the OIDC token handler configuration"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/SecurityBundle/DependencyInjection/MainConfiguration.php","lines":["@@ -59,6 +59,12 @@ public function getConfigTreeBuilder(): TreeBuilder","             ->docUrl('https://symfony.com/doc/{version:major}.{version:minor}/reference/configuration/security.html', 'symfony/security-bundle')","             ->children()","                 ->scalarNode('access_denied_url')->defaultNull()->example('/foo/error403')->end()","+                ->integerNode('recent_authentication_lifetime')","+                    ->min(0)","+                    ->defaultValue(2 * 3600)","+                    ->info('Number of seconds an interactive authentication keeps granting IS_AUTHENTICATED_RECENTLY. Use it to make sensitive actions require the user to authenticate again.')","+                    ->example('600')","+                ->end()","                 ->enumNode('session_fixation_strategy')","                     ->values([SessionAuthenticationStrategy::NONE, SessionAuthenticationStrategy::MIGRATE, SessionAuthenticationStrategy::INVALIDATE])","                     ->defaultValue(SessionAuthenticationStrategy::MIGRATE)"],"additions":6,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/SecurityBundle/DependencyInjecti