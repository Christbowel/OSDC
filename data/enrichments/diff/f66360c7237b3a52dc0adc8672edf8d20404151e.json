tions":0,"truncated":false},{"path":"test/e2e/css-hmr-initial-load-race/app/layout.tsx","lines":["@@ -0,0 +1,10 @@","+import type { ReactNode } from 'react'","+import './globals.css'","+","+export default function Root({ children }: { children: ReactNode }) {","+  return (","+    <html>","+      <body>{children}</body>","+    </html>","+  )","+}"],"additions":10,"deletions":0,"truncated":false},{"path":"test/e2e/css-hmr-initial-load-race/app/page.tsx","lines":["@@ -0,0 +1,16 @@","+'use client'","+","+import { useState } from 'react'","+","+export default function Page() {","+  const [count, setCount] = useState(0)","+","+  return (","+    <>","+      <p className=\"race-target race-added\">hello</p>","+      <button id=\"counter\" onClick={() => setCount(count + 1)}>","+        {count}","+      </button>","+    </>","+  )","+}"],"additions":16,"deletions":0,"truncated":false},{"path":"test/e2e/css-hmr-initial-load-race/css-hmr-initial-load-race.test.ts","lines":["@@ -0,0 +1,95 @@","+import { nextTestSetup } from 'e2e-utils'","+import { gate } from 'next-test-utils'","+import { assertCssHmrStartupRecovery } from '../../lib/css-hmr-initial-load-race'","+","+const stylesheet = 'app/globals.css'","+","+// Regression coverage for https://github.com/vercel/next.js/pull/99893.","+// These repeated App/Pages races are complemented by a fresh Pages-only fixture","+// so an already ensured App route cannot mask missing global Pages observation.","+describe('css-hmr-initial-load-race', () => {","+  const { next } = nextTestSetup({ files: __dirname })","+","+  for (const [attempt, pathname] of ['/', '/legacy', '/'].entries()) {","+    // Requires a local file edit and a development HMR stream.","+    // @force-gate dev && turbopack","+    it(`reloads a missed startup CSS edit on ${pathname} (attempt ${attempt}), then preserves ordinary CSS HMR`, async () => {","+      await next.fetch(pathname)","+      await assertCssHmrStartupRecovery(next, pathname, stylesheet)","+    })","+  }","+","+  // @force-gate dev && turbopack","+  it('recovers a Pages race when the first greeting arrives after hydration', async () => {","+    await next.fetch('/legacy')","+    await assertCssHmrStartupRecovery(next, '/legacy', stylesheet, {","+      delayGreetingUntilHydrated: true,","+    })","+  })","+","+  // @force-gate dev && turbopack","+  it('does not reload or refetch CSS on an unchanged initial load', async () => {","+    let documentRequests = 0","+    let cssRequests = 0","+    const browser = await next.browser('/', {","+      async beforePageLoad(page) {","+        page.on('request', (request) => {","+          if (","+            request.isNavigationRequest() &&","+            request.frame() === page.mainFrame()","+          ) {","+            documentRequests++","+          }","+          if (new URL(request.url()).pathname.endsWith('.css')) cssRequests++","+        })","+      },","+    })","+    await browser.elementByCss('#counter').click()","+    expect(await browser.elementByCss('#counter').text()).toBe('1')","+    expect(await browser.eval('window.__nextHmrInitialVersion')).toMatch(","+      /^\\d+$/","+    )","+    expect(documentRequests).toBe(1)","+    expect(cssRequests).toBe(1)","+  })","+","+  it('emits the initial baseline only in dev-server HTML with Turbopack HMR', async () => {","+    const hasHmr = await gate('dev && turbopack')","+    for (const path of ['/', '/legacy']) {","+      const response = await next.fetch(path)","+      expect(response.status).toBe(200)","+      const html = await response.text()","+      if (hasHmr) {","+        expect(html).toMatch(/var __nextHmrInitialVersion=\"\\d+\";/)","+      } else {","+        expect(html).not.toContain('__nextHmrInitialVersion')","+      }","+      const browser = await next.browser(path)","+      const version = await browser.eval('window.__nextHmrInitialVersion')","+      if (hasHmr) expect(version).toMatch(/^\\d+$/)","+      else expect(version).toBeUndefined()","+      await browser.elementByCss('#counter').click()","+      expect(await browser.elementByCss('#counter').text()).toBe('1')","+    }","+  })","+","+  // CSP nonce extraction is meaningful on the self-hosted dev server.","+  // @force-gate dev && turbopack","+  it('reuses the bootstrap CSP nonce for the inline baseline', async () => {","+    const policy = \"script-src 'self' 'nonce-hmr-baseline-test' 'unsafe-eval'\"","+    for (const path of ['/', '/legacy']) {","+      const response = await next.fetch(path, {","+        headers: { 'Content-Security-Policy': policy },","+      })","+      const html = await response.text()","+      const scripts = Array.from(","+        html.matchAll(/<script\\b([^>]*)>([\\s\\S]*?)<\\/script>/g)","+      )","+      const baseline = scripts.find(([, , content]) =>","+        content.includes('var __nextHmrInitialVersion=')","+      )","+      expect(baseline).toBeDefined()","+      expect(baseline[1]).toContain('nonce=\"hmr-baseline-test\"')","+    }","+  })","+})"],"additions":95,"deletions":0,"truncated":false},{"path":"test/e2e/css-hmr-initial-load-race/next.config.ts","lines":["@@ -0,0 +1,5 @@","+import type { NextConfig } from 'next'","+","+const nextConfig: NextConfig = {}","+","+export default nextConfig"],"additions":5,"deletions":0,"truncated":false},{"path":"test/e2e/css-hmr-initial-load-race/pages/_app.tsx","lines":["@@ -0,0 +1,6 @@","+import type { AppProps } from 'next/app'","+import '../app/globals.css'","+","+export default function App({ Component, pageProps }: AppProps) {","+  return <Component {...pageProps} />","+}"],"additions":6,"deletions":0,"truncated":false},{"path":"test/e2e/css-hmr-initial-load-race/pages/legacy.tsx","lines":["@@ -0,0 +1 @@","+export { default } from '../app/page'"],"additions":1,"deletions":0,"truncated":false},{"path":"test/e2e/css-hmr-pages-initial-load-race/css-hmr-pages-initial-load-race.test.ts","lines":["@@ -0,0 +1,244 @@","+import { nextTestSetup } from 'e2e-utils'","+import { assertCssHmrStartupRecovery } from '../../lib/css-hmr-initial-load-race'","+import {","+  gate,","+  getRedboxDescription,","+  retry,","+  waitForNoRedbox,","+  waitForRedbox,","+} from 'next-test-utils'","+","+// No App directory or prewarmed route: the first browser loads Pages' global CSS","+// through _app. An App route observer must not mask this independent regression.","+describe('css-hmr-pages-initial-load-race', () => {","+  const { next } = nextTestSetup({ files: __dirname })","+","+  // Requires a local file edit and a development HMR stream.","+  // @force-gate dev && turbopack","+  it('reloads a missed global CSS edit on the very first Pages navigation', async () => {","+    await assertCssHmrStartupRecovery(next, '/', 'global.css')","+  })","+","+  // @force-gate dev && turbopack","+  it('recovers when the first greeting is delivered only after hydration', async () => {","+    await assertCssHmrStartupRecovery(next, '/', 'global.css', {","+      delayGreetingUntilHydrated: true,","+    })","+  })","+","+  // @force-gate dev && turbopack","+  it('observes replacement global CSS after ensuring another Page', async () => {","+    const originalApp = await next.readFile('pages/_app.tsx')","+    let documents = 0","+    const browser = await next.browser('/', {","+      async beforePageLoad(page) {","+        await page.addInitScript(() => {","+          ;(window as any).__appObserverDocument = crypto.randomUUID()","+        })","+        page.on('request', (request) => {","+          if (","+            request.isNavigationRequest() &&","+            request.frame() === page.mainFrame()","+          ) {","+            documents++","+          }","+        })","+      },","+    })","+    const documentId = await browser.eval('window.__appObserverDocument')","+    try {","+      await browser.elementByCss('#other').click()","+      await retry(async () => {","+        expect(new URL(await browser.url()).pathname).toBe('/other')","+      })","+      await browser.elementByCss('#counter').click()","+      expect(await browser.elementByCss('#counter').text()).toBe('1')","+      await next.patchFile(","+        'pages/_app.tsx',","+        originalApp.replace('original-app', 'edited-app')","+      )","+      await retry(async () => {","+        expect(await browser.elementByCss('#app-label').text()).toBe(","+          'edited-app'","+        )","+      })","+      expect(await browser.elementByCss('#counter').text()).toBe('1')","+      expect(await browser.eval('window.__appObserverDocument')).toBe(","+        documentId","+      )","+      expect(documents).toBe(1)","+      await next.patchFile(","+        'pages/_app.tsx',","+        originalApp","+          .replace('original-app', 'edited-app')","+          .replace('../global.css', '../replacement.css')","+      )","+      await retry(async () => {","+        expect(await browser.elementByCss('#app-label').text()).toBe(","+          'edited-app'","+        )","+      })","+      // Removing one CSS dependency and adding another already triggers runtime","+      // reloads without this observer. Check the new dependency is live, rather","+      // than promising state preservation for that structural change.","+      await retry(async () => {","+        const hrefs = await browser.eval<string[]>(","+          `Array.from(document.querySelectorAll('link[rel=\"stylesheet\"]')).map((link) => link.getAttribute('href'))`","+        )","+        const css = (","+          await Promise.all(","+            hrefs.map(async (href) => (await next.fetch(href)).text())","+          )","+        ).join('\\n')","+        expect(css).toContain('.replacement-marker')","+      })","+      // No subscribed browser may detect this edit on behalf of the global","+      // observer. Its changed CSS dependency must be watched before new HTML.","+      await browser.close()","+      await assertCssHmrStartupRecovery(next, '/other', 'replacement.css')","+    } finally {","+      await browser.close()