+            local_manifest","+                .dependencies([DependencyGroup::Peer])","+                .map(|(name, _)| name),","+        )","+        .chain(optional_peer_names(local_manifest))","+        .collect();","+    // An install without optional dependencies leaves the optional map alone.","+    let optional =","+        check.config.optional.then_some(snapshot.optional_dependencies.as_ref()).flatten();","+    let recorded = [snapshot.dependencies.as_ref(), optional]","+        .into_iter()","+        .flatten()","+        .flat_map(|deps| deps.keys());","+    for name in recorded {","+        if !expected.contains(name.to_string().as_str()) {","             return Err(dep.outdated());","         }","     }"],"additions":86,"deletions":73,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps/tests.rs","lines":["@@ -1,13 +1,12 @@"," use super::{","-    LocalDepContext, SpecDirs, check_local_dep_group_freshness, dependency_manifests_by_dir,","-    peers::{PeerShadowing, check_recorded_peer_specs_match},","+    LocalDepContext, SpecDirs, dependency_manifests_by_dir, peers::check_recorded_peer_specs_match,","     project_manifests_by_dir,"," };"," use crate::install::FreshnessCheckError;"," use pnpm_catalogs_resolver::CatalogResolutionError;"," use pnpm_catalogs_types::Catalogs;"," use pnpm_lockfile::{PackageMetadata, StalenessReason};","-use pnpm_package_manifest::{DependencyGroup, PackageManifest};","+use pnpm_package_manifest::PackageManifest;"," use std::{","     collections::HashMap,","     path::{Path, PathBuf},","@@ -192,34 +191,84 @@ fn check_local_dep_peers(","     recorded_peers: &serde_json::Value,","     snapshot_deps: &HashMap<pnpm_lockfile::PkgName, pnpm_lockfile::SnapshotDepRef>,"," ) -> Result<(), FreshnessCheckError> {","-    let manifest = PackageManifest::from_value(PathBuf::from(\"/ws/lib/package.json\"), manifest);","-    let metadata: PackageMetadata = serde_json::from_value(serde_json::js