_lockfile::Lockfile =","+        serde_saphyr::from_str(\"lockfileVersion: '9.0'\\nimporters: {}\\n\").expect(\"parse lockfile\");","+    let mut config = pnpm_config::Config::new();","+    config.auto_install_peers = case.auto_install_peers;","+    config.optional = case.include_optional;","+    let ignored = pnpm_matcher::create_matcher(&[]);","+    let manifests_by_dir = HashMap::from([(pnpm_fs::lexical_normalize(&dep_dir), &local_manifest)]);","+    let catalogs = &case.catalogs;","+    let check = crate::install::lockfile_freshness::ImporterSatisfactionCheck {","+        lockfile: &lockfile,","+        lockfile_dir: Path::new(\"/ws\"),","+        manifest: &local_manifest,","+        importer_id: \".\",","+        config: &config,","+        workspace: crate::install::lockfile_freshness::WorkspaceProjects {","+            packages: None,","+            manifests_by_dir: &manifests_by_dir,","+            catalogs,","+        },","+        optional_exclusions: crate::install::lockfile_freshness::OptionalDependencyExclusions {","+            ignored: &ignored,","+            allow_unresolved: case.allow_unresolved,","+        },","+        parsed_overrides: None,","+    };","     let dep = LocalDepContext {","         name: \"lib\",","         declared_as_file: false,","         rel_path: \"lib\",","-        dir: Path::new(\"/ws/lib\"),","+        dir: &dep_dir,","         dirs: SpecDirs {","             workspace_root: Path::new(\"/ws\"),","             lockfile_dir: Path::new(\"/ws\"),","             manifests_by_dir: &HashMap::new(),","         },","-        catalogs: &catalogs,","+        catalogs,","     };","-    let peers = PeerShadowing::of(&manifest, &metadata, auto_install_peers);","-    check_local_dep_group_freshness(","-        &dep,","-        &manifest,","-        DependencyGroup::Prod,","-        Some(snapshot_deps),","-        (false, &peers.shadowed),","-    )?;","-    peers.check_local_peer_deps_freshness(&dep, &manifest, &metadata)","+    super