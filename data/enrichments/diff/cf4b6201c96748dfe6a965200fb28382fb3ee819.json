n a_dependency_that_became_optional_is_outdated() {","+    let result = check_directory_dep(&DirectoryDepCase {","+        manifest: serde_json::json!({","+            \"name\": \"lib\",","+            \"optionalDependencies\": { \"is-positive\": \"1.0.0\" },","+        }),","+        metadata: directory_metadata(),","+        snapshot: serde_json::json!({ \"dependencies\": { \"is-positive\": \"1.0.0\" } }),","+        allow_unresolved: false,","+        auto_install_peers: true,","+        include_optional: true,","+        catalogs: Catalogs::new(),","+    });","+    assert!(result.is_err(), \"the child moved to optionalDependencies: {result:?}\");","+}","+","+#[test]","+fn an_install_without_optional_dependencies_ignores_the_recorded_optional_children() {","+    let result = check_directory_dep(&DirectoryDepCase {","+        manifest: serde_json::json!({ \"name\": \"lib\" }),","+        metadata: directory_metadata(),","+        snapshot: serde_json::json!({ \"optionalDependencies\": { \"is-positive\": \"1.0.0\" } }),","+        allow_unresolved: false,","+        auto_install_peers: true,","+        include_optional: false,","+        catalogs: Catalogs::new(),","+    });","+    assert!(result.is_ok(), \"the optional map is not compared: {result:?}\");","+}","+","+#[test]","+fn a_misconfigured_catalog_child_keeps_the_catalog_error() {","+    let error = check_directory_dep(&DirectoryDepCase {","+        manifest: serde_json::json!({","+            \"name\": \"lib\",","+            \"dependencies\": { \"is-positive\": \"catalog:missing\" },","+        }),","+        metadata: directory_metadata(),","+        snapshot: serde_json::json!({ \"dependencies\": { \"is-positive\": \"1.0.0\" } }),","+        allow_unresolved: false,","+        auto_install_peers: true,","+        include_optional: true,","+        catalogs: Catalogs::from([(","+            \"default\".to_string(),","+            std::collections::BTreeMap::from([(\"is-positive\".to_string(), \"1.0.0\".to_string())]),","+        )]),","+    })","+    .expect_err(\"the named catalog does not exist\");","+    assert!(","+        matches!(&error, FreshnessCheckError::InvalidCatalog(_)),","+        \"expected the catalog error, got {error:?}\",","+    );","+}","+","+/// The resolver drops a dependency that the package's own peer supplies","+/// before it resolves `catalog:` specs, so a missing catalog entry on it is","+/// no error.","+#[test]","+fn a_peer_shadowed_dependency_is_not_resolved_through_the_catalogs() {","+    let result = check_directory_dep(&DirectoryDepCase {","+        manifest: serde_json::json!({","+            \"name\": \"lib\",","+            \"dependencies\": { \"react\": \"catalog:missing\" },","+            \"peerDependencies\": { \"react\": \"^18.0.0\" },","+        }),","+        metadata: serde_json::json!({","+            \"resolution\": { \"type\": \"directory\", \"directory\": \"lib\" },","+            \"peerDependencies\": { \"react\": \"^18.0.0\" },","+        }),","+        snapshot: serde_json::json!({ \"dependencies\": { \"react\": \"18.3.1\" } }),","+        allow_unresolved: false,","+        auto_install_peers: true,","+        include_optional: true,","+        catalogs: Catalogs::from([(","+            \"default\".to_string(),","+            std::collections::BTreeMap::from([(\"is-positive\".to_string(), \"1.0.0\".to_string())]),","+        )]),","+    });","+    assert!(result.is_ok(), \"the shadowed dependency is the peer check's: {result:?}\");","+}","+","+/// A child that became optional is a change even when the install leaves","+/// optional dependencies out: the lockfile still records it as required.","+#[test]","+fn a_dependency_that_became_optional_is_outdated_without_optional_dependencies() {","+    let result = check_directory_dep(&DirectoryDepCase {","+        manifest: serde_json::json!({","+            \"name\": \"lib\",","+            \"optionalDependencies\": { \"is-positive\": \"1.0.0\" },","+        }),","+      