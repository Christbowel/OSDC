{"id":"cf4b6201c96748dfe6a965200fb28382fb3ee819","axis":"silent","repo":"pnpm/pnpm","sha":"cf4b6201c96748dfe6a965200fb28382fb3ee819","parsed":{"files":[{"path":".changeset/injected-child-specs.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm install --frozen-lockfile` now accepts the lockfile it wrote for an injected workspace package that bundles a dependency (`bundledDependencies`), or that lists a dependency in both `dependencies` and `optionalDependencies`. Before, it failed with `ERR_PNPM_OUTDATED_LOCKFILE`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/inject_workspace_packages.rs","lines":["@@ -1308,3 +1308,86 @@ fn frozen_install_accepts_injected_dependency_whose_peer_is_a_workspace_link() {"," fn frozen_install_accepts_injected_dependency_with_an_unmet_peer() {","     assert_frozen_install_accepts_fresh_lockfile(\"2.0.0\");"," }","+","+/// Install a workspace whose `project-2` injects `project-1` with","+/// `project_1` as its manifest, then run a frozen install from a clean tree.","+fn assert_frozen_install_accepts_an_injected_project(project_1: &serde_json::Value) {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"packages:\\n  - 'project-*'\\ninjectWorkspacePackages: true\\ndedupeInjectedDeps: false\\n\",","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({ \"name\": \"ws-root\", \"version\": \"0.0.0\", \"private\": true }).to_string(),","+    )","+    .expect(\"write root package.json\");","+    fs::create_dir_all(workspace.join(\"project-1/node_modules/is-negative\"))","+        .expect(\"mkdir project-1\");","+    fs::write(workspace.join(\"project-1/package.json\"), project_1.to_string())","+        .expect(\"write project-1/package.json\");","+    // What a bundled dependency ships with.","+    fs::write(","+        workspace.join(\"project-1/node_modules/is-negative/package.json\"),","+        serde_json::json!({ \"name\": \"is-negative\", \"version\": \"1.0.0\" }).to_string(),","+    )","+    .expect(\"write bundled is-negative\");","+    fs::create_dir_all(workspace.join(\"project-2\")).expect(\"mkdir project-2\");","+    fs::write(","+        workspace.join(\"project-2/package.json\"),","+        serde_json::json!({","+            \"name\": \"project-2\",","+            \"version\": \"1.0.0\",","+            \"dependencies\": { \"project-1\": \"workspace:1.0.0\" },","+        })","+        .to_string(),","+    )","+    .expect(\"write project-2/package.json\");","+","+    pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    for dir in [\"node_modules\", \"project-2/node_modules\"] {","+        let _ = fs::remove_dir_all(workspace.join(dir));","+    }","+    crate::_utils::pacquet_in(&workspace)","+        .with_args([\"install\", \"--frozen-lockfile\"])","+        .assert()","+        .success();","+","+    drop((root, mock_instance));","+}","+","+/// A bundled dependency ships inside the package, so the resolver leaves it","+/// out of the snapshot.","+#[test]","+fn frozen_install_accepts_an_injected_project_with_a_bundled_dependency() {","+    assert_frozen_install_accepts_an_injected_project(&serde_json::json!({","+        \"name\": \"project-1\",","+        \"version\": \"1.0.0\",","+        \"dependencies\": { \"is-positive\": \"1.0.0\", \"is-negative\": \"1.0.0\" },","+        \"bundledDependencies\": [\"is-negative\"],","+    }));","+}","+","+/// A name in both `dependencies` and `optionalDependencies` is one optional","+/// child, recorded under `optionalDependencies`.","+#[test]","+fn frozen_install_accepts_an_injected_project_with_a_dependency_that_is_also_optional() {","+    assert_frozen_install_accepts_an_injected_project(&serde_json::json!({","+        \"name\": \"project-1\",","+        \"version\": \"1.0.0\",","+        \"dependencies\": { \"is-positive\": \"1.0.0\" },","+        \"optionalDependencies\": { \"is-positive\": \"1.0.0\" },","+    }));","+}"],"additions":83,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/lockfile_freshness/directory_deps.rs","lines":["@@ -11,6 +11,9 @@ use pnpm_catalogs_types::Catalogs;"," use pnpm_injected_deps_syncer::publish_source_dir;"," use pnpm_lockfile::StalenessReason;"," use pnpm_package_manifest::{DependencyGroup, PackageManifest};","+use pnpm_resolving_deps_resolver::{","+    ChildCatalogs, ChildSpec, ResolveDependencyTreeError, local_directory_child_specs,","+};"," use spec::{SpecDirs, spec_satisfies_snapshot_dep};"," use std::{","     collections::{HashMap, HashSet},","@@ -276,51 +279,72 @@ fn check_single_directory_dep_freshness(","         return Err(dep.outdated());","     };","     let peers = PeerShadowing::of(&local_manifest, pkg_meta, check.config.auto_install_peers);","-    check_local_dep_group_freshness(","-        dep,","-        &local_manifest,","-        DependencyGroup::Prod,","-        snapshot.dependencies.as_ref(),","-        (false, &peers.shadowed),","-    )?;","-    if check.config.optional {","-        check_local_dep_group_freshness(","-            dep,","-            &local_manifest,","-            DependencyGroup::Optional,","-            snapshot.optional_dependencies.as_ref(),","-            (check.optional_exclusions.allow_unresolved, &HashSet::new()),","-        )?;","-    }","+    check_local_dep_children_freshness(check, dep, &local_manifest, snapshot, &peers.shadowed)?;","     peers.check_local_peer_deps_freshness(dep, &local_manifest, pkg_meta)"," }"," ","-fn check_local_dep_group_freshness(","+/// Compares the children the resolver walks for the package (see",