al_manifest, (&children, snapshot))?;","+    for child in &children {","+        if !child_is_fresh(check, dep, snapshot, child) {","+            return Err(dep.outdated());","         }","-        check_snapshot_keys_in_manifest(dep, &valid_keys, snapshot_deps)?;","     }","-    // The snapshot records the peer's resolution for these, whose range the","-    // peer check compares.","-    manifest_deps.retain(|name, _| !shadowed.contains(name));","-    check_manifest_specs_satisfy_snapshot(dep, &manifest_deps, snapshot_deps, allow_unresolved)","+    Ok(())","+}","+","+/// Whether the snapshot records a resolution of `child` that its spec","+/// accepts. An optional child the install leaves out is only checked not to","+/// be recorded as a required one.","+fn child_is_fresh(","+    check: &ImporterSatisfactionCheck<'_>,","+    dep: &LocalDepContext<'_>,","+    snapshot: &pnpm_lockfile::SnapshotEntry,","+    (name, spec, optional, _): &ChildSpec,","+) -> bool {","+    if *optional && !check.config.optional {","+        return recorded_child(snapshot, name, false).is_none();","+    }","+    match recorded_child(snapshot, name, *optional) {","+        Some(recorded) => spec_satisfies_snapshot_dep(&dep.dirs, dep.dir, name, spec, recorded),","+        None => *optional && check.optional_exclusions.allow_unresolved,","+    }","+}","+","+/// The resolution the snapshot records for a child, in the map its","+/// optionality puts it in.","+fn recorded_child<'s>(","+    snapshot: &'s pnpm_lockfile::SnapshotEntry,","+    name: &str,","+    optional: bool,","+) -> Option<&'s pnpm_lockfile::SnapshotDepRef> {","+    let name = pnpm_lockfile::PkgName::parse(name).ok()?;","+    let recorded = if optional { &snapshot.optional_dependencies } else { &snapshot.dependencies };","+    recorded.as_ref()?.get(&name)"," }"," "," fn optional_peer_names(manifest: &PackageManifest) -> impl Iterator<Item = &str> {","@@ -337,44 +361,33 @@ fn optional_peer_names(manifest: &PackageManifest) -> imp