{"id":"f4dbdd7bf622f36f98c6a5292acac5a37ef21929","axis":"silent","repo":"sqlite/sqlite","sha":"f4dbdd7bf622f36f98c6a5292acac5a37ef21929","parsed":{"files":[{"path":"ext/session/sessioncorrupt.test","lines":["@@ -78,4 +78,61 @@ do_execsql_test 2.2 {","   SELECT * FROM x"," } {1 same one 2 same two}"," ","+#-------------------------------------------------------------------------","+# A single changeset may not contain both changeset ('T') and patchset","+# ('P') table headers. Such a blob is corrupt. Concatenations of","+# changesets with changesets, or of patchsets with patchsets, are fine.","+#","+reset_db","+do_execsql_test 3.0 {","+  CREATE TABLE t1(a INTEGER PRIMARY KEY, b);","+  CREATE TABLE t2(x INTEGER PRIMARY KEY, y);","+}","+","+set C1 [changeset_from_sql { INSERT INTO t1 VALUES(1, 'one'); }]","+set C2 [changeset_from_sql { INSERT INTO t2 VALUES(2, 'two'); }]","+set P1 [patchset_from_sql  { INSERT INTO t1 VALUES(3, 'three'); }]","+set P2 [patchset_from_sql  { INSERT INTO t2 VALUES(4, 'four'); }]","+","+forcedelete test.db2","+sqlite3 db2 test.db2","+do_execsql_test -db db2 3.1 {","+  CREATE TABLE t1(a INTEGER PRIMARY KEY, b);","+  CREATE TABLE t2(x INTEGER PRIMARY KEY, y);","+}","+","+proc apply_db2 {cs} {","+  list [catch { sqlite3changeset_apply db2 $cs xConflict } msg] $msg","+}","+proc iterate {cs} {","+  set res [list]","+  set rc [catch {","+    sqlite3session_foreach c $cs { lappend res [lindex $c 0] }","+  } msg]","+  if {$rc} { return [list 1 $msg] }","+  list 0 $res","+}","+","+foreach {tn cs} [list \\","+  1 [string cat $C1 $P2] \\","+  2 [string cat $P1 $C2] \\","+  3 [string cat $C1 $P2 $C1] \\","+] {","+  do_test 3.2.$tn.1 { apply_db2 $cs } {1 SQLITE_CORRUPT}","+  do_execsql_test -db db2 3.2.$tn.2 {","+    SELECT * FROM t1; SELECT * FROM t2;","+  } {}","+  do_test 3.2.$tn.3 { lindex [iterate $cs] 0 } 1","+  do_test 3.2.$tn.4 {","+    list [catch { sqlite3changeset_invert $cs } msg] $msg","+  } {1 SQLITE_CORRUPT}","+}","+","+do_test 3.3.1 { apply_db2 [string cat $C1 $C2] } {0 {}}","+do_test 3.3.2 { apply_db2 [string cat $P1 $P2] } {0 {}}","+do_execsql_test -db db2 3.3.3 {","+  SELECT * FROM t1; SELECT * FROM t2;","+} {1 one 3 three 2 two 4 four}","+db2 close","+"," finish_test"],"additions":57,"deletions":0,"truncated":false},{"path":"ext/session/sqlite3session.c","lines":["@@ -3865,6 +3865,11 @@ static int sessionChangesetNextOne("," ","   op = p->in.aData[p->in.iNext++];","   while( op=='T' || op=='P' ){","+    /* A single changeset may not contain both changeset ('T') and","+    ** patchset ('P') table headers. If it does, it is corrupt. */","+    if( p->zTab && p->bPatchset!=(op=='P') ){","+      return (p->rc = SQLITE_CORRUPT_BKPT);","+    }","     if( pbNew ) *pbNew = 1;","     p->bPatchset = (op=='P');","     if( sessionChangesetReadTblhdr(p) ) return p->rc;"],"additions":5,"deletions":0,"truncated":false},{"path":"manifest","lines":["@@ -1,5 +1,5 @@","-C Merge\\sfixes\\sfor\\sissues\\sF3\\s(expert\\sextension),\\sF5\\s(dbdata\\sextension)\\sand\\sF6\\s(vec1\\sextension)\\sreported\\sat\\s[bugs:/info/2026-11-17T15:14:07Z\\s|\\s2026-11-17T15:14:07Z].","-D 2026-11-17T15:21:11.401","+C Have\\sthe\\ssession\\smodule\\smore\\sconsistently\\sreject\\sany\\schangeset/patchset\\sthat\\scontains\\sa\\smix\\sof\\schangeset\\sand\\spatchset\\sheaders\\sas\\scorrupt.\\sIssue\\sF8\\sreported\\sat\\s[bugs:/info/2026-11-17T15:14:07Z\\s|\\s2026-11-17T15:14:07Z].","+D 2026-11-17T15:34:52.818"," F .fossil-settings/binary-glob 61195414528fb3ea9693577e1980230d78a1f8b0a54c78cf1b9b24d0a409ed6a x"," F .fossil-settings/empty-dirs dbb81e8fc0401ac46a1491ab34a7f2c7c0452f2f06b54ebb845d024ca8283ef1"," F .fossil-settings/ignore-glob 35175cdfcf539b2318cb04a9901442804be81cd677d8b889fcc9149c21f239ea","@@ -570,7 +570,7 @@ F ext/session/sessionchange.test 6618cb1c1338a4b6df173b6ac42d09623fb71269962abf2"," F ext/session/sessionchange2.test eaf97490cd4931fc4b5f8be48a3143093b607de3fe72f9df33976012c0bdbeb6"," F ext/session/sessionconfli