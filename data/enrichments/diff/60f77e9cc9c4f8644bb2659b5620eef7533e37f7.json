governing permissions and limitations","+ * under the License.","+ */","+","+","+package org.apache.spark.sql.hudi.dml.others","+","+import org.apache.hudi.testutils.HoodieClientTestUtils.createMetaClient","+","+import org.apache.spark.sql.hudi.common.HoodieSparkSqlTestBase","+","+/**","+ * TIMESTAMP AS OF with a Hudi-format instant (yyyyMMddHHmmssSSS) in the positions a production query puts it:","+ * top level, inside a CTE, inside two CTEs joined, and inside a derived table.","+ */","+class TestTimeTravelInCte extends HoodieSparkSqlTestBase {","+","+  private def withTwoCommitTable(f: (String, String, String) => Unit): Unit = {","+    withTempDir { tmp =>","+      val tableName = generateTableName","+      spark.sql(","+        s\"\"\"","+           |create table $tableName (","+           |  id int,","+           |  name string,","+           |  ts long,","+           |  datestr string","+           |) using hudi","+           | tblproperties (type = 'cow', primaryKey = 'id', preCombineField = 'ts')","+           | partitioned by (datestr)","+           | location '${tmp.getCanonicalPath}/$tableName'","+         \"\"\".stripMargin)","+      spark.sql(s\"insert into $tableName values(1, 'a1', 1000, '2026-10-19')\")","+      val metaClient = createMetaClient(spark, s\"${tmp.getCanonicalPath}/$tableName\")","+      val instant1 = metaClient.getActiveTimeline.getAllCommitsTimeline.lastInstant().get().requestedTime","+      spark.sql(s\"insert into $tableName values(2, 'a2', 2000, '2026-10-19')\")","+      metaClient.reloadActiveTimeline()","+      val instant2 = metaClient.getActiveTimeline.getAllCommitsTimeline.lastInstant().get().requestedTime","+      f(tableName, instant1, instant2)","+    }","+  }","+","+  test(\"Time travel with a Hudi instant at top level\") {","+    withTwoCommitTable { (t, i1, _) =>","+      checkAnswer(s\"select count(*) from $t TIMESTAMP AS OF '$i1' where datestr = '2026-10-19'\")(Seq(1))","+    }","+  }","+","+  test(\"Time travel with a Hudi instant inside a CTE\") {","+    withTwoCommitTable { (t, i1, _) =>","+      checkAnswer(","+        s\"\"\"with a as (select * from $t TIMESTAMP AS OF '$i1' where datestr = '2026-10-19')","+           |select count(*) from a\"\"\".stripMargin)(Seq(1))","+    }","+  }","+","+  test(\"Time travel with Hudi instants inside two joined CTEs\") {","+    withTwoCommitTable { (t, i1, i2) =>","+      checkAnswer(","+        s\"\"\"with old as (select id, name from $t TIMESTAMP AS OF '$i1' where datestr = '2026-10-19'),","+           |new as (select id, name from $t TIMESTAMP AS OF '$i2' where datestr = '2026-10-19')","+           |select new.id from new left join old on new.id = old.id where old.id is null\"\"\".stripMargin)(Seq(2))","+    }","+  }","+","+  test(\"Time travel with a Hudi instant inside a derived table\") {","+    withTwoCommitTable { (t, i1, _) =>","+      checkAnswer(","+        s\"select count(*) from (select * from $t TIMESTAMP AS OF '$i1' where datestr = '2026-10-19') x\")(Seq(1))","+    }","+  }","+}"],"additions":87,"deletions":0,"truncated":false},{"path":"hudi-spark-datasource/hudi-spark3-common/src/main/scala/org/apache/spark/sql/HoodieSpark3CatalystPlanUtils.scala","lines":["@@ -19,7 +19,7 @@"," package org.apache.spark.sql"," "," import org.apache.spark.sql.catalyst.expressions.Expression","-import org.apache.spark.sql.catalyst.plans.logical.{Assignment, UpdateAction}","+import org.apache.spark.sql.catalyst.plans.logical.{Assignment, LogicalPlan, UnresolvedWith, UpdateAction}"," import org.apache.spark.sql.execution.streaming.SerializedOffset"," "," /**","@@ -41,4 +41,10 @@ abstract class HoodieSpark3CatalystPlanUtils extends BaseHoodieCatalystPlanUtils","       case _ => None","     }","   }","+","+  override def transformCteDefinitions(withClause: UnresolvedWith, f: LogicalPlan => LogicalPlan): LogicalPlan = {","+    withClause.copy(cteRelations = withClause.cteRelations.map { case (name, cte) =>","+      (name, cte.copy(child = f(cte.chi