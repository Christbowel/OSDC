{"id":"353379c141770e21ec0b2a8744d50f4eafb1901e","axis":"silent","repo":"pnpm/pnpm","sha":"353379c141770e21ec0b2a8744d50f4eafb1901e","parsed":{"files":[{"path":".changeset/deploy-source-date-epoch.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": minor","+---","+","+`pnpm deploy` and `pnpm install` now use the `SOURCE_DATE_EPOCH` environment variable as an upper bound for timestamps in `node_modules/.modules.yaml` and `node_modules/.pnpm-workspace-state-v1.json`. With an equivalently prepared deploy target and an epoch no later than the timestamps that would otherwise be recorded, deploying the same project twice produces identical files [pnpm/pnpm#17171](https://github.com/pnpm/pnpm/issues/17171)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/deploy.rs","lines":["@@ -1143,3 +1143,5 @@ mod source_isolation;"," mod local_dependencies;"," "," mod self_containment;","+","+mod reproducible;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/deploy/reproducible.rs","lines":["@@ -0,0 +1,55 @@","+use super::{AddMockedRegistry, CommandExtra, CommandTempCwd, fs, pacquet_cmd, write_workspace};","+use assert_cmd::assert::OutputAssertExt;","+","+/// `SOURCE_DATE_EPOCH` replaces the current time in the bookkeeping files a","+/// deploy writes, so two deploys of the same project are byte-identical.","+#[test]","+fn deploy_records_source_date_epoch_in_bookkeeping_files() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    write_workspace(&workspace, true);","+    let app_manifest_path = workspace.join(\"packages/app/package.json\");","+    let mut app_manifest: serde_json::Value =","+        serde_json::from_str(&fs::read_to_string(&app_manifest_path).unwrap()).unwrap();","+    app_manifest[\"scripts\"] = serde_json::json!({ \"start\": \"node index.js\" });","+    fs::write(app_manifest_path, app_manifest.to_string()).unwrap();","+    pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let deploy_dir = workspace.join(\"out\");","+    let deploy = || {","+        pacquet_cmd(&workspace)","+            .with_env(\"SOURCE_DATE_EPOCH\", \"1700000000\")","+            .with_args([\"--filter\", \"app\", \"deploy\", \"--prod\", \"out\"])","+            .assert()","+            .success();","+        let modules_dir = deploy_dir.join(\"node_modules\");","+        (","+            fs::read_to_string(modules_dir.join(\".modules.yaml\")).unwrap(),","+            fs::read_to_string(modules_dir.join(\".pnpm-workspace-state-v1.json\")).unwrap(),","+        )","+    };","+    let (modules_yaml, workspace_state) = deploy();","+    fs::remove_dir_all(&deploy_dir).unwrap();","+","+    assert!(modules_yaml.contains(\"Tue, 14 Nov 2023 22:13:20 GMT\"), \"{modules_yaml}\");","+    assert!(","+        workspace_state.contains(r#\"\"lastValidatedTimestamp\": 1700000000000\"#),","+        \"{workspace_state}\",","+    );","+    assert_eq!(deploy(), (modules_yaml, workspace_state));","+    pacquet_cmd(&deploy_dir)","+        .with_args([\"--config.verify-deps-before-run=error\", \"run\", \"start\"])","+        .assert()","+        .success();","+","+    drop((root, mock_instance));","+}"],"additions":55,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/lib.rs","lines":["@@ -23,6 +23,7 @@ pub use crate::{","     },","     global_bin_check::{CheckGlobalBinDirError, check_global_bin_dir},","     npmrc_auth::{BasicAuth, RegistryCreds, is_json_auth_scope, validate_json_auth_registry},","+    source_date_epoch::source_date_epoch,","     store_path::StoreRelocation,","     windows_path_env::{","         UnexpandedWindowsEnvVar, ensure_windows_dir_envs, ensure_windows_home_dir_env,","@@ -75,6 +76,7 @@ mod global_bin_check;"," mod node_linker;"," mod npmrc_auth;"," mod override_version_references;","+mod source_date_epoch;"," mod store_path;"," mod windows_path_env;"," mod workspace_yaml;","@@ -108,6 +110,7 @@ use std::{","     collections::{BTreeMap, BTreeSet, HashMap},","     path::{Path, PathBuf},","     sync::Arc,","+    time::SystemTime,"," };"," "," /// Which path-valued settings the user pinned somewhere in the cascade, as"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/settings.rs","lines":["@@ -5,8 +5,8 @@ use super::{","     PackageImportMethod, PackageManagerBootstrap, PathBuf, Pipe, PmOnFail, ProjectConfig,","     PythonSettings, RegistryOptions, RemoteCacheSettings, RemoteSideEffectsCacheSettings,","     ReporterType, ResolutionMode, RuntimeOnFail, SaveWorkspaceProtocol, ScriptsPrependNodePath,","-    SmartDefault, StoreDir, StoreIndexFormat, Tool, ToolSettings, TrustPolicy, VerifyDepsBeforeRun,","-    WorkspaceKeyIssues, default_cache_dir, default_child_concurrency,","+    SmartDefault, StoreDir, StoreIndexFormat, SystemTime, Tool, ToolSettings, TrustPolicy,","+    VerifyDepsBeforeRun, WorkspaceKeyIssues, default_cache_dir, default_child_concurrency,","     default_enable_global_virtual_store, default_fetch_min_speed_ki_bps, default_fetch_retries,","     default_fetch_retry_factor, default_fetch_retry_maxtimeout, default_fetch_retry_mintimeout,","     default_fetch_timeout, default_fetch_warn_timeout_ms, default_git_shallow_hosts,","@@ -15,7 +15,7 @@ use super::{","     default_public_hoist_pattern, default_registry, default_state_dir, default_store_dir,","     default_tag_version_prefix, default_unsafe_perm, default_user_agent,","     default_virtual_store_dir_max_length, default_workspace_concurrency, is_ci, npmrc_auth,","-    side_effects_cache_remote_env, workspace_yaml,","+    side_effects_cache_remote_env, source_date_epoch, workspace_yaml,"," };"," "," /// The two hoist patterns as one value, for","@@ -64,6 +64,11 @@ pub struct Config {","     #[default(_code = \"is_ci()\")]","     pub ci: bool,"," ","+    /// The time from `SOURCE_DATE_EPOCH`, recorded in place of the current","+    /// time in `.modules.yaml` and `.pnpm-workspace-state-v1.json`.","+    #[default(_code = \"source_date_epoch()\")]","+    pub source_date_epoch: Option<SystemTime>,","+","     /// Whether the default reporter renders dependency and download progress.","     #[default = true]","     pub progress: bool,"],"additions":8,"deletions":3,"truncated":false},{"path":"pnpm/crates/config/src/source_date_epoch.rs","lines":["@@ -0,0 +1,29 @@","+//! The [`SOURCE_DATE_EPOCH`](https://reproducible-builds.org/specs/source-date-epoch/)","+//! convention for reproducible output.","+","+use crate::api::{EnvVar, Host};","+use std::{","+    sync::OnceLock,","+    time::{Duration, SystemTime},","+};","+","+/// The time `SOURCE_DATE_EPOCH` sets, read once per process. `None` when the","+/// variable is unset or is not a whole number of seconds since the epoch.","+pub fn source_date_epoch() -> Option<SystemTime> {","+    static SOURCE_DATE_EPOCH: OnceLock<Option<SystemTime>> = OnceLock::new();","+    *SOURCE_DATE_EPOCH.get_or_init(read_source_date_epoch::<Host>)","+}","+","+pub(crate) fn read_source_date_epoch<Sys: EnvVar>() -> Option<SystemTime> {","+    let seconds = Sys::var(\"SOURCE_DATE_EPOCH\")?","+        .trim()","+        .parse::<u64>()","+        .ok()?;","+    if seconds > i64::MAX as u64 / 1_000 {","+        return None;","+    }","+    SystemTime::UNIX_EPOCH.checked_add(Duration::from_secs(seconds))","+}","+","+#[cfg(test)]","+mod tests;"],"additions":29,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/source_date_epoch/tests.rs","lines":["@@ -0,0 +1,42 @@","+use super::{EnvVar, read_source_date_epoch};","+use std::{","+    cell::RefCell,","+    time::{Duration, SystemTime},","+};","+","+thread_local! {","+    static VALUE: RefCell<Option<String>> = const { RefCell::new(None) };","+}","+","+struct FakeEnv;","+","+impl EnvVar for FakeEnv {","+    fn var(name: &str) -> Option<String> {","+        assert_eq!(name, \"SOURCE_DATE_EPOCH\");","+        VALUE.with_borrow(Clone::clone)","+    }","+}","+","+fn read_with(value: Option<&str>) -> Option<SystemTime> {","+    VALUE.set(value.map(str::to_string));","+    read_source_date_epoch::<FakeEnv>()","+}","+","+#[test]","+fn whole_seconds_set_the_time() {","+    assert_eq!(","+        read_with(Some(\"1700000000\")),","+        Some(SystemTime::UNIX_EPOCH + Duration::from_secs(1_700_000_000)),","+    );","+    assert_eq!(read_with(Some(\"0\")), Some(SystemTime::UNIX_EPOCH));","+}","+","+#[test]","+fn unset_or_malformed_values_are_ignored() {","+    assert_eq!(read_with(None), None);","+    assert_eq!(read_with(Some(\"\")), None);","+    assert_eq!(read_with(Some(\"-1\")), None);","+    assert_eq!(read_with(Some(\"1700000000.5\")), None);","+    assert_eq!(read_with(Some(\"yesterday\")), None);","+    assert_eq!(read_with(Some(&(i64::MAX as u64 / 1_000 + 1).to_string())), None);","+}"],"additions":42,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_package_from_registry/tests.rs","lines":["@@ -37,6 +37,7 @@ fn create_config(","         network_concurrency_by_registry: std::collections::BTreeMap::new(),","         bail: true,","         ci: false,","+        source_date_epoch: None,","         progress: true,","         update_notifier: true,","         color: Default::default(),"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/apply_materialization.rs","lines":["@@ -1,13 +1,12 @@","+pub(in crate::install) mod commit;"," pub(in crate::install) mod completion;"," ","+use commit::{CommitModulesStateInputs, commit_modules_state};"," use completion::{","     MaterializedProjectScriptsInputs, ReportInstallCompletionInputs, ResolveOnlyCompletionInputs,","     complete_resolve_only, report_install_completion, run_materialized_project_scripts,"," };"," ","-mod commit;","-use commit::{CommitModulesStateInputs, commit_modules_state};","-"," mod selection;"," use selection::{","     LinkMaterializedLockfiles, LinkMaterializedManifestLinks, LinkMaterializedProjectsInputs,"],"additions":2,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/apply_materialization/commit.rs","lines":["@@ -112,7 +112,8 @@ pub(super) fn prepare_committed_build_state(","         now,","     );","     tracing::info!(target: \"pacquet::install::phase\", phase = \"apply.prune\", elapsed_ms = phase_start.elapsed().as_millis() as u64, \"phase complete\");","-    let pruned_at = pruned_at(inputs.prior.layout, did_prune, now);","+    let pruned_at =","+        pruned_at(inputs.prior.layout, did_prune, now, inputs.tree.config.source_date_epoch);","     // The build phase settles a dependency only when it actually","     // rebuilt it, so a `pnpm rebuild --pending` that the policy still","     // blocks (`allowBuilds: None`/`false`) leaves the debt in place.","@@ -168,12 +169,19 @@ pub(super) fn merge_committed_modules_metadata("," }"," /// Stamp `prunedAt` only when the sweep ran (or there was no prior"," /// `.modules.yaml`); otherwise preserve the recorded timestamp so","-/// the throttle keeps counting from the last real prune.","-pub(super) fn pruned_at(","+/// the throttle keeps counting from the last real prune. When","+/// `SOURCE_DATE_EPOCH` is set, always record the capped epoch so","+/// existing installations produce reproducible output even when a","+/// sweep is not due.","+pub(in crate::install) fn pruned_at(","     prior_modules: Option<&pnpm_modules_yaml::ModulesLayout>,","     did_prune: bool,","     now: SystemTime,","+    source_date_epoch: Option<SystemTime>,"," ) -> String {","+    if let Some(epoch) = source_date_epoch {","+        return httpdate::fmt_http_date(epoch.min(now));","+    }","     match (prior_modules, did_prune) {","         (Some(prior), false) => prior.pruned_at.clone(),","         _ => httpdate::fmt_http_date(now),","@@ -274,7 +282,7 @@ fn virtual_store_prune_is_due(","                 false,","                 prior_modules.map(|modules| modules.pruned_at.as_str()),","                 config.modules_cache_max_age,","-                now,","+                config.source_date_epoch.map_or(now, |epoch| epoch.min(now)),","             ))"," }"," "],"additions":12,"deletions":4,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/prepare_modules_state/tests.rs","lines":["@@ -1,4 +1,9 @@","-use std::{collections::BTreeMap, fs, path::Path, time::SystemTime};","+use std::{","+    collections::BTreeMap,","+    fs,","+    path::Path,","+    time::{Duration, SystemTime},","+};"," "," use pnpm_config::{Config, NodeLinker};"," use pnpm_lockfile::Lockfile;","@@ -8,11 +13,12 @@ use pnpm_workspace_state::{ProjectEntry, WorkspaceState, load_workspace_state};"," use tempfile::tempdir;"," "," use crate::install::{","+    apply_materialization::commit::pruned_at,","     moved_tree_is_reusable,","     prepare_modules_state::{","         purge::{is_safe_modules_purge_target, purge_modules_dir_entries},","         recorded_workspace,","-        up_to_date::{FrozenTreeUpToDate, frozen_tree_up_to_date},","+        up_to_date::{FrozenTreeUpToDate, frozen_tree_up_to_date, modules_cache_prune_due},","     },","     state_options::{ModulesTreeContext, RecordedWorkspace, RepeatInstallPolicy},"," };","@@ -452,3 +458,31 @@ fn missing_or_corrupt_state_requires_relinking_only_for_an_existing_tree() {","         assert!(!fresh.moved, \"a first filtered install must still write its initial state\");","     }"," }","+","+#[test]","+fn source_date_epoch_stamps_and_evaluates_pruned_at_against_capped_clock() {","+    let now = SystemTime::UNIX_EPOCH + Duration::from_secs(1_776_718_252);","+    let epoch = SystemTime::UNIX_EPOCH + Duration::from_secs(1_700_000_000);","+    let future_epoch = now + Duration::from_hours(1);","+    let mut config = Config::new();","+    let mut prior = recorded_modules(&config, NodeLinker::Isolated);","+    prior.pruned_at = httpdate::fmt_http_date(now - Duration::from_mins(1));","+","+    assert_eq!(","+        pruned_at(Some(&prior), false, now, Some(epoch)),","+        httpdate::fmt_http_date(epoch),","+        \"SOURCE_DATE_EPOCH overrides prior prunedAt even when no sweep ran\",","+    );","+    assert_eq!(","+        pruned_at(Some(&prior), false, now, Some(future_epoch)),","+        httpdate::fmt_http_date(now),","+        \"a future SOURCE_DATE_EPOCH is capped to now\",","+    );","+","+    prior.pruned_at = httpdate::fmt_http_date(epoch);","+    config.source_date_epoch = Some(epoch);","+    assert!(","+        !modules_cache_prune_due(&config, Some(&prior)),","+        \"a tree stamped with SOURCE_DATE_EPOCH does not immediately expire under that epoch\",","+    );","+}"],"additions":36,"deletions":2,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/prepare_modules_state/up_to_date.rs","lines":["@@ -165,6 +165,8 @@ pub(super) fn modules_cache_prune_due(","     config: &Config,","     modules_manifest: Option<&pnpm_modules_yaml::ModulesLayout>,"," ) -> bool {","+    let now = SystemTime::now();","+    let effective_now = config.source_date_epoch.map_or(now, |epoch| epoch.min(now));","     modules_manifest.is_some_and(|modules| {","         crate::prune_virtual_store::should_prune_virtual_store(","             crate::prune_virtual_store::same_dir(","@@ -173,7 +175,7 @@ pub(super) fn modules_cache_prune_due(","             ),","             Some(modules.pruned_at.as_str()),","             config.modules_cache_max_age,","-            SystemTime::now(),","+            effective_now,","         )","     })"," }"],"additions":3,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/tests/build_workspace_state_tests.rs","lines":["@@ -109,6 +109,32 @@ fn raises_the_manifest_mtime_baseline_to_the_filesystem_now() {","     assert_eq!(build(Some(manifest_ms - 1)).last_validated_timestamp, manifest_ms);"," }"," ","+#[test]","+fn source_date_epoch_lowers_the_timestamp_but_never_raises_it() {","+    let dir = tempdir().unwrap();","+    let manifest = write_manifest(dir.path(), \"root\", \"1.0.0\");","+    let mut config = config_for(dir.path());","+    let mut build = |source_date_epoch_ms: u64| {","+        config.source_date_epoch =","+            Some(SystemTime::UNIX_EPOCH + Duration::from_millis(source_date_epoch_ms));","+        build_workspace_state::<FrozenClock>(","+            dir.path(),","+            &config,","+            pnpm_config::NodeLinker::default(),","+            IncludedDependencies::default(),","+            None,","+            &BTreeMap::default(),","+            &[(dir.path().to_path_buf(), &manifest)],","+            Some(1_600_000_001_000),","+        )","+        .last_validated_timestamp","+    };","+","+    assert_eq!(build(1_500_000_000_000), 1_500_000_000_000);","+    let validated = pnpm_testing_utils::fs::mtime_ms(manifest.path()).max(1_600_000_001_000);","+    assert_eq!(build(u64::try_from(validated).unwrap() + 1), validated);","+}","+"," /// Every project in the list lands in `state.projects` keyed by its"," /// `root_dir`. Regression catch for the bug where a workspace fresh"," /// install (no `pnpm-lock.yaml` on disk) recorded only the root"],"additions":26,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/workspace_state.rs","lines":["@@ -23,7 +23,7 @@ use super::{"," };"," use crate::optimistic_repeat_install::{","     Scope, check_optimistic_repeat_install_with_state, config_blocks_fast_path,","-    refreshed_validation_baseline_ms, validation_baseline_ms,","+    last_validated_timestamp,"," };"," use pnpm_reporter::Reporter;"," use pnpm_workspace_state::{load_workspace_state, update_workspace_state_in_modules};","@@ -442,10 +442,7 @@ pub(super) fn build_projects_map("," /// complete once the caller has settled its settings."," ///"," /// Records the projects pacquet just materialized plus the resolved","-/// settings the install used. `lastValidatedTimestamp` is the","-/// [`validation_baseline_ms`] of the lockfile and manifests raised to","-/// `filesystem_now_ms`, per [`refreshed_validation_baseline_ms`]; the","-/// wall clock stands in only when nothing can be stat'd.","+/// settings the install used, and the [`last_validated_timestamp`]."," /// Settings pacquet does not track yet (e.g. `peersSuffixMaxLength`)"," /// are omitted; pnpm's `checkDepsStatus`"," /// only iterates fields present in the serialized object, so an","@@ -465,9 +462,10 @@ pub(crate) fn build_workspace_state<Sys: Clock>(","     filesystem_now_ms: Option<i64>,"," ) -> WorkspaceState {","     let mut state = WorkspaceState {","-        last_validated_timestamp: refreshed_validation_baseline_ms(","-            validation_baseline_ms(workspace_root, config, project_manifests)","-                .unwrap_or_else(|| pnpm_workspace_state::millis_since_epoch(Sys::now())),","+        last_validated_timestamp: last_validated_timestamp::<Sys>(","+            workspace_root,","+            config,","+            project_manifests,","             filesystem_now_ms,","         ),","         projects: build_projects_map(project_manifests),"],"additions":6,"deletions":8,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install.rs","lines":["@@ -39,8 +39,8 @@ pub(crate) use settings::{"," };"," pub(crate) use timestamps::{","     file_mtime, file_mtime_from_metadata, filesystem_now_ms_in_modules,","-    filesystem_now_ns_in_modules, lockfile_modified_since, modified_at_or_after,","-    refreshed_validation_baseline_ms, validation_baseline_ms,","+    filesystem_now_ns_in_modules, last_validated_timestamp, lockfile_modified_since,","+    modified_at_or_after,"," };"," "," mod current_lockfile;"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/tests/validation.rs","lines":["@@ -1,12 +1,20 @@"," //! The content digests and records [`super::super::validation`] keeps."," ","-use super::super::validation::{","-    FileDigest, FileDigests, RecordValidation, Vouched, manifest_digest, record_validation,","+use super::super::{","+    pnpmfiles_drift,","+    validation::{","+        FileDigest, FileDigests, RecordValidation, Vouched, manifest_digest, record_validation,","+    },"," };"," use pnpm_config::Config;"," use pnpm_package_manifest::PackageManifest;"," use pnpm_workspace_state::{FileSignature, Validation, WorkspaceState};","-use std::{collections::HashSet, fs, path::Path};","+use std::{","+    collections::HashSet,","+    fs,","+    path::Path,","+    time::{Duration, SystemTime},","+};"," use tempfile::tempdir;"," "," fn manifest(json: &str) -> PackageManifest {","@@ -144,3 +152,54 @@ fn a_manifest_digest_matches_the_one_pnpm_v11_computes() {","     );","     assert_eq!(manifest_digest(&manifest), \"0684f5a6122e59859b6c170262a4c110\");"," }","+","+#[test]","+fn source_date_epoch_records_deterministic_pnpmfile_digests_without_trusting_mtimes() {","+    let dir = tempdir().unwrap();","+    let root = dir.path();","+    let pnpmfile = root.join(\".pnpmfile.cjs\");","+    fs::write(&pnpmfile, \"module.exports = {}\\n\").unwrap();","+    fs::write(root.join(\"pnpm-lock.yaml\"), \"lockfileVersion: '9.0'\\n\").unwrap();","+    let epoch = SystemTime::UNIX_EPOCH + Duration::from_secs(1_700_000_000);","+    pnpm_testing_utils::fs::set_mtime(&pnpmfile, epoch + Duration::from_hours(1));","+","+    let mut config = Config::new();","+    config.modules_dir = root.join(\"node_modules\");","+    config.install_state_dir = config.modules_dir.join(\".pnpm\");","+    config.source_date_epoch = Some(epoch);","+    let root_manifest = manifest(r#\"{\"name\":\"a\"}\"#);","+    let project_manifests = [(root.to_path_buf(), &root_manifest)];","+    let mut state = WorkspaceState {","+        last_validated_timestamp: 1_700_000_000_000,","+        pnpmfiles: vec![pnpmfile.to_string_lossy().into_owned()],","+        ..WorkspaceState::default()","+    };","+    record_validation(","+        &mut state,","+        &RecordValidation {","+            workspace_root: root,","+            config: &config,","+            project_manifests: &project_manifests,","+            vouched: &Vouched::All,","+        },","+    );","+","+    let validation = state.validation.as_ref().expect(\"validation recorded\");","+    assert_eq!(validation.recorded_at_ns, 0);","+    for signature in validation.files.values() {","+        assert_eq!(signature.mtime_ns, 0);","+        assert_eq!(signature.ctime_ns, None);","+    }","+    assert_eq!(","+        pnpmfiles_drift(root, &config, &state),","+        None,","+        \"an unchanged pnpmfile newer than SOURCE_DATE_EPOCH must not be flagged as modified\",","+    );","+","+    fs::write(&pnpmfile, \"module.exports = { hooks: {} }\\n\").unwrap();","+    pnpm_testing_utils::fs::set_mtime(&pnpmfile, epoch - Duration::from_hours(1));","+    assert!(","+        pnpmfiles_drift(root, &config, &state).is_some(),","+        \"an edited pnpmfile with mtime restored before SOURCE_DATE_EPOCH must be detected\",","+    );","+}"],"additions":62,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/timestamps.rs","lines":["@@ -1,6 +1,7 @@"," //! Modification times, and the baseline a recorded validation is compared against."," "," use super::{Config, Lockfile, PackageManifest, Path, PathBuf, SystemTime, fs};","+use pnpm_modules_yaml::Clock;"," "," pub(crate) const NANOS_PER_MILLI: i64 = 1_000_000;"," ","@@ -167,6 +168,25 @@ pub(crate) fn refreshed_validation_baseline_ms(baseline_ms: i64, now_ms: Option<","     now_ms.map_or(baseline_ms, |now| baseline_ms.max(now))"," }"," ","+/// The [`refreshed_validation_baseline_ms`] of the validated files, lowered","+/// to `SOURCE_DATE_EPOCH` when it is set. Never raised to it: a later value","+/// would hide manifest edits made before that time.","+pub(crate) fn last_validated_timestamp<Sys: Clock>(","+    workspace_root: &Path,","+    config: &Config,","+    project_manifests: &[(PathBuf, &PackageManifest)],","+    filesystem_now_ms: Option<i64>,","+) -> i64 {","+    let validated = refreshed_validation_baseline_ms(","+        validation_baseline_ms(workspace_root, config, project_manifests)","+            .unwrap_or_else(|| pnpm_workspace_state::millis_since_epoch(Sys::now())),","+        filesystem_now_ms,","+    );","+    config.source_date_epoch.map_or(validated, |epoch| {","+        validated.min(pnpm_workspace_state::millis_since_epoch(epoch))","+    })","+}","+"," /// Whether the lockfile's `subject` mtime post-dates `reference_ms`."," ///"," /// On a sub-second filesystem this is a whole-*millisecond* comparison,"],"additions":20,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/validation.rs","lines":["@@ -308,15 +308,19 @@ pub(crate) struct RecordValidation<'a> {"," /// The files are stat'd before the filesystem clock is probed, so a file"," /// rewritten after its stat either has a stat that no longer matches or falls"," /// inside the window [`FileDigests`] distrusts.","+///","+/// Under `SOURCE_DATE_EPOCH`, whose output must not vary with file stats or","+/// the clock, `recorded_at_ns` and each file signature's stat timestamps are","+/// zeroed while keeping content digests. [`signature_trusted`] then always","+/// returns `false`, so the next check rehashes the files on disk against the","+/// recorded digests instead of trusting modification times."," pub(crate) fn record_validation(state: &mut WorkspaceState, inputs: &RecordValidation<'_>) {","     let previous = match inputs.vouched {","         Vouched::All => None,","         Vouched::Projects { previous, .. } => *previous,","     };","     let (lockfile, files) = recorded_files(state, inputs, previous);","-    let Some(recorded_at_ns) = super::filesystem_now_ns_in_modules(","-        &inputs.config.workspace_state_modules_dir(inputs.workspace_root),","-    ) else {","+    let Some(recorded_at_ns) = recorded_validation_time_ns(inputs) else {","         state.validation = None;","         state.filtered_install = true;","         return;","@@ -332,6 +336,15 @@ pub(crate) fn record_validation(state: &mut WorkspaceState, inputs: &RecordValid","     state.validation = Some(validation);"," }"," ","+fn recorded_validation_time_ns(inputs: &RecordValidation<'_>) -> Option<i64> {","+    if inputs.config.source_date_epoch.is_some() {","+        return Some(0);","+    }","+    super::filesystem_now_ns_in_modules(&inputs.config.workspace_state_modules_dir(","+        inputs.workspace_root,","+    ))","+}","+"," /// The lockfile digest and the signatures of the shared input files, read"," /// the way the next check reads them."," fn recorded_files(","@@ -352,7 +365,11 @@ fn recorded_files(","                 }),","         )","         .filter_map(|(path, digest)| match digest {","-            FileDigest::Present(signature) => {","+            FileDigest::Present(mut signature) => {","+                if inputs.config.source_date_epoch.is_some() {","+                    signature.mtime_ns = 0;","+                    signature.ctime_ns = None;","+                }","                 Some((path.to_string_lossy().into_owned(), signature))","             }","             FileDigest::Absent | FileDigest::Unreadable => None,"],"additions":21,"deletions":4,"truncated":false},{"path":"pnpm/docs/cli/deploy.md","lines":["@@ -99,6 +99,12 @@ Since v12.7.0:","   or an absolute `virtualStoreDir`, it stays at `node_modules/.pnpm`."," * The `prepare` script of the deployed project is not run."," ","+## Reproducible output","+","+Since v12.15.0, when the [`SOURCE_DATE_EPOCH`](https://reproducible-builds.org/docs/source-date-epoch/) environment variable is set, `pnpm deploy` and `pnpm install` use it as an upper bound for the timestamps in `node_modules/.modules.yaml` and `node_modules/.pnpm-workspace-state-v1.json`. With an equivalently prepared deploy target and an epoch no later than the timestamps that would otherwise be recorded, deploying the same project with the same lockfile produces identical files, so a Docker layer built from the deploy directory stays cached.","+","+The next `pnpm install` or `pnpm run` in that directory checks the installed dependencies against the lockfile instead of trusting file modification times.","+"," ## Files included in the deployed project"," "," By default, all the files of the project are copied during deployment but this can be modified in _one_ of the following ways which are resolved in order:",""],"additions":6,"deletions":0,"truncated":false}],"additions":341,"deletions":30,"truncated":false,"file_count":19},"error":null,"fetched_at":"2026-10-21T13:27:23.207617+00:00"}