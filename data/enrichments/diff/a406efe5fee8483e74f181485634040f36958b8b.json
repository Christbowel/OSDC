,"+ */","+final class TaskCrashedException extends RuntimeException","+{","+    /**","+     * @psalm-mutation-free","+     */","+    private function __construct(public readonly string $path, string $message, Throwable $previous)","+    {","+        parent::__construct($message, 0, $previous);","+    }","+","+    /**","+     * @param class-string $main_task the task the worker ran","+     */","+    public static function inWorker(string $path, TaskFailureThrowable $failure, string $main_task): self","+    {","+        $causes = [];","+","+        for ($cause = $failure->getPrevious(); $cause instanceof TaskFailureThrowable; $cause = $cause->getPrevious()) {","+            $causes[] = 'Caused by: ' . $cause->getOriginalClassName() . ': ' . $cause->getOriginalMessage();","+        }","+","+        return new self(","+            $path,","+            self::report(","+                $path,","+                $failure->getOriginalClassName(),","+                $failure->getOriginalMessage(),","+                $failure->getOriginalFile(),","+                $failure->getOriginalLine(),","+                $causes,","+                self::traceUpToTask($failure->getOriginalTraceAsString(), $main_task),","+            ),","+            $failure,","+        );","+    }","+","+    public static function inProcess(string $path, Throwable $throwable): self","+    {","+        $causes = [];","+","+        for ($cause = $throwable->getPrevious(); $cause !== null; $cause = $cause->getPrevious()) {","+            $causes[] = 'Caused by: ' . $cause::class . ': ' . $cause->getMessage();","+        }","+","+        return new self(","+            $path,","+            self::report(","+                $path,","+                $throwable::class,","+                $throwable->getMessage(),","+                $throwable->getFile(),","+                $throwable->getLine(),","+                $causes,","+                $throwable->getTraceAsString(),","+            ),","+           