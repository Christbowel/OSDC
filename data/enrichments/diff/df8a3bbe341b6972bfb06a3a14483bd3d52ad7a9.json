eStaticLoader()` for $url ($name)',","     async ({ getData, url }) => {"],"additions":25,"deletions":0,"truncated":false},{"path":"packages/@expo/cli/e2e/__tests__/export/static-splitting.test.ts","lines":["@@ -117,6 +117,7 @@ describe('exports static with granular bundle splitting', () => {","         // loaders","         'env',","         'error',","+        'json-helper',","         'large-suspense',","         'meta',","         'no-loader',"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/expo-router/src/hooks/__tests__/useLoaderData.types.test.ts","lines":["@@ -0,0 +1,54 @@","+import { expectTypeOf } from 'expect-type';","+import { createServerLoader, createStaticLoader, json } from 'expo-server';","+","+import { useLoaderData } from '../useLoaderData';","+","+it('infers JSON payloads from synchronous and asynchronous loaders', () => {","+  const data = { id: 1 };","+  const loader = () => json(data);","+  const asyncLoader = async () => json(data);","+","+  expectTypeOf<ReturnType<typeof useLoaderData<typeof loader>>>().toEqualTypeOf<{ id: number }>();","+  expectTypeOf<ReturnType<typeof useLoaderData<typeof asyncLoader>>>().toEqualTypeOf<{","+    id: number;","+  }>();","+});","+","+it('infers JSON payloads through both loader helpers', () => {","+  const data = { id: 1 };","+  const staticLoader = createStaticLoader(() => json(data));","+  const serverLoader = createServerLoader(async () => json(data));","+","+  expectTypeOf<ReturnType<typeof useLoaderData<typeof staticLoader>>>().toEqualTypeOf<{","+    id: number;","+  }>();","+  expectTypeOf<ReturnType<typeof useLoaderData<typeof serverLoader>>>().toEqualTypeOf<{","+    id: number;","+  }>();","+});","+","+it('preserves unions of JSON responses and plain data', () => {","+  const data = { id: 1 };","+  const loader = () => (Math.random() ? json(data) : { error: 'missing' });","+","+  expectTypeOf<ReturnType<typeof useLoaderData<typeof loader>>>().toEqualTypeOf<","+    { id: number } | { error: string }","+  >();","+});","+","+it('preserves literal payload types', () => {","+  const data: { readonly id: 1 } = { id: 1 };","+  const loader = () => json(data);","+","+  expectTypeOf<ReturnType<typeof useLoaderData<typeof loader>>>().toEqualTypeOf<{","+    readonly id: 1;","+  }>();","+});","+","+it('keeps plain loader data and reads standard responses as untyped JSON', () => {","+  const loader = async () => ({ id: 1 });","+  const responseLoader = () => Response.json({ id: 1 });","+","+  expectTypeOf<ReturnType<typeof useLoaderData<typeof loader>>>().toEqualTypeOf<{ id: number }>();","+  expectTypeOf<ReturnType<typeof useLoaderData<typeof responseLoader>>>().toBeAny();","+});"],"additions":54,"deletions":0,"truncated":false},{"path":"packages/expo-router/src/hooks/useLoaderData.ts","lines":["@@ -12,7 +12,11 @@ import { fetchLoader } from '../loaders/utils';"," import { useCurrentRouteInfo } from './useCurrentRouteInfo';"," "," type LoaderFunctionResult<T extends LoaderFunction<any>> =","-  T extends LoaderFunction<infer R> ? R : unknown;","+  T extends LoaderFunction<infer R>","+    ? R extends Response","+      ? Awaited<ReturnType<R['json']>>","+      : R","+    : unknown;"," "," /**","  * Returns the result of the `loader` function for the calling route."],"additions":5,"deletions":1,"truncated":false},{"path":"packages/expo-server/src/__tests__/helpers.test.ts","lines":["@@ -0,0 +1,72 @@","+import { json, type TypedResponse } from '../index';","+","+type Equal<A, B> =","+  (<T>() => T extends A ? 1 : 2) extends <T>() => T extends B ? 1 : 2 ? true : false;","+type Expect<T extends true> = T;","+","+interface User {","+  id: number;","+}","+","+interface Payload {","+  user: User;","+}","+","+export function jsonInterfacePayload(data: Payload) {","+  return json(data);","+}","+","+export type InterfaceBody = Expect<","+  Equal<Awaited<ReturnType<ReturnType<typeof jsonInterfacePayload>['json']>>, Payload>","+>;","+","+export type JsonBody = Expect<","+  Equal<Awaited<ReturnType<TypedResponse<{ id: number }>['json']>>, { id: number }>","+>;","+export type ClonedJsonBody = Expect<","+  Equal<ReturnType<TypedResponse<{ id: number }>['clone']>, TypedResponse<{ id: number }>>","+>;","+","+it('returns a standard Response with the JSON body, status, and headers', async () => {","+  const response: Response = json(","+    { id: 1 },","+    {","+      status: 201,","+      headers: { 'Cache-Control': 'private, max-age=60' },","+    }","+  );","+","+  expect(response).toBeInstanceOf(Response);","+  expect(response.status).toBe(201);","+  expect(response.headers.get('Content-Type')).toBe('application/json');","+  expect(response.headers.get('Cache-Control')).toBe('private, max-age=60');","+  expect(await response.json()).toEqual({ id: 1 });","+});","+","+it('preserves the body when cloned', async () => {","+  const response = json({ id: 1 });","+  const clone = response.clone();","+","+  expect(await clone.json()).toEqual({ id: 1 });","+  expect(await response.json()).toEqual({ id: 1 });","+});","+","+it('supports null, primitives, arrays, and readonly values', async () => {","+  expect(await json(null).json()).toBeNull();","+  expect(await json('value').json()).toBe('value');","+  expect(await json(42).json()).toBe(42);","+  expect(await json(false).json()).toBe(false);","+  expect(await json([{ id: 1 }, null] as const).json()).toEqual([{ id: 1 }, null]);","+});","+","+// These calls are checked by tsc but must not execute during the runtime tests.","+export function invalidJsonInputs() {","+  // @ts-expect-error Dates serialize to strings and must be converted explicitly.","+  json({ date: new Date() });","+  // @ts-expect-error BigInts cannot be serialized as JSON.","+  json({ id: 1n });","+  // @ts-expect-error Functions are not JSON values.","+  json({ fn: () => 1 });","+  // @ts-expect-error Undefined is not a JSON value.","+  json(undefined);","+}"],"additions":72,"deletions":0,"truncated":false},{"path":"packages/expo-server/src/helpers.ts","lines":["@@ -0,0 +1,43 @@","+/** A value that can be sent as JSON without changing its TypeScript type. */","+export type JsonValue =","+  | string","+  | number","+  | boolean","+  | null","+  | readonly JsonValue[]","+  | { readonly [key: string]: JsonValue };","+","+// Interfaces have no implicit index signature, so check their properties individually.","+type JsonInput<T> = T extends JsonValue","+  ? T","+  : T extends (...args: never[]) => unknown","+    ? never","+    : T extends object","+      ? { [K in keyof T]: JsonInput<T[K]> }","+      : never;","+","+/** A standard `Response` that preserves the type of its JSON body. */","+export interface TypedResponse<T> extends Response {","+  json(): Promise<T>;","+  clone(): TypedResponse<T>;","+}","+","+/**","+ * Creates a JSON response while preserving the type of its body.","+ * Pass JSON values only. Convert values such as `Date` to strings before calling this helper.","+ *","+ * @example","+ * ```ts","+ * import { json } from 'expo-server';","+ *","+ * export function loader() {","+ *   return json({ name: 'Ada' }, {","+ *     headers: { 'Cache-Control': 'private, max-age=60' },","+ *   });","+ * }","+ * ```","+ */","+export function json<T>(data: T & JsonInput<T>, init?: ResponseInit): TypedResponse<T> {","+  // The input is restricted to JSON values, so parsing the body preserves its type.","+  return Response.json(data, init) as TypedResponse<T>;","+}"],"additions":43,"deletions":0,"truncated":false},{"path":"packages/expo-server/src/index.ts","lines":["@@ -1,3 +1,4 @@"," export * from './runtime/api';","+export { json, type JsonValue, type TypedResponse } from './helpers';"," export { createStaticLoader, createServerLoader } from './loaders/helpers';"," export type * from './types';",""],"additions":1,"deletions":0,"truncated":false}],"additions":284,"deletions":1,"truncated":false,"file_count":14},"error":null,"fetched_at":"2026-11-24T20:29:01.031980+00:00"}