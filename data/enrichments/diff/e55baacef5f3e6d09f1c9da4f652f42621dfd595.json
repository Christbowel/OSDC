eparator belongs to nobody.","+\t// Each slice starts where the previous statement ended and runs through its own terminators,","+\t// so comments and whitespace before a statement belong to it; a separator-only run before the","+\t// first statement belongs to nobody, and the last statement runs to the end of the input."," \tauto statements = StmtParseAll(fx.conn, \"-- lead\\n;select $1;\\n\\n  select 21 ;;\\t-- mid\\nSELECT 3; -- tail\");"," \tREQUIRE(statements.size() == 3);","-\tREQUIRE(StmtText(statements[0]) == \"select $1;\\n\\n  \");","-\tREQUIRE(StmtText(statements[1]) == \"select 21 ;;\\t-- mid\\n\");","-\tREQUIRE(StmtText(statements[2]) == \"SELECT 3; -- tail\");","+\tREQUIRE(StmtText(statements[0]) == \"select $1;\");","+\tREQUIRE(StmtText(statements[1]) == \"\\n\\n  select 21 ;;\");","+\tREQUIRE(StmtText(statements[2]) == \"\\t-- mid\\nSELECT 3; -- tail\");"," \tfor (auto &stmt : statements) {"," \t\tduckdb_v2_sql_statement_destroy(&stmt);"," \t}","@@ -772,8 +772,8 @@ TEST_CASE(\"V2: sql_statement_get_text outlives the input string and the iterator"," \tREQUIRE(statements.size() == 2);"," \t// The iterator is already destroyed by StmtParseAll; now clobber the caller's buffer too."," \tsql.assign(sql.size(), 'x');","-\tREQUIRE(StmtText(statements[0]) == \"SELECT 1; \");","-\tREQUIRE(StmtText(statements[1]) == \"SELECT 2\");","+\tREQUIRE(StmtText(statements[0]) == \"SELECT 1;\");","+\tREQUIRE(StmtText(statements[1]) == \" SELECT 2\");"," \tfor (auto &stmt : statements) {"," \t\tduckdb_v2_sql_statement_destroy(&stmt);"," \t}"],"additions":8,"deletions":8,"truncated":false},{"path":"test/api/test_parse_statement_iterator.cpp","lines":["@@ -198,6 +198,26 @@ TEST_CASE(\"ParseIterator: semicolons in strings and comments handled\", \"[api][pa"," \tREQUIRE(DrainParse(with_comments).size() == 2);"," }"," ","+TEST_CASE(\"ParseIterator: comments before a statement are part of its query text\", \"[api][parse_iterator]\") {","+\tDuckDB db(nullptr);","+\tConnection con(db);","+\tauto &ctx = *con.context;","+","+\tconst string sql = \"/* lead */ SELECT 1; -- between\\nSELECT 2 /* tail */;;  \";","+\tParseIterator it(ctx, sql);","+\tauto stmts = DrainParse(it);","+\tREQUIRE(stmts.size() == 2);","+\tREQUIRE(stmts[0]->query == \"/* lead */ SELECT 1;\");","+\tREQUIRE(stmts[1]->query == \" -- between\\nSELECT 2 /* tail */;;  \");","+","+\t// Parser::ParseQuery slices the same way","+\tParser parser(ctx);","+\tparser.ParseQuery(sql);","+\tREQUIRE(parser.statements.size() == 2);","+\tREQUIRE(parser.statements[0]->query == stmts[0]->query);","+\tREQUIRE(parser.statements[1]->query == stmts[1]->query);","+}","+"," //===--------------------------------------------------------------------===//"," // StatementIterator (Peek = \"more input?\", Get = the next user statement)"," //===--------------------------------------------------------------------===//","@@ -358,5 +378,5 @@ TEST_CASE(\"StatementIterator: a statement the engine expands is yielded as writt"," \tREQUIRE(stmts[3]->type == StatementType::TRANSACTION_STATEMENT);"," \tREQUIRE(stmts[4]->type == StatementType::MULTI_STATEMENT);"," \tREQUIRE(stmts[5]->type == StatementType::TRANSACTION_STATEMENT);","-\tREQUIRE(stmts[1]->query == \"ALTER TABLE t ADD COLUMN r DOUBLE DEFAULT random(); \");","+\tREQUIRE(stmts[1]->query == \" ALTER TABLE t ADD COLUMN r DOUBLE DEFAULT random();\");"," }"],"additions":21,"deletions":1,"truncated":false},{"path":"test/api/test_query_profiler.cpp","lines":["@@ -92,7 +92,7 @@ TEST_CASE(\"Test parser timing is reported per statement\", \"[api]\") {"," \tREQUIRE(single_statement_output.find(\"SELECT 7;\") != std::string::npos);"," "," \tauto iterator = con.context->IterateStatements(\"SELECT 42; SELECT 43;\");","-\tfor (const auto expected_query : {\"SELECT 42; \", \"SELECT 43;\"}) {","+\tfor (const auto expected_query : {\"SELECT 42;\", \" SELECT 43;\"}) {"," \t\tREQUIRE(iterator.Peek());"," \t\tauto statement = iterator.GetStatementForExecution();"," \t\tREQUI