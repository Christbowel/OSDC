{"id":"d7b1d7beda748c25ffd694cb6f38d593ee2124d7","axis":"silent","repo":"TryGhost/Ghost","sha":"d7b1d7beda748c25ffd694cb6f38d593ee2124d7","parsed":{"files":[{"path":"ghost/core/server/auth/better-auth/README.md","lines":["@@ -38,6 +38,15 @@ send the admin session with every frontend request. Its `maxAge` is Better"," Auth's, in seconds, from `expiresIn`. The auth frame (`web/admin/app.js`)"," accepts either name."," ","+Better Auth reads the client IP, for session rows and its rate limiter, only","+from request headers. A client can set any header, so Ghost points","+`advanced.ipAddress.ipAddressHeaders` at its own `x-ghost-client-ip`, which","+`setClientIPHeader` (`client-ip.ts`) overwrites with Express's `req.ip` as","+`trust proxy` resolved it. Mount it before any route that hands request headers","+to Better Auth. `ipv6Subnet: 64` and `normalizeIP` in Ghost's `BackoffLimiter`","+format an address the same way, so both count a client against the same key.","+IPv6 counts per /64, the block a single subscriber usually holds.","+"," - `knex-adapter.ts`: a Better Auth database adapter over a Knex instance. It","   imports nothing from Ghost, so it can become a package later. Ghost","   migrations own the DDL, so there is no `createSchema`. It generates no ids:"],"additions":9,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/client-ip.ts","lines":["@@ -0,0 +1,17 @@","+import type { NextFunction, Request, Response } from 'express';","+","+/** Carries the client IP Express resolved to Better Auth; only Ghost sets it. */","+export const CLIENT_IP_HEADER = 'x-ghost-client-ip';","+","+/**","+ * Replaces any copy of the client IP header a client sent with `req.ip`, as","+ * `trust proxy` resolved it. Mount before every route that hands the request","+ * headers to Better Auth.","+ */","+export function setClientIPHeader(req: Request, _res: Response, next: NextFunction) {","+  delete req.headers[CLIENT_IP_HEADER];","+  if (req.ip) {","+    req.headers[CLIENT_IP_HEADER] = req.ip;","+  }","+  next();","+}"],"additions":17,"deletions":0,"truncated":false},{"path":"ghost/core/server/auth/better-auth/create-auth.ts","lines":["@@ -3,6 +3,7 @@"," import { betterAuth } from 'better-auth/minimal';"," import errors from '@tryghost/errors';"," import type { Knex } from 'knex';","+import { CLIENT_IP_HEADER } from './client-ip';"," import { createKnexAdapter } from './knex-adapter';"," import {","   generateGhostId,","@@ -138,6 +139,8 @@ export function createAuth(deps: CreateAuthDeps) {","     },","     advanced: {","       database: { generateId: generateGhostId },","+      // Express's req.ip, set by setClientIPHeader; IPv6 counts per /64, as Ghost's limiters key it","+      ipAddress: { ipAddressHeaders: [CLIENT_IP_HEADER], ipv6Subnet: 64 },","       // Sets `Secure` and the `__Secure-` name prefix together, on an HTTPS admin URL only","       useSecureCookies: ssl,","       cookies: {"],"additions":3,"deletions":0,"truncated":false},{"path":"ghost/core/server/web/shared/middleware/api/backoff-limiter.ts","lines":["@@ -1,5 +1,7 @@"," import { createHash } from 'node:crypto';","+import { isIPv6 } from 'node:net';"," import errors from '@tryghost/errors';","+import ipaddr from 'ipaddr.js';"," import type { NextFunction, Request, Response } from 'express';"," import { RateLimiterRes } from 'rate-limiter-flexible';"," import type { RateLimiterAbstract } from 'rate-limiter-flexible';","@@ -17,6 +19,15 @@ export interface BackoffOptions {","   onBlocked: (retryAfterMs: number, res: Response) => Error;"," }"," ","+/** What a request counts against: its IP and the limiter's key. */","+export interface LimiterKey {","+  ip?: string;","+  key?: string;","+}","+","+/** Whether a counted request may continue, and if not, for how long it is blocked. */","+export type ConsumeResult = { allowed: true } | { allowed: false; retryAfterMs: number };","+"," /** Builds one rate-limiter-flexible limiter over the shared store. */"," export type LimiterFactory = (options: {","   keyPrefix: string;","@@ -36,6 +47,20 @@ export function backoffDelays(minWait: number, maxWait: number): number[] {","   return delays;"," }"," ","+/** Formats an IP as Better Auth does with `ipv6Subnet: 64`: IPv4-mapped IPv6 as IPv4, other IPv6 as its expanded /64. */","+export function normalizeIP(ip: string): string {","+  if (!isIPv6(ip)) {","+    return ip;","+  }","+","+  const address = ipaddr.process(ip);","+  if (!(address instanceof ipaddr.IPv6)) {","+    return address.toString();","+  }","+","+  return new ipaddr.IPv6([...address.parts.slice(0, 4), 0, 0, 0, 0]).toFixedLengthString();","+}","+"," const hashKey = (parts: (string | undefined)[]) =>","   createHash('sha256')","     .update(parts.map((part) => part ?? '').join('\\0'))","@@ -98,9 +123,9 @@ export class BackoffLimiter {","   }"," ","   readonly middleware = (req: Request, res: Response, next: NextFunction) => {","-    this.attempt(this.keyFor(req))","+    this.consume(this.keyFor(req))","       .then(","-        (blockedFor) => (blockedFor === null ? undefined : this.options.onBlocked(blockedFor, res)),","+        (result) => (result.allowed ? undefined : this.options.onBlocked(result.retryAfterMs, res)),","         (err: unknown) =>","           new errors.InternalServerError({","             message: 'Unknown error',","@@ -110,18 +135,32 @@ export class BackoffLimiter {","       .then(next, next);","   };"," ","+  /**","+   * Counts one request outside Express, against the same counters `middleware`","+   * uses for that IP and key. `ip` is ignored when the limiter ignores IP.","+   */","+  async consume(limiterKey: LimiterKey): Promise<ConsumeResult> {","+    const retryAfterMs = await this.attempt(this.hash(limiterKey));","+","+    return retryAfterMs === null ? { allowed: true } : { allowed: false, retryAfterMs };","+  }","+","   /** Clears the count and wait this request's key has built up. */","   resetRequest(req: Request) {","-    return this.clear(this.keyFor(req));","+    return this.reset(this.keyFor(req));","   }"," ","   /** Clears a key's count and wait. `ip` is ignored when the limiter ignores IP. */","-  reset({ ip, key }: { ip?: string; key?: string }) {","-    return this.clear(hashKey([this.options.ignoreIP ? undefined : ip, key]));","+  reset(limiterKey: LimiterKey) {","+    return this.clear(this.hash(limiterKey));","+  }","+","+  private keyFor(req: Request): LimiterKey {","+    return { ip: req.ip, key: this.options.key?.(req) };","   }"," ","-  private keyFor(req: Request) {","-    return hashKey([this.options.ignoreIP ? undefined : req.ip, this.options.key?.(req)]);","+  private hash({ ip, key }: LimiterKey) {","+    return hashKey([this.options.ignoreIP || !ip ? undefined : normalizeIP(ip), key]);","   }"," ","   /** Milliseconds the request is blocked for, or null when it may continue. */"],"additions":46,"deletions":7,"truncated":false},{"path":"ghost/core/server/web/shared/middleware/api/spam-prevention.ts","lines":["@@ -10,10 +10,6 @@ import { BackoffLimiter } from './backoff-limiter';"," import type { BackoffOptions, LimiterFactory } from './backoff-limiter';"," "," const messages = {","-  forgottenPasswordEmail: {","-    error: 'Only {rfa} forgotten password attempts per email every {rfp} seconds.',","-    context: 'Forgotten password reset attempt failed',","-  },","   forgottenPasswordIp: {","     error: 'Only {rfa} tries per IP address every {rfp} seconds.',","     context: 'Forgotten password reset attempt failed',","@@ -321,19 +317,18 @@ const userLogin = () =>","       }),","   });"," ","-// Stop password reset requests when there are (freeRetries + 1) requests per lifetime per email","-// Defaults here are 5 attempts per hour for a user+IP pair","+// Stops password reset requests when there are (freeRetries + 1) requests per lifetime per IP","+// Defaults here are 5 attempts per hour per IP"," // The endpoint is then locked for an hour"," const userReset = () =>","   limiter('userReset', 'user_reset', {","-    key: (req) => emailKey(bodyField(req, 'username')),","     onBlocked(retryAfterMs) {","       const { attempts, period } = quotedLimits('user_reset');"," ","       return new errors.TooManyRequestsError({","         message: `Too many password reset attempts try again in ${waitText(retryAfterMs)}`,","-        context: tpl(messages.forgottenPasswordEmail.error, { rfa: attempts, rfp: period }),","-        help: tpl(messages.forgottenPasswordEmail.context),","+        context: tpl(messages.forgottenPasswordIp.error, { rfa: attempts, rfp: period }),","+        help: tpl(messages.forgottenPasswordIp.context),","       });","     },","   });"],"additions":4,"deletions":9,"truncated":false},{"path":"ghost/test/unit/server/auth/better-auth/client-ip.test.ts","lines":["@@ -0,0 +1,73 @@","+import assert from 'node:assert/strict';","+import type { NextFunction, Request, Response } from 'express';","+import type { Knex } from 'knex';","+import { getIP } from 'better-auth/api';","+import {","+  CLIENT_IP_HEADER,","+  setClientIPHeader,","+} from '../../../../../core/server/auth/better-auth/client-ip';","+import { createAuth } from '../../../../../core/server/auth/better-auth/create-auth';","+import { normalizeIP } from '../../../../../core/server/web/shared/middleware/api/backoff-limiter';","+","+function withHeader(ip: string | undefined, headers: Record<string, string> = {}) {","+  const req = { ip, headers: { ...headers } } as Request;","+  let called = false;","+  setClientIPHeader(","+    req,","+    {} as Response,","+    (() => {","+      called = true;","+    }) as NextFunction,","+  );","+  assert.ok(called);","+  return req;","+}","+","+describe('setClientIPHeader', function () {","+  it('replaces a client-sent copy of the header with req.ip', function () {","+    const req = withHeader('203.0.113.7', { [CLIENT_IP_HEADER]: '198.51.100.1' });","+","+    assert.equal(req.headers[CLIENT_IP_HEADER], '203.0.113.7');","+  });","+","+  it('drops a client-sent copy when Express resolved no IP', function () {","+    const req = withHeader(undefined, { [CLIENT_IP_HEADER]: '198.51.100.1' });","+","+    assert.equal(Object.hasOwn(req.headers, CLIENT_IP_HEADER), false);","+  });","+","+  it('gives Better Auth the IP Ghost limiters key on, whatever the forwarded headers say', async function () {","+    const auth = createAuth({","+      db: {} as Knex,","+      secret: 'a'.repeat(64),","+      sessionMaxAgeMs: 1000,","+      urlUtils: {","+        getAdminUrl: () => undefined,","+        getSiteUrl: () => 'https://example.com/',","+        getSubdir: () => '',","+        isSSL: () => true,","+      },","+      password: { hash: async () => '', compare: async () => false },","+      logger: { debug() {}, info() {}, warn() {}, error() {} },","+    });","+    const { options } = await auth.$context;","+","+    for (const ip of [","+      '203.0.113.7',","+      '::ffff:203.0.113.7',","+      '2001:DB8::1',","+      '2001:db8:0:0:1::1',","+      '2001:db8:1:2:3:4:5:6',","+      '::1',","+    ]) {","+      const req = withHeader(ip, { 'x-forwarded-for': '198.51.100.1' });","+      const headers = new Headers(req.headers as Record<string, string>);","+","+      assert.equal(","+        getIP(new Request('https://example.com/', { headers }), options),","+        normalizeIP(ip),","+        ip,","+      );","+    }","+  });","+});"],"additions":73,"deletions":0,"truncated":false},{"path":"ghost/test/unit/server/web/shared/middleware/api/backoff-limiter.test.ts","lines":["@@ -5,6 +5,7 @@ import { RateLimiterMemory } from 'rate-limiter-flexible';"," import {","   BackoffLimiter,","   backoffDelays,","+  normalizeIP,"," } from '../../../../../../../core/server/web/shared/middleware/api/backoff-limiter';"," import type {","   BackoffOptions,","@@ -235,6 +236,75 @@ describe('BackoffLimiter', function () {","     assert.equal((await request(limiter)).allowed, true);","   });"," ","+  it('consume({ip, key}) allows freeRetries + 1 requests, then reports the wait', async function () {","+    vi.useFakeTimers({ now: 0 });","+    const limiter = build();","+    const outcomes = [];","+","+    for (let i = 0; i < 4; i++) {","+      outcomes.push(await limiter.consume({ ip: '127.0.0.1', key: 'key' }));","+    }","+","+    assert.deepEqual(outcomes, [","+      { allowed: true },","+      { allowed: true },","+      { allowed: true },","+      { allowed: false, retryAfterMs: 1000 },","+    ]);","+  });","+","+  it('consume shares counters with middleware for the same IP and key', async function () {","+    const limiter = build({ freeRetries: 1 });","+","+    assert.deepEqual(await run(limiter, 2), [true, true]);","+    assert.equal((await limiter.consume({ ip: '127.0.0.1', key: 'key' })).allowed, false);","+","+    const other = build({ freeRetries: 1 });","+    await other.consume({ ip: '127.0.0.1', key: 'key' });","+    await other.consume({ ip: '127.0.0.1', key: 'key' });","+    assert.equal((await request(other)).allowed, false);","+  });","+","+  it('consume ignores ip on a limiter that ignores IP', async function () {","+    const limiter = build({ freeRetries: 0, ignoreIP: true });","+","+    assert.equal((await limiter.consume({ ip: '10.0.0.1', key: 'key' })).allowed, true);","+    assert.equal((await limiter.consume({ ip: '10.0.0.2', key: 'key' })).allowed, false);","+  });","+","+  it('counts every spelling of an IP against one key', async function () {","+    const limiter = build({ freeRetries: 1 });","+","+    await request(limiter, { ip: '2001:DB8::1' });","+    await limiter.consume({ ip: '2001:0db8:0000:0000:0000:0000:0000:0001', key: 'key' });","+    assert.equal((await request(limiter, { ip: '2001:db8:0:0:0:0:0:1' })).allowed, false);","+","+    await request(limiter, { ip: '::ffff:10.0.0.1' });","+    await limiter.consume({ ip: '10.0.0.1', key: 'key' });","+    assert.equal((await request(limiter, { ip: '::ffff:a00:1' })).allowed, false);","+  });","+","+  it('counts an IPv6 /64 as one client', async function () {","+    const limiter = build({ freeRetries: 0 });","+","+    assert.equal((await request(limiter, { ip: '2001:db8:1:2::1' })).allowed, true);","+    assert.equal((await request(limiter, { ip: '2001:db8:1:2:ffff::9' })).allowed, false);","+    assert.equal((await request(limiter, { ip: '2001:db8:1:3::1' })).allowed, true);","+  });","+","+  it('normalizes IPs the way Better Auth does with a /64 IPv6 subnet', function () {","+    assert.equal(normalizeIP('203.0.113.7'), '203.0.113.7');","+    assert.equal(normalizeIP('2001:DB8::1'), '2001:0db8:0000:0000:0000:0000:0000:0000');","+    assert.equal(normalizeIP('::1'), '0000:0000:0000:0000:0000:0000:0000:0000');","+    assert.equal(normalizeIP('::'), '0000:0000:0000:0000:0000:0000:0000:0000');","+    assert.equal(normalizeIP('2001:db8:1:2:3:4:5:6'), '2001:0db8:0001:0002:0000:0000:0000:0000');","+    assert.equal(normalizeIP('::ffff:203.0.113.7'), '203.0.113.7');","+    assert.equal(normalizeIP('0:0:0:0:0:ffff:203.0.113.7'), '203.0.113.7');","+    assert.equal(normalizeIP('::ffff:cb00:7107'), '203.0.113.7');","+    assert.equal(normalizeIP('64:ff9b::203.0.113.7'), '0064:ff9b:0000:0000:0000:0000:0000:0000');","+    assert.equal(normalizeIP('not an ip'), 'not an ip');","+  });","+","   it('fails the request with an InternalServerError when the store fails', async function () {","     const failure = new Error('database gone');","     const broken: LimiterFactory = (options) => {"],"additions":70,"deletions":0,"truncated":false},{"path":"ghost/test/unit/server/web/shared/middleware/api/spam-prevention.test.ts","lines":["@@ -172,10 +172,13 @@ describe('Spam Prevention', function () {","     assert.equal(second.options.lifetime, 23);","   });"," ","-  it('keys member sign-ins and staff resets on a normalized email', function () {","+  it('keys staff resets on IP alone', function () {","+    assert.equal(build('userReset').options.key, undefined);","+  });","+","+  it('keys member sign