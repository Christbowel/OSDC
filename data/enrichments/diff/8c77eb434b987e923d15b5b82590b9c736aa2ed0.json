{"id":"8c77eb434b987e923d15b5b82590b9c736aa2ed0","axis":"silent","repo":"rails/rails","sha":"8c77eb434b987e923d15b5b82590b9c736aa2ed0","parsed":{"files":[{"path":"activerecord/CHANGELOG.md","lines":["@@ -1,3 +1,12 @@","+*   Truncate tables shadowed by a same-named table earlier on the PostgreSQL","+    `search_path`.","+","+    `db:truncate_all` and the reset of parallel test databases truncated the","+    table a bare name resolves to twice and left the shadowed one untouched.","+    They also failed on a table whose name contains a dot.","+","+    *Sergei Malykh*","+"," *   Fix `remove_index` and `index_exists?` in migrations declaring version 4.2","     to honor `table_name_prefix` and `table_name_suffix`."," "],"additions":9,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/abstract/database_statements.rb","lines":["@@ -378,6 +378,10 @@ def truncate_tables(*table_names) # :nodoc:","         end","       end"," ","+      def tables_to_truncate # :nodoc:","+        tables","+      end","+","       # Runs the given block in a database transaction, and returns the result","       # of the block.","       #","@@ -692,7 +696,7 @@ def insert_fixtures_set(fixture_set, tables_to_delete = [])","       end"," ","       def empty_all_tables # :nodoc:","-        truncate_tables(*tables)","+        truncate_tables(*tables_to_truncate)","       end"," ","       def empty_insert_statement_value(primary_key = nil)"],"additions":5,"deletions":1,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/postgresql/database_statements.rb","lines":["@@ -132,6 +132,11 @@ def execute_batch(statements, name = nil, **kwargs) # :nodoc:","           intent.finish","         end"," ","+        def tables_to_truncate # :nodoc:","+          internal_tables = [pool.schema_migration.table_name, pool.internal_metadata.table_name]","+          search_path_tables.filter_map { |name, table| name unless internal_tables.include?(table) }","+        end","+","         private","           IDLE_TRANSACTION_STATUSES = [PG::PQTRANS_IDLE, PG::PQTRANS_INTRANS, PG::PQTRANS_INERROR].freeze","           private_constant :IDLE_TRANSACTION_STATUSES"],"additions":5,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/postgresql/schema_statements.rb","lines":["@@ -1437,6 +1437,16 @@ def unique_constraint_for!(table_name, column: nil, **options)","               raise(ArgumentError, \"Table '#{table_name}' has no unique constraint for #{column || options}\")","           end"," ","+          # Every table on the search path as [regclass::text, relname]. regclass::text","+          # schema-qualifies a name unless it resolves unqualified on the search path.","+          def search_path_tables","+            query_rows(<<~SQL, \"SCHEMA\")","+              SELECT c.oid::regclass::text, c.relname","+              FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace","+              WHERE n.nspname = ANY (current_schemas(false)) AND c.relkind IN ('r','p')","+            SQL","+          end","+","           def data_source_sql(name = nil, type: nil)","             scope = quoted_scope(name, type: type)","             scope[:type] ||= \"'r','v','m','p','f'\" # (r)elation/table, (v)iew, (m)aterialized view, (p)artitioned table, (f)oreign table"],"additions":10,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/connection_adapters/ractor_connection_handler/postgresql_proxy_adapter.rb","lines":["@@ -306,6 +306,10 @@ def table_comment(...)","           remote_dispatch(:table_comment, ...)","         end"," ","+        def tables_to_truncate","+          remote_dispatch(:tables_to_truncate)","+        end","+","         def type_to_sql(...)","           pure_remote_dispatch(:type_to_sql, ...)","         end"],"additions":4,"deletions":0,"truncated":false},{"path":"activerecord/lib/active_record/tasks/database_tasks.rb","lines":["@@ -234,7 +234,7 @@ def empty_all_tables(db_config)"," ","       def truncate_tables(db_config)","         with_temporary_connection(db_config) do |conn|","-          conn.truncate_tables(*conn.tables)","+          conn.truncate_tables(*conn.tables_to_truncate)","         end","       end","       private :truncate_tables"],"additions":1,"deletions":1,"truncated":false},{"path":"activerecord/test/cases/adapters/postgresql/schema_test.rb","lines":["@@ -74,6 +74,14 @@ class Thing5 < ActiveRecord::Base","     self.table_name = \"things\"","   end"," ","+  class SchemaMigration1 < ActiveRecord::Base","+    self.table_name = \"test_schema.schema_migrations\"","+  end","+","+  class SchemaMigration2 < ActiveRecord::Base","+    self.table_name = \"test_schema2.schema_migrations\"","+  end","+","   class Song < ActiveRecord::Base","     self.table_name = \"music.songs\"","     has_and_belongs_to_many :albums","@@ -271,6 +279,35 @@ def test_data_source_exists_when_not_on_schema_search_path","     end","   end"," ","+  def test_empty_all_tables_empties_a_table_shadowed_by_a_same_named_one_on_the_search_path","+    Thing1.create!(id: 1)","+    Thing2.create!(id: 1)","+","+    with_schema_search_path(\"#{SCHEMA_NAME}, #{SCHEMA2_NAME}\") do","+      @connection.empty_all_tables","+    end","+","+    assert_equal 0, Thing1.count","+    assert_equal 0, Thing2.count","+  end","+","+  def test_empty_all_tables_keeps_internal_tables_in_every_schema_on_the_search_path","+    [SCHEMA_NAME, SCHEMA2_NAME].each do |schema|","+      @connection.create_table \"#{schema}.#{@connection.pool.schema_migration.table_name}\", id: false do |t|","+        t.string :version","+      end","+    end","+    SchemaMigration1.create!(version: \"1\")","+    SchemaMigration2.create!(version: \"1\")","+","+    with_schema_search_path(\"#{SCHEMA_NAME}, #{SCHEMA2_NAME}\") do","+      @connection.empty_all_tables","+    end","+","+    assert_equal 1, SchemaMigration1.count","+    assert_equal 1, SchemaMigration2.count","+  end","+","   def test_data_source_exists_wrong_schema","     assert_not(@connection.data_source_exists?(\"foo.things\"), \"data_source should not exist\")","   end",""],"additions":37,"deletions":0,"truncated":false}],"additions":71,"deletions":2,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-17T12:26:21.339187+00:00"}