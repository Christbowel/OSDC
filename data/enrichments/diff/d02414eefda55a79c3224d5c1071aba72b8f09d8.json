ge', () => {"," ","     await waitFor(() => expect(exportRequests).toEqual([dayBounds]));","   });","+","+  describe('ProtectedListPage', () => {","+    const originalStrapi = window.strapi;","+","+    beforeEach(() => {","+      window.strapi = {","+        ...originalStrapi,","+        features: {","+          ...originalStrapi.features,","+          isEnabled: (name?: string) => name === 'audit-logs',","+        },","+      };","+    });","+","+    afterEach(() => {","+      window.strapi = originalStrapi;","+    });","+","+    it('renders the not found page when the config disables audit logs', async () => {","+      server.use(","+        http.get('/admin/license-limit-information', () =>","+          HttpResponse.json({","+            data: { features: [{ name: 'audit-logs' }], auditLogs: { enabled: false } },","+          })","+        )","+      );","+","+      render(<ProtectedListPage />);","+","+      expect(await screen.findByRole('heading', { name: 'Page not found' })).toBeInTheDocument();","+      expect(screen.queryByRole('heading', { name: 'Audit Logs' })).not.toBeInTheDocument();","+    });","+","+    it('renders the audit logs when the config keeps them enabled', async () => {","+      server.use(","+        http.get('/admin/license-limit-information', () =>","+          HttpResponse.json({","+            data: { features: [{ name: 'audit-logs' }], auditLogs: { enabled: true } },","+          })","+        )","+      );","+","+      render(<ProtectedListPage />);","+","+      expect(await screen.findByRole('heading', { name: 'Audit Logs' })).toBeInTheDocument();","+      expect(screen.queryByRole('heading', { name: 'Page not found' })).not.toBeInTheDocument();","+    });","+  });"," });"],"additions":49,"deletions":1,"truncated":false},{"path":"packages/core/admin/ee/server/src/controllers/__tests__/admin.license.vitest.test.ts","lines":["@@ -124,6 +124,52 @@ describe('getProjectType', () => {","   });"," });"," ","+describe('licenseLimitInformation auditLogs', () => {","+  const setConfig = (config: Record<string, unknown>) => {","+    (global.strapi as any).config.get = vi.fn((key: string, defaultValue: unknown) =>","+      key in config ? config[key] : defaultValue","+    );","+  };","+","+  it('reports audit logs enabled when the license has them and the config is unset', async () => {","+    createStrapiMock();","+    stubUserServices();","+","+    const { data } = await adminController.licenseLimitInformation();","+","+    expect(data.auditLogs).toEqual({ enabled: true });","+  });","+","+  it('reports audit logs disabled when admin.auditLogs.enabled is false', async () => {","+    createStrapiMock();","+    stubUserServices();","+    setConfig({ 'admin.auditLogs.enabled': false });","+","+    const { data } = await adminController.licenseLimitInformation();","+","+    expect(data.auditLogs).toEqual({ enabled: false });","+  });","+","+  it('reports audit logs disabled when the license lacks them', async () => {","+    createStrapiMock({ ee: { features: { list: () => [], isEnabled: () => false } } });","+    stubUserServices();","+    setConfig({ 'admin.auditLogs.enabled': true });","+","+    const { data } = await adminController.licenseLimitInformation();","+","+    expect(data.auditLogs).toEqual({ enabled: false });","+  });","+","+  it('keeps the config state off the unauthenticated project-type response', async () => {","+    createStrapiMock();","+    setConfig({ 'admin.auditLogs.enabled': false });","+","+    const data = (await adminController.getProjectType()).data as any;","+","+    expect(data).not.toHaveProperty('auditLogs');","+  });","+});","+"," describe('licenseLimitInformation (extended fields)', () => {","   const OLD_ENV = process.env;","   beforeEach(() => {"],"additions":46,"deletions":0,"truncated":false},{"path":"packages/core/admin/ee/server/src/controllers/admin.ts","lines":["@@ -5,6 +5,7 @@ import type {","   GetProjectType,"," } from '../../../../shared/contracts/admin';"," import { getService } from '../utils';","+import { isAuditLogsEnabled } from '../audit-logs/utils';"," "," type RetainedFeature = { name: string; [key: string]: any };"," ","@@ -172,6 +173,7 @@ export default {","       features: (strapi.ee.features.list() ??","         []) as GetLicenseLimitInformation.Response['data']['features'],","       entitlements: strapi.ee.entitlements.list(),","+      auditLogs: { enabled: isAuditLogsEnabled(strapi) },","     };"," ","     return { data } satisfies GetLicenseLimitInformation.Response;"],"additions":2,"deletions":0,"truncated":false},{"path":"packages/core/admin/shared/contracts/admin.ts","lines":["@@ -278,6 +278,11 @@ export declare namespace GetLicenseLimitInformation {","         feature: string;","         limits: Array<{ key: string; unit?: 'days' | 'count'; value: number | null }>;","       }>;","+      /**","+       * Whether audit logs run: the license includes them and `admin.auditLogs.enabled` is not","+       * `false`. `features` lists `audit-logs` from the license alone.","+       */","+      auditLogs: { enabled: boolean };","     };","     error?: errors.ApplicationError;","   }"],"additions":5,"deletions":0,"truncated":false},{"path":"tests/api/core/admin/ee/audit-logs/config-disabled-admin-state.test.api.ts","lines":["@@ -0,0 +1,56 @@","+import { describeOnCondition } from 'api-tests/utils';","+import { createStrapiInstance } from 'api-tests/strapi';","+import { createAuthRequest } from 'api-tests/request';","+import type { Core } from '@strapi/types';","+","+const edition = process.env.STRAPI_DISABLE_EE === 'true' ? 'CE' : 'EE';","+","+// The admin hides the audit-logs settings link, page and homepage widget from the config state that","+// `/admin/license-limit-information` reports, since the license alone does not tell it.","+describeOnCondition(edition === 'EE')('Audit logs config state for the admin', () => {","+  let strapi: Core.Strapi | undefined;","+  let rq: Awaited<ReturnType<typeof createAuthRequest>>;","+","+  const boot = async (auditLogsEnabled: boolean | undefined) => {","+    strapi = await createStrapiInstance({","+      register: async ({ strapi: instance }: { strapi: Core.Strapi }) => {","+        if (auditLogsEnabled !== undefined) {","+          instance.config.set('admin.auditLogs.enabled', auditLogsEnabled);","+        }","+      },","+    });","+    rq = await createAuthRequest({ strapi });","+  };","+","+  const shutdown = async () => {","+    if (strapi !== undefined) {","+      await strapi.destroy();","+      strapi = undefined;","+    }","+  };","+","+  const getAuditLogsState = async () => {","+    const res = await rq({ method: 'GET', url: '/admin/license-limit-information' });","+","+    expect(res.statusCode).toBe(200);","+","+    return res.body.data.auditLogs;","+  };","+","+  afterEach(async () => {","+    await shutdown();","+  });","+","+  test.each([","+    { config: undefined, enabled: true },","+    { config: true, enabled: true },","+    { config: false, enabled: false },","+  ])(","+    'reports auditLogs.enabled $enabled when admin.auditLogs.enabled is $config',","+    async ({ config, enabled }) => {","+      await boot(config);","+","+      expect(await getAuditLogsState()).toEqual({ enabled });","+    }","+  );","+});",""],"additions":56,"deletions":0,"truncated":false}],"additions":375,"deletions":6,"truncated":false,"file_count":15},"error":null,"fetched_at":"2026-11-06T17:00:28.183806+00:00"}