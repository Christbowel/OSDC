{"id":"d02414eefda55a79c3224d5c1071aba72b8f09d8","axis":"silent","repo":"strapi/strapi","sha":"d02414eefda55a79c3224d5c1071aba72b8f09d8","parsed":{"files":[{"path":"docs/docs/packages/core/admin/ee/audit-logs.md","lines":["@@ -40,6 +40,8 @@ While the license includes the `audit-logs` feature and the config is off, the E"," "," When the license loses the `audit-logs` feature, the two actions are not registered on the next boot. The Super Admin reset (`resetSuperAdminPermissions`) drops them from the Super Admin, and the permission cleanup (`cleanPermissionsInDatabase`) deletes them from every other role and from admin tokens. When the feature comes back, the Super Admin reset restores them for the Super Admin only."," ","+The admin panel follows the same condition. `window.strapi.features` (from `/admin/project-type`) only carries the license, so the config state comes from the authenticated `GET /admin/license-limit-information`, as `auditLogs: { enabled }` (`isAuditLogsEnabled`). `useIsAuditLogsDisabledByConfig` (`packages/core/admin/ee/admin/src/hooks/`) reads it; when the config is off the admin hides the Settings \"Audit Logs\" link (`useSettingsMenu`), shows the not found page on `/settings/audit-logs` (`ProtectedListPage`), and drops the homepage \"Last activity\" widget (`hideAuditLogsWidgetWhenDisabled` in `widgetVisibility.ts`). Until that response arrives, the license alone decides.","+"," ### Subscribing to all events"," "," The Audit Logs feature adds a subscriber to the [EventHub](../../core/event-hub.md), allowing it to listen to all events in the application. However, we don't save every event in the audit logs; we only save the default ones (see the defaultEvents array in the service file)."],"additions":2,"deletions":0,"truncated":false},{"path":"packages/core/admin/admin/src/hooks/tests/useSettingsMenu.test.ts","lines":["@@ -1,4 +1,70 @@","-import { normalizeSettings } from '../useSettingsMenu';","+import { renderHook, server, waitFor } from '@tests/utils';","+import { http, HttpResponse } from 'msw';","+","+import { normalizeSettings, useSettingsMenu } from '../useSettingsMenu';","+","+describe('useSettingsMenu', () => {","+  const originalStrapi = window.strapi;","+","+  beforeEach(() => {","+    window.strapi = {","+      ...originalStrapi,","+      isEE: true,","+      features: {","+        ...originalStrapi.features,","+        isEnabled: (name?: string) => name === 'audit-logs',","+      },","+    };","+  });","+","+  afterEach(() => {","+    window.strapi = originalStrapi;","+  });","+","+  const respondWith = (auditLogs: { enabled: boolean }) =>","+    server.use(","+      http.get('/admin/license-limit-information', () =>","+        HttpResponse.json({ data: { features: [{ name: 'audit-logs' }], auditLogs } })","+      )","+    );","+","+  const getAdminLinkIds = async () => {","+    const { result } = renderHook(() => useSettingsMenu());","+","+    await waitFor(() => expect(result.current.isLoading).toBe(false));","+    // The EE links load asynchronously after the CE ones.","+    await waitFor(() =>","+      expect(","+        result.current.menu","+          .find((section) => section.id === 'permissions')","+          ?.links.some((link) => link.id === 'roles')","+      ).toBe(true)","+    );","+","+    return () =>","+      result.current.menu","+        .find((section) => section.id === 'permissions')","+        ?.links.map((link) => link.id) ?? [];","+  };","+","+  it('lists the audit logs link when the config keeps audit logs enabled', async () => {","+    respondWith({ enabled: true });","+","+    const adminLinkIds = await getAdminLinkIds();","+","+    await waitFor(() => expect(adminLinkIds()).toContain('auditLogs'));","+  });","+","+  it('hides the audit logs link when the config disables audit logs', async () => {","+    respondWith({ enabled: false });","+","+    const adminLinkIds = await getAdminLinkIds();","+","+    await waitFor(() => expect(adminLinkIds()).toContain('users'));","+    await waitFor(() => expect(adminLinkIds()).not.toContain('auditLogs'));","+    expect(adminLinkIds()).not.toContain('auditLogs-purchase-page');","+  });","+});"," "," describe('normalizeSettings', () => {","   it('returns a stable global section when settings are missing', () => {"],"additions":67,"deletions":1,"truncated":false},{"path":"packages/core/admin/admin/src/hooks/useSettingsMenu.ts","lines":["@@ -3,6 +3,7 @@ import * as React from 'react';"," import sortBy from 'lodash/sortBy';"," import { useSelector } from 'react-redux';"," ","+import { useIsAuditLogsDisabledByConfig } from '../../../ee/admin/src/hooks/useIsAuditLogsDisabledByConfig';"," import { SETTINGS_LINKS_CE, SettingsMenuLink } from '../constants';"," import { useAppInfo } from '../features/AppInfo';"," import { getAdminUserId, useAuth } from '../features/Auth';","@@ -102,6 +103,8 @@ const useSettingsMenu = (): {","     }","   );"," ","+  const { isDisabledByConfig: isAuditLogsDisabledByConfig } = useIsAuditLogsDisabledByConfig();","+","   const addPermissions = React.useCallback(","     (link: SettingsMenuLink) => {","       if (!link.id) {","@@ -185,7 +188,9 @@ const useSettingsMenu = (): {","       {","         id: 'permissions',","         intlLabel: { id: 'Settings.permissions', defaultMessage: 'Administration Panel' },","-        links: adminLinks.map(addPermissions),","+        links: adminLinks","+          .filter((link) => isAuditLogsDisabledByConfig === false || link.id !== 'auditLogs')","+          .map(addPermissions),","       },","       ...Object.values(otherSections),","     ]);","@@ -198,6 +203,7 @@ const useSettingsMenu = (): {","   }, [","     adminLinks,","     globalLinks,","+    isAuditLogsDisabledByConfig,","     settings,","     shouldUpdateStrapi,","     addPermissions,"],"additions":7,"deletions":1,"truncated":false},{"path":"packages/core/admin/admin/src/pages/Home/HomePage.tsx","lines":["@@ -5,6 +5,7 @@ import { Plus } from '@strapi/icons';"," import { useIntl } f