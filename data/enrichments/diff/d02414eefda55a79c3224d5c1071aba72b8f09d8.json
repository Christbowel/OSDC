kages/core/admin/admin/src/utils/tests/widgetVisibility.test.ts","lines":["@@ -1,6 +1,8 @@"," import {","+  hideAuditLogsWidgetWhenDisabled,","   hideCloudDeployMenuLinkInProduction,","   hideDeployNowWidgetInProduction,","+  AUDIT_LOGS_WIDGET_UID,","   CLOUD_DEPLOY_MENU_LINK,","   DEPLOY_NOW_WIDGET_UID,"," } from '../widgetVisibility';","@@ -43,6 +45,21 @@ describe('hideDeployNowWidgetInProduction', () => {","   });"," });"," ","+describe('hideAuditLogsWidgetWhenDisabled', () => {","+  const auditLogsWidget = createMockWidget(AUDIT_LOGS_WIDGET_UID, 'Last activity');","+  const widgetsWithAuditLogs = [...mockWidgets, auditLogsWidget];","+","+  it('removes the audit logs widget when the config disables audit logs', () => {","+    expect(hideAuditLogsWidgetWhenDisabled(widgetsWithAuditLogs, true)).toEqual(mockWidgets);","+  });","+","+  it('keeps the audit logs widget otherwise', () => {","+    expect(hideAuditLogsWidgetWhenDisabled(widgetsWithAuditLogs, false)).toEqual(","+      widgetsWithAuditLogs","+    );","+  });","+});","+"," describe('hideCloudDeployMenuLinkInProduction', () => {","   const menuLinks = [","     { to: 'plugins/upload', intlLabel: { id: 'upload', defaultMessage: 'Media Library' } },"],"additions":17,"deletions":0,"truncated":false},{"path":"packages/core/admin/admin/src/utils/widgetVisibility.ts","lines":["@@ -37,6 +37,26 @@ export const hideDeployNowWidgetInProduction = (","   return widgets.filter((widget) => widget.uid !== DEPLOY_NOW_WIDGET_UID);"," };"," ","+/**","+ * UID of the \"Last activity\" widget, which lists the latest audit logs.","+ */","+export const AUDIT_LOGS_WIDGET_UID = 'plugin::admin.audit-logs';","+","+/**","+ * Hides the audit logs widget when `admin.auditLogs.enabled: false` turns off audit logs that the","+ * license includes: the server then mounts no audit-logs route for the widget to read.","+ */","+export const hideAuditLogsWidgetWhenDisabled = (","+  widgets: WidgetWithUID[],","+  isAuditLogsDisabledByConfig: boolean","+): WidgetWithUID[] => {","+  if (isAuditLogsDisabledByConfig === false) {","+    return widgets;","+  }","+","+  return widgets.filter((widget) => widget.uid !== AUDIT_LOGS_WIDGET_UID);","+};","+"," /**","  * Hides the Strapi Cloud deploy sidebar link when the project runs in production.","  */"],"additions":20,"deletions":0,"truncated":false},{"path":"packages/core/admin/ee/admin/src/hooks/tests/useIsAuditLogsDisabledByConfig.test.ts","lines":["@@ -0,0 +1,59 @@","+import { renderHook, server, waitFor } from '@tests/utils';","+import { http, HttpResponse } from 'msw';","+","+import { useIsAuditLogsDisabledByConfig } from '../useIsAuditLogsDisabledByConfig';","+","+describe('useIsAuditLogsDisabledByConfig', () => {","+  const originalStrapi = window.strapi;","+","+  const setLicensed = (licensed: boolean) => {","+    window.strapi = {","+      ...originalStrapi,","+      features: {","+        ...originalStrapi.features,","+        isEnabled: (name?: string) => licensed === true && name === 'audit-logs',","+      },","+    };","+  };","+","+  const respondWith = (auditLogs: { enabled: boolean }) =>","+    server.use(","+      http.get('/admin/license-limit-information', () =>","+        HttpResponse.json({ data: { features: [{ name: 'audit-logs' }], auditLogs } })","+      )","+    );","+","+  afterEach(() => {","+    window.strapi = originalStrapi;","+  });","+","+  it('is true once the server reports audit logs disabled by config', async () => {","+    setLicensed(true);","+    respondWith({ enabled: false });","+","+    const { result } = renderHook(() => useIsAuditLogsDisabledByConfig());","+","+    expect(result.current.isLoading).toBe(true);","+    await waitFor(() => expect(result.current.isLoading).toBe(false));","+    expect(result.current.isDisabledByConfig).toBe(true);","+  });","+","+  it('is false when the server reports audit logs enabled', async () => {","+    setLicensed(true);","+    respondWith({ enabled: true });","+","+    const { result } = renderHook(() => useIsAuditLogsDisabledByConfig());","+","+    await waitFor(() => expect(result.current.isLoading).toBe(false));","+    expect(result.current.isDisabledByConfig).toBe(false);","+  });","+","+  it('is false without the license feature, whatever the server says', async () => {","+    setLicensed(false);","+    respondWith({ enabled: false });","+","+    const { result } = renderHook(() => useIsAuditLogsDisabledByConfig());","+","+    expect(result.current).toEqual({ isLoading: false, isDisabledByConfig: false });","+  });","+});"],"additions":59,"deletions":0,"truncated":false},{"path":"packages/core/admin/ee/admin/src/hooks/useIsAuditLogsDisabledByConfig.ts","lines":["@@ -0,0 +1,21 @@","+import { useGetLicenseLimitsQuery } from '../../../../admin/src/services/admin';","+","+/**","+ * Whether `admin.auditLogs.enabled: false` turns off audit logs that the license includes.","+ * The server then mounts no audit-logs route, so the admin hides the settings link, the settings","+ * page and the homepage widget.","+ *","+ * `window.strapi.features` only carries the license; the config state comes from the authenticated","+ * `/admin/license-limit-information`. Until that answers, the license alone decides.","+ */","+const useIsAuditLogsDisabledByConfig = (): { isLoading: boolean; isDisabledByConfig: boolean } => {","+  const isLicensed = window.strapi.features.isEnabled(window.strapi.features.AUDIT_LOGS);","+  const { data, isLoading } = useGetLicenseLimitsQuery(undefined, { skip: isLicensed === false });","+","+  return {","+    isLoading,","+    isDisabledByConfig: isLicensed === true && data?.data?.auditLogs?.enabled === false,","+  };","+};","+","+export { useIsAuditLogsDisabledByConfig };"],"additions":21,"deletions":0,"truncated":false},{"path":"packages/core/admin/ee/admin/src/pages/SettingsPage/pages/ApplicationInfoPage/components/tests/LicenseInfo.test.tsx","lines":["@@ -28,6 +28,7 @@ const baseLicense: LicenseData = {","   registrySyncErrorKind: nu