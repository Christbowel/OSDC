tif verbosity.Request.Body && isLoggableJSON(req.Header.Get(\"Content-Type\"), true) {","+\t\t\tlog.RequestBody = scim.requestBody()","+\t\t}","+\t} else if verbosity.Request.Body && req.Header.Get(\"Content-Type\") == contentTypeJSON && len(rawBody) > 0 {"," \t\tif err := json.Unmarshal(rawBody, &log.RequestBody); err != nil {"," \t\t\tlog.RequestBody = map[string]any{"," \t\t\t\tauditLogErrorKey: fmt.Sprintf(\"failed to unmarshal request body: %s\", err.Error()),","@@ -190,7 +200,7 @@ func newLog("," }"," "," func (l *logEntry) prepareResponseBody(resHeaders http.Header, body []byte) {","-\tif resHeaders.Get(\"Content-Type\") == contentTypeJSON && len(body) > 0 {","+\tif isLoggableJSON(resHeaders.Get(\"Content-Type\"), l.scim) && len(body) > 0 {"," \t\tdecompressed, err := decompressResponse(resHeaders.Get(\"Content-Encoding\"), body)"," \t\tif err != nil {"," \t\t\tl.ResponseBody = map[string]any{"],"additions":12,"deletions":2,"truncated":false},{"path":"pkg/auth/audit/middleware.go","lines":["@@ -18,9 +18,11 @@ func GetAuditLoggerMiddleware(auditLog *LoggingHandler) func(next http.Handler)"," "," \t\t\treqTimestamp := time.Now().Format(time.RFC3339)"," \t\t\tuser := getUserInfo(req)","-\t\t\tcontext := context.WithValue(req.Context(), userKeyValue, user)","-\t\t\treq = req.WithContext(context)"," \t\t\tkeepReqBody := auditLog.level >= auditlogv1.LevelRequest","+\t\t\tscim := &scimRecord{keepBody: keepReqBody}","+\t\t\tctx := context.WithValue(req.Context(), userKeyValue, user)","+\t\t\tctx = context.WithValue(ctx, scimRecordKey{}, scim)","+\t\t\treq = req.WithContext(ctx)"," \t\t\trawReqBody, userName := copyReqBody(req, keepReqBody)"," "," \t\t\t// keepResBody determines whether to buffer response bodies for audit logging.","@@ -48,7 +50,7 @@ func GetAuditLoggerMiddleware(auditLog *LoggingHandler) func(next http.Handler)"," \t\t\tif auditLog.writer.ExcludeGroups {"," \t\t\t\tauditUser.Group = nil"," \t\t\t}","-\t\t\tauditLogEntry := newLog(verbosityLevel, auditUser, req, wrappedRw, reqTimestamp, respTimestamp, rawReqBody, userName)","+\t\t\tauditLogEntry := newLog(verbosityLevel, auditUser, req, wrappedRw, reqTimestamp, respTimestamp, rawReqBody, userName, scim)"," \t\t\tauditLog.Write(auditLogEntry)"," \t\t})"," \t}"],"additions":5,"deletions":3,"truncated":false},{"path":"pkg/auth/audit/redact.go","lines":["@@ -232,6 +232,46 @@ func regexRedactor(patterns []string) (Redactor, error) {"," \t}), nil"," }"," ","+// scimPatchOpRedactor redacts the value of SCIM PATCH operations (RFC 7644 3.5.2) whose path matches patterns,","+// e.g. {\"op\": \"replace\", \"path\": \"password\", \"value\": \"...\"}. It applies only to entries marked by [CaptureSCIMRequest].","+// Rancher's SCIM server doesn't support password attributes and rejects such operations, but the body is logged anyway,","+// so a misconfigured identity provider could otherwise leak a password into the audit log.","+// Key-based redaction misses these because the attribute name is in the path value, not a key.","+// PATCH operations appear only in requests, so response bodies are left unchanged.","+func scimPatchOpRedactor(patterns []string) (Redactor, error) {","+\tregexes, err := compileRegexes(patterns)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+","+\treturn RedactFunc(func(log *logEntry) error {","+\t\tif log.scim {","+\t\t\tredactSCIMPatchOps(regexes, log.RequestBody)","+\t\t}","+\t\treturn nil","+\t}), nil","+}","+","+func redactSCIMPatchOps(patterns []*regexp.Regexp, v any) {","+\tswitch v := v.(type) {","+\tcase map[string]any:","+\t\t_, hasOp := v[\"op\"]","+\t\t_, hasValue := v[\"value\"]","+\t\tpath, isString := v[\"path\"].(string)","+\t\tif hasOp && hasValue && isString && matchesAny(path, patterns) {","+\t\t\tv[\"value\"] = redacted","+\t\t}","+","+\t\tfor _, child := range v {","+\t\t\tredactSCIMPatchOps(patterns, child)","+\t\t}","+\tcase []any:","+\t\tfor _, child := range v {","+\t\t\tredactSCIMPatchOps(patterns, child)","+\t\t}","+\t}","+}","+"," const ("," \tredactPrefix      = \"/v3/import\""," \tredactedImportUrl = redactPrefix + \"/\" + redacted"],"additions":40,"deletions":0,"truncated":false},{"path":"pkg/auth/audit/scim.go","lines":["@@ -0,0 +1,114 @@","+package audit","+","+import (","+\t\"bytes\"","+\t\"encoding/json\"","+\t\"errors\"","+\t\"fmt\"","+\t\"io\"","+\t\"mime\"","+\t\"net/http\"","+","+\t\"github.com/rancher/rancher/pkg/settings\"","+)","+","+const contentTypeSCIMJSON = \"application/scim+json\"","+","+type scimRecordKey struct{}","+","+// scimRecord holds the per-request state for SCIM requests, marked by [CaptureSCIMRequest].","+// The audit middleware stores a pointer to it in the request context.","+type scimRecord struct {","+\tkeepBody bool // Whether the audit level requires request bodies.","+","+\tmarked    bool","+\tbody      bytes.Buffer","+\tlimit     int","+\toverLimit bool","+\treadErr   error","+}","+","+// CaptureSCIMRequest marks r as a SCIM request for the audit log. The SCIM server calls it after authenticating the request.","+// If the audit level requires request bodies, it wraps r.Body so the audit log keeps a copy of up to public-api-body-limit bytes","+// as the handler reads them. The handler reads the original body unchanged.","+// It does nothing if audit logging is disabled.","+func CaptureSCIMRequest(r *http.Request) {","+\trec, ok := r.Context().Value(scimRecordKey{}).(*scimRecord)","+\tif !ok || rec.marked {","+\t\treturn","+\t}","+","+\trec.marked = true","+\tif !rec.keepBody || r.Body == nil || r.Body == http.NoBody {","+\t\treturn","+\t}","+","+\trec.limit = int(apiBodyLimit())","+\tr.Body = &scimBodyReader{ReadCloser: r.Body, rec: rec}","+}","+","+// scimBodyReader copies what the handler reads into the record.","+type scimBodyReader struct {","+\tio.ReadCloser","+\trec *scimRecord","+}","+","+func (b *scimBodyReader) Read(p []byte) (int, error) {","+\tn, err := b.ReadCloser.Read(p)","+\tb.rec.write(p[:n])","+\tif err != nil && !errors.Is(err, io.EOF) && b.rec.readErr == nil {","+\t\tb.rec.readErr = err","+\t}","+","+\treturn n, err","+}","+","+func (r *scimRecord) write(p []byte) {","+\tif room := r.limit - r.body.Len(); len(p) > room {","+\t\tr.overLimit = true","+\t\tp = p[:max(room, 0)]","+\t}","+\tr.body.Write(p)","+}","+","+// requestBody returns the request body for the audit log entry, or nil if the handler read none.","+func (r *scimRecord) requestBody() map[string]any {","+\tswitch {","+\tcase r.readErr != nil:","+\t\treturn map[string]any{auditLogErrorKey: fmt.Sprintf(\"failed to read request body: %s\", r.readErr)}","+\tcase r.overLimit:","+\t\treturn map[string]any{auditLogErrorKey: fmt.Sprintf(\"request body is larger than %d bytes\", r.limit)}","+\tcase r.body.Len() == 0:","+\t\treturn nil","+\t}","+","+\tvar body map[string]any","+\tif err := json.Unmarshal(r.body.Bytes(), &body); err != nil {","+\t\treturn map[string]any{auditLogErrorKey: fmt.Sprintf(\"failed to unmarshal request body: %s\", err)}","+\t}","+","+\treturn body","+}","+","+// isLoggableJSON reports whether a body with contentType is parsed into the audit log.","+// SCIM entries also accept the SCIM media type and media type parameters, such as charset.","+func isLoggableJSON(contentType string, scim bool) bool {","+\tif contentType == contentTypeJSON {","+\t\treturn true","+\t}","+\tif !scim {","+\t\treturn false","+\t}","+","+\tmediaType, _, err := mime.ParseMediaType(contentType)","+\treturn err == nil && (mediaType == contentTypeJSON || mediaType == contentTypeSCIMJSON)","+}","+","+func apiBodyLimit() int64 {","+\tlimit, err := settings.APIBodyLimit.GetQuantityAsInt64(1024 * 1024)","+\tif err != nil {","+\t\treturn 1024 * 1024","+\t}","+","+\treturn limit","+}"],"additions":114,"deletions":0,"truncated":false},{"path":"pkg/auth/audit/scim_test.go","lines":["@@ -0,0 +1,240 @@","+package audit","+","+import (","+\t\"encoding/json\"","+\t\"io\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"strings\"","+\t\"testing\"","+\t\"testing/iotest\"","+","+\tauditlogv1 \"github.com/rancher/rancher/pkg/apis/auditlog.cattle.io/v1\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestCaptureSCIMRequestWithoutAuditLog(t *testing.T) {","+\tt.Parallel()","+","+\treq := httptest.NewRequest(http.MethodPatch, \"/v1-scim/okta/Users/u-abc\", strings.NewReader(`{}`))","+\tbody := req.Body","+","+\tCaptureSCIMRequest(req)","+","+\tassert.True(t, body == req.Body, \"the body must not be wrapped\")","+}","+","+func TestCaptureSCIMRequest(t *testing.T) {","+\tt.Parallel()","+","+\tconst (","+\t\treqBody = `{\"schemas\":[\"urn:ietf:params:scim:api:messages:2.0:PatchOp\"],\"Operations\":[{\"op\":\"replace\",\"path\":\"active\",\"value\":false}]}`","+\t\tresBody = `{\"id\":\"u-abc\",\"active\":false}`","+\t)","+","+\ttests := []struct {","+\t\tname        string","+\t\tlevel       auditlogv1.Level","+\t\tmethod      string","+\t\tcontentType string","+\t\tmark        bool","+\t\tread        bool","+\t\twantReqBody bool","+\t\twantResBody bool","+\t}{","+\t\t{name: \"PATCH\", level: auditlogv1.LevelRequest, method: http.MethodPatch, contentType: contentTypeSCIMJSON, mark: true, read: true, wantReqBody: true},","+\t\t{name: \"PUT\", level: auditlogv1.LevelRequest, method: http.MethodPut, contentType: contentTypeSCIMJSON, mark: true, read: true, wantReqBody: true},","+\t\t{name: \"POST with charset\", level: auditlogv1.LevelRequest, method: http.MethodPost, contentType: contentTypeSCIMJSON + \"; charset=utf-8\", mark: true, read: true, wantReqBody: true},","+\t\t{name: \"PATCH with JSON\", level: auditlogv1.LevelRequest, method: http.MethodPatch, contentType: contentTypeJSON, mark: true, read: true, wantReqBody: true},","+\t\t{name: \"PUT with JSON\", level: auditlogv1.LevelRequest, method: http.MethodPut, contentType: contentTypeJSON, mark: true, read: true, wantReqBody: true},","+\t\t{name: \"response body\", level: auditlogv1.LevelRequestResponse, method: http.MethodPatch, contentType: contentTypeSCIMJSON, mark: true, read: true, wantReqBody: true, wantResBody: true},","+\t\t{name: \"below request level\", level: auditlogv1.LevelHeaders, method: http.MethodPatch, contentType: contentTypeSCIMJSON, mark: true, read: true},","+\t\t// SCIM entries log only what the handler read, not the copy the existing JSON rules read before routing.","+\t\t{name: \"body not read\", level: auditlogv1.LevelRequest, method: http.MethodPut, contentType: contentTypeJSON, mark: true},","+\t\t{name: \"other content type\", level: auditlogv1.LevelRequestResponse, method: http.MethodPatch, contentType: \"text/plain\", mark: true, read: true},","+\t\t{name: \"not marked\", level: auditlogv1.LevelRequestResponse, method: http.MethodPatch, contentType: contentTypeSCIMJSON, read: true},","+\t\t{name: \"not marked PUT with JSON\", level: auditlogv1.LevelRequest, method: http.MethodPut, contentType: contentTypeJSON, read: true, wantReqBody: true},","+\t}","+","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+","+\t\t\twriter, auditOutput := newTestAuditWriter(tt.level)","+","+\t\t\thandler := http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {","+\t\t\t\tif tt.mark {","+\t\t\t\t\tCaptureSCIMRequest(req)","+\t\t\t\t}","+\t\t\t\tif tt.read {","+\t\t\t\t\tbody, err := io.ReadAll(req.Body)","+\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\tassert.Equal(t, reqBody, string(body))","+\t\t\t\t}","+","+\t\t\t\trw.Header().Set(\"Content-Type\", tt.contentType)","+\t\t\t\trw.WriteHeader(http.StatusOK)","+\t\t\t\trw.Write([]byte(resBody))","+\t\t\t})","+","+\t\t\treq := newTestRequest(tt.method, \"/v1-scim/okta/Users/u-abc\", strings.NewReader(reqBody))","+\t\t\treq.Header.Set(\"Content-Type\", tt.contentType)","+","+\t\t\tNewAuditLogMiddleware(writer)(handler).ServeHTTP(httptest.NewRecorder(), req)","+","+\t\t\tvar entry map[string]any","+\t\t\trequire.NoError(t, json.Unmarshal(auditOutput.Bytes(), &entry))","+","+\t\t\tif tt.wantReqBody {","+\t\t\t\tvar want map[string]any","+\t\t\t\trequire.NoError(t, json.Unmarshal([]byte(reqBody), &want))","+\t\t\t\tassert.Equal(t, want, entry[\"requestBody\"])","+\t\t\t} else {","+\t\t\t\tassert.Nil(t, entry[\"requestBody\"])","+\t\t\t}","+","+\t\t\tif tt.wantResBody {","+\t\t\t\tassert.Equal(t, map[string]any{\"id\": \"u-abc\", \"active\": false}, entry[\"responseBody\"])","+\t\t\t} else {","+\t\t\t\tassert.Nil(t, entry[\"responseBody\"])","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestCaptureSCIMRequestBelowRequestLevel(t *testing.T) {","+\tt.Parallel()","+","+\twriter, _ := newTestAuditWriter(auditlogv1.LevelHeaders)","+","+\thandler := http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {","+\t\tbody := req.Body","+\t\tCaptureSCIMRequest(req)","+\t\tassert.True(t, body == req.Body, \"the body must not be wrapped below the request level\")","+\t})","+","+\treq := newTestRequest(http.MethodPatch, \"/v1-scim/okta/Users/u-abc\", strings.NewReader(`{}`))","+\treq.Header.Set(\"Content-Type\", contentTypeSCIMJSON)","+","+\tNewAuditLogMiddleware(writer)(handler).ServeHTTP(httptest.NewRecorder(), req)","+}","+","+func TestCaptureSCIMRequestOversizeBody(t *testing.T) {","+\tt.Parallel()","+","+\tconst limit = 1024 * 1024 // the default public-api-body-limit","+\trawBody := `{\"data\":\"` + strings.Repeat(\"x\", limit) + `\"}`","+","+\tt.Run(\"handler reads the whole body\", func(t *testing.T) {","+\t\tt.Parallel()","+","+\t\twriter, auditOutput := newTestAuditWriter(auditlogv1.LevelRequest)","+","+\t\tvar read []byte","+\t\thandler := http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {","+\t\t\tCaptureSCIMRequest(req)","+\t\t\tvar err error","+\t\t\tread, err = io.ReadAll(req.Body)","+\t\t\trequire.NoError(t, err)","+\t\t})","+","+\t\treq := newTestRequest(http.MethodPatch, \"/v1-scim/okta/Users/u-abc\", strings.NewReader(rawBody))","+\t\treq.Header.Set(\"Content-Type\", contentTypeSCIMJSON)","+","+\t\tNewAuditLogMiddleware(writer)(handler).ServeHTTP(httptest.NewRecorder(), req)","+","+\t\tassert.True(t, rawBody == string(read), \"handler read %d bytes, want the original %d\", len(read), len(rawBody))","+","+\t\tvar entry map[string]any","+\t\trequire.NoError(t, json.Unmarshal(auditOutput.Bytes(), &entry))","+\t\trequire.IsType(t, map[string]any{}, entry[\"requestBody\"])","+\t\tassert.Contains(t, entry[\"requestBody\"].(map[string]any)[auditLogErrorKey], \"larger than\")","+\t})","+","+\tt.Run(\"route body limit\", func(t *testing.T) {","+\t\tt.Parallel()","+","+\t\twriter, auditOutput := newTestAuditWriter(auditlogv1.LevelRequest)","+","+\t\t// The SCIM authenticator runs inside the SCIM routes' http.MaxBytesHandler.","+\t\tvar readErr error","+\t\thandler := http.MaxBytesHandler(http.HandlerFunc(func(rw http.ResponseWriter, req *http.Request) {","+\t\t\tCaptureSCIMRequest(req)","+\t\t\t_, readErr = io.ReadAll(req.Body)","+\t\t\trw.WriteHeader(http.StatusBadRequest)","+\t\t}), limit)","+","+\t\treq := newTestRequest(http.MethodPatch, \"/v1-scim/okta/Users/u-abc\", strings.NewReader(rawBody))","+\t\treq.Header.Set(\"Content-Type\", contentTypeSCIMJSON)","+","+\t\tNewAuditLogMiddleware(writer)(handler).ServeHTTP(httptest.NewRecorder(), req)","+","+\t\tvar maxBytesErr *http.MaxBytesError","+\t\tassert.ErrorAs(t, readErr, &maxBytesErr)","+","+\t\tvar entry map[string]any","+\t\trequire.NoError(t, json.Unmarshal(auditOutput.Bytes(), &entry))","+\t\trequire.IsType(t, map[string]any{}, entry[\"requestBody\"])","+\t\tassert.Contains(t, entry[\"requestBody\"].(map[string]any)[auditLogErrorKey], \"request body too large\")","+\t})","+}","+","+func TestCaptureSCIMRequestTwice(t *testing.T) {","+\tt.Parallel()","+","+\tconst reqBody = `{\"Operations\":[{\"op\":\"replace\",\"path\":\"active\",\"value\":false}]}`","+","+\twriter, auditOutput := newTestAuditWriter(auditlogv1.LevelRequest)","+","+\thandler := http.HandlerFunc(func(rw http.ResponseWriter, req *http