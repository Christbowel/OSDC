{"id":"GHSA-cq55-c7wv-pxmq","axis":"advisories","repo":"smarty-php/smarty","sha":"31e06fc087a8b5a9b236c1e5dacc1c2850a2c115","parsed":{"files":[{"path":"changelog/security-fetch-ssrf-redirect.md","lines":["@@ -0,0 +1 @@","+- Security: `{fetch}` no longer follows HTTP redirects for remote resources while a security policy is active, preventing an open redirect on a trusted host from bypassing `trusted_uri` (CWE-918 server-side request forgery)"],"additions":1,"deletions":0,"truncated":false},{"path":"src/FunctionHandler/Fetch.php","lines":["@@ -189,7 +189,22 @@ public function handle($params, Template $template) {"," \t\t\t\treturn;"," \t\t\t}"," \t\t} else {","-\t\t\t$content = @file_get_contents($params['file']);","+\t\t\tif ($protocol && isset($template->getSmarty()->security_policy)) {","+\t\t\t\t// Remote resource (e.g. https://) reached through file_get_contents().","+\t\t\t\t// isTrustedUri() only validates the initial URL, but file_get_contents()","+\t\t\t\t// follows redirects by default, so an open redirect on an otherwise","+\t\t\t\t// trusted host could be used to reach a non-trusted target (SSRF).","+\t\t\t\t// Disable redirect-following while a security policy is in effect.","+\t\t\t\t$context = stream_context_create([","+\t\t\t\t\t'http' => [","+\t\t\t\t\t\t'follow_location' => 0,","+\t\t\t\t\t\t'max_redirects' => 1,","+\t\t\t\t\t],","+\t\t\t\t]);","+\t\t\t\t$content = @file_get_contents($params['file'], false, $context);","+\t\t\t} else {","+\t\t\t\t$content = @file_get_contents($params['file']);","+\t\t\t}"," \t\t\tif ($content === false) {"," \t\t\t\tthrow new Exception(\"{fetch} cannot read resource '\" . $params['file'] . \"'\");"," \t\t\t}"],"additions":16,"deletions":1,"truncated":false},{"path":"tests/UnitTests/TemplateSource/TagTests/PluginFunction/PluginFunctionFetchTest.php","lines":["@@ -64,4 +64,93 @@ public function testFetchSecurity2()"," \t\t$this->smarty->fetch('string:{fetch file=\"/templates/../etc/passwd\"}');"," \t}"," ","+\t/**","+\t * When a security policy is in effect, {fetch} of a remote resource must not","+\t * follow redirects, otherwise an open redirect on a trusted host could be","+\t * used to bypass trusted_uri and reach an internal target (SSRF, CWE-918).","+\t */","+\tpublic function testFetchRemoteDisablesRedirectsUnderSecurity()","+\t{","+\t\tFetchContextCaptureStreamWrapper::$capturedOptions = null;","+\t\tstream_wrapper_register('ssrftest', FetchContextCaptureStreamWrapper::class);","+\t\ttry {","+\t\t\t$this->smarty->enableSecurity();","+\t\t\t$this->smarty->security_policy->trusted_uri[] = '/^ssrftest:\\/\\/allowed$/';","+","+\t\t\t$result = $this->smarty->fetch('string:{fetch file=\"ssrftest://allowed/data\"}');","+","+\t\t\t$this->assertSame('BODY', $result);","+\t\t\t$this->assertIsArray(FetchContextCaptureStreamWrapper::$capturedOptions);","+\t\t\t$this->assertArrayHasKey('http', FetchContextCaptureStreamWrapper::$capturedOptions);","+\t\t\t$this->assertSame(0, FetchContextCaptureStreamWrapper::$capturedOptions['http']['follow_location']);","+\t\t\t$this->assertLessThanOrEqual(1, FetchContextCaptureStreamWrapper::$capturedOptions['http']['max_redirects']);","+\t\t} finally {","+\t\t\tstream_wrapper_unregister('ssrftest');","+\t\t}","+\t}","+","+\t/**","+\t * Without a security policy there is no trusted_uri to bypass, so the","+\t * redirect-disabling stream context is not applied (backwards compatible).","+\t */","+\tpublic function testFetchRemoteKeepsDefaultBehaviorWithoutSecurity()","+\t{","+\t\tFetchContextCaptureStreamWrapper::$capturedOptions = null;","+\t\tstream_wrapper_register('ssrftest', FetchContextCaptureStreamWrapper::class);","+\t\ttry {","+\t\t\t$result = $this->smarty->fetch('string:{fetch file=\"ssrftest://allowed/data\"}');","+","+\t\t\t$this->assertSame('BODY', $result);","+\t\t\t$this->assertSame([], FetchContextCaptureStreamWrapper::$capturedOptions);","+\t\t} finally {","+\t\t\tstream_wrapper_unregister('ssrftest');","+\t\t}","+\t}","+","+}","+","+/**","+ * Minimal custom stream wrapper used by the fetch SSRF tests: it records the","+ * stream context options that {fetch} passes to file_get_contents() and returns","+ * a fixed body so the call succeeds without touching the network.","+ */","+class FetchContextCaptureStreamWrapper","+{","+\t/** @var resource|null populated by PHP when a context is passed */","+\tpublic $context;","+","+\t/** @var array|null options captured from the context on the last open */","+\tpublic static $capturedOptions = null;","+","+\tprivate $read = false;","+","+\tpublic function stream_open($path, $mode, $options, &$opened_path)","+\t{","+\t\tself::$capturedOptions = isset($this->context) ? stream_context_get_options($this->context) : [];","+\t\treturn true;","+\t}","+","+\tpublic function stream_read($count)","+\t{","+\t\tif ($this->read) {","+\t\t\treturn '';","+\t\t}","+\t\t$this->read = true;","+\t\treturn 'BODY';","+\t}","+","+\tpublic function stream_eof()","+\t{","+\t\treturn $this->read;","+\t}","+","+\tpublic function stream_stat()","+\t{","+\t\treturn [];","+\t}","+","+\tpublic function url_stat($path, $flags)","+\t{","+\t\treturn [];","+\t}"," }",""],"additions":89,"deletions":0,"truncated":false}],"additions":106,"deletions":1,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-09-02T12:23:40.797763+00:00"}