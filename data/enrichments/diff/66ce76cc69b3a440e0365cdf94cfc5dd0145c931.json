CASE(\"Test that a failed cached database construction releases its cache entry\", \"[api]\") {","+\tDBInstanceCache cache;","+\tDBConfig config;","+\tconfig.options.http_client_pool_capacity = 0;","+\tREQUIRE_THROWS_WITH(cache.GetOrCreateInstance(\":memory:\", config, true),","+\t                    Catch::Contains(\"HTTP client pool capacity must be at least 1\"));","+\t// the entry the failed attempt reserved is gone, otherwise the next lookup waits for it forever","+\tREQUIRE(!config.db_cache_entry);","+","+\tconfig.options.http_client_pool_capacity = DConstants::INVALID_INDEX;","+\tauto db = cache.GetOrCreateInstance(\":memory:\", config, true);","+\tREQUIRE(db);","+\tConnection con(*db);","+\tREQUIRE_NO_FAIL(con.Query(\"SELECT 42\"));","+}"],"additions":44,"deletions":0,"truncated":false},{"path":"test/api/test_extension_signature_check.cpp","lines":["@@ -0,0 +1,275 @@","+#include \"catch.hpp\"","+#include \"duckdb/common/error_data.hpp\"","+#include \"duckdb/common/file_system.hpp\"","+#include \"duckdb/common/optional_idx.hpp\"","+#include \"duckdb/main/extension_helper.hpp\"","+#include \"test_helpers.hpp\"","+","+// the last part of the test limits the threads that can start through the default thread attributes, a glibc extension","+#if defined(__linux__) && !defined(DUCKDB_NO_THREADS) && defined(__GLIBC_PREREQ)","+#if __GLIBC_PREREQ(2, 18)","+#define SIGNATURE_CHECK_TEST_HAS_DEFAULT_PTHREAD_ATTRIBUTES","+#endif","+#endif","+","+#ifdef SIGNATURE_CHECK_TEST_HAS_DEFAULT_PTHREAD_ATTRIBUTES","+#include <fstream>","+#include <mutex>","+#include <pthread.h>","+#include <sys/resource.h>","+#include <thread>","+#include <unistd.h>","+#endif","+","+using namespace duckdb;","+","+namespace {","+","+// An RSA 2048 key pair made for this test with openssl genrsa. This is the public key in the compact form that","+// CREATE EXTENSION REPOSITORY takes (base64 of the DER encoding). The private key only signed SIGNATURE_HEX below.","+constexpr const char *SIGNING_PUBLIC_KEY =","+    \"MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA4TQiDZgqbR0dQu/x9vqx+kxCQ5jJxYf75y/aHAffMGcn0W1rfwkbX+48SJu3wepD4Q\"","+    \"hBg02XYaNgnlqeMa9eYHkxo4tQ09g36c1cMNuVLvb75fG0MrZMP0GU086ydp/UbjLcRMZHUuLE8PMCOFUqrwMlt/qA82I2naNpS9Efjid/btzE\"","+    \"F/gtWUY8XyLAKRcjCupdzIaxBhwOQkeAZJrP+r9A8FdoA0TnUCauiUW4qkNq0qe2wp41R48yFuBJlX0+miJ9QaNorYkmv7kpknypZ+oEeLd3Ql\"","+    \"KPwqCCDPYc7OYkAncoOu9QIHVGC66urNqKTCMOUK8BZY8CBEAbeyUUdwIDAQAB\";","+","+// The extension buffer of the test is BUFFER_SIZE bytes, the signature in its last 256 bytes. The signed part is","+// hashed in four 1 MiB chunks (the last one 256 bytes short), one task each. Every byte of chunk k is k, so a chunk","+// hashed from the wrong offset changes the hash.","+constexpr idx_t BUFFER_SIZE = 4ULL * 1024 * 1024;","+constexpr idx_t CHUNK_SIZE = 1024ULL * 1024;","+","+// The RSASSA PKCS1 v1.5 signature of the two level hash of the signed part (sha256 of the concatenated sha256 of","+// each chunk), made with openssl pkeyutl in sign mode with the sha256 digest option","+constexpr const char *SIGNATURE_HEX =","+    \"c8d7aaeda40583aedc1948d9455d4d00ea6c1398d7ac73fb7fe4e9afc100f1c178b93810e06be899a3310f3a95e58056a79b31467643fba9\"","+    \"0f3ef18502a86b99fa1c4cbbd403df10ef255e16bb267feb2087cb529b0a47194e6bab2c16f3106d3ec96f93e949200701ce8b6c1e2db989\"","+    \"aca2e39be316c7ccd6990f3dac5c93426e389b84ecc57dc6a4eda8dc695ee3788d983e874a18dded2e293f55299ebe759a35c651ca3fc1f6\"","+    \"5e59c71d98d80a29fd5bc9cb814de18913234cb34f93696b9c0598f98a17a43a83bc74c68927bf94230c06a39ae508c6fa99d8fd18f6651f\"","+    \"cd58edcd3d6928d6552f2988071cc7d93c89bdd80e1f6c215eb085cb63c849f2\";","+","+vector<char> SignedBuffer() {","+\tvector<char> buffer(BUFFER_SIZE);","+\tfor (idx_t i = 0; i < BUFFER_SIZE; i++) {","+\t\tbuffer[i] = static_cast<char>(i / CHUNK_SIZE);","+\t}","+\tconst string hex(SIGNATURE_HEX);","+\tREQUIRE(hex.size() == 2 * ParsedExtensionMetaData::SIGNATURE_SIZE);","+\tauto signature = buffer.data() + BUFFER_SIZE - ParsedExtensionMetaData::SIGNATURE_SIZE;","+\tfor (idx_t i = 0; i < ParsedExtensionMetaData::SIGNATURE_SIZE; i++) {"],"additions":59,"deletions":0,"truncated":false}],"additions":252,"deletions":54,"truncated":true,"file_count":21},"error":null,"fetched_at":"2026-11-04T16:06:55.208373+00:00"}