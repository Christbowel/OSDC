 grants: DefaultGrants,"," ) -> Result<CheckedRevision, RegistryError> {","     let routing = stored_routing(config, next, credentials).map_err(invalid_document)?;","     pnpr_route::validate_public_routes(&routing.route_policy)","@@ -127,10 +138,14 @@ pub(crate) async fn check_revision(","     check_upstream_hosts(config, &routing, previous, next)?;","     check_public_route_hosts(config, &routing, previous, next)?;","     let vacated = check_hosted_storage(storage, previous, next).await?;","+    let seeded = match grants {","+        DefaultGrants::Seed => default_grants(next, previous),","+        DefaultGrants::Skip => Vec::new(),","+    };","     let hosted = HostedChange {","         vacated,","         bound: bound_namespaces(next),","-        seeded: default_grants(next, previous),","+        seeded,","         removed: previous","             .registry_names()","             .filter(|name| next.registry_kind(name).is_none())"],"additions":16,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/tests/grant_administration.rs","lines":["@@ -6,6 +6,8 @@ use axum::{","     http::{Request, StatusCode},"," };"," use pnpr::{Config, router_with_auth};","+use pnpr_package_name::{CanonicalPackageName, Ecosystem};","+use pnpr_storage::{HostedDocumentVersion, Storage};"," use serde_json::{Value, json};"," use std::{","     net::{Ipv4Addr, SocketAddr, SocketAddrV4},","@@ -74,7 +76,12 @@ fn public_url() -> Option<String> {"," async fn app_router(config: Config) -> axum::Router {","     let auth = crate::tokens::seeded_auth(","         &config,","-        &[(\"root\", \"secret123\"), (\"carol\", \"secret123\"), (\"bob\", \"secret123\")],","+        &[","+            (\"root\", \"secret123\"),","+            (\"alice\", \"secret123\"),","+            (\"carol\", \"secret123\"),","+            (\"bob\", \"secret123\"),","+        ],","     );","     router_with_auth(config, auth)"," }","@@ -353,6 +360,152 @@ async fn adding_a_registry_seeds_its_grant_and_removing_it_forgets_the_grant() {","     assert_eq!(shared[\"registries\"], json!([\"local\"]));"," }"," ","+async fn write_vault_package(storage: &Storage, package_name: &str) {","+    let package = CanonicalPackageName::parse(package_name, Ecosystem::Npm).unwrap();","+    let doc = format!(r#\"{{\"name\":{package_name:?},\"versions\":{{}},\"dist-tags\":{{}}}}\"#);","+    storage","+        .for_hosted(\"vault\", Ecosystem::Npm)","+        .write_hosted_document_if_current(","+            &package,","+            doc.as_bytes(),","+            Some(&HostedDocumentVersion::Unversioned),","+            None,","+        )","+        .await","+        .unwrap();","+}","+","+#[tokio::test]","+async fn restoring_a_revision_after_restricting_a_grant_never_seeds_default_grants() {","+    let dir = TempDir::new().unwrap();","+    let config = load_config(dir.path()).await;","+    let storage = Storage::from_config(&config.storage).unwrap();","+    let app = app_router(config).await;","+    let root = login(&app, \"root\").await;","+    let alice = login(&app, \"alice\").await;","+    let bob = login(&app, \"bob\").await;","+","+    let vault_registry = \"/-/pnpr/v0/admin/registries/vault\";","+    let vault_entry = json!({","+        \"type\": \"hosted\",","+        \"namespace\": \"vault\",","+        \"packages\": { \"@vault/*\": {} },","+    });","+    let (status, created) = send(&app, \"PUT\", vault_registry, Some(&root), Some(vault_entry)).await;","+    assert_eq!((status, &created[\"version\"]), (StatusCode::OK, &json!(\"2\")), \"{created}\");","+","+    let restricted = json!({","+        \"registries\": [\"vault\"],","+        \"subjects\": { \"alice\": [\"read\", \"publish\"] },","+    });","+    let (status, locked) = put_grant(&app, &root, \"vault\", restricted).await;","+    assert_eq!(status, StatusCode::OK, \"{locked}\");","+    assert_eq!(locked[\"subjects\"], json!({ \"alice\": [\"publish\", \"read\"] }));","+","+    assert_eq!(send(&app, \"DELETE\", vault_registry, Some(&root), None).await.0, StatusCode::OK);","+","+    let restore = \"/-/pnpr/v0/admin/registry-revisions/2/restore\";","+    let (status, restored) = send(&app, \"POST\", restore, Some(&root), None).await;","+    assert_eq!((status, &restored[\"version\"]), (StatusCode::OK, &json!(\"4\")), \"{restored}\");","+    assert_eq!(send(&app, \"GET\", vault_registry, Some(&root), None).await.0, StatusCode::OK);","+    write_vault_package(&storage, \"@vault/secret\").await;","+","+    let vault_grant = format!(\"{GRANTS}/vault\");","+    assert_eq!(send(&app, \"GET\", &vault_grant, Some(&root), None).await.0, StatusCode::NOT_FOUND);","+    assert!(!grant_names(&app, &root).await.contains(&\"vault\".to_string()));","+    assert_eq!(","+        send(&app, \"GET\", \"/npm/~vault/@vault/secret\", None, None).await.0,","+        StatusCode::NOT_FOUND,","+    );","+    assert_eq!(read(&app, \"/npm/~vault/@vault/secret\", &bob).await, StatusCode::NOT_FOUND);","+    let publish = crate::npm::publish_doc(\"@vault/unclaimed\", \"1.0.0\", b\"tarball-contents\");","+    assert_eq!(","+        send(&app, \"PUT\", \"/npm/~vault/@vault/unclaimed\", Some(&bob), Some(publish))","+            .await","+            .0,","+        StatusCode::NOT_FOUND,","+    );","+","+    // Admitting `$all` to another package in `vault` lifts the registry-wide 404 mask.","+    let partial = json!({","+        \"registries\": [\"vault\"],","+        \"include\": [\"@vault/open\"],","+        \"subjects\": { \"$all\": [\"read\"] },","+    });","+    assert_eq!(put_grant(&app, &root, \"vault-open\", partial).await.0, StatusCode::OK);","+    let alice_only = json!({","+        \"registries\": [\"vault\"],","+        \"subjects\": { \"alice\": [\"read\", \"publish\"] },","+    });","+    assert_eq!(put_grant(&app, &root, \"vault\", alice_only).await.0, StatusCode::OK);","+    assert_eq!(","+        send(&app, \"GET\", \"/npm/~vault/@vault/secret\", None, None).await.0,","+        StatusCode::UNAUTHORIZED,","+    );","+    assert_eq!(read(&app, \"/npm/~vault/@vault/secret\", &bob).await, StatusCode::FORBIDDEN);","+    assert_eq!(read(&app, \"/npm/~vault/@vault/secret\", &alice).await, StatusCode::OK);","+}","+","+#[tokio::test]","+async fn restoring_a_revision_after_deleting_a_grant_leaves_no_grant_while_new_registries_seed() {","+    let dir = TempDir::new().unwrap();","+    let config = load_config(dir.path()).await;","+    let storage = Storage::from_config(&config.storage).unwrap();","+    let app = app_router(config).await;","+    let root = login(&app, \"root\").await;","+    let bob = login(&app, \"bob\").await;","+","+    let vault_registry = \"/-/pnpr/v0/admin/registries/vault\";","+    let vault_entry = json!({","+        \"type\": \"hosted\",","+        \"namespace\": \"vault\",","+        \"packages\": { \"@vault/*\": {} },","+    });","+    assert_eq!(","+        send(&app, \"PUT\", vault_registry, Some(&root), Some(vault_entry)).await.0,","+        StatusCode::OK,","+    );","+    let vault_grant = format!(\"{GRANTS}/vault\");","+    assert_eq!(","+        send(&app, \"DELETE\", &vault_grant, Some(&root), None).await.0,","+        StatusCode::NO_CONTENT,","+    );","+    assert_eq!(send(&app, \"DELETE\", vault_registry, Some(&root), None).await.0, StatusCode::OK);","+","+    let restore = \"/-/pnpr/v0/admin/registry-revisions/2/restore\";","+    assert_eq!(send(&app, \"POST\", restore, Some(&root), None).await.0, StatusCode::OK);","+    write_vault_package(&storage, \"@vault/secret\").await;","+    assert_eq!(send(&app, \"GET\", &vault_grant, Some(&root), None).await.0, StatusCode::NOT_FOUND);","+    assert!(!grant_names(&app, &root).await.contains(&\"vault\".to_string()));","+    assert_eq!(","+        send(&app, \"GET\", \"/npm/~vault/@vault/secret\", None, None).await.0,","+        StatusCode::NOT_FOUND,","+    );","+","+    let new_registry = \"/-/pnpr/v0/admin/registries/new-reg\";","+    let new_entry = json!({","+        \"type\": \"hosted\",","+        \"namespace\": \"new-reg\",","+        \"packages\": { \"@new-reg/*\": {} },","+    });","+    assert_eq!(","+        send(&app, \"PUT\", new_registry, Some(&root), Some(new_entry)).await.0,","+        StatusCode::OK,","+    );","+    let (status, seeded) = send(&app, \"GET\", &format!(\"{GRANTS}/new-reg\"), Some(&root), None).await;","+    assert_eq!(status, StatusCode::OK, \"{seeded}\");","+    assert_eq!(seeded[\"registries\"], json!([\"new-reg\"]));","+    assert_eq!(seeded[\"subjects\"], json!({ \"$all\": [\"read\"], \"$owners\": [\"annotate\", \"publish\"] }));","+    let publish = crate::npm::publish_doc(\"@new-reg/pkg\", \"1.0.0\", b\"tarball-contents\");","+    assert_eq!(","+        send(&app, \"PUT\", \"/npm/~new-reg/@new-reg/pkg\", Some(&bob), Some(publish))","+            .await","+            .0,","+        StatusCode::CREATED,","+    );","+    assert_eq!(send(&app, \"GET\", \"/npm/~new-reg/@new-reg/pkg\", None, None).await.0, StatusCode::OK);","+}","+"," #[tokio::test]"," async fn a_new_process_serves_the_stored_grants() {","     let dir = TempDir::new().unwrap();"],"additions":154,"deletions":1,"truncated":false},{"path":"pnpr/crates/storage/src/database/sql/registry_graph.rs","lines":["@@ -74,7 +74,8 @@ pub struct NewRegistryGraph<'a> {","     /// Every hosted namespace the revision serves.","     pub bound: &'a [HostedNamespace],","     /// The grants of the registries the revision adds. Each is created","-    /// unless a grant already has its name.","+    /// unless a grant already has its name. Ignored when [`Self::restored_from`]","+    /// is `Some`, so restoring a revision never seeds grants.","     pub seeded: &'a [super::StoredGrant],","     /// The keys of the registries the revision removes. They leave every","     /// grant, and a grant left without a registry is removed.","@@ -186,7 +187,7 @@ impl Storage {","         let restored_from = revision.restored_from.map(to_column);","         let vacated = revision.vacated.to_vec();","         let bound = revision.bound.to_vec();","-        let grants = (revision.removed.to_vec(), revision.seeded.to_vec());","+        let grants = (revision.removed.to_vec(), seeded_grants(&revision));","         self.database.write(move |connection| {","             let transaction = WriteTransaction::begin(connection)?;","             let current = current_generation(&*transaction)?;","@@ -236,6 +237,13 @@ impl Storage {","     }"," }"," ","+fn seeded_grants(revision: &NewRegistryGraph<'_>) -> Vec<super::StoredGrant> {","+    match revision.restored_from {","+        Some(_) => Vec::new(),","+        None => revision.seeded.to_vec(),","+    }","+}","+"," /// Fence the `vacated` namespaces against publishes from replicas that still"," /// serve them, and lift the fence from every `bound` one."," fn retire_namespaces("],"additions":10,"deletions":2,"truncated":false},{"path":"pnpr/crates/storage/src/database/sql/tests/grants.rs","lines":["@@ -267,9 +267,59 @@ async fn a_graph_write_seeds_and_forgets_the_grants_of_its_registries(db: Db) {","     );"," }"," ","+async fn a_restored_graph_revision_never_seeds_grants(db: Db) {","+    let storage = storage(&db);","+    let seed = |id: &str, name: &str| StoredGrant {","+        id: id.to_string(),","+        content: content(name, &[name], &[(\"$all\", \"read\")]),","+    };","+    let initial = [seed(\"g-1\", \"local\"), seed(\"g-2\", \"corp\")];","+    assert_eq!(","+        storage","+            .write_registry_graph(None, revision(LOCAL_AND_CORP, &initial, &[]))","+            .await","+            .unwrap(),","+        RegistryGraphWrite::Written(1),","+    );","+    let removed = [\"corp\".to_string()];","+    let added = [seed(\"g-3\", \"shared\")];","+    assert_eq!(","+        storage","+            .write_registry_graph(Some(1), revision(LOCAL_AND_SHARED, &added, &removed))","+            .await","+            .unwrap(),","+        RegistryGraphWrite::Written(2),","+    );","+","+    let unseeded = [seed(\"g-4\", \"corp\")];","+    let forgotten = [\"shared\".to_string()];","+    let restored = NewRegistryGraph {","+        restored_from: Some(1),","+        ..revision(LOCAL_AND_CORP, &unseeded, &forgotten)","+    };","+    assert_eq!(","+        storage","+            .write_registry_graph(Some(2), restored)","+            .await","+            .unwrap(),","+        RegistryGraphWrite::Written(3),","+    );","+    let stored = storage","+        .read_grants(None)","+        .await","+        .unwrap()","+        .unwrap();","+    let names: Vec<String> = stored.grants","+        .into_iter()","+        .map(|grant| grant.content.name)","+        .collect();","+    assert_eq!(names, [\"local\"]);","+}","+"," conformance!(","     another_instance_reads_grants_only_after_they_change,","     a_grant_write_is_refused_on_a_stale_generation_or_a_taken_name,","     a_grant_and_the_teams_it_names_are_kept_together,","     a_graph_write_seeds_and_forgets_the_grants_of_its_registries,","+    a_restored_graph_revision_never_seeds_grants,"," );"],"additions":50,"deletions":0,"truncated":false},{"path":"pnpr/docs/configuration.md","lines":["@@ -483,7 +483,9 @@ once:"," The `local` registry pnpr stores on first start gives `read` to"," `$authenticated`, not `$all`. Nobody is given `delete` by default. Change a"," default grant like any other. Removing a registry takes it out of every grant","-and removes a grant left with no registry.","+and removes a grant left with no registry. Restoring an earlier revision","+creates no default grants, so a removed registry that a restore brings back","+serves nobody until a grant covers it."," "," ### Managing grants {#managing-grants}"," ",""],"additions":3,"deletions":1,"truncated":false}],"additions":266,"deletions":17,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-20T17:58:13.821986+00:00"}