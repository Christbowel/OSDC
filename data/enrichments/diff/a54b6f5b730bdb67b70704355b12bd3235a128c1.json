{"id":"a54b6f5b730bdb67b70704355b12bd3235a128c1","axis":"silent","repo":"pnpm/pnpm","sha":"a54b6f5b730bdb67b70704355b12bd3235a128c1","parsed":{"files":[{"path":".changeset/bright-buses-smile.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm deploy` now resolves relative `file:` overrides from the source workspace [#18191](https://github.com/pnpm/pnpm/issues/18191)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/deploy/install.rs","lines":["@@ -95,6 +95,12 @@ pub(super) fn create_deploy_install_config(","     deploy_config"," }"," ","+struct DeployInstallContext<'a> {","+    source_root: &'a Path,","+    pnpmfile_hook: Option<Arc<dyn pnpm_hooks::PnpmfileHooks>>,","+    preferred_versions_override: Option<PreferredVersions>,","+}","+"," impl DeployArgs {","     pub(super) async fn run_install_in_deploy_dir<ReporterT: Reporter + 'static>(","         &self,","@@ -133,8 +139,11 @@ impl DeployArgs {","             deploy_dir,","             legacy,","             frozen_lockfile,","-            pnpmfile_hook,","-            preferred_versions,","+            DeployInstallContext {","+                source_root: base_config.root_project_manifest_dir(deploy_dir),","+                pnpmfile_hook,","+                preferred_versions_override: preferred_versions,","+            },","         )","         .await","     }","@@ -153,9 +162,13 @@ impl DeployArgs {","         deploy_dir: &Path,","         legacy: bool,","         frozen_lockfile: bool,","-        pnpmfile_hook: Option<Arc<dyn pnpm_hooks::PnpmfileHooks>>,","-        preferred_versions_override: Option<PreferredVersions>,","+        context: DeployInstallContext<'_>,","     ) -> miette::Result<()> {","+        let DeployInstallContext {","+            source_root,","+            pnpmfile_hook,","+            preferred_versions_override,","+        } = context;","         let config = state.config;","         let workspace_projects_override = deployed_workspace_projects(state, deploy_dir, legacy);"," ","@@ -188,7 +201,7 @@ impl DeployArgs {","             base_install","         };","         if legacy {","-            install.run_legacy_deploy::<ReporterT>().await","+            install.run_legacy_deploy::<ReporterT>(source_root).await","         } else {","             install.run::<ReporterT>().await","         }"],"additions":18,"deletions":5,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/deploy/local_dependencies.rs","lines":["@@ -1,7 +1,10 @@","+use std::process::Command;","+","+use assert_cmd::assert::OutputAssertExt;","+"," use super::{","     AddMockedRegistry, CommandExtra, CommandTempCwd, append_workspace_yaml_key, fs, pacquet_cmd,"," };","-use assert_cmd::assert::OutputAssertExt;"," "," /// A `file:` dependency may live outside the lockfile directory. Install"," /// links it, so deploy copies it too.","@@ -45,3 +48,70 @@ fn deploy_copies_file_dependency_outside_the_lockfile_dir() {"," ","     drop((root, mock_instance));"," }","+","+#[test]","+fn deploy_resolves_relative_file_overrides_from_the_source_workspace() {","+    let fixture = CommandTempCwd::init().add_mocked_registry();","+    let source = &fixture.workspace;","+    let root = source.parent().unwrap();","+    let sdk = root.join(\"sdk\");","+    let common = root.join(\"common\");","+    for package in [&sdk, &common] {","+        fs::create_dir(package).unwrap();","+    }","+    fs::write(","+        source.join(\"package.json\"),","+        r#\"{\"name\":\"repro-app\",\"version\":\"1.0.0\",\"dependencies\":{\"repro-sdk\":\"file:../sdk\"}}\"#,","+    )","+    .unwrap();","+    fs::write(","+        sdk.join(\"package.json\"),","+        r#\"{\"name\":\"repro-sdk\",\"version\":\"1.0.0\",\"main\":\"index.js\",\"dependencies\":{\"repro-common\":\"1.0.0\"}}\"#,","+    )","+    .unwrap();","+    fs::write(sdk.join(\"index.js\"), \"module.exports = require('repro-common')\\n\").unwrap();","+    fs::write(","+        common.join(\"package.json\"),","+        r#\"{\"name\":\"repro-common\",\"version\":\"1.0.0\",\"main\":\"index.js\"}\"#,","+    )","+    .unwrap();","+    fs::write(common.join(\"index.js\"), \"module.exports = 42\\n\").unwrap();","+    append_workspace_yaml_key(source, \"packages\", \"[]\");","+    append_workspace_yaml_key(source, \"sharedWorkspaceLockfile\", \"false\");","+    append_workspace_yaml_key(","+        source,","+        \"overrides\",","+        \"\\n  \\\"repro-sdk>repro-common\\\": file:../common\",","+    );","+","+    pacquet_cmd(source)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let output = root.join(\"output\");","+    for (mode, extra) in [","+        (\"default\", None),","+        (\"shared\", Some(\"--config.sharedWorkspaceLockfile=true\")),","+        (\"legacy\", Some(\"--legacy\")),","+    ] {","+        let target = output.join(mode);","+        let mut deploy = pacquet_cmd(source);","+        deploy.args([\"--filter=.\", \"deploy\"]);","+        if let Some(extra) = extra {","+            deploy.arg(extra);","+        }","+        deploy.arg(&target);","+        deploy.assert().success();","+    }","+","+    fs::rename(&common, root.join(\"common-away\")).unwrap();","+    fs::rename(&sdk, root.join(\"sdk-away\")).unwrap();","+    for mode in [\"default\", \"shared\", \"legacy\"] {","+        Command::new(\"node\")","+            .current_dir(output.join(mode))","+            .args([\"-e\", \"if (require('repro-sdk') !== 42) process.exit(1)\"])","+            .assert()","+            .success();","+    }","+}"],"additions":71,"deletions":1,"truncated":false},{"path":"pnpm/crates/package-manager/src/install.rs","lines":["@@ -613,6 +613,7 @@ impl InstallSaveOptions {"," #[derive(Default)]"," pub(crate) struct InstallManifestOptions<'install> {","     pub(crate) deploy_hook: bool,","+    pub(crate) overrides_root_dir: Option<&'install Path>,","     /// pnpm's `pruneDirectDependencies`: scan each importer's