"p5\" }","+","+---","+\"Filters on ancestor levels\":","+","+  # root: term on a doc values only long","+  - do:","+      search:","+        index: books","+        body: {\"_source\": false, \"knn\": {\"field\": \"chapters.paragraphs.vector\", \"query_vector\": [0, 0], \"k\": 10, \"filter\": {\"term\": {\"pages\": 100}}, \"inner_hits\": {\"name\": \"inner\", \"size\": 10, \"_source\": true}}}","+","+  - match: { hits.total.value: 1 }","+  - match: { hits.hits.0._id: \"1\" }","+  - length: { hits.hits.0.inner_hits.inner.hits.hits: 3 }","+  - match: { hits.hits.0.inner_hits.inner.hits.hits.0._source.pid: \"p1\" }","+  - match: { hits.hits.0.inner_hits.inner.hits.hits.1._source.pid: \"p2\" }","+  - match: { hits.hits.0.inner_hits.inner.hits.hits.2._source.pid: \"p3\" }","+","+  # root: match_phrase on match_only_text","+  - do:","+      search:","+        index: books","+        body: {\"_source\": false, \"knn\": {\"field\": \"chapters.paragraphs.vector\", \"query_vector\": [0, 0], \"k\": 10, \"filter\": {\"match_phrase\": {\"summary\": \"long story\"}}, \"inner_hits\": {\"name\": \"inner\", \"size\": 10, \"_source\": true}}}","+","+  - match: { hits.total.value: 1 }","+  - match: { hits.hits.0._id: \"2\" }","+  - length: { hits.hits.0.inner_hits.inner.hits.hits: 2 }","+  - match: { hits.hits.0.inner_hits.inner.hits.hits.0._source.pid: \"p4\" }","+  - match: { hits.hits.0.inner_hits.inner.hits.hits.1._source.pid: \"p5\" }","+","+  # root: flattened","+  - do:","+      search:","+        index: books","+        body: {\"_source\": false, \"knn\": {\"field\": \"chapters.paragraphs.vector\", \"query_vector\": [0, 0], \"k\": 10, \"filter\": {\"term\": {\"tags.color\": \"green\"}}, \"inner_hits\": {\"name\": \"inner\", \"size\": 10, \"_source\": true}}}","+","+  - match: { hits.total.value: 2 }","+  - match: { hits.hits.0._id: \"1\" }","+  - length: { hits.hits.0.inner_hits.inner.hits.hits: 3 }","+  - match: { hits.hits.0.inner_hits.inner.hits.hits.0._source.pid: \"p1\" }