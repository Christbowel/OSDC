{"id":"bbd5cf689eb6f640aff49e40fa932026b6d5ef57","axis":"silent","repo":"salvo-rs/salvo","sha":"bbd5cf689eb6f640aff49e40fa932026b6d5ef57","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -16,6 +16,13 @@ The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/)."," "," ### Changed"," ","+- **Breaking:** JWT finders now use `Option<Vec<Method>>` for their public","+  `allowed_methods` field: `None` accepts every method, including extensions;","+  `Some(methods)` restricts extraction to that list. Wrap direct field assignments","+  in `Some(...)`. The existing `allowed_methods(Vec<Method>)` builder still works,","+  and an explicit empty list still disables token extraction. Mutable list access","+  turns an unrestricted finder into an explicit list of standard methods.","+"," - **Breaking:** tus `Metadata` values are now `Option<Vec<u8>>` instead of","   `Option<String>`. Use `Metadata::get_text` for strict UTF-8 access and convert","   text with `into_bytes` in custom stores and hooks. DiskStore reads previous"],"additions":7,"deletions":0,"truncated":false},{"path":"crates/jwt-auth/README.md","lines":["@@ -49,6 +49,19 @@ JWT (JSON Web Token) authentication middleware for the Salvo web framework."," - **Type-safe claims**: Decode tokens into your own custom claims structs"," - **Configurable validation**: Customize token validation rules"," ","+## HTTP method selection","+","+Token finders accept every HTTP method by default, including extension methods","+such as `PROPFIND`. Use `.allowed_methods(vec![Method::GET])` to restrict a finder;","+an explicit empty vector disables extraction for all methods.","+","+The public `allowed_methods` field is now `Option<Vec<Method>>`: `None` means","+unrestricted, and `Some(methods)` is an explicit allowlist. Wrap previous direct","+vector assignments in `Some(...)`. The builder still accepts `Vec<Method>`.","+Calling `allowed_methods_mut()` on an unrestricted finder first creates an","+explicit list of standard methods, so edits and `clear()` keep their allowlist","+semantics. Set the public field to `None` to restore unrestricted extraction.","+"," ## Installation"," "," This is an official crate, so you can enable it in `Cargo.toml`:"],"additions":13,"deletions":0,"truncated":false},{"path":"crates/jwt-auth/src/finder.rs","lines":["@@ -4,7 +4,7 @@ use salvo_core::async_trait;"," use salvo_core::http::header::{AUTHORIZATION, HeaderName};"," use salvo_core::http::{Method, Request};"," ","-use super::ALL_METHODS;","+use super::STANDARD_METHODS;"," "," /// Trait for extracting JWT tokens from HTTP requests."," ///","@@ -43,9 +43,9 @@ pub trait JwtTokenFinder: Send + Sync {"," #[derive(Eq, PartialEq, Clone, Debug)]"," #[non_exhaustive]"," pub struct HeaderFinder {","-    /// Allowed HTTP methods for which this finder should extract tokens.","-    /// If the request's method is not in this list, the finder will not attempt extraction.","-    pub allowed_methods: Vec<Method>,","+    /// Methods for token extraction: `None` accepts all methods, including extensions.","+    /// `Some(methods)` is an explicit allowlist; `Some(Vec::new())` disables extraction.","+    pub allowed_methods: Option<Vec<Method>>,"," ","     /// List of headers names to check for Bearer tokens.","     pub header_names: Vec<HeaderName>,","@@ -62,7 +62,7 @@ impl HeaderFinder {","     #[must_use]","     pub fn new() -> Self {","         Self {","-            allowed_methods: ALL_METHODS.to_vec(),","+            allowed_methods: None,","             header_names: vec![AUTHORIZATION],","         }","     }","@@ -81,16 +81,21 @@ impl HeaderFinder {","         self","     }"," ","-    /// Returns a mutable reference to the allowed HTTP methods.","+    /// Returns an explicit method allowlist for mutation.","+    ///","+    /// If unrestricted, first restricts extraction to the standard HTTP methods.","+    /// Clearing this list disables extraction. Set `allowed_methods` to `None`","+    /// to accept all methods again.","     #[inline]","     pub fn allowed_methods_mut(&mut self) -> &mut Vec<Method> {","-        &mut self.allowed_methods","+        self.allowed_methods","+            .get_or_insert_with(|| STANDARD_METHODS.to_vec())","     }","-    /// Sets the allowed HTTP methods and returns `Self`.","+    /// Restricts extraction to these methods. An empty list disables extraction.","     #[inline]","     #[must_use]","     pub fn allowed_methods(mut self, methods: Vec<Method>) -> Self {","-        self.allowed_methods = methods;","+        self.allowed_methods = Some(methods);","         self","     }","     /// Deprecated alias for [`Self::allowed_methods_mut`].","@@ -111,7 +116,11 @@ impl HeaderFinder {"," impl JwtTokenFinder for HeaderFinder {","     #[inline]","     async fn find_token(&self, req: &mut Request) -> Option<String> {","-        if self.allowed_methods.contains(req.method()) {","+        if self","+            .allowed_methods","+            .as_ref()","+            .is_none_or(|methods| methods.contains(req.method()))","+        {","             for header_name in &self.header_names {","                 if let Some(Ok(auth)) = req.headers().get(header_name).map(|auth| auth.to_str())","                     && let Some((scheme, token)) = auth.split_once(' ')","@@ -174,8 +183,9 @@ mod tests {"," #[derive(Eq, PartialEq, Clone, Default, Debug)]"," #[non_exhaustive]"," pub struct FormFinder {","-    /// Allowed HTTP methods for which this finder should extract tokens.","-    pub allowed_methods: Vec<Method>,","+    /// Methods for token extraction: `None` accepts all methods, including extensions.","+    /// `Some(methods)` is an explicit allowlist; `Some(Vec::new())` disables extraction.","+    pub allowed_methods: Option<Vec<Method>>,"," ","     /// Name of the form field containing the token.","     pub field_name: Cow<'static, str>,","@@ -186,19 +196,24 @@ impl FormFinder {","     pub fn new<T: Into<Cow<'static, str>>>(field_name: T) -> Se