   let root = tempfile::tempdir().unwrap();","+    let mut server = mockito::Server::new_async().await;","+    let _alpha = serve(&mut server, \"alpha\", &[(\"1.0\", wheel(\"alpha\", \"1.0\", \"\", &[]))]).await;","+    project(root.path(), &server.url(), &[\"alpha>=1\"]);","+    pacquet_in(root.path())","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    let current = environment(root.path());","+    let directory = current.parent().unwrap();","+    pnpm_fs::remove_symlink_dir(&directory.join(\"project\")).unwrap();","+    let older = directory.join(\"env-older\");","+    fs::create_dir(&older).unwrap();","+","+    pacquet_in(root.path())","+        .with_args([\"store\", \"prune\"])","+        .assert()","+        .success();","+    let mut expected = vec![current, older];","+    expected.sort();","+    assert_eq!(generations(root.path()), expected);","+}","+"," /// An environment rewrites each wheel's `RECORD`, so the store copy has no"," /// hard link while the environment still uses the wheel. The store is"," /// inside the project, which an npm project would not register."],"additions":119,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/cas.rs","lines":["@@ -16,6 +16,18 @@ use std::{"," };"," "," impl Config {","+    /// Keep the store stable while this operation uses it, with the","+    /// `frozenStore` lock when the store is frozen.","+    pub fn lock_store_for_use(","+        &self,","+    ) -> Result<pnpm_store_dir::StoreOperationLock, pnpm_store_dir::StoreLockError> {","+        if self.frozen_store {","+            self.store_dir.lock_for_frozen_use()","+        } else {","+            self.store_dir.lock_for_use()","+        }","+    }","+","     pub(super) fn apply_cas_layout(&mut self) {","         if self.node_linker == NodeLinker::Loaded {","             self.global_virtual_store_before_loaded.get_or_insert(self.enable_global_virtual_store);"],"additions":12,"deletions":0,"truncated":false},{"path":"