ot, &format!(r#\"{{\"files\":{{}},\"package\":\"{CHECKSUM}\"}}\"#));","     let mut forced = config.clone();","     forced.force = true;","@@ -306,9 +307,11 @@ fn crate_store_slots_are_grouped_by_name_version_and_content() {","         checksum: \"9a8e94ea7f378bd32cbbd37198a4a91436180c5bb472411e48b5ec2e2124ae9e\".to_string(),","     };"," ","+    let store_dir = StoreDir::new(PathBuf::from(\"store/v11\"));","     assert_eq!(","-        package.store_slot(std::path::Path::new(\"store/v11\")),","-        std::path::Path::new(\"store/v11\")","+        package.store_slot(&store_dir),","+        store_dir","+            .root()","             .join(\"crates\")","             .join(\"serde\")","             .join(\"1.0.228\")","@@ -498,7 +501,7 @@ async fn repairs_a_preseeded_slot_from_verified_store_metadata() {","         version: \"1.0.0\".to_string(),","         checksum: checksum.to_string(),","     };","-    let slot = package.store_slot(store_dir.root());","+    let slot = package.store_slot(store_dir);","     fs::create_dir_all(slot.join(\"src\")).unwrap();","     fs::write(slot.join(\"package.json\"), \"{}\").unwrap();","     fs::write(slot.join(\"Cargo.toml\"), \"attacker controlled\").unwrap();"],"additions":8,"deletions":5,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps/store.rs","lines":["@@ -53,12 +53,9 @@ pub(super) fn lock_config_dependency_store<Reporter: self::Reporter>(","         level: LogLevel::Debug,","         message: \"Waiting for the configuration dependency store operation lock\".to_string(),","     }));","-    let store_lock = if config.frozen_store {","-        config.store_dir.lock_for_frozen_use()","-    } else {","-        config.store_dir.lock_for_use()","-    }","-    .wrap_err(\"lock the store while installing configuration dependencies\")?;","+    let store_lock = config","+        .lock_store_for_use()","+        .wrap_err(\"lock the store while installing configuration dependencies\")?;","     Reporter::emit(&LogEvent::Global(GlobalLog {","         level: LogLevel::Debug,","         message: \"Acquired the configuration dependency store operation lock\".to_string(),"],"additions":3,"deletions":6,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/cargo_install.rs","lines":["@@ -816,6 +816,7 @@ fn install_does_not_parse_or_modify_excluded_cargo_workspaces() {"," }"," "," mod lockfile_features;","+mod store_prune;"," "," #[test]"," fn remove_aliased_crates_by_name_and_package_url() {"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/cargo_install/store_prune.rs","lines":["@@ -0,0 +1,176 @@","+//! `pnpm store prune` and the crates Cargo workspaces link from the store.","+","+use super::{","+    cargo_workspace,","+    crate_archive,","+};","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use sha2::{","+    Digest,","+    Sha256,","+};","+use std::{","+    fs,","+    path::{","+        Path,","+        PathBuf,","+    },","+    process::Command,","+};","+use tempfile::TempDir;","+","+/// A registry serving version 1.0.0 of each of `names`, and the slot each","+/// one takes in the store at `store`.","+fn serve_crates(","+    registry: &mut mockito::ServerGuard,","+    store: &Path,","+    names: &[&str],","+) -> (Vec<mockito::Mock>, Vec<PathBuf>) {","+    let mut mocks = vec![","+        registry","+            .mock(\"GET\", \"/config.json\")","+            .with_body(","+                serde_json::json!({\"dl\": format!(\"{}/dl/{{crate}}/{{version}}\", registry.url())})","+                    .to_string(),","+            )","+            .expect_at_least(0)","+            .create(),","+    ];","+    let mut slots = Vec::new();","+    for name in names {","+        let archive = crate_archive(name, \"1.0.0\");","+        let checksum = format!(\"{:x}\", Sha256::digest(&archive));","+        let entry = serde_json::json!({","+            \"name\": name,","+            \"vers\": \"1.0.0\",","+            \"deps\": [],","+            \"cksum\": checksum,","+            \"features\": {},","+            \"yanked\": false,","+            \"v\": 1,","+        });","+        mocks.push(","+            registry","+                .mock(\"GET\", format!(\"/{}/{}/{name}\", &name[..2], &name[2..4]).as_str())","+                .with_body(format!(\"{entry}\\n\"))","+                .expect_at_least(0)","+                .create(),","+        );","+        mocks.push(","+            registry","+                .mock(\"GET\", format!(\"/dl/{name}/1.0.0\").as_str())","+                .with_body(&archive)","+                .expect_at_least(0)","+                .create(),","+        );","+        slots.push(","+            store","+                .join(\"v11/crates\")","+                .join(name)","+                .join(\"1.0.0\")","+                .join(checksum),","+        );","+    }","+    (mocks, slots)","+}","+","+fn pnpm_in(dir: &Path, store: &Path, args: &[&str]) -> Command {","+    Command::cargo_bin(\"pnpm\")","+        .expect(\"find the pnpm binary\")","+        .with_current_dir(dir)","+        .with_env(\"CARGO_HOME\", store.join(\"cargo-home\"))","+        .with_env(\"PNPM_CONFIG_CACHE_DIR\", store.join(\"cache\"))","+        .with_env(\"PNPM_CONFIG_STORE_DIR\", store)","+        .with_args(args)","+}","+","+fn workspace(registry: &mockito::ServerGuard, dependencies: &str) -> TempDir {","+    cargo_workspace(&registry.url(), dependencies, \"\")","+}","+","+#[test]","+fn store_prune_removes_the_crates_only_a_removed_workspace_links() {","+    let store = TempDir::new().unwrap();","+    let mut registry = mockito::Server::new();","+    let (_mocks, slots) = serve_crates(&mut registry, store.path(), &[\"demo\", \"other\"]);","+    let kept = workspace(&registry, \"demo = \\\"1\\\"\\n\");","+    let removed = workspace(&registry, \"demo = \\\"1\\\"\\nother = \\\"1\\\"\\n\");","+    for root in [&kept, &removed] {","+        pnpm_in(root.path(), store.path(), &[\"install\"]).assert().success();","+    }","+    eprintln!(\"slots: {slots:?}\");","+    assert!(slots.iter().all(|slot| slot.is_dir()));","+    fs::remove_dir_all(removed.path()).unwrap();","+","+    let output = pnpm_in(kept.path(), store.path(), &[\"store\", \"prune\"]).output().unwrap();","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    eprintln!(\"STDERR:\\n{stderr}\");","+    assert!(output.status.success());","+    assert!(stderr.contains(\"Removed 1 unused crate\\n\"), \"{stderr}\");","+    assert!(slots[0].is_dir(), \"a crate the remaining workspace links was removed\");","+    assert!(!slots[1].exists(), \"a crate no workspace links was kept\");","+    Command::new(\"cargo\")","+        .with_current_dir(kept.path())","+        .with_env(\"CARGO_HOME\", store.path().join(\"cargo-home\"))","+        .with_args([\"check\", \"--locked\", \"--offline\"])","+        .assert()","+        .success();","+}","+","+/// An older pnpm linked crates without registering the workspace, so a","+/// crate it linked may be in use by a workspace the prune cannot find.","+#[test]","+fn store_prune_keeps_a_crate_no_registered_workspace_has_linked() {","+    let store = TempDir::new().unwrap();","+    let mut registry = mockito::Server::new();","+    let (_mocks, slots) = serve_crates(&mut registry, store.path(), &[\"demo\"]);","+    let root = workspace(&registry, \"demo = \\\"1\\\"\\n\");","+    pnpm_in(root.path(), store.path(), &[\"install\"]).assert().success();","+    let slot = &slots[0];","+    fs::remove_file(created_record(slot)).unwrap();","+    fs::remove_dir_all(root.path()).unwrap();","+","+    pnpm_in(store.path(), store.path(), &[\"store\", \"prune\"]).assert().success();","+    eprintln!(\"slot: {}\", slot.display());","+    assert!(slot.is_dir());","+}","+","+/// A workspace an older pnpm installed links crates without being","+/// registered. A crate it created stays unrecorded when a registered","+/// workspace links it too, so removing that workspace keeps the crate.","+#[test]","+fn store_prune_keeps_a_crate_an_older_pnpm_created_after_a_registered_workspace_links_it() {","+    let store = TempDir::new().unwrap();","+    let mut registry = mockito::Server::new();","+    let (_mocks, slots) = serve_crates(&mut registry, store.path(), &[\"demo\"]);","+    let older = workspace(&registry, \"demo = \\\"1\\\"\\n\");","+    pnpm_in(older.path(), store.path(), &[\"install\"]).assert().success();","+    let slot = &slots[0];","+    fs::remove_file(created_record(slot)).unwrap();","+    fs::remove_dir_all(store.path().join(\"v11/cargo-workspaces\")).unwrap();","+    let registered = workspace(&registry, \"demo = \\\"1\\\"\\n\");","+    pnpm_in(registered.path(), store.path(), &[\"install\"]).assert().success();","+    eprintln!(\"record: {}\", created_record(slot).display());","+    assert!(!created_record(slot).exists());","+    fs::remove_dir_all(registered.path()).unwrap();","+","+    pnpm_in(store.path(), store.path(), &[\"store\", \"prune\"]).assert().success();","+    eprintln!(\"slot: {}\", slot.display());","+    assert!(slot.is_dir());","+    Command::new(\"cargo\")","+        .with_current_dir(older.path())","+        .with_env(\"CARGO_HOME\", store.path().join(\"cargo-home\"))","+        .with_args([\"check\", \"--locked\", \"--offline\"])","+        .assert()","+        .success();","+}","+","+fn created_record(slot: &Path) -> PathBuf {","+    slot.with_file_name(format!(","+        \"{}.created\",","+        slot.file_name()","+            .unwrap()","+            .to_string_lossy(),","+    ))","+}"],"additions":176,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/python/environments.rs","lines":["@@ -41,6 +41,12 @@ pub(super) fn generations(root: &Path) -> Vec<PathBuf> {","         .map(fs::read_dir)","         .flat_map(Result::unwrap)","         .map(Result::unwrap)","+        .filter(|value| {","+            value","+                .file_name()","+                .to_string_lossy()","+       