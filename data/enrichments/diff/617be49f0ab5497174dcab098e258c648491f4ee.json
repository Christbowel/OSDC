Type}","+   */","+  private static Triple<Type, String, Integer> unwrapListElementType(Type listType, String parentName, int depth) {","+    Type elementType = listType;","+    String elementParentName = parentName;","+    int elementDepth = depth;","+    while (!elementType.isPrimitive() && !elementType.isRepetition(REPEATED)) {","+      elementParentName = elementType.getName();","+      elementType = elementType.asGroupType().getType(0);","+      elementDepth++;","+    }","+    if (isThreeLevelListRepeatedType(elementType, elementParentName)) {","+      elementParentName = elementType.getName();","+      elementType = elementType.asGroupType().getType(0);","+      elementDepth++;","+    }","+    return Triple.of(elementType, elementParentName, elementDepth);","+  }","+","+  /**","+   * Returns whether the repeated type of a list is the synthetic wrapper of a three-level list,","+   * rather than the element itself. Shared by {@link #unwrapListElementType} and","+   * {@link #getArrayElementColumn}, so that the vectors and the {@code ParquetField} tree pick the","+   * same element.","+   *","+   * @param parentName name of the group that contains {@code repeatedType}","+   */","+  private static boolean isThreeLevelListRepeatedType(Type repeatedType, String parentName) {","+    return !repeatedType.isPrimitive()","+        && repeatedType.getLogicalTypeAnnotation() == null","+        && repeatedType.asGroupType().getFieldCount() == 1","+        && !repeatedType.getName().equals(\"array\")","+        && !repeatedType.getName().equals(parentName + \"_tuple\");","+  }","+","   /**","    * Peels one {@code repeated group key_value} wrapper off a MAP / MULTISET physical type, matching","    * Parquet's canonical 3-level map encoding.","@@ -823,10 +881,7 @@ public static ColumnIO getArrayElementColumn(ColumnIO columnIO) {"," ","     // Three-level list: skip the synthetic `element` / `list` wrapper when present.","     if (columnIO instanceof GroupColumnIO","-        &