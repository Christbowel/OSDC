ss extends Class {","-    static {","-        this.setDefaultOptions({","-            myOption1: 'foo',","-            myOption2: 'bar'","-        });","-    }","+    static defaultOptions = {","+        myOption1: 'foo',","+        myOption2: 'bar'","+    };"," }"," "," class MyChildClass extends MyClass {","-    static {","-        this.setDefaultOptions({","-            myOption1: 'baz',","-            myOption3: 5","-        });","-    }","+    static defaultOptions = {","+        myOption1: 'baz',","+        myOption3: 5","+    };"," }"," "," const a = new MyChildClass();","@@ -57,18 +53,22 @@ a.options.myOption2; // 'bar'"," a.options.myOption3; // 5"," ```"," ","+Every instance gets its own `options` object, which inherits from the default options of its class. Changing a default later, like `Marker.defaultOptions.riseOnHover = true`, affects all instances that don't set the option themselves. `mergeOptions()` adds or changes defaults of an existing class without touching the defaults of its parent, which makes it the way to change defaults from a plugin:","+","+```js","+MyChildClass.mergeOptions({myOption4: true});","+```","+"," There's also [`Util.setOptions`](#util-setoptions), a method for"," conveniently merging options passed to constructor with the defaults"," defined in the class:"," "," ```js"," class MyClass extends Class {","-    static {","-        this.setDefaultOptions({","-            foo: 'bar',","-            bla: 5","-        });","-    }","+    static defaultOptions = {","+        foo: 'bar',","+        bla: 5","+    };"," ","     initialize(options) {","         Util.setOptions(this, options);","@@ -89,7 +89,7 @@ keys that are already used by the class in question."," @section Mixins"," @example"," ","-You can add methods and properties from other objects using the `include` method (such objects are called mixins):","+You can add methods and properties from other objects using the `include` method (such objects are called mixins). An `options` property of the mixin is merged into the default options of the class:"," "," ```js"," const MyMixin = {"],"additions":20,"deletions":20,"truncated":false},{"path":"src/core/Util.js","lines":["@@ -88,7 +88,8 @@ export function splitWords(str) {"," // Merges the given properties to the `options` of the `obj` object, returning the resulting options. See `Class options`."," export function setOptions(obj, options) {"," \tif (!Object.hasOwn(obj, 'options')) {","-\t\tobj.options = obj.options ? Object.create(obj.options) : {};","+\t\tconst defaults = getDefaultOptions(obj.constructor) ?? obj.options;","+\t\tobj.options = defaults ? Object.create(defaults) : {};"," \t}"," \tfor (const i in options) {"," \t\tif (Object.hasOwn(options, i)) {","@@ -98,6 +99,23 @@ export function setOptions(obj, options) {"," \treturn obj.options;"," }"," ","+const chainedDefaults = new WeakMap(); // class -> the defaultOptions object it was chained with","+","+// Links the `defaultOptions` of each class in the chain to its parent's, so defaults are inherited and stay live.","+// Done on first use because a static field can't do it in its initializer and stay tree-shakeable.","+function getDefaultOptions(cls) {","+\tconst defaults = cls?.defaultOptions;","+\tif (defaults && chainedDefaults.get(cls) !== defaults) {","+\t\tfor (let c = cls; c.defaultOptions; c = Object.getPrototypeOf(c)) {","+\t\t\tif (Object.hasOwn(c, 'defaultOptions')) {","+\t\t\t\tObject.setPrototypeOf(c.defaultOptions, Object.getPrototypeOf(c).defaultOptions ?? Object.prototype);","+\t\t\t}","+\t\t}","+\t\tchainedDefaults.set(cls, defaults);","+\t}","+\treturn defaults;","+}","+"," const templateRe = /\\{ *([\\w_ -]+) *\\}/g;"," "," // @function template(str: String, data: Object): String"],"additions":19,"deletions":1,"truncated":false},{"path":"src/dom/Draggable.js","lines":["@@ -21,16 +21,14 @@ import * as PointerEvents from './DomEvent.PointerEvents.js';"," "," export class Draggable extends Evented {"," ","-\tstat