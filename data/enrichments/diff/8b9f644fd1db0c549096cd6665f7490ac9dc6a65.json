S, apply_options_headers, insert_joined_header};","+use crate::method_override::TusMethodFilter;"," use crate::stores::Extension;"," use crate::{","     H_ACCESS_CONTROL_ALLOW_HEADERS, H_ACCESS_CONTROL_ALLOW_METHODS, H_ACCESS_CONTROL_MAX_AGE,","@@ -61,6 +62,14 @@ async fn options(req: &mut Request, depot: &mut Depot, res: &mut Response) {"," "," pub(crate) fn options_handler() -> Router {","     Router::new()","-        .options(options)","-        .push(Router::with_path(\"{id}\").options(options))","+        .push(","+            Router::new()","+                .filter(TusMethodFilter(Method::OPTIONS))","+                .goal(options),","+        )","+        .push(","+            Router::with_path(\"{id}\")","+                .filter(TusMethodFilter(Method::OPTIONS))","+                .goal(options),","+        )"," }"],"additions":12,"deletions":3,"truncated":false},{"path":"crates/tus/src/handlers/patch.rs","lines":["@@ -1,11 +1,12 @@"," use std::sync::Arc;"," "," use futures_util::StreamExt;","-use salvo_core::http::{HeaderValue, StatusCode};","+use salvo_core::http::{HeaderValue, Method, StatusCode};"," use salvo_core::{Depot, Request, Response, Router, handler};"," "," use crate::error::{ProtocolError, TusError};"," use crate::handlers::{apply_common_headers, finish_upload, upload_expiration};","+use crate::method_override::TusMethodFilter;"," use crate::stores::Extension;"," use crate::utils::{check_tus_version, parse_u64};"," use crate::{","@@ -303,7 +304,9 @@ async fn patch(req: &mut Request, depot: &mut Depot, res: &mut Response) {"," }"," "," pub(crate) fn patch_handler() -> Router {","-    Router::with_path(\"{id}\").patch(patch)","+    Router::with_path(\"{id}\")","+        .filter(TusMethodFilter(Method::PATCH))","+        .goal(patch)"," }"," "," #[cfg(test)]"],"additions":5,"deletions":2,"truncated":false},{"path":"crates/tus/src/handlers/post.rs","lines":["@@ -1,11 +1,12 @@"," use std::sync::Arc;"," "," use futures_util::StreamExt;","-use salvo_core::http::{HeaderValue, StatusCode};","+use salvo_core::http::{HeaderValue, Method, StatusCode};"," use salvo_core::{Depot, Request, Response, Router, handler};"," "," use crate::error::{ProtocolError, TusError};"," use crate::handlers::{Metadata, apply_common_headers, finish_upload, upload_expiration};","+use crate::method_override::TusMethodFilter;"," use crate::stores::{Extension, UploadInfo};"," use crate::utils::{check_tus_version, is_safe_upload_id, parse_u64};"," use crate::{","@@ -303,5 +304,7 @@ async fn create(req: &mut Request, depot: &mut Depot, res: &mut Response) {"," }"," "," pub(crate) fn post_handler() -> Router {","-    Router::new().post(create)","+    Router::new()","+        .filter(TusMethodFilter(Method::POST))","+        .goal(create)"," }"],"additions":5,"deletions":2,"truncated":false},{"path":"crates/tus/src/lib.rs","lines":["@@ -86,6 +86,7 @@ use crate::options::{MaxSize, TusOptions, UploadFinishPatch, UploadPatch};"," use crate::utils::normalize_path;"," "," mod handlers;","+mod method_override;"," "," /// Error types returned by the tus implementation."," pub mod error;","@@ -391,6 +392,11 @@ impl Tus {","     }"," ","     /// Builds the Salvo router that serves the configured tus endpoints.","+    ///","+    /// `X-HTTP-Method-Override` is resolved when a tus endpoint is selected,","+    /// before any service or router hoops run. Those hoops and lifecycle hooks","+    /// see the effective method. Filters outside this router still see the","+    /// original wire method; use hoops for access control by effective method.","     pub fn into_router(self) -> Router {","         let base_path = normalize_path(&self.options.path);","         if !self.options.relative_location && self.options.canonical_origin.is_none() {","@@ -411,6 +417,7 @@ impl Tus {","             .push(handlers::patch_handler())","             .push(handlers::delete_handler())","             .push(handlers::get_handler())","+            .push(method_override::invalid_override_router())","     }"," }"," "],"additions":7,"deletions":0,"truncated":false},{"path":"crates/tus/src/method_override.rs","lines":["@@ -0,0 +1,101 @@","+use std::sync::Arc;","+","+use salvo_core::http::{HeaderValue, Method, StatusCode};","+use salvo_core::routing::{Filter, FilterInfo, PathState};","+use salvo_core::{Depot, Request, Response, Router, async_trait, handler};","+","+use crate::handlers::apply_common_headers;","+use crate::utils::check_tus_version;","+use crate::{H_TUS_RESUMABLE, H_TUS_VERSION, ProtocolError, TUS_VERSION, Tus, TusError};","+","+const HEADER: &str = \"x-http-method-override\";","+","+fn effective_method(req: &Request) -> Result<Method, ()> {","+    let mut values = req.headers().get_all(HEADER).iter();","+    let Some(value) = values.next() else {","+        return Ok(req.method().clone());","+    };","+    if values.next().is_some() {","+        return Err(());","+    }","+    Method::from_bytes(value.as_bytes()).map_err(|_| ())","+}","+","+// Normalize only when the entire endpoint path matches. Routing runs before","+// hoops, so access-control hoops and the handler see the same effective method.","+// A failed match must not change the request seen by sibling application routes.","+#[derive(Debug)]","+pub(crate) struct TusMethodFilter(pub(crate) Method);","+","+#[async_trait]","+impl Filter for TusMethodFilter {","+    async fn filter(&self, req: &mut Request, state: &mut PathState<'_>) -> bool {","+        if !state.is_ended() {","+            return false;","+        }","+        let Ok(method) = effective_method(req) else {","+            return false;","+        };","+        if method != self.0 {","+            return false;","+        }","+        *req.method_mut() = method;","+        true","+    }","+","+    fn info(&self) -> FilterInfo {","+        FilterInfo::Method(self.0.clone())","+    }","+","+    fn collect_methods(&self, methods: &mut Vec<Method>) {","+        methods.push(self.0.clone());","+    }","+","+    async fn filter_for_method(","+        &self,","+        _req: &mut Request,","+        state: &mut PathState<'_>,","+        method: &Method,","+    ) -> Option<bool> {","+        Some(state.is_ended() && method == self.0)","+    }","+}","+","+#[derive(Debug)]","+struct InvalidOverride;","+","+#[async_trait]","+impl Filter for InvalidOverride {","+    async fn filter(&self, req: &mut Request, state: &mut PathState<'_>) -> bool {","+        state.is_ended() && effective_method(req).is_err()","+    }","+}","+","+#[handler]","+async fn invalid_override(req: &mut Request, depot: &mut Depot, res: &mut Response) {","+    let state = depot.get_typed::<Arc<Tus>>().expect(\"missing tus state\");","+    apply_common_headers(req, &state.options, &mut res.headers);","+    if let Err(error) = check_tus_version(","+        req.headers()","+            .get(H_TUS_RESUMABLE)","+            .and_then(|value| value.to_str().ok()),","+    ) {","+        if matches!(error, ProtocolError::UnsupportedTusVersion(_)) {","+            res.headers","+                .insert(H_TUS_VERSION, HeaderValue::from_static(TUS_VERSION));","+        }","+        res.status_code(TusError::Protocol(error).status());","+        return;","+    }","+    res.status_code(StatusCode::BAD_REQUEST);","+}","+","+pub(crate) fn invalid_override_router() -> Router {","+    Router::new()","+        .push(Router::new().filter(InvalidOverride).goal(invalid_override))","+        .push(","+            Router::with_path(\"{id}\")","+                .filter(InvalidOverride)","+                .goal(invalid_override),","+        )","+}"],"additions":101,"deletions":0,"truncated":false},{"path":"crates/tus/tests/method_override.rs","lines":["@@ -0,0 +1,170 @@","+//! Method overrides retain routing, authorization, and response semantics.","+","+use salvo_core::http::{Method, StatusCode};","+use salvo_core::test::{ResponseExt, TestClient};","+use salvo_core::{Depot, FlowCtrl, Request, Response, Router, Service, handler};","+use salvo_tus::{DiskStore, Tus};","+","+#[handler]","+async fn record_method(","+    req: &mut Request,","+    depot: &mut Depot,","+    res: &mut Response,","+    ctrl: &mut FlowCtrl,","+) {","+    let method = req.method().clone();","+    ctrl.call_next(req, depot, res).await;","+    assert_eq!(req.method(), method);","+    res.headers_mut()","+        .insert(\"x-effective-method\", method.as_str().parse().unwrap());","+}","+","+#[handler]","+async fn deny_delete(req: &mut Request, res: &mut Response, ctrl: &mut FlowCtrl) {","+    if req.method() == Method::DELETE {","+        res.status_code(StatusCode::FORBIDDEN);","+        ctrl.skip_rest();","+    }","+}","+","+#[handler]","+async fn echo_method(req: &mut Request) -> String {","+    req.method().to_string()","+}","+","+#[tokio::test]","+async fn overrides_select_endpoints_before_outer_hoops() {","+    let root = tempfile::tempdir().unwrap();","+    let tus = Tus::new()","+        .path(\"uploads\")","+        .store(DiskStore::new().disk_root(root.path()));","+    let service = Service::new(","+        Router::with_hoop(record_method)","+            .hoop(deny_delete)","+            .push(tus.clone().into_router()),","+    );","+    let response = TestClient::post(\"http://localhost/uploads\")","+        .add_header(\"Tus-Resumable\", \"1.0.0\", true)","+        .add_header(\"Upload-Length\", \"4\", true)","+        .send(&service)","+        .await;","+    assert_eq!(response.status_code, Some(StatusCode::CREATED));","+    let location = response","+        .headers()","+        .get(\"Location\")","+        .unwrap()","+        .to_str()","+        .unwrap();","+    let url = format!(\"http://localhost/{}\", location.trim_start_matches('/'));","+","+    let response = TestClient::post(&url)","+        .add_header(\"X-HTTP-Method-Override\", \"PATCH\", true)","+        .add_header(\"Tus-Resumable\", \"1.0.0\", true)","+        .add_header(\"Content-Type\", \"application/offset+octet-stream\", true)","+        .add_header(\"Upload-Offset\", \"0\", true)","+        .body(\"abc\")","+        .send(&service)","+        .await;","+    assert_eq!(response.status_code, Some(StatusCode::NO_CONTENT));","+    assert_eq!(response.headers().get(\"Upload-Offset\").unwrap(), \"3\");","+    assert_eq!(","+        response.headers().get(\"X-Effective-Method\").unwrap(),","+        \"PATCH\"","+    );","+","+    let mut response = TestClient::post(&url)","+        .add_header(\"X-HTTP-Method-Override\", \"HEAD\", true)","+        .add_header(\"Tus-Resumable\", \"1.0.0\", true)","+        .send(&service)","+        .await;","+    assert_eq!(response.status_code, Some(StatusCode::OK));","+    assert_eq!(response.headers().get(\"Upload-Offset\").unwrap(), \"3\");","+    assert_eq!(","+        response.headers().get(\"X-Effective-Method\").unwrap(),","+        \"HEAD\"","+    );","+    assert!(response.take_bytes(None).await.unwrap().is_empty());","+","+    let response = TestClient::post(&url)","+        .add_header(\"X-HTTP-Method-Override\", \"DELETE\", true)","+        .add_header(\"Tus-Resumable\", \"1.0.0\", true)","+        .send(&service)","+        .await;","+    assert_eq!(response.status_code, Some(StatusCode::FORBIDDEN));","+    assert_eq!(","+        response.headers().get(\"X-Effective-Method\").unwrap(),","+        \"DELETE\"","+    );","+    let response = TestClient::head(&url)","+        .add_header(\"Tus-Resumable\", \"1.0.0\", true)","+        .send(&service)","+        .await;","+    assert_eq!(response.status_code, Some(StatusCode::OK));","+","+    let response = TestClient::post(&url)","+        .add_header(\"X-HTTP-Method-Override\", \"DELETE\", true)","+        .add_header(\"Tus-Resumable\", \"1.0.0\", true)","+        .send(tus.into_router())","+        .await;","+    assert_eq!(response.status_code, Some(StatusCode::NO_CONTENT));","+}","+","+#[tokio::test]","+async fn malformed_unknown_and_non_tus_overrides_are_isolated() {","+    let service = Service::new(","+        Router::new()","+            .push(Tus::new().path(\"uploads\").into_router())","+            .push(Router::with_path(\"other\").post(echo_method))","+            // A prefix match without a complete tus endpoint must not mutate","+            // the method subsequently seen by this sibling application route.","+            .push(Router::with_path(\"uploads/{id}/other\").post(echo_method)),","+    );","+    for value in [\"\", \"PATCH DELETE\", \"PATCH,DELETE\"] {","+        let response = TestClient::post(\"http://localhost/uploads/upload\")","+            .add_header(\"X-HTTP-Method-Override\", value, true)","+            .add_header(\"Tus-Resumable\", \"1.0.0\", true)","+            .send(&service)","+            .await;","+        assert_eq!(response.status_code, Some(StatusCode::BAD_REQUEST));","+    }","+    let response = TestClient::post(\"http://localhost/uploads/upload\")","+        .add_header(\"X-HTTP-Method-Override\", \"PATCH\", true)","+        .add_header(\"X-HTTP-Method-Override\", \"DELETE\", false)","+        .add_header(\"Tus-Resumable\", \"1.0.0\", true)","+        .send(&service)","+        .await;","+    assert_eq!(response.status_code, Some(StatusCode::BAD_REQUEST));","+    let response = TestClient::post(\"http://localhost/uploads/upload\")","+        .add_header(\"X-HTTP-Method-Override\", \"BREW\", true)","+        .send(&service)","+        .await;","+    assert_eq!(response.status_code, Some(StatusCode::METHOD_NOT_ALLOWED));","+    let response = TestClient::post(\"http://localhost/uploads/upload\")","+        .add_header(\"X-HTTP-Method-Override\", \"PATCH\", true)","+        .add_header(\"Tus-Resumable\", \"0.9.0\", true)","+        .send(&service)","+        .await;","+    assert_eq!(response.status_code, Some(StatusCode::PRECONDITION_FAILED));","+    for path in [\"other\", \"uploads/upload/other\"] {","+        let mut response = TestClient::post(format!(\"http://localhost/{path}\"))","+            .add_header(\"X-HTTP-Method-Override\", \"DELETE\", true)","+            .send(&service)","+            .await;","+        assert_eq!(response.status_code, Some(StatusCode::OK));","+        assert_eq!(response.take_string().await.unwrap(), \"POST\");","+    }","+    let response = TestClient::post(\"http://localhost/uploads\")","+        .add_header(\"X-HTTP-Method-Override\", \"OPTIONS\", true)","+        .send(&service)","+        .await;","+    assert_eq!(response.status_code, Some(StatusCode::NO_CONTENT));","+    assert!(","+        response","+            .headers()","+            .get(\"Access-Control-Allow-Headers\")","+            .unwrap()","+            .to_str()","+            .unwrap()","+            .contains(\"X-HTTP-Method-Override\")","+    );","+}",""],"additions":170,"deletions":0,"truncated":false}],"additions":325,"deletions":14,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-10-29T15:20:46.620347+00:00"}