{"id":"f2648bdaeb9ea5b8efcaaf3ae8905095643a11ca","axis":"silent","repo":"spring-projects/spring-data-redis","sha":"f2648bdaeb9ea5b8efcaaf3ae8905095643a11ca","parsed":{"files":[{"path":"pom.xml","lines":["@@ -495,4 +495,4 @@"," \t\t\t<url>https://repo.spring.io/milestone</url>"," \t\t</repository>"," \t</repositories>","-</project>","\\ No newline at end of file","+</project>"],"additions":1,"deletions":1,"truncated":false},{"path":"src/main/antora/modules/ROOT/pages/redis/pubsub-annotated.adoc","lines":["@@ -67,6 +67,70 @@ class RedisConfiguration {"," You can customize the javadoc:org.springframework.data.redis.config.RedisListenerEndpointRegistrar[listener registrar] by implementing the `RedisListenerConfigurer` interface."," See the javadoc of classes that implement javadoc:org.springframework.data.redis.config.RedisListenerConfigurer[] for details and examples."," ","+[[redis-annotated-subscription-notifications]]","+== Subscription Notifications","+","+A bean with `@RedisListener` methods can implement javadoc:org.springframework.data.redis.connection.SubscriptionListener[] to get notified when Redis confirms the subscription to the topics of these methods.","+This is useful, for example, to publish only once the subscription is in place, as messages published before are lost.","+","+[source,java,indent=0,subs=\"verbatim,quotes\"]","+----","+@Component","+public class MyService implements SubscriptionListener {","+","+  @RedisListener(\"my-channel\")","+  public void processOrder(String data) { ... }","+","+  @RedisListener(\"my-channel\")","+  public void auditOrder(String data) { ... }","+","+  @Override","+  public void onChannelSubscribed(byte[] channel, long count) {","+    // called once for \"my-channel\"","+  }","+}","+----","+","+The bean is notified once per topic and container, regardless of how many of its methods listen to the topic.","+In the preceding example, `onChannelSubscribed` is called once, although two methods listen to `my-channel`.","+Pattern topics are reported through `onPatternSubscribed`.","+","+Redis confirms a subscription to all listeners of a topic, and the container subscribes again for each listener that is added later.","+If another listener subscribes to the same topic afterwards, for example, a second `SubscriptionListener` bean with `@RedisListener(\"my-channel\")`, the bean is notified again.","+","+Notifications are sent each time the listener endpoints start.","+They are also sent when the container recovers a lost connection and subscribes again.","+","+Forwarding applies to `@RedisListener` methods only.","+An endpoint registered through `RedisListenerConfigurer` passes its `MessageListener` to the container unchanged.","+If that listener implements `SubscriptionListener`, the container notifies it directly, once for each listener.","+","+Notifications are sent by javadoc:org.springframework.data.redis.config.SubscriptionForwardingEndpointRegistry[], the registry that `@EnableRedisListeners` registers by default.","+To opt out, declare a plain `RedisListenerEndpointRegistry` bean and pass it to the registrar through `RedisListenerConfigurer`:","+","+[source,java,indent=0,subs=\"verbatim,quotes\"]","+----","+@Configuration","+@EnableRedisListeners","+public class AppConfig implements RedisListenerConfigurer {","+","+  @Bean","+  public RedisListenerEndpointRegistry plainRegistry() {","+    return new RedisListenerEndpointRegistry();","+  }","+","+  @Override","+  public void configureRedisListeners(RedisListenerEndpointRegistrar registrar) {","+    registrar.setEndpointRegistry(plainRegistry());","+  }","+}","+----","+","+The default registry is still registered but stays unused.","+","+NOTE: The registry must be a bean, as only beans are started and stopped with the application context.","+A registry that is not a bean never subscribes its endpoints.","+"," [[redis-annotated-programmatic-registration]]"," == Programmatic Endpoint Registration"," "],"additions":64,"deletions":0,"truncated":false},{"path":"src/main/java/org/springframework/data/redis/config/AbstractRedisListenerEndpoint.java","lines":["@@ -99,16 +99,20 @@ public void start() {"," \t\tsynchronized (this.lifecycleMonitor) {"," \t\t\tif (!this.isRunning()) {"," ","-\t\t\t\tString topicName = getTopic();","-\t\t\t\tAssert.hasText(topicName, \"Topic must not be null or empty\");","-","-\t\t\t\tTopic topic = TOPIC_RESOLVER.resolveTopic(topicName);","-\t\t\t\tthis.listenerContainer.addMessageListener(this.messageListener, topic);","+\t\t\t\tthis.listenerContainer.addMessageListener(this.messageListener, resolveTopic());"," \t\t\t\tthis.running = true;"," \t\t\t}"," \t\t}"," \t}"," ","+\tTopic resolveTopic() {","+","+\t\tString topicName = getTopic();","+\t\tAssert.hasText(topicName, \"Topic must not be null or empty\");","+","+\t\treturn TOPIC_RESOLVER.resolveTopic(topicName);","+\t}","+"," \t@Override"," \tpublic void stop() {"," "],"additions":9,"deletions":5,"truncated":false},{"path":"src/main/java/org/springframework/data/redis/config/MessageHandlerMethodFactoryAware.java","lines":["@@ -0,0 +1,38 @@","+/*","+ * Copyright 2026-present the original author or authors.","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ *      https://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package org.springframework.data.redis.config;","+","+import org.springframework.beans.factory.Aware;","+import org.springframework.messaging.handler.annotation.support.MessageHandlerMethodFactory;","+","+/**","+ * Interface to be implemented by objects that need a {@link MessageHandlerMethodFactory} to invoke listener methods.","+ * <p>","+ * The factory is provided by the Redis listener infrastructure before the object is used.","+ *","+ * @author Mark Paluch","+ * @since 4.2","+ */","+public interface MessageHandlerMethodFactoryAware extends Aware {","+","+\t/**","+\t * Set the {@link MessageHandlerMethodFactory} used to create handler methods.","+\t *","+\t * @param messageHandlerMethodFactory the factory to use","+\t */","+\tvoid setMessageHandlerMethodFactory(MessageHandlerMethodFactory messageHandlerMethodFactory);","+","+}"],"additions":38,"deletions":0,"truncated":false},{"path":"src/main/java/org/springframework/data/redis/config/MethodRedisListenerEndpoint.java","lines":["@@ -34,7 +34,8 @@","  * @since 4.1","  * @see HandlerMethodMessageListenerAdapter","  */","-public class MethodRedisListenerEndpoint extends AbstractRedisListenerEndpoint {","+public class MethodRedisListenerEndpoint extends AbstractRedisListenerEndpoint","+\t\timplements MessageHandlerMethodFactoryAware {"," "," \tprivate final Object bean;"," ","@@ -95,6 +96,7 @@ public void setMostSpecificMethod(@Nullable Method mostSpecificMethod) {"," \t * Set the {@link MessageHandlerMethodFactory} to use to build the {@link InvocableHandlerMethod} responsible to"," \t * manage the invocation of this endpoint."," \t */","+\t@Override"," \tpublic void setMessageHandlerMethodFactory(MessageHandlerMethodFactory messageHandlerMethodFactory) {"," \t\tthis.messageHandlerMethodFactory = messageHandlerMethodFactory;"," \t}"],"additions":3,"deletions":1,"truncated":false},{"path":"src/main/java/org/springframework/data/redis/config/RedisListenerBootstrapConfiguration.java","lines":["@@ -28,7 +28,8 @@"," /**","  * {@code @Configuration} class that registers a {@link RedisListenerAnnotationBeanPostProcessor} bean capable of","  * processing Spring's {@link RedisListener @RedisListener} annotation. Also registers a default","- * {@link RedisListenerEndpointRegistry}.","+ * {@link RedisListenerEndpointRegistry} that forwards subscription callbacks to listener beans implementing","+ * {@link org.springframework.data.redis.connection.SubscriptionListener}.","  * <p>","  * This configuration class is automatically imported when using the {@code @EnableRedisListeners} annotation. See the","  * {@link EnableRedisListeners @EnableRedisListeners} for complete usage details.","@@ -54,7 +55,7 @@ public RedisListenerAnnotationBeanPostProcessor redisListenerAnnotationBeanPostP"," "," \t@Bean(name = RedisListenerConfigUtils.REDIS_LISTENER_ENDPOINT_REGISTRY_BEAN_NAME)"," \t@Role(BeanDefinition.ROLE_INFRASTRUCTURE)","-\tpublic RedisListenerEndpointRegistry redisListenerEndpointRegistry() {","-\t\treturn new RedisListenerEndpointRegistry();","+\tpublic SubscriptionForwardingEndpointRegistry redisListenerEndpointRegistry() {","+\t\treturn new SubscriptionForwardingEndpointRegistry();"," \t}"," }"],"additions":4,"deletions":3,"truncated":false},{"path":"src/main/java/org/springframework/data/redis/config/RedisListenerEndpointRegistrar.java","lines":["@@ -164,7 +164,7 @@ protected void registerAllEndpoints() {"," \t\tAssert.state(this.endpointRegistry != null, \"No RedisListenerEndpointRegistry set\");"," "," \t\tfor (RedisListenerEndpointDescriptor descriptor : this.redisListenerEndpointDescriptors) {","-\t\t\tif (descriptor.endpoint instanceof MethodRedisListenerEndpoint methodEndpoint) {","+\t\t\tif (descriptor.endpoint instanceof MessageHandlerMethodFactoryAware methodEndpoint) {"," \t\t\t\tmethodEndpoint.setMessageHandlerMethodFactory(getMessageHandlerMethodFactory());"," \t\t\t}"," \t\t\tthis.endpointRegistry.registerListener(descriptor.endpoint, descriptor.container);","@@ -191,7 +191,7 @@ public void registerEndpoint(RedisListenerEndpoint endpoint, RedisMessageListene"," \t\tif (this.startImmediately) {"," \t\t\tAssert.state(this.endpointRegistry != null, \"No RedisListenerEndpointRegistry set\");"," ","-\t\t\tif (endpoint instanceof MethodRedisListenerEndpoint methodEndpoint) {","+\t\t\tif (endpoint instanceof MessageHandlerMethodFactoryAware methodEndpoint) {"," \t\t\t\tmethodEndpoint.setMessageHandlerMethodFactory(getMessageHandlerMethodFactory());"," \t\t\t}"," \t\t\tthis.endpointRegistry.registerListener(endpoint, descriptor.container);"],"additions":2,"deletions":2,"truncated":false},{"path":"src/main/java/org/springframework/data/redis/config/SubscriptionForwardingEndpointRegistry.java","lines":["@@ -0,0 +1,142 @@","+/*","+ * Copyright 2026-present the original author or authors.","+ *","+ * Licensed under the Apache License, Version 2.0 (the \"License\");","+ * you may not use this file except in compliance with the License.","+ * You may obtain a copy of the License at","+ *","+ *      https://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing, software","+ * distributed under the License is distributed on an \"AS IS\" BASIS,","+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+ * See the License for the specific language governing permissions and","+ * limitations under the License.","+ */","+package org.springframework.data.redis.config;","+","+import java.util.ArrayList;","+import java.util.LinkedHashMap;","+import java.util.LinkedHashSet;","+import java.util.List;","+import java.util.Map;","+import java.util.Set;","+","+import org.jspecify.annotations.Nullable;","+","+import org.springframework.data.redis.connection.Message;","+import org.springframework.data.redis.connection.MessageListener;","+import org.springframework.data.redis.connection.SubscriptionListener;","+import org.springframework.data.redis.listener.RedisMessageListenerContainer;","+import org.springframework.data.redis.listener.Topic;","+","+/**","+ * {@link RedisListenerEndpointRegistry} that notifies listener beans implementing {@link SubscriptionListener} once per","+ * topic instead of once per registered endpoint.","+ *","+ * @author Mark Paluch","+ * @author Moritz Halbritter","+ * @since 4.2","+ */","+public class SubscriptionForwardingEndpointRegistry extends RedisListenerEndpointRegistry {","+","+\tprivate final Map<Key, SubscriptionForwarder> forwarders = new LinkedHashMap<>();","+","+\t@Override","+\tpublic void registerListener(RedisListenerEndpoint endpoint, RedisMessageListenerContainer container) {","+","+\t\tsuper.registerListener(endpoint, container);","+","+\t\tif (!(endpoint instanceof MethodRedisListenerEndpoint methodEndpoint)) {","+\t\t\treturn;","+\t\t}","+","+\t\tif (!(methodEndpoint.getBean() instanceof SubscriptionListener listener)) {","+\t\t\treturn;","+\t\t}","+","+\t\tKey key = new Key(container, listener);","+\t\tsynchronized (this.forwarders) {","+\t\t\tthis.forwarders.computeIfAbsent(key, k -> new SubscriptionForwarder(listener)).endpoints.add(methodEndpoint);","+\t\t}","+\t}","+","+\t@Override","+\tpublic void start() {","+","+\t\tsuper.start();","+","+\t\tsynchronized (this.forwarders) {","+\t\t\tthis.forwarders.forEach((key, forwarder) -> key.container().addMessageListener(forwarder, forwarder.topics()));","+\t\t}","+\t}","+","+\t@Override","+\tpublic void stop() {","+","+\t\tsuper.stop();","+","+\t\tsynchronized (this.forwarders) {","+\t\t\tthis.forwarders.forEach((key, forwarder) -> key.container().removeMessageListener(forwarder));","+\t\t}","+\t}","+","+\tprivate record Key(RedisMessageListenerContainer container, SubscriptionListener listener) {","+","+\t\t@Override","+\t\tpublic boolean equals(@Nullable Object other) {","+\t\t\treturn other instanceof Key key && this.container == key.container && this.listener == key.listener;","+\t\t}","+","+\t\t@Override","+\t\tpublic int hashCode() {","+\t\t\treturn 31 * System.identityHashCode(this.container) + System.identityHashCode(this.listener);","+\t\t}","+","+\t}","+","+\tprivate static class SubscriptionForwarder implements MessageListener, SubscriptionListener {","+","+\t\tprivate final SubscriptionListener delegate;","+","+\t\tprivate final List<AbstractRedisListenerEndpoint> endpoints = new ArrayList<>();","+","+\t\tSubscriptionForwarder(SubscriptionListener delegate) {","+\t\t\tthis.delegate = delegate;","+\t\t}","+","+\t\tSet<Topic> topics() {","+","+\t\t\tSet<Topic> topics = new LinkedHashSet<>();","+\t\t\tfor (AbstractRedisListenerEndpoint endpoint : this.endpoints) {","+\t\t\t\ttopics.add(endpoint.resolveTopic());","+\t\t\t}","+\t\t\treturn topics;","+\t\t}","+","+\t\t@Override","+\t\tpublic void onMessage(Message message, byte @Nullable [] pattern) {}","+","+\t\t@Override","+\t\tpublic void onChannelSubscribed(byte[] channel, long count) {","+\t\t\tthis.delegate.onChannelSubscribed(channel, count);","+\t\t}","+","+\t\t@Override","+\t\tpublic void onChannelUnsubscribed(byte[] channel, long count) {","+\t\t\tthis.delegate.onChannelUnsubscribed(channel, count);","+\t\t}","+","+\t\t@Override","+\t\tpublic void onPatternSubscribed(byte[] pattern, long count) {","+\t\t\tthis.delegate.onPatternSubscribed(pattern, count);","+\t\t}","+","+\t\t@Override","+\t\tpublic void onPatternUnsubscribed(byte[] pattern, long count) {","+\t\t\tthis.delegate.onPatternUnsubscribed(pattern, count);","+\t\t}","+","+\t}","+","+}"],"additions":142,"deletions":0,"truncated":false},{"path":"src/test/java/org/springframework/data/redis/annotation/RedisListenerAnnotationBeanPostProcessorIntegrationTests.java","lines":["@@ -34,7 +34,10 @@"," import org.springframework.context.annotation.Configuration;"," import org.springframework.core.env.MapPropertySource;"," import org.springframework.data.redis.connection.MessageListener;","+import org.springframework.data.redis.connection.SubscriptionListener;"," import org.springframework.data.redis.config.RedisListenerConfigUtils;","+import org.springframework.data.redis.config.RedisListenerConfigurer;","+import org.springframework.data.redis.config.RedisListenerEndpointRegistrar;"," import org.springframework.da