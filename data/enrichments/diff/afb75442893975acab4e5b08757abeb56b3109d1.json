"+func (l *capturingFolderLogger) FromContext(context.Context) log.Logger {","+\treturn l","+}","+","+func captureFolderLogs(t *testing.T) *capturingFolderLogger {","+\tt.Helper()","+\tlogger := &capturingFolderLogger{}","+\tprevious := backendLogger","+\tbackendLogger = logger","+\tt.Cleanup(func() { backendLogger = previous })","+\treturn logger","+}","+","+func TestBackendFailureRetainsDiagnosticsInLogs(t *testing.T) {","+\tlogger := captureFolderLogs(t)","+\toriginal := apierrors.NewServiceUnavailable(backendDiagnostic)","+\terr := sanitizedBackendError(context.Background(), \"moveTargetLookup\", original)","+\trequireSanitizedBackendResponse(t, err, 503, \"\")","+\trequire.Equal(t, 1, logger.ErrorLogs.Calls)","+\trequire.Equal(t, []any{\"operation\", \"moveTargetLookup\", \"error\", original}, logger.ErrorLogs.Ctx)","+}","+","+func TestParentFailuresAreLogged(t *testing.T) {","+\tfor _, forCreate := range []bool{false, true} {","+\t\tfor _, tc := range []struct {","+\t\t\tname       string","+\t\t\tobj        runtime.Object","+\t\t\terr        error","+\t\t\tlevel      string","+\t\t\tdiagnostic string","+\t\t}{","+\t\t\t{name: \"backend failure\", err: errors.New(backendDiagnostic), level: \"WARN\", diagnostic: backendDiagnostic},","+\t\t\t{name: \"missing parent\", err: apierrors.NewNotFound(schema.GroupResource{Resource: \"folders\"}, \"parent\"), level: \"DEBUG\"},","+\t\t\t{name: \"forbidden parent\", err: apierrors.NewForbidden(schema.GroupResource{Resource: \"folders\"}, \"parent\", errors.New(backendDiagnostic)), level: \"DEBUG\"},","+\t\t\t{name: \"grpc missing parent\", err: status.Error(codes.NotFound, backendDiagnostic), level: \"DEBUG\"},","+\t\t\t{name: \"wrong object type\", obj: &unstructured.Unstructured{}, level: \"ERROR\", diagnostic: \"expected folder, found: *unstructured.Unstructured\"},","+\t\t} {","+\t\t\tt.Run(fmt.Sprintf(\"%s/create=%t\", tc.name, forCreate), func(t *testing.T) {","+\t\t\t\tlogger := captureFolderLogs(t)","+\t\t\t\tctx := context.Background()","+\t\t\t\tstore := grafanarest.NewMockStorage(t)","+\t\t\t\tstore.On(\"Get\", mock.Anything, \"parent\", mock.Anything).Return(tc.obj, tc.err).Once()","+\t\t\t\t_, _ = newParentsGetterWithPolicy(store, forCreate)(ctx, ancestryTestFolder(\"child\", \"parent\"))","+\t\t\t\tlevel := tc.level","+\t\t\t\tif forCreate && level == \"WARN\" {","+\t\t\t\t\tlevel = \"ERROR\"","+\t\t\t\t}","+\t\t\t\trecords := map[string]logtest.Logs{\"DEBUG\": logger.DebugLogs, \"WARN\": logger.WarnLogs, \"ERROR\": logger.ErrorLogs}","+\t\t\t\trequire.Equal(t, 1, records[level].Calls)","+\t\t\t\trequire.Equal(t, 1, logger.DebugLogs.Calls+logger.WarnLogs.Calls+logger.ErrorLogs.Calls)","+\t\t\t\trecord := make(map[string]any)","+\t\t\t\tfields := records[level].Ctx","+\t\t\t\tfor i := 0; i < len(fields); i += 2 {","+\t\t\t\t\trecord[fields[i].(string)] = fields[i+1]","+\t\t\t\t}","+\t\t\t\trequire.Equal(t, \"parentLookup\", record[\"operation\"])","+\t\t\t\trequire.Equal(t, \"parent\", record[\"parent\"])","+\t\t\t\trequire.Equal(t, \"child\", record[\"folder\"])","+\t\t\t\tif tc.err != nil {","+\t\t\t\t\trequire.Equal(t, tc.err, record[\"error\"])","+\t\t\t\t} else {","+\t\t\t\t\trequire.EqualError(t, record[\"error\"].(error), tc.diagnostic)","+\t\t\t\t}","+\t\t\t})","+\t\t}","+\t}","+}","+","+func TestExpectedParentFailuresDoNotMarkTraceAsFailed(t *testing.T) {","+\tfor _, lookupErr := range []error{","+\t\tapierrors.NewNotFound(schema.GroupResource{Resource: \"folders\"}, \"parent\"),","+\t\tapierrors.NewForbidden(schema.GroupResource{Resource: \"folders\"}, \"parent\", errors.New(\"denied\")),","+\t} {","+\t\tt.Run(lookupErr.Error(), func(t *testing.T) {","+\t\t\tctx, recorder, _ := newFolderTrace(t)","+\t\t\tstore := grafanarest.NewMockStorage(t)","+\t\t\tstore.On(\"Get\", mock.Anything, \"parent\", mock.Anything).Return(nil, lookupErr).Once()","+\t\t\tinfo, err := newParentsGetter(store)(ctx, ancestryTestFolder(\"child\", \"parent\"))","+\t\t\trequire.NoError(t,