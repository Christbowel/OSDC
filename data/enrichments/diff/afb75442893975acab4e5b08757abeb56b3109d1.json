{"id":"afb75442893975acab4e5b08757abeb56b3109d1","axis":"silent","repo":"grafana/grafana","sha":"afb75442893975acab4e5b08757abeb56b3109d1","parsed":{"files":[{"path":"pkg/registry/apis/folders/backend_errors.go","lines":["@@ -0,0 +1,67 @@","+package folders","+","+import (","+\t\"context\"","+\t\"net/http\"","+","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+","+\tfoldererrors \"github.com/grafana/grafana/pkg/api/apierrors\"","+\t\"github.com/grafana/grafana/pkg/infra/log\"","+)","+","+var backendLogger log.Logger = log.New(\"folders\")","+","+// Backend statuses may contain diagnostics even when they are already Kubernetes","+// errors. Retain only classification and retry hints, not messages or identities.","+func backendStatusError(err error) apierrors.StatusError {","+\tmapped := foldererrors.ToFolderStatusError(err)","+\tcode := int(mapped.ErrStatus.Code)","+\tswitch {","+\tcase apierrors.IsNotFound(&mapped):","+\t\tcode = http.StatusNotFound","+\tcase apierrors.IsForbidden(&mapped):","+\t\tcode = http.StatusForbidden","+\t}","+\tif code < 400 || code > 599 {","+\t\tcode = http.StatusInternalServerError","+\t}","+\tretryAfter := 0","+\tif details := mapped.ErrStatus.Details; details != nil && details.RetryAfterSeconds > 0 {","+\t\tretryAfter = int(details.RetryAfterSeconds)","+\t}","+\tpublic := apierrors.NewGenericServerResponse(code, \"\", schema.GroupResource{}, \"\", \"\", retryAfter, false)","+\tif code == http.StatusForbidden && public.ErrStatus.Message == \"\" {","+\t\tpublic.ErrStatus.Message = \"Access denied\"","+\t}","+\t// Retry classification can differ from the HTTP code's default reason;","+\t// ServerTimeout, for example, uses 500 but must remain retryable.","+\tswitch mapped.ErrStatus.Reason {","+\tcase metav1.StatusReasonUnknown:","+\t\t// Keep the classification derived from the HTTP code when no reason is supplied.","+\tcase metav1.StatusReasonUnauthorized, metav1.StatusReasonForbidden,","+\t\tmetav1.StatusReasonNotFound, metav1.StatusReasonAlreadyExists,","+\t\tmetav1.StatusReasonConflict, metav1.StatusReasonGone,","+\t\tmetav1.StatusReasonInvalid, metav1.StatusReasonServerTimeout,","+\t\tmetav1.StatusReasonStoreReadError, metav1.StatusReasonTimeout,","+\t\tmetav1.StatusReasonTooManyRequests, metav1.StatusReasonBadRequest,","+\t\tmetav1.StatusReasonMethodNotAllowed, metav1.StatusReasonNotAcceptable,","+\t\tmetav1.StatusReasonRequestEntityTooLarge, metav1.StatusReasonUnsupportedMediaType,","+\t\tmetav1.StatusReasonInternalError, metav1.StatusReasonExpired,","+\t\tmetav1.StatusReasonServiceUnavailable:","+\t\tpublic.ErrStatus.Reason = mapped.ErrStatus.Reason","+\t}","+\tif code == 499 {","+\t\tpublic.ErrStatus.Message = \"Request canceled\"","+\t\tpublic.ErrStatus.Reason = \"ClientClosedRequest\"","+\t}","+\treturn *public","+}","+","+func sanitizedBackendError(ctx context.Context, operation string, err error) error {","+\tbackendLogger.FromContext(ctx).Error(\"Folder backend operation failed\", \"operation\", operation, \"error\", err)","+\tpublic := backendStatusError(err)","+\treturn &public","+}"],"additions":67,"deletions":0,"truncated":false},{"path":"pkg/registry/apis/folders/backend_errors_test.go","lines":["@@ -0,0 +1,366 @@","+package folders","+","+import (","+\t\"bytes\"","+\t\"context\"","+\t\"encoding/json\"","+\t\"errors\"","+\t\"fmt\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"testing\"","+","+\tgokitlog \"github.com/go-kit/log\"","+\t\"github.com/stretchr/testify/mock\"","+\t\"github.com/stretchr/testify/require\"","+\totelcodes \"go.opentelemetry.io/otel/codes\"","+\t\"google.golang.org/grpc/codes\"","+\t\"google.golang.org/grpc/status\"","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured\"","+\t\"k8s.io/apimachinery/pkg/runtime\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+\t\"k8s.io/apiserver/pkg/admission\"","+\t\"k8s.io/apiserver/pkg/endpoints/handlers/responsewriters\"","+\t\"k8s.io/client-go/kubernetes/scheme\"","+","+\tauthlib \"github.com/grafana/authlib/types\"","+\tfolderv1 \"github.com/grafana/grafana/apps/folder/pkg/apis/folder/v1\"","+\tgrafanarest \"github.com/grafana/grafana/pkg/apiserver/rest\"","+\t\"github.com/grafana/grafana/pkg/infra/log\"","+\t\"github.com/grafana/grafana/pkg/infra/log/logtest\"","+\t\"github.com/grafana/grafana/pkg/storage/unified/resourcepb\"","+)","+","+const backendDiagnostic = \"PRIVATE_BACKEND_DIAGNOSTIC\"","+","+func requireSanitizedBackendResponse(t *testing.T, err error, code int, retry string) {","+\tt.Helper()","+\trequire.Error(t, err)","+\tw := httptest.NewRecorder()","+\tresponsewriters.ErrorNegotiated(err, scheme.Codecs, schema.GroupVersion{Version: \"v1\"}, w, httptest.NewRequest(http.MethodPost, \"/folders\", nil))","+\trequire.Equal(t, code, w.Code)","+\trequire.Equal(t, retry, w.Header().Get(\"Retry-After\"))","+\trequire.NotContains(t, w.Body.String(), backendDiagnostic)","+\tif code == http.StatusForbidden {","+\t\tvar public metav1.Status","+\t\trequire.NoError(t, json.Unmarshal(w.Body.Bytes(), &public))","+\t\trequire.Equal(t, \"Access denied\", public.Message)","+\t\trequire.Equal(t, metav1.StatusReasonForbidden, public.Reason)","+\t}","+}","+","+func TestCreateSanitizesBackendServerErrors(t *testing.T) {","+\tdetailed := &apierrors.StatusError{ErrStatus: metav1.Status{","+\t\tCode: 503, Reason: metav1.StatusReasonServiceUnavailable, Message: backendDiagnostic,","+\t\tDetails: &metav1.StatusDetails{Name: backendDiagnostic, Group: backendDiagnostic, Kind: backendDiagnostic, UID: backendDiagnostic, RetryAfterSeconds: 7,","+\t\t\tCauses: []metav1.StatusCause{{Field: backendDiagnostic, Message: backendDiagnostic}}},","+\t}}","+\tfor _, tc := range []struct {","+\t\tname  string","+\t\terr   error","+\t\tcode  int","+\t\tretry string","+\t}{","+\t\t{\"internal\", apierrors.NewInternalError(errors.New(backendDiagnostic)), 500, \"\"},","+\t\t{\"detailed unavailable\", detailed, 503, \"7\"},","+\t\t{\"transport\", status.Error(codes.Unavailable, backendDiagnostic), 503, \"\"},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tstore := grafanarest.NewMockStorage(t)","+\t\t\tstore.On(\"Create\", mock.Anything, mock.Anything, mock.Anything, mock.Anything).Return(nil, tc.err).Once()","+\t\t\tfs := folderStorage{store: store}","+\t\t\t_, err := fs.Create(context.Background(), ancestryTestFolder(\"child\", \"\"), nil, &metav1.CreateOptions{})","+\t\t\trequireSanitizedBackendResponse(t, err, tc.code, tc.retry)","+\t\t})","+\t}","+\trequire.Equal(t, backendDiagnostic, detailed.ErrStatus.Message)","+\trequire.Equal(t, backendDiagnostic, detailed.ErrStatus.Details.Name)","+}","+","+func TestBackendServerTimeoutRetainsRetryClassification(t *testing.T) {","+\tfor _, wrapped := range []bool{false, true} {","+\t\tfor _, boundary := range []string{\"create\", \"move\"} {","+\t\t\tt.Run(fmt.Sprintf(\"%s/wrapped=%t\", boundary, wrapped), func(t *testing.T) {","+\t\t\t\tvar original error = apierrors.NewServerTimeout(schema.GroupResource{Group: backendDiagnostic, Resource: backendDiagnostic}, backendDiagnostic, 7)","+\t\t\t\tif wrapped {","+\t\t\t\t\toriginal = fmt.Errorf(\"%s: %w\", backendDiagnostic, original)","+\t\t\t\t}","+\t\t\t\tstore := grafanarest.NewMockStorage(t)","+\t\t\t\tvar err error","+\t\t\t\tif boundary == \"create\" {","+\t\t\t\t\tstore.On(\"Create\", mock.Anything, mock.Anything, mock.Anything, mock.Anything).Return(nil, original).Once()","+\t\t\t\t\tfs := folderStorage{store: store}","+\t\t\t\t\t_, err = fs.Create(context.Background(), ancestryTestFolder(\"child\", \"\"), nil, &metav1.CreateOptions{})","+\t\t\t\t} else {","+\t\t\t\t\tstore.On(\"Get\", mock.Anything, \"new-parent\", mock.Anything).Return(nil, original).Once()","+\t\t\t\t\tb := &FolderAPIBuilder{storage: store, parents: newParentsGetter(store), maxNestedFolderDepth: 5}","+\t\t\t\t\told := ancestryTestFolder(\"child\", \"\")","+\t\t\t\t\tobj := ancestryTestFolder(\"child\", \"new-parent\")","+\t\t\t\t\terr = b.Validate(ancestryTestContext(t, \"org-42\", false), admission.NewAttributesRecord(","+\t\t\t\t\t\tobj, old, folderv1.SchemeGroupVersion.WithKind(\"Folder\"), \"org-42\", obj.Name,","+\t\t\t\t\t\tfolderv1.SchemeGroupVersion.WithResource(\"folders\"), \"\", admission.Update, nil, false, nil,","+\t\t\t\t\t), nil)","+\t\t\t\t}","+\t\t\t\trequireSanitizedBackendResponse(t, err, 500, \"7\")","+\t\t\t\trequire.True(t, apierrors.IsServerTimeout(err), \"provisioning must recognize the error as retryable\")","+\t\t\t\trequire.Equal(t, metav1.StatusReasonServerTimeout, responsewriters.ErrorToAPIStatus(err).Reason)","+\t\t\t})","+\t\t}","+\t}","+}","+","+func TestCreationLookupServerMessagesRemainCompatible(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tcode    int","+\t\tmessage string","+\t}{","+\t\t{500, \"an error on the server (\\\"\\\") has prevented the request from succeeding\"},","+\t\t{503, \"the server is currently unable to handle the request\"},","+\t\t{504, \"the server was unable to return a response in the time allotted, but may still be processing the request\"},","+\t} {","+\t\tfor _, wrapped := range []bool{false, true} {","+\t\t\tt.Run(fmt.Sprintf(\"%d/wrapped=%t\", tc.code, wrapped), func(t *testing.T) {","+\t\t\t\tstore := grafanarest.NewMockStorage(t)","+\t\t\t\tstore.On(\"Get\", mock.Anything, \"C\", mock.Anything).Return(nil, &apierrors.StatusError{ErrStatus: metav1.Status{Code: int32(tc.code), Message: backendDiagnostic}}).Once()","+\t\t\t\terr := validateAncestryTestCreateThroughStorage(ancestryTestContext(t, \"org-42\", false), store, 5, false, ancestryTestStorageWrapper(t, wrapped))","+\t\t\t\trequire.Error(t, err)","+\t\t\t\trequire.Equal(t, tc.message, responsewriters.ErrorToAPIStatus(err).Message)","+\t\t\t})","+\t\t}","+\t}","+}","+","+func TestBackendStatusReasonAll