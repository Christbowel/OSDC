 .build(),","+            );","+        }","+        \"/jar-remove\" => {","+            res.cookies_mut().remove(Cookie::new(RAW, \"\"));","+        }","+        \"/update\" => {","+            res.add_header(SET_COOKIE, format!(\"{RAW}=stale; Path=/\"), false)","+                .unwrap();","+            res.add_header(","+                SET_COOKIE,","+                \"name%2520with%2520spaces=unrelated; Path=/\",","+                false,","+            )","+            .unwrap();","+            res.add_cookie(Cookie::build((RAW, \"new value;100%\")).path(\"/\").build());","+        }","+        _ => unreachable!(),","+    }","+    res.render(\"done\");","+}","+","+#[tokio::test]","+async fn all_removal_apis_expire_the_actual_wire_cookie() {","+    let service = Service::new(Router::with_path(\"{action}\").goal(mutate));","+    for path in [\"remove\", \"remove-with\", \"jar-remove\"] {","+        let response = TestClient::get(format!(\"https://example.test/{path}\"))","+            .add_header(\"cookie\", format!(\"{RAW}=old%20value\"), true)","+            .send(&service)","+            .await;","+        let fields: Vec<_> = response.headers().get_all(SET_COOKIE).iter().collect();","+        assert_eq!(fields.len(), 1);","+        let wire = fields[0].to_str().unwrap();","+        assert!(wire.starts_with(&format!(\"{RAW}=;\")), \"{wire}\");","+        assert!(wire.contains(\"Max-Age=0\"), \"{wire}\");","+        if path == \"remove-with\" {","+            assert!(wire.contains(\"Path=/\"));","+            assert!(wire.contains(\"Domain=example.test\"));","+        }","+    }","+}","+","+#[tokio::test]","+async fn updates_replace_only_matching_wire_identity_and_encode_the_value() {","+    let service = Service::new(Router::with_path(\"{action}\").goal(mutate));","+    let response = TestClient::get(\"https://example.test/update\")","+        .add_header(\"cookie\", format!(\"{RAW}=old%20value\"), true)","+        .send(&service)","+        .await;","+    let fields: Vec<_> = response","+        .headers()","+        .get_all(SET_COOKIE)","+        .iter()","+        .map(|field| field.to_str().unwrap())","+        .collect();","+    assert_eq!(fields.len(), 2);","+    assert!(fields.contains(&\"name%2520with%2520spaces=unrelated; Path=/\"));","+    assert!(fields.contains(&\"name%20with%20spaces=new%20value%3B100%25; Path=/\"));","+    let serialized = response.into_hyper();","+    assert_eq!(serialized.headers().get_all(SET_COOKIE).iter().count(), 2);","+}","+","+#[test]","+fn new_legal_names_are_wire_tokens_while_invalid_names_keep_escaping() {","+    let mut response = Response::new();","+    response.add_cookie(Cookie::new(\"literal%23^|`\", \"a value\"));","+    response.add_cookie(Cookie::new(\"legacy name\", \"another value\"));","+    let response = response.into_hyper();","+    let fields: Vec<_> = response","+        .headers()","+        .get_all(SET_COOKIE)","+        .iter()","+        .map(|field| field.to_str().unwrap())","+        .collect();","+    assert!(fields.contains(&\"literal%23^|`=a%20value\"));","+    assert!(fields.contains(&\"legacy%20name=another%20value\"));","+}","+","+#[test]","+fn imported_cookie_mutations_preserve_encoded_neighbors_and_attributes() {","+    for target in [\"name%20with%20spaces\", \"name%2520with%2520spaces\"] {","+        let mut source = hyper::Response::new(salvo_core::http::ResBody::None);","+        for name in [\"name%20with%20spaces\", \"name%2520with%2520spaces\"] {","+            source.headers_mut().append(","+                SET_COOKIE,","+                format!(\"{name}=old%20value; Path=/; Domain=example.test\")","+                    .parse()","+                    .unwrap(),","+            );","+        }","+        let mut response = Response::from(source);","+        assert_eq!(response.cookies().iter().count(), 2);","+        let original = response.cookie(target).unwrap().clone();","+        assert_eq!(original.value(), \"old value\");","+        response.remove_cookie_with(original);","+        let response = response.into_hyper();","+        let fields: Vec<_> = response","+            .headers()","+            .get_all(SET_COOKIE)","+            .iter()","+            .map(|field| field.to_str().unwrap())","+            .collect();","+        assert_eq!(fields.len(), 2);","+        let removal = fields","+            .iter()","+            .find(|field| field.starts_with(&format!(\"{target}=;\")))","+            .unwrap();","+        assert!(removal.contains(\"Max-Age=0\"));","+        assert!(removal.contains(\"Path=/\"));","+        assert!(removal.contains(\"Domain=example.test\"));","+        let neighbor = if target == RAW {","+            \"name%2520with%2520spaces\"","+        } else {","+            RAW","+        };","+        assert!(","+            fields","+                .contains(&format!(\"{neighbor}=old%20value; Path=/; Domain=example.test\").as_str())","+        );","+    }","+}","+","+#[test]","+fn explicit_wire_identity_wins_over_its_legacy_invalid_alias() {","+    for reverse in [false, true] {","+        let mut response = Response::new();","+        let mut cookies = [","+            Cookie::new(\"legacy name\", \"legacy\"),","+            Cookie::new(\"legacy%20name\", \"explicit\"),","+        ];","+        if reverse {","+            cookies.reverse();","+        }","+        for cookie in cookies {","+            response.add_cookie(cookie);","+        }","+        let response = response.into_hyper();","+        let fields: Vec<_> = response","+            .headers()","+            .get_all(SET_COOKIE)","+            .iter()","+            .map(|field| field.to_str().unwrap())","+            .collect();","+        assert_eq!(fields, [\"legacy%20name=explicit\"]);","+    }","+}"],"additions":168,"deletions":0,"truncated":false},{"path":"crates/csrf/src/cookie_store.rs","lines":["@@ -239,11 +239,11 @@ mod tests {","                 .add_header(\"cookie\", &genuine, true)","                 .add_header(\"cookie\", &alias, false)","                 .build();","-            // Exercise the actual Request parser: the alias shadows the genuine","-            // cookie in its decoded jar, but must not affect prefixed-store load.","+            // Both the Request parser and prefixed store preserve original names,","+            // so the encoded alias cannot replace the genuine cookie at either layer.","             assert_eq!(","                 req.cookie(&store.name).unwrap().value(),","-                format!(\"{attacker}.{attacker_proof}\")","+                format!(\"{victim}.{victim_proof}\")","             );","             assert_eq!(","                 store.load(&mut req, &mut Depot::new(), &cipher).await,"],"additions":3,"deletions":3,"truncated":false},{"path":"crates/jwt-auth/tests/cookie_name_identity.rs","lines":["@@ -0,0 +1,50 @@","+//! Encoded cookie names must not alias a configured authentication cookie.","+use salvo_core::prelude::*;","+use salvo_core::test::{ResponseExt, TestClient};","+use salvo_jwt_auth::{ConstDecoder, CookieFinder, JwtAuth, JwtAuthDepotExt};","+","+#[handler]","+async fn identity(depot: &mut Depot) -> String {","+    depot.jwt_auth_data::<serde_json::Value>().unwrap().claims[\"sub\"]","+        .as_str()","+        .unwrap()","+        .to_owned()","+}","+","+#[tokio::test]","+async fn encoded_host_cookie_alias_cannot_select_another_jwt() {","+    let _ = salvo_jwt_auth::install_crypto_provider();","+    let secret = \"YXVkaXQtbG9jYWwtc2VjcmV0LXdpdGgtc3VmZmljaWVudC1lbnRyb3B5LWZvci1oczI1Ng==\";","+    let issue = |sub: &str| {","+        jsonwebtoken::encode(","+            &jsonwebtoken::Header::new(jsonwebtoken::Algorithm::HS256),","+            &serde_json::json!({\"sub\": sub, \"exp\": 4000000000u64}),","+            &jsonwebtoken::EncodingKey::from_base64_secret(secret).unwrap(),","+        )","+        .unwrap()","+    };","+    let victim = issue(\"victim\");","+    let attacker = issue(\"attacker\");","+    let auth: JwtAuth<serde_json::Value, _> =","+        JwtAuth::new(ConstDecoder::from_base64_secret(secret).unwrap())","+            .finders(vec![Box::new(CookieFinder::new(\"__Host-token\"))]);","+    let service = Service::new(Router::new().hoop(auth).goal(identity));","+    for (cookie, expected) in [","+        (format!(\"__%48ost-token={attacker}\"), None),","+        (","+            format!(\"__Host-token={victim}; __%48ost-token={attacker}\"),","+            Some(\"victim\"),","+        ),","+    ] {","+        let mut response = TestClient::get(\"https://app.example.test/\")","+            .add_header(\"cookie\", cookie, true)","+            .send(&service)","+            .await;","+        if let Some(expected) = expected {","+            assert_eq!(response.status_code, Some(StatusCode::OK));","+            assert_eq!(response.take_string().await.unwrap(), expected);","+        } else {","+            assert_eq!(response.status_code, Some(StatusCode::UNAUTHORIZED));","+        }","+    }","+}"],"additions":50,"deletions":0,"truncated":false},{"path":"crates/session/tests/cookie_name_identity.rs","lines":["@@ -0,0 +1,72 @@","+//! Session cookie names must retain their exact wire identity.","+use salvo_core::http::header::{COOKIE, SET_COOKIE};","+use salvo_core::prelude::*;","+use salvo_core::test::{ResponseExt, TestClient};","+use salvo_session::{MemoryStore, SessionDepotExt, SessionHandler};","+","+#[handler]","+async fn login(req: &mut Request, depot: &mut Depot) {","+    let user = req.query::<String>(\"user\").unwrap();","+    let session = depot.session_mut().unwrap();","+    session.regenerate();","+    session.insert(\"user\", user).unwrap();","+}","+","+#[handler]","+async fn whoami(depot: &mut Depot) -> String {","+    depot","+        .session()","+        .unwrap()","+        .get::<String>(\"user\")","+        .unwrap_or_default()","+}","+","+fn pair(response: &Response) -> String {","+    response.headers()[SET_COOKIE]","+        .to_str()","+        .unwrap()","+        .split(';')","+        .next()","+        .unwrap()","+        .to_owned()","+}","+","+#[tokio::test]","+async fn encoded_alias_cannot_select_another_valid_session() {","+    let sessions = SessionHandler::builder(MemoryStore::new(), &[42; 64])","+        .cookie_name(\"__Host-session\")","+        .secure_cookie(true)","+        .build()","+        .unwrap();","+    let service = Service::new(","+        Router::new()","+            .hoop(sessions)","+            .push(Router::with_path(\"login\").post(login))","+            .push(Router::with_path(\"me\").get(whoami)),","+    );","+    let attacker = pair(","+        &TestClient::post(\"https://app.example.test/login?user=attacker\")","+            .send(&service)","+            .await,","+    );","+    let victim = pair(","+        &TestClient::post(\"https://app.example.test/login?user=victim\")","+            .send(&service)","+            .await,","+    );","+    let alias = attacker.replacen(\"__Host-session=\", \"%5F_Host-session=\", 1);","+    for (header, expected) in [","+        (alias.clone(), \"\"),","+        (format!(\"{victim}; {alias}\"), \"victim\"),","+    ] {","+        let mut response = TestClient::get(\"https://app.example.test/me\")","+            .add_header(COOKIE, header, true)","+            .send(&service)","+            .await;","+        assert_eq!(","+            response.take_string().await.unwrap(),","+            expected,","+            \"An encoded cookie name must not replace the authenticated cookie\"","+        );","+    }","+}",""],"additions":72,"deletions":0,"truncated":false}],"additions":389,"deletions":11,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-16T17:24:01.296310+00:00"}