{"id":"8c1cf5fd28ce9bac0d9ac6dc2123a14a1244d7ad","axis":"silent","repo":"jaegertracing/jaeger","sha":"8c1cf5fd28ce9bac0d9ac6dc2123a14a1244d7ad","parsed":{"files":[{"path":"internal/storage/v2/clickhouse/attribute_layout.go","lines":["@@ -0,0 +1,47 @@","+// Copyright (c) 2026 The Jaeger Authors.","+// SPDX-License-Identifier: Apache-2.0","+","+package clickhouse","+","+import (","+\t\"context\"","+\t\"fmt\"","+","+\t\"github.com/ClickHouse/clickhouse-go/v2/lib/driver\"","+","+\t\"github.com/jaegertracing/jaeger/internal/storage/v2/clickhouse/sql\"","+\tchtracestore \"github.com/jaegertracing/jaeger/internal/storage/v2/clickhouse/tracestore\"","+)","+","+// checkAttributeLayout verifies that the spans table stores its attribute groups in the","+// configured layout. The table may have been created by the operator or under an earlier","+// configuration, and the statements of one layout fail on a table of the other only when the","+// first span is written or read. A table that does not exist passes the check.","+func checkAttributeLayout(ctx context.Context, conn driver.Conn, configured chtracestore.AttributeLayout) error {","+\trows, err := conn.Query(ctx, sql.SelectAttributeGroupType)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"failed to read the attribute layout of the spans table: %w\", err)","+\t}","+\tdefer rows.Close()","+\t// The rows are read to the end, because the driver reports an error of the result stream","+\t// only after the last row.","+\tvar columnTypes []string","+\tfor rows.Next() {","+\t\tvar columnType string","+\t\tif err := rows.Scan(&columnType); err != nil {","+\t\t\treturn fmt.Errorf(\"failed to read the attribute layout of the spans table: %w\", err)","+\t\t}","+\t\tcolumnTypes = append(columnTypes, columnType)","+\t}","+\tif err := rows.Err(); err != nil {","+\t\treturn fmt.Errorf(\"failed to read the attribute layout of the spans table: %w\", err)","+\t}","+\tfor _, columnType := range columnTypes {","+\t\tif !configured.Declares(columnType) {","+\t\t\treturn fmt.Errorf(\"the spans table declares its string attributes as %s, which is not the %s layout that attribute_layout selects; \"+","+\t\t\t\t\"an existing table is not converted, so change attribute_layout or create the tables in a new database\",","+\t\t\t\tcolumnType, configured.Name())","+\t\t}","+\t}","+\treturn nil","+}"],"additions":47,"deletions":0,"truncated":false},{"path":"internal/storage/v2/clickhouse/attribute_layout_test.go","lines":["@@ -0,0 +1,107 @@","+// Copyright (c) 2026 The Jaeger Authors.","+// SPDX-License-Identifier: Apache-2.0","+","+package clickhouse","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/jaegertracing/jaeger/internal/storage/v2/clickhouse/clickhousetest\"","+\tchtracestore \"github.com/jaegertracing/jaeger/internal/storage/v2/clickhouse/tracestore\"","+)","+","+func TestCheckAttributeLayout(t *testing.T) {","+\ttests := []struct {","+\t\tname       string","+\t\tconfigured chtracestore.AttributeLayout","+\t\t// columnTypes is the rows of the lookup: none when the spans table does not exist.","+\t\tcolumnTypes []string","+\t\tqueryErr    error","+\t\tscanErr     error","+\t\trowsErr     error","+\t\twantErr     string","+\t}{","+\t\t{","+\t\t\tname:        \"nested table and nested configuration\",","+\t\t\tconfigured:  chtracestore.NestedLayout{},","+\t\t\tcolumnTypes: []string{\"Array(String)\"},","+\t\t},","+\t\t{","+\t\t\tname:        \"nested table without flatten_nested\",","+\t\t\tconfigured:  chtracestore.NestedLayout{},","+\t\t\tcolumnTypes: []string{\"Nested(key String, value String)\"},","+\t\t},","+\t\t{","+\t\t\tname:        \"map table and map configuration\",","+\t\t\tconfigured:  chtracestore.MapLayout{},","+\t\t\tcolumnTypes: []string{\"Map(String, String)\"},","+\t\t},","+\t\t{","+\t\t\tname:       \"no table\",","+\t\t\tconfigured: chtracestore.MapLayout{},","+\t\t},","+\t\t{","+\t\t\tnam