f, useState } from 'react';","+import { PlatformColor, Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';","+import { SafeAreaView } from 'react-native-safe-area-context';","+import type { SplitHostCommands } from 'react-native-screens/experimental';","+import type { SFSymbol } from 'sf-symbols-typescript';","+","+import { ToggleRow } from '@/components/ToggleRow';","+import { MESSAGES } from '@/components/split-view-mail';","+","+const MAILBOXES: { name: string; icon: SFSymbol }[] = [","+  { name: 'Inbox', icon: 'tray' },","+  { name: 'VIP', icon: 'star' },","+  { name: 'Drafts', icon: 'doc' },","+  { name: 'Sent', icon: 'paperplane' },","+  { name: 'Junk', icon: 'xmark.bin' },","+  { name: 'Bin', icon: 'trash' },","+  { name: 'All Mail', icon: 'tray.2' },","+];","+","+export default function Layout() {","+  const router = useRouter();","+  // Navigation does not reveal a column, so the selected column is shown with the split view commands.","+  const splitRef = useRef<SplitHostCommands>(null);","+  const [collapsed, setCollapsed] = useState(false);","+  const { id } = useGlobalSearchParams<{ id?: string }>();","+  const message = MESSAGES.find((m) => m.id === id);","+","+  const [showHeaders, setShowHeaders] = useState(true);","+  const [alternateTitles, setAlternateTitles] = useState(false);","+  const [largeTitle, setLargeTitle] = useState(true);","+  const [threeColumns, setThreeColumns] = useState(true);","+  const [showInspector, setShowInspector] = useState(false);","+","+  return (","+    <SplitView","+      ref={splitRef}","+      preferredDisplayMode=\"twoBesideSecondary\"","+      showInspector={showInspector}","+      onCollapse={() => setCollapsed(true)}","+      onExpand={() => setCollapsed(false)}>","+      <SplitView.Column","+        header={","+          showHeaders","+            ? {","+                title: alternateTitles ? 'Folders' : 'Mailboxes',","+                largeTitle,","+              }","+            : undefined","+        }>","+        <ScrollView contentInsetAdjustmentBehavior=\"automatic\">","+          {MAILBOXES.map((mailbox) => (","+            <Pressable","+              key={mailbox.name}","+              style={styles.row}","+              onPress={() => {","+                // When expanded, `show` would close the sidebar overlay.","+                if (collapsed && threeColumns) splitRef.current?.show('supplementary');","+              }}>","+              <SymbolView name={mailbox.icon} size={20} />","+              <Text style={styles.rowTitle}>{mailbox.name}</Text>","+            </Pressable>","+          ))}","+          <View style={styles.controls}>","+            <Text style={styles.sectionTitle}>Test cases</Text>","+            <Pressable testID=\"split-view-mail-home\" onPress={() => router.replace('/')}>","+              <Text style={styles.link}>Back to home</Text>","+            </Pressable>","+            <ToggleRow","+              label=\"Headers\"","+              testID=\"split-view-mail-headers\"","+              value={showHeaders}","+              onValueChange={setShowHeaders}","+            />","+            <ToggleRow","+              label=\"Alternate titles\"","+              testID=\"split-view-mail-titles\"","+              value={alternateTitles}","+              onValueChange={setAlternateTitles}","+            />","+            <ToggleRow","+              label=\"Large title\"","+              testID=\"split-view-mail-large-title\"","+              value={largeTitle}","+              onValueChange={setLargeTitle}","+            />","+            <ToggleRow","+              label=\"Three columns\"","+              testID=\"split-view-mail-three-columns\"","+              value={threeColumns}","+              onValueChange={setThreeColumns}","+            />","+            <ToggleRow","+              label=\"Inspector\"","+              testID=\"split-view-mail-inspector\"","+              value={showInspector}","+              onValueChange={setShowInspector}","+            />","+          </View>","+        </ScrollView>","+      </SplitView.Column>","+      {threeColumns && (","+        <SplitView.Column","+          header={showHeaders ? { title: alternateTitles ? 'Gmail' : 'Inbox Gmail' } : undefined}>","+          <ScrollView contentInsetAdjustmentBehavior=\"automatic\">","+            {/* The floating sidebar of iOS 26 covers the leading edge of this column. */}","+            <SafeAreaView edges={['left']}>","+              {MESSAGES.map((m) => (","+                <Pressable","+                  key={m.id}","+                  style={[","+                    styles.message,","+                    m.id === id && { backgroundColor: PlatformColor('systemGray5') },","+                  ]}","+                  onPress={() => {","+                    router.replace(`/split-view-mail/${m.id}`);","+                    splitRef.current?.show('secondary');","+                  }}>","+                  <Text style={styles.sender}>{m.sender}</Text>","+                  <Text>{m.subject}</Text>","+                </Pressable>","+              ))}","+            </SafeAreaView>","+          </ScrollView>","+        </SplitView.Column>","+      )}","+      <SplitView.Content","+        header={","+          showHeaders","+            ? { title: alternateTitles ? 'Message' : (message?.sender ?? 'Mail') }","+            : undefined","+        }","+      />","+      {showInspector && (","+        <SplitView.Inspector header={showHeaders ? { title: 'Info' } : undefined}>","+          <View style={styles.inspector}>","+            <Text>Inspector</Text>","+          </View>","+        </SplitView.Inspector>","+      )}","+    </SplitView>","+  );","+}","+","+const styles = StyleSheet.create({","+  row: {","+    flexDirection: 'row',","+    alignItems: 'center',","+    gap: 12,","+    paddingHorizontal: 20,","+    paddingVertical: 10,","+  },","+  rowTitle: { fontSize: 17 },","+  controls: { padding: 20, gap: 4 },","+  link: { fontSize: 16, color: PlatformColor('link'), paddingVertical: 8 },","+  sectionTitle: { fontSize: 13, color: 'gray', textTransform: 'uppercase' },","+  message: { paddingHorizontal: 20, paddingVertical: 12, gap: 2 },","+  sender: { fontSize: 17, fontWeight: '600' },","+  inspector: { flex: 1, alignItems: 'center', justifyContent: 'center' },","+});"],"additions":162,"deletions":0,"truncated":false},{"path":"apps/router-tester/app/split-view-mail/index.tsx","lines":["@@ -0,0 +1,14 @@","+import { StyleSheet, Text, View } from 'react-native';","+","+export default function NoMessage() {","+  return (","+    <View style={styles.container}>","+      <Text style={styles.title}>No Message Selected</Text>","+    </View>","+  );","+}","+","+const styles = StyleSheet.create({","+  container: { flex: 1, alignItems: 'center', justifyContent: 'center', gap: 8 },","+  title: { fontSize: 20, fontWeight: '600' },","+});"],"additions":14,"deletions":0,"truncated":false},{"path":"apps/router-tester/components/split-view-mail.tsx","lines":["@@ -0,0 +1,23 @@","+export const MESSAGES = [","+  {","+    id: 'security-alert',","+    sender: 'Google',","+    subject: 'Security alert',","+    date: 'Today at 9:41',","+    body: 'A new sign-in on an iPad was detected. If this was you, you do not need to do anything.',","+  },","+  {","+    id: 'google-photos',","+    sender: 'Google Photos',","+    subject: 'Welcome to Google Photos',","+    date: 'Yesterday at 18:02',","+    body: 'Back up your photos and videos, and find them on any device.',","+  },","+  {","+    id: 'instagram',","+    sender: 'Instagram',","+    subject: 'See more from your friends',","+    date: 'Monday at 12:15',","+    body: 'Follow the people you know to see their photos and videos.',","+  },","+];"],"additions":23,"deletions":0,"truncated":false},{"path":"packages/expo-router/expo-module.config.json","lines":["@@ -1,7 +1,12 @@"," {","   \"platforms\": [\"apple\", \"android\", \"web\"],","   \"apple\": {","-    \"modules\": [\"ExpoHeadModule\", \"LinkPreviewNativeModule\", \"RouterToolbarModule\"],","+    \"modules\": [","+      \"ExpoHeadModule\",","+      \"LinkPreviewNativeModule\",","+      \"RouterToolbarModule\",","+      \"SplitViewModule\"","+    ],","     \"appDelegateSubscribers\": [\"ExpoHeadAppDelegateSubscriber\"]","   },","   \"android\": {"],"additions":6,"deletions":1,"truncated":false},{"path":"packages/expo-router/ios/SplitView/SplitViewHeaderView.swift","lines":["@@ -0,0 +1,47 @@","+import ExpoModulesCore","+import UIKit","+","+// Matches `RNSNavigationItemCustomizing` of react-native-screens by its Objective-C name,","+// so this compiles with versions that do not declare it.","+@objc(RNSNavigationItemCustomizing)","+protocol NavigationItemCustomizer: NSObjectProtocol {","+  func configureNavigationItem(_ navigationItem: UINavigationItem)","+}","+","+// Writes the header of a react-native-screens split column. The column passes its navigation item","+// when this view is mounted as its direct child.","+class SplitViewHeaderView: ExpoView, NavigationItemCustomizer {","+  var headerTitle: String?","+  var largeTitle = false","+","+  private weak var navigationItem: UINavigationItem?","+","+  func configureNavigationItem(_ navigationItem: UINavigationItem) {","+    self.navigationItem = navigationItem","+    apply()","+  }","+","+  override func didMoveToSuperview() {","+    super.didMoveToSuperview()","+    if superview == nil, let navigationItem {","+      navigationItem.title = nil","+      navigationItem.largeTitleDisplayMode = .never","+      self.navigationItem = nil","+    }","+  }","+","+  func apply() {","+    guard let navigationItem else {","+      return","+    }","+    navigationItem.title = headerTitle","+    // `.automatic` would follow the previous item, which is another column when the split view is collapsed.","+    let largeTitleDisplayMode: UINavigationItem.LargeTitleDisplayMode = largeTitle ? .always : .never","+    if navigationItem.largeTitleDisplayMode != largeTitleDisplayMode {","+      navigationItem.largeTitleDisplayMode = largeTitleDisplayMode","+      // A visible bar does not grow by itself when its item starts to show a large title.","+      // The column view is the view of its controller, so the controller is its next responder.","+      (superview?.next as? UIViewController)?.navigationController?.navigationBar.sizeToFit()","+    }","+  }","+}"],"additions":47,"deletions":0,"truncated":false},{"path":"packages/expo-router/ios/SplitView/SplitViewModule.swift","lines":["@@ -0,0 +1,19 @@","+import ExpoModulesCore","+","+public class SplitViewModule: Module {","+  public func definition() -> ModuleDefinition {","+    Name(\"ExpoRouterSplitViewModule\")","+","+    View(SplitViewHeaderView.self) {","+      Prop(\"title\") { (view: SplitViewHeaderView, title: String?) in","+        view.headerTitle = title","+      }","+      Prop(\"largeTitle\") { (view: SplitViewHeaderView, largeTitle: Bool?) in","+        view.largeTitle = largeTitle ?? false","+      }","+      OnViewDidUpdateProps { (view: SplitViewHeaderView) in","+        view.apply()","+      }","+    }","+  }","+}"],"additions":19,"deletions":0,"truncated":false},{"path":"packages/expo-router/src/split-view/__tests__/split-view-content-warning.test.ios.tsx","lines":["@@ -0,0 +1,63 @@","+import type { ReactNode } from 'react';","+import { Text } from 'react-native';","+","+import { renderRouter } from '../../testing-library';","+import { SplitView } from '../split-view';","+","+// The missing SplitView.Content warning shows once per module instance, so these tests use their own test file.","+","+jest.mock('../../optional-libraries/react-native-screens', () => {","+  const { View }: typeof import('react-native') = jest.requireActual('react-native');","+  const actual = jest.requireActual(","+    '../../optional-libraries/react-native-screens'","+  ) as typeof import('../../optional-libraries/react-native-screens');","+","+  return {","+    ...actual,","+    Split: {","+      ...actual.Split,","+      Host: ({ children }: { children?: ReactNode }) => <View>{children}</View>,","+      Column: ({ children }: { children?: ReactNode }) => <View>{children}</View>,","+    },","+  };","+});","+","+const MISSING_CONTENT_WARNING =","+  'SplitView.Content is missing. Add <SplitView.Content /> to SplitView to configure the content column.';","+","+it('does not warn when SplitView.Content is present', async () => {","+  const warn = jest.spyOn(console, 'warn').mockImplementation(() => {});","+  await renderRouter(","+    {","+      _layout: () => (","+        <SplitView>","+          <SplitView.Column />","+          <SplitView.Content />","+        </SplitView>","+      ),","+      index: () => <Text>Index</Text>,","+    },","+    { initialUrl: '/' }","+  );","+","+  expect(warn).not.toHaveBeenCalled();","+  warn.mockRestore();","+});","+","+it('warns once when SplitView.Content is missing', async () => {","+  const warn = jest.spyOn(console, 'warn').mockImplementation(() => {});","+  const routes = {","+    _layout: () => (","+      <SplitView>","+        <SplitView.Column />","+      </SplitView>","+    ),","+    index: () => <Text>Index</Text>,","+  };","+  await renderRouter(routes, { initialUrl: '/' });","+  await renderRouter(routes, { initialUrl: '/' });","+","+  expect(warn).toHaveBeenCalledTimes(1);","+  expect(warn).toHaveBeenCalledWith(MISSING_CONTENT_WARNING);","+  warn.mockRestore();","+});"],"additions":63,"deletions":0,"truncated":false},{"path":"packages/expo-router/src/split-view/__tests__/split-view.test.ios.tsx","lines":["@@ -1,4 +1,4 @@","-import { act, screen } from '@testing-library/react-native';","+import { act, screen, within } from '@testing-library/react-native';"," import { Children, isValidElement, type ReactNode } from 'react';"," import { Text, type NativeSyntheticEvent } from 'react-native';"," import { SafeAreaProvider } from 'react-native-safe-area-context';",