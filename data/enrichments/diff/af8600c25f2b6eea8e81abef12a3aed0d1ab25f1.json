ilboxes' }}>","+            <Text>Sidebar</Text>","+          </SplitView.Column>","+          <SplitView.Content />","+        </SplitView>","+      ),","+      index: () => <Text>Index</Text>,","+    },","+    { initialUrl: '/' }","+  );","+","+  // The first Split.Column is the sidebar column.","+  const columnProps = jest.mocked(Split.Column).mock.calls[0]![0];","+  expect(","+    Children.toArray(columnProps.children).map((child) => isValidElement(child) && child.type)","+  ).toEqual([SafeAreaView, SplitViewColumnHeader]);","+});","+","+it('renders the SplitView.Content header in the content column', async () => {","+  await renderRouter(","+    {","+      _layout: () => (","+        <SplitView>","+          <SplitView.Column />","+          <SplitView.Content header={{ title: 'Message' }} />","+        </SplitView>","+      ),","+      index: () => <Text testID=\"index\">Index</Text>,","+    },","+    { initialUrl: '/' }","+  );","+","+  // The first Split.Column is the sidebar column. The second is the content column.","+  const contentColumn = screen.getAllByTestId('Split.Column')[1]!;","+  expect(within(contentColumn).getByTestId('SplitViewNativeHeader')).toBeVisible();","+  expect(within(contentColumn).getByTestId('index')).toBeVisible();","+  expect(jest.mocked(SplitViewNativeHeader).mock.lastCall![0].title).toBe('Message');","+});","+","+it('renders the SplitView.Content header as the last child of the content column', async () => {","+  await renderRouter(","+    {","+      _layout: () => (","+        <SplitView>","+          <SplitView.Column />","+          <SplitView.Content header={{ title: 'Message' }} />","+        </SplitView>","+      ),","+      index: () => <Text testID=\"index\">Index</Text>,","+    },","+    { initialUrl: '/' }","+  );","+","+  // The first Split.Column is the sidebar column. The second is the content column.","+  const contentColumnProps = jest.mocked(Split.Column).mock.calls[1]![0];","+  expect(","+    Children.toArray(con