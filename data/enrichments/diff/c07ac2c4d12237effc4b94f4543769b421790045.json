{"id":"c07ac2c4d12237effc4b94f4543769b421790045","axis":"silent","repo":"rust-lang/cargo","sha":"c07ac2c4d12237effc4b94f4543769b421790045","parsed":{"files":[{"path":"src/bin/cargo/cli.rs","lines":["@@ -488,7 +488,10 @@ impl Exec {","     #[tracing::instrument(skip_all)]","     fn exec(self, gctx: &mut GlobalContext, subcommand_args: &ArgMatches) -> CliResult {","         match self {","-            Self::Builtin(exec) => exec(gctx, subcommand_args),","+            Self::Builtin(exec) => {","+                warn_mixed_zero_values(gctx, subcommand_args)?;","+                exec(gctx, subcommand_args)","+            }","             Self::Manifest(cmd) => {","                 let ext_path = super::find_external_subcommand(gctx, &cmd);","                 if !gctx.cli_unstable().script && ext_path.is_some() {","@@ -530,6 +533,41 @@ impl Exec {","     }"," }"," ","+/// Warns for an option having repeated occurrences but one of them is empty.","+///","+/// Here we check _all_ flags having the bad pattern `num_args(0..N)`.","+/// This might not be needed if clap supports showing possible candidates with dynamic values.","+/// See <https://github.com/rust-lang/cargo/issues/14606#issuecomment-2400013901>.","+fn warn_mixed_zero_values(gctx: &GlobalContext, args: &ArgMatches) -> CargoResult<()> {","+    for id in args.ids() {","+        // We use raw occurrences here because we don't need type information.","+        let Some(occurrences) = args.get_raw_occurrences(id.as_str()) else {","+            continue;","+        };","+","+        let mut has_value = false;","+        let mut has_no_value = false;","+","+        for values in occurrences {","+            if values.len() == 0 {","+                has_no_value = true;","+            } else {","+                has_value = true;","+            }","+        }","+        if has_value && has_no_value {","+            warn_ignored_zero_values(gctx, id.as_str())?;","+        }","+    }","+","+    // for nested command like `c