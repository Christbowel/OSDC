-exist rustc -vV` (never executed)","+","+Caused by:","+  [NOT_FOUND]","+","+\"#]])","+        .run();","+}"],"additions":243,"deletions":0,"truncated":false},{"path":"tests/testsuite/future_incompat_report.rs","lines":["@@ -725,3 +725,20 @@ fn correct_report_id_when_cached() {"," \"#]])","         .run();"," }","+","+#[cargo_test]","+fn package_flag_without_a_value() {","+    let p = project().file(\"src/lib.rs\", \"\").build();","+","+    p.cargo(\"report future-incompatibilities -p\")","+        .with_status(101)","+        .with_stderr_data(str![[r#\"","+[WARNING] `--package` without a value is ignored","+  |","+  = [NOTE] this was previously accepted but will become a hard error in the future","+  = [HELP] pass a value to `--package` or remove it","+[ERROR] no reports are currently available","+","+\"#]])","+        .run();","+}"],"additions":17,"deletions":0,"truncated":false},{"path":"tests/testsuite/install.rs","lines":["@@ -3393,3 +3393,89 @@ im_a_teapot = \"deny\""," \"#]])","         .run();"," }","+","+/// `cargo install` checks `--bin` and `--example` for a missing value","+/// only when there is a local workspace,","+/// so a registry install is enough to trigger the bad parse.","+#[cargo_test]","+fn bin_and_example_flags_without_a_value() {","+    Package::new(\"foo\", \"0.0.1\")","+        .file(\"src/main.rs\", \"fn main() {}\")","+        .publish();","+    Package::new(\"bar\", \"0.0.1\")","+        .file(\"src/main.rs\", \"fn main() {}\")","+        .file(\"examples/a.rs\", \"fn main() {}\")","+        .publish();","+","+    cargo_process(\"install foo --bin\")","+        .with_stderr_data(str![[r#\"","+[WARNING] `--bin` without a value is ignored","+  |","+  = [NOTE] this was previously accepted but will become a hard error in the future","+  = [HELP] pass a value to `--bin` or remove it","+[UPDATING] `dummy-registry` index","+[DOWNLOADING] crates ...","+[DOWNLOADED] foo v0.0.1 (registry `dummy-registry`)","+[INSTALLING] foo v0.0.1","+[COMPILING