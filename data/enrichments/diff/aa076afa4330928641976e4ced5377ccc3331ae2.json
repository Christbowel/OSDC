essage\",","+    [","+        (401, {\"error\": \"unauthorized\"}, \"Unexpected response from OIDC token endpoint\"),","+        (200, {}, \"OIDC token not found in response\"),","+    ],","+)","+async def test_azure_pipelines_credential_oidc_error(get_token_method, status_code, payload, message):","+    response = mock_response(status_code=status_code, json_payload=payload)","+    response.json.return_value = payload","+    transport = AsyncMock(send=AsyncMock(return_value=response))","+    credential = AzurePipelinesCredential(","+        system_access_token=\"token\",","+        client_id=\"client-id\",","+        tenant_id=\"tenant-id\",","+        service_connection_id=\"connection-id\",","+        transport=transport,","+    )","+","+    with patch.dict(\"os.environ\", {SYSTEM_OIDCREQUESTURI: \"https://example.com/oidc\"}, clear=True):","+        async with credential:","+            with pytest.raises(ClientAuthenticationError, match=message):","+                await getattr(credential, get_token_method)(\"scope\")","+    transport.send.assert_awaited_once()"," "," "," @pytest.mark.asyncio","@@ -97,7 +178,8 @@ async def test_azure_pipelines_credential_in_chain(get_token_method):"," @pytest.mark.asyncio"," @pytest.mark.live_test_only(\"Requires Azure Pipelines environment with configured service connection\")"," @pytest.mark.parametrize(\"get_token_method\", GET_TOKEN_METHODS)","-async def test_azure_pipelines_credential_authentication(get_token_method):","+@pytest.mark.parametrize(\"use_custom_transport\", [False, True])","+async def test_azure_pipelines_credential_authentication(get_token_method, use_custom_transport):","     system_access_token = os.environ.get(\"SYSTEM_ACCESSTOKEN\", \"\")","     service_connection_id = os.environ.get(\"AZURE_SERVICE_CONNECTION_ID\", \"\")","     tenant_id = os.environ.get(\"AZURE_SERVICE_CONNECTION_TENANT_ID\", \"\")","@@ -105,19 +187,31 @@ async def test_azure_pipelines_credential_authentication(get_token_method):"," ",