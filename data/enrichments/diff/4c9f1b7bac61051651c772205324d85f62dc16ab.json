und ||= row.has(name)","+      values.push(row.get(name))","+    }","+    return found ? values : null","+  }","+","+  private _record_at(index: Index): Dict<unknown> | undefined {","+    return this.records[isNumber(index) ? index : index.index]","+  }","+","+  override get_field_value(name: string, index: Index): unknown {","+    const row = this._record_at(index)","+    return row === undefined ? undefined : dict(row).get(name)","+  }","+","+  get_record(index: Index): PlainObject {","+    const row = this._record_at(index)","+    return row === undefined ? {} : Object.fromEntries(dict(row).entries())","+  }","+","+  fields(): string[] {","+    const fields = new Set<string>()","+    for (const record of this.records) {","+      for (const name of keys(record)) {","+        fields.add(name)","+      }","+    }","+    return [...fields]","+  }","+}"],"additions":137,"deletions":0,"truncated":false},{"path":"bokehjs/test/assets/data/record_dive_observations.jsonl","lines":["@@ -0,0 +1,21 @@","+{\"site\":\"Shelter Cove\",\"depth\":3,\"cover\":61,\"status\":\"reviewed\"}","+{\"site\":\"Shelter Cove\",\"depth\":6,\"cover\":82,\"status\":\"reviewed\"}","+{\"site\":\"Shelter Cove\",\"depth\":9,\"cover\":90,\"status\":\"reviewed\"}","+{\"site\":\"Shelter Cove\",\"depth\":13,\"cover\":84,\"status\":\"reviewed\"}","+{\"site\":\"Shelter Cove\",\"depth\":17,\"cover\":68,\"status\":\"reviewed\"}","+{\"site\":\"Shelter Cove\",\"depth\":22,\"cover\":42,\"status\":\"reviewed\"}","+{\"site\":\"Shelter Cove\",\"depth\":28,\"cover\":17,\"status\":\"reviewed\"}","+{\"site\":\"Shelter Cove\",\"depth\":34,\"cover\":5,\"status\":\"reviewed\"}","+{\"site\":\"Needle Reef\",\"depth\":4,\"cover\":53,\"status\":\"reviewed\"}","+{\"site\":\"Needle Reef\",\"depth\":7,\"cover\":70,\"status\":\"reviewed\"}","+{\"site\":\"Needle Reef\",\"depth\":10,\"cover\":88,\"status\":\"reviewed\"}","+{\"site\":\"Needle Reef\",\"depth\":14,\"cover\":73,\"status\":\"reviewed\"}","+{\"site\":\"Needle Reef\",\"