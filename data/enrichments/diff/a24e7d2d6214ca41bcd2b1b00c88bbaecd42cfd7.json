sign(globalThis, environmentEncoding);","+});","+","+describe.each([\"babel\", \"oxc\"])(\"%s\", compiler => {","+  describe.each([false, true])(\"hydratable=%s\", hydratable => {","+    let runtime;","+    beforeAll(async () => {","+      runtime = await loadModule(compile(compiler, hydratable));","+    });","+","+    function mount(view) {","+      const root = document.createElement(\"div\");","+      document.body.appendChild(root);","+      const dispose = runtime.mount(root, view);","+      return { root, dispose };","+    }","+","+    test(\"a static select value after a sibling selects its option\", () => {","+      const { root, dispose } = mount(\"selectValue\");","+      try {","+        expect(root.querySelector(\"select\").value).toBe(\"b\");","+        expect(root.querySelector(\"span\").value).toBeUndefined();","+      } finally {","+        dispose();","+      }","+    });","+","+    test(\"a selected option beside defaultSelected is the one selected\", () => {","+      const { root, dispose } = mount(\"optionSelected\");","+      try {","+        const select = root.querySelector(\"select\");","+        expect([...select.options].map(option => option.selected)).toEqual([false, true]);","+        expect(select.value).toBe(\"b\");","+      } finally {","+        dispose();","+      }","+    });","+","+    test(\"an input value beside defaultValue lands on that input\", () => {","+      const { root, dispose } = mount(\"inputValue\");","+      try {","+        const inputs = [...root.querySelectorAll(\"input\")];","+        expect(inputs.map(input => input.value)).toEqual([\"a\", \"x\"]);","+        expect(inputs[1].defaultValue).toBe(\"y\");","+      } finally {","+        dispose();","+      }","+    });","+","+    test(\"a checked box beside defaultChecked is the one checked\", () => {","+      const { root, dispose } = mount(\"inputChecked\");","+      try {","+        const boxes = [...root.querySelectorAll(\"input\")];","+        expect(boxes.map