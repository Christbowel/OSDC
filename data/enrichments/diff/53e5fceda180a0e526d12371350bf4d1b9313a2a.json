{"id":"53e5fceda180a0e526d12371350bf4d1b9313a2a","axis":"silent","repo":"pytorch/pytorch","sha":"53e5fceda180a0e526d12371350bf4d1b9313a2a","parsed":{"files":[{"path":".ci/pytorch/common_utils.sh","lines":["@@ -377,7 +377,7 @@ function install_cutlass_dsl() {","   # Pin to a version accepted by torch._native's cutedsl version gate","   # (_CUTEDSL_REQUIRED_VERSIONS); apache-tvm-ffi is a required runtime dep of","   # the CuTeDSL op overrides but is not pulled in by nvidia-cutlass-dsl.","-  pip_install \"$cutlass_dsl_package\" apache-tvm-ffi==0.1.12","+  pip_install \"$cutlass_dsl_package\" apache-tvm-ffi==0.1.12 'cuda-bindings>=13.2,<14'","   echo \"NVIDIA CUTLASS DSL installation complete.\""," }"," "],"additions":1,"deletions":1,"truncated":false},{"path":".ci/wheel/linux/build.sh","lines":["@@ -49,6 +49,8 @@ case \"${GPU_ARCH_TYPE:-BLANK}\" in","         # CUDA arch types only: this arm also serves cpu/xpu/rocm, where stage 2 can","         # only skip.","         if [[ \"${GPU_ARCH_TYPE}\" == cuda* ]]; then","+            # cuda.pathfinder needs the toolkit root in the final manywheel image.","+            export CUDA_PATH=\"${CUDA_PATH:-${CUDA_HOME:-/usr/local/cuda}}\"","             # nullglob so an empty directory counts as zero, not the pattern.","             naot_wheels=()","             shopt -s nullglob"],"additions":2,"deletions":0,"truncated":false},{"path":"pyrefly.toml","lines":["@@ -105,6 +105,7 @@ ignore-missing-imports = [","     \"flydsl.*\",","     # cuda-python ships with cutlass but is absent from the linter image.","     \"cuda.bindings.*\",","+    \"cuda.pathfinder\",","     \"deeplearning.*\",","     \"einops.*\",","     \"libfb.*\","],"additions":1,"deletions":0,"truncated":false},{"path":"tools/native_aot/build_stage2.py","lines":["@@ -527,6 +527,7 @@ def require_runtimes() -> None:","         dists = sorted(","             {d for k in gaps for d in toolchains.get_toolchain(k).RUNTIME_DISTS}","         )","+        dists = [d + \">=13.2,<14\" if d == \"cuda-bindings\" else d for d in dists]","         detail = \"; \".join(","             f\"{k} needs {', '.join(ms)}\" for k, ms in sorted(gaps.items())","         )"],"additions":1,"deletions":0,"truncated":false},{"path":"tools/native_aot/cuda_image.py","lines":["@@ -0,0 +1,108 @@","+\"\"\"Compress native AOT cubins through CUDA's in-memory fatbinary API.\"\"\"","+","+from __future__ import annotations","+","+import logging","+import struct","+from pathlib import Path","+from typing import Any","+","+","+_FATBIN_MAGIC = 0xBA55ED50","+_FATBIN_HEADER = struct.Struct(\"<IHHQ\")","+_FATBIN_ENTRY = struct.Struct(\"<HHIQ\")","+_FATBIN_ELF = 2","+log = logging.getLogger(__name__)","+","+","+def compress_cubin(cubin: bytes, arch: str) -> bytes:","+    \"\"\"Keep the cubin unchanged when a compressed CUDA image would be larger.\"\"\"","+    from cuda.bindings import nvfatbin","+    from cuda.pathfinder import DynamicLibNotFoundError","+","+    try:","+        handle = nvfatbin.create([\"-64\", \"-compress-all\"], 2)","+    except DynamicLibNotFoundError as error:","+        raise RuntimeError(","+            \"native-AOT compression requires libnvfatbin from CUDA Toolkit 13; \"","+            \"check CUDA library paths or set TORCH_NATIVE_AOT=0 to disable native AOT\"","+        ) from error","+    try:","+        nvfatbin.add_cubin(handle, cubin, len(cubin), arch.removeprefix(\"sm_\"), \"\")","+        compressed = bytearray(nvfatbin.size(handle))","+        nvfatbin.get(handle, compressed)","+        return bytes(compressed) if len(compressed) < len(cubin) else cubin","+    finally:","+        nvfatbin.destroy(handle)","+","+","+def compress_cute_embedded_cubin(compiled: Any, arch: str | None = None) -> None:","+    \"\"\"Compress the captured cubin for an explicit arch; retain other images.\"\"\"","+    if arch is None:","+        return","+    from cutlass._mlir import ir","+","+    cubin = compiled.__cubin__","+    if isinstance(cubin, str):","+        cubin = Path(cubin).read_bytes()","+    if not isinstance(cubin, bytes):","+        raise RuntimeError(\"CuTeDSL did not capture its cubin for native AOT\")","+    module = compiled.ir_module","+    matched = False","+    with module.context:","+        for op in module.body.operations:","+            if op.operation.name != \"llvm.mlir.global\" or \"value\" not in op.attributes:","+                continue","+            value = op.attributes[\"value\"]","+            if not isinstance(value, ir.StringAttr):","+                continue","+            data = ir.StringAttr(value).value_bytes","+            if len(data) < _FATBIN_HEADER.size:","+                continue","+            magic, _, header, _ = _FATBIN_HEADER.unpack_from(data)","+            if (","+                magic != _FATBIN_MAGIC","+                or header < _FATBIN_HEADER.size","+                or header + _FATBIN_ENTRY.size > len(data)","+            ):","+                continue","+            kind, _, entry_header, size = _FATBIN_ENTRY.unpack_from(data, header)","+            payload = header + entry_header","+            # Replace only the captured ELF's single-image wrapper.","+            if (","+                kind != _FATBIN_ELF","+                or entry_header < _FATBIN_ENTRY.size","+                or payload + size != len(data)","+                or data[payload:] != cubin","+            ):","+                continue","+            matched = True","+            compressed = compress_cubin(cubin, arch)","+            if len(compressed) >= len(cubin):","+                continue","+            old_type = op.attributes[\"global_type\"]","+            symbol = ir.StringAttr(op.attributes[\"sym_name\"]).value","+            new_type = ir.TypeAttr.get(","+                ir.Type.parse(f\"!llvm.array<{len(compressed)} x i8>\")","+            )","+            op.attributes[\"value\"] = ir.StringAttr.get(compressed)","+            op.attributes[\"global_type\"] = new_type","+","+            def update_gep_element_type(operation: Any) -> Any:","+                if (","+                    operation.operation.name == \"llvm.getelementptr\"","+                    and \"elem_type\" in operation.attributes","+                    and operation.attributes[\"elem_type\"] == old_type","+                ):","+                    owner = operation.operands[0].owner","+                    if (","+                        owner.operation.name == \"llvm.mlir.addressof\"","+                        and ir.FlatSymbolRefAttr(owner.attributes[\"global_name\"]).value","+                        == symbol","+                    ):","+                        operation.attributes[\"elem_type\"] = new_type","+                return ir.WalkResult.ADVANCE","+","+            module.operation.walk(update_gep_element_type)","+    if not matched:","+        log.debug(\"No supported CuTeDSL cubin buffer; retaining original images\")"],"additions":108,"deletions":0,"truncated":false},{"path":"tools/native_aot/toolchains.py","lines":["@@ -35,6 +35,10 @@","     several kinds' artifacts."," "," Export runs in stage 2, after torch is built, so a builder module may import torch.","+","+CUDA images are compressed at export through cuda.bindings.nvfatbin. CuTe exposes","+its raw cubin through --keep-cubin; its host ABI and other embedded images are","+retained. CUDA decompresses images on first load. Triton retains its CUDA-image artifact path."," \"\"\""," "," from __future__ import annotations","@@ -43,8 +47,11 @@"," import platform"," import re"," import shlex","+import tempfile"," from typing import Any"," ","+from tools.native_aot.cuda_image import compress_cubin, compress_cute_embedded_cubin","+"," "," class Toolchain:","     kind: str = \"\"","@@ -90,7 +97,15 @@ class Toolchain:","     def missing_runtimes(cls) -> list[str]:","         import importlib.util"," ","-        return [m for m in cls.REQUIRED_RUNTIMES if importlib.util.find_spec(m) is None]","+        missing = []","+     