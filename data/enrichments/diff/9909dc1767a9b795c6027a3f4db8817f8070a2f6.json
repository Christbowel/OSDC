ne, LiteParsedPipeline>;","+","+public:","+    /**","+     * A handle to a single subpipeline slot, returned by value from every element accessor. It","+     * dereferences straight through to the LiteParsedPipeline (for in-place edits) but never","+     * yields the owning OwnedLiteParsedPipeline wrapper, so the slot cannot be reassigned, moved","+     * from, or swapped with another.","+     */","+    class reference {","+    public:","+        LitePipeline& operator*() const {","+            return *_owned;","+        }","+        LitePipeline* operator->() const {","+            return &*_owned;","+        }","+","+        // Wrapper-level accessors used by generic consumers (view cycle detection, desugaring).","+        decltype(auto) pipeline() const {","+            return _owned.pipeline();","+        }","+        const boost::optional<NamespaceString>& getViewNss() const {","+            return _owned.getViewNss();","+        }","+","+    private:","+        friend class OwnedLiteParsedPipelinesView;","+        explicit reference(OwnedPipeline& owned) : _owned(owned) {}","+","+        // Reference member: the handle is non-assignable, so std::swap, std::iter_swap and the","+        // reordering algorithms fail to compile when applied to it.","+        OwnedPipeline& _owned;","+    };","+","+    /**","+     * Forward-only iterator yielding 'reference' handles by value. Deliberately not bidirectional:","+     * std::reverse/std::sort reject it on iterator category alone, and the by-value proxy defeats","+     * iter_swap-based reordering.","+     */","+    class iterator {","+    public:","+        using iterator_category = std::forward_iterator_tag;","+        using difference_type = std::ptrdiff_t;","+        using value_type = OwnedLiteParsedPipeline;","+        using reference = OwnedLiteParsedPipelinesView::reference;","+        using pointer = void;","+","+        reference operator*() const {","+            return reference{*_it};","+        }","+    