","+","+/**","+ * Reads Bedrock's {@code application/vnd.amazon.eventstream} body, which is binary frames rather than SSE: a prelude","+ * (total length, headers length, CRC), typed headers, a JSON payload and a CRC of the whole frame. Each event frame is","+ * passed on as a {@link ServerSentEvent} named by its {@code :event-type} header, so the stream runs on the same","+ * guarded HTTP client as every other provider.","+ */","+class AwsEventStreamParser implements ServerSentEventParser {","+","+    static final String MESSAGE_TYPE = \":message-type\";","+    static final String EVENT_TYPE = \":event-type\";","+    static final String EXCEPTION_TYPE = \":exception-type\";","+    static final String ERROR_CODE = \":error-code\";","+    static final String ERROR_MESSAGE = \":error-message\";","+","+    private static final int PRELUDE_LENGTH = 12;","+    private static final int CRC_LENGTH = 4;","+    // AWS caps one event-stream message at 16 MB.","+    private static final int MAX_MESSAGE_LENGTH = 16 * 1024 * 1024;","+","+    private static final byte STRING_HEADER = 7;","+","+    @Override","+    public void parse(@NonNull InputStream body, @NonNull ServerSentEventListener listener) {","+        try {","+            var firstFrame = true;","+            while (true) {","+                var prelude = body.readNBytes(PRELUDE_LENGTH);","+                if (prelude.length == 0) {","+                    return;","+                }","+                // Bedrock answers a path it doesn't serve with a 200 and a JSON body. A frame starts with its length,","+                // whose first byte is 0 or 1 under the 16 MB cap, never whitespace or '{'.","+                if (firstFrame && startsWithJsonObject(prelude)) {","+                    listener.onError(new ProviderRequestRefusedException(","+                            ProviderRequestRefusedException.Reason.BEDROCK_CONVERSE_URL));","+                    return;","+                }","+                firstFrame = false;","+                if (prelude.length < PRELUDE_LENGTH) {","+                    throw new IOException(\"Truncated event stream prelude\");","+                }","+                var preludeBuffer = ByteBuffer.wrap(prelude);","+                int totalLength = preludeBuffer.getInt();","+                int headersLength = preludeBuffer.getInt();","+                int preludeCrc = preludeBuffer.getInt();","+                if (crc(prelude, 0, 8) != preludeCrc) {","+                    throw new IOException(\"Event stream prelude CRC mismatch\");","+                }","+                if (headersLength < 0 || totalLength < PRELUDE_LENGTH + headersLength + CRC_LENGTH","+                        || totalLength > MAX_MESSAGE_LENGTH) {","+                    throw new IOException(\"Invalid event stream message length \" + totalLength);","+                }","+                var rest = body.readNBytes(totalLength - PRELUDE_LENGTH);","+                if (rest.length < totalLength - PRELUDE_LENGTH) {","+                    throw new IOException(\"Truncated event stream message\");","+                }","+                var messageCrc = new CRC32();","+                messageCrc.update(prelude);","+                messageCrc.update(rest, 0, rest.length - CRC_LENGTH);","+                if ((int) messageCrc.getValue() != ByteBuffer.wrap(rest, rest.length - CRC_LENGTH, CRC_LENGTH)","+                        .getInt()) {","+                    throw new IOException(\"Event stream message CRC mismatch\");","+                }","+","+                var headers = stringHeaders(ByteBuffer.wrap(rest, 0, headersLength));","+                var payload = new String(rest, headersLength, rest.length - headersLength - CRC_LENGTH,","+                        StandardCharsets.UTF_8);","+                if (\"event\".equals(headers.get(MESSAGE_TYPE))) {","+                    listener.onEvent(new ServerSentEvent(headers.get(EVENT_TYPE), payload));","+                    continue;","+                }","+                listener.onError(toException(headers, payload));","+                return;","+            }","+        } catch (IOException exception) {","+            listener.onError(exception);","+        }","+    }","+","+    // An exception frame carries the same {\"message\": ...} body as a non-2xx response, so both reach callers as an","+    // HttpException with the status and the error type header that response would have had.","+    private static HttpException toException(Map<String, String> headers, String payload) {","+        var type = headers.getOrDefault(EXCEPTION_TYPE, headers.getOrDefault(ERROR_CODE, \"\"));","+        var body = payload.isBlank()","+                ? JsonUtils.writeValueAsString(Map.of(\"message\", headers.getOrDefault(ERROR_MESSAGE, type)))","+                : payload;","+        return new HttpResponseException(statusOf(type), body,","+                Map.of(BedrockConverseMapper.ERROR_TYPE_HEADER, List.of(StringUtils.capitalize(type))));","+    }","+","+    private static int statusOf(String exceptionType) {","+        return switch (exceptionType) {","+            case \"validationException\" -> 400;","+            case \"accessDeniedException\" -> 403;","+            case \"resourceNotFoundException\" -> 404;","+            case \"throttlingException\" -> 429;","+            case \"modelStreamErrorException\" -> 424;","+            case \"serviceUnavailableException\" -> 503;","+            default -> 500;","+        };","+    }","+","+    private static boolean startsWithJsonObject(byte[] bytes) {","+        for (byte value : bytes) {","+            if (value == '{') {","+                return true;","+            }","+            if (value != ' ' && value != '\\t' && value != '\\n' && value != '\\r') {","+                return false;","+            }","+        }","+        return false;","+    }","+","+    private static Map<String, String> stringHeaders(ByteBuffer buffer) throws IOException {","+        var headers = new HashMap<String, String>();","+        try {","+            while (buffer.hasRemaining()) {","+                var name = new String(bytes(buffer, Byte.toUnsignedInt(buffer.get())), StandardCharsets.UTF_8);","+                byte type = buffer.get();","+                switch (type) {","+                    case 0, 1 -> {","+                    }","+                    case 2 -> skip(buffer, 1);","+                    case 3 -> skip(buffer, 2);","+                    case 4 -> skip(buffer, 4);","+                    case 5, 8 -> skip(buffer, 8);","+                    case 6 -> skip(buffer, Short.toUnsignedInt(buffer.getShort()));","+                    case STRING_HEADER -> headers.put(name,","+                            new String(bytes(buffer, Short.toUnsignedInt(buffer.getShort())),","+                                    StandardCharsets.UTF_8));","+                    case 9 -> skip(buffer, 16);","+                    default -> throw new IOException(\"Unknown event stream header type \" + type);","+                }","+            }","+        } catch (BufferUnderflowException | IllegalArgumentException exception) {","+            throw new IOException(\"Malformed event stream headers\", exception);","+        }","+        return headers;","+    }","+","+    private static byte[] bytes(ByteBuffer buffer, int length) {","+        var bytes = new byte[length];","+        buffer.get(bytes);","+        return bytes;","+    }","+","+    private static void skip(ByteBuffer buffer, int length) {","+        buffer.position(buffer.position() + length);","+    }","+","+    private static int crc(byte[] bytes, int offset, int length) {","+        var crc = new CRC32();","+        crc.update(bytes, offset, length);","+        return (int) crc.getValue();","+    }","+}"],"additions":177,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/infrastructure/llm/customllm/BedrockAnthropicMessagesProvider.java","lines":["@@ -0,0 +1,60 @@","+package com.comet.opik.infrastructure.llm.customllm;","+","+import com.comet.opik.domain.llm.LlmProviderService;","+import dev.langchain4j.model.openai.internal.chat.ChatCompletionRequest;","+import dev.langchain4j.model.openai.internal.chat.ChatCompletionResponse;","+import io.dropwizard.jersey.errors.ErrorMessage;","+import lombok.NonNull;","+import lombok.RequiredArgsConstructor;","+import org.apache.commons.lang3.ObjectUtils;","+","+import java.util.Optional;","+import java.util.function.Consumer;","+","+@RequiredArgsConstructor","+class BedrockAnthropicMessagesProvider implements LlmProviderService {","+","+    private final @NonNull LlmProviderService anthropic;","+    private final String providerName;","+","+    @Override","+    public ChatCompletionResponse generate(@NonNull ChatCompletionRequest request, @NonNull String workspaceId) {","+        return anthropic.generate(toBedrockRequest(request), workspaceId);","+    }","+","+    @Override","+    public void generateStream(","+            @NonNull ChatCompletionRequest request,","+            @NonNull String workspaceId,","+            @NonNull Consumer<ChatCompletionResponse> handleMessage,","+            @NonNull Runnable handleClose,","+            @NonNull Consumer<Throwable> handleError) {","+        anthropic.generateStream(toBedrockRequest(request), workspaceId, handleMessage, handleClose, handleError);","+    }","+","+    @Override","+    public void validateRequest(@NonNull ChatCompletionRequest request) {","+        anthropic.validateRequest(toBedrockRequest(request));","+    }","+","+    @Override","+    public Optional<ErrorMessage> getLlmProviderError(@NonNull Throwable throwable) {","+        return anthropic.getLlmProviderError(throwable);","+    }","+","+    // The playground's token slider allows 0, which Anthropic rejects; without a positive limit the Anthropic mapper","+    // applies its default.","+    private ChatCompletionRequest toBedrockRequest(ChatCompletionRequest request) {","+        return ChatCompletionRequest.builder()","+                .from(request)","+                .model(BedrockApi.modelId(request.model(), providerName))","+                .maxCompletionTokens(ObjectUtils.firstNonNull(","+                        positiveOrNull(request.maxCompletionTokens()), positiveOrNull(request.maxTokens())))","+                .maxTokens(null)","+                .build();","+    }","+","+    private static Integer positiveOrNull(Integer tokens) {","+        return tokens != null && tokens > 0 ? tokens : null;","+    }","+}"],"additions":60,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/infrastructure/llm/customllm/BedrockApi.java","lines":["@@ -0,0 +1,66 @@","+package com.comet.opik.infrastructure.llm.customllm;","+","+import com.comet.opik.api.LlmProvider;","+import com.comet.opik.infrastructure.llm.LlmProviderClientApiConfig;","+import lombok.NonNull;","+import lombok.extern.slf4j.Slf4j;","+import org.apache.commons.lang3.StringUtils;","+","+import java.util.Locale;","+import java.util.Optional;","+","+/**","+ * The API a Bedrock provider sends its requests through. Bedrock serves Claude only through the Anthropic Messages","+ * API and Amazon Nova only through Converse, neither through Chat Completions, so their models need a provider set to","+ * {@link #ANTHROPIC_MESSAGES} or {@link #CONVERSE}.","+ */","+@Slf4j","+enum BedrockApi {","+    CHAT_COMPLETIONS,","+    ANTHROPIC_MESSAGES,","+    CONVERSE;","+","+    static final String CONFIG_KEY = \"bedrock_api\";","+","+    private static final String MESSAGES_PATH = \"/messages\";","+    private static final String VERSION_PATH = \"/v1\";","+","+    static BedrockApi of(@NonNull LlmProviderClientApiConfig config) {","+        if (config.provider() != LlmProvider.BEDROCK) {","+            return CHAT_COMPLETIONS;","+        }","+        var value = Optional.ofNullable(config.configuration())","+                .map(configuration -> configuration.get(CONFIG_KEY))","+                .orElse(null);","+        if (StringUtils.isBlank(value)) {","+            return CHAT_COMPLETIONS;","+        }","+        try {","+            return valueOf(value.trim().toUpperCase(Locale.ROOT));","+        } catch (IllegalArgumentException exception) {","+            log.warn(\"Unknown '{}' value '{}', falling back to '{}'\", CONFIG_KEY, value, CHAT_COMPLETIONS);","+            return CHAT_COMPLETIONS;","+        }","+    }","+","+    /**","+     * AWS documents the Anthropic route as {@code …/anthropic} for bedrock-runtime and as the full","+     * {@code …/anthropic/v1/messages} for bedrock-mantle, and people paste either. The Anthropic client appends","+     * {@code messages} itself, so both become {@code …/anthropic/v1}.","+     */","+    static String messagesBaseUrl(@NonNull String url) {","+        var base = StringUtils.stripEnd(url.trim(), \"/\");","+        base = StringUtils.removeEnd(base, MESSAGES_PATH);","+        return base.endsWith(VERSION_PATH) ? base : base + VERSION_PATH;","+    }","+","+    static String converseBaseUrl(@NonNull String url) {","+        return StringUtils.stripEnd(url.trim(), \"/\");","+    }","+","+    static String modelId(@NonNull String model, String providerName) {","+        return CustomLlmModelNameChecker.isCustomLlmModel(model)","+                ? CustomLlmModelNameChecker.extractModelName(model, providerName)","+                : model;","+    }","+}"],"additions":66,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/infrastructure/llm/customllm/BedrockConverseChatModel.java","lines":["@@ -0,0 +1,32 @@","+package com.comet.opik.infrastructure.llm.customllm;","+","+import com.fasterxml.jackson.databind.JsonNode;","+import dev.langchain4j.model.chat.ChatModel;","+import dev.langchain4j.model.chat.request.ChatRequest;","+import dev.langchain4j.model.chat.request.ChatRequestParameters;","+import dev.langchain4j.model.chat.response.ChatResponse;","+import jakarta.annotation.Nullable;","+import lombok.NonNull;","+import lombok.RequiredArgsConstructor;","+","+@RequiredArgsConstructor","+class BedrockConverseChatModel implements ChatModel {","+","+    private final @NonNull BedrockConverseClient client;","+    private final @NonNull String modelId;","+    private final @NonNull ChatRequestParameters defaultRequestParameters;","+    private final @Nullable JsonNode customParameters;","+","+    @Override","+    public ChatRequestParameters defaultRequestParameters() {","+        return defaultRequestParameters;","+    }","+","+    @Override","+    public ChatResponse doChat(ChatRequest chatRequest) {","+        var response = client.converse(modelId,","+                BedrockConverseMapper.toConverseRequest(chatRequest.messages(), chatRequest.parameters(),","+                        customParameters));","+        return BedrockConverseMapper.toChatResponse(response, modelId);","+    }","+}"],"additions":32,"deletions":0,"truncated":false},{"path":"apps/opik-backend/src/main/java/com/comet/opik/infrastructure/llm/customllm/BedrockConverseClient.java","lines":["@@ -0,0 +1,56 @@","+package com.comet.opik.infrastructure.llm.customllm;","+","+import com.comet.opik.utils.JsonUtils;","+import com.fasterxml.jackson.databind.JsonNode;","+import com.fasterxml.jackson.databind.node.ObjectNode;","+import dev.langchain4j.http.client.HttpClient;","+import dev.langchain4j.http.client.HttpMethod;","+import dev.langchain4j.http.client.HttpRequest;","+import dev.langchain4j.http.client.sse.ServerSentEventListener;","+import lombok.NonNull;","+import lombok.RequiredArgsConstructor;","+import org.apache.commons.lang3.StringUtils;","+","+import java.net.URLEncoder;","+import java.nio.charset.StandardCharsets;","+","+@RequiredArgsConstructor","+class BedrockConverseClient {","+","+    private final @NonNull HttpClient httpClient;","+    private final @NonNull String baseUrl;","+    private final String apiKey;","+","+    JsonNode converse(@NonNull String modelId, @NonNull ObjectNode body) {","+        var response = JsonUtils.getJsonNodeFromStringWithFallback(","+                httpClient.execute(request(modelId, \"converse\", body)).body());","+        // Bedrock answers a path it doesn't serve with a 200 and {\"Output\": {\"__type\": \"...UnknownOperationException\"}}","+        if (!response.path(\"output\").path(\"message\").isObject()) {","+            throw new ProviderRequestRefusedException(ProviderRequestRefusedException.Reason.BEDROCK_CONVERSE_URL);","+        }","+        return response;","+    }","+","+    void converseStream(@NonNull String modelId, @NonNull ObjectNode body, @NonNull ServerSentEventListener listener) {","+        httpClient.execute(request(modelId, \"converse-stream\", body), new AwsEventStreamParser(), listener);","+    }","+","+    // In token mode there is no static key: InterceptingHttpClient puts the fetched token in Authorization.","+    private HttpRequest request(String modelId, String operation, ObjectNode body) {","+        var request = HttpRequest.builder()","+                .method(HttpMethod.POST)","+                .url(\"%s/model/%s/%s\".formatted(baseUrl, encodePathSegment(modelId), operation))","+                .addHeader(\"Content-Type\", \"application/json\")","+                .body(JsonUtils.writeValueAsString(body));","+        if (StringUtils.isNotBlank(apiKey)) {","+            request.addHeader(\"Authorization\", \"Bearer \" + apiKey);","+        }","+        return request.build();","+    }","+","+    // An inference profile ARN has slashes, which must stay inside the one path segment; the colon of a version","+    // suffix (-v1:0) is valid in a path and is kept as Bedrock's own examples show it.","+    private static String encodePathSegment(String modelId) {","+        return URLEncoder.encode(modelId, StandardCharsets.UTF_8).replace(\"+\", \"%20\").replace(\"%3A\", \":\");","+    }","+}"],"additions":5