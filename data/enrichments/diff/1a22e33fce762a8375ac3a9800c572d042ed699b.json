 except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+package krt_test","+","+import (","+\t\"fmt\"","+\t\"testing\"","+","+\tcorev1 \"k8s.io/api/core/v1\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+","+\t\"istio.io/istio/pkg/kube\"","+\t\"istio.io/istio/pkg/kube/kclient\"","+\t\"istio.io/istio/pkg/kube/kclient/clienttest\"","+\t\"istio.io/istio/pkg/kube/krt\"","+\t\"istio.io/istio/pkg/slices\"","+\t\"istio.io/istio/pkg/test\"","+\t\"istio.io/istio/pkg/test/util/assert\"","+\t\"istio.io/istio/tests/util/leak\"","+)","+","+// leakSources holds a set of long-lived source collections used by the leak","+// tests below. These collections outlive the derived collections under test, so","+// any handler registration a derived collection leaves behind on them (after it","+// is stopped) shows up as a leaked goroutine.","+type leakSources struct {","+\topts        krt.OptionsBuilder","+\tstop        <-chan struct{}","+\tpods        krt.Collection[SimplePod]","+\tservices    krt.Collection[SimpleService]","+\trawServices krt.Collection[*corev1.Service]","+}","+","+// setupLeakSources builds long-lived pod and service collections seeded with a","+// single matching pod/service, and returns them along with the shared options","+// and stop channel.","+func setupLeakSources(t *testing.T) leakSources {","+\tstop := test.NewStop(t)","+\topts := testOptions(t)","+\tc := kube.NewFakeClient()","+","+\tkpc := kclient.New[*corev1.Pod](c)","+\tpc := clienttest.Wrap(t, kpc)","+\tpods := krt.WrapClient(kpc, opts.WithName(\"Pods\")...)","+","+\tksc := kclient.New[*corev1.Service](c)","+\tsc := clienttest.Wrap(t, ksc)","+\tservices := krt.WrapClient(ksc, opts.WithName(\"Services\")...)","+\tc.RunAndWait(stop)","+","+\tSimplePods := SimplePodCollection(pods, opts)","+\tSimpleServices := SimpleServiceCollection(services, opts)","+\tassert.Equal(t, SimplePods.WaitUntilSynced(stop), true)","+\tassert.Equal(t, SimpleServices.WaitUntilSynced(stop), true)","+","+\tpc.Create(&corev1.Pod{","+\t\tObjectMeta: metav1.ObjectMeta{Name: \"pod\", Namespace: \"ns\", Labels: map[string]string{\"app\": \"foo\"}},","+\t\tStatus:     corev1.PodStatus{PodIP: \"1.2.3.4\"},","+\t})","+\tsc.Create(&corev1.Service{","+\t\tObjectMeta: metav1.ObjectMeta{Name: \"svc\", Namespace: \"ns\"},","+\t\tSpec:       corev1.ServiceSpec{Selector: map[string]string{\"app\": \"foo\"}},","+\t})","+","+\treturn leakSources{opts: opts, stop: stop, pods: SimplePods, services: SimpleServices, rawServices: services}","+}","+","+// TestCollectionDependencyLeak verifies that stopping a derived NewManyCollection","+// (via its own stop channel), while the collections it depends on remain alive,","+// does not leak the handler registrations (and their goroutines) it created on","+// those collections -- both the primary parent subscription and any Fetch","+// dependency subscriptions.","+func TestCollectionDependencyLeak(t *testing.T) {","+\ts := setupLeakSources(t)","+\tleak.Check(t)","+","+\tconst iterations = 20","+\tfor i := 0; i < iterations; i++ {","+\t\tderivedStop := make(chan struct{})","+\t\tendpoints := krt.NewManyCollection(","+\t\t\ts.services,","+\t\t\tfunc(ctx krt.HandlerContext, svc SimpleService) []SimpleEndpoint {","+\t\t\t\tmatched := krt.Fetch(ctx, s.pods, krt.FilterLabel(svc.Selector))","+\t\t\t\treturn slices.Map(matched, func(pod SimplePod) SimpleEndpoint {","+\t\t\t\t\treturn SimpleEndpoint{Pod: pod.Name, Service: svc.Name, Namespace: svc.Namespace, IP: pod.IP}","+\t\t\t\t})","+\t\t\t},","+\t\t\ts.opts.With(krt.WithName(\"Endpoints\"), krt.WithStop(derivedStop))...,","+\t\t)","+\t\tassert.Equal(t, endpoints.WaitUntilSynced(s.stop), true)","+\t\tassert.EventuallyEqual(t, func() int { return len(endpoints.List()) }, 1)","+\t\tclose(derivedStop)","+\t}","+}","+","+// TestMergeJoinCollectionLeak verifies that stopping a JoinWithMergeCollection","+// does not leak the handler registrations it created on its (still-alive) source","+// collections.","+func TestMergeJoinCollectionLeak(t *testing.T) {","+\ts := setupLeakSources(t)","+\tleak.Check(t)","+","+\tmerge := func(ts []SimplePod) *SimplePod { return &ts[0] }","+","+\tconst iterations = 20","+\tfor i := 0; i < iterations; i++ {","+\t\tderivedStop := make(chan struct{})","+\t\tmerged := krt.JoinWithMergeCollection(","+\t\t\t[]krt.Collection[SimplePod]{s.pods},","+\t\t\tmerge,","+\t\t\ts.opts.With(krt.WithName(\"MergedPods\"), krt.WithStop(derivedStop))...,","+\t\t)","+\t\tassert.Equal(t, merged.WaitUntilSynced(s.stop), true)","+\t\tassert.EventuallyEqual(t, func() int { return len(merged.List()) }, 1)","+\t\tclose(derivedStop)","+\t}","+}","+","+// TestNestedJoinWithMergeCollectionLeak verifies that stopping a","+// NestedJoinWithMergeCollection does not leak the handler registrations it created","+// on the (still-alive) container collection or its sub-collections.","+func TestNestedJoinWithMergeCollectionLeak(t *testing.T) {","+\ts := setupLeakSources(t)","+","+\t// A long-lived container collection holding a single sub-collection.","+\tmulti := krt.NewStaticCollection(","+\t\tnil,","+\t\t[]krt.Collection[SimplePod]{s.pods},","+\t\ts.opts.WithName(\"MultiPods\")...,","+\t)","+\tassert.Equal(t, multi.WaitUntilSynced(s.stop), true)","+","+\tleak.Check(t)","+","+\tmerge := func(ts []SimplePod) *SimplePod { return &ts[0] }","+","+\tconst iterations = 20","+\tfor i := 0; i < iterations; i++ {","+\t\tderivedStop := make(chan struct{})","+\t\tmerged := krt.NestedJoinWithMergeCollection(","+\t\t\tmulti,","+\t\t\tmerge,","+\t\t\ts.opts.With(krt.WithName(\"NestedMergedPods\"), krt.WithStop(derivedStop))...,","+\t\t)","+\t\tassert.Equal(t, merged.WaitUntilSynced(s.stop), true)","+\t\tassert.EventuallyEqual(t, func() int { return len(merged.List()) }, 1)","+\t\tclose(derivedStop)","+\t}","+}","+","+// TestJoinCollectionLeak guards JoinCollection in checked mode (>=2 sub-collections).","+// Checked joins subscribe to every sub-collection at construction and rely on their","+// own dedicated stop-cleanup goroutine (separate from the manyCollection teardown","+// path) to unregister them; this ensures that cleanup keeps working.","+func TestJoinCollectionLeak(t *testing.T) {","+\tstop := test.NewStop(t)","+\topts := testOptions(t)","+","+\tc1 := krt.NewStaticCollection(nil, []Named{{Namespace: \"ns\", Name: \"a\"}}, opts.WithName(\"Join1\")...)","+\tc2 := krt.NewStaticCollection(nil, []Named{{Namespace: \"ns\", Name: \"b\"}}, opts.WithName(\"Join2\")...)","+\tassert.Equal(t, c1.WaitUntilSynced(stop), true)","+\tassert.Equal(t, c2.WaitUntilSynced(stop), true)","+","+\tleak.Check(t)","+","+\tconst iterations = 20","+\tfor i := 0; i < iterations; i++ {","+\t\tderivedStop := make(chan struct{})","+\t\tjoined := krt.JoinCollection(","+\t\t\t[]krt.Collection[Named]{c1, c2},","+\t\t\topts.With(krt.WithName(\"Joined\"), krt.WithStop(derivedStop))...,","+\t\t)","+\t\tassert.Equal(t, joined.WaitUntilSynced(stop), true)","+\t\tassert.EventuallyEqual(t, func() int { return len(joined.List()) }, 2)","+\t\tclose(derivedStop)","+\t}","+}","+","+// TestJoinCollectionUncheckedLeak guards JoinCollection in unchecked mode. Unchecked","+// joins currently hold no construction-time subscription (handlers register lazily and","+// are caller-owned), so stopping one should leak nothing. This guards against a future","+// change that adds construction-time subscriptions to the unchecked path without","+// wiring up teardown.","+func TestJoinCollectionUncheckedLeak(t *testing.T) {","+\tstop := test.NewStop(t)","+\topts := testOptions(t)","+","+\tc1 := krt.NewStaticCollection(nil, []Named{{Namespace: \"ns\", Name: \"a\"}}, opts.WithName(\"UJoin1\")...)","+\tc2 := krt.NewStaticCollection(nil, []Named{{Namespace: \"ns\", Name: \"b\"}}, opts.WithName(\"UJoin2\")...)","+\tassert.Equal(t, c1.WaitUntilSynced(stop), true)","+\tassert.Equal(t, c2.WaitUntilSynced(stop), true)","+","+\tleak.Check(t)","+","+\tconst iterations = 20","+\tfor i := 0; i < iterations; i++ {","+\t\tderivedStop := make(chan struct{})","+\t\tjoined := krt.JoinCollection(","+\t\t\t[]krt.Collection[Named]{c1, c2},","+\t\t\topts.With(krt.WithName(\"UJoined\"), krt.WithStop(derivedStop), krt.WithJoinUnchecked())...,","+\t\t)","+\t\tassert.Equal(t, joined.WaitUntilSynced(stop), true)","+\t\tassert.EventuallyEqual(t, func() int { return len(joined.List()) }, 2)","+\t\tclose(derivedStop)","+\t}","+}","+","+// TestSingletonCollectionLeak guards NewSingleton, which is implemented on top of a","+// manyCollection (over an internal dummy collection) that Fetches other collections.","+// This ensures the singleton wrapper does not leak the Fetch subscription it makes on a","+// still-alive dependency when it is stopped.","+func TestSingletonCollectionLeak(t *testing.T) {","+\ts := setupLeakSources(t)","+\tleak.Check(t)","+","+\tconst iterations = 20","+\tfor i := 0; i < iterations; i++ {","+\t\tderivedStop := make(chan struct{})","+\t\tsingle := krt.NewSingleton(","+\t\t\tfunc(ctx krt.HandlerContext) *Named {","+\t\t\t\tpods := krt.Fetch(ctx, s.pods)","+\t\t\t\treturn &Named{Namespace: \"ns\", Name: fmt.Sprintf(\"count-%d\", len(pods))}","+\t\t\t},","+\t\t\ts.opts.With(krt.WithName(\"Singleton\"), krt.WithStop(derivedStop))...,","+\t\t)","+\t\tassert.Equal(t, single.AsCollection().WaitUntilSynced(s.stop), true)","+\t\tassert.EventuallyEqual(t, func() *Named { return single.Get() }, &Named{Namespace: \"ns\", Name: \"count-1\"})","+\t\tclose(derivedStop)","+\t}","+}","+","+// TestStatusCollectionLeak guards NewStatusCollection, another public constructor built","+// on manyCollection. It subscribes to its parent input and Fetches a dependency; stopping","+// it must unregister both from the still-alive inputs.","+func TestStatusCollectionLeak(t *testing.T) {","+\ts := setupLeakSources(t)","+\tleak.Check(t)","+","+\tconst iterations = 20","+\tfor i := 0; i < iterations; i++ {","+\t\tderivedStop := make(chan struct{})","+\t\t_, primary := krt.NewStatusCollection(","+\t\t\ts.rawServices,","+\t\t\tfunc(ctx krt.HandlerContext, svc *corev1.Service) (*string, *Named) {","+\t\t\t\tpods := krt.Fetch(ctx, s.pods, krt.FilterLabel(svc.Spec.Selector))","+\t\t\t\tif len(pods) == 0 {","+\t\t\t\t\tst := \"empty\"","+\t\t\t\t\treturn &st, nil","+\t\t\t\t}","+\t\t\t\tst := \"ok\"","+\t\t\t\treturn &st, &Named{Namespace: svc.Namespace, Name: svc.Name}","+\t\t\t},","+\t\t\ts.opts.With(krt.WithName(\"Status\"), krt.WithStop(derivedStop))...,","+\t\t)","+\t\tassert.Equal(t, primary.WaitUntilSynced(s.stop), true)","+\t\tassert.EventuallyEqual(t, func() int { return len(primary.List()) }, 1)","+\t\tclose(derivedStop)","+\t}","+}"],"additions":271,"deletions":0,"truncated":false},{"path":"pkg/kube/krt/fetch.go","lines":["@@ -84,7 +84,7 @@ func fetch[T any](ctx HandlerContext, cc Collection[T], allowMissingContext bool"," \tif ctx != nil {"," \t\th := ctx.(registerDependency)"," \t\t// Important: register before we List(), so we cannot miss any events","-\t\th.registerDependency(d, c, func(f erasedEventHandler) Syncer {","+\t\th.registerDependency(d, c, func(f erasedEventHandler) HandlerRegistration {"," \t\t\tff := func(o []Event[T]) {"," \t\t\t\tf(slices.Map(o, castEvent[T, any]))"," \t\t\t}"],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/kube/krt/internal.go","lines":["@@ -110,7 +110,7 @@ type erasedEventHandler = func(o []Event[any])"," // This is called from Fetch to Collections, generally."," type registerDependency interface {"," \t// Registers a dependency, returning true if it is finalized","-\tregisterDependency(*dependency, Syncer, func(f erasedEventHandler) Syncer)","+\tregisterDependency(*dependency, Syncer, func(f erasedEventHandler) HandlerRegistration)"," \tname() string"," }"," "],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/kube/krt/mergejoin.go","lines":["@@ -377,6 +377,13 @@ func (j *mergejoin[T]) runQueue() {"," \t\t\t})"," \t\t}, true))"," \t}","+\t// These registrations were made on collections that may outlive us. Once we are stopped,","+\t// unregister them.","+\tdefer func() {","+\t\tfor _, reg := range regs {","+\t\t\treg.UnregisterHandler()","+\t\t}","+\t}()"," "," \tsyncers = slices.Map(regs, func(r HandlerRegistration) cache.InformerSynced {"," \t\treturn r.HasSynced"],"additions":7,"deletions":0,"truncated":false},{"path":"pkg/kube/krt/nestedjoinmerge.go","lines":["@@ -142,6 +142,11 @@ func NestedJoinWithMergeCollection[T any](collections Collection[Collection[T]],"," }"," "," func (j *nestedjoinmerge[T]) runQueue(initialCollections []Collection[T], subscriptionFunc func([]Event[T]), reg HandlerRegistration) {","+\t// We subscribed to the container collection (reg) and to each sub-collection (j.regs); all of","+\t// these may outlive us. Once we are stopped, unregister them (and their goroutines) so we don't","+\t// leak them.","+\tdefer j.unregisterAll(reg)","+"," \t// Wait for the container of collections to be synced before we start processing events."," \tif !j.collections.WaitUntilSynced(j.stop) {"," \t\treturn","@@ -168,6 +173,21 @@ func (j *nestedjoinmerge[T]) runQueue(initialCollections []Collection[T], subscr"," \tj.queue.Run(j.stop)"," }"," ","+// unregisterAll unregisters the container collection subscription along with all currently tracked","+// sub-collection subscriptions. It is safe to call once the collection has stopped; after","+// unregistering the container subscription no new sub-collection subscriptions can be added.","+func (j *nestedjoinmerge[T]) unregisterAll(containerReg HandlerRegistration) {","+\tj.mu.Lock()","+\tdefer j.mu.Unlock()","+\t// Unregister the container subscription first so no further sub-collection subscriptions are added.","+\tcontainerReg.UnregisterHandler()","+\tfor uid, reg := range j.regs {","+\t\treg.UnregisterHandler()","+\t\t// we need to delete the entry to play nice with handleCollectionDelete","+\t\tdelete(j.regs, uid)","+\t}","+}","+"," func (j *nestedjoinmerge[T]) handleCollectionUpdate(e Event[Collection[T]]) {"," \tinnerCollection := e.Latest().(internalCollection[T])"," \tlog.Debugf(\"NestedJoinWithMergeCollection: Collection %s (uid %s) updated, recalculating merged values\", innerCollection.name(), innerCollection.uid())"],"additions":20,"deletions":0,"truncated":false},{"path":"pkg/kube/krt/testing.go","lines":["@@ -19,7 +19,7 @@ type TestingDummyContext struct{}"," func (t TestingDummyContext) _internalHandler() {"," }"," ","-func (t TestingDummyContext) registerDependency(d *dependency, s Syncer, f func(f erasedEventHandler) Syncer) {","+func (t TestingDummyContext) registerDependency(d *dependency, s Syncer, f func(f erasedEventHandler) HandlerRegistration) {"," }"," "," func (t TestingDummyContext) name() string {"],"additions":1,"deletions":1,"truncated":false},{"path":"releasenotes/notes/krt-collection-teardown-leaks.yaml","lines":["@@ -0,0 +1,11 @@","+apiVersion: release-notes/v2","+kind: bug-fix","+area: traffic-management","+issue:","+  - 60033","+releaseNotes:","+  - |","+    **Fixed** goroutine and memory leaks in istiod in ambient multi-cluster mode when remote","+    clusters are removed or updated. The internal collections built for each remote cluster did","+    not release the event handlers they had registered on their inputs when torn down, causing","+    goroutines and memory to accumulate over time as clusters were removed or reconfigured.",""],"additions":11,"deletions":0,"truncated":false}],"additions":343,"deletions":10,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-08-15T07:57:23.330026+00:00"}