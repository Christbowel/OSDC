{"id":"1a22e33fce762a8375ac3a9800c572d042ed699b","axis":"silent","repo":"istio/istio","sha":"1a22e33fce762a8375ac3a9800c572d042ed699b","parsed":{"files":[{"path":"pkg/kube/krt/collection.go","lines":["@@ -42,7 +42,8 @@ type dependencyState[I any] struct {"," \t// collectionDependencies specifies the set of collections we depend on from within the transformation functions (via Fetch)."," \t// These are keyed by the internal uid() function on collections."," \t// Note this does not include `parent`, which is the *primary* dependency declared outside of transformation functions.","-\tcollectionDependencies sets.Set[collectionUID]","+\tcollectionDependencies       sets.Set[collectionUID]","+\tcollectionDependencyHandlers map[collectionUID]HandlerRegistration"," \t// Stores a map of I -> secondary dependencies (added via Fetch)"," \tobjectDependencies  map[Key[I]][]*dependency"," \tindexedDependencies map[indexedDependency]sets.Set[Key[I]]","@@ -608,6 +609,7 @@ func newManyCollection[I, O any]("," \t\tparent:         c,"," \t\tdependencyState: dependencyState[I]{"," \t\t\tcollectionDependencies:       sets.New[collectionUID](),","+\t\t\tcollectionDependencyHandlers: map[collectionUID]HandlerRegistration{},"," \t\t\tobjectDependencies:           map[Key[I]][]*dependency{},"," \t\t\tindexedDependencies:          map[indexedDependency]sets.Set[Key[I]]{},"," \t\t\tindexedDependenciesExtractor: map[extractorKey]func(o any) []string{},","@@ -656,7 +658,7 @@ func (h *manyCollection[I, O]) runQueue() {"," \t\treturn"," \t}"," \t// Now register to our primary collection. On any event, we will enqueue the update.","-\tsyncer := c.RegisterBatch(func(o []Event[I]) {","+\tparentReg := c.RegisterBatch(func(o []Event[I]) {"," \t\tif h.onPrimaryInputEventHandler != nil {"," \t\t\th.onPrimaryInputEventHandler(o)"," \t\t}","@@ -666,9 +668,22 @@ func (h *manyCollection[I, O]) runQueue() {"," \t\t})"," \t}, true)"," \t// Wait for everything initial state to be enqueued","-\tif !syncer.WaitU