he package once, whether through `import` or","+`require()`, so every consumer in a process shares one bus.","+","+Ghost's test runners are the exception: they would load a second copy for","+tests that `import` the package. Ghost's vitest configs alias the package to","+`ghost/test/utils/domain-events-bridge.ts` to keep it to one.","+","+## Develop","+","+From the package directory:","+","+```bash","+pnpm build   # compile to build/ with tsc (ESM)","+pnpm test    # type-check + unit tests","+pnpm lint    # lint source and tests","+```","+","+Run `pnpm build` before `pnpm test`. One test loads the compiled package through","+`require()`, the way Ghost's CommonJS code does, so it needs `build/` to exist.","+","+Through Nx, only the `test:unit` target builds first:","+`pnpm nx run @tryghost/domain-events:test:unit`. The `test` target runs the","+package script directly and does not, so it needs `pnpm build` beforehand too."],"additions":46,"deletions":11,"truncated":false},{"path":"packages/domain-events/eslint.config.mjs","lines":["@@ -1,16 +1,3 @@"," import { nodeLibConfig } from '@internal/cfg-eslint';"," ","-// The imported files keep their PascalCase names (src/DomainEvents.js and its","-// test) because Ghost deep-imports `@tryghost/domain-events/lib/DomainEvents`.","-// Renaming belongs to the modernization follow-up, so the filename rule is off","-// until then.","-const legacyFilenames = { 'ghost/filenames/match-regex': 'off' };","-","-export default nodeLibConfig({","-  typescript: false,","-  commonjs: true,","-  srcGlobs: ['index.js', 'src/**/*.js'],","-  testGlobs: ['test/**/*.js'],","-  extraSrcRules: legacyFilenames,","-  extraTestRules: legacyFilenames,","-});","+export default nodeLibConfig();"],"additions":1,"deletions":14,"truncated":false},{"path":"packages/domain-events/index.d.ts","lines":["@@ -1,3 +0,0 @@","-import DomainEvents = require('./src/DomainEvents');","-","-export = DomainEvents;"],"additions":0,"deletions":3,"truncated":false},{"path"