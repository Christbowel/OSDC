{"id":"7898707481e59d4f4922f6709c71730d53abb894","axis":"silent","repo":"mongodb/mongo","sha":"7898707481e59d4f4922f6709c71730d53abb894","parsed":{"files":[{"path":"jstests/noPassthrough/validate/validation_metrics.js","lines":["@@ -0,0 +1,164 @@","+/**","+ * Verifies the metrics log line emitted at the end of every collection validation, from both the","+ * 'validate' command and startup '--validate' (fleet validation). Checks that:","+ *   - each validation emits exactly one line carrying the collection's identity, mode, completion","+ *     status and validity,","+ *   - every validation, full or not, reports every phase 1 timing, the verify timings and non-zero","+ *     data sizes.","+ *","+ * @tags: [","+ *   requires_persistence,","+ *   requires_wiredtiger,","+ * ]","+ */","+import {extractUUIDFromObject, getUUIDFromListCollections} from \"jstests/libs/uuid_util.js\";","+","+const kMetricsLogId = 13618300;","+","+const dbName = jsTestName();","+const collName = jsTestName();","+const kNumDocs = 1000;","+","+const kTimingFields = [","+    \"recordStoreValidateDurationSecs\",","+    \"indexValidateDurationSecs\",","+    \"totalDurationSecs\",","+    \"phase1DurationSecs\",","+    \"recordStoreTraversalDurationSecs\",","+    \"indexTraversalDurationSecs\",","+];","+","+// Asserts 'lines' holds exactly one metrics line for our collection with its shared fields","+// populated. Returns the metrics.","+function checkCollectionMetrics(lines, expectedMode) {","+    jsTest.log.info(\"Collected validation metrics\", {lines});","+    const ours = lines.filter((attr) => attr.namespace === `${dbName}.${collName}`);","+    assert.eq(1, ours.length, \"expected exactly one metrics line for the collection\", {lines});","+    const attr = ours[0];","+    assert.eq(collUUID, attr.uuid.uuid.$uuid, attr);","+    assert.eq(expectedMode, attr.mode, attr);","+    assert.eq(true, attr.completed, attr);","+    assert.eq(0, attr.status.code, attr);","+    assert.eq(true, attr.valid, attr);","+","+    const m = attr.metrics;","+    assert.eq(false, m.isTimeseries, m);","+    for (const field of kTimingFields) {","+        assert(m.hasOwnProperty(field), `missing ${field}`, m);","+        assert.gte(m[field], 0, `negative ${field}`, m);","+    }","+    assert.gte(m.totalDurationSecs, m.phase1DurationSecs, m);","+    assert.gte(","+        m.phase1DurationSecs,","+        m.recordStoreTraversalDurationSecs + m.indexTraversalDurationSecs,","+        m,","+    );","+    // No index inconsistencies, so the second phase never runs.","+    assert(!m.hasOwnProperty(\"phase2DurationSecs\"), m);","+    assert.gt(m.recordStoreDataSize, 0, m);","+    assert.gt(m.indexDataSize, 0, m);","+    return m;","+}","+","+let conn = MongoRunner.runMongod();","+const db = conn.getDB(dbName);","+const coll = db.getCollection(collName);","+{","+    let bulk = coll.initializeUnorderedBulkOp();","+    for (let i = 0; i < kNumDocs; i++) {","+        bulk.insert({_id: i, a: i});","+    }","+    assert.commandWorked(bulk.execute());","+}","+assert.commandWorked(coll.createIndex({a: 1}));","+const collUUID = extractUUIDFromObject(getUUIDFromListCollections(db, collName));","+","+// The 'attr' object of every metrics log line in the global log since the last clearLog.","+function getMetricAttrsFromGlobalLog() {","+    const globalLog = assert.commandWorked(conn.adminCommand({getLog: \"global\"})).log;","+    return globalLog","+        .map((line) => JSON.parse(line))","+        .filter((entry) => entry.id === kMetricsLogId)","+        .map((entry) => entry.attr);","+}","+","+// The 'validate' command emits the line too.","+assert.commandWorked(conn.adminCommand({clearLog: \"global\"}));","+const fullRes = assert.commandWorked(coll.validate({full: true}));","+const commandFull = checkCollectionMetrics(getMetricAttrsFromGlobalLog(), \"foregroundFull\");","+// The reply carries the traversed record bytes too, as they depend only on the data.","+assert.eq(fullRes.dataSize, commandFull.recordStoreDataSize, {fullRes, commandFull});","+const replyKeyBytes = Object.values(fullRes.indexDetails).reduce(","+    (sum, idx) => sum + idx.keyBytes,","+    0,","+);","+assert.eq(replyKeyBytes, commandFull.indexDataSize, {fullRes, commandFull});","+","+assert.commandWorked(conn.adminCommand({clearLog: \"global\"}));","+assert.commandWorked(coll.validate());","+checkCollectionMetrics(getMetricAttrsFromGlobalLog(), \"foreground\");","+","+const dbpath = conn.dbpath;","+const port = conn.port;","+MongoRunner.stopMongod(conn);","+","+// Runs 'mongod --validate' scoped to our collection with the given inner options, asserts a clean","+// exit, and returns the 'attr' object of every metrics log line from the raw output.","+function runModalValidate(innerOptions, {logId = kMetricsLogId, extraArgs = []} = {}) {","+    clearRawMongoProgramOutput();","+    const exitCode = runMongoProgram(","+        \"mongod\",","+        \"--validate\",","+        \"--port\",","+        port,","+        \"--dbpath\",","+        dbpath,","+        \"--setParameter\",","+        `validateDbName=${dbName}`,","+        \"--setParameter\",","+        `validateCollectionName=${collName}`,","+        \"--setParameter\",","+        `collectionValidateOptions={options: ${innerOptions}}`,","+        ...extraArgs,","+    );","+    assert.eq(","+        MongoRunner.EXIT_CLEAN,","+        exitCode,","+        `modal '--validate' with options ${innerOptions} did not exit cleanly`,","+    );","+    return rawMongoProgramOutput(\"(\" + logId + \")\")","+        .split(\"\\n\")","+        .filter((line) => line.trim() !== \"\")","+        .map((line) => {","+            try {","+                return JSON.parse(line.split(\"|\").slice(1).join(\"|\"));","+            } catch (e) {","+                return null;","+            }","+        })","+        .filter((entry) => entry && entry.id === logId)","+        .map((entry) => entry.attr);","+}","+","+// Startup '--validate' emits the line for both full and non-full validation.","+const offlineFull = checkCollectionMetrics(runModalValidate(\"{full: true}\"), \"foregroundFull\");","+const offlineNonFull = checkCollectionMetrics(runModalValidate(\"{full: false}\"), \"foreground\");","+","+// The traversed bytes depend only on the data, not on the mode or how validation was launched.","+assert.eq(commandFull.recordStoreDataSize, offlineFull.recordStoreDataSize);","+assert.eq(commandFull.indexDataSize, offlineFull.indexDataSize);","+assert.eq(offlineFull.recordStoreDataSize, offlineNonFull.recordStoreDataSize);","+assert.eq(offlineFull.indexDataSize, offlineNonFull.indexDataSize);","+","+// Startup '--validate' reports each validation as an operation, like the 'validate' command does.","+const kSlowQueryLogId = 51803;","+const slowOps = runModalValidate(\"{full: true}\", {","+    logId: kSlowQueryLogId,","+    extraArgs: [\"--slowms\", \"0\"],","+}).filter((attr) => attr.ns === `${dbName}.${collName}`);","+assert.eq(1, slowOps.length, \"expected exactly one slow operation line for the collection\", {","+    slowOps,","+});","+assert.eq(collName, slowOps[0].command.validate, slowOps[0]);","+assert.eq(true, slowOps[0].command.full, slowOps[0]);","+assert(slowOps[0].hasOwnProperty(\"durationMillis\"), \"missing durationMillis\", slowOps[0]);"],"additions":164,"deletions":0,"truncated":false},{"path":"jstests/sharding/mongos_unsharded_commands_interface_parity_with_replica_set.js","lines":["@@ -106,6 +106,10 @@ function removeInconsistentFields(res) {","     if (res.hasOwnProperty(\"repairMode\")) {","         delete res[\"repairMode\"];","     }","+    // Not reported by shards on binaries older than this field.","+    if (res.hasOwnProperty(\"dataSize\")) {","+        delete res[\"dataSize\"];","+    }"," }"," "," const tests = ["],"additions":4,"deletions":0,"truncated":false},{"path":"src/mongo/db/startup_recovery.cpp","lines":["@@ -9,7 +9,9 @@"," #include \"mongo/bson/bsonobj.h\""," #include \"mongo/bson/bsonobjbuilder.h\""," #include \"mongo/db/change_stream_pre_image_util.h\"","+#include \"mongo/db/commands.h\""," #include \"mongo/db/commands/feature_compatibility_version.h\"","+#include \"mongo/db/curop.h\""," #include \"mongo/db/database_name.h\""," #include \"mongo/db/dbhelpers.h\""," #include \"mongo/db/exec/scoped_timer.h\"","@@ -27,6 +29,7 @@"," #include \"mongo/db/mongod_options_storage_gen.h\""," #include \"mongo/db/namespace_string.h\""," #include \"mongo/db/operation_context.h\"","+#include \"mongo/db/profile_settings.h\""," #include \"mongo/db/repair.h\""," #include \"mongo/db/repl/read_concern_args.h\""," #include \"mongo/db/repl/repl_set_member_in_standalone_mode.h\"","@@ -741,6 +744,43 @@ void startupRepair(OperationContext* opCtx,","     }"," }"," ","+/**","+ * Runs collection_validation::validate() as its own operation, so that a validation slower than","+ * 'slowms' reports the same \"Slow query\" log line as the 'validate' command. 'validateOptions' are","+ * the options the validation was configured with, reported as part of the command.","+ */","+Status validateAndLogOperation(OperationContext* opCtx,","+                               const NamespaceString& nss,","+                               const BSONObj& validateOptions,","+                               const collection_validation::ValidationOptions& options,","+                               ValidateResults& results) {","+    CurOp curOp;","+    curOp.push(opCtx);","+    {","+        BSONObjBuilder cmdObj;","+        cmdObj.append(\"validate\", nss.coll());","+        cmdObj.appendElementsUnique(validateOptions);","+        ClientLock lk(opCtx->getClient());","+        // The registered command lets the log line redact and report the command as it does for","+        // the 'validate' command.","+        curOp.setGenericOpRequestDetails(","+            lk, nss, CommandHelpers::findCommand(opCtx, \"validate\"), cmdObj.obj(), dbMsg);","+    }","+    curOp.ensureStarted();","+    ON_BLOCK_EXIT([&] {","+        try {","+            curOp.completeAndLogOperation(","+                {logv2::LogComponent::kCommand, toLogService(opCtx->getService())},","+                DatabaseProfileSettings::get(opCtx->getServiceContext())","+                    .getDatabaseProfileSettings(nss.dbName())","+                    .filter);","+        } catch (const DBException& e) {","+            LOGV2(13618301, \"Unable to log offline validation operation\", \"error\"_attr = e);","+        }","+    });","+    return collection_validation::validate(opCtx, nss, options, results);","+}","+"," // Performs collection validation for a singular collection."," // Returns if the collection is valid, or the validation didn't complete correctly."," StatusWith<bool> offlineValidateCollection(OperationContext* opCtx,","@@ -776,7 +816,8 @@ StatusWith<bool> offlineValidateCollection(OperationContext* opCtx,","     }","     ValidateResults validateResults;","     try {","-        Status status = collection_validation::validate(opCtx, nss, parsedOptions, validateResults);","+        Status status =","+            validateAndLogOperation(opCtx, nss, validateOptions, parsedOptions, validateResults);"," ","         if (!status.isOK()) {","             LOGV2_ERROR(11790200,"],"additions":42,"deletions":1,"truncated":false},{"path":"src/mongo/db/validate/collection_validation.cpp","lines":["@@ -11,6 +11,7 @@"," #include \"mongo/client/read_preference.h\""," #include \"mongo/db/auth/validated_tenancy_scope.h\""," #include \"mongo/db/basic_types_gen.h\"","+#include \"mongo/db/curop.h\""," #include \"mongo/db/index/index_access_method.h\""," #include \"mongo/db/index/multikey_paths.h\""," #include \"mongo/db/index_key_validate.h\"","@@ -50,6 +51,7 @@"," #include \"mongo/util/fail_point.h\""," #include \"mongo/util/scopeguard.h\""," #include \"mongo/util/str.h\"","+#include \"mongo/util/timer.h\""," #include \"mongo/util/uuid.h\""," "," #include <algorithm>","@@ -986,6 +988,78 @@ ValidationOptions parseValidateOptions(OperationContext* opCtx,","             sizeStats};"," }"," ","+namespace {","+","+/**","+ * Timings describing the cost of each stage of a collection validation. A field is only populated","+ * if validation reached the corresponding stage. These vary between otherwise identical","+ * validations, so they are logged rather than kept in ValidateResults.","+ */","+struct ValidationMetrics {","+    // Whether the collection is a time-series collection. Only known once the collection is found.","+    boost::optional<bool> isTimeseries;","+    // Wall-clock time spent in collection_validation::validate().","+    boost::optional<Microseconds> totalDuration;","+    // Time spent validating the internal structure of the record store. Only full validation runs","+    // WT_SESSION::verify, so this is much smaller otherwise.","+    boost::optional<Microseconds> recordStoreValidateDuration;","+    // Time spent validating the internal structure of all indexes. Only full validation runs","+    // WT_SESSION::verify, so this is much smaller otherwise.","+    boost::optional<Microseconds> indexValidateDuration;","+    // Time spent in the first phase of index consistency checks, which covers the record store and","+    // index traversals.","+    boost::optional<Microseconds> phase1Duration;","+    boost::optional<Microseconds> recordStoreTraversalDuration;","+    boost::optional<Microseconds> indexTraversalDuration;","+    // Time spent in the second phase, which only runs when index inconsistencies are found.","+    boost::optional<Microseconds> phase2Duration;","+","+    /**","+     * Serializes the metrics along with the bytes traversed, as recorded in 'results'.","+     */","+    BSONObj toBSON(const ValidateResults& results) const {","+        BSONObjBuilder bob;","+        if (isTimeseries) {","+            bob.append(\"isTimeseries\", *isTimeseries);","+        }","+        // Durations are reported in whole seconds, as the validations they are meant to track run","+        // for hours to days.","+        appendSeconds(bob, \"totalDurationSecs\", totalDuration);","+        appendSeconds(bob, \"recordStoreValidateDurationSecs\", recordStoreValidateDuration);","+        appendSeconds(bob, \"indexValidateDurationSecs\", indexValidateDuration);","+        appendSeconds(bob, \"phase1DurationSecs\", phase1Duration);","+        appendSeconds(bob, \"recordStoreTraversalDurationSecs\", recordStoreTraversalDuration);","+        appendSeconds(bob, \"indexTraversalDurationSecs\", indexTraversalDuration);","+        appendSeconds(bob, \"phase2DurationSecs\", phase2Duration);","+        // The sizes come from ValidateResults, where they are also reported in the result object.","+        // Startup validation has no command reply, so they are logged too.","+        if (const auto dataSize = results.getDataSize()) {","+            bob.appendNumber(\"recordStoreDataSize\", *dataSize);","+        }","+        // Index key bytes are only accumulated once the index traversal has run.","+        if (indexTraversalDuration) {","+            long long indexDataSize = 0;","+            for (const auto& [_, ivr] : results.getIndexResultsMap()) {","+                indexDataSize += ivr.getKeyBytesTraversed();","+            }","+            bob.appendNumber(\"indexDataSize\", indexDataSize);","+        }","+        return bob.obj();","+    }","+","+private:","+    // Appends 'duration' to 'bob' as a whole number of seconds, if it was recorded.","+    static void appendSeconds(BSONObjBuilder& bob,","+                              std::string_view fieldName,","+                              const boost::optional<Microseconds>& duration) {","+        if (duration) {","+            bob.append(fieldName, durationCount<Seconds>(*duration));","+        }","+    }","+};","+","+}  // namespace","+"," Status validate(OperationContext* opCtx,","                 const NamespaceString& nss,","                 ValidationOptions options,","@@ -993,6 +1067,46 @@ Status validate(OperationContext* opCtx,","     invariant(!shard_role_details::getLocker(opCtx)->isLocked() || storageGlobalParams.repair ||","               storageGlobalParams.validate);"," ","+    // Report the cost of every validation, including those that fail or throw. 'valid' only","+    // describes the collection when 'completed' is true; a validation that stopped early may not","+    // have reached the checks that would have found errors.","+    const ValidateMode mode = options.getValidateMode();","+    Timer totalTimer;","+    ValidationMetrics metrics;","+    // Cleared if validation stopped early because of an exception it reports as a warning or","+    // interruption rather than propagating.","+    bool completed = true;","+    // The status validate() returns, or the error it throws.","+    Status status = Status::OK();","+    const int uncaughtExceptionsAtStart = std::uncaught_exceptions();","+    ScopeGuard logMetrics([&] {","+        metrics.totalDuration = totalTimer.elapsed();","+        // Covers exceptions not recorded in 'status', which are not DBExceptions.","+        const bool threw = std::uncaught_exceptions() > uncaughtExceptionsAtStart;","+        // Surface the failure in the slow query log and profiler entry for this operation.","+        if (!status.isOK()) {","+            CurOp::get(opCtx)->debug().errInfo = status;","+        }","+        LOGV2(13618300,","+              \"Collection validation metrics\",","+              logAttrs(nss),","+              \"uuid\"_attr = results.getUUID(),","+              \"mode\"_attr = toString(mode),","+              \"completed\"_attr = completed && status.isOK() && !threw,","+              \"status\"_attr = status,","+              \"valid\"_attr = results.isValid(),","+              \"metrics\"_attr = metrics.toBSON(results));","+    });","+    // Runs a setup step that fails validation by throwing, recording its error for the metrics.","+    auto recordError = [&](auto&& step) -> decltype(auto) {","+        try {","+            return step();","+        } catch (const DBException& e) {","+            status = e.toStatus();","+            throw;","+        }","+    };","+","     // Foreground validation needs to ignore prepare conflicts, or else it would deadlock.","     // Repair mode cannot use ignore-prepare because it needs to be able to do writes, and there is","     // no danger of deadlock for this mode anyway since it is only used at startup (or in standalone","@@ -1038,14 +1152,17 @@ Status validate(OperationContext* opCtx,","     if (auto readTimestamp = options.getReadTimestamp()) {","         auto replCoord = repl::ReplicationCoordinator::get(opCtx);","         if (replCoord->getSettings().isReplSet()) {","-            uassertStatusOK(replCoord->waitUntilOpTimeForRead(","-                opCtx, repl::ReadConcernArgs::snapshot(*readTimestamp)));","+            recordError([&] {","+                uassertStatusOK(replCoord->waitUntilOpTimeForRead(","+                    opCtx, repl::ReadConcernArgs::snapshot(*readTimestamp)));","+            });","         }","     }"," ","     // This is deliberately outside of the try-catch block, so that any errors thrown in the","     // constructor fail the cmd, as opposed to returning OK with valid:false.","-    ValidateState validateState(opCtx, nss, std::move(options));","+    ValidateState validateState =","+        recordError([&] { return ValidateState(opCtx, nss, std::move(options)); });"," ","     // Relax corruption detection so that we log and continue scanning instead of failing early.","     auto oldDataCorruptionMode =","@@ -1079,14 +1196,16 @@ Status validate(OperationContext* opCtx,","         shard_role_details::getRecoveryUnit(opCtx)->setPrefetching(true);","     }"," ","-    Status status = validateState.initializeCollection(opCtx);","-    uassertStatusOK(status);","+    recordError([&] { uassertStatusOK(validateState.initializeCollection(opCtx)); });","+    metrics.isTimeseries = validateState.getCollection()->isTimeseriesCollection();"," ","     const auto replCoord = repl::ReplicationCoordinator::get(opCtx);","     // Check whether we are allowed to read from this node after acquiring our locks. If we are","     // in a state where we cannot read, we should not run validate.","-    uassertStatusOK(replCoord->checkCanServeReadsFor(","-        opCtx, nss, ReadPreferenceSetting::get(opCtx).canRunOnSecondary()));","+    recordError([&] {","+        uassertStatusOK(replCoord->checkCanServeReadsFor(","+            opCtx, nss, ReadPreferenceSetting::get(opCtx).canRunOnSecondary()));","+    });"," ","     results.setNamespaceString(validateState.nss());","     results.setUUID(validateState.uuid());","@@ -1114,12 +1233,20 @@ Status validate(OperationContext* opCtx,"," ","         // Record store validation code is executed before we open cursors because it may close","         // and/or invalidate all open cursors.","-        validateState.getCollection()->getRecordStore()->validate(","-            *shard_role_details::getRecoveryUnit(opCtx), validateState, &results);","+        {","+            Timer timer;","+            validateState.getCollection()->getRecordStore()->validate(","+                *shard_role_details::getRecoveryUnit(opCtx), validateState, &results);","+            metrics.recordStoreValidateDuration = timer.elapsed();","+        }"," ","         // For full index validation, we validate the internal structure of each index and save","         // the number of keys in the index to compare against _validateIndexes()'s count results.","-        _validateIndexesInternalStructure(opCtx, validateState, results);","+        {","+            Timer timer;","+            _validateIndexesInternalStructure(opCtx, validateState, results);","+            metrics.indexValidateDuration = timer.elapsed();","+        }"," ","         if (!results.isValid()) {","             _reportInvalidResults(opCtx, validateState, results);","@@ -1161,10 +1288,25 @@ Status validate(OperationContext* opCtx,","         // record key (RecordId) matches the cluster key field in the record value (document's","         // cluster key)."," ","-        indexValidator.traverseRecordStore(opCtx,","-                                           results,","-                                           validateState.validationVersion(),","-                                           validateState.getTargetRecordsPerRecordStoreSlice());","+        Timer phase1Timer;","+        {","+            Timer timer;","+            indexValidator.traverseRecordStore(opCtx,","+                                               results,","+                                               validateState.validationVersion(),","+                                               validateState.getTargetRecordsPerRecordStoreSlice());","+            metrics.recordStoreTraversalDuration = timer.elapsed();","+            // The slices traverse on their own operation contexts, so their storage statistics","+            // are added to this operation's to keep its slow operation reporting complete.","+            if (const auto* sliceStats = indexValidator.getSliceStorageStats()) {","+                auto& opStats = CurOp::get(opCtx)->debug().storageStats;","+                if (opStats) {","+                    *opStats += *sliceStats;","+                } else {","+                    opStats = sliceStats->clone();","+                }","+            }","+        }"," ","         if (validateState.isCollHashValidation()) {","             indexValidator.computeMetadataHash(opCtx, validateState.getCollection(), results);","@@ -1216,7 +1358,12 @@ Status validate(OperationContext* opCtx,","         }"," ","         // Validate indexes and check for mismatches.","-        _validateIndexes(opCtx, validateState, indexValidator, results);","+        {","+            Timer timer;","+            _validateIndexes(opCtx, validateState, indexValidator, results);","+            metrics.indexTraversalDuration = timer.elapsed();","+        }","+        metrics.phase1Duration = phase1Timer.elapsed();"," ","         if (indexValidator.haveEntryMismatch()) {","             LOGV2_OPTIONS(20305,","@@ -1224,7 +1371,9 @@ Status validate(OperationContext* opCtx,","                           \"Index inconsistencies were detected. \"","                           \"Starting the second phase of index validation to gather concise errors\",","                           logAttrs(validateState.nss()));","+            Timer phase2Timer;","             _gatherIndexEntryErrors(opCtx, validateState, indexValidator, results);","+            metrics.phase2Duration = phase2Timer.elapsed();","         }"," ","         if (!results.isValid() && !results.continueValidation()) {","@@ -1248,6 +1397,7 @@ Status validate(OperationContext* opCtx,","                       logAttrs(validateState.nss()),","                       logAttrs(validateState.uuid()));","     } catch (const DBException& e) {","+        completed = false;","         auto interruptStatus = opCtx->checkForInterruptNoAssert();","         if (!interruptStatus.isOK() || e.code() == ErrorCodes::Interrupted) {","             LOGV2_OPTIONS(5160301,","@@ -1255,7 +1405,9 @@ Status validate(OperationContext* opCtx,","                           \"Validation interrupted\",","                           logAttrs(validateState.nss()),","                           \"error\"_attr = e.toString());","-            return interruptStatus.isOK() ? e.toStatus() : interruptStatus;","+            status = interruptStatus.isOK() ? e.toStatus() : interruptStatus;","+            // Return a copy, as returning 'status' would move it out before 'logMetrics' runs.","+            return Status(status);","         }"," ","         string err = str::stream() << \"exception during collection validation: \" << e.toString();"],"additions":168,"deletions":16,"truncated":false},{"path":"src/mongo/db/validate/collection_validation_test.cpp","lines":["@@ -13,6 +13,7 @@"," #include \"mongo/bson/timestamp.h\""," #include \"mongo/bson/util/builder.h\""," #include \"mongo/db/client.h\"","+#include \"mongo/db/curop.h\""," #include \"mongo/db/dbhelpers.h\""," #include \"mongo/db/index/index_access_method.h\""," #include \"mongo/db/operation_context.h\"","@@ -44,6 +45,7 @@"," #include \"mongo/db/timeseries/viewless_timeseries_collection_creation_helpers.h\""," #include \"mongo/db/validate/validate_results.h\""," #include \"mongo/db/validate/validate_timeseries.h\"","+#include \"mongo/unittest/log_capture.h\""," #include \"mongo/unittest/server_parameter_guard.h\""," #include \"mongo/unittest/unittest.h\""," #include \"mongo/util/assert_util.h\"","@@ -350,6 +352,231 @@ TEST_F(CollectionValidationTest, Validate) {","                         .numErrors = 0});"," }"," ","+constexpr int kValidationMetricsLogId = 13618300;","+","+/**","+ * Returns the 'metrics' object of every validation metrics log line captured by 'logs'.","+ */","+std::vector<BSONObj> getLoggedMetrics(const unittest::LogCaptureGuard& logs) {","+    std::vector<BSONObj> metrics;","+    for (const auto& line : logs.getBSON()) {","+        if (line[\"id\"].numberInt() == kValidationMetricsLogId) {","+            metrics.push_back(line[\"attr\"][\"metrics\"].Obj().getOwned());","+        }","+    }","+    return metrics;","+}","+","+// Validation logs timings for each stage it reaches and the bytes it traversed.","+TEST_F(CollectionValidationTest, ValidateLogsMetrics) {","+    auto opCtx = operationContext();","+    insertDataRange(opCtx, 0, 5);","+    unittest::LogCaptureGuard logs;","+    const auto results = foregroundValidate(","+        kNss,","+        opCtx,","+        {.valid = true, .numRecords = 5, .numInvalidDocuments = 0, .numErrors = 0},","+        {collection_validation::ValidateMode::kForegroundFull});","+    logs.stop();","+    ASSERT_EQ(results.size(), 1);","+    const auto metrics = getLoggedMetrics(logs);","+    ASSERT_EQ(metrics.size(), 1);","+    const auto& m = metrics[0];","+    for (auto field : {\"totalDurationSecs\",","+                       \"recordStoreValidateDurationSecs\",","+                       \"indexValidateDurationSecs\",","+                       \"phase1DurationSecs\",","+                       \"recordStoreTraversalDurationSecs\",","+                       \"indexTraversalDurationSecs\"}) {","+        EXPECT_TRUE(m.hasField(field)) << field;","+    }","+    // No index inconsistencies, so the second phase never runs.","+    EXPECT_FALSE(m.hasField(\"phase2DurationSecs\"));","+    EXPECT_EQ(m[\"isTimeseries\"].type(), BSONType::boolean) << m;","+    EXPECT_FALSE(m[\"isTimeseries\"].boolean()) << m;","+","+    // The sizes are logged as reported by the results.","+    const auto dataSize = results[0].getDataSize();","+    ASSERT_TRUE(dataSize);","+    EXPECT_GT(*dataSize, 0);","+    EXPECT_EQ(m[\"recordStoreDataSize\"].safeNumberLong(), *dataSize);","+    long long keyBytes = 0;","+    for (const auto& [_, ivr] : results[0].getIndexResultsMap()) {","+        keyBytes += ivr.getKeyBytesTraversed();","+    }","+    EXPECT_GT(keyBytes, 0);","+    EXPECT_EQ(m[\"indexDataSize\"].safeNumberLong(), keyBytes);","+}","+","+// Every call to validate() emits exactly one metrics log line identifying the validation.","+TEST_F(CollectionValidationTest, ValidateLogsMetricsOncePerCall) {","+    auto opCtx = operationContext();","+    unittest::LogCaptureGuard logs;","+    foregroundValidate(kNss,","+                       opCtx,","+                       {.valid = true,","+                        .numRecords = insertDataRange(opCtx, 0, 5),","+                        .numInvalidDocuments = 0,","+                        .numErrors = 0});","+    logs.stop();","+","+    // foregroundValidate() runs one validation per mode.","+    EXPECT_EQ(logs.countBSONContainingSubset(BSON(\"id\" << kValidationMetricsLogId)), 3);","+    EXPECT_EQ(logs.countBSONContainingSubset(","+                  BSON(\"id\" << kValidationMetricsLogId << \"attr\"","+                            << BSON(\"mode\" << \"foregroundFull\"","+                                           << \"completed\" << true << \"valid\" << true))),","+              1);","+    EXPECT_EQ(logs.countBSONContainingSubset(","+                  BSON(\"id\" << kValidationMetricsLogId << \"attr\"","+                            << BSON(\"metrics\" << BSON(\"totalDurationSecs\" << BSONUndefined)))),","+              3);","+}","+","+// Validations that find corruption still report their metrics, flagged as invalid.","+TEST_F(CollectionValidationTest, ValidateLogsMetricsForInvalidCollection) {","+    auto opCtx = operationContext();","+    unittest::LogCaptureGuard logs;","+    foregroundValidate(kNss,","+                       opCtx,","+                       {.valid = false,","+                        .numRecords = setUpInvalidData(opCtx),","+                        .numInvalidDocuments = 1,","+                        .numErrors = 1});","+    logs.stop();","+    EXPECT_EQ(logs.countBSONContainingSubset(","+                  BSON(\"id\" << kValidationMetricsLogId << \"attr\" << BSON(\"valid\" << false))),","+              3);","+}","+","+/**","+ * Runs a foreground validation of 'nss' with the 'throwBeforeIndexValidation' fail point throwing","+ * 'errorCode', returning the status validate() reported.","+ */","+Status validateThrowingBeforeIndexValidation(OperationContext* opCtx,","+                                             const NamespaceString& nss,","+                                             ErrorCodes::Error errorCode) {","+    FailPointEnableBlock fp(\"throwBeforeIndexValidation\", BSON(\"errorCode\" << errorCode));"],"additions":107,"deletions":0,"truncated":false}],"additions":485,"deletions":17,"truncated":true,"file_count":5},"error":null,"fetched_at":"2026-10-17T12:26:28.499644+00:00"}