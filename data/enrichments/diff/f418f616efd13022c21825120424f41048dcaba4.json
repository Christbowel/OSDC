{"id":"f418f616efd13022c21825120424f41048dcaba4","axis":"silent","repo":"vllm-project/vllm","sha":"f418f616efd13022c21825120424f41048dcaba4","parsed":{"files":[{"path":"docs/models/supported_models.md","lines":["@@ -596,6 +596,7 @@ These models primarily accept the [`LLM.generate`](./generative_models.md#llmgen"," | `LightOnOCRForConditionalGeneration` | LightOnOCR-1B | T + I<sup>E+</sup> | `lightonai/LightOnOCR-1B`, etc | ✅︎ | ✅︎ |"," | `Lfm2VlForConditionalGeneration` | LFM2-VL | T + I<sup>+</sup> | `LiquidAI/LFM2-VL-450M`, `LiquidAI/LFM2-VL-3B`, `LiquidAI/LFM2-VL-8B-A1B`, etc. | ✅︎ | ✅︎ |"," | `Lfm3AudioForConditionalGeneration` | LFM3-Audio | T + A<sup>E+</sup> | `LiquidAI/LFM3-Audio-2B`, etc. | | ✅︎ |","+| `Lfm3OmniForConditionalGeneration` | LFM3-Omni | T + I<sup>E+</sup> + V<sup>E+</sup> + A<sup>E+</sup> | `LiquidAI/LFM3-Omni-2B` | | ✅︎ |"," | `Lfm3VlForConditionalGeneration` | LFM3-VL | T + I<sup>E+</sup> + V<sup>E+</sup> | `LiquidAI/LFM3-VL-2B` | | ✅︎ |"," | `Llama4ForConditionalGeneration` | Llama 4 | T + I<sup>+</sup> | `meta-llama/Llama-4-Scout-17B-16E-Instruct`, `meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8`, `meta-llama/Llama-4-Maverick-17B-128E-Instruct`, etc. | ✅︎ | ✅︎ |"," | `Llama_Nemotron_Nano_VL` | Llama Nemotron Nano VL | T + I<sup>E+</sup> | `nvidia/Llama-3.1-Nemotron-Nano-VL-8B-V1` | ✅︎ | ✅︎ |"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/models/multimodal/processing/test_lfm3_omni.py","lines":["@@ -0,0 +1,133 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+import numpy as np","+import pytest","+","+from vllm.multimodal import MULTIMODAL_REGISTRY","+from vllm.multimodal.cache import LruKeyReplicatedSenderCache","+from vllm.transformers_utils.configs.lfm3_omni import Lfm3OmniConfig","+","+from ....multimodal.utils import random_audio, random_video","+from ...utils import build_model_context","+","+LAYER_TYPES = [\"conv\", \"conv\", \"full_attention\"] * 5 + [\"full_attention\"] * 2","+ENCODER = {\"num_mel_bins\": 128, \"conv_channels\": 256}","+LFM2_ENCODER = {","+    \"model_type\": \"lfm2\",","+    \"vocab_size\": 2,","+    \"hidden_size\": 768,","+    \"intermediate_size\": 2560,","+    \"num_hidden_layers\": 17,","+    \"num_attention_heads\": 8,","+    \"num_key_value_heads\": 4,","+    \"layer_types\": LAYER_TYPES,","+    \"rope_parameters\": {\"rope_type\": \"default\", \"rope_theta\": 1e6},","+}","+LFM3_ENCODER = {","+    **LFM2_ENCODER,","+    \"model_type\": \"lfm3\",","+    \"intermediate_size\": 1792,","+    \"head_dim\": 96,","+    \"sliding_window\": 32,","+    \"use_attention_gate\": False,","+    \"use_sandwich_norm\": False,","+    \"layer_types\": [","+        \"sliding_attention\" if t == \"full_attention\" else t for t in LAYER_TYPES","+    ],","+    \"rope_parameters\": {","+        \"sliding_attention\": {\"rope_type\": \"default\", \"rope_theta\": 1e6}","+    },","+}","+# The hub checkpoints keep an LFM2 encoder; the transformers-native export an","+# LFM3 one without the attention gate and sandwich norms","+HUB = {","+    **ENCODER,","+    \"model_type\": \"lfm3_omni_encoder\",","+    \"sliding_window\": 32,","+    \"text_config\": LFM2_ENCODER,","+}","+TRANSFORMERS_NATIVE = {**ENCODER, \"text_config\": LFM3_ENCODER}","+","+","+@pytest.mark.parametrize(\"encoder\", [HUB, TRANSFORMERS_NATIVE])","+def test_config_layouts(encoder):","+    config = Lfm3OmniConfig(","+        text_config={\"model_type\": \"lfm3\"},","+        vision_config={\"model_type\": \"lfm3_vl_vision\"},","+        audio_encoder_config=encoder,","+        depth_config={\"model_type\": \"lfm3\"},","+    )","+    assert (config.image_token_id, config.video_token_id) == (125030, 125029)","+    assert config.audio_token_id == 125031","+    assert config.vision_config.spatial_merge_size == 2","+    audio_encoder = config.audio_encoder_config","+    assert audio_encoder.sliding_window == 32","+    assert audio_encoder.text_config.model_type == \"lfm2\"","+    assert audio_encoder.text_config.layer_types == LAYER_TYPES","+    restored = Lfm3OmniConfig(**config.to_dict())","+    assert restored.audio_encoder_config.to_dict() == audio_encoder.to_dict()","+    assert restored.vision_config.to_dict() == config.vision_config.to_dict()","+","+","+def soundtrack_data(num_videos: int) -> dict[str, list]:","+    rng = np.random.RandomState(0)","+    data: dict[str, list] = {\"video\": [], \"audio\": []}","+    for _ in range(num_videos):","+        video = random_video(rng, min_frames=8, max_frames=9, min_wh=64, max_wh=65)","+        metadata = {","+            \"total_num_frames\": len(video),","+            \"fps\": 2.0,","+            \"duration\": len(video) / 2.0,","+            \"video_backend\": \"opencv\",","+            \"frames_indices\": list(range(len(video))),","+            \"do_sample_frames\": False,","+        }","+        data[\"video\"].append((video, metadata))","+        data[\"audio\"].append(random_audio(rng, min_len=16000, max_len=16001, sr=16000))","+    return data","+","+","+@pytest.mark.parametrize(\"num_videos\", [1, 2])","+@pytest.mark.parametrize(\"standalone_clip\", [False, True])","+def test_soundtrack_without_placeholder(num_videos, standalone_clip):","+    \"\"\"With `use_audio_in_video` the chat parser adds each video's soundtrack as","+    the audio item right after it, and the openai content format puts no","+    placeholder for it in the prompt. The processor adds one after each video;","+    a standalone clip keeps its own placeholder.\"\"\"","+    num_audios = num_videos + standalone_clip","+    ctx = build_model_context(","+        \"LiquidAI/LFM3-Omni-2B\",","+        limit_mm_per_prompt={\"image\": 0, \"video\": num_videos, \"audio\": num_audios},","+        mm_processor_cache_gb=1,","+    )","+    processor = MULTIMODAL_REGISTRY.create_processor(ctx.model_config)","+    config = processor.info.get_hf_config()","+    video, audio = config.video_token_id, config.audio_token_id","+    data = soundtrack_data(num_videos)","+    if standalone_clip:","+        data[\"audio\"].append(random_audio(np.random.RandomState(1), 8000, 8001, 16000))","+    mm_items = processor.info.parse_mm_data(data)","+","+    def run(prompt, cache=None):","+        return processor(","+            prompt,","+            mm_items=mm_items,","+            hf_processor_mm_kwargs={\"use_audio_in_video\": True},","+            cache=cache,","+        )","+","+    explicit = [video, audio] * num_videos + [audio] * standalone_clip","+    out = run(explicit)","+    expected = out[\"prompt_token_ids\"]","+    # each soundtrack is interleaved inside its video's span","+    spans = [(p.offset, p.offset + p.length) for p in out[\"mm_placeholders\"][\"video\"]]","+    assert len(spans) == num_videos","+    for start, end in spans:","+        assert audio in expected[start:end]","+    # a standalone clip keeps its own span after the videos","+    assert (audio in expected[spans[-1][1] :]) == standalone_clip","+","+    cache = LruKeyReplicatedSenderCache(ctx.model_config)","+    chat_prompt = [video] * num_videos + [audio] * standalone_clip","+    for _ in range(2):  # cache miss, then cache hit","+        assert run(chat_prompt, cache)[\"prompt_token_ids\"] == expected"],"additions":133,"deletions":0,"truncated":false},{"path":"tests/models/registry.py","lines":["@@ -1094,6 +1094,7 @@ def check_available_online(","         \"LiquidAI/LFM2-VL-450M\",","     ),","     \"Lfm3AudioForConditionalGeneration\": _HfExamplesInfo(\"LiquidAI/LFM3-Audio-2B\"),","+    \"Lfm3OmniForConditionalGeneration\": _HfExamplesInfo(\"LiquidAI/LFM3-Omni-2B\"),","     \"Lfm3VlForConditionalGeneration\": _HfExamplesInfo(\"LiquidAI/LFM3-VL-2B\"),","     \"Llama4ForConditionalGeneration\": _HfExamplesInfo(","         \"meta-llama/Llama-4-Scout-17B-16E-Instruct\","],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/model_executor/models/lfm3_omni.py","lines":["@@ -0,0 +1,460 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"Inference-only LFM3-Omni model: images, videos and speech in, text out.","+","+Prompts follow the Transformers processor: every image, video and clip is wrapped","+in one span pair, a video is a series of timestamped frame groups, and with","+`use_audio_in_video` each video takes the first clip after it as its soundtrack,","+split across its frame groups. The speech output head is not served and its","+weights are skipped on load.","+\"\"\"","+","+from collections.abc import Mapping, Sequence","+from dataclasses import dataclass, field, replace","+","+import torch","+from transformers import BatchFeature","+","+from vllm.config import VllmConfig","+from vllm.config.multimodal import MultiModalDummyOptions","+from vllm.inputs import MultiModalDataDict","+from vllm.multimodal import MULTIMODAL_REGISTRY","+from vllm.multimodal.inputs import MultiModalFieldConfig, MultiModalKwargsItems","+from vllm.multimodal.parse import MultiModalDataItems, VideoProcessorItems","+from vllm.multimodal.processing import (","+    PromptReplacement,","+    PromptUpdate,","+    PromptUpdateDetails,","+)","+from vllm.multimodal.processing.processor import (","+    MultiModalProcessingResult,","+    PlaceholderFeaturesInfo,","+    ResolvedPromptUpdate,","+)","+from vllm.transformers_utils.configs.lfm3_omni import Lfm3OmniConfig","+from vllm.transformers_utils.processors.lfm3_omni import Lfm3OmniProcessor","+from vllm.utils.gpu_sync_debug import gpu_sync_allowed","+","+from .interfaces import MultiModalEmbeddings","+from .lfm3_audio import (","+    Lfm3AudioEncoder,","+    Lfm3AudioForConditionalGeneration,","+    Lfm3AudioProcessingInfo,","+    Lfm3AudioProjector,","+    split_audio_features,","+    suppress_speech_mode,","+)","+from .lfm3_vl import (","+    Lfm3VlDummyInputsBuilder,","+    Lfm3VlForConditionalGeneration,","+    Lfm3VlProcessingInfo,","+)","+from .qwen2_5_omni_thinker import merge_interleaved_embeddings","+from .qwen3_vl import Qwen3VLMultiModalDataParser, Qwen3VLMultiModalProcessor","+from .utils import maybe_prefix","+","+","+class Lfm3OmniProcessingInfo(Lfm3AudioProcessingInfo, Lfm3VlProcessingInfo):","+    def get_hf_config(self):","+        return self.ctx.get_hf_config(Lfm3OmniConfig)","+","+    def get_hf_processor(self, **kwargs: object) -> Lfm3OmniProcessor:","+        return self.ctx.get_hf_processor(Lfm3OmniProcessor, **kwargs)","+","+    def get_data_parser(self):","+        return Qwen3VLMultiModalDataParser(","+            self.get_hf_config().vision_config.spatial_merge_size,","+            video_needs_metadata=True,","+            target_sr=self.get_feature_extractor().sampling_rate,","+            target_channels=1,","+            expected_hidden_size=self._get_expected_hidden_size(),","+            allow_missing_mm_embeddings=self.allow_missing_mm_embeddings,","+        )","+","+    def get_supported_mm_limits(self) -> Mapping[str, int | None]:","+        return {\"image\": None, \"video\": None, \"audio\": None}","+","+    def get_mm_max_tokens_per_item(","+        self, seq_len: int, mm_counts: Mapping[str, int] | None = None","+    ) -> Mapping[str, int]:","+        return {","+            **Lfm3VlProcessingInfo.get_mm_max_tokens_per_item(","+                self, seq_len, mm_counts or {}","+            ),","+            **super().get_mm_max_tokens_per_item(seq_len, mm_counts),","+        }","+","+","+class Lfm3OmniDummyInputsBuilder(Lfm3VlDummyInputsBuilder):","+    info: Lfm3OmniProcessingInfo","+","+    def get_dummy_text(self, mm_counts: Mapping[str, int]) -> str:","+        audio = \"<|vision_start|><|audio|><|vision_end|>\"","+        return super().get_dummy_text(mm_counts) + audio * mm_counts.get(\"audio\", 0)","+","+    def get_dummy_mm_data(","+        self,","+        seq_len: int,","+        mm_counts: Mapping[str, int],","+        mm_options: MultiModalDummyOptions,","+    ) -> MultiModalDataDict:","+        return {","+            **super().get_dummy_mm_data(seq_len, mm_counts, mm_options),","+            \"audio\": self._get_dummy_audios(","+                length=self.info.get_max_audio_samples(),","+                num_audios=mm_counts.get(\"audio\", 0),","+                overrides=mm_options.get(\"audio\"),","+            ),","+        }","+","+","+@dataclass","+class _VideoGroups(PromptUpdateDetails):","+    \"\"\"A video placeholder that takes a soundtrack, kept as frame groups until","+    the prompt shows which clip that is.\"\"\"","+","+    groups: list[list[int]] = field(default_factory=list)","+    group_starts: list[float] = field(default_factory=list)","+","+","+class Lfm3OmniMultiModalProcessor(Qwen3VLMultiModalProcessor):","+    info: Lfm3OmniProcessingInfo","+","+    def _get_mm_fields_config(","+        self, hf_inputs: BatchFeature, hf_processor_mm_kwargs: Mapping[str, object]","+    ) -> Mapping[str, MultiModalFieldConfig]:","+        return {","+            **super()._get_mm_fields_config(hf_inputs, hf_processor_mm_kwargs),","+            \"input_features\": MultiModalFieldConfig.batched(\"audio\"),","+            \"audio_embeds\": MultiModalFieldConfig.batched(\"audio\"),","+        }","+","+    def _postprocess_hf_mm_data(","+        self,","+        mm_inputs: Mapping[str, object],","+        hf_processor_mm_kwargs: Mapping[str, object],","+        processed_data: BatchFeature,","+    ) -> BatchFeature:","+        return split_audio_features(processed_data)","+","+    def _span_token_ids(self) -> tuple[int, int]:","+        processor = self.info.get_hf_processor()","+        return processor.vision_start_token_id, processor.vision_end_token_id","+","+    def _postprocess_prompt(self, prompt: list[int]) -> list[int]:","+        # Each placeholder gets exactly one span pair, so drop the pair a chat","+        # template already put around it.","+        processor = self.info.get_hf_processor()","+        start, end = self._span_token_ids()","+        placeholders = {","+            processor.image_token_id,","+            processor.video_token_id,","+            processor.audio_token_id,","+        }","+        stripped: list[int] = []","+        index = 0","+        while index < len(prompt):","+            if (","+                prompt[index] == start","+                and index + 2 < len(prompt)","+                and prompt[index + 1] in placeholders","+                and prompt[index + 2] == end","+            ):","+                stripped.append(prompt[index + 1])","+                index += 3","+            else:","+                stripped.append(prompt[index])","+                index += 1","+        return stripped","+","+    def _wrap(self, tokens: list[int]) -> list[int]:","+        start, end = self._span_token_ids()","+        return [start, *tokens, end]","+","+    def _with_soundtrack(","+        self, video: _VideoGroups, num_tokens: int","+    ) -> PromptUpdateDetails:","+        \"\"\"Splits the soundtrack's encoder tokens at the first frame of each","+        group, after the group.\"\"\"","+        processor = self.info.get_hf_processor()","+        extractor = processor.feature_extractor","+        seconds_per_token = (","+            extractor.hop_length * extractor.encoder_stride / extractor.sampling_rate","+        )","+        bounds = [0] + [","+            min(num_tokens, round(start / seconds_per_token))","+            for start in video.group_starts[1:]","+        ]","+        bounds = [max(bounds[: i + 1]) for i in range(len(bounds))] + [num_tokens]","+        tokens: list[int] = []","+        for group, first, last in zip(video.groups, bounds, bounds[1:]):","+            tokens += group + [processor.audio_token_id] * (last - first)","+        return PromptUpdateDetails.select_token_id(","+            self._wrap(tokens), processor.video_token_id","+        )","+","+    def _get_prompt_updates(","+        self,","+        mm_items: MultiModalDataItems,","+        hf_processor_mm_kwargs: Mapping[str, object],","+        out_mm_kwargs: MultiModalKwargsItems,","+    ) -> Sequence[PromptUpdate]:","+        processor = self.info.get_hf_processor(**hf_processor_mm_kwargs)","+        tokenizer = self.info.get_tokenizer()","+        extractor = processor.feature_extractor","+        start, end = self._span_token_ids()","+        temporal_patch_size = processor.video_processor.temporal_patch_size","+        merge_length = processor.image_processor.merge_size**2","+        use_audio_in_video = bool(hf_processor_mm_kwargs.get(\"use_audio_in_video\"))","+","+        def wrapped(token_id: int, count: int) -> PromptUpdateDetails:","+            return PromptUpdateDetails.select_token_id(","+                self._wrap([token_id] * count), token_id","+            )","+","+        def image_replacement(item_idx: int) -> PromptUpdateDetails:","+            grid_thw = out_mm_kwargs[\"image\"][item_idx][\"image_grid_thw\"].data","+            assert isinstance(grid_thw, torch.Tensor)","+            return wrapped(","+                processor.image_token_id, int(grid_thw.prod()) // merge_length","+            )","+","+        def audio_replacement(item_idx: int) -> PromptUpdateDetails:","+            item = out_mm_kwargs[\"audio\"][item_idx]","+            if (embeds := item.get(\"audio_embeds\")) is not None:","+                count = len(embeds.data)","+            else:","+                features = item[\"input_features\"].data","+                assert isinstance(features, torch.Tensor)","+                count = extractor.num_encoder_tokens(features.shape[-1])","+            return wrapped(processor.audio_token_id, count)","+","+        def video_replacement(item_idx: int) -> PromptUpdateDetails:","+            item = out_mm_kwargs[\"video\"][item_idx]","+            grid_thw = item[\"video_grid_thw\"].data","+            assert isinstance(grid_thw, torch.Tensor)","+            timestamps = item[\"timestamps\"].data","+            assert isinstance(timestamps, (list, torch.Tensor))","+            tokens_per_group = int(grid_thw[1:].prod()) // merge_length","+            groups = [","+                self.get_video_repl(","+                    tokens_per_frame=[tokens_per_group],","+                    timestamps=[timestamp],","+                    tokenizer=tokenizer,","+                    vision_start_token_id=start,","+                    vision_end_token_id=end,","+                    video_token_id=processor.video_token_id,","+                ).full","+                for timestamp in timestamps","+            ]","+            details = PromptUpdateDetails.select_token_id(","+                self._wrap([token for group in groups for token in group]),","+                processor.video_token_id,","+            )","+            if not use_audio_in_video:","+                return details","+            # The soundtrack splits at the first frame of each group, which the","+            # averaged timestamps lose, so take the frame indices the loader","+            # sampled; frames resampled by the HF processor change the count.","+            videos = mm_items.get(\"video\")","+            video = (","+                videos.get(item_idx)","+                if isinstance(videos, VideoProcessorItems)","+                else None","+            )","+            metadata = video[1] if isinstance(video, tuple) else {}","+            indices = metadata.get(\"frames_indices\", [])","+            if -(-len(indices) // temporal_patch_size) != len(groups):","+                raise ValueError(","+                    \"`use_audio_in_video` needs videos sampled by the video loader\"","+                )","+            return _VideoGroups(","+                full=details.full,","+                is_embed=details.is_embed,","+                groups=groups,","+                group_starts=[","+                    index / metadata[\"fps\"] for index in indices[::temporal_patch_size]","+                ],","+            )","+","+        return [","+            PromptReplacement(\"image\", [processor.image_token_id], image_replacement),","+            PromptReplacement(\"video\", [processor.video_token_id], video_replacement),","+            PromptReplacement(\"audio\", [processor.audio_token_id], audio_replacement),","+        ]","+","+    def _with_soundtrack_placeholders(","+        self, prompt: list[int], num_audios: int","+    ) -> list[int]:","+        \"\"\"The chat parser adds each video's decoded soundtrack as the audio","+        item right after it; the openai content format puts no placeholder for","+        it in the prompt. When the audio items outnumber the placeholders by","+        exactly one per video, put that placeholder right after every video,","+        as HF's `load_audio_from_video` does; otherwise the prompt is kept.\"\"\"","+        processor = self.info.get_hf_processor()","+        video_token_id = processor.video_token_id","+        audio_token_id = processor.audio_token_id","+        num_videos = prompt.count(video_token_id)","+        if num_audios != prompt.count(audio_token_id) + num_videos:","+            return prompt","+        with_tracks: list[int] = []","+        for token in prompt:","+            with_tracks.append(token)","+            if token == video_token_id:","+                with_tracks.append(audio_token_id)","+        return with_tracks","+","+    def _soundtracks(self, prompt: list[int]) -> dict[int, int]:","+        \"\"\"The audio item each video takes as its soundtrack: the first clip","+        after the video that no earlier video took.\"\"\"","+        processor = self.info.get_hf_processor()","+        clips = [i for i, t in enumerate(prompt) if t == processor.audio_token_id]","+        taken: list[int] = []","+        for video in (i for i, t in enumerate(prompt) if t == processor.video_token_id):","+            clip_idx = next(","+                (i for i, clip in enumerate(clips) if clip > video and i not in taken),","+                None,","+            )","+            if clip_idx is None:","+                raise ValueError(","+                    \"`use_audio_in_video` needs an audio clip after each video\"","+                )","+            taken.append(clip_idx)","+        return dict(enumerate(taken))","+","+    def _maybe_apply_prompt_updates(","+        self,","+        mm_items: MultiModalDataItems,","+        mm_res: MultiModalProcessingResult,","+    ) -> tuple[list[int], Mapping[str, list[PlaceholderFeaturesInfo]]]:","+        if not any(","+            isinstance(update.content, _VideoGroups)","+            for item in mm_res.prompt_updates.get(\"video\", [])","+            for update in item","+        ):","+            return super()._maybe_apply_prompt_updates(mm_items, mm_res)","+","+        mm_item_counts = mm_items.get_all_counts()","+        self._validate_mm_kwargs(mm_res.kwargs, mm_item_counts)","+        self._validate_mm_updates(mm_res.prompt_updates, mm_item_counts)","+        prompt = self._with_soundtrack_placeholders(","+            mm_res.prompt_ids, mm_item_counts.get(\"audio\", 0)","+        )","+","+        # A soundtrack's own placeholder expands to nothing; its tokens follow","+        # its video's frame groups instead.","+        soundtracks = self._soundtracks(prompt)","+        updates: dict[str, list[list[ResolvedPromptUpdate]]] = {","+            modality: [list(item) for item in items]","+            for modality, items in mm_res.prompt_updates.items()","+        }","+        audio_token_id = self.info.get_hf_processor().audio_token_id","+        for video_idx, audio_idx in soundtracks.items():","+            (video,) = updates[\"video\"][video_idx]","+            (audio,) = updates[\"audio\"][audio_idx]","+            assert isinstance(video.content, _VideoGroups)","+            content = self._with_soundtrack(","+                video.content, audio.content.full.count(audio_token_id)","+            )","+            updates[\"video\"][video_idx] = [replace(video, content=content)]","+            updates[\"audio\"][audio_idx] = [","+                replace(audio, content=PromptUpdateDetails.from_seq([]))","+            ]","+","+        prompt_ids, placeholders = self._apply_prompt_updates(prompt, updates)","+        audio_placeholders = list(placeholders.get(\"audio\", []))","+        for video_placeholder in placeholders[\"video\"]:","+            audio_idx = soundtracks[video_placeholder.item_idx]","+            audio_placeholders.append(","+                replace(","+                    video_placeholder,","+                    modality=\"audio\",","+                    item_idx=audio_idx,","+                    is_embed=torch.tensor(video_placeholder.tokens) == audio_token_id,","+                )","+            )","+        placeholders = {","+            **placeholders,","+            \"audio\": sorted(audio_placeholders, key=lambda info: info.item_idx),","+        }","+        self._validate_mm_placeholders(placeholders, mm_item_counts)","+        return prompt_ids, placeholders","+","+","+@MULTIMODAL_REGISTRY.register_processor(","+    Lfm3OmniMultiModalProcessor,","+    info=Lfm3OmniProcessingInfo,","+    dummy_inputs=Lfm3OmniDummyInputsBuilder,","+)","+class Lfm3OmniForConditionalGeneration(Lfm3VlForConditionalGeneration):","+    hf_to_vllm_mapper = (","+        Lfm3VlForConditionalGeneration.hf_to_vllm_mapper","+        | Lfm3AudioForConditionalGeneration.hf_to_vllm_mapper","+    )","+","+    @classmethod","+    def get_placeholder_str(cls, modality: str, i: int) -> str | None:","+        if modality.startswith(\"audio\"):","+            return \"<|vision_start|><|audio|><|vision_end|>\"","+        return super().get_placeholder_str(modality, i)","+","+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = \"\") -> None:","+        super().__init__(vllm_config=vllm_config, prefix=prefix)","+        config: Lfm3OmniConfig = vllm_config.model_config.hf