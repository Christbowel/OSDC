{"id":"033177064b5d93c3295d64ae32176ed78527e7d9","axis":"silent","repo":"pnpm/pnpm","sha":"033177064b5d93c3295d64ae32176ed78527e7d9","parsed":{"files":[{"path":".changeset/pnpr-package-metadata-writes.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+When the version tagged `latest` is removed, pnpr now restores the most recent former `latest` that is still published. If none remains, pnpr prefers the highest remaining stable release. Moving `latest` also updates the package README.","+","+pnpr rejects npm publish documents with no versions. Fetching package metadata with `?write=true` returns the current revision. Deprecation updates check that revision on every request, reject non-string messages, and clear the annotation for an empty message."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/package_mutation.rs","lines":["@@ -160,7 +160,8 @@ async fn try_rewrite_packument(","     let (hosted, version) = read_packument_for_rewrite(state, identity, target, name).await?;","     let mut packument = incoming_val.clone();","     let storage = hosted_storage(state, Some(&target.namespace));","-    let tar_integrities = storage.read_tar_integrities(name).await.unwrap_or_default();","+    let tar_integrities =","+        storage.refresh_tar_integrities(name).await.map_err(IntoResponse::into_response)?;","     let removed = prepare_packument_rewrite(hosted, &tar_integrities, name, &mut packument)?;","     let bytes = serde_json::to_vec_pretty(&packument)","         .map_err(RegistryError::Json)"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/package_mutation/version_removal.rs","lines":["@@ -27,8 +27,8 @@ use serde_json::{"," "," /// Remove `version` from `name`'s packument when it still lists it, and"," /// reclaim the archives only it mapped. Reports whether it was listed. The","-/// `latest` tag naming it moves to the highest version left, or goes when","-/// none is. Other tags naming it are removed. Concurrent commits cause a retry.","+/// `latest` tag returns to its most recent surviving target. Other tags","+/// naming the removed version are dropped."," /// The removed version and former maintainers are recorded together."," pub(super) async fn remove_listed_version(","     state: &AppState,","@@ -66,8 +66,18 @@ async fn try_remove_listed_version(","         }","         return Ok(Some(false));","     };","+    let replacement = if packument.pointer(\"/dist-tags/latest\").and_then(Value::as_str)","+        == Some(version)","+    {","+        storage","+            .previous_published_latest(name, version)","+            .await?","+            .or_else(|| highest_remaining_version(packument.get(\"versions\")?.as_object()?, version))","+    } else {","+        None","+    };","     let Some(object) = packument.as_object_mut() else { return Ok(Some(false)) };","-    if !drop_version(object, version) {","+    if !drop_version(object, version, replacement.as_deref()) {","         return Ok(Some(false));","     }","     let removed = [version.to_string()];","@@ -85,39 +95,49 @@ async fn try_remove_listed_version(","     }"," }"," ","+fn highest_remaining_version(versions: &Map<String, Value>, removed: &str) -> Option<String> {","+    versions","+        .keys()","+        .filter(|key| key.as_str() != removed)","+        .filter_map(|key| {","+            let parsed = node_semver::Version::parse(key).ok()?;","+            Some((!parsed.is_prerelease(), parsed, key))","+        })","+        .max()","+        .map(|(_, _, key)| key.clone())","+}","+"," /// Drop `version` from `packument`, with its `time` entry, and update the"," /// tags that named it. Reports whether the packument listed it.","-fn drop_version(packument: &mut Map<String, Value>, version: &str) -> bool {","+fn drop_version(","+    packument: &mut Map<String, Value>,","+    version: &str,","+    replacement: Option<&str>,","+) -> bool {","     let Some(versions) = packument.get_mut(\"versions\").and_then(Value::as_object_mut) else {","         return false;","     };","     if versions.shift_remove(version).is_none() {","         return false;","     }","-    let highest = versions","-        .keys()","-        .map(node_semver::Version::parse)","-        .filter_map(Result::ok)","-        .max()","-        .map(|highest| highest.to_string());","     if let Some(time) = packument.get_mut(\"time\").and_then(Value::as_object_mut) {","         time.shift_remove(version);","     }","     if let Some(tags) = packument.get_mut(\"dist-tags\").and_then(Value::as_object_mut) {","-        move_tags(tags, version, highest.as_deref());","+        move_tags(tags, version, replacement);","     }","     true"," }"," ","-fn move_tags(tags: &mut Map<String, Value>, version: &str, highest: Option<&str>) {","+fn move_tags(tags: &mut Map<String, Value>, version: &str, replacement: Option<&str>) {","     tags.retain(|tag, target| {","         if target.as_str() != Some(version) {","             return true;","         }","         if tag == \"latest\"","-            && let Some(highest) = highest","+            && let Some(replacement) = replacement","         {","-            *target = Value::String(highest.to_string());","+            *target = Value::String(replacement.to_string());","             return true;","         }","         false"],"additions":34,"deletions":14,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/package_mutation/version_removal_tests.rs","lines":["@@ -7,8 +7,8 @@ fn removing_a_version_retargets_only_latest() {","         \"versions\": { \"1.0.0\": {}, \"2.0.0\": {} },","         \"dist-tags\": { \"latest\": \"2.0.0\", \"beta\": \"2.0.0\", \"stable\": \"1.0.0\" }","     });","-    assert!(drop_version(document.as_object_mut().unwrap(), \"2.0.0\"));","+    assert!(drop_version(document.as_object_mut().unwrap(), \"2.0.0\", Some(\"1.0.0\")));","     assert_eq!(document[\"dist-tags\"], json!({ \"latest\": \"1.0.0\", \"stable\": \"1.0.0\" }));","-    assert!(drop_version(document.as_object_mut().unwrap(), \"1.0.0\"));","+    assert!(drop_version(document.as_object_mut().unwrap(), \"1.0.0\", None));","     assert_eq!(document[\"dist-tags\"], json!({}));"," }"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/package_reads.rs","lines":["@@ -23,7 +23,10 @@ use super::{","     is_osv_vulnerable_packument_version,","     is_tar_registry,","     not_found,","-    package_responses::processing::admission::DocumentSource,","+    package_responses::{","+        PackumentRequest,","+        processing::admission::DocumentSource,","+    },","     packument_response,","     read_source_packument,","     registry_endpoint,","@@ -43,17 +46,29 @@ mod version_documents;"," pub(super) async fn serve_packument(","     state: &AppState,","     identity: &Identity,","-    headers: &HeaderMap,","+    headers: HeaderMap,","     registry: Option<&str>,","     raw_name: &str,","+    query: Option<&str>,"," ) -> Response {","     let Some(target) = addressed_registry(state, registry, Ecosystem::Npm) else {","         return not_found();","     };","     let base = registry_endpoint(state, Ecosystem::Npm, registry);","+    let for_write = query.is_some_and(|query| {","+        url::form_urlencoded::parse(query.as_bytes())","+            .any(|(key, value)| key == \"write\" && value == \"true\")","+    });","+    let request =","+        if for_write { PackumentRequest::Write } else { PackumentRequest::Read(&headers) };","     let response =","-        serve_registry_packument(state, identity, headers, &target, raw_name, &base).await;","-    caller_scoped(state, Ecosystem::Npm, registry, Some(raw_name), response)","+        serve_registry_packument(state, identity, request, &target, raw_name, &base).await;","+    match request {","+        PackumentRequest::Write => super::private_no_cache(response),","+        PackumentRequest::Read(_) => {","+            caller_scoped(stat