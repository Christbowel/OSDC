{"id":"fe97b09e6b8f911be53b663d3333fa3d37610fce","axis":"silent","repo":"ServiceStack/ServiceStack","sha":"fe97b09e6b8f911be53b663d3333fa3d37610fce","parsed":{"files":[{"path":"ServiceStack.OrmLite/src/ServiceStack.OrmLite.MySql/MySqlDialectProviderBase.cs","lines":["@@ -385,6 +385,36 @@ public override string ToPostCreateTableStatement(ModelDefinition modelDef)"," \t\treturn null;"," \t}"," ","+\t/// <summary>","+\t/// Returns the MySqlBulkLoader columns and SET expressions for loading CSV serialized rows of T.","+\t/// Guids are serialized in CSVs without dashes, so they're loaded into a variable and converted into the","+\t/// 'D' format stored in CHAR(36) columns, which MySqlConnector requires when reading them back.","+\t/// Not used by MySql.Data which treats @variables as params unless 'Allow User Variables=true'.","+\t/// </summary>","+\tinternal static (List<string> Columns, List<string> Expressions) GetBulkLoadColumns<T>(IOrmLiteDialectProvider dialect)","+\t{","+\t\tvar modelDef = ModelDefinition<T>.Definition;","+\t\tvar columns = new List<string>();","+\t\tvar expressions = new List<string>();","+\t\tforeach (var prop in CsvSerializer.PropertiesFor<T>())","+\t\t{","+\t\t\tvar fieldDef = modelDef.GetFieldDefinition(prop.PropertyName);","+\t\t\tvar column = dialect.GetQuotedColumnName(fieldDef);","+\t\t\tvar fieldType = Nullable.GetUnderlyingType(fieldDef.ColumnType) ?? fieldDef.ColumnType;","+\t\t\tif (fieldType == typeof(Guid) && dialect.GetConverterBestMatch(fieldDef) is MySqlGuidConverter)","+\t\t\t{","+\t\t\t\tvar variable = \"@guid\" + expressions.Count;","+\t\t\t\tcolumns.Add(variable);","+\t\t\t\texpressions.Add($\"{column} = INSERT(INSERT(INSERT(INSERT(NULLIF({variable},''),9,0,'-'),14,0,'-'),19,0,'-'),24,0,'-')\");","+\t\t\t}","+\t\t\telse","+\t\t\t{","+\t\t\t\tcolumns.Add(column);","+\t\t\t}","+\t\t}","+\t\treturn (columns, expressions);","+\t}","+"," \tpublic override string GetQuotedValue(string paramValue)"," \t{"," \t\treturn \"'\" + paramValue.Replace(\"\\\\\", \"\\\\\\\\\").Replace(\"'\", @\"\\'\") + \"'\";"],"additions":30,"deletions":0,"truncated":false},{"path":"ServiceStack.OrmLite/src/ServiceStack.OrmLite.MySqlConnector/Converters/MySqlConnectorDateTimeOffsetConverter.cs","lines":["@@ -0,0 +1,15 @@","+using System;","+using System.Globalization;","+","+namespace ServiceStack.OrmLite.MySql.Converters;","+","+/// <summary>","+/// DateTimeOffsets are stored in VARCHAR columns. MySqlConnector serializes DateTimeOffset params as UTC date times","+/// without their offset (which are read back as local times), so explicitly send them as ISO 8601 strings.","+/// </summary>","+public class MySqlConnectorDateTimeOffsetConverter : MySqlDateTimeOffsetConverter","+{","+    public override object ToDbValue(Type fieldType, object value) => value is DateTimeOffset dateTimeOffset","+        ? dateTimeOffset.ToString(\"o\", CultureInfo.InvariantCulture)","+        : base.ToDbValue(fieldType, value);","+}"],"additions":15,"deletions":0,"truncated":false},{"path":"ServiceStack.OrmLite/src/ServiceStack.OrmLite.MySqlConnector/MySqlConnectorDialectProvider.cs","lines":["@@ -20,6 +20,7 @@ public class MySqlConnectorDialectProvider : MySqlDialectProviderBase<MySqlConne","     public MySqlConnectorDialectProvider()","     {","         base.RegisterConverter<DateTime>(new MySqlConnectorDateTimeConverter());","+        base.RegisterConverter<DateTimeOffset>(new MySqlConnectorDateTimeOffsetConverter());","     }"," ","     public override IDbConnection CreateConnection(string connectionString, Dictionary<string, string> options)","@@ -82,9 +83,9 @@ private static MySqlBulkLoader CreateBulkLoader<T>(IDbConnection db, IEnumerable","             LineTerminator = Environment.NewLine,","         };","         ","-        var columns = CsvSerializer.PropertiesFor<T>()","-            .Select(x => dialect.GetQuotedColumnName(modelDef.GetFieldDefinition(x.PropertyName)));","+        var (columns, expressions) = GetBulkLoadColumns<T