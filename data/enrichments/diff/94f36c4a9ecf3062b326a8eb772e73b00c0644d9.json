{"id":"94f36c4a9ecf3062b326a8eb772e73b00c0644d9","axis":"silent","repo":"TanStack/router","sha":"94f36c4a9ecf3062b326a8eb772e73b00c0644d9","parsed":{"files":[{"path":".changeset/esbuild-refuse-code-splitting.md","lines":["@@ -0,0 +1,5 @@","+---","+'@tanstack/router-plugin': patch","+---","+","+The esbuild plugin now throws when `autoCodeSplitting` is enabled, and `TanStackRouterCodeSplitterEsbuild` throws, instead of silently bundling every route without splitting. Route generation with esbuild is unchanged."],"additions":5,"deletions":0,"truncated":false},{"path":"docs/router/api/file-based-routing.md","lines":["@@ -188,7 +188,7 @@ By default, this value is set to `false`."," "," ### `autoCodeSplitting`"," ","-This feature is only available if you are using the TanStack Router Bundler Plugin.","+This feature is only available if you are using the TanStack Router Bundler Plugin with Vite, Rspack/Rsbuild or Webpack. With Esbuild, setting it to `true` is an error."," "," This option is used to enable automatic code-splitting for non-critical route configuration items. See the \"Automatic Code-Splitting\" guide for more information."," "],"additions":1,"deletions":1,"truncated":false},{"path":"docs/router/guide/automatic-code-splitting.md","lines":["@@ -4,7 +4,7 @@ title: Automatic Code Splitting"," "," The automatic code splitting feature in TanStack Router allows you to optimize your application's bundle size by lazily loading route components and their associated data. This is particularly useful for large applications where you want to minimize the initial load time by only loading the necessary code for the current route."," ","-To turn this feature on, simply set the `autoCodeSplitting` option to `true` in your bundler plugin configuration. This enables the router to automatically handle code splitting for your routes without requiring any additional setup.","+To turn this feature on, simply set the `autoCodeSplitting` option to `true` in your bundler plugin configuration. This enables the router to automatically handle code splitting for your routes without requiring any additional setup. It is available with Vite, Rspack/Rsbuild and Webpack, not with Esbuild."," "," ```ts"," // vite.config.ts"],"additions":1,"deletions":1,"truncated":false},{"path":"docs/router/installation/with-esbuild.md","lines":["@@ -25,7 +25,6 @@ export default {","   plugins: [","     tanstackRouter({","       target: 'react',","-      autoCodeSplitting: true,","     }),","   ],"," }","@@ -50,10 +49,7 @@ const ctx = await esbuild.context({","   format: 'esm',","   target: ['esnext'],","   sourcemap: true,","-  plugins: [","-    solidPlugin(),","-    tanstackRouter({ target: 'solid', autoCodeSplitting: true }),","-  ],","+  plugins: [solidPlugin(), tanstackRouter({ target: 'solid' })],"," })"," "," if (isDev) {","@@ -72,6 +68,9 @@ Or, you can clone our [Quickstart Esbuild example](https://github.com/TanStack/r"," "," Now that you've added the plugin to your Esbuild configuration, you're all set to start using file-based routing with TanStack Router."," ","+> [!NOTE]","+> Automatic code splitting is not available with Esbuild: the plugin throws an error when `autoCodeSplitting` is `true`. Route generation works as usual. To split routes, use [manual code splitting](../guide/code-splitting.md) or another bundler.","+"," ## Ignoring the generated route tree file"," "," If your project is configured to use a linter and/or formatter, you may want to ignore the generated route tree file. This file is managed by TanStack Router and therefore shouldn't be changed by your linter or formatter."],"additions":4,"deletions":5,"truncated":false},{"path":"e2e/react-router/basic-esbuild-file-based/src/esbuild.config.js","lines":["@@ -2,9 +2,5 @@ import { tanstackRouter } from '@tanstack/router-plugin/esbuild'"," "," export default {","   // ...","-  plugins: [","-    tanstackRouter({","-      autoCodeSplitting: true,","-    }),","-  ],","+  plugins: [tanstackRouter()],"," }"],"additions":1,"deletions":5,"truncated":false},{"path":"e2e/solid-router/basic-esbuild-file-based/src/esbuild.config.js","lines":["@@ -6,7 +6,6 @@ export default {","   plugins: [","     tanstackRouter({","       target: 'solid',","-      autoCodeSplitting: true,","     }),","     solidPlugin(),","   ],"],"additions":0,"deletions":1,"truncated":false},{"path":"e2e/vue-router/basic-esbuild-file-based/src/esbuild.config.js","lines":["@@ -9,7 +9,6 @@ export default {","     }),","     tanstackRouter({","       target: 'vue',","-      autoCodeSplitting: true,","     }),","   ],"," }"],"additions":0,"deletions":1,"truncated":false},{"path":"examples/react/quickstart-esbuild-file-based/esbuild.config.js","lines":["@@ -7,5 +7,5 @@ export default {","   bundle: true,","   format: 'esm',","   target: ['esnext'],","-  plugins: [tanstackRouter({ target: 'react', autoCodeSplitting: true })],","+  plugins: [tanstackRouter({ target: 'react' })],"," }"],"additions":1,"deletions":1,"truncated":false},{"path":"examples/solid/quickstart-esbuild-file-based/build.js","lines":["@@ -14,10 +14,7 @@ const ctx = await esbuild.context({","   target: ['esnext'],","   sourcemap: true,","   conditions: ['style'],","-  plugins: [","-    solidPlugin(),","-    tanstackRouter({ target: 'solid', autoCodeSplitting: true }),","-  ],","+  plugins: [solidPlugin(), tanstackRouter({ target: 'solid' })],"," })"," "," if (isDev) {"],"additions":1,"deletions":4,"truncated":false},{"path":"packages/router-plugin/skills/router-plugin/SKILL.md","lines":["@@ -91,12 +91,13 @@ esbuild.build({","   plugins: [","     tanstackRouter({","       target: 'react',","-      autoCodeSplitting: true,","     }),","   ],"," })"," ```"," ","+> Automatic code splitting is not available with esbuild: the plugin throws when `autoCodeSplitting` is `true`. Use manual code splitting (`.lazy.tsx` files) or another bundler to split routes.","+"," ## Configuration Options"," "," ### Core Options"],"additions":2,"deletions":1,"truncated":false},{"path":"packages/router-plugin/src/esbuild.ts","lines":["@@ -1,7 +1,6 @@"," import { createEsbuildPlugin } from 'unplugin'"," ","-import { configSchema } from './core/config'","-import { createRouterCodeSplitterPlugin } from './core/router-code-splitter-plugin'","+import { configSchema, getConfig } from './core/config'"," import { createRouterGeneratorPlugin } from './core/router-generator-plugin'"," import { unpluginRouterComposedFactory } from './core/router-composed-plugin'"," import { createRouterPluginContext } from './core/router-plugin-context'","@@ -13,6 +12,20 @@ type RouterPluginOptions = Partial<Config | (() => Config)> | undefined"," "," const defaultRouterPluginContext = createRouterPluginContext()"," ","+const ESBUILD_SPLITTING_ERROR =","+  '@tanstack/router-plugin: route code splitting (`autoCodeSplitting`) is not supported with esbuild. ' +","+  'Use the generator alone (`TanStackRouterGeneratorEsbuild`), or set `autoCodeSplitting: false`.'","+","+function refuseSplitting(options: RouterPluginOptions) {","+  const config =","+    typeof options === 'function'","+      ? options()","+      : getConfig(options ?? {}, process.cwd())","+  if (config.autoCodeSplitting) {","+    throw new Error(ESBUILD_SPLITTING_ERROR)","+  }","+}","+"," /**","  * @example","  * ```ts","@@ -33,22 +46,14 @@ const TanStackRouterGeneratorEsbuild = ("," }"," "," /**","- * @example","- * ```ts","- * export default {","- *  plugins: [TanStackRouterCodeSplitterEsbuild()],","- *  // ...","- * }","- * ```","+ * Route code splitting is not available with esbuild: this entry refuses","+ * clearly.","  */"," const TanStackRouterCodeSplitterEsbuild = (","-  options?: RouterPluginOptions,","-  routerPluginContext?: RouterPluginContext,","-) => {","-  const pluginContext = routerPluginContext ?? defaultRouterPluginContext","-  return createEsbuildPlugin((pluginOptions: RouterPluginOptions) =>","-    createRouterCodeSplitterPlugin(pluginOptions, pluginContext),","-  )(options)","+  _options?: RouterPluginOptions,","+  _routerPluginContext?: RouterPluginContext,","+): never => {","+  throw new Error(ESBUILD_SPLITTING_ERROR)"," }"," "," /**","@@ -60,7 +65,10 @@ const TanStackRouterCodeSplitterEsbuild = (","  * }","  * ```","  */","-const TanStackRouterEsbuild = createEsbuildPlugin(unpluginRouterComposedFactory)","+const TanStackRouterEsbuild = (options: RouterPluginOptions = {}) => {","+  refuseSplitting(options)","+  return createEsbuildPlugin(unpluginRouterComposedFactory)(options)","+}"," const tanstackRouter = TanStackRouterEsbuild"," export default TanStackRouterEsbuild"," "],"additions":25,"deletions":17,"truncated":false},{"path":"packages/router-plugin/tests/esbuild.test.ts","lines":["@@ -0,0 +1,28 @@","+import { describe, expect, test } from 'vitest'","+import {","+  TanStackRouterCodeSplitterEsbuild,","+  TanStackRouterGeneratorEsbuild,","+  tanstackRouter,","+} from '../src/esbuild'","+","+describe('esbuild plugin', () => {","+  test('refuses autoCodeSplitting', () => {","+    expect(() =>","+      tanstackRouter({ target: 'react', autoCodeSplitting: true }),","+    ).toThrow(/autoCodeSplitting/)","+  })","+","+  test('refuses the code splitter entry', () => {","+    expect(() => TanStackRouterCodeSplitterEsbuild()).toThrow(","+      /autoCodeSplitting/,","+    )","+  })","+","+  test('accepts route generation without code splitting', () => {","+    expect(() => tanstackRouter({ target: 'react' })).not.toThrow()","+    expect(() =>","+      tanstackRouter({ target: 'react', autoCodeSplitting: false }),","+    ).not.toThrow()","+    expect(() => TanStackRouterGeneratorEsbuild()).not.toThrow()","+  })","+})",""],"additions":28,"deletions":0,"truncated":false}],"additions":69,"deletions":37,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-04T16:05:20.837903+00:00"}