document's events. Only the listener's connection events","+ * count: the document's snapshots also load while the listener is down, so a snapshot says","+ * nothing about whether the document is live.","+ *","+ * @internal","+ */","+export function toConnectionState(): OperatorFunction<{type: string}, ConnectionState> {","+  return (events$) =>","+    events$.pipe(","+      filter((event) => CONNECTION_EVENT_TYPES.has(event.type)),","+      map((event) => event.type !== 'reconnect'),","+      switchMap((isConnected): Observable<ConnectionState> =>","+        // oxlint-disable-next-line no-deprecated -- will fix in follow up PR","+        isConnected ? of('connected') : timer(200).pipe(mapTo('reconnecting')),","+      ),","+      startWith(INITIAL),","+      distinctUntilChanged(),","+    )","+}","+"," /**","  * The realtime connection state for a document, derived from its listener","  * events. Extracted so it can be combined with other document streams","@@ -24,16 +48,9 @@ export function connectionState(","   docTypeName: string,","   version?: string,"," ): Observable<ConnectionState> {","-  return documentStore.pair.documentEvents(publishedDocId, docTypeName, version).pipe(","-    map((ev: {type: string}) => ev.type),","-    map((eventType) => eventType !== 'reconnect'),","-    switchMap((isConnected): Observable<ConnectionState> =>","-      // oxlint-disable-next-line no-deprecated -- will fix in follow up PR","-      isConnected ? of('connected') : timer(200).pipe(mapTo('reconnecting')),","-    ),","-    startWith(INITIAL),","-    distinctUntilChanged(),","-  )","+  return documentStore.pair","+    .documentEvents(publishedDocId, docTypeName, version)","+    .pipe(toConnectionState())"," }"," "," /** @internal */"],"additions":29,"deletions":12,"truncated":false},{"path":"packages/sanity/src/core/preview/__test__/createObserveDocument.test.ts","lines":["@@ -1,11 +1,13 @@"," import {","+  ClientError,","   createClient,","   type MutationEvent,","   type Reco