nt_count / len(verdicts)"],"additions":4,"deletions":2,"truncated":false},{"path":"sdks/python/src/opik/evaluation/metrics/conversation/llm_judges/user_frustration/metric.py","lines":["@@ -270,7 +270,9 @@ def _score_from_verdicts(","     if len(verdicts) == 0:","         return 0.0"," ","-    frustrated_count = sum(v.verdict.strip().lower() == \"yes\" for v in verdicts)","+    frustrated_count = sum(","+        parsing_helpers.normalize_verdict(v.verdict) == \"yes\" for v in verdicts","+    )","     return frustrated_count / len(verdicts)"," "," ","@@ -280,7 +282,8 @@ def _extract_frustrations_from_verdicts(","     return [","         {\"message_number\": f\"{index + 1}\", \"reason\": verdict.reason}","         for index, verdict in enumerate(verdicts)","-        if verdict.verdict.strip().lower() == \"yes\" and verdict.reason is not None","+        if parsing_helpers.normalize_verdict(verdict.verdict) == \"yes\"","+        and verdict.reason is not None","     ]"," "," "],"additions":5,"deletions":2,"truncated":false},{"path":"sdks/python/src/opik/evaluation/metrics/llm_judges/parsing_helpers.py","lines":["@@ -3,6 +3,24 @@"," import opik.exceptions as exceptions"," "," ","+def normalize_verdict(verdict: str) -> str:","+    \"\"\"Normalize a judge ``verdict`` for comparison.","+","+    The conversation judges ask for ``yes``/``no`` but their schemas accept any","+    string, and models drift: ``\"Yes.\"``, ``\" no\"`` or ``\"YES\"`` all reach the","+    score computation. Comparing raw strings made the metrics disagree on the","+    same drifted value - the ``!= \"no\"`` metrics counted ``\"No.\"`` as a positive","+    verdict while the ``== \"yes\"`` ones dropped ``\"Yes.\"`` - so every judge now","+    reads the verdict through this one normalizer: case-folded, whitespace- and","+    trailing-punctuation-trimmed (period, comma, exclamation, question, semicolon,","+    colon - the sentence-enders a judge appends), so ``\"Yes.\"``, ``\" yes \"`` and","+    ``\"No .``\" all read as their bare verdict. Punctuation a verdict carries for","+    another reason (parentheses, dashes) is left alone: the normalizer removes","+    drift, it does not interpret the verdict.","+    \"\"\"","+    return verdict.strip().lower().rstrip(\".,!?;:\").strip()","+","+"," def extract_json_content_or_raise(content: str) -> Any:","     try:","         return json.loads(content)"],"additions":18,"deletions":0,"truncated":false},{"path":"sdks/python/src/opik/evaluation/threads/helpers.py","lines":["@@ -43,7 +43,11 @@ def load_conversation_thread("," ) -> conversation_thread.ConversationThread:","     traces = client.search_traces(","         project_name=project_name,","-        filter_string=f'thread_id = \"{thread.id}\"',","+        # A thread id is a free-form string, so a value containing a double","+        # quote would otherwise terminate the literal early and make the","+        # filter match other threads' traces. The OQL parser reads a doubled","+        # quote inside a double-quoted literal as one quote character.","+        filter_string=f'thread_id = \"{thread.id.replace(chr(34), chr(34) * 2)}\"',","         max_results=max_results,","         truncate=False,","     )"],"additions":5,"deletions":1,"truncated":false},{"path":"sdks/python/tests/unit/evaluation/metrics/llm_judges/conversation/conversational_coherence/test_metric.py","lines":["@@ -722,3 +722,35 @@ async def test_score__only_replies_without_text__raises_without_calling_the_mode","         await metric.ascore(conversation=conversation)"," ","     mock_model.agenerate_chat_completion.assert_not_called()","+","+","+def _punctuated_no_side_effect(*args, **kwargs):","+    \"\"\"A judge that drifts from the STRICTLY yes/no prompt with punctuation.\"\"\"","+    response_format = kwargs.get(\"response_format\")","+    if response_format == schema.EvaluateConversationCoherenceResponse:","+        return _assistant_message(json.dumps({\"verdict\": \"No.\", \"reason\": None}))","+    elif response_format == schema.ScoreReasonResponse:","+        return _assistant_message(json.dumps({\"reason\": \"The reply is off-topic.\"}))","+    return _assistant_message(\"{}\")","+","+","+def test_score__punctuated_no_verdict__still_counts_as_irrelevant(mock_model):","+    \"\"\"A drifted verdict must not silently inflate the score.","+","+    The prompt asks for STRICTLY ``yes``/``no`` but the schema accepts any","+    string, and models drift. Before the shared normalizer, ``\"No.\"`` passed","+    the ``!= \"no\"`` comparison and a fully incoherent thread scored 1.0.","+    \"\"\"","+    conversation = [","+        {\"role\": \"user\", \"content\": \"What is the overdraft fee?\"},","+        {\"role\": \"assistant\", \"content\": \"I like cats.\"},","+    ]","+    mock_model.generate_chat_completion.side_effect = _punctuated_no_side_effect","+","+    metric = ConversationalCoherenceMetric(model=mock_model, track=False)","+    result = metric.score(conversation=conversation)","+","+    assert result.name == \"conversational_coherence_score\"","+    assert result.value == 0.0","+    assert result.reason == \"The reply is off-topic.\"","+    assert result.scoring_failed is False"],"additions":32,"deletions":0,"truncated":false},{"path":"sdks/python/tests/unit/evaluation/metrics/llm_judges/conversation/session_completeness/test_metric.py","lines":["@@ -329,3 +329,26 @@ async def test__session_completeness_quality__empty_conversation__raises_error__","     )","     with pytest.raises(exceptions.MetricComputationError):","         await metric.ascore(conversation=conversation)","+","+","+def test__session_completeness_quality__punctuated_no_verdict__counts_as_unmet(","+    simple_conversation, mock_model","+):","+    \"\"\"A drifted verdict must not silently inflate the score.","+","+    The prompt asks for STRICTLY ``yes``/``no`` but the schema accepts any","+    string, and models drift. Before the shared normalizer, ``\"No.\"`` passed","+    the ``!= \"no\"`` comparison and an unmet goal counted as addressed.","+    \"\"\"","+    mock_model.generate_chat_completion.side_effect = _assistant_messages(","+        '{\"user_goals\": [\"Find a chocolate cake recipe\", \"Plan a weekend trip to the mountains\"]}',","+        '{\"verdict\": \"No.\", \"reason\": \"No recipe was provided.\"}',","+        '{\"verdict\": \"No.\", \"reason\": \"No packing advice was provided.\"}',","+        '{\"reason\": \"Neither goal was addressed.\"}',","+    )","+","+    metric = SessionCompletenessQuality(model=mock_model, track=False)","+    result = metric.score(simple_conversation)","+","+    assert_helpers.assert_score_result(result)","+    assert result.value == 0.0"],"additions":23,"deletions":0,"truncated":false},{"path":"sdks/python/tests/unit/evaluation/metrics/llm_judges/conversation/user_frustration/test_metric.py","lines":["@@ -378,3 +378,38 @@ async def test_score__with_all_frustrated_responses__async(mock_model):","     assert result.name == \"test_frustration\"","     assert result.value == 1.0","     assert \"frustration\" in result.reason.lower()","+","+","+def _punctuated_frustration_side_effect(*args, **kwargs):","+    \"\"\"A judge that drifts from the STRICTLY yes/no prompt with punctuation.\"\"\"","+    response_format = kwargs.get(\"response_format\")","+    if response_format == schema.EvaluateUserFrustrationResponse:","+        return _assistant_message(json.dumps({\"verdict\": \"Yes.\", \"reason\": None}))","+    elif response_format == schema.ScoreReasonResponse:","+        return _assistant_message(json.dumps({\"reason\": \"The user is frustrated.\"}))","+    return _assistant_message(\"{}\")","+","+","+def test_score__punctuated_yes_verdict__still_counts_as_frustrated(mock_model):","+    \"\"\"A drifted verdict must not silently flip the score.","+","+    The prompt asks for STRICTLY ``yes``/``no`` but the schema accepts any","+    string, and models drift. Before the shared normalizer, ``\"Yes.\"`` failed","+    the ``== \"yes\"`` comparison and a fully frustrated thread scored 0.0.","+    \"\"\"","+    conversation = [","+        {\"role\": \"user\", \"content\": \"This is the third time I'm asking!\"},","+        {\"role\": \"assistant\", \"content\": \"Could you rephrase the question?\"},","+        {\"role\": \"user\", \"content\": \"I already did. Twice!\"},","+    ]","+    mock_model.generate_chat_completion.side_effect = (","+        _punctuated_frustration_side_effect","+    )","+","+    metric = UserFrustrationMetric(model=mock_model, track=False)","+    result = metric.score(conversation=conversation)","+","+    assert result.name == \"user_frustration_score\"","+    assert result.value == 1.0","+    assert result.reason == \"The user is frustrated.\"","+    assert result.scoring_failed is False"],"additions":35,"deletions":0,"truncated":false},{"path":"sdks/python/tests/unit/evaluation/metrics/llm_judges/test_parsing_helpers.py","lines":["@@ -68,3 +68,33 @@ def test_reason_to_text__non_string_items_in_list__stringified(self):"," ","     def test_reason_to_text__empty_list__returns_no_reason_provided(self):","         assert parsing_helpers.reason_to_text([]) == \"No reason provided\"","+","+","+class TestNormalizeVerdict:","+    def test_normalize_verdict__plain_yes_no__unchanged(self):","+        assert parsing_helpers.normalize_verdict(\"yes\") == \"yes\"","+        assert parsing_helpers.normalize_verdict(\"no\") == \"no\"","+","+    def test_normalize_verdict__case_and_whitespace__folded(self):","+        assert parsing_helpers.normalize_verdict(\"YES\") == \"yes\"","+        assert parsing_helpers.normalize_verdict(\"  No \") == \"no\"","+","+    def test_normalize_verdict__trailing_punctuation__trimmed(self):","+        # Models drift from the \"STRICTLY yes/no\" prompt; the score","+        # computations must not read \"No.\" as a positive verdict.","+        assert parsing_helpers.normalize_verdict(\"Yes.\") == \"yes\"","+        assert parsing_helpers.normalize_verdict(\"No.\") == \"no\"","+        assert parsing_helpers.normalize_verdict(\"no!\") == \"no\"","+        assert parsing_helpers.normalize_verdict(\"yes,\") == \"yes\"","+","+    def test_normalize_verdict__whitespace_before_punctuation__trimmed(self):","+        # A space between the verdict and its punctuation must not survive:","+        # \"No .\" would otherwise read as \"no \" and fail the exact comparison.","+        assert parsing_helpers.normalize_verdict(\"No .\") == \"no\"","+        assert parsing_helpers.normalize_verdict(\"Yes !\") == \"yes\"","+        assert parsing_helpers.normalize_verdict(\"no ;\") == \"no\"","+","+    def test_normalize_verdict__unrecognized_words__left_as_is(self):","+        # A genuinely ambiguous verdict stays ambiguous: the caller decides","+        # how to count it, the normalizer only removes drift.","+        assert parsing_helpers.normalize_verdict(\"kind of\") == \"kind of\""],"additions":30,"deletions":0,"truncated":false},{"path":"sdks/python/tests/unit/evaluation/threads/test_helpers.py","lines":["@@ -101,3 +101,36 @@ def output_transform(json_output):","         max_results=10,","         truncate=False,","     )","+","+","+def test_load_conversation_thread__thread_id_with_double_quote__filter_stays_scoped():","+    \"\"\"A thread id containing a double quote must not break out of the filter.","+","+    The filter is built by string interpolation, so an unescaped quote would","+    terminate the literal early and make the filter match other threads'","+    traces. The OQL parser reads a doubled quote inside a double-quoted","+    literal as one quote character.","+    \"\"\"","+    mock_opik_client = mock.MagicMock()","+    mock_opik_client.search_traces.return_value = []","+","+    thread = TraceThread(id='thread\"123')","+    helpers.load_conversation_thread(","+        thread=thread,","+        trace_input_transform=lambda x: x.get(\"content\", \"\"),","+        trace_output_transform=lambda x: x.get(\"content\", \"\"),","+        max_results=10,","+        project_name=\"test_project\",","+        client=mock_opik_client,","+    )","+","+    call_kwargs = mock_opik_client.search_traces.call_args[1]","+    assert call_kwargs[\"filter_string\"] == 'thread_id = \"thread\"\"123\"'","+","+    # The generated filter must parse back to the original thread id.","+    from opik.api_objects import opik_query_language","+","+    parsed = opik_query_language.OpikQueryLanguage.for_traces(","+        call_kwargs[\"filter_string\"]","+    ).get_filter_expressions()","+    assert parsed[0][\"value\"] == 'thread\"123'",""],"additions":33,"deletions":0,"truncated":false}],"additions":190,"deletions":7,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-04T16:05:41.688969+00:00"}