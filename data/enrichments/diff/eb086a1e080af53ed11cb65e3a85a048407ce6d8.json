;","+        $this->assertEquals('storage_invalid_content_range', $second['body']['type']);","+    }","+","+    public function testChunkedUploadRejectsShortChunk(): void","+    {","+        $bucketId = $this->createChunkedUploadBucket('Short Chunk Bucket');","+        $chunkSize = 5 * 1024 * 1024;","+        $totalSize = $chunkSize + 1024;","+","+        $first = $this->uploadChunk($bucketId, 'unique()', '', \\str_repeat('a', $chunkSize), 'bytes 0-' . ($chunkSize - 1) . '/' . $totalSize);","+        $this->assertEquals(201, $first['headers']['status-code']);","+        $fileId = $first['body']['$id'];","+","+        // The last chunk carries fewer bytes than its range announces.","+        $second = $this->uploadChunk($bucketId, $fileId, $fileId, \\str_repeat('b', 10), 'bytes ' . $chunkSize . '-' . ($totalSize - 1) . '/' . $totalSize);","+        $this->assertEquals(400, $second['headers']['status-code']);","+        $this->assertEquals('storage_invalid_content_range', $second['body']['type']);","+","+        $file = $this->client->call(Client::METHOD_GET, '/storage/buckets/' . $bucketId . '/files/' . $fileId, \\array_merge([","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+        ], $this->getHeaders()));","+        $this->assertEquals(404, $file['headers']['status-code']);","+    }","+","+    private function createChunkedUploadBucket(string $name): string","+    {","+        $bucket = $this->client->call(Client::METHOD_POST, '/storage/buckets', \\array_merge([","+            'content-type' => 'application/json',","+            'x-appwrite-project' => $this->getProject()['$id'],","+        ], $this->getHeaders()), [","+            'bucketId' => Id::unique(),","+            'name' => $name,","+            'fileSecurity' => true,","+            'antivirus' => false,","+            'permissions' => [","+                Permission::create(Role::any()),","+                Permission::read(Role::any()),","+            ],","+        ]);","+        $this->assertEquals(201, $bucket['headers']['status-code']);","+","+        return $bucket['body']['$id'];","+    }","+","+    /**","+     * @return array<string, mixed>","+     */","+    private function uploadChunk(string $bucketId, string $fileId, string $resumeId, string $bytes, string $range): array","+    {","+        $headers = [","+            'content-type' => 'multipart/form-data',","+            'x-appwrite-project' => $this->getProject()['$id'],","+            'content-range' => $range,","+        ];","+        if ($resumeId !== '') {","+            $headers['x-appwrite-id'] = $resumeId;","+        }","+","+        return $this->client->call(Client::METHOD_POST, '/storage/buckets/' . $bucketId . '/files', \\array_merge($headers, $this->getHeaders()), [","+            'fileId' => $fileId,","+            'file' => new CURLFile('data://text/plain;base64,' . \\base64_encode($bytes), 'text/plain', 'chunk.txt'),","+            'permissions' => [","+                Permission::read(Role::any()),","+            ],","+        ]);","+    }"," }",""],"additions":81,"deletions":0,"truncated":false}],"additions":111,"deletions":2,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-16T14:19:21.197087+00:00"}