opfs\" VFS',","     //predicate: ()=>false,","     test: async function(sqlite3){","       /* https://sqlite.org/forum/forumpost/cf37d5ff1182c31081","@@ -4776,156 +4780,6 @@ T.g('Bug Reports')","         .assert(pAuxDestructed===nAuxSet);","     }","   })","-//#define ? sqlite3_set_auxdata:dtor 0","-//#if sqlite3_set_auxdata:dtor","-/* Full details: search sqlite3-api-glue.c-pp.js for","-   [tag:sqlite3_set_auxdata:dtor]. */","-  .t({","-    /* https://github.com/sqlite/sqlite-wasm/issues/92 */","-    name: 'sqlite3_set_auxdata() binding part two',","-    predicate: ()=>{","-      return wasm.xWrap.argAdapter('sqlite3_set_auxdata:dtor')","-        ? true","-        : \"Requires sqlite3_set_auxdata:dtor conversion\"","-    },","-    test: function(sqlite3){","-      const db = new sqlite3.oo1.DB();","-      const pAux = db.pointer; // any pointer will do","-      let pAuxDestructed = 0;","-      const cxSeen = new Set;","-      const pAuxDtor = (ptr)=>{","-        //log(\"freeing auxdata\");","-        ++pAuxDestructed;","-      };","-      let nAuxSet = 0 /* how many times we set aux data */;","-      let nAuxReused = 0 /* how many times we reused aux data */;","-      try{","-        db.createFunction(\"auxtest\",{","-          xFunc: function(pCx, x, y){","-            T.assert(wasm.isPtr(pCx));","-            cxSeen.add(pCx);","-            const localAux = capi.sqlite3_get_auxdata(pCx, 0);","-            if( !localAux ){","-              //log(\"setting auxdata\");","-              ++nAuxSet;","-              capi.sqlite3_set_auxdata(pCx, 0, pAux, pAuxDtor);","-            }else{","-              //log(\"reusing auxdata\",localAux);","-              T.assert(pAux===localAux);","-              ++nAuxReused;","-            }","-            return x;","-          }","-        });","-        console.error(\"Before 2x UDF w/ aux data for 4 rows\");","-        db.exec([","-          \"create table t(a);\",","-          \"insert into t(a) values(1),(2),(-1),(-2);\",","