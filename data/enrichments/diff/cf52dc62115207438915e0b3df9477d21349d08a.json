n creates","-                 an entry in the WASM indirect function table.","-","-                 Best case (depending on how we concretely handle the","-                 conversion), this can lead to many JS/WASM proxy","-                 bindings being installed and uninstalled in rapid","-                 succession. Worst case (depending on the conversion","-                 impl), all such bindings are live until pCx is","-                 finalized.","-","-                 The way around that is to follow the pattern used in","-                 the variant of his test function two above this","-                 one. It demonstrates how to manually manage these","-                 safely and efficiently. We currently have no good way","-                 to automate that level of efficiency, however.","-              */","-              ++nAuxSet;","-              if( nAuxSet - nAuxDestructed>nPeakAux ){","-                nPeakAux = nAuxSet - nAuxDestructed;","-              }","-              capi.sqlite3_set_auxdata(pCx, 0, pAux, auxDtor);","-            }else{","-              //log(\"reusing auxdata\",localAux);","-              T.assert(pAux===localAux);","-              ++nAuxReused;","-            }","-            return x;","-          }","-        });","-        db.exec([","-          \"create table t(a);\",","-          \"insert into t(a) values(1),(2),(-1),(-2);\",","-          \"select auxtest(1,a) + auxtest(2,a), auxtest(3,a) \",","-          \"from t order by a;\"","-        ]);","-        /* The following numbers are very specific to the rules of","-           when auxdata dtors are called. */","-        T.assert(3===nAuxSet)","-          .assert(nAuxSet===nPeakAux)","-          .assert(9===nAuxReused)","-          .assert(nAuxDestructed===nAuxSet);","-        db.exec(\"select auxtest(1,a), auxtest(2,a) from t order by a;\");","-        T.assert(5===nAuxSet)","-          .assert(3===nPeakAux)","-          .assert(15===nAuxReused)","-          .assert(nAuxDestructed===nAuxSet);","-        db.exec(\"select auxtest(1*a,a), auxtest(2+a,a) from t order by a;\");","-        T.assert(13===nAuxSet/*twice per row*/)","-          .assert(3===nPeakAux)","-          .assert(15===nAuxReused/*unchanged!*/)","-          .assert(nAuxDestructed===nAuxSet);","-      }finally{","-        db.close();","-      }","-    }","-  })","-//#/if sqlite3_set_auxdata:dtor"," ;/*end of Bug Reports group*/;"," "," ////////////////////////////////////////////////////////////////////////"],"additions":12,"deletions":158,"truncated":false},{"path":"manifest","lines":["@@ -1,5 +1,5 @@","-C Revise\\sa\\stest\\scase\\sso\\sthat\\sit\\sworks\\seven\\son\\ssystems\\swith\\svery\\slarge\\nfilesystem\\spage\\ssizes.\\n[forum:/info/2026-10-11T08:31:48Z|Forum\\sthread\\s2026-10-11T08:31:48Z]","-D 2026-11-05T15:13:59.518","+C Remove\\sa\\slarge\\schunk\\sof\\s#if'd-out\\stests\\sof\\sthe\\sfailed\\sauxdata\\sdtor\\sbinding\\sexperiment.","+D 2026-11-05T15:31:54.405"," F .fossil-settings/binary-glob 61195414528fb3ea9693577e1980230d78a1f8b0a54c78cf1b9b24d0a409ed6a x"," F .fossil-settings/empty-dirs dbb81e8fc0401ac46a1491ab34a7f2c7c0452f2f06b54ebb845d024ca8283ef1"," F .fossil-settings/ignore-glob 35175cdfcf539b2318cb04a9901442804be81cd677d8b889fcc9149c21f239ea","@@ -722,7 +722,7 @@ F ext/wasm/sql/001-sudoku.sql 35b7cb7239ba5d5f193bc05ec379bcf66891bce6f2a5b3879f"," F ext/wasm/test-opfs-vfs.html 1f2d672f3f3fce810dfd48a8d56914aba22e45c6834e262555e685bce3da8c3f"," F ext/wasm/tester1-worker.c-pp.html c95f3b37c5baa6e7ca1c9c622a081b02dae1acb011e7dc3c99c488456be2864b"," F ext/wasm/tester1.c-pp.html ef13dd266d4aa7dae0f27f4448978e571bddb0c7e058d108328438feef226ae9","-F ext/wasm/tester1.c-pp.js f9a8889bbdb02ca0722a690d8a138ed728622a2c96c6cad14ccb60c0533320ef","+F ext/wasm/tester1.c-pp.js ff51f22f05b08c392cb8707cd400aba1b934657e6eae0393fb1b0e0d4650ae9f"," F ext/wasm/tests/opfs/concurrency/index.html 706eab6308343c04ac2360aba6001af4ffaf46d8f33a0ccd02c64d93e3216a43"