{"id":"87133479d098749ace4e220e005e315b4f898c26","axis":"silent","repo":"redis/redis","sha":"87133479d098749ace4e220e005e315b4f898c26","parsed":{"files":[{"path":"src/config.c","lines":["@@ -3417,6 +3417,7 @@ static int updateReplBacklogSize(const char **err) {"," "," static int updateMaxmemory(const char **err) {","     UNUSED(err);","+    moduleUpdateMaxmemorySnapshot();","     if (server.maxmemory) {","         size_t used = zmalloc_used_memory()-freeMemoryGetNotCountedMemory();","         if (server.maxmemory < used) {"],"additions":1,"deletions":0,"truncated":false},{"path":"src/module.c","lines":["@@ -12454,6 +12454,42 @@ float RM_GetUsedMemoryRatio(void){","     return level;"," }"," ","+/* Copy of server.maxmemory that other threads can read, since server.maxmemory","+ * is a plain field written by CONFIG SET. */","+static redisAtomic unsigned long long maxmemory_snapshot = 0;","+","+/* Publish server.maxmemory for RM_GetUsedMemoryRatioEstimate(). Must be","+ * called on the main thread after every change of server.maxmemory. */","+void moduleUpdateMaxmemorySnapshot(void) {","+    atomicSet(maxmemory_snapshot, server.maxmemory);","+}","+","+/* Return a number between 0 and 1 indicating the amount of memory currently","+ * used, relative to the Redis \"maxmemory\" configuration, like","+ * RedisModule_GetUsedMemoryRatio(), with two differences:","+ *","+ * * The used memory is the raw allocator total (INFO `used_memory`). The","+ *   replication and AOF buffers that RedisModule_GetUsedMemoryRatio() excludes","+ *   are counted, because reading them is what makes that API main-thread only.","+ * * It is thread safe: it may be called from any thread, with or without","+ *   holding the GIL.","+ *","+ * The value is approximate: used memory is a relaxed sum of per-thread","+ * counters, and the maxmemory snapshot is refreshed by the main thread when","+ * the configuration changes.","+ *","+ * * 0 - No memory limit configured.","+ * * Between 0 and 1 - The percentage of the memory used normalized in 0-1 range.","+ * * Exactly 1 - Memory limit reached.","+ * * Greater 1 - More memory used than the configured limit.","+ */","+float RM_GetUsedMemoryRatioEstimate(void) {","+    unsigned long long maxmemory;","+    atomicGet(maxmemory_snapshot, maxmemory);","+    if (maxmemory == 0) return 0;","+    return (float)zmalloc_used_memory() / (float)maxmemory;","+}","+"," /* --------------------------------------------------------------------------","  * ## Scanning keyspace and hashes","  * -------------------------------------------------------------------------- */","@@ -16393,6 +16429,7 @@ void moduleRegisterCoreAPI(void) {","     REGISTER_API(SignalKeyAsReady);","     REGISTER_API(GetBlockedClientReadyKey);","     REGISTER_API(GetUsedMemoryRatio);","+    REGISTER_API(GetUsedMemoryRatioEstimate);","     REGISTER_API(MallocSize);","     REGISTER_API(MallocUsableSize);","     REGISTER_API(MallocSizeString);"],"additions":37,"deletions":0,"truncated":false},{"path":"src/redismodule.h","lines":["@@ -1464,6 +1464,7 @@ REDISMODULE_API void (*RedisModule_SendChildHeartbeat)(double progress) REDISMOD"," REDISMODULE_API int (*RedisModule_ExitFromChild)(int retcode) REDISMODULE_ATTR;"," REDISMODULE_API int (*RedisModule_KillForkChild)(int child_pid) REDISMODULE_ATTR;"," REDISMODULE_API float (*RedisModule_GetUsedMemoryRatio)(void) REDISMODULE_ATTR;","+REDISMODULE_API float (*RedisModule_GetUsedMemoryRatioEstimate)(void) REDISMODULE_ATTR;"," REDISMODULE_API size_t (*RedisModule_MallocSize)(void* ptr) REDISMODULE_ATTR;"," REDISMODULE_API size_t (*RedisModule_MallocUsableSize)(void *ptr) REDISMODULE_ATTR;"," REDISMODULE_API size_t (*RedisModule_MallocSizeString)(RedisModuleString* str) REDISMODULE_ATTR;","@@ -1873,6 +1874,7 @@ static int RedisModule_Init(RedisModuleCtx *ctx, const char *name, int ver, int","     REDISMODULE_GET_API(ExitFromChild);","     REDISMODULE_GET_API(KillForkChild);","     REDISMODULE_GET_API(GetUsedMemoryRatio);","+    REDISMODULE_GET_API(GetUsedMemoryRatioEstimate);","     REDISMODULE_GET_API(MallocSize);","     REDISMODULE_GET_API(MallocUsableSize);","     REDISMODULE_GET_API(MallocSizeString);"],"additions":2,"deletions":0,"truncated":false},{"path":"src/server.c","lines":["@@ -3264,6 +3264,7 @@ void initServer(void) {","         server.maxmemory = 3072LL*(1024*1024); /* 3 GB */","         server.maxmemory_policy = MAXMEMORY_NO_EVICTION;","     }","+    moduleUpdateMaxmemorySnapshot();"," ","     luaEnvInit();","     scriptingInit(1);"],"additions":1,"deletions":0,"truncated":false},{"path":"src/server.h","lines":["@@ -3407,6 +3407,7 @@ int moduleDefragValue(robj *key, robj *obj, int dbid);"," int moduleLateDefrag(robj *key, robj *value, unsigned long *cursor, monotime endtime, int dbid);"," void moduleDefragStart(void);"," void moduleDefragEnd(void);","+void moduleUpdateMaxmemorySnapshot(void);"," void *moduleGetHandleByName(char *modulename);"," int moduleIsModuleCommand(void *module_handle, struct redisCommand *cmd);"," int moduleHasSubscribersForKeyspaceEvent(int type);"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/modules/misc.c","lines":["@@ -5,6 +5,7 @@"," #include <unistd.h>"," #include <errno.h>"," #include <limits.h>","+#include <pthread.h>"," "," #define UNUSED(x) (void)(x)"," ","@@ -596,6 +597,36 @@ int test_signalmodifiedkey(RedisModuleCtx *ctx, RedisModuleString **argv, int ar","     return REDISMODULE_OK;"," }"," ","+int test_used_memory_ratio(RedisModuleCtx *ctx, RedisModuleString **argv, int argc) {","+    UNUSED(argv);","+    if (argc != 1) return RedisModule_WrongArity(ctx);","+    return RedisModule_ReplyWithDouble(ctx, RedisModule_GetUsedMemoryRatio());","+}","+","+int test_used_memory_ratio_estimate(RedisModuleCtx *ctx, RedisModuleString **argv, int argc) {","+    UNUSED(argv);","+    if (argc != 1) return RedisModule_WrongArity(ctx);","+    return RedisModule_ReplyWithDouble(ctx, RedisModule_GetUsedMemoryRatioEstimate());","+}","+","+static void *used_memory_ratio_thread_main(void *arg) {","+    *(float *)arg = RedisModule_GetUsedMemoryRatioEstimate();","+    return NULL;","+}","+","+/* Calls RedisModule_GetUsedMemoryRatioEstimate() from a thread that does not","+ * hold the GIL. */","+int test_used_memory_ratio_estimate_bg(RedisModuleCtx *ctx, RedisModuleString **argv, int argc) {","+    UNUSED(argv);","+    if (argc != 1) return RedisModule_WrongArity(ctx);","+    pthread_t tid;","+    float ratio = -1;","+    if (pthread_create(&tid, NULL, used_memory_ratio_thread_main, &ratio) != 0)","+        return RedisModule_ReplyWithError(ctx, \"-ERR Can't start thread\");","+    pthread_join(tid, NULL);","+    return RedisModule_ReplyWithDouble(ctx, ratio);","+}","+"," int RedisModule_OnLoad(RedisModuleCtx *ctx, RedisModuleString **argv, int argc) {","     REDISMODULE_NOT_USED(argv);","     REDISMODULE_NOT_USED(argc);","@@ -674,6 +705,12 @@ int RedisModule_OnLoad(RedisModuleCtx *ctx, RedisModuleString **argv, int argc)","         return REDISMODULE_ERR;","     if (RedisModule_CreateCommand(ctx, \"test.signalmodifiedkey\", test_signalmodifiedkey, \"write\", 1, 1, 1) == REDISMODULE_ERR)","         return REDISMODULE_ERR;","+    if (RedisModule_CreateCommand(ctx, \"test.used_memory_ratio\", test_used_memory_ratio, \"\", 0, 0, 0) == REDISMODULE_ERR)","+        return REDISMODULE_ERR;","+    if (RedisModule_CreateCommand(ctx, \"test.used_memory_ratio_estimate\", test_used_memory_ratio_estimate, \"\", 0, 0, 0) == REDISMODULE_ERR)","+        return REDISMODULE_ERR;","+    if (RedisModule_CreateCommand(ctx, \"test.used_memory_ratio_estimate_bg\", test_used_memory_ratio_estimate_bg, \"\", 0, 0, 0) == REDISMODULE_ERR)","+        return REDISMODULE_ERR;"," ","     return REDISMODULE_OK;"," }"],"additions":37,"deletions":0,"truncated":false},{"path":"tests/unit/moduleapi/misc.tcl","lines":["@@ -531,6 +531,37 @@ start_server {overrides {save {900 1}} tags {\"modules external:skip\"}} {","     test \"Cluster keyslot\" {","         assert_equal 12182 [r test.keyslot foo]","     }","+","+    test \"GetUsedMemoryRatioEstimate is 0 without maxmemory\" {","+        r config set maxmemory 0","+        assert_equal 0 [r test.used_memory_ratio_estimate]","+        assert_equal 0 [r test.used_memory_ratio_estimate_bg]","+        assert_equal 0 [r test.used_memory_ratio]","+    }","+","+    test \"GetUsedMemoryRatioEstimate tracks used_memory and maxmemory\" {","+        set maxmemory [expr {[s used_memory] * 4}]","+        r config set maxmemory $maxmemory","+        set ratio [r test.used_memory_ratio_estimate]","+        set expected [expr {double([s used_memory]) / $maxmemory}]","+        assert_range $ratio [expr {$expected * 0.95}] [expr {$expected * 1.05}]","+","+        # Never smaller than RM_GetUsedMemoryRatio(), which subtracts the","+        # replication and AOF buffers. Allow for noise between the two calls.","+        set ratio_main [r test.used_memory_ratio]","+        assert_morethan_equal $ratio [expr {$ratio_main * 0.99}]","+","+        # A new maxmemory is reflected on the very next call.","+        r config set maxmemory [expr {$maxmemory * 2}]","+        set ratio_halved [r test.used_memory_ratio_estimate]","+        assert_range $ratio_halved [expr {$ratio / 2 * 0.95}] [expr {$ratio / 2 * 1.05}]","+","+        # Same value from a thread that does not hold the GIL.","+        set ratio_bg [r test.used_memory_ratio_estimate_bg]","+        assert_range $ratio_bg [expr {$ratio_halved * 0.95}] [expr {$ratio_halved * 1.05}]","+","+        r config set maxmemory 0","+    }"," }"," "," start_server {tags {\"modules external:skip\"}} {",""],"additions":31,"deletions":0,"truncated":false}],"additions":110,"deletions":0,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-05T16:29:59.272356+00:00"}