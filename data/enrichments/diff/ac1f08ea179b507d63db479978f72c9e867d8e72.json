&c->component_suggest_on    },","-                { \"Component\", \"SuggestOnOSRelease\",         config_parse_condition,           CONDITION_OS_RELEASE,          &c->component_suggest_on    },","-                { \"Component\", \"SuggestOnMachineTag\",        config_parse_condition,           CONDITION_MACHINE_TAG,         &c->component_suggest_on    },","+                { \"Component\", \"Description\",                config_parse_string,                   0,                             &c->component_description    },","+                { \"Component\", \"Documentation\",              config_parse_url_specifiers_many,      0,                             &c->component_documentation  },","+                { \"Component\", \"Enabled\",                    config_parse_bool,                     0,                             &c->component_enabled        },","+                { \"Component\", \"SuccessAction\",              config_parse_component_success_action, 0,                             &c->component_success_action },","+                { \"Component\", \"Suggest\",                    config_parse_tristate,                 0,                             &c->component_suggest        },","+                { \"Component\", \"SuggestOnArchitecture\",      config_parse_condition,                CONDITION_ARCHITECTURE,        &c->component_suggest_on     },","+                { \"Component\", \"SuggestOnFirmware\",          config_parse_condition,                CONDITION_FIRMWARE,            &c->component_suggest_on     },","+                { \"Component\", \"SuggestOnVirtualization\",    config_parse_condition,                CONDITION_VIRTUALIZATION,      &c->component_suggest_on     },","+                { \"Component\", \"SuggestOnHost\",              config_parse_condition,                CONDITION_HOST,                &c->component_suggest_on     },","+                { \"Component\", \"SuggestOnFraction\",          config_parse_condition,                CONDITION_FRACTION,            &c->component_suggest_on     },","+                { \"Component\", \"SuggestOnKernelCommandLine\", config_parse_condition,                CONDITION_KERNEL_COMMAND_LINE, &c->component_suggest_on     },","+                { \"Component\", \"SuggestOnVersion\",           config_parse_condition,                CONDITION_VERSION,             &c->component_suggest_on     },","+                { \"Component\", \"SuggestOnCredential\",        config_parse_condition,                CONDITION_CREDENTIAL,          &c->component_suggest_on     },","+                { \"Component\", \"SuggestOnSecurity\",          config_parse_condition,                CONDITION_SECURITY,            &c->component_suggest_on     },","+                { \"Component\", \"SuggestOnOSRelease\",         config_parse_condition,                CONDITION_OS_RELEASE,          &c->component_suggest_on     },","+                { \"Component\", \"SuggestOnMachineTag\",        config_parse_condition,                CONDITION_MACHINE_TAG,         &c->component_suggest_on     },","                 {}","         };"," ","@@ -2782,8 +2783,18 @@ static int context_update_iteration(","                         r = context_update(&cc, version, booted_version, action_flags, reboot_needed);","                         if (r == -EHOSTDOWN) /* Component disabled → skip it in the \"all\" case. */","                                 continue;","-                        if (r > 0)","+                        if (r > 0) {","                                 installed = true;","+","+                                if (cc.component_success_action == COMPONENT_SUCCESS_RESTART) {","+                                        /* The component asked us to start from the beginning after it","+                                         * has been updated successfully, for example because it makes","+                                         * new transfer files available. Hence, finish this iteration","+                                         * early, and skip the remaining components. */","+                                        log_info(\"Component '%s' updated successfully, finishing update iteration early.\", *name);","+                                        break;","+                                }","+                        }","                         RET_GATHER(ret, r);","                 }"," "],"additions":27,"deletions":16,"truncated":false},{"path":"src/sysupdate/sysupdate.h","lines":["@@ -1,6 +1,7 @@"," /* SPDX-License-Identifier: LGPL-2.1-or-later */"," #pragma once"," ","+#include \"sysupdate-config.h\""," #include \"sysupdate-forward.h\""," #include \"sysupdate-target.h\""," ","@@ -36,6 +37,7 @@ typedef struct Context {","         char *component_description;","         char **component_documentation;","         bool component_enabled;","+        ComponentSuccessAction component_success_action;"," ","         int component_suggest;","         Condition *component_suggest_on;"],"additions":2,"deletions":0,"truncated":false},{"path":"test/units/TEST-72-SYSUPDATE.sh","lines":["@@ -809,6 +809,65 @@ grep -F 'Maximum number of update iterations (2) reached' \"$LOOPDIR/log\" >/dev/n"," "," rm -rf \"$LOOPDIR\""," ","+# Test SuccessAction= in *.component files: two components, the first one is configured to restart the","+# update iteration once it has been updated successfully.","+ACTIONDIR=\"$WORKDIR/component-actions\"","+action_reset() {","+    rm -rf \"$ACTIONDIR\" /run/sysupdate.act-a.d /run/sysupdate.act-b.d \\","+        /run/sysupdate.act-a.component /run/sysupdate.act-b.component \\","+        /var/lib/systemd/sysupdate/installdb.act-a /var/lib/systemd/sysupdate/installdb.act-b","+    mkdir -p \"$ACTIONDIR/source\" /run/sysupdate.act-a.d /run/sysupdate.act-b.d","+","+    for c in a b; do","+        mkdir -p \"$ACTIONDIR/target-$c\"","+        echo \"$c\" >\"$ACTIONDIR/source/act-$c-1.bin\"","+        cat >\"/run/sysupdate.act-$c.d/01-act-$c.transfer\" <<EOF","+[Source]","+Type=regular-file","+Path=$ACTIONDIR/source","+MatchPattern=act-$c-@v.bin","+","+[Target]","+Type=regular-file","+Path=$ACTIONDIR/target-$c","+MatchPattern=act-$c-@v.bin","+EOF","+    done","+}","+","+# Move the default component's definitions out of the way, we only want to update our two components","+mv \"$CONFIGDIR\" \"$CONFIGDIR.backup\"","+","+# By default we continue with the next component, hence a single iteration updates both","+action_reset","+\"$SYSUPDATE\" --component-all --verify=no update","+cmp \"$ACTIONDIR/source/act-a-1.bin\" \"$ACTIONDIR/target-a/act-a-1.bin\"","+cmp \"$ACTIONDIR/source/act-b-1.bin\" \"$ACTIONDIR/target-b/act-b-1.bin\"","+","+# With SuccessAction=restart the iteration is finished after the first component got updated","+action_reset","+printf '[Component]\\nSuccessAction=restart\\n' >/run/sysupdate.act-a.component","+\"$SYSUPDATE\" --component-all --verify=no update |& tee \"$ACTIONDIR/log\"","+cmp \"$ACTIONDIR/source/act-a-1.bin\" \"$ACTIONDIR/target-a/act-a-1.bin\"","+test ! -e \"$ACTIONDIR/target-b/act-b-1.bin\"","+grep -F \"Component 'act-a' updated successfully, finishing update iteration early.\" \"$ACTIONDIR/log\" >/dev/null","+# … and the next invocation picks up the second component","+\"$SYSUPDATE\" --component-all --verify=no update","+cmp \"$ACTIONDIR/source/act-b-1.bin\" \"$ACTIONDIR/target-b/act-b-1.bin\"","+","+# With --loop= the restart happens within a single invocation","+action_reset","+printf '[Component]\\nSuccessAction=restart\\n' >/run/sysupdate.act-a.component","+\"$SYSUPDATE\" --component-all --verify=no --loop=16 update |& tee \"$ACTIONDIR/log\"","+cmp \"$ACTIONDIR/source/act-a-1.bin\" \"$ACTIONDIR/target-a/act-a-1.bin\"","+cmp \"$ACTIONDIR/source/act-b-1.bin\" \"$ACTIONDIR/target-b/act-b-1.bin\"","+grep -F 'stable state reached after 3 iterations' \"$ACTIONDIR/log\" >/dev/null","+","+rm -rf \"$ACTIONDIR\" /run/sysupdate.act-a.d /run/sysupdate.act-b.d \\","+    /run/sysupdate.act-a.component /run/sysupdate.act-b.component \\","+    /var/lib/systemd/sysupdate/installdb.act-a /var/lib/systemd/sysupdate/installdb.act-b","+mv \"$CONFIGDIR.backup\" \"$CONFIGDIR\"","+"," # Make sure the processing of compressed streams still handles uncompressed streams shorter than"," # COMPRESSION_MAGIC_BYTES_MAX correctly."," rm -rf \"$CONFIGDIR\" \"$WORKDIR/blobs\"",""],"additions":59,"deletions":0,"truncated":false}],"additions":125,"deletions":16,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-14T13:06:33.978846+00:00"}