 => &mut n.arg,","+                Expr::Await(n) => &mut n.arg,","+                Expr::TsTypeAssertion(n) => &mut n.expr,","+                _ => return,","+            };","+        }","+    }","+","+    /// TypeScript rejects expression type arguments before `/=`, `>>=`, and","+    /// `>>>=`. Cast targets also need grouping to bind before any","+    /// assignment.","+    pub(super) fn wrap_ts_assign_target(&mut self, op: AssignOp, target: &mut AssignTarget) {","+        if self.remove_only {","+            return;","+        }","+        let AssignTarget::Simple(target) = target else {","+            return;","+        };","+","+        let needs_parens = match target {","+            SimpleAssignTarget::TsInstantiation(..) => {","+                matches!(op, op!(\"/=\") | op!(\">>=\") | op!(\">>>=\"))","+            }","+            SimpleAssignTarget::TsAs(..)","+            | SimpleAssignTarget::TsSatisfies(..)","+            | SimpleAssignTarget::TsTypeAssertion(..) => true,","+            _ => false,","+        };","+        if !needs_parens {","+            return;","+        }","+","+        let expr = target.take().into();","+        *target = SimpleAssignTarget::Paren(self.make_paren(expr));","+    }","+","+    /// Ends a conditional test's cast type before a consequent that would make","+    /// TypeScript consume `?` as a postfix nullable type operator.","+    pub(super) fn wrap_ts_conditional_test(&mut self, test: &mut Expr, consequent: &Expr) {","+        if self.remove_only {","+            return;","+        }","+","+        let Some(cast) = ts_cast_tail(test) else {","+            return;","+        };","+        if can_start_ts_type(consequent) {","+            return;","+        }","+","+        self.wrap(cast);","+    }","+","+    /// Postfix casts bind less tightly than prefix and update operators. Group","+    /// their operands so the cast cannot move outside its enclosing operator.","+    pub(super) fn wrap_ts_cast_operand(&mut self, expr: &mut Expr) {","+        if matches!(","+            expr,","+            Expr::TsAs(..) | Expr::TsSatisfies(..) | Expr::TsConstAssertion(..)","+        ) {","+            self.wrap(expr);","+        }","+    }","+}","+","+/// Prefix operands already group postfix casts. Only ungrouped rightmost binary","+/// operands can expose a trailing cast to the conditional lookahead.","+fn ts_cast_tail(mut expr: &mut Expr) -> Option<&mut Expr> {","+    while let Expr::Bin(n) = expr {","+        expr = &mut n.right;","+    }","+","+    matches!(","+        expr,","+        Expr::TsAs(..) | Expr::TsSatisfies(..) | Expr::TsConstAssertion(..)","+    )","+    .then_some(expr)","+}","+","+/// Carries the first emitted expression or assignment target without turning a","+/// borrowed target back into an owned expression.","+enum TypeStart<'a> {","+    Expr(&'a Expr),","+    Target(&'a SimpleAssignTarget),","+}","+","+/// Mirrors the token lookahead used before TypeScript's postfix `T?` syntax.","+/// Parentheses do not end this walk: TypeScript also looks inside them,","+/// accepting parameter starts such as private names. A minus sign can start a","+/// type only before a numeric or bigint literal.","+fn can_start_ts_type(expr: &Expr) -> bool {","+    let mut start = TypeStart::Expr(expr);","+    let mut in_parens = false;","+    loop {","+        start = match start {","+            TypeStart::Expr(expr) => match expr {","+                Expr::Member(n) => TypeStart::Expr(&n.obj),","+                Expr::Call(n) => match &n.callee {","+                    Callee::Expr(expr) => TypeStart::Expr(expr),","+                    Callee::Super(..) => return false,","+                    _ => return true,","+                },","+                Expr::OptChain(n) => match &*n.base {","+                    OptChainBase::Member(n) => TypeStart::Expr(&n.obj),","+                    OptChainBase::Call(n) => TypeStart::Expr(&n.callee),","+                    #[cfg(swc_ast_unknown)]","+                    _ => return true,","+                },","+                Expr::TaggedTpl(n) => TypeStart::Expr(&n.tag),","+                Expr::Bin(n) => TypeStart::Expr(&n.left),","+                Expr::Cond(n) => TypeStart::Expr(&n.test),","+                Expr::Seq(n) => match n.exprs.first() {","+                    Some(expr) => TypeStart::Expr(expr),","+                    None => return true,","+                },","+                Expr::Assign(n) => match &n.left {","+                    AssignTarget::Simple(target) => TypeStart::Target(target),","+                    _ => return true,","+                },","+                Expr::Update(n) if !n.prefix => TypeStart::Expr(&n.arg),","+                Expr::TsAs(n) => TypeStart::Expr(&n.expr),","+                Expr::TsSatisfies(n) => TypeStart::Expr(&n.expr),","+                Expr::TsNonNull(n) => TypeStart::Expr(&n.expr),","+                Expr::TsConstAssertion(n) => TypeStart::Expr(&n.expr),","+                Expr::TsInstantiation(n) => TypeStart::Expr(&n.expr),","+                Expr::Paren(n) => {","+                    in_parens = true;","+                    TypeStart::Expr(&n.expr)","+                }","+                Expr::PrivateName(..) => return in_parens,","+                Expr::Lit(Lit::Regex(..))","+                | Expr::Class(..)","+                | Expr::SuperProp(..)","+                | Expr::Update(..) => return false,","+                Expr::Unary(n) => {","+                    return match n.op {","+                        op!(\"!\") | op!(\"typeof\") | op!(\"void\") => true,","+                        op!(unary, \"-\") => {","+                            matches!(&*n.arg, Expr::Lit(Lit::Num(..) | Lit::BigInt(..)))","+                        }","+                        _ => false,","+                    };","+                }","+                _ => return true,","+            },","+            TypeStart::Target(target) => match target {","+                SimpleAssignTarget::Member(n) => TypeStart::Expr(&n.obj),","+                SimpleAssignTarget::SuperProp(..) => return false,","+                SimpleAssignTarget::Paren(n) => {","+                    in_parens = true;","+                    TypeStart::Expr(&n.expr)","+                }","+                SimpleAssignTarget::OptChain(n) => match &*n.base {","+                    OptChainBase::Member(n) => TypeStart::Expr(&n.obj),","+                    OptChainBase::Call(n) => TypeStart::Expr(&n.callee),","+                    #[cfg(swc_ast_unknown)]","+                    _ => return true,","+                },","+                SimpleAssignTarget::TsAs(n) => TypeStart::Expr(&n.expr),","+                SimpleAssignTarget::TsSatisfies(n) => TypeStart::Expr(&n.expr),","+                SimpleAssignTarget::TsNonNull(n) => TypeStart::Expr(&n.expr),","+                SimpleAssignTarget::TsInstantiation(n) => TypeStart::Expr(&n.expr),","+                _ => return true,","+            },","+        };","+    }","+}"],"additions":201,"deletions":0,"truncated":false},{"path":"crates/swc_ecma_transforms_base/tests/fixer.rs","lines":["@@ -0,0 +1,117 @@","+use std::path::PathBuf;","+","+use swc_common::{sync::Lrc, util::take::Take, EqIgnoreSpan, FileName, SourceMap};","+use swc_ecma_ast::{EsVersion, Expr, Module, SimpleAssignTarget};","+use swc_ecma_codegen::{text_writer::JsWriter, Emitter};","+use swc_ecma_parser::{parse_file_as_module, Syntax, TsSyntax};","+use swc_ecma_transforms_base::fixer::fixer;","+use swc_ecma_visit::{noop_visit_mut_type, VisitMut, VisitMutWith};","+use testing::fixture;","+","+/// Compare expression structure independently of the parentheses that the","+/// parser records and the fixer inserts.","+struct IgnoreParens;","+","+impl VisitMut for IgnoreParens {","+    noop_visit_mut_type!();","+","+    fn visit_mut_expr(&mut self, expr: &mut Expr) {","+        while let Expr::Paren(paren) = expr {","+            *expr = *paren.expr.take();","+        }","+        expr.visit_mut_children_with(self);","+    }","+","+    fn visit_mut_simple_assign_target(&mut self, target: &mut SimpleAssignTarget) {","+        while let SimpleAssignTarget::Paren(paren) = target {","+            *target = SimpleAssignTarget::try_from(paren.expr.take())","+                .expect(\"parenthesized assignment target should remain assignable\");","+        }","+        target.visit_mut_children_with(self);","+    }","+}","+","+fn parse(cm: &SourceMap, source: String, syntax: Syntax) -> Module {","+    let file = cm.new_source_file(FileName::Anon.into(), source);","+    let mut errors = Vec::new();","+    let module = parse_file_as_module(&file, syntax, EsVersion::latest(), None, &mut errors)","+        .expect(\"fixer fixture should parse as a TypeScript module\");","+    assert!(","+        errors.is_empty(),","+        \"fixer fixture has syntax errors: {errors:?}\"","+    );","+    module","+}","+","+fn print(cm: Lrc<SourceMap>, module: &Module) -> String {","+    let mut output = Vec::new();","+    let mut emitter = Emitter {","+        cfg: Default::default(),","+        cm: cm.clone(),","+        comments: None,","+        wr: JsWriter::new(cm, \"\\n\", &mut output, None),","+    };","+    emitter.emit_module(module).unwrap();","+    String::from_utf8(output).unwrap()","+}","+","+// SWC rejects some unparenthesized instantiation assignment targets that","+// TypeScript accepts. Check their structure separately and their emitted text","+// with the shared resolver snapshots until the parser supports these forms.","+#[fixture(","+    \"tests/ts-resolver/fixer/**/input.ts\",","+    exclude(\"instantiation-assignments\")","+)]","+#[fixture(","+    \"tests/ts-resolver/fixer/**/input.tsx\",","+    exclude(\"instantiation-assignments\")","+)]","+fn ts_fixer_round_trip(input: PathBuf) {","+    testing::run_test2(false, |cm, _| {","+        let source = std::fs::read_to_string(&input).unwrap();","+        let syntax = Syntax::Typescript(TsSyntax {","+            tsx: input.extension().is_some_and(|ext| ext == \"tsx\"),","+            ..Default::default()","+        });","+        let mut expected = parse(&cm, source, syntax);","+        let mut fixed = expected.clone();","+        fixed.visit_mut_with(&mut fixer(None));","+        let output = print(cm.clone(), &fixed);","+        let mut actual = parse(&cm, output.clone(), syntax);","+","+        expected.visit_mut_with(&mut IgnoreParens);","+        actual.visit_mut_with(&mut IgnoreParens);","+        assert!(","+            expected.eq_ignore_span(&actual),","+            \"fixer changed the expression structure in {}:\\n{output}\",","+            input.display(),","+        );","+        Ok(())","+    })","+    .unwrap();","+}","+","+#[fixture(\"tests/ts-resolver/fixer/instantiation-assignments/input.ts\")]","+#[fixture(\"tests/ts-resolver/fixer/instantiation-assignments/input.tsx\")]","+fn ts_fixer_assignment_structure(input: PathBuf) {","+    testing::run_test2(false, |cm, _| {","+        let source = std::fs::read_to_string(&input).unwrap();","+        let syntax = Syntax::Typescript(TsSyntax {","+            tsx: input.extension().is_some_and(|ext| ext == \"tsx\"),","+            ..Default::default()","+        });","+        let mut expected = parse(&cm, source, syntax);","+        let mut actual = expected.clone();","+        actual.visit_mut_with(&mut fixer(None));","+","+        expected.visit_mut_with(&mut IgnoreParens);","+        actual.visit_mut_with(&mut IgnoreParens);","+        assert!(","+            expected.eq_ignore_span(&actual),","+            \"fixer changed the assignment structure in {}\",","+            input.display(),","+        );","+        Ok(())","+    })","+    .unwrap();","+}"],"additions":117,"deletions":0,"truncated":false},{"path":"crates/swc_ecma_transforms_base/tests/ts-resolver/fixer/binary-cast-operands/input.ts","lines":["@@ -0,0 +1,65 @@","+export {};","+left ** (value as T);","+left * (value as T);","+left 