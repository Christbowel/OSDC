/Operators/Operator_Precedence#precedence_and_associativity","@@ -385,6 +404,8 @@ impl VisitMut for Fixer<'_> {","                 _ => (),","             }","         }","+","+        self.wrap_ts_instantiation_tail(expr.op, &mut expr.left);","     }"," ","     fn visit_mut_block_stmt(&mut self, n: &mut BlockStmt) {","@@ -491,6 +512,8 @@ impl VisitMut for Fixer<'_> {","         expr.cons.visit_mut_with(self);","         expr.alt.visit_mut_with(self);","         self.ctx = ctx;","+","+        self.wrap_ts_conditional_test(&mut expr.test, &expr.cons);","     }"," ","     fn visit_mut_export_default_expr(&mut self, node: &mut ExportDefaultExpr) {","@@ -847,6 +870,11 @@ impl VisitMut for Fixer<'_> {","         }","     }"," ","+    fn visit_mut_ts_type_assertion(&mut self, expr: &mut TsTypeAssertion) {","+        expr.visit_mut_children_with(self);","+        self.wrap_ts_cast_operand(&mut expr.expr);","+    }","+","     fn visit_mut_unary_expr(&mut self, n: &mut UnaryExpr) {","         let old = self.ctx;","         self.ctx = Context::FreeExpr;","@@ -872,12 +900,20 @@ impl VisitMut for Fixer<'_> {","             | Expr::Seq(..)","             | Expr::Cond(..)","             | Expr::Arrow(..)","-            | Expr::Yield(..) => self.wrap(&mut n.arg),","+            | Expr::Yield(..)","+            | Expr::TsAs(..)","+            | Expr::TsSatisfies(..)","+            | Expr::TsConstAssertion(..) => self.wrap(&mut n.arg),"," ","             _ => {}","         }","     }"," ","+    fn visit_mut_update_expr(&mut self, expr: &mut UpdateExpr) {","+        expr.visit_mut_children_with(self);","+        self.wrap_ts_cast_operand(&mut expr.arg);","+    }","+","     fn visit_mut_var_declarator(&mut self, node: &mut VarDeclarator) {","         node.name.visit_mut_children_with(self);"," ","@@ -1150,7 +1186,13 @@ impl Fixer<'_> {","             return;","         }"," ","-        let mut span = e.span();","+        let expr = Box::new(e.take());","+        *e = self.make_paren(e