oad the pre-command config\");","+","+    assert_eq!(config.package_manager_bootstrap.registry, \"https://mirror.example.com/npm/\");","+    assert_eq!(","+        config.package_manager_bootstrap.registries.get(\"default\").map(String::as_str),","+        Some(\"https://mirror.example.com/npm/\"),","+    );","+    assert_eq!(","+        config.package_manager_bootstrap.proxy.https_proxy.as_deref(),","+        Some(\"http://proxy.example.com:8080\"),","+    );","+}","+"," /// `pnpm --version` still reconciles the `packageManager` pin, so its argv"," /// scan has to see `--ignore-workspace` too — otherwise the pass reports"," /// the key issues of a `pnpm-workspace.yaml` the user asked it to ignore.","@@ -1015,6 +1049,7 @@ fn pre_command_input(dir: &Path) -> PreCommandInput {","             pin_flags: PinFlags::default(),","             color: None,","             ignore_workspace: false,","+            network: CliNetworkArgs::default(),","         },","         global: false,","         skip_pm_handling: false,",""],"additions":37,"deletions":2,"truncated":false}],"additions":79,"deletions":9,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-14T13:04:55.509173+00:00"}