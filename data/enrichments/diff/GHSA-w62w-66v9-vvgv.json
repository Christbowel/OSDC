,"+\t\t\t\twriteError(w, http.StatusBadRequest, \"BadRequest\", \"invalid namespace\")","+\t\t\t\treturn","+\t\t\t}","+\t\t\t// Reject leading/trailing/consecutive unit separators so distinct","+\t\t\t// inputs cannot collapse to the same parsed namespace via","+\t\t\t// parseNamespace's empty-part filter.","+\t\t\tfor _, part := range strings.Split(ns, \"\\x1F\") {","+\t\t\t\tif part == \"\" || !isValidNameSegment(part) {","+\t\t\t\t\twriteError(w, http.StatusBadRequest, \"BadRequest\", \"invalid namespace\")","+\t\t\t\t\treturn","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t\tnext.ServeHTTP(w, r)","+\t})","+}","+","+// isValidNameSegment rejects a single path-segment value (bucket prefix slot,","+// table name, or one namespace part) that would be unsafe to embed in a filer","+// path: `.`, `..`, embedded slash/backslash, or NUL.","+func isValidNameSegment(s string) bool {","+\tif s == \"\" {","+\t\treturn true","+\t}","+\tif s == \".\" || s == \"..\" {","+\t\treturn false","+\t}","+\treturn !strings.ContainsAny(s, \"/\\\\\\x00\")","+}"],"additions":70,"deletions":0,"truncated":false},{"path":"weed/s3api/iceberg/path_validation_test.go","lines":["@@ -0,0 +1,116 @@","+package iceberg","+","+import (","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"testing\"","+","+\t\"github.com/gorilla/mux\"","+)","+","+func TestValidateRequestPath_RejectsTraversal(t *testing.T) {","+\ttests := []struct {","+\t\tname     string","+\t\trawPath  string","+\t\twantCode int","+\t}{","+\t\t{\"clean namespace+table passes\", \"/v1/namespaces/sales/tables/orders\", http.StatusOK},","+\t\t{\"clean prefixed passes\", \"/v1/wh/namespaces/sales/tables/orders\", http.StatusOK},","+\t\t{\"clean namespace only passes\", \"/v1/namespaces/sales\", http.StatusOK},","+","+\t\t// SkipClean(true) means raw `..` survives routing — these are the","+\t\t// realistic traversal shapes the middleware must catch.","+\t\t{\"dotdot as prefix var rejected\", \"/v1/../namespaces/sales\", http.StatusBadRequest},","+\t