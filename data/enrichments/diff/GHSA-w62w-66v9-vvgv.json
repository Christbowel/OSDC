izes against bucket-A.","+func validateRequestPath(next http.Handler) http.Handler {","+\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\tvars := mux.Vars(r)","+\t\t// When a var is in the matched route it must be non-empty: an empty","+\t\t// bucket would let downstream path.Join collapse it and let the object","+\t\t// key pick the bucket.","+\t\tif bucket, ok := vars[\"bucket\"]; ok {","+\t\t\tif bucket == \"\" || !s3_constants.IsValidBucketName(bucket) {","+\t\t\t\ts3err.WriteErrorResponse(w, r, s3err.ErrInvalidRequest)","+\t\t\t\treturn","+\t\t\t}","+\t\t}","+\t\tif object, ok := vars[\"object\"]; ok {","+\t\t\tif object == \"\" || !s3_constants.IsValidObjectKey(object) {","+\t\t\t\ts3err.WriteErrorResponse(w, r, s3err.ErrInvalidRequest)","+\t\t\t\treturn","+\t\t\t}","+\t\t}","+\t\tnext.ServeHTTP(w, r)","+\t})","+}"],"additions":38,"deletions":0,"truncated":false},{"path":"weed/s3api/s3api_path_validation_test.go","lines":["@@ -0,0 +1,87 @@","+package s3api","+","+import (","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"testing\"","+","+\t\"github.com/gorilla/mux\"","+)","+","+func TestValidateRequestPath_RejectsTraversal(t *testing.T) {","+\ttests := []struct {","+\t\tname string","+\t\t// rawPath is sent as the Request-URI; net/http.NewRequest does not","+\t\t// rewrite the path, so `..` segments survive into mux when the router","+\t\t// is built with SkipClean(true) — matching the production setup in","+\t\t// weed/command/s3.go.","+\t\trawPath  string","+\t\twantCode int","+\t}{","+\t\t{\"clean path passes\", \"/bucket-a/folder/file.txt\", http.StatusOK},","+\t\t{\"bucket only passes\", \"/bucket-a\", http.StatusOK},","+\t\t{\"trailing slash passes\", \"/bucket-a/folder/\", http.StatusOK},","+","+\t\t{\"leading dotdot rejected\", \"/bucket-a/../evil-bucket/test.txt\", http.StatusBadRequest},","+\t\t{\"nested dotdot rejected\", \"/bucket-a/good/../evil/test.txt\", http.StatusBadRequest},","+\t\t{\"backslash dotdot rejected\