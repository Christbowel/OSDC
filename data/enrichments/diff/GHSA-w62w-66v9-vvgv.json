uest && handlerCalled {","+\t\t\t\tt.Fatalf(\"path %q: inner handler reached despite rejection\", tt.rawPath)","+\t\t\t}","+\t\t})","+\t}","+}","+","+// Defense-in-depth: if a future route or middleware ever leaves one of the","+// captured vars empty, the middleware must still reject the request. The","+// default mux regex won't normally allow this.","+func TestValidateRequestPath_RejectsEmptyCapturedVars(t *testing.T) {","+\ttests := []struct {","+\t\tname string","+\t\tvars map[string]string","+\t}{","+\t\t{\"empty prefix\", map[string]string{\"prefix\": \"\", \"namespace\": \"ns\"}},","+\t\t{\"empty table\", map[string]string{\"namespace\": \"ns\", \"table\": \"\"}},","+\t\t{\"empty namespace\", map[string]string{\"namespace\": \"\"}},","+\t}","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\thandlerCalled := false","+\t\t\th := validateRequestPath(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {","+\t\t\t\thandlerCalled = true","+\t\t\t}))","+\t\t\treq := mux.SetURLVars(httptest.NewRequest(http.MethodGet, \"/\", nil), tt.vars)","+\t\t\trr := httptest.NewRecorder()","+\t\t\th.ServeHTTP(rr, req)","+\t\t\tif handlerCalled {","+\t\t\t\tt.Fatalf(\"vars %v: inner handler reached despite empty capture\", tt.vars)","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestIsValidNameSegment(t *testing.T) {","+\ttests := []struct {","+\t\tname  string","+\t\tinput string","+\t\twant  bool","+\t}{","+\t\t{\"empty ok\", \"\", true},","+\t\t{\"plain\", \"orders\", true},","+\t\t{\"with dot inside\", \"my.table\", true},","+\t\t{\"hidden\", \".hidden\", true},","+","+\t\t{\"bare dot\", \".\", false},","+\t\t{\"bare dotdot\", \"..\", false},","+\t\t{\"contains slash\", \"foo/bar\", false},","+\t\t{\"contains backslash\", \"foo\\\\bar\", false},","+\t\t{\"contains nul\", \"foo\\x00bar\", false},","+\t}","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tif got := isValidNameSegment(tt.input); got != tt.want {","+\t\t\t\tt.Errorf(\"isValidNameSegment(%q) = %v, want %v\", tt.input, got, tt.want)","+\t\t\t}","+\t\t})","+\t}","+}"],"additions":116,"deletions":0,"truncated":false},{"path":"weed/s3api/iceberg/server.go","lines":["@@ -71,6 +71,13 @@ func (s *Server) RegisterRoutes(router *mux.Router) {"," \t// Add middleware to log all requests/responses"," \trouter.Use(loggingMiddleware)"," ","+\t// Reject `..`/`.`/NUL in {prefix}/{namespace}/{table} vars before any","+\t// handler runs. The router uses SkipClean(true), so traversal segments","+\t// would otherwise reach path.Join in stage-marker / location builders.","+\t// Registered after loggingMiddleware so rejected requests still get","+\t// audit-logged.","+\trouter.Use(validateRequestPath)","+"," \t// Configuration endpoint - no auth needed for config"," \trouter.HandleFunc(\"/v1/config\", s.handleConfig).Methods(http.MethodGet)"," "],"additions":7,"deletions":0,"truncated":false},{"path":"weed/s3api/s3_constants/header.go","lines":["@@ -177,6 +177,41 @@ func GetBucketAndObject(r *http.Request) (bucket, object string) {"," \treturn"," }"," ","+// IsValidObjectKey rejects S3 object keys that — after normalization","+// (backslash→slash, slash collapse) — contain a `.` or `..` path segment, or","+// embed a NUL byte. Such keys are collapsed by filepath.Join inside the filer","+// and would escape the bucket directory, so they must not reach the gRPC layer.","+// Gorilla mux URL-decodes captured vars before this runs, so `%2e%2e` is","+// already `..` here.","+func IsValidObjectKey(object string) bool {","+\tif object == \"\" {","+\t\treturn true","+\t}","+\tif strings.ContainsRune(object, '\\x00') {","+\t\treturn false","+\t}","+\tobject = strings.ReplaceAll(object, \"\\\\\", \"/\")","+\tfor _, seg := range strings.Split(object, \"/\") {","+\t\tif seg == \".\" || seg == \"..\" {","+\t\t\treturn false","+\t\t}","+\t}","+\treturn true","+}","+","+// IsValidBucketName rejects bucket names captured from the URL path that