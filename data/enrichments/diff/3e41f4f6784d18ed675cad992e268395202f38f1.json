pr(&LogicalOr{","+\t\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"c\"))),","+\t\t\t\t\tRhs: NewBody(NewExpr(VarTerm(\"d\"))),","+\t\t\t\t})),","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tnote:  \"group forces right nesting of same operator\",","+\t\t\tinput: \"a or (b or c)\",","+\t\t\texp: &Expr{Terms: &LogicalOr{","+\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"a\"))),","+\t\t\t\tRhs: NewBody(NewExpr(&LogicalOr{","+\t\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"b\"))),","+\t\t\t\t\tRhs: NewBody(NewExpr(VarTerm(\"c\"))),","+\t\t\t\t})),","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tnote:  \"not inside group\",","+\t\t\tinput: \"(not a)\",","+\t\t\texp:   NewExpr(&Not{Body: NewBody(NewExpr(VarTerm(\"a\")))}),","+\t\t},","+\t\t{","+\t\t\tnote:  \"not with grouped operand\",","+\t\t\tinput: \"not (a)\",","+\t\t\texp:   NewExpr(&Not{Body: NewBody(NewExpr(VarTerm(\"a\")))}),","+\t\t},","+\t\t{","+\t\t\tnote:  \"not inside group binds under or\",","+\t\t\tinput: \"(not a or b)\",","+\t\t\texp: &Expr{Terms: &LogicalOr{","+\t\t\t\tLhs: NewBody(NewExpr(&Not{Body: NewBody(NewExpr(VarTerm(\"a\")))})),","+\t\t\t\tRhs: NewBody(NewExpr(VarTerm(\"b\"))),","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tnote:  \"not with grouped operand inside or\",","+\t\t\tinput: \"not (a) or b\",","+\t\t\texp: &Expr{Terms: &LogicalOr{","+\t\t\t\tLhs: NewBody(NewExpr(&Not{Body: NewBody(NewExpr(VarTerm(\"a\")))})),","+\t\t\t\tRhs: NewBody(NewExpr(VarTerm(\"b\"))),","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tnote:  \"not inside group binds under or\",","+\t\t\tinput: \"(not a or b)\",","+\t\t\texp: &Expr{Terms: &LogicalOr{","+\t\t\t\tLhs: NewBody(NewExpr(&Not{Body: NewBody(NewExpr(VarTerm(\"a\")))})),","+\t\t\t\tRhs: NewBody(NewExpr(VarTerm(\"b\"))),","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tnote:  \"redundant parens around single operand drop\",","+\t\t\tinput: \"(a) and (b)\",","+\t\t\texp: &Expr{Terms: &LogicalAnd{","+\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"a\"))),","+\t\t\t\tRhs: NewBody(NewExpr(VarTerm(\"b\"))),","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tnote:  \"group forces right nesting of and\",","+\t\t\tinput: \"a and (b and c)\",","+\t\t\texp: &Expr{Terms: &LogicalAnd{","+\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"a\"))),","+\t\t\t\tRhs: NewBody(NewExpr(&LogicalAnd{","+\t\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"b\"))),","+\t\t\t\t\tRhs: NewBody(NewExpr(VarTerm(\"c\"))),","+\t\t\t\t})),","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tnote:  \"redundant parens preserve same-precedence tree\",","+\t\t\tinput: \"(a and b) or c\",","+\t\t\texp: &Expr{Terms: &LogicalOr{","+\t\t\t\tLhs: NewBody(NewExpr(&LogicalAnd{","+\t\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"a\"))),","+\t\t\t\t\tRhs: NewBody(NewExpr(VarTerm(\"b\"))),","+\t\t\t\t})),","+\t\t\t\tRhs: NewBody(NewExpr(VarTerm(\"c\"))),","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tnote:  \"comparison operands inside groups\",","+\t\t\tinput: \"(a == b) or (c == d)\",","+\t\t\texp: &Expr{Terms: &LogicalOr{","+\t\t\t\tLhs: NewBody(Equal.Expr(VarTerm(\"a\"), VarTerm(\"b\"))),","+\t\t\t\tRhs: NewBody(Equal.Expr(VarTerm(\"c\"), VarTerm(\"d\"))),","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tnote:  \"deeply mixed and/or groups\",","+\t\t\tinput: \"a or (b and (c or d))\",","+\t\t\texp: &Expr{Terms: &LogicalOr{","+\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"a\"))),","+\t\t\t\tRhs: NewBody(NewExpr(&LogicalAnd{","+\t\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"b\"))),","+\t\t\t\t\tRhs: NewBody(NewExpr(&LogicalOr{","+\t\t\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"c\"))),","+\t\t\t\t\t\tRhs: NewBody(NewExpr(VarTerm(\"d\"))),","+\t\t\t\t\t})),","+\t\t\t\t})),","+\t\t\t}},","+\t\t},","+\t\t{","+\t\t\tnote:  \"explicit body lhs with paren group rhs\",","+\t\t\tinput: \"{x; y} and (a or b)\",","+\t\t\texp: &Expr{Terms: &LogicalAnd{","+\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"x\")), NewExpr(VarTerm(\"y\"))),","+\t\t\t\tRhs: NewBody(NewExpr(&LogicalOr{","+\t\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"a\"))),","+\t\t\t\t\tRhs: NewBody(NewExpr(VarTerm(\"b\"))),","+\t\t\t\t})),","+\t\t\t\tExplicitLhs: true,","+\t\t\t}},","+\t\t},","+\t}","+","+\tfor _, tc := range tests {","+\t\tt.Run(tc.note, func(t *testing.T) {","+\t\t\tassertParseOneExpr(t, tc.note, tc.input, tc.exp, opts)","+\t\t})","+\t}","+}","+","+func TestParseLogical_ParenErrors(t *testing.T) {","+\topts := logicalParserOpts(\"not\")","+","+\ttests := []struct {","+\t\tnote     string","+\t\tinput    string","+\t\texpected string","+\t}{","+\t\t{","+\t\t\tnote:     \"empty group\",","+\t\t\tinput:    \"a or ()\",","+\t\t\texpected: \"empty parenthesized group\",","+\t\t},","+\t\t{","+\t\t\tnote:     \"empty explicit body in group\",","+\t\t\tinput:    \"a or ({})\",","+\t\t\texpected: \"found empty body\",","+\t\t},","+\t\t{","+\t\t\tnote:     \"unterminated group\",","+\t\t\tinput:    \"a and (b or c\",","+\t\t\texpected: \"expected ) to close parenthesized group\",","+\t\t},","+\t\t{","+\t\t\tnote:     \"non-logical group operand backtracks to term path\",","+\t\t\tinput:    \"a or (x = 1)\",","+\t\t\texpected: \"non-terminated expression\",","+\t\t},","+\t\t{","+\t\t\tnote:     \"empty group at statement start backtracks to term\",","+\t\t\tinput:    \"() and a\",","+\t\t\texpected: \"unexpected ) token\",","+\t\t},","+\t\t{","+\t\t\tnote:     \"group opening with an operator\",","+\t\t\tinput:    \"a and ( or b)\",","+\t\t\texpected: \"unexpected or keyword\",","+\t\t},","+\t\t{","+\t\t\tnote:     \"assignment in group backtracks to term path\",","+\t\t\tinput:    \"a and (x := 1)\",","+\t\t\texpected: \"non-terminated expression\",","+\t\t},","+\t\t{","+\t\t\tnote:     \"some in group backtracks to term path\",","+\t\t\tinput:    \"a or (some x in xs)\",","+\t\t\texpected: \"unexpected some keyword\",","+\t\t},","+\t\t{","+\t\t\tnote:     \"multi-statement needs explicit body\",","+\t\t\tinput:    \"a and (x; y)\",","+\t\t\texpected: \"non-terminated expression\",","+\t\t},","+\t\t{","+\t\t\tnote:     \"empty not group\",","+\t\t\tinput:    \"not ()\",","+\t\t\texpected: \"empty parenthesized group\",","+\t\t},