er) parseEvery() *Expr {"," \tqb := &Every{}"," \tqb.SetLoc(p.s.Loc())"],"additions":241,"deletions":25,"truncated":false},{"path":"v1/ast/parser_logical_test.go","lines":["@@ -285,12 +285,17 @@ func TestParseLogical_WithModifier(t *testing.T) {"," \t\t{"," \t\t\tnote:      \"and, with on lhs implicit operand is an error\","," \t\t\tinput:     \"a with input as v and b\",","-\t\t\texpectErr: \"`with` modifier is not allowed on operand of `and`\",","+\t\t\texpectErr: \"`with` modifier is not allowed on operand of `and` (hint: Wrap the operand in `(...)` or `{...}` to scope, or move `with` after the `and` expression to apply it to the whole expression)\","," \t\t},"," \t\t{"," \t\t\tnote:      \"or, with on lhs implicit operand is an error\","," \t\t\tinput:     \"a with input as v or b\",","-\t\t\texpectErr: \"`with` modifier is not allowed on operand of `or`\",","+\t\t\texpectErr: \"`with` modifier is not allowed on operand of `or` (hint: Wrap the operand in `(...)` or `{...}` to scope, or move `with` after the `or` expression to apply it to the whole expression)\",","+\t\t},","+\t\t{","+\t\t\tnote:      \"with mid-chain cannot be followed by another operator\",","+\t\t\tinput:     \"a and b with input as v or c\",","+\t\t\texpectErr: \"unexpected or keyword\","," \t\t},"," \t}"," \tfor _, tc := range errorTests {","@@ -869,3 +874,836 @@ func TestParseLogical_InnerExprHasLocation(t *testing.T) {"," \t\tt.Errorf(\"Expected file to be test.rego but got: %v\", inner.Location.File)"," \t}"," }","+","+func TestParseLogical_ParenGrouping(t *testing.T) {","+\topts := logicalParserOpts(\"not\")","+","+\ttests := []struct {","+\t\tnote  string","+\t\tinput string","+\t\texp   *Expr","+\t}{","+\t\t{","+\t\t\tnote:  \"rhs group\",","+\t\t\tinput: \"a and (b or c)\",","+\t\t\texp: &Expr{Terms: &LogicalAnd{","+\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"a\"))),","+\t\t\t\tRhs: NewBody(NewExpr(&LogicalOr{","+\t\t\t\t\tLhs: NewBody(NewExpr(VarTerm(\"b\"))),","+\t\t\t\t\tRhs: NewBody(Ne