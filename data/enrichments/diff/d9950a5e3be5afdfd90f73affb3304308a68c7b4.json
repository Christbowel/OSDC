URL-encoded","+     * decoder also percent-decodes the names, and the values that end its input, in place: it is","+     * given a private copy of the input, which is small, as the form is buffered.","      *","      * @param input The input, owned by the view","      * @return The view","      */","-    private static ByteBuf decoderInput(ByteBuf input) {","+    private ByteBuf decoderInput(ByteBuf input) {","+        if (decoder instanceof VintageAccess.UrlEncodedDecoder) {","+            try {","+                return input.alloc().buffer(input.readableBytes()).writeBytes(input);","+            } finally {","+                input.release();","+            }","+        }","         return input.alloc().compositeBuffer().addComponent(true, input);","     }"," ","@@ -312,11 +346,13 @@ public void complete() {","         assert eventLoop == null || eventLoop.inEventLoop();","         try {","             decoder.endInput();","+            // the end of the input completes the last field, which the decoder validates then,","+            // e.g. a percent escape it was waiting on the rest of","+            forwardOutput();","         } catch (Exception e) {","             handleDecoderException(e);","             return;","         }","-        forwardOutput();","         if (closeDelimiter != null && !closeDelimiter.found()) {","             // the decoder ends the last part with the end of the input: a truncated body, or one","             // with another closing boundary, would be read as a shorter form","@@ -358,6 +394,53 @@ private void eof() {","         }","     }"," ","+    /**","+     * How the content of the fields is read.","+     */","+    public enum Content {","+        /**","+         * Decoded, e.g. percent-decoded for URL-encoded data.","+         */","+        DECODED,","+        /**","+         * As it appears in the body, for a decoder that validates nothing when it decodes the","+         * content, e.g. without the quirks that refuse malformed p