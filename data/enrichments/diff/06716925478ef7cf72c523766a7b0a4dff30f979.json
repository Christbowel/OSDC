caseInsensitive);","+        if (pathMatcher != null) {","+            chainResolver.setPathMatcher(pathMatcher);","+        }","         chainResolver.setFilterChainManager(manager);"," ","         //Now create a concrete ShiroFilter instance and apply the acquired SecurityManager and built","@@ -566,6 +583,11 @@ private void applyUnauthorizedUrlIfNecessary(Filter filter) {","     }"," ","     void applyGlobalPropertiesIfNecessary(Filter filter) {","+        if (filter instanceof PathMatchingFilter pathMatchingFilter) {","+            if (pathMatcher != null) {","+                pathMatchingFilter.setPathMatcher(pathMatcher);","+            }","+        }","         applyLoginUrlIfNecessary(filter);","         applySuccessUrlIfNecessary(filter);","         applyUnauthorizedUrlIfNecessary(filter);"],"additions":22,"deletions":0,"truncated":false},{"path":"support/spring/src/main/java/org/apache/shiro/spring/web/SpringPathPatternMatcher.java","lines":["@@ -0,0 +1,84 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *     http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing,","+ * software distributed under the License is distributed on an","+ * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+ * KIND, either express or implied.  See the License for the","+ * specific language governing permissions and limitations","+ * under the License.","+ */","+package org.apache.shiro.spring.web;","+","+import org.apache.shiro.util.PatternMatcher;","+import org.springframework.http.server.PathContainer;","+import org.springframework.http.server.PathContainer.Options;","+import org.springframework.web.util.pattern.PathPattern;","+import org.springframework.web.util.pattern.PathPatternParser;","+","+import java.util.concurrent.ConcurrentHashMap;","+import java.util.concurrent.ConcurrentMap;","+","+/**","+ * Matches Shiro's decoded application paths using Spring's parsed path patterns.","+ * Matching is case-insensitive by default, consistent with Shiro's Ant matcher.","+ */","+public class SpringPathPatternMatcher implements PatternMatcher {","+    private final PathPatternParser parser;","+    private final ConcurrentMap<String, PathPattern> patterns = new ConcurrentHashMap<>();","+","+    public SpringPathPatternMatcher() {","+        this(new PathPatternParser());","+    }","+","+    public SpringPathPatternMatcher(PathPatternParser mvcParser) {","+        parser = new PathPatternParser();","+        parser.setCaseSensitive(false);","+        parser.setPathOptions(mvcParser.getPathOptions());","+    }","+","+    /**","+     * Parses and caches a configured pattern, rejecting invalid patterns at startup.","+     * @param pattern the configured pattern","+     * @return the parsed pattern","+     */","+    public PathPattern validatePattern(String pattern) {","+        return patterns.computeIfAbsent(pattern, parser::parse);","+    }","+","+    @Override","+    public boolean matches(String pattern, String source) {","+        // Servlet paths have already been decoded; do not decode percent sequences a second time.","+        return validatePattern(pattern).matches(PathContainer.parsePath(source,","+                Options.create('/', false)));","+    }","+","+    @Override","+    public boolean isCaseInsensitive() {","+        return !parser.isCaseSensitive();","+    }","+","+    /**","+     * Configures case sensitivity before any patterns have been parsed.","+     * Reapplying the current setting is allowed.","+     * @param caseInsensitive whether matching should ignore case","+     * @throws IllegalStateException if changing the setting after a pattern has been parsed","+     */","+    @Override","+    public void setCaseInsensitive(boolean caseInsensitive) {","+        if (isCaseInsensitive() != caseInsensitive) {","+            if (!patterns.isEmpty()) {","+                throw new IllegalStateException(\"Cannot change case sensitivity after path patterns have been parsed.\");","+            }","+            parser.setCaseSensitive(!caseInsensitive);","+        }","+    }","+}"],"additions":84,"deletions":0,"truncated":false},{"path":"support/spring/src/test/java/org/apache/shiro/spring/web/SpringPathPatternMatcherTest.java","lines":["@@ -0,0 +1,88 @@","+/*","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *     http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing,","+ * software distributed under the License is distributed on an","+ * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+ * KIND, either express or implied.  See the License for the","+ * specific language governing permissions and limitations","+ * under the License.","+ */","+package org.apache.shiro.spring.web;","+","+import org.junit.jupiter.api.Test;","+import org.springframework.web.util.pattern.PathPatternParser;","+","+import static org.assertj.core.api.Assertions.assertThat;","+import static org.assertj.core.api.Assertions.assertThatIllegalStateException;","+","+class SpringPathPatternMatcherTest {","+","+    @Test","+    void matchesSpringPatterns() {","+        SpringPathPatternMatcher matcher = new SpringPathPatternMatcher();","+        PathPatternParser parser = new PathPatternParser();","+        parser.setCaseSensitive(false);","+        for (String pattern : new String[]{\"/users/{id}\", \"/users/{id:[0-9]+}\", \"/users/*\", \"/users/**\", \"/users/{*rest}\"}) {","+            for (String path : new String[]{\"/users\", \"/users/42\", \"/users/42/\", \"/users/42/profile\", \"/Users/42\"}) {","+                assertThat(matcher.matches(pattern, path))","+                        .as(\"%s against %s\", pattern, path)","+                        .isEqualTo(parser.parse(pattern).matches(","+                                org.springframework.http.server.PathContainer.parsePath(path)));","+            }","+        }","+    }","+","+    @Test","+    void defaultsToCaseInsensitiveRegardlessOfMvcSetting() {","+        assertThat(new SpringPathPatternMatcher().isCaseInsensitive()).isTrue();","+        PathPatternParser parser = new PathPatternParser();","+        assertThat(parser.isCaseSensitive()).isTrue();","+        SpringPathPatternMatcher matcher = new SpringPathPatternMatcher(parser);","+        assertThat(matcher.matches(\"/files/private/**\", \"/files/PRIVATE/report.pdf\")).isTrue();","+        assertThat(parser.isCaseSensitive()).isTrue();","+    }","+","+    @Test","+    void doesNotDecodeServletPathsTwice() {","+        SpringPathPatternMatcher matcher = new SpringPathPatternMatcher();","+        assertThat(matcher.matches(\"/users/admin\", \"/users/%61dmin\")).isFalse();","+        assertThat(matcher.matches(\"/users/{id}\", \"/users/Jane Doe\")).isTrue();","+    }","+","+    @Test","+    void configuresCaseSensitivityBeforeParsing() {","+        SpringPathPatternMatcher matcher = new SpringPathPatternMatcher();","+        matcher.setCaseInsensitive(false);","+        assertThat(matcher.matches(\"/users/{id}\", \"/Users/42\")).isFalse();","+        matcher.setCaseInsensitive(false);","+        assertThat(matcher.matches(\"/users/{id}\", \"/Users/42\")).isFalse();","+    }","+","+    @Test","+    void rejectsChangingCaseSensitivityAfterMatching() {","+        SpringPathPatternMatcher matcher = new SpringPathPatternMatcher();","+        assertThat(matcher.matches(\"/users/{id}\", \"/Users/42\")).isTrue();","+        assertThatIllegalStateException().isThrownBy(() -> matcher.setCaseInsensitive(false));","+        matcher.setCaseInsensitive(true);","+        assertThat(matcher.matches(\"/users/{id}\", \"/Users/42\")).isTrue();","+    }","+","+    @Test","+    void rejectsChangingCaseSensitivityAfterValidation() {","+        SpringPathPatternMatcher matcher = new SpringPathPatternMatcher();","+        matcher.setCaseInsensitive(true);","+        matcher.validatePattern(\"/users/{id}\");","+        assertThatIllegalStateException().isThrownBy(() -> matcher.setCaseInsensitive(false));","+        matcher.setCaseInsensitive(true);","+        assertThat(matcher.matches(\"/users/{id}\", \"/Users/42\")).isTrue();","+    }","+}"],"additions":88,"deletions":0,"truncated":false}],"additions":440,"deletions":3,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-10-28T14:43:02.413994+00:00"}