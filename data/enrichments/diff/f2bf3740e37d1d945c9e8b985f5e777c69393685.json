tizedConfig.Peek()","+\t\t\t\tvar retry <-chan time.Time","+","+\t\t\t\tif config != nil {","+\t\t\t\t\tconcurrentChange := errors.New(\"concurrent configuration change\")","+\t\t\t\t\tctx, cancel := context.WithCancelCause(ctx)","+\t\t\t\t\tgo func() {","+\t\t\t\t\t\tselect {","+\t\t\t\t\t\tcase <-ctx.Done():","+\t\t\t\t\t\tcase <-configChanged:","+\t\t\t\t\t\t\tcancel(concurrentChange)","+\t\t\t\t\t\t}","+\t\t\t\t\t}()","+","+\t\t\t\t\tupdated, err := a.configClient.Update(ctx, config, metav1.UpdateOptions{})","+\t\t\t\t\tcancel(nil)","+\t\t\t\t\tif err != nil {","+\t\t\t\t\t\tcause := context.Cause(ctx)","+\t\t\t\t\t\tif !errors.Is(cause, concurrentChange) && !errors.Is(cause, leaderelection.ErrLostLead) {","+\t\t\t\t\t\t\tlog.WithError(err).Errorf(\"Failed to update sanitized cluster configuration, resource version was %q\", config.ResourceVersion)","+\t\t\t\t\t\t\tif !apierrors.IsConflict(err) {","+\t\t\t\t\t\t\t\tretry = time.After(wait.Jitter(50*time.Second, 0.4))","+\t\t\t\t\t\t\t}","+\t\t\t\t\t\t}","+\t\t\t\t\t} else {","+\t\t\t\t\t\tlog.Infof(\"Updated sanitized cluster configuration, new resource version is %q\", updated.ResourceVersion)","+\t\t\t\t\t}","+\t\t\t\t}","+"," \t\t\t\tselect {","-\t\t\t\tcase a.resultChan <- clusterConfig:","+\t\t\t\tcase <-configChanged:","+\t\t\t\tcase <-retry:"," \t\t\t\tcase <-ctx.Done():","-\t\t\t\t\treturn true, nil","+\t\t\t\t\treturn"," \t\t\t\t}"," \t\t\t}","-\t\t\treturn false, nil"," \t\t})","-\t}()","+\t})"," "," \treturn nil"," }","@@ -102,3 +171,56 @@ func (a *apiConfigSource) Stop() error {"," \ta.stop()"," \treturn nil"," }","+","+// Returns a sanitized set of feature gates, with all unknown components","+// stripped. Returns nil if the feature gates are already sane.","+//","+// TODO: Remove in k0s 1.38+: Sanitize feature gates.","+func sanitizedFeatureGates(fgs v1beta1.FeatureGates) v1beta1.FeatureGates {","+\tfgLen := len(fgs)","+\tif fgLen < 1 {","+\t\treturn nil","+\t}","+","+\tvar sanitized bool","+\tsanitizedGates := make(v1beta1.FeatureGates, 0, fgLen)","+\tfor _, fg := range fgs {","+\t\tif compLen := len(fg.Components); compLen > 0 {","+\t\t\tcomponents := make([]v1beta1.FeatureComponent, 0, compLen)","+\t\t\tfor _, c := range fg.Components {","+\t\t\t\tswitch c {","+\t\t\t\tcase v1beta1.FeatureComponentKubeAPIServer:","+\t\t\t\tcase v1beta1.FeatureComponentKubeControllerManager:","+\t\t\t\tcase v1beta1.FeatureComponentKubeProxy:","+\t\t\t\tcase v1beta1.FeatureComponentKubeScheduler:","+\t\t\t\tcase v1beta1.FeatureComponentKubelet:","+\t\t\t\tdefault:","+\t\t\t\t\tsanitized = true","+\t\t\t\t\tcontinue","+\t\t\t\t}","+\t\t\t\tcomponents = append(components, c)","+\t\t\t}","+","+\t\t\t// Before k0s 1.37, it wasn't possible to have an empty component","+\t\t\t// list because it would default to the set of well-known","+\t\t\t// components. After sanitation, if there are no components left,","+\t\t\t// the feature gate doesn't apply to any of the known components.","+\t\t\t// However, starting with k0s 1.37, the absence of components on a","+\t\t\t// feature gate means that it applies to all components, which is","+\t\t\t// the opposite. Therefore, omit the feature gate completely.","+\t\t\tif len(components) < 1 {","+\t\t\t\tcontinue","+\t\t\t}","+","+\t\t\tfg.Components = components","+\t\t}","+","+\t\tsanitizedGates = append(sanitizedGates, fg)","+\t}","+","+\tif !sanitized {","+\t\treturn nil","+\t}","+","+\treturn sanitizedGates","+}"],"additions":134,"deletions":12,"truncated":false},{"path":"pkg/component/controller/clusterconfig/apiconfigsource_test.go","lines":["@@ -0,0 +1,261 @@","+// SPDX-FileCopyrightText: 2026 k0s authors","+// SPDX-License-Identifier: Apache-2.0","+","+package clusterconfig","+","+import (","+\t\"sync/atomic\"","+\t\"testing\"","+\t\"testing/synctest\"","+\t\"time\"","+","+\t\"github.com/k0sproject/k0s/pkg/apis/k0s/v1beta1\"","+\tk0sfake \"github.com/k0sproject/k0s/pkg/client/clientset/fake\"","+\tk0sclient \"github.com/k0sproject/k0s/pkg/client/clientset/typed/k0s/v1beta1\"","+\t\"github.com/k0sproject/k0s/pkg/constant\"","+\t\"github.com/k0sproject/k0s/pkg/leaderelection\"","+","+\tapierrors \"k8s.io/apimachinery/pkg/api/errors\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/runtime\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+\tk8stesting \"k8s.io/client-go/testing\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestAPIConfigSource(t *testing.T) {","+\t// TODO: Remove in k0s 1.38+: Sanitize feature gates.","+\tinsaneClusterConfig := func() *v1beta1.ClusterConfig {","+\t\treturn &v1beta1.ClusterConfig{","+\t\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\t\tName:            constant.ClusterConfigObjectName,","+\t\t\t\tNamespace:       constant.ClusterConfigNamespace,","+\t\t\t\tResourceVersion: \"1\",","+\t\t\t},","+\t\t\tSpec: &v1beta1.ClusterSpec{","+\t\t\t\tFeatureGates: v1beta1.FeatureGates{","+\t\t\t\t\t{Name: \"KeepMe\", Enabled: true},","+\t\t\t\t\t{Name: \"StripMe\", Enabled: true, Components: []v1beta1.FeatureComponent{","+\t\t\t\t\t\t\"bogus\", v1beta1.FeatureComponentKubelet,","+\t\t\t\t\t}},","+\t\t\t\t\t{Name: \"DropMe\", Components: []v1beta1.FeatureComponent{\"bogus\"}},","+\t\t\t\t},","+\t\t\t},","+\t\t}","+\t}","+","+\t// TODO: Remove in k0s 1.38+: Sanitize feature gates.","+\texpectedSanitizedFeatureGates := func() v1beta1.FeatureGates {","+\t\treturn v1beta1.FeatureGates{","+\t\t\t{Name: \"KeepMe\", Enabled: true},","+\t\t\t{Name: \"StripMe\", Enabled: true, Components: []v1beta1.FeatureComponent{","+\t\t\t\tv1beta1.FeatureComponentKubelet,","+\t\t\t}},","+\t\t}","+\t}","+","+\tstartAPIConfigSource := func(t *testing.T, client k0sclient.ClusterConfigInterface) *apiConfigSource {","+\t\tunderTest := &apiConfigSource{","+\t\t\tconfigClient: client,","+\t\t\tleaderStatus: func() (leaderelection.Status, <-chan struct{}) {","+\t\t\t\treturn leaderelection.StatusLeading, nil // the lead never expires","+\t\t\t},","+\t\t\tresultChan: make(chan *v1beta1.ClusterConfig),","+\t\t}","+","+\t\trequire.NoError(t, underTest.Start(t.Context()))","+\t\tt.Cleanup(func() { assert.NoError(t, underTest.Stop()) })","+","+\t\treturn underTest","+\t}","+","+\t// TODO: Remove in k0s 1.38+: Sanitize feature gates.","+\tt.Run(\"sanitizes feature gates\", func(t *testing.T) {","+\t\tsynctest.Test(t, func(t *testing.T) {","+\t\t\tstored := insaneClusterConfig()","+\t\t\texpected := expectedSanitizedFeatureGates()","+","+\t\t\tclient := k0sfake.NewSimpleClientset(stored).K0sV1beta1().ClusterConfigs(constant.ClusterConfigNamespace)","+\t\t\tunderTest := startAPIConfigSource(t, client)","+","+\t\t\t// The internally published config is sanitized.","+\t\t\tpublished := <-underTest.ResultChan()","+\t\t\trequire.NotNil(t, published.Spec)","+\t\t\tassert.Equal(t, expected, published.Spec.FeatureGates)","+","+\t\t\t// Wait until the leader task has written the sanitized config back.","+\t\t\tsynctest.Wait()","+","+\t\t\twritten, err := client.Get(t.Context(), constant.ClusterConfigObjectName, metav1.GetOptions{})","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.NotNil(t, written.Spec)","+\t\t\tassert.Equal(t, expected, written.Spec.FeatureGates,","+\t\t\t\t\"Sanitized config should have been written back to the API\")","+\t\t})","+\t})","+","+\t// TODO: Remove in k0s 1.38+: Sanitize feature gates.","+\tt.Run(\"retries failed write-backs\", func(t *testing.T) {","+\t\tsynctest.Test(t, func(t *testing.T) {","+\t\t\tstored := insaneClusterConfig()","+\t\t\texpected := expectedSanitizedFeatureGates()","+","+\t\t\tclients := k0sfake.NewSimpleClientset(stored)","+\t\t\tvar updates atomic.Uint32","+\t\t\tclients.PrependReactor(\"update\", \"clusterconfigs\", func(k8stesting.Action) (bool, runtime.Object, error) {","+\t\t\t\tif updates.Add(1) == 1 {","+\t\t\t\t\treturn true, nil, apierrors.NewInternalError(assert.AnError)","+\t\t\t\t}","+\t\t\t\treturn false, nil, nil","+\t\t\t})","+\t\t\tclient := clients.K0sV1beta1().ClusterConfigs(constant.ClusterConfigNamespace)","+\t\t\tunderTest := startAPIConfigSource(t, client)","+","+\t\t\tpublished := <-underTest.ResultChan()","+\t\t\trequire.NotNil(t, published.Spec)","+\t\t\tassert.Equal(t, expected, published.Spec.FeatureGates)","+","+\t\t\t// The first write-back attempt fails and leaves the API untouched.","+\t\t\tsynctest.Wait()","+\t\t\tassert.EqualValues(t, 1, updates.Load())","+\t\t\twritten, err := client.Get(t.Context(), constant.ClusterConfigObjectName, metav1.GetOptions{})","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.NotNil(t, written.Spec)","+\t\t\tassert.Len(t, written.Spec.FeatureGates, 3, \"Nothing should have been written back yet\")","+","+\t\t\t// The retry fires after at most 70 seconds (50 seconds plus jitter).","+\t\t\ttime.Sleep(70 * time.Second)","+\t\t\tsynctest.Wait()","+","+\t\t\tassert.EqualValues(t, 2, updates.Load())","+\t\t\twritten, err = client.Get(t.Context(), constant.ClusterConfigObjectName, metav1.GetOptions{})","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.NotNil(t, written.Spec)","+\t\t\tassert.Equal(t, expected, written.Spec.FeatureGates,","+\t\t\t\t\"Sanitized config should have been written back on the second attempt\")","+\t\t})","+\t})","+","+\t// TODO: Remove in k0s 1.38+: Sanitize feature gates.","+\tt.Run(\"resolves conflicts via watch\", func(t *testing.T) {","+\t\tsynctest.Test(t, func(t *testing.T) {","+\t\t\tstored := insaneClusterConfig()","+\t\t\texpected := expectedSanitizedFeatureGates()","+","+\t\t\tclients := k0sfake.NewSimpleClientset(stored)","+\t\t\tvar updates atomic.Uint32","+\t\t\tclients.PrependReactor(\"update\", \"clusterconfigs\", func(k8stesting.Action) (bool, runtime.Object, error) {","+\t\t\t\tif updates.Add(1) == 1 {","+\t\t\t\t\treturn true, nil, apierrors.NewConflict(","+\t\t\t\t\t\tschema.GroupResource{Group: v1beta1.GroupName, Resource: \"clusterconfigs\"},","+\t\t\t\t\t\tconstant.ClusterConfigObjectName, assert.AnError,","+\t\t\t\t\t)","+\t\t\t\t}","+\t\t\t\treturn false, nil, nil","+\t\t\t})","+\t\t\tclient := clients.K0sV1beta1().ClusterConfigs(constant.ClusterConfigNamespace)","+\t\t\tunderTest := startAPIConfigSource(t, client)","+","+\t\t\tpublished := <-underTest.ResultChan()","+\t\t\trequire.NotNil(t, published.Spec)","+\t\t\tassert.Equal(t, expected, published.Spec.FeatureGates)","+","+\t\t\t// The write-back hits a conflict. No retry timer may be armed for","+\t\t\t// conflicts: the concurrent change will be seen by the watch.","+\t\t\tsynctest.Wait()","+\t\t\ttime.Sleep(24 * time.Hour)","+\t\t\tsynctest.Wait()","+\t\t\tassert.EqualValues(t, 1, updates.Load(), \"Conflicts shouldn't be retried on a timer\")","+","+\t\t\t// The concurrent change arrives via the watch, still insane.","+\t\t\tconcurrent := insaneClusterConfig()","+\t\t\tconcurrent.ResourceVersion = \"2\"","+\t\t\t_, err := client.Update(t.Context(), concurrent, metav1.UpdateOptions{})","+\t\t\trequire.NoError(t, err)","+","+\t\t\tpublished = <-underTest.ResultChan()","+\t\t\trequire.NotNil(t, published.Spec)","+\t\t\tassert.Equal(t, expected, published.Spec.FeatureGates)","+","+\t\t\t// Now the write-back succeeds against the new version.","+\t\t\tsynctest.Wait()","+\t\t\tassert.EqualValues(t, 3, updates.Load())","+\t\t\twritten, err := client.Get(t.Context(), constant.ClusterConfigObjectName, metav1.GetOptions{})","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.NotNil(t, written.Spec)","+\t\t\tassert.Equal(t, expected, written.Spec.FeatureGates,","+\t\t\t\t\"Sanitized config should have been written back after the conflict\")","+\t\t})","+\t})","+}","+","+func TestSanitizedFeatureGates(t *testing.T) {","+\tfor _, test := range []struct {","+\t\tname      string","+\t\tgates     v1beta1.FeatureGates","+\t\tsanitized v1beta1.FeatureGates // nil means \"already sane\"","+\t}{","+\t\t{","+\t\t\tname: \"nil\",","+\t\t},","+\t\t{","+\t\t\tname:  \"empty\",","+\t\t\tgates: v1beta1.FeatureGates{},","+\t\t},","+\t\t{","+\t\t\tname: \"sane without components\",","+\t\t\tgates: v1beta1.FeatureGates{","+\t\t\t\t{Name: \"Feature\", Enabled: true},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"sane with components\",","+\t\t\tgates: v1beta1.FeatureGates{","+\t\t\t\t{Name: \"Feature\", Components: []v1beta1.FeatureComponent{","+\t\t\t\t\tv1beta1.FeatureComponentKubeAPIServer,","+\t\t\t\t\tv1beta1.FeatureComponentKubeControllerManager,","+\t\t\t\t\tv1beta1.FeatureComponentKubeProxy,","+\t\t\t\t\tv1beta1.FeatureComponentKubeScheduler,","+\t\t\t\t\tv1beta1.FeatureComponentKubelet,","+\t\t\t\t}},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"strips unknown components\",","+\t\t\tgates: v1beta1.FeatureGates{","+\t\t\t\t{Name: \"Feature\", Enabled: true, Components: []v1beta1.FeatureComponent{","+\t\t\t\t\t\"bogus\", v1beta1.FeatureComponentKubelet, \"another-bogus\",","+\t\t\t\t}},","+\t\t\t},","+\t\t\tsanitized: v1beta1.FeatureGates{","+\t\t\t\t{Name: \"Feature\", Enabled: true, Components: []v1beta1.FeatureComponent{v1beta1.FeatureComponentKubelet}},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"omits gates whose components are all unknown\",","+\t\t\tgates: v1beta1.FeatureGates{","+\t\t\t\t{Name: \"First\", Components: []v1beta1.FeatureComponent{\"bogus\"}},","+\t\t\t\t{Name: \"Second\", Enabled: true},","+\t\t\t},","+\t\t\tsanitized: v1beta1.FeatureGates{","+\t\t\t\t{Name: \"Second\", Enabled: true},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"may omit all gates\",","+\t\t\tgates: v1beta1.FeatureGates{","+\t\t\t\t{Name: \"Feature\", Components: []v1beta1.FeatureComponent{\"bogus\"}},","+\t\t\t},","+\t\t\tsanitized: v1beta1.FeatureGates{},","+\t\t},","+\t} {","+\t\tt.Run(test.name, func(t *testing.T) {","+\t\t\toriginal := test.gates.DeepCopy()","+","+\t\t\tassert.Equal(t, test.sanitized, sanitizedFeatureGates(test.gates))","+\t\t\tassert.Equal(t, original, test.gates, \"Feature gates were modified in-place\")","+\t\t})","+\t}","+}"],"additions":261,"deletions":0,"