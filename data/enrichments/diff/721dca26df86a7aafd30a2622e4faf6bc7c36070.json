le.None,","+\t\t\tview: constObservable(undefined),","+\t\t}));","+\t\tview.layout(400, 800, 0, 0);","+\t\tconst headerShown = () => view.element.querySelector<HTMLElement>('.session-header-bar')?.style.display !== 'none';","+","+\t\tconst alone = headerShown();","+\t\tview.setProvidedTitleVisible(false);","+\t\tconst withTabs = headerShown();","+\t\tview.setProvidedTitleVisible(true);","+\t\tconst aloneAgain = headerShown();","+","+\t\tconst { menuId, contextKeyService, options } = view.titleMenu;","+\t\tassert.deepStrictEqual({ alone, withTabs, aloneAgain, menu: menuId.id, inChatEditorScope: SessionInChatEditorContext.getValue(contextKeyService), onSession: options.args?.[0] === session }, {","+\t\t\talone: true,","+\t\t\twithTabs: false,","+\t\t\taloneAgain: true,","+\t\t\tmenu: Menus.SessionBarToolbar.id,","+\t\t\tinChatEditorScope: true,","+\t\t\tonSession: true,","+\t\t});","+\t});","+","+\ttest('the tab of a chat shows its status as the sessions list does, spinning while in progress, its pull request once it is done, and its session in its tooltip and for screen readers; it changes only as these do', () => {","+\t\tconst status = observableValue('status', SessionStatus.InProgress);","+\t\tconst isRead = observableValue('isRead', true);","+\t\tconst pullRequest = observableValue<ThemeIcon | undefined>('pullRequest', undefined);","+\t\tconst mainChat = upcastPartial<IChat>({ resource: URI.parse('test-chat:/main'), title: constObservable('Main') });","+\t\tconst chat = upcastPartial<IChat>({ resource: URI.parse('test-chat:/side'), title: constObservable('Side chat'), status, isRead, isArchived: constObservable(false), completedStateIcon: pullRequest });","+\t\tconst session = upcastPartial<ISession>({ title: constObservable('The session'), mainChat: constObservable(mainChat), chats: constObservable([mainChat, chat]), isQuickChat: constObservable(false) });","+\t\tconst sessionsListModelService = upcastPartial<ISessionsListModelService>({","+\t\t\tgetStatusIcon: 