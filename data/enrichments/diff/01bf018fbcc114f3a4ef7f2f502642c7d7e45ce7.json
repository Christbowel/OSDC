gh the reporter too, so the ndjson","-/// reporter writes a record and the silent reporter drops it.","-fn report_lifecycle_failure(ctx: &RunContext<'_>, message: &str) {","-    if matches!(ctx.output, ScriptOutput::Inherit) && default_reporter_selected() {","-        pnpm_diagnostics::eprintln!(\"{message}\");","-        return;","+    let interrupted = !status.success() && interrupt_count() != interrupts_before;","+    if !status.success() && !interrupted {","+        report_lifecycle_failure(ctx, status, stage);","     }","-    (ctx.emit)(&LogEvent::Pnpm(PnpmLog {","-        level: LogLevel::Error,","-        message: message.to_string(),","-        prefix: String::new(),","-    }));","+    Ok(Some(StageExit { status, interrupted }))"," }"," "," pub(crate) fn exec_scripts_prepend_node_path("],"additions":32,"deletions":52,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/run/lifecycle_failure.rs","lines":["@@ -0,0 +1,32 @@","+use super::{RunContext, ScriptExit, ScriptOutput};","+use crate::cli_args::reporter::default_reporter_selected;","+use pnpm_reporter::{LogEvent, LogLevel, PnpmLog};","+","+/// Report the `[ELIFECYCLE]` line for a `stage` that failed with `status`.","+///","+/// A streamed run goes through the reporter, which may be redrawing its","+/// frame in place: a line written past it would shift the rows the frame","+/// moves the cursor over. An inherited run under the default reporter","+/// writes the line to stderr after the script's own output; under any","+/// other reporter it goes through the reporter too, so the ndjson","+/// reporter writes a record and the silent reporter drops it.","+pub(super) fn report_lifecycle_failure(ctx: &RunContext<'_>, status: ScriptExit, stage: &str) {","+    let message = lifecycle_failure_message(status, stage);","+    if matches!(ctx.output, ScriptOutput::Inherit) && default_reporter_selected() {","+        pnpm_diagnostics::eprintln!(\"{message}\");","+        return;","+    }","+    (ctx.emit)(&LogEven