 start_script,"," };"," "," /// Run the task's scripts one at a time, in selection order: the mode a","@@ -49,8 +49,6 @@ fn run_one_script(","     let options = run.options;","     let root = options.node.project.as_path();","     let ctx: RunContext<'_> = options.run_context(run.manifest, root, run.extra_env, run.root_str);","-    let start = Instant::now();","-    let status = run_stages(&ctx, selected, script, options.args.script_args())?;","-    let duration = start.elapsed().as_secs_f64() * 1e3;","-    Ok(apply_script_result(state, &ctx, status, duration))","+    let settled = run_settled_script(&ctx, selected, script, options.args.script_args())?;","+    Ok(apply_script_result(state, &ctx, settled))"," }"],"additions":4,"deletions":6,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/interrupt.rs","lines":["@@ -293,6 +293,54 @@ fn ctrl_c_ends_pnpm_with_the_signal_without_a_lifecycle_failure() {","     drop(root);"," }"," ","+/// A recursive run the user interrupts ends pnpm with the signal too, and","+/// reports no run failure for the scripts the interrupt ended","+/// ([pnpm/pnpm#16964](https://github.com/pnpm/pnpm/issues/16964)).","+#[test]","+fn ctrl_c_ends_a_parallel_run_with_the_signal_without_a_run_failure() {","+    assert_ctrl_c_ends_recursive_run(&[\"--filter=./project-*\", \"--parallel\"], &RECURSIVE_PROJECTS);","+}","+","+/// The same for a recursive run that selects one project, whose script","+/// runs in the terminal's foreground group.","+#[test]","+fn ctrl_c_ends_a_filtered_run_with_the_signal_without_a_run_failure() {","+    assert_ctrl_c_ends_recursive_run(&[\"--filter=project-1\"], &RECURSIVE_PROJECTS[..1]);","+}","+","+const RECURSIVE_PROJECTS: [&str; 2] = [\"project-1\", \"project-2\"];","+","+fn assert_ctrl_c_ends_recursive_run(selection: &[&str], started: &[&str]) {","+    let CommandTempCwd { pacquet, root, workspace, .. } = CommandTempCwd::init();","+    write_workspace(&workspace, &RECURSIVE_PROJECTS, LINGERING_SCRIPT);","+","+    let mut terminal = Terminal::open();","+    let mut process = terminal.spawn_foreground(","+        pacquet","+            .with_args([\"--config.verify-deps-before-run=false\", \"-r\"])","+            .with_args(selection)","+            .with_args([\"run\", \"dev\"]),","+    );","+    for project in started {","+        wait_for_file(&workspace.join(project).join(\"started.txt\"), &mut process);","+    }","+    terminal.press_ctrl_c();","+    let status = wait_for_shutdown(&mut process);","+    let output = terminal.captured_output();","+","+    assert_eq!(","+        status.signal(),","+        Some(libc::SIGINT),","+        \"an interrupted recursive run ends pnpm with SIGINT\\n{output}\",","+    );","+    assert!(","+        !output.contains(\"ERR_PNPM_RECURSIVE_RUN_FIRST_FAIL\") && !output.contains(\"ELIFECYCLE\"),","+        \"scripts the user interrupted are not a run failure\\n{output}\",","+    );","+","+    drop(root);","+}","+"," /// Without a terminal, the shell running the script may stay its parent"," /// (dash does) and then keeps a relayed `SIGINT` to itself until its"," /// child exits. pnpm signals the script's whole process group instead,","@@ -639,6 +687,56 @@ fn a_script_failing_after_a_handled_interrupt_is_still_reported() {","     drop(root);"," }"," ","+/// In a recursive run too, a script that fails on its own after an earlier","+/// stage handled the interrupt is a run failure, not an interrupted run.","+#[test]","+fn a_recursive_script_failing_after_a_handled_interrupt_is_still_reported() {","+    let CommandTempCwd { pacquet, root, workspace, .. } = CommandTempCwd::init();","+    write_workspace(&workspace, &RECURSIVE_PROJECTS[..1], LINGERING_SCRIPT);","+    let project = workspace.join(RECURSIVE_PROJECTS[0]);","+    let manifest = json!({","+        \"name\": RECURSIVE_PROJECTS[0],","+        \"version\": \"0.0.0\",","+        \"scripts\": { \"predev\": \"exec node pre.js\", \"dev\": r#\"exec node -e \"process.exit(3)\"\"# },","+    });","+    fs::write(project.join(\"package.json\"), manifest.to_string()).expect(\"write package.json\");","+    fs::write(project.join(\"pre.js\"), PRE_SCRIPT).expect(\"write the pre script\");","+","+    let mut process = spawn_without_terminal(","+        pacquet","+            .with_env(\"PNPM_CONFIG_ENABLE_PRE_POST_SCRIPTS\", \"true\")","+            .with_args([","+                \"--config.verify-deps-before-run=false\",","+                \"-r\",","+                \"--filter=project-1\",","+                \"run\",","+                \"dev\",","+            ])","+            .with_stderr(Stdio::piped()),","+    );","+    wait_for_file(&project.join(\"pre-started.txt\"), &mut process);","+    interrupt(&process);","+    let status = wait_for_shutdown(&mut process);","+    let mut output = String::new();","+    process.stderr","+        .take()","+        .expect(\"stderr is piped\")","+        .read_to_string(&mut output)","+        .expect(\"read stderr\");","+","+    assert!(","+        project.join(\"pre-shut-down.txt\").exists(),","+        \"the pre script should have handled the interrupt\\n{output}\",","+    );","+    assert!(","+        output.contains(\"ERR_PNPM_RECURSIVE_RUN_FIRST_FAIL\"),","+        \"a script that fails on its own is still a run failure\\n{output}\",","+    );","+    assert_eq!(status.code(), Some(1), \"the run failed\\n{output}\");","+","+    drop(root);","+}","+"," /// The `dev` script execs `script`: the shell is out of the picture, and"," /// the relay's target is the script itself."," fn write_project(dir: &Path, name: &str, script: &str) {",""],"additions":98,"deletions":0,"truncated":false}],"additions":246,"deletions":72,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-10-17T12:24:52.910375+00:00"}