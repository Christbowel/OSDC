lled_script();","+        self.execution.interrupted.get_or_insert(exit);","+    }","+}","+","+/// How one script settled.","+#[derive(Clone, Copy)]","+struct SettledScript {","+    status: ScriptExit,","+    /// Whether the user's interrupt ended the stage that ended the script.","+    interrupted: bool,","+    duration: f64,","+}","+","+/// Run one selected script's stages and time them.","+fn run_settled_script(","+    ctx: &RunContext<'_>,","+    selected: &str,","+    script: &str,","+    args: &[String],","+) -> miette::Result<SettledScript> {","+    let start = Instant::now();","+    let exit = run_stages(ctx, selected, script, args)?;","+    Ok(SettledScript {","+        status: exit.status,","+        interrupted: exit.interrupted,","+        duration: start.elapsed().as_secs_f64() * 1e3,","+    })"," }"," "," /// Apply one settled script's verdict to the run state. `false` when","@@ -285,9 +334,13 @@ impl ScriptRunState {"," fn apply_script_result(","     state: &mut ScriptRunState,","     ctx: &RunContext<'_>,","-    status: pnpm_executor::ScriptExit,","-    duration: f64,","+    settled: SettledScript,"," ) -> bool {","+    let SettledScript { status, interrupted, duration } = settled;","+    if interrupted {","+        state.interrupted_script(status);","+        return false;","+    }","     if ctx.process_tracker.is_some_and(ProcessTracker::is_cancelled) {","         state.cancelled_script();","         return false;"],"additions":55,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/run/recursive/execution/concurrent.rs","lines":["@@ -1,11 +1,10 @@"," use super::{","-    Instant, Mutex, ProcessTracker, ProjectExecution, ProjectScripts, RunContext, ScriptRunState,","-    TaskCompletion, apply_script_result, reenters_running_script, run_stages,","-    runnable_project_script, start_script,","+    Mutex, ProcessTracker, ProjectExecution, ProjectScripts, RunContext, ScriptRunState,","+    SettledScript, TaskCompletion, apply_script_re