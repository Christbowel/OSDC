ted: 48 + 7 + // struct + \"viewers\"","+\t\t\t\t32 + 4 + // type + \"User\"","+\t\t\t\t32 + 5 + 7, // type + \"Group\" + \"members\"","+\t\t},","+\t\t{","+\t\t\tname: \"relation with a rewrite of every node type\",","+\t\t\trelation: ast.Relation{","+\t\t\t\tName: \"view\",","+\t\t\t\tSubjectSetRewrite: &ast.SubjectSetRewrite{","+\t\t\t\t\tOperation: ast.OperatorAnd,","+\t\t\t\t\tChildren: ast.Children{","+\t\t\t\t\t\t&ast.ComputedSubjectSet{Relation: \"editors\"},","+\t\t\t\t\t\t&ast.TupleToSubjectSet{Relation: \"parents\", ComputedSubjectSetRelation: \"view\"},","+\t\t\t\t\t\t&ast.InvertResult{Child: &ast.ComputedSubjectSet{Relation: \"banned\"}},","+\t\t\t\t\t\t&ast.SubjectSetRewrite{Children: ast.Children{","+\t\t\t\t\t\t\t&ast.ComputedSubjectSet{Relation: \"owners\"},","+\t\t\t\t\t\t}},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t},","+\t\t\texpected: 48 + 4 + // struct + \"view\"","+\t\t\t\t32 + // rewrite","+\t\t\t\t16 + 16 + 7 + // header + computed + \"editors\"","+\t\t\t\t16 + 32 + 7 + 4 + // header + tuple + \"parents\" + \"view\"","+\t\t\t\t16 + 16 + 16 + 6 + // header + invert + computed + \"banned\"","+\t\t\t\t16 + 32 + 16 + 16 + 6, // header + nested rewrite + header + computed + \"owners\"","+\t\t},","+\t\t{","+\t\t\tname: \"nil children are safe and cost nothing\",","+\t\t\trelation: ast.Relation{","+\t\t\t\tSubjectSetRewrite: &ast.SubjectSetRewrite{","+\t\t\t\t\tChildren: ast.Children{","+\t\t\t\t\t\tnil,","+\t\t\t\t\t\t(*ast.SubjectSetRewrite)(nil),","+\t\t\t\t\t\t(*ast.ComputedSubjectSet)(nil),","+\t\t\t\t\t\t(*ast.TupleToSubjectSet)(nil),","+\t\t\t\t\t\t(*ast.InvertResult)(nil),","+\t\t\t\t\t\t&ast.InvertResult{},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t},","+\t\t\texpected: 48 + 32 + 6*16 + 16, // struct + rewrite + 6 headers + empty invert","+\t\t},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+\t\t\trequire.Equal(t, tc.expected, tc.relation.EstimatedSize())","+\t\t})","+\t}","+}"],"additions":89,"deletions":0,"trunca