{"id":"e5dc65c1c4a398b718341c397ee4f1413baffcb4","axis":"silent","repo":"vllm-project/vllm","sha":"e5dc65c1c4a398b718341c397ee4f1413baffcb4","parsed":{"files":[{"path":".buildkite/test_areas/kernels.yaml","lines":["@@ -560,12 +560,18 @@ steps:","       - vllm/platforms/rocm.py","       - vllm/_aiter_ops.py","       - tests/kernels/attention/test_rocm_triton_attn_dsv4.py","+      - tests/kernels/attention/test_dcp_indexer_rocm.py","       - tests/kernels/attention/test_kimi_mxfp4_indexer.py","+      - tests/kernels/attention/test_rocm_aiter_flydsl_sparse_mla.py","+      - vllm/models/kimi_k3/amd/ops/flydsl_sparse_mla.py","+      - vllm/models/kimi_k3/amd/ops/flydsl_sparse_mla_gfx950.py","+      - tests/kernels/attention/test_rocm_aiter_mla_sparse_index_remap.py","       - vllm/models/kimi_k3/amd/ops/fp4_indexer.py","       - vllm/models/kimi_k3/amd/dsa.py","       - vllm/models/kimi_k3/amd/ops/fp4_indexer_prefill.py","       - vllm/models/kimi_k3/common/dsa_cache.py","       - vllm/v1/attention/backends/mla/rocm_aiter_mla_sparse.py","+      - vllm/model_executor/kernels/attention/dsa/dcp_indexer_rocm.py","       - vllm/model_executor/layers/sparse_attn_indexer.py","       - vllm/v1/kv_cache_interface.py","       - tests/kernels/attention/test_rocm_aiter_mla_decode.py","@@ -579,7 +585,10 @@ steps:","       - pytest -v -s tests/kernels/attention/test_rocm_aiter_mla_fp8_support.py","       - pytest -v -s tests/kernels/attention/test_rocm_aiter_mla_op_registration.py","       - pytest -v -s tests/kernels/attention/test_rocm_triton_attn_dsv4.py::test_dsv41_adaptive_mla_swa_metadata_graph_replay","+      - pytest -v -s tests/kernels/attention/test_dcp_indexer_rocm.py","       - pytest -v -s tests/kernels/attention/test_kimi_mxfp4_indexer.py","+      - pytest -v -s tests/kernels/attention/test_rocm_aiter_flydsl_sparse_mla.py","+      - pytest -v -s tests/kernels/attention/test_rocm_aiter_mla_sparse_index_remap.py"," "," - label: \":nvidia: (L4) Quantization Kernels\"","   key: kernels-quantization-test"],"additions":9,"deletions":0,"truncated":false},{"path":"tests/kernels/attention/test_dcp_indexer_rocm.py","lines":["@@ -0,0 +1,129 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+import pytest","+import torch","+","+from vllm.model_executor.kernels.attention.dsa.dcp_indexer_rocm import (","+    pack_dcp_candidates,","+    select_dcp_candidates,","+)","+from vllm.platforms import current_platform","+","+pytestmark = pytest.mark.skipif(","+    not current_platform.is_rocm(), reason=\"ROCm DCP indexer\"","+)","+","+","+@pytest.mark.parametrize(\"world_size\", [2, 8])","+@pytest.mark.parametrize(\"interleave\", [1, 16])","+@pytest.mark.parametrize(\"with_offsets\", [False, True])","+def test_global_candidates_match_score_and_token_order(","+    world_size, interleave, with_offsets","+):","+    \"\"\"Mixed signs, ties, short/empty shards and per-row offsets retain global ids.\"\"\"","+    k, rows, width = 8, 3, 19","+    generator = torch.Generator().manual_seed(17)","+    shards = []","+    expected: list[list[tuple[float, int]]] = [[] for _ in range(rows)]","+    for rank in range(world_size):","+        scores = torch.randint(-3, 4, (rows, width), generator=generator).float()","+        scores[1, 1] = -0.0","+        scores[1, 2] = 0.0","+        starts = (","+            torch.tensor([2, 0, 1])","+            if with_offsets","+            else torch.zeros(rows, dtype=torch.long)","+        )","+        indices = torch.full((rows, k), -1, dtype=torch.int32)","+        for row in range(rows):","+            length = 0 if row == 2 else width - int(starts[row]) - rank","+            candidates = [","+                (float(scores[row, int(starts[row]) + i]), i) for i in range(length)","+            ]","+            candidates.sort(key=lambda item: (-item[0], item[1]))","+            for column, (score, local) in enumerate(candidates[:k]):","+                indices[row, column] = local","+                token = (","+                    local // interleave * world_size * interleave","+                    + rank * interleave","+                    + local % interleave","+                )","+                expected[row].append((score, token))","+        shards.append(","+            pack_dcp_candidates(","+                scores.cuda(),","+                indices.cuda(),","+                rank,","+                world_size,","+                interleave,","+                starts.cuda() if with_offsets else None,","+            )","+        )","+    gathered = torch.cat(shards, dim=1)","+    out = torch.empty((rows, k), dtype=torch.int32, device=\"cuda\")","+    select_dcp_candidates(gathered, out)","+    reference = torch.full((rows, k), -1, dtype=torch.int32)","+    for row, candidates in enumerate(expected):","+        candidates.sort(key=lambda item: (-item[0], item[1]))","+        reference[row, : min(k, len(candidates))] = torch.tensor(","+            [token for _, token in candidates[:k]], dtype=torch.int32","+        )","+    # Selection is unordered within a row: compare the selected sets.","+    torch.testing.assert_close(","+        out.cpu().sort(dim=-1).values, reference.sort(dim=-1).values, rtol=0, atol=0","+    )","+","+","+def test_empty_shard_and_graph_replay():","+    indices = torch.tensor([[0, 1, -1, 3]], dtype=torch.int32, device=\"cuda\")","+    scores = torch.tensor([[1.0, 4.0, -float(\"inf\"), float(\"nan\")]], device=\"cuda\")","+    out = torch.empty_like(indices)","+    empty = pack_dcp_candidates(scores[:, :0], indices, 0, 2, 1)","+    stream = torch.cuda.Stream()","+    stream.wait_stream(torch.cuda.current_stream())","+    with torch.cuda.stream(stream):","+        for _ in range(3):","+            select_dcp_candidates(","+                torch.cat(","+                    [empty, pack_dcp_candidates(scores, indices, 1, 2, 1)], dim=1","+                ),","+                out,","+            )","+    torch.cuda.current_stream().wait_stream(stream)","+    graph = torch.cuda.CUDAGraph()","+    with torch.cuda.graph(graph):","+        select_dcp_candidates(","+            torch.cat([empty, pack_dcp_candidates(scores, indices, 1, 2, 1)], dim=1),","+            out,","+        )","+    scores[0, 0] = 6.0","+    graph.replay()","+    torch.testing.assert_close(","+        out.cpu().sort(dim=-1).values,","+        torch.tensor([[-1, -1, 1, 3]], dtype=torch.int32),","+        rtol=0,","+        atol=0,","+    )","+","+","+def test_strided_candidates_mask_nonfinite_and_preserve_output_padding():","+    \"\"\"Fused packing preserves signed-zero ties and writes only output slots.\"\"\"","+    scores = torch.tensor(","+        [[0.0, 99.0, -0.0, 99.0, float(\"inf\"), 99.0, float(\"nan\"), 99.0, -2.0, 99.0]],","+        device=\"cuda\",","+    )[:, ::2]","+    indices = torch.tensor(","+        [[0, 99, 1, 99, 2, 99, 3, 99, 4, 99, -1, 99, 5, 99]],","+        device=\"cuda\",","+        dtype=torch.int32,","+    )[:, ::2]","+    packed = pack_dcp_candidates(scores, indices, 1, 2, 16)","+    storage = torch.full((1, 18), 73, device=\"cuda\", dtype=torch.int32)","+    select_dcp_candidates(packed, storage[:, ::2])","+    torch.testing.assert_close(","+        storage[:, ::2].sort(-1).values.cpu(),","+        torch.tensor([[-1, -1, -1, -1, -1, -1, 16, 17, 20]], dtype=torch.int32),","+        rtol=0,","+        atol=0,","+    )","+    assert bool((storage[:, 1::2] == 73).all())"],"additions":129,"deletions":0,"truncated":false},{"path":"tests/kernels/attention/test_rocm_aiter_flydsl_sparse_mla.py","lines":["@@ -0,0 +1,360 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"VLLM_ROCM_USE_AITER_FLYDSL_SPARSE_MLA: rocm_aiter_ops.triton_sparse_mla_fwd","+on the in-tree FlyDSL sparse MLA must match the Triton kernel on the Kimi-K3.1","+fp8_ds_mla call shapes, and fall back to it whenever FlyDSL cannot take a call.\"\"\"","+","+import pytest","+import torch","+","+from vllm.platforms import current_platform","+","+pytestmark = pytest.mark.skipif(","+    not current_platform.is_rocm(), reason=\"ROCm-only aiter path\"","+)","+","+KV_LORA_RANK, ROPE_DIM, TOPK = 512, 64, 2048","+# fp8_ds_mla record: 512 fp8 latent, 4 fp32 per-128 scales, 64 bf16 rope.","+ROW_BYTES = KV_LORA_RANK + 4 * 4 + ROPE_DIM * 2","+","+","+@pytest.fixture","+def flydsl_ops(monkeypatch):","+    \"\"\"rocm_aiter_ops with the FlyDSL flag on; yields the FlyDSL launch log.\"\"\"","+    from vllm.platforms.rocm import on_gfx950","+","+    if not on_gfx950():","+        pytest.skip(\"FlyDSL sparse MLA is gfx950-only\")","+    flydsl = pytest.importorskip(\"vllm.models.kimi_k3.amd.ops.flydsl_sparse_mla\")","+    pytest.importorskip(\"aiter.ops.triton.attention.sparse_mla\")","+    from vllm._aiter_ops import rocm_aiter_ops","+","+    launches: list[tuple[int, bool, bool]] = []","+","+    def fwd(q, *args, has_invalid=False, return_lse=False, **kwargs):","+        launches.append((q.shape[1], has_invalid, return_lse))","+        return flydsl.flydsl_sparse_mla_fp8ds_fwd(","+            q, *args, has_invalid=has_invalid, return_lse=return_lse, **kwargs","+        )","+","+    monkeypatch.setattr(","+        rocm_aiter_ops,","+        \"_flydsl_sparse_mla_ops\",","+        staticmethod(lambda: (flydsl.flydsl_sparse_mla_fp8ds_supported, fwd)),","+    )","+    monkeypatch.setenv(\"VLLM_ROCM_USE_AITER\", \"1\")","+    monkeypatch.setenv(\"VLLM_ROCM_USE_AITER_FLYDSL_SPARSE_MLA\", \"1\")","+    # Exercise FlyDSL on small batches too; the gate has its own test.","+    monkeypatch.setenv(\"VLLM_ROCM_AITER_FLYDSL_SPARSE_MLA_MIN_TOKENS\", \"1\")","+    # Keep aiter's own FlyDSL route off so the Triton reference is Gluon.","+    monkeypatch.delenv(\"AITER_FLYDSL_SPARSE_MLA\", raising=False)","+    rocm_aiter_ops.refresh_env_variables()","+    try:","+        yield rocm_aiter_ops, launches","+    finally:","+        monkeypatch.undo()","+        rocm_aiter_ops.refresh_env_variables()","+","+","+def _fp8_ds_mla_cache(num_slots: int, gen: torch.Generator) -> torch.Tensor:","+    latent = (torch.randn(num_slots, KV_LORA_RANK, generator=gen) * 0.3).to(","+        torch.float8_e4m3fn","+    )","+    scales = torch.exp2(torch.randint(-6, 1, (num_slots, 4), generator=gen).float())","+    rope = (torch.randn(num_slots, ROPE_DIM, generator=gen) * 0.5).to(torch.bfloat16)","+    cache = torch.cat(","+        [latent.view(torch.uint8), scales.view(torch.uint8), rope.view(torch.uint8)],","+        dim=1,","+    )","+    assert cache.shape[1] == ROW_BYTES","+    return cache.cuda()","+","+","+def _indices(case: str, num_tokens: int, num_slots: int, gen: torch.Generator):","+    \"\"\"(indptr, indices, has_invalid) as the K3.1 fp8_ds_mla call sites build them.","+","+    fixed: DCP non-compact prefill, TOPK per row, -1 past the valid count.","+    ragged: non-DCP / compact DCP prefill, min(pos + 1, TOPK) valid slots per row.","+    \"\"\"","+    positions = torch.randint(0, 3 * TOPK, (num_tokens,), generator=gen)","+    edges = torch.tensor([0, 1, TOPK - 1, TOPK])[:num_tokens]","+    positions[: len(edges)] = edges","+    lens = torch.clamp(positions + 1, max=TOPK)","+    if case == \"fixed\":","+        indices = torch.full((num_tokens, TOPK), -1, dtype=torch.int32)","+        for row, n in enumerate(lens.tolist()):","+            indices[row, :n] = torch.randint(0, num_slots, (n,), generator=gen)","+        indptr = torch.arange(num_tokens + 1, dtype=torch.int32) * TOPK","+        return indptr.cuda(), indices.flatten().cuda(), True","+    indptr = torch.zeros(num_tokens + 1, dtype=torch.int32)","+    indptr[1:] = lens.cumsum(0)","+    indices = torch.randint(","+        0, num_slots, (int(indptr[-1]),), generator=gen, dtype=torch.int32","+    )","+    return indptr.cuda(), indices.cuda(), False","+","+","+def _run(ops, q, kv, indptr, indices, has_invalid, return_lse, scale):","+    out = torch.empty(","+        (q.shape[0], q.shape[1], KV_LORA_RANK), dtype=torch.bfloat16, device=q.device","+    )","+    lse = ops.triton_sparse_mla_fwd(","+        q,","+        kv,","+        out,","+        scale,","+        indptr,","+        indices,","+        kv_lora_rank=KV_LORA_RANK,","+        qk_rope_head_dim=ROPE_DIM,","+        has_invalid=has_invalid,","+        return_lse=return_lse,","+    )","+    return out, lse","+","+","+@pytest.mark.parametrize(\"case\", [\"fixed\", \"ragged\"])","+@pytest.mark.parametrize(\"return_lse\", [False, True])","+@pytest.mark.parametrize(\"num_heads,num_tokens\", [(12, 300), (16, 37), (4, 1)])","+@torch.inference_mode()","+def test_flydsl_matches_triton(","+    flydsl_ops, case: str, return_lse: bool, num_heads: int, num_tokens: int","+) -> None:","+    ops, launches = flydsl_ops","+    gen = torch.Generator().manual_seed(num_heads * 1000 + num_tokens)","+    num_slots = 3 * TOPK","+    cache = _fp8_ds_mla_cache(num_slots, gen)","+    # As forward_mqa hands it over: one row per page.","+    kv = cache.unsqueeze(1)","+    indptr, indices, has_invalid = _indices(case, num_tokens, num_slots, gen)","+    q = (","+        torch.randn(num_tokens, num_heads, KV_LORA_RANK + ROPE_DIM, generator=gen) * 0.5","+    ).to(\"cuda\", torch.bfloat16)","+    scale = (KV_LORA_RANK + ROPE_DIM) ** -0.5","+","+    out, lse = _run(ops, q, kv, indptr, indices, has_invalid, return_lse, scale)","+    assert launches == [(num_heads, has_invalid, return_lse)]","+    ops._FLYDSL_SPARSE_MLA = False","+    ref_out, ref_lse = _run(ops, q, kv, indptr, indices, has_invalid, return_lse, scale)","+    assert len(launches) == 1","+","+    assert not out.isnan().any()","+    torch.testing.assert_close(out, ref_out, atol=3e-2, rtol=2e-2)","+    cos = torch.nn.functional.cosine_similarity(","+        out.float().flatten(), ref_out.float().flatten(), dim=0","+    )","+    assert cos > 0.9999","+    if return_lse:","+        assert lse is not None and ref_lse is not None","+        torch.testing.assert_close(lse, ref_lse.view_as(lse), atol=1e-3, rtol=1e-4)","+    else:","+        assert lse is None","+","+","+@torch.inference_mode()","+def test_flydsl_cache_past_4gib(flydsl_ops) -> None:","+    \"\"\"The non-DCP K3.1 call hands FlyDSL its whole packed block-row space,","+    which spans more than 4 GiB on a real server: slots past that line must","+    be addressed in 64 bits (DMA, scale and rope reads alike).\"\"\"","+    ops, launches = flydsl_ops","+    span = 5 * 2**30","+    num_slots = span // ROW_BYTES","+    free, _ = torch.accelerator.get_memory_info()","+    if free < span + 2**30:","+        pytest.skip(\"needs 6 GiB of free device memory\")","+    gen = torch.Generator().manual_seed(3)","+    num_tokens, num_heads = 64, 16","+    small = _fp8_ds_mla_cache(3 * TOPK, gen)","+    n = small.shape[0]","+    # The rows that get read, scattered to either side of the 4 GiB line.","+    line = 2**32 // ROW_BYTES + 1","+    slots = torch.cat(","+        [","+            torch.randperm(line, generator=gen)[: n // 2],","+            line + torch.randperm(num_slots - line, generator=gen)[: n - n // 2],","+        ]","+    ).to(\"cuda\", torch.int64)","+    big = torch.empty(num_slots, ROW_BYTES, dtype=torch.uint8, device=\"cuda\")","+    big[slots] = small","+    indptr, local, has_invalid = _indices(\"ragged\", num_tokens, n, gen)","+    indices = slots[local.long()].to(torch.int32)","+    assert int(indices.max()) * ROW_BYTES > 2**32","+    q = (","+        torch.randn(num_tokens, num_heads, KV_LORA_RANK + ROPE_DIM, generator=gen) * 0.5","+    ).to(\"cuda\", torch.bfloat16)","+    scale = (KV_LORA_RANK + ROPE_DIM) ** -0.5","+","+    out, lse = _run(ops, q, big.unsqueeze(1), indptr, indices, has_invalid, True, scale)","+    assert launches == [(num_heads, has_invalid, True)]","+    # The same kernel over the compact cache with local ids is the same work","+    # in the same order, so it is bit-exact.","+    out_s, lse_s = _run(","+        ops, q, small.unsqueeze(1), indptr, local, has_invalid, True, scale","+    )","+    assert torch.equal(out, out_s) and torch.equal(lse, lse_s)","+    # The Triton kernel gathers with 64-bit offsets, so it is a reference too.","+    ops._FLYDSL_SPARSE_MLA = False","+    ref_out, ref_lse = _run(","+        ops, q, big.unsqueeze(1), indptr, indices, has_invalid, True, scale","+    )","+    assert len(launches) == 2","+    assert not out.isnan().any()","+    torch.testing.assert_close(out, ref_out, atol=3e-2, rtol=2e-2)","+    cos = torch.nn.functional.cosine_similarity(","+        out.float().flatten(), ref_out.float().flatten(), dim=0","+    )","+    assert cos > 0.9999","+    torch.testing.assert_close(lse, ref_lse.view_as(lse), atol=1e-3, rtol=1e-4)","+","+","+@torch.inference_mode()","+def test_flydsl_falls_back_to_triton(flydsl_ops, monkeypatch) -> None:","+    ops, launches = flydsl_ops","+    gen = torch.Generator().manual_seed(0)","+    cache = _fp8_ds_mla_cache(TOPK, gen)","+    indptr, indices, _ = _indices(\"ragged\", 8, TOPK, gen)","+    q = torch.randn(8, 16, KV_LORA_RANK + ROPE_DIM, generator=gen).to(","+        \"cuda\", torch.bfloat16","+    )","+","+    def run():","+        return _run(ops, q, cache.unsqueeze(1), indptr, indices, False, True, 0.04)","+","+    ops._FLYDSL_SPARSE_MLA = False","+    ref_out, ref_lse = run()","+    ops._FLYDSL_SPARSE_MLA = True","+","+    # aiter without the FlyDSL op.","+    with monkeypatch.context() as m:","+        m.setattr(ops, \"_flydsl_sparse_mla_ops\", staticmethod(lambda: None))","+        out, lse = run()","+    assert torch.equal(out, ref_out) and torch.equal(lse, ref_lse)","+    assert not launches","+","+    # A config that never ran eagerly is not compiled mid CUDA-graph capture.","+    ops._FLYDSL_SPARSE_MLA_COMPILED.discard((16, False, True))","+    with monkeypatch.context() as m:","+        m.setattr(torch.cuda, \"is_current_stream_capturing\", lambda: True)","+        out, lse = run()","+    assert torch.equal(out, ref_out) and torch.equal(lse, ref_lse)","+    assert not launches","+    run()","+    assert launches == [(16, False, True)]","+    with monkeypatch.context() as m:","+        m.setattr(torch.cuda, \"is_current_stream_capturing\", lambda: True)","+        run()","+    assert len(launches) == 2","+","+","+def _run_sink(ops, q, kv, indptr, indices, scale, sink):","+    out = torch.empty(","+        (q.shape[0], q.shape[1], KV_LORA_RANK), dtype=torch.bfloat16, device=q.device","+    )","+    ops.triton_sparse_mla_fwd(","+        q,","+        kv,","+        out,","+        scale,","+        indptr,","+        indices,","+        has_invalid=False,","+        attn_sink=sink,","+        return_lse=True,","+    )","+    return out","+","+","+@torch.inference_mode()","+def test_flydsl_rejects_unsupported_calls(flydsl_ops) -> None:","+    \"\"\"Calls FlyDSL cannot take (attention sink here) stay on Triton.\"\"\"","+    ops, launches = flydsl_ops","+    gen = torch.Generator().manual_seed(1)","+    cache = _fp8_ds_mla_cache(TOPK, gen)","+    indptr, indices, _ = _indices(\"ragged\", 8, TOPK, gen)","+    q = torch.randn(8, 16, KV_LORA_RANK + ROPE_DIM, generator=gen).to(","+        \"cuda\", torch.bfloat16","+    )","+    sink = torch.zeros(16, device=\"cuda\")","+    out = _run_sink(ops, q, cache.unsqueeze(1), indptr, indices, 0.04, sink)","+    assert not launches","+    ops._FLYDSL_SPARSE_MLA = False","+    ref = _run_sink(ops, q, cache.unsqueeze(1), indptr, indices, 0.04, sink)","+    assert torch.equal(out, ref)","+","+","+IN_TREE_MODULE = \"vllm.models.kimi_k3.amd.ops.flydsl_sparse_mla\"","+AITER_MODULE = \"aiter.ops.flydsl.sparse_mla\"","+","+","+def _resolve(monkeypatch, broken: tuple[str, ...]):","+    \"\"\"_flydsl_sparse_mla_ops() with the named modules failing to import.\"\"\"","+    import importlib","+","+    from vllm._aiter_ops import rocm_aiter_ops","+","+    real = importlib.import_module","+","+    def fake(name, *args, **kwargs):","+        if name in broken:","+            raise ImportError(f\"no {name}\")","+        return real(name, *args, **kwargs)","+","+    with monkeypatch.context() as m:","+        m.setattr(importlib, \"import_module\", fake)","+        rocm_aiter_ops._flydsl_sparse_mla_ops.cache_clear()","+        try:","+            return rocm_aiter_ops._flydsl_sparse_mla_ops()","+        finally:","+            rocm_aiter_ops._flydsl_sparse_mla_ops.cache_clear()","+","+","+def test_flydsl_ops_prefer_in_tree(monkeypatch) -> None:","+    \"\"\"The lookup takes vLLM's own FlyDSL kernel over aiter's copy.\"\"\"","+    in_tree = pytest.importorskip(IN_TREE_MODULE)","+","+    ops = _resolve(monkeypatch, ())","+    assert ops is not None","+    assert ops == (","+        in_tree.flydsl_sparse_mla_fp8ds_supported,","+        in_tree.flydsl_sparse_mla_fp8ds_fwd,","+    )","+","+","+def test_flydsl_ops_fall_back_to_aiter(monkeypatch) -> None:","+    \"\"\"Without the in-tree kernel the lookup still finds aiter's copy.\"\"\"","+    aiter_flydsl = pytest.importorskip(AITER_MODULE)","+","+    assert _resolve(monkeypatch, (IN_TREE_MODULE,)) == (","+        aiter_flydsl.flydsl_sparse_mla_fp8ds_supported,","+        aiter_flydsl.flydsl_sparse_mla_fp8ds_fwd,","+    )","+","+","+def test_flydsl_ops_none_without_flydsl(monkeypatch) -> None:","+    \"\"\"A box with no FlyDSL at all keeps running on the Triton kernel.","+","+    The lookup must report absence instead of raising; triton_sparse_mla_fwd","+    treats None as \"not handled\" and falls through. Needs no FlyDSL install,","+    so it runs wherever the ROCm kernel suite runs.","+    \"\"\"","+    assert _resolve(monkeypatch, (IN_TREE_MODULE, AITER_MODULE)) is None","+","+","+@torch.inference_mode()","+def test_flydsl_min_tokens_gate(flydsl_ops, monkeypatch) -> None:","+    \"\"\"Batches below the min-tokens gate (decode) stay on Triton.\"\"\"","+    ops, launches = flydsl_ops","+    gen = torch.Generator().manual_seed(2)","+    cache = _fp8_ds_mla_cache(TOPK, gen)","+    q = torch.randn(64, 12, KV_LORA_RANK + ROPE_DIM, generator=gen).to(","+        \"cuda\", torch.bfloat16","+    )","+    indptr, indices, _ = _indices(\"ragged\", 64, TOPK, gen)","+    monkeypatch.setenv(\"VLLM_ROCM_AITER_FLYDSL_SPARSE_MLA_MIN_TOKENS\", \"65\")","+    ops.refresh_env_variables()","+    _run(ops, q, cache.unsqueeze(1), indptr, indices, False, True, 0.04)","+    assert not launches","+    monkeypatch.setenv(\"VLLM_ROCM_AITER_FLYDSL_SPARSE_MLA_MIN_TOKENS\", \"64\")","+    ops.refresh_env_variables()","+    _run(ops, q, cache.unsqueeze(1), indptr, indices, False, True, 0.04)","+    assert launches == [(12, False, True)]"],"additions":360,"deletions":0,"truncated":false},{"path":"tests/kernels/attention/test_rocm_aiter_mla_sink.py","lines":["@@ -293,7 +293,7 @@ def test_sparse_mla_backend_reports_sink_support_for_current_hardware() -> None:","     assert ROCMAiterMLASparseBackend.supports_sink() == (get_cdna_version() in (3, 4))"," "," ","-def test_sparse_mla_backend_rejects_dcp() -> None:","+def test_sparse_mla_backend_allows_dcp() -> None:","     from vllm.platforms.rocm import RocmPlatform","     from vllm.v1.attention.backends.registry import AttentionBackendEnum","     from vllm.v1.attention.selector import AttentionSelectorConfig","@@ -312,11 +312,11 @@ def test_sparse_mla_backend_rejects_dcp() -> None:","         use_dcp=True,","     )"," ","-    with pytest.raises(ValueError, match=\"DCP not supported\"):","-        RocmPlatform.get_attn_backend_cls(","-            selected_backend=AttentionBackendEnum.ROCM_AITER_MLA_SPARSE,","-            attn_selector_config=selector_config,","-        )","+    backend_cls = RocmPlatform.get_attn_backend_cls(","+        selected_backend=AttentionBackendEnum.ROCM_AITER_MLA_SPARSE,","+        attn_selector_config=selector_config,","+    )","+    assert backend_cls == AttentionBackendEnum.ROCM_AITER_MLA_SPARSE.get_path()"," "," "," @pytest.mark.parametrize(\"num_heads,block_size\", [(8, 16), (20, 32)])","@@ -466,7 +466,7 @@ def test_sparse_mla_sink_forward_mqa_preserves_split_query(dtype):","     kv = torch.randn(2, 2, block_size, Q_HEAD_DIM, device=\"cuda\").to(dtype)[:, 1]","     selected = torch.tensor([[1, 7, 18], [0, 3, 20]], dtype=torch.int32, device=\"cuda\")","     sinks = torch.linspace(-3.0, 5.0, num_heads, device=\"cuda\")","-    impl = object.__new__(ROCMAiterMLASparseImpl)","+    impl = ROCMAiterMLASparseImpl.__new__(ROCMAiterMLASparseImpl)","     impl.num_heads = num_heads","     impl.kv_lora_rank = V_HEAD_DIM","     impl.kv_cache_dtype = \"auto\""],"additions":7,"deletions":7,"truncated":false},{"path":"tests/kernels/attention/test_rocm_aiter_mla_sparse_index_remap.py","lines":["@@ -7,6 +7,7 @@"," import torch"," "," from vllm.platforms import current_platform","+from vllm.triton_utils import tl, triton"," "," if not current_platform.is_rocm():","     pytest.skip(","@@ -35,6 +36,318 @@"," TOPK_TOKENS = 4"," "," ","+@pytest.mark.parametrize(\"rows,topk\", [(0, 512), (1, 512), (96, 2048), (300, 2048)])","+def test_dcp_csr_preserves_valid_slots_and_empty_rows(rows, topk):","+    generator = torch.Generator(device=\"cuda\").manual_seed(7)","+    # A row stride larger than top-k also occurs with sliced index buffers.","+    indices = torch.randint(","+        -1024,","+        4096,","+        (rows, topk + 16),","+        generator=generator,","+        dtype=torch.int32,","+        device=\"cuda\",","+    )[:, :topk]","+    if rows:","+        indices[0].fill_(-1)","+    indptr, packed = sparse_mod._compact_dcp_indices(indices)","+    expected = indices[indices >= 0]","+    counts = (indices >= 0).sum(dim=1, dtype=torch.int32)","+    torch.testing.assert_close(","+        indptr[1:], counts.cumsum(0), atol=0, rtol=0, check_dtype=False","+    )","+    assert indptr[0].item() == 0","+    torch.testing.assert_close(packed[: expected.numel()], expected, atol=0, rtol=0)","+","+","+def _poison_empty(monkeypatch, value):","+    \"\"\"Fill every `torch.empty` result, so an unwritten entry is visible.\"\"\"","+    real_empty = torch.empty","+","+    def empty(*args, **kwargs):","+        return real_empty(*args, **kwargs).fill_(value)","+","+    monkeypatch.setattr(torch, \"empty\", empty)","+","+","+@pytest.mark.parametrize(\"rows,topk\", [(0, 512), (1, 512), (96, 2048), (300, 2048)])","+def test_dcp_csr_with_counts_packs_row_prefixes(monkeypatch, rows, topk):","+    \"\"\"The counts arm is the DCP decode path: every pure-decode step uses it.","+","+    With counts the valid entries are a row prefix rather than the entries","+    above the `-1` sentinel, and `indptr` is left uninitialised for the","+    kernel to fill. Poisoning the allocation fails this test if","+    `_pack_valid_rows` ever stops writing all `rows + 1` entries.","+    \"\"\"","+    generator = torch.Generator(device=\"cuda\").manual_seed(13)","+    # Positive garbage past the prefix: a sentinel-based pack would keep it.","+    indices = torch.randint(","+        0,","+        4096,","+        (rows, topk + 16),","+        generator=generator,","+        dtype=torch.int32,","+        device=\"cuda\",","+    )[:, :topk]","+    counts = torch.randint(","+        0, topk + 1, (rows,), generator=generator, dtype=torch.int32, device=\"cuda\"","+    )","+    if rows:","+        counts[0] = 0","+        counts[-1] = topk","+","+    _poison_empty(monkeypatch, -7)","+    indptr, packed = sparse_mod._compact_dcp_indices(indices, counts)","+","+    assert indptr.numel() == rows + 1","+    assert indptr[0].item() == 0","+    torch.testing.assert_close(","+        indptr[1:], counts.cumsum(0), atol=0, rtol=0, check_dtype=False","+    )","+    expected = torch.cat(","+        [indices[row, : counts[row]] for row in range(rows)] + [indices.new_empty(0)]","+    )","+    torch.testing.assert_close(packed[: expected.numel()], expected, atol=0, rtol=0)","+","+","+@triton.jit","+def _score_key_probe(src, dst, N: tl.constexpr):","+    i = tl.arange(0, N)","+    tl.store(dst + i, sparse_mod._score_key(tl.load(src + i)))","+","+","+def test_score_key_orders_floats_and_sinks_nan():","+    \"\"\"merge_dcp_scores compares scores as integers, so the map must order.","+","+    NaN has to land below -inf: a NaN logit must never win a top-k slot from","+    a real one.","+    \"\"\"","+    values = torch.tensor(","+        [float(\"nan\"), float(\"-inf\"), -1.0, -0.0, 0.0, 1.0, float(\"inf\")],","+        dtype=torch.float32,","+        device=\"cuda\",","+    )","+    keys = torch.empty(8, dtype=torch.int32, device=\"cuda\")","+    _score_key_probe[(1,)](torch.cat([values, values[:1]]), keys, 8)","+","+    assert keys[0].item() == -2147483648","+    ordered = keys[:7].tolist()","+    assert ordered == sorted(ordered)","+    assert len(set(ordered)) == 7","+","+","+def _score_keys(scores):","+    bits = scores.view(torch.int32).to(torch.int64)","+    keys = bits ^ ((bits >> 31) & 0x7FFFFFFF)","+    return torch.where(","+        (bits & 0x7FFFFFFF) > 0x7F800000, torch.tensor(-2147483648), keys","+    )","+","+","+def _reference_merge(scores, local_indices, token_block_table, rank, page, stride):","+    \"\"\"Selection of _select_owned_slots, written out row by row.","+","+    Args:","+        scores: Rank-major scores of shape `[rows, world * k]`.","+        local_indices: Every rank's local KV positions, `[world, rows, k]`.","+            A negative entry is a padded slot the row does not own.","+        token_block_table: Per-row block table.","+        rank: The rank whose selection is wanted.","+        page: KV block size.","+        stride: Cache rows per KV block.","+","+    Returns:","+        The CSR row pointer and the packed physical KV rows of `rank`.","+","+    \"\"\"","+    world, rows, k = local_indices.shape","+    keys = _score_keys(scores)","+    # The k-th largest key: the threshold the aiter top-k hands the kernel.","+    threshold = keys.sort(dim=1, descending=True).values[:, k - 1].tolist()","+    keys = keys.tolist()","+    live = (local_indices[rank] >= 0).tolist()","+    locals_ = local_indices[rank].tolist()","+    pages = token_block_table.tolist()","+    counts = []","+    packed = []","+    for row in range(rows):","+        limit = threshold[row]","+        row_keys = keys[row]","+        room = k - sum(key > limit for key in row_keys)","+        mine = row_keys[rank * k : (rank + 1) * k]","+        tied = [live[row][col] and mine[col] == limit for col in range(k)]","+        if any(tied):","+            # The kernel counts every earlier plane's entries at the threshold","+            # with no liveness mask, so the reference does the same.","+            room -= sum(key == limit for key in row_keys[: rank * k])","+        cols = []","+        ordinal = 0","+        for col in range(k):","+            if not live[row][col]:","+                continue","+            if mine[col] > limit:","+                cols.append(col)","+            elif tied[col]:","+                if ordinal < room:","+                    cols.append(col)","+                ordinal += 1","+        counts.append(len(cols))","+        for col in cols:","+            local = locals_[row][col]","+            packed.append(pages[row][local // page] * stride + local % page)","+    indptr = torch.tensor([0] + counts, dtype=torch.int32).cumsum(0)","+    return indptr, torch.tensor(packed, dtype=torch.int32, device=scores.device)","+","+","+def _merge_inputs(rows, k, world_size, num_pages, page, live_per_row, seed):","+    \"\"\"Build one merge case: tied scores, with each plane padding its tail.","+","+    `live_per_row` gives each row's total live entries across the ranks; a","+    row with fewer than `k` of them is a short row, whose k-th score is then","+    `-inf` and whose padding ties with it.","+    \"\"\"","+    generator = torch.Generator(device=\"cuda\").manual_seed(seed)"],"additions":172,"deletions":0,"truncated":false}],"additions":677,"deletions":7,"truncated":true,"file_count":5},"error":null,"fetched_at":"2026-11-13T17:04:01.559494+00:00"}