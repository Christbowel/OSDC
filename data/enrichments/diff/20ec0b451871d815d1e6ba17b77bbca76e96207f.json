r}\": [team for team in (teams or []) if team]","+            for codeowner, teams in co_jira_map.items()","+        }","+","+    @classmethod","+    def from_repo(cls) -> \"TeamResolver\":","+        \"\"\"Build a resolver from the CODEOWNERS and mapping files in this repo.\"\"\"","+        with open(CODEOWNERS_FILE, \"r\", encoding=\"utf8\") as codeowners_file:","+            codeowners_contents = codeowners_file.read()","+        with open(CO_JIRA_MAP_FILE, \"r\", encoding=\"utf8\") as map_file:","+            co_jira_map = yaml.safe_load(map_file)","+        return cls(codeowners_contents, co_jira_map)","+","+    def _jira_teams_for_codeowner(self, codeowner: str) -> list[str]:","+        \"\"\"","+        Map a single GitHub team to its JIRA team(s).","+","+        Ownership is often expressed with a sub team that has no JIRA team of its","+        own (`@10gen/query-execution-sbe`, `@10gen/server-replication-reviewers`),","+        so fall back to the longest mapped ancestor of the team name.","+        \"\"\"","+        name = codeowner","+        while name:","+            if name in self._co_jira_map:","+                return self._co_jira_map[name]","+            name, _, _ = name.rpartition(\"-\")","+        return []","+","+    def jira_teams(self, file_path: str) -> list[str]:","+        \"\"\"","+        Return the JIRA teams owning the given repo relative file path.","+","+        `matching_lines` yields the CODEOWNERS rules matching the file from most","+        to least specific. Ownership is frequently narrowed to a sub team with no","+        JIRA team of its own, so keep widening until a rule names a team we can","+        map, rather than giving up on the most specific rule.","+        \"\"\"","+        for owners, _, _, _ in self._codeowners.matching_lines(file_path):","+            teams = []","+            for owner_type, codeowner in owners:","+                if owner_type != \"TEAM\":","+                    continue","+                for