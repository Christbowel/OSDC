fallback) {","+                                log_debug_errno(r, \"Couldn't read credential '%s' from '%s', using SetCredential= fallback: %m\",","+                                                *id, *source);","+                                continue;","+                        }","+","+                        return log_error_errno(r, \"Failed to read credential '%s' from '%s': %m\", *id, *source);","+                }","+","+                r = machine_credential_add(&credentials, *id, iov.iov_base, iov.iov_len);","+                if (r < 0)","+                        return log_error_errno(r, \"Failed to add credential '%s': %m\", *id);","+        }","+","+        /* LoadCredential= takes precedence, SetCredential= only acts as fallback. */","+        FOREACH_ARRAY(cred, settings->credentials.credentials, settings->credentials.n_credentials) {","+                if (machine_credential_find(&credentials, cred->id))","+                        continue;","+","+                r = machine_credential_add(&credentials, cred->id, cred->data, cred->size);","+                if (r < 0)","+                        return log_error_errno(r, \"Failed to add credential '%s': %m\", cred->id);","+        }","+","+        if (credentials.n_credentials > 0 || !strv_isempty(load_credentials)) {","+                machine_credential_context_done(&arg_credentials);","+                arg_credentials = TAKE_STRUCT(credentials);","+        }","+","+        return 0;","+}","+"," static int merge_settings(Settings *settings, const char *path) {","         int rl;"," ","@@ -5099,6 +5167,14 @@ static int merge_settings(Settings *settings, const char *path) {","                 arg_restrict_address_families_is_allowlist = settings->restrict_address_families_is_allowlist;","         }"," ","+        if (!FLAGS_SET(arg_settings_mask, SETTING_CREDENTIALS)) {","+                int r;","+","+                r = merge_settings_credentials(settings, path);","+                if (r < 0)","+ 