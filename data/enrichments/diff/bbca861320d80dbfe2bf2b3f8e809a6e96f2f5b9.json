= machine_credential_split(cred_str, &id, &p);","+        if (r == -EBADMSG)","+                return log_error_errno(SYNTHETIC_ERRNO(EINVAL), \"Missing ':' separator in --set-credential= argument.\");","+        if (r < 0)","+                return log_error_errno(r, \"Failed to parse --set-credential= parameter: %m\");","+","+        _cleanup_(erase_and_freep) char *data = NULL;","+        ssize_t l;","+        l = cunescape(p, UNESCAPE_ACCEPT_NUL, &data);","+        if (l < 0)","+                return log_error_errno(l, \"Failed to unescape data of credential '%s': %m\", id);","+","+        return machine_credential_add_and_log(ctx, id, data, l);","+}","+","+int machine_credential_load(MachineCredentialContext *ctx, const char *cred_path) {","+        _cleanup_free_ char *id = NULL;","+        const char *p;","+        int r;","+","+        assert(ctx);","+        assert(cred_path);","+","+        r = machine_credential_split(cred_path, &id, &p);","+        if (r == -EBADMSG)","+                return log_error_errno(SYNTHETIC_ERRNO(EINVAL), \"Missing value for --load-credential=: %s\", cred_path);","+        if (r < 0)","+                return log_error_errno(r, \"Failed to parse --load-credential= parameter: %m\");","+","+        if (!machine_credential_source_valid(p))","+                return log_error_errno(SYNTHETIC_ERRNO(EINVAL),","+                                       \"Credential source appears to be neither a valid path nor a credential name: %s\", p);","+","+        _cleanup_(iovec_done_erase) struct iovec iov = {};","+        r = machine_credential_read(p, &iov);","+        if (r == -ENXIO && !is_path(p))","+                return log_error_errno(r, \"Credential not available (no credentials passed at all): %s\", p);","         if (r < 0)","                 return log_error_errno(r, \"Failed to read credential '%s': %m\", p);"," "],"additions":85,"deletions":37,"truncated":false},{"path":"src/shared/machine-credential.h","lines":["@@ -19,5 +19,9