ntial=cred.reset:nope","+SetCredential=","+LoadCredential=cred.load-reset:/tmp/cred.path","+LoadCredential=","+SetCredential=cred.set:hello world","+SetCredential=cred.escaped:a\\\\nb","+SetCredential=cred.replaced:old","+SetCredential=cred.replaced:new","+LoadCredential=cred.path:/tmp/cred.missing","+LoadCredential=cred.path:/tmp/cred.path","+LoadCredential=cred.load-wins:/tmp/cred.path","+SetCredential=cred.load-wins:fallback","+SetCredential=cred.fallback:fallback","+LoadCredential=cred.fallback:/tmp/cred.missing","+LoadCredential=cred.inherited:svc.cred","+LoadCredential=cred.inherited-missing:svc.missing","+LoadCredential=cred.inherited-fallback:svc.missing","+SetCredential=cred.inherited-fallback:fallback","+SetCredential=cred.no-separator","+LoadCredential=cred.no-separator","+SetCredential=cred/invalid:value","+LoadCredential=cred/invalid:/tmp/cred.path","+LoadCredential=cred.relative:tmp/cred.path","+LoadCredential=cred.unnormalized:/tmp/../tmp/cred.path","+","+[Files]","+${COVERAGE_BUILD_DIR:+\"Bind=$COVERAGE_BUILD_DIR\"}","+EOF","+    cat >\"$root/creds.sh\" <<\\EOF","+#!/usr/bin/env bash","+set -ex","+","+[[ \"$CREDENTIALS_DIRECTORY\" == /run/host/credentials ]]","+[[ \"$(</run/host/credentials/cred.set)\" == \"hello world\" ]]","+[[ \"$(</run/host/credentials/cred.escaped)\" == $'a\\nb' ]]","+[[ \"$(</run/host/credentials/cred.replaced)\" == new ]]","+[[ \"$(</run/host/credentials/cred.path)\" == \"foo bar\" ]]","+[[ \"$(</run/host/credentials/cred.load-wins)\" == \"foo bar\" ]]","+[[ \"$(</run/host/credentials/cred.fallback)\" == fallback ]]","+[[ ! -e /run/host/credentials/cred.reset ]]","+[[ ! -e /run/host/credentials/cred.load-reset ]]","+# Invalid assignments are ignored","+[[ ! -e /run/host/credentials/cred.no-separator ]]","+[[ ! -e /run/host/credentials/cred.relative ]]","+[[ ! -e /run/host/credentials/cred.unnormalized ]]","+[[ ! -e /run/host/credentials/cred ]]","+if [[ -n \"${EXPECTED_INHERITED:-}\" ]]; then","+    [[ \"$(</run/host/credentials/cred.inherited)\" == \"$EXPECTED_INHERITED\" ]]","+else","+    [[ ! -e /run/host/credentials/cred.inherited ]]","+fi","+EOF","+    # A credential to be inherited from systemd-nspawn is skipped if it wasn't passed to it...","+    systemd-nspawn --register=no --directory=\"$root\" bash /creds.sh","+","+    # ... and passed on if it was","+    systemd-run --wait \\","+                -p SetCredential=svc.cred:from-service \\","+                systemd-nspawn --register=no \\","+                               --directory=\"$root\" \\","+                               --setenv=EXPECTED_INHERITED=from-service \\","+                               bash /creds.sh","+","+    # Credentials on the command line take precedence over all credential settings","+    systemd-nspawn --register=no \\","+                   --directory=\"$root\" \\","+                   --set-credential=cred.cmdline:yes \\","+                   bash -xec 'test -e /run/host/credentials/cred.cmdline; test ! -e /run/host/credentials/cred.set'","+","+    # ... unless --settings=override is used, in which case the settings replace the command line ones","+    systemd-nspawn --register=no \\","+                   --directory=\"$root\" \\","+                   --settings=override \\","+                   --set-credential=cred.set:cmdline \\","+                   --set-credential=cred.cmdline:yes \\","+                   bash -xec '[[ \"$(</run/host/credentials/cred.set)\" == \"hello world\" ]]; test ! -e /run/host/credentials/cred.cmdline'","+","+    # A settings file next to the image isn't trusted, so it may not load credentials from the host, and","+    # SetCredential= is used instead. Bind= is ignored in untrusted files too, hence pass the coverage","+    # directory on the command line.","+    mv \"/run/systemd/nspawn/$container.nspawn\" \"/var/lib/machines/$container.nspawn\""],"additions":95,"deletions":0,"truncated":false}],"additions":456,"deletions":42,"truncated":true,"file_count":10},"error":nul