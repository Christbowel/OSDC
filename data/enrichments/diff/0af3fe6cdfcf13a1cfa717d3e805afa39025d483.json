{"id":"0af3fe6cdfcf13a1cfa717d3e805afa39025d483","axis":"silent","repo":"TYPO3/typo3","sha":"0af3fe6cdfcf13a1cfa717d3e805afa39025d483","parsed":{"files":[{"path":"typo3/sysext/core/Classes/Log/Logger.php","lines":["@@ -66,8 +66,9 @@ public function __construct(string $name)","     /**","      * Re-initialize instance with creating a new instance with up to date information","      */","-    public function __wakeup()","+    public function __unserialize(array $data): void","     {","+        $this->name = (string)($data['name'] ?? '');","         $newLogger = GeneralUtility::makeInstance(LogManager::class)->getLogger($this->name);","         $this->minimumLogLevel = $newLogger->minimumLogLevel;","         $this->writers = $newLogger->writers;","@@ -75,11 +76,11 @@ public function __wakeup()","     }"," ","     /**","-     * Remove everything except the name, to be able to restore it on wakeup","+     * Remove everything except the name, to be able to restore it on unserialization","      */","-    public function __sleep(): array","+    public function __serialize(): array","     {","-        return ['name'];","+        return ['name' => $this->name];","     }"," ","     /**"],"additions":5,"deletions":4,"truncated":false},{"path":"typo3/sysext/core/Classes/Resource/FileReference.php","lines":["@@ -504,18 +504,19 @@ public function getParentFolder(): FolderInterface","     /**","      * Avoids exporting original file object which contains","      * singleton dependencies that must not be serialized.","-     *","-     * @return string[]","      */","-    public function __sleep(): array","+    public function __serialize(): array","     {","-        $keys = get_object_vars($this);","-        unset($keys['originalFile'], $keys['mergedProperties'], $keys['mergedPropertiesContext']);","-        return array_keys($keys);","+        $properties = get_object_vars($this);","+        unset($properties['originalFile'], $properties['mergedProperties'], $properties['mergedPropertiesContext']);","+        return $properties;","     }"," ","-    public function __wakeup(): void","+    public function __unserialize(array $data): void","     {","+        foreach ($data as $property => $value) {","+            $this->{$property} = $value;","+        }","         $factory = GeneralUtility::makeInstance(ResourceFactory::class);","         $this->originalFile = $this->getFileObject(","             (int)$this->propertiesOfFileReference['uid_local'],"],"additions":8,"deletions":7,"truncated":false},{"path":"typo3/sysext/core/Classes/Security/BlockSerializationTrait.php","lines":["@@ -29,7 +29,7 @@ trait BlockSerializationTrait","     /**","      * Deny object deserialization.","      */","-    public function __wakeup()","+    public function __unserialize(array $data): void","     {","         throw new \\BadMethodCallException('Cannot unserialize ' . __CLASS__, 1588784142);","     }"],"additions":1,"deletions":1,"truncated":false},{"path":"typo3/sysext/core/Classes/Serializer/DenyListDeserializer.php","lines":["@@ -26,8 +26,8 @@"," "," /**","  * Deserializes a PHP-serialized payload while refusing any class that carries","- * a user-defined __destruct() or an exploitable __wakeup() (one not provided","- * solely by BlockSerializationTrait).","+ * a user-defined __destruct() or __wakeup(), or an exploitable __unserialize()","+ * (one not provided solely by BlockSerializationTrait).","  *","  * The per-class deny/allow decision is made lazily via ReflectionClass at the","  * first encounter of each class name, then cached in cache:core so that","@@ -45,7 +45,7 @@","      * @var list<string>","      */","     private array $allowedClassNames;","-    private \\ReflectionMethod $blockSerializationWakeup;","+    private \\ReflectionMethod $blockSerializationUnserialize;"," ","     public function __construct(","         #[Autowire(service: 'cache.core')]","@@ -55,7 +55,7 @@ public function __construct(","     ) {","         $allowedClassNames = $GLOBALS['TYPO3_CONF_VARS']['SYS']['deserialization']['allowedClassNames'] ?? null;","         $this->allowedClassNames = is_array($allowedClassNames) ? $allowedClassNames : [];","-        $this->blockSerializationWakeup = new \\ReflectionClass(BlockSerializationTrait::class)->getMethod('__wakeup');","+        $this->blockSerializationUnserialize = new \\ReflectionClass(BlockSerializationTrait::class)->getMethod('__unserialize');","     }"," ","     /**","@@ -125,7 +125,8 @@ private function resolveClassDenyStatus(string $className): bool","             return false;","         }","         return $this->getUserDefinedMethod($rc, '__destruct') !== null","-            || $this->hasDeniableWakeupMethod($rc);","+            || $this->getUserDefinedMethod($rc, '__wakeup') !== null","+            || $this->hasDeniableUnserializeMethod($rc);","     }"," ","     /**","@@ -146,22 +147,22 @@ private function getUserDefinedMethod(\\ReflectionClass $rc, string $methodName):","     }"," ","     /**","-     * Returns true when the class has a user-defined __wakeup() that is NOT","-     * BlockSerializationTrait::__wakeup(). Classes whose only __wakeup comes","+     * Returns true when the class has a user-defined __unserialize() that is NOT","+     * BlockSerializationTrait::__unserialize(). Classes whose only __unserialize comes","      * from BlockSerializationTrait are already protected against deserialization","      * (the trait throws unconditionally) and must not be treated as gadgets.","      *","      * Note: for trait methods getDeclaringClass() returns the using class, not the","      * trait — so the origin is identified by comparing the method's source file and line","-     * against the trait's own __wakeup declaration.","+     * against the trait's own __unserialize declaration.","      */","-    private function hasDeniableWakeupMethod(\\ReflectionClass $rc): bool","+    private function hasDeniableUnserializeMethod(\\ReflectionClass $rc): bool","     {","-        $method = $this->getUserDefinedMethod($rc, '__wakeup');","+        $method = $this->getUserDefinedMethod($rc, '__unserialize');","         if ($method === null) {","             return false;","         }","-        return $method->getFileName() !== $this->blockSerializationWakeup->getFileName()","-            || $method->getStartLine() !== $this->blockSerializationWakeup->getStartLine();","+        return $method->getFileName() !== $this->blockSerializationUnserialize->getFileName()","+            || $method->getStartLine() !== $this->blockSerializationUnserialize->getStartLine();","     }"," }"],"additions":13,"deletions":12,"truncated":false},{"path":"typo3/sysext/core/Configuration/DefaultConfiguration.php","lines":["@@ -192,12 +192,12 @@","         ],","         'deserialization' => [","             // List of class names that are allowed to be deserialized even if they carry","-            // __destruct() or __wakeup() and would otherwise be blocked. Use this to","+            // __destruct(), __wakeup() or __unserialize() and would otherwise be blocked. Use this to","             // explicitly permit classes that have been reviewed and are known to be safe.","             'allowedClassNames' => [","                 // Scheduler task entries prior to v9.5.4 contained","                 // a serialized logger instance.","-                // The `__wakeup()` method of this class is safe to be","+                // The `__unserialize()` method of this class is safe to be","                 // deserialized and is therefore excluded from the deny list","                 \\TYPO3\\CMS\\Core\\Log\\Logger::class,","             ],"],"additions":2,"deletions":2,"truncated":false},{"path":"typo3/sysext/core/Documentation/Changelog/15.0/Breaking-108285-SerializeAndUnserializeMagicMethods.rst","lines":["@@ -0,0 +1,97 @@","+..  include:: /Includes.rst.txt","+","+..  _breaking-108285-1792310400:","+","+=======================================================================","+Breaking: #108285 - Core uses __serialize() and __unserialize() methods","+=======================================================================","+","+See :issue:`108285`","+","+Description","+===========","+","+PHP 8.5 deprecates the magic methods :php:`__sleep()` and :php:`__wakeup()`","+in favor of :php:`__serialize()` and :php:`__unserialize()`. All TYPO3 Core","+classes have been migrated to the new methods:","+","+*   :php-short:`\\TYPO3\\CMS\\Core\\Log\\Logger`","+*   :php-short:`\\TYPO3\\CMS\\Core\\Resource\\FileReference`","+*   :php-short:`\\TYPO3\\CMS\\Core\\Security\\BlockSerializationTrait`","+*   :php-short:`\\TYPO3\\CMS\\Extbase\\Persistence\\Generic\\Query`","+*   :php-short:`\\TYPO3\\CMS\\Extbase\\Persistence\\Generic\\QueryResult`","+*   :php-short:`\\TYPO3\\CMS\\Extbase\\Persistence\\Generic\\Typo3QuerySettings`","+*   :php-short:`\\TYPO3\\CMS\\Extbase\\Reflection\\ReflectionService`","+*   :php-short:`\\TYPO3\\CMS\\Form\\Domain\\Finishers\\FinisherVariableProvider`","+","+:php-short:`\\TYPO3\\CMS\\Extbase\\DomainObject\\AbstractDomainObject`, the base","+class of all Extbase entities and value objects, implements","+:php:`__serialize()` and :php:`__unserialize()` as well.","+","+The internal deserializer used by :php-short:`\\TYPO3\\CMS\\Core\\Registry` and","+by upgrade wizards now also rejects classes with a user-defined","+:php:`__unserialize()` method, unless that method is provided by","+:php-short:`\\TYPO3\\CMS\\Core\\Security\\BlockSerializationTrait` or the class is","+listed in","+:php:`$GLOBALS['TYPO3_CONF_VARS']['SYS']['deserialization']['allowedClassNames']`.","+","+Impact","+======","+","+When a class or one of its parents implements :php:`__serialize()` or","+:php:`__unserialize()`, PHP no longer calls :php:`__sleep()` or","+:php:`__wakeup()`. Such methods in classes extending one of the classes above,","+including any Extbase domain model, are silently ignored.","+","+Serialized data written before the update, for example in caches, sessions or","+the state of a form, may no longer be restored correctly.","+","+Affected installations","+======================","+","+Installations with extensions that implement :php:`__sleep()` or","+:php:`__wakeup()` in a class extending one of the classes mentioned above,","+especially in Extbase domain models extending","+:php-short:`\\TYPO3\\CMS\\Extbase\\DomainObject\\AbstractEntity` or","+:php-short:`\\TYPO3\\CMS\\Extbase\\DomainObject\\AbstractValueObject`, or that","+call :php:`parent::__sleep()` or :php:`parent::__wakeup()` of these classes.","+","+Migration","+=========","+","+Replace :php:`__sleep()` with :php:`__serialize()`, which returns an array of","+the data to be serialized, and :php:`__wakeup()` with :php:`__unserialize()`,","+which receives that array and restores the object state. Call the parent","+methods where the parent class implements them:","+","+..  code-block:: php","+    :caption: Before","+","+    public function __sleep(): array","+    {","+        return ['title'];","+    }","+","+    public function __wakeup(): void","+    {","+        $this->initializeRuntimeState();","+    }","+","+..  code-block:: php","+    :caption: After","+","+    public function __serialize(): array","+    {","+        return ['title' => $this->title];","+    }","+","+    public function __unserialize(array $data): void","+    {","+        $this->title = $data['title'];","+        $this->initializeRuntimeState();","+    }","+","+Flush all caches after the update. Pending form submissions and session data","+containing serialized objects of the affected classes have to be re-created.","+","+..  index:: PHP-API, NotScanned"],"additions":97,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Resource/FileReferenceTest.php","lines":["@@ -38,6 +38,31 @@ public function setUp(): void","         $this->importCSVDataSet(__DIR__ . '/Fixtures/FileReference/FileReference.csv');","     }"," ","+    #[Test]","+    public function serializationDoesNotExposeTheOriginalFile(): void","+    {","+        $fileReference = new FileReference(['uid' => 1, 'uid_local' => 1, 'title' => 'reference title']);","+        $fileReference->getProperties();","+","+        self::assertSame(","+            'O:' . strlen(FileReference::class) . ':\"' . FileReference::class . '\":1:{s:25:\"propertiesOfFileReference\";a:3:{s:3:\"uid\";i:1;s:9:\"uid_local\";i:1;s:5:\"title\";s:15:\"reference title\";}}',","+            serialize($fileReference)","+        );","+    }","+","+    #[Test]","+    public function unserializationRestoresTheOriginalFile(): void","+    {","+        $fileReference = new FileReference(['uid' => 1, 'uid_local' => 1, 'title' => 'reference title']);","+","+        $restored = unserialize(serialize($fileReference), ['allowed_classes' => [FileReference::class]]);","+","+        self::assertInstanceOf(FileReference::class, $restored);","+        self::assertSame('reference title', $restored->getTitle());","+        self::assertSame(1, $restored->getOriginalFile()->getUid());","+        self::assertSame('/ProcessedFileTest.jpg', $restored->getIdentifier());","+    }","+","     #[Test]","     public function fileReferenceCanBeSoftDeleted(): void","     {"],"additions":25,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Serializer/DenyListDeserializerTest.php","lines":["@@ -88,12 +88,22 @@ public function classWithWakeupIsBlocked(): void","         $this->subject->deserialize($serialized);","     }"," ","+    #[Test]","+    public function classWithUnserializeIsBlocked(): void","+    {","+        $className = Fixtures\\ClassWithUnserialize::class;","+        $serialized = 'O:' . strlen($className) . ':\"' . $className . '\":0:{}';","+        $this->expectException(DeserializerException::class);","+        $this->expectExceptionCode(1778594101);","+        $this->subject->deserialize($serialized);","+    }","+","     #[Test]","     public function classWithOnlyBlockSerializationTraitIsAllowed(): void","     {","-        // BackendFormProtection inherits BlockSerializationTrait's __wakeup (throws on deserialization)","+        // BackendFormProtection inherits BlockSerializationTrait's __unserialize (throws on deserialization)","         // but carries no other gadget methods — it must NOT be blocked by the deny-list.","-        // The exception must come from BlockSerializationTrait::__wakeup (code 1588784142),","+        // The exception must come from BlockSerializationTrait::__unserialize (code 1588784142),","         // not from the deserializer deny-list (code 1778594101).","         $className = BackendFormProtection::class;","         $serialized = 'O:' . strlen($className) . ':\"' . $className . '\":0:{}';"],"additions":12,"deletions":2,"truncated":false},{"path":"typo3/sysext/core/Tests/Functional/Serializer/Fixtures/ClassWithUnserialize.php","lines":["@@ -0,0 +1,23 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Core\\Tests\\Functional\\Serializer\\Fixtures;","+","+final readonly class ClassWithUnserialize","+{","+    public function __unserialize(array $data): void {}","+}"],"additions":23,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Tests/Unit/Log/LoggerTest.php","lines":["@@ -21,14 +21,18 @@"," use PHPUnit\\Framework\\Attributes\\Test;"," use Psr\\Log\\LogLevel;"," use TYPO3\\CMS\\Core\\Log\\Logger;","+use TYPO3\\CMS\\Core\\Log\\LogManager;"," use TYPO3\\CMS\\Core\\Log\\LogRecord;"," use TYPO3\\CMS\\Core\\Log\\Processor\\NullProcessor;"," us