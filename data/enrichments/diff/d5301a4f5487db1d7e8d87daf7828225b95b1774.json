modules,version,usable\",","+    [","+        ({\"mori\", \"mori.cco\", \"mori.ops.dispatch_combine_v2\"}, \"1.2.4\", True),","+        ({\"mori\", \"mori.cco\", \"mori.ops.dispatch_combine_v2\"}, \"1.2.5.dev3+g1\", True),","+        ({\"mori\", \"mori.cco\", \"mori.ops.dispatch_combine_v2\"}, \"1.2.3.post1\", False),","+        ({\"mori\", \"mori.cco\", \"mori.ops.dispatch_combine_v2\"}, \"unknown\", False),","+        ({\"mori\"}, \"1.2.4\", False),","+        (set(), \"1.2.4\", False),","+    ],","+)","+def test_mori_epv2_needs_a_recent_mori(monkeypatch, modules, version, usable):","+    monkeypatch.setattr(import_utils, \"_has_module\", lambda name: name in modules)","+    monkeypatch.setitem(sys.modules, \"mori\", SimpleNamespace(__version__=version))","+    assert (import_utils.mori_epv2_unavailable_reason() is None) is usable","+","+","+@pytest.mark.parametrize(","+    \"backend,internode,max_tokens,kernel\",","+    [","+        (\"mori\", False, 4096, \"IntraNode\"),","+        (\"mori\", True, 256, \"InterNodeV1LL\"),","+        (\"mori\", True, 257, \"InterNodeV1\"),","+        (\"mori_high_throughput\", True, 128, \"InterNodeV1\"),","+        (\"mori_low_latency\", True, 4096, \"InterNodeV1LL\"),","+    ],","+)","+def test_mori_epv1_kernel_choice(monkeypatch, backend, internode, max_tokens, kernel):","+    from vllm.distributed.device_communicators import all2all","+","+    kernel_types = SimpleNamespace(","+        IntraNode=\"IntraNode\", InterNodeV1=\"InterNodeV1\", InterNodeV1LL=\"InterNodeV1LL\"","+    )","+    fake_mori = SimpleNamespace(","+        ops=SimpleNamespace(EpDispatchCombineKernelType=kernel_types)","+    )","+    monkeypatch.setitem(sys.modules, \"mori\", fake_mori)","+    monkeypatch.setitem(","+        sys.modules,","+        \"vllm.platforms.rocm\",","+        SimpleNamespace(on_gfx942=lambda: False, on_gfx950=lambda: True),","+    )","+    monkeypatch.delenv(","+        \"VLLM_MORI_DISPATCH_INTER_KERNEL_SWITCH_THRESHOLD\", raising=F