{"id":"GHSA-v859-c572-qh5p","axis":"advisories","repo":"zitadel/zitadel","sha":"9d60e83d6faa5e7e7a5339e031cdb26e0efe4d59","parsed":{"files":[{"path":"cmd/setup/73.go","lines":["@@ -0,0 +1,134 @@","+package setup","+","+import (","+\t\"context\"","+\t_ \"embed\"","+\t\"fmt\"","+","+\t\"github.com/zitadel/zitadel/backend/v3/instrumentation/logging\"","+\t\"github.com/zitadel/zitadel/internal/api/authz\"","+\t\"github.com/zitadel/zitadel/internal/database\"","+\t\"github.com/zitadel/zitadel/internal/eventstore\"","+\t\"github.com/zitadel/zitadel/internal/eventstore/handler/v2\"","+\t\"github.com/zitadel/zitadel/internal/query/projection\"","+\t\"github.com/zitadel/zitadel/internal/repository/instance\"","+\t\"github.com/zitadel/zitadel/internal/repository/usergrant\"","+)","+","+var (","+\t//go:embed 73.sql","+\tfixUserGrantRoles string","+)","+","+// FixUserGrantRoles repairs grant-based user grants that kept roles which","+// should have been cascade-removed (GHSA-v859-c572-qh5p). Only grant-based","+// user grants (ug.grant_id set) are in scope: the bug can only manifest via","+// ChangeProjectGrant's multi-role cascade to those grants (see 73.sql for","+// details), so direct user grants are intentionally left untouched even if","+// their roles also happen to mismatch, since that mismatch would be unrelated","+// pre-existing data drift, not this CVE. The corruption lives in the","+// eventstore event payloads, so we fix the source of truth by pushing a","+// corrective user.grant.cascade.changed event with the reconciled role set,","+// then let the projection catch up.","+type FixUserGrantRoles struct {","+\teventstore *eventstore.Eventstore","+}","+","+func (mig *FixUserGrantRoles) Execute(ctx context.Context, _ eventstore.Event) error {","+\tinstances, err := mig.eventstore.InstanceIDs(","+\t\tctx,","+\t\teventstore.NewSearchQueryBuilder(eventstore.ColumnsInstanceIDs).","+\t\t\tOrderDesc().","+\t\t\tAddQuery().","+\t\t\tAggregateTypes(instance.AggregateType).","+\t\t\tEventTypes(instance.InstanceAddedEventType).","+\t\t\tBuilder().ExcludeAggregateIDs().","+\t\t\tAggregateTypes(instance.AggregateType).","+\t\t\tEventTypes(instance.InstanceRemovedEventType).","+\t\t\tBuilder(),","+\t)","+\tif err != nil {","+\t\treturn err","+\t}","+","+\tctx = authz.SetCtxData(ctx, authz.CtxData{UserID: \"SETUP\"})","+\tfor i, instanceID := range instances {","+\t\tctx = authz.WithInstanceID(ctx, instanceID)","+\t\tlogging.Info(ctx, \"fix user grant roles\", \"instance\", instanceID, \"migration\", mig.String(), \"progress\", fmt.Sprintf(\"%d/%d\", i+1, len(instances)))","+","+\t\t// The finder reads projection tables, which may not yet be populated during","+\t\t// setup. Bring the sources up to date for this instance before querying.","+\t\tfor _, source := range []*handler.Handler{","+\t\t\tprojection.ProjectGrantProjection,","+\t\t\tprojection.UserGrantProjection,","+\t\t} {","+\t\t\tif _, err = source.Trigger(ctx); err != nil {","+\t\t\t\treturn err","+\t\t\t}","+\t\t}","+","+\t\tfixedCount, err := mig.fixInstanceUserGrants(ctx, instanceID)","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\tif fixedCount == 0 {","+\t\t\tcontinue","+\t\t}","+\t\tlogging.Info(ctx, \"fixed user grant roles\", \"instance\", instanceID, \"migration\", mig.String(), \"grantsFixed\", fixedCount)","+\t\t// Reflect the corrective events we just pushed in the read model.","+\t\t_, err = projection.UserGrantProjection.Trigger(ctx)","+\t\tlogging.OnError(ctx, err).Debug(\"failed triggering user grant projection to update roles\")","+\t}","+\treturn nil","+}","+","+func (mig *FixUserGrantRoles) fixInstanceUserGrants(ctx context.Context, instanceID string) (fixedCount int, err error) {","+\tvar correctedGrants []eventstore.Command","+","+\ttx, err := mig.eventstore.Client().BeginTx(ctx, nil)","+\tif err != nil {","+\t\treturn 0, err","+\t}","+\tdefer func() {","+\t\tif err != nil {","+\t\t\t_ = tx.Rollback()","+\t\t\treturn","+\t\t}","+\t\terr = tx.Commit()","+\t}()","+","+\trows, err := tx.QueryContext(ctx, fixUserGrantRoles, instanceID)","+\tif err != nil {","+\t\treturn 0, err","+\t}","+\tdefer rows.Close()","+","+\tfor rows.Next() {","+\t\tvar (","+\t\t\tid            string","+\t\t\tresourceOwner string","+\t\t\tcorrectRoles  = database.TextArray[string]{}","+\t\t)","+\t\tif err := rows.Scan(&id, &resourceOwner, &correctRoles); err != nil {","+\t\t\treturn 0, err","+\t\t}","+\t\taggregate := &eventstore.Aggregate{","+\t\t\tID:            id,","+\t\t\tType:          usergrant.AggregateType,","+\t\t\tVersion:       usergrant.AggregateVersion,","+\t\t\tResourceOwner: resourceOwner,","+\t\t\tInstanceID:    instanceID,","+\t\t}","+\t\tcorrectedGrants = append(correctedGrants, usergrant.NewUserGrantCascadeChangedEvent(ctx, aggregate, correctRoles))","+\t}","+\tif rows.Err() != nil {","+\t\treturn 0, rows.Err()","+\t}","+","+\t_, err = mig.eventstore.PushWithClient(ctx, tx, correctedGrants...)","+\treturn len(correctedGrants), err","+}","+","+func (*FixUserGrantRoles) String() string {","+\treturn \"73_fix_user_grant_roles\"","+}"],"additions":134,"deletions":0,"truncated":false},{"path":"cmd/setup/73.sql","lines":["@@ -0,0 +1,39 @@","+-- Finds user grants whose stored roles include roles that are no longer valid","+-- (the residue left by the buggy cascade removal, GHSA-v859-c572-qh5p), and","+-- returns the corrected role set for each. $1 = instance_id, run once per instance.","+--","+-- Scope: only grant-based user grants (ug.grant_id set) can be affected by this","+-- bug. It was introduced by ChangeProjectGrant (internal/command/project_grant.go),","+-- which cascades a *multi*-role removal to the user grants tied to that project","+-- grant. Direct user grants never go through a multi-role removal call, so any","+-- role mismatch there is unrelated to this CVE (e.g. pre-existing role_key drift)","+-- and must not be \"fixed\" here to avoid stripping unrelated, legitimate roles.","+WITH computed AS (","+    SELECT","+        ug.id,","+        ug.resource_owner,","+        ug.roles AS current_roles,","+        -- Recompute the roles this grant is actually allowed to keep by filtering","+        -- its current roles down to the ones still granted by the project grant.","+        COALESCE(","+            ARRAY(","+                SELECT r","+                FROM unnest(ug.roles) AS r          -- expand the stored roles array","+                WHERE r = ANY(pg.granted_role_keys)","+            ),","+            ARRAY[]::TEXT[]                          -- keep NULL out; use empty array","+        ) AS valid_roles","+    FROM projections.user_grants5 ug","+    JOIN projections.project_grants4 pg","+        ON pg.instance_id = ug.instance_id","+       AND pg.grant_id = ug.grant_id","+    WHERE ug.instance_id = $1","+      AND ug.grant_id IS NOT NULL AND ug.grant_id <> ''  -- direct grants are out of scope, see above","+      AND ug.roles IS NOT NULL","+      AND cardinality(ug.roles) > 0                 -- nothing to correct on empty grants","+)","+-- valid_roles is always a subset of current_roles, so a size mismatch means at","+-- least one stale role was dropped -> this grant needs a corrective event.","+SELECT id, resource_owner, valid_roles","+FROM computed","+WHERE cardinality(valid_roles) <> cardinality(current_roles);"],"additions":39,"deletions":0,"truncated":false},{"path":"cmd/setup/config.go","lines":["@@ -192,6 +192,7 @@ type Steps struct {"," \ts70AddEventStoreCommandEnforceOwner     *AddEventStoreCommandEnforceOwnerColumn"," \ts71JWTProvideAddAudienceColumn          *JWTProvideAddAudienceColumn"," \ts72AddColumnsToLoginNamesView           *AddColumnsToLoginNamesView","+\ts73FixUserGrantRoles                    *FixUserGrantRoles"," \tRelationalTables                        *TransactionalTables"," }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"cmd/setup/setup.go","lines":["@@ -255,6 +255,7 @@ func Setup(ctx context.Context, config *Config, steps *Steps, masterKey string)"," \tsteps.s70AddEventStoreCommandEnforceOwner = &AddEventStoreCommandEnforceOwnerColumn{dbClient: dbClient}"," \tsteps.s71JWTProvideAddAudienceColumn = &JWTProvideAddAudienceColumn{dbClient: dbClient}"," \tsteps.s72AddColumnsToLoginNamesView = &AddColumnsToLoginNamesView{dbClient: dbClient}","+\tsteps.s73FixUserGrantRoles = &FixUserGrantRoles{eventstore: eventstoreClient}"," "," \terr = projection.Create(ctx, dbClient, eventstoreClient, config.Projections, nil, nil, nil)"," \tif err != nil {","@@ -380,6 +381,7 @@ func Setup(ctx context.Context, config *Config, steps *Steps, masterKey string)"," \t\tsteps.s68TargetAddPayloadTypeColumn,"," \t\tsteps.s71JWTProvideAddAudienceColumn,"," \t\tsteps.s72AddColumnsToLoginNamesView,","+\t\tsteps.s73FixUserGrantRoles,"," \t} {"," \t\tsetupErr = executeMigration(ctx, eventstoreClient, step, \"migration failed\")"," \t\tif setupErr != nil {"],"additions":2,"deletions":0,"truncated":false},{"path":"internal/api/grpc/management/integration_test/user_grant_test.go","lines":["@@ -0,0 +1,117 @@","+//go:build integration","+","+package management_test","+","+import (","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/zitadel/zitadel/internal/integration\"","+\tmgmt_pb \"github.com/zitadel/zitadel/pkg/grpc/management\"","+)","+","+// PoC for GHSA-v859-c572-qh5p","+//","+// Updating a project grant to drop roles cascades into the user grants of that","+// grant via removeRoleFromUserGrant (internal/command/user_grant.go), which","+// removes the dropped roles in a single call. Because that loop mutates the","+// slice while iterating forward, two *adjacent* removed roles cause the second to be","+// skipped: the user keeps authorisation that should have been revoked.","+//","+// Here a user grant holds [\"admin\",\"viewer\",\"editor\"]; the project grant is","+// updated to keep only [\"editor\"], so \"admin\" and \"viewer\" should both be","+// stripped. The test asserts the CORRECT result ([\"editor\"]); against faulty","+// implementations the grant ends up [\"viewer\",\"editor\"], so it fails.","+func TestServer_UpdateProjectGrant_cascadeRoleRemovalSkipsAdjacent(t *testing.T) {","+\tconst (","+\t\troleAdmin  = \"admin\"","+\t\troleViewer = \"viewer\"","+\t\troleEditor = \"editor\"","+\t)","+","+\t// Org that the project will be granted to.","+\tgrantedOrg := Instance.CreateOrganization(IAMOwnerCTX, integration.OrganizationName(), integration.Email())","+\tgrantedOrgID := grantedOrg.GetOrganizationId()","+\tgrantedOrgCTX := integration.SetOrgID(IAMOwnerCTX, grantedOrgID)","+","+\t// Project (owned by the default org) with three roles, in order.","+\tprojectResp, err := Client.AddProject(OrgCTX, &mgmt_pb.AddProjectRequest{","+\t\tName: integration.ProjectName(),","+\t})","+\trequire.NoError(t, err)","+\tprojectID := projectResp.GetId()","+","+\tfor _, role := range []string{roleAdmin, roleViewer, roleEditor} {","+\t\t_, err = Client.AddProjectRole(OrgCTX, &mgmt_pb.AddProjectRoleRequest{","+\t\t\tProjectId:   projectID,","+\t\t\tRoleKey:     role,","+\t\t\tDisplayName: role,","+\t\t})","+\t\trequire.NoError(t, err)","+\t}","+","+\t// Grant the project (with all three roles) to the granted org.","+\tgrantResp, err := Client.AddProjectGrant(OrgCTX, &mgmt_pb.AddProjectGrantRequest{","+\t\tProjectId:    projectID,","+\t\tGrantedOrgId: grantedOrgID,","+\t\tRoleKeys:     []string{roleAdmin, roleViewer, roleEditor},","+\t})","+\trequire.NoError(t, err)","+\tgrantID := grantResp.GetGrantId()","+","+\t// A user in the granted org, holding all three roles on the project grant.","+\tuserResp := Instance.CreateHumanUserVerified(IAMOwnerCTX, grantedOrgID, integration.Email(), \"+41791234567\")","+\tuserID := userResp.GetUserId()","+","+\tuserGrantResp, err := Client.AddUserGrant(grantedOrgCTX, &mgmt_pb.AddUserGrantRequest{","+\t\tUserId:         userID,","+\t\tProjectId:      projectID,","+\t\tProjectGrantId: grantID,","+\t\tRoleKeys:       []string{roleAdmin, roleViewer, roleEditor},","+\t})","+\trequire.NoError(t, err)","+\tuserGrantID := userGrantResp.GetUserGrantId()","+","+\t// UpdateProjectGrant only cascades to user grants the query side already","+\t// returns, so wait for the projection to catch up to all three roles.","+\tretryDuration, tick := integration.WaitForAndTickWithMaxDuration(CTX, time.Minute)","+\trequire.EventuallyWithT(t, func(ct *assert.CollectT) {","+\t\tgrant, err := Client.GetUserGrantByID(grantedOrgCTX, &mgmt_pb.GetUserGrantByIDRequest{","+\t\t\tUserId:  userID,","+\t\t\tGrantId: userGrantID,","+\t\t})","+\t\tassert.NoError(ct, err)","+\t\tassert.ElementsMatch(ct, []string{roleAdmin, roleViewer, roleEditor}, grant.GetUserGrant().GetRoleKeys())","+\t}, retryDuration, tick)","+","+\t// Drop \"admin\" and \"viewer\" from the project grant, keeping only \"editor\".","+\t// This cascades removeRoleFromUserGrant([\"admin\",\"viewer\"]) into the user grant.","+\t_, err = Client.UpdateProjectGrant(OrgCTX, &mgmt_pb.UpdateProjectGrantRequest{","+\t\tProjectId: projectID,","+\t\tGrantId:   grantID,","+\t\tRoleKeys:  []string{roleEditor},","+\t})","+\trequire.NoError(t, err)","+","+\t// Wait until the cascade has been applied and projected. \"admin\" (the first","+\t// removed role) is dropped by both the buggy and fixed code, so its absence","+\t// is a stable signal that the cascade has converged.","+\tretryDuration, tick = integration.WaitForAndTickWithMaxDuration(CTX, time.Minute)","+\tvar finalRoleKeys []string","+\trequire.EventuallyWithT(t, func(ct *assert.CollectT) {","+\t\tgrant, err := Client.GetUserGrantByID(grantedOrgCTX, &mgmt_pb.GetUserGrantByIDRequest{","+\t\t\tUserId:  userID,","+\t\t\tGrantId: userGrantID,","+\t\t})","+\t\tassert.NoError(ct, err)","+\t\tfinalRoleKeys = grant.GetUserGrant().GetRoleKeys()","+\t\tassert.NotContains(ct, finalRoleKeys, roleAdmin)","+\t}, retryDuration, tick)","+","+\t// Correct expectation: only \"editor\" survives. With the off-by-one bug the","+\t// user grant is [\"viewer\",\"editor\"] — \"viewer\" was skipped during removal.","+\tassert.ElementsMatch(t, []string{roleEditor}, finalRoleKeys)","+}"],"additions":117,"deletions":0,"truncated":false},{"path":"internal/command/project_role.go","lines":["@@ -193,7 +193,7 @@ func (c *Commands) RemoveProjectRole(ctx context.Context, projectID, key, resour"," \t}"," "," \tfor _, grantID := range cascadeUserGrantIDs {","-\t\tevent, err := c.removeRoleFromUserGrant(ctx, grantID, []string{key}, true)","+\t\tevent, err := c.removeRoleFromUserGrant(ctx, grantID, map[string]bool{key:true}, true)"," \t\tif err != nil {"," \t\t\tlogging.LogWithFields(\"COMMAND-mK0of\", \"usergrantid\", grantID).WithError(err).Warn(\"could not cascade remove role on user grant\")"," \t\t\tcontinue"],"additions":1,"deletions":1,"truncated":false},{"path":"internal/command/user_grant.go","lines":["@@ -111,7 +111,7 @@ func (c *Commands) ChangeUserGrant(ctx context.Context, userGrant *domain.UserGr"," \treturn userGrantWriteModelToUserGrant(existingUserGrant), nil"," }"," ","-func (c *Commands) removeRoleFromUserGrant(ctx context.Context, userGrantID string, roleKeys []string, cascade bool) (_ eventstore.Command, err error) {","+func (c *Commands) removeRoleFromUserGrant(ctx context.Context, userGrantID string, roleKeysToRemove map[string]bool, cascade bool) (_ eventstore.Command, err error) {"," \texistingUserGrant, err := c.userGrantWriteModelByID(ctx, userGrantID, \"\")"," \tif err != nil {"," \t\treturn nil, err","@@ -119,21 +119,16 @@ func (c *Commands) removeRoleFromUserGrant(ctx context.Context, userGrantID stri"," \tif existingUserGrant.State == domain.UserGrantStateUnspecified || existingUserGrant.State == domain.UserGrantStateRemoved {"," \t\treturn nil, zerrors.ThrowNotFound(nil, \"COMMAND-3M9sd\", \"Errors.UserGrant.NotFound\")"," \t}","-\tkeyExists := false","-\tfor i, key := range existingUserGrant.RoleKeys {","-\t\tfor _, roleKey := range roleKeys {","-\t\t\tif key == roleKey {","-\t\t\t\tkeyExists = true","-\t\t\t\tcopy(existingUserGrant.RoleKeys[i:], existingUserGrant.RoleKeys[i+1:])","-\t\t\t\texistingUserGrant.RoleKeys[len(existingUserGrant.RoleKeys)-1] = \"\"","-\t\t\t\texistingUserGrant.RoleKeys = existingUserGrant.RoleKeys[:len(existingUserGrant.RoleKeys)-1]","-\t\t\t\tcontinue","-\t\t\t}","-\t\t}","-\t}","-\tif !keyExists {","+\t","+\tbeforeLen := len(existingUserGrant.RoleKeys)","+\texistingUserGrant.RoleKeys = slices.DeleteFunc(existingUserGrant.RoleKeys, func(role string) bool {","+\t\treturn roleKeysToRemove[role]","+\t})","+","+\tif beforeLen == len(existingUserGrant.RoleKeys) {"," \t\treturn nil, zerrors.ThrowPreconditionFailed(nil, \"COMMAND-5m8g9\", \"Errors.UserGrant.RoleKeyNotFound\")"," \t}","+"," \tchangedUserGrant := NewUserGrantWriteModel(userGrantID, existingUserGrant.ResourceOwner)"," \tuserGrantAgg := UserGrantAggregateFromWriteModel(&changedUserGrant.WriteModel)"," "],"additions":9,"deletions":14,"truncated":false},{"path":"internal/command/user_grant_test.go","lines":["@@ -6,6 +6,7 @@ import ("," \t\"testing\""," "," \t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\""," \t\"golang.org/x/text/language\""," "," \t\"github.com/zitadel/zitadel/internal/api/authz\"","@@ -3209,3 +3210,74 @@ func TestCommandSide_BulkRemoveUserGrant(t *testing.T) {"," \t\t})"," \t}"," }","+","+// PoC for GHSA-v859-c572-qh5p","+// Each case asserts the CORRECT post-removal RoleKeys;","+// against faulty implementations these assertions fail.","+func TestCommandSide_removeRoleFromUserGrant(t *testing.T) {","+\tt.Parallel()","+\ttests := []struct {","+\t\tname             string","+\t\texistingRoleKeys []string","+\t\troleKeysToRemove map[string]bool","+\t\twant             []string","+\t}{","+\t\t{","+\t\t\tname:             \"advisory scenario, remove two adjacent leading roles\",","+\t\t\texistingRoleKeys: []string{\"admin\", \"viewer\", \"editor\"},"