, \"expected *usergrant.UserGrantCascadeChangedEvent, got %T\", cmd)","+\t\t\tassert.Equal(t, tt.want, event.RoleKeys)","+\t\t})","+\t}","+}"],"additions":72,"deletions":0,"truncated":false},{"path":"internal/domain/project_grant.go","lines":["@@ -1,6 +1,10 @@"," package domain"," ","-import es_models \"github.com/zitadel/zitadel/internal/eventstore/v1/models\"","+import (","+\t\"slices\"","+","+\tes_models \"github.com/zitadel/zitadel/internal/eventstore/v1/models\"","+)"," "," type ProjectGrant struct {"," \tes_models.ObjectRoot","@@ -34,11 +38,11 @@ func (p *ProjectGrant) IsValid() bool {"," \treturn p.GrantedOrgID != \"\""," }"," ","-func GetRemovedRoles(existingRoles, newRoles []string) []string {","-\tremoved := make([]string, 0)","+func GetRemovedRoles(existingRoles, newRoles []string) map[string]bool {","+\tremoved := make(map[string]bool, 0)"," \tfor _, role := range existingRoles {","-\t\tif !containsRoleKey(role, newRoles) {","-\t\t\tremoved = append(removed, role)","+\t\tif !slices.Contains(newRoles, role) {","+\t\t\tremoved[role] = true"," \t\t}"," \t}"," \treturn removed"],"additions":9,"deletions":5,"truncated":false},{"path":"internal/domain/project_role.go","lines":["@@ -1,6 +1,8 @@"," package domain"," "," import (","+\t\"slices\"","+"," \t\"github.com/zitadel/zitadel/internal/eventstore/v1/models\""," )"," ","@@ -30,18 +32,9 @@ func (p *ProjectRole) IsValid() bool {"," "," func HasInvalidRoles(validRoles, roles []string) bool {"," \tfor _, roleKey := range roles {","-\t\tif !containsRoleKey(roleKey, validRoles) {","-\t\t\treturn true","-\t\t}","-\t}","-\treturn false","-}","-","-func containsRoleKey(roleKey string, validRoles []string) bool {","-\tfor _, validRole := range validRoles {","-\t\tif roleKey == validRole {","+\t\tif !slices.Contains(validRoles, roleKey) {"," \t\t\treturn true"," \t\t}"," \t}"," \treturn false","-}","+}","\\ No newline at end of file"],"additions":4,"deletions":11,"truncated":false},{"path":"internal/domain/user_grant.g