ode","+\t\t\t\t}","+\t\t\t\trequire.Equal(t, http.StatusOK, request(http.MethodGet))","+\t\t\t\trequire.Equal(t, http.StatusOK, request(http.MethodDelete))","+\t\t\t\tif mode == \"local cold cache\" {","+\t\t\t\t\tac.InvalidateResolverCache(1, \"annotations:id:123\")","+\t\t\t\t}","+\t\t\t\trequire.Equal(t, http.StatusNotFound, request(http.MethodGet))","+\t\t\t\trepo.AssertExpectations(t)","+\t\t\t})","+\t\t}","+\t}","+}","+","+func TestAPI_AnnotationScopeResolutionErrors(t *testing.T) {","+\tfor _, legacy := range []bool{false, true} {","+\t\tfor _, tc := range []struct {","+\t\t\tname        string","+\t\t\tmethod      string","+\t\t\tdashboard   string","+\t\t\tlookupErr   error","+\t\t\tpermissions []accesscontrol.Permission","+\t\t\tstatus      int","+\t\t}{","+\t\t\t{","+\t\t\t\tname:        \"missing annotation\",","+\t\t\t\tpermissions: []accesscontrol.Permission{{Action: accesscontrol.ActionAnnotationsRead, Scope: accesscontrol.ScopeAnnotationsTypeOrganization}},","+\t\t\t\tstatus:      http.StatusNotFound,","+\t\t\t},","+\t\t\t{","+\t\t\t\tname:        \"missing annotation on update\",","+\t\t\t\tmethod:      http.MethodPut,","+\t\t\t\tpermissions: []accesscontrol.Permission{{Action: accesscontrol.ActionAnnotationsWrite, Scope: accesscontrol.ScopeAnnotationsTypeOrganization}},","+\t\t\t\tstatus:      http.StatusNotFound,","+\t\t\t},","+\t\t\t{","+\t\t\t\tname:        \"missing annotation on patch\",","+\t\t\t\tmethod:      http.MethodPatch,","+\t\t\t\tpermissions: []accesscontrol.Permission{{Action: accesscontrol.ActionAnnotationsWrite, Scope: accesscontrol.ScopeAnnotationsTypeOrganization}},","+\t\t\t\tstatus:      http.StatusNotFound,","+\t\t\t},","+\t\t\t{","+\t\t\t\tname:        \"missing annotation on delete\",","+\t\t\t\tmethod:      http.MethodDelete,","+\t\t\t\tpermissions: []accesscontrol.Permission{{Action: accesscontrol.ActionAnnotationsDelete, Scope: accesscontrol.ScopeAnnotationsTypeOrganization}},","+\t\t\t\tstatus:      http.StatusNotFound,