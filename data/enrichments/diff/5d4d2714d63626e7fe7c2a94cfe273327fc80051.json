{"id":"5d4d2714d63626e7fe7c2a94cfe273327fc80051","axis":"silent","repo":"expo/expo","sha":"5d4d2714d63626e7fe7c2a94cfe273327fc80051","parsed":{"files":[{"path":".changeset/android-crypto-decryption-length.md","lines":["@@ -0,0 +1,5 @@","+---","+'expo-crypto': patch","+---","+","+[Android] Fix AES-GCM decryption returning extra zero bytes on devices that overestimate the required output size."],"additions":5,"deletions":0,"truncated":false},{"path":"apps/test-suite/tests/CryptoAES.ts","lines":["@@ -166,6 +166,16 @@ export async function test({ describe, it, expect, beforeAll }: JasmineInterface","         expect(areArraysEqual(decrypted, plaintext)).toBe(true);","       });"," ","+      it('preserves the exact plaintext length, including trailing zero bytes', async () => {","+        for (const plaintext of [new Uint8Array(0), new Uint8Array([1, 2, 0, 0])]) {","+          const sealedData = await aesEncryptAsync(plaintext, key);","+          const decrypted = await aesDecryptAsync(sealedData, key);","+","+          expect(decrypted.byteLength).toBe(plaintext.byteLength);","+          expect(areArraysEqual(decrypted, plaintext)).toBe(true);","+        }","+      });","+","       it('encrypts and decrypts ArrayBuffer data', async () => {","         const plaintext = new Uint8Array([9, 10, 11, 12, 13, 14, 15, 16]).buffer;"," "],"additions":10,"deletions":0,"truncated":false},{"path":"packages/expo-crypto/android/src/main/java/expo/modules/crypto/aes/AesCryptoModule.kt","lines":["@@ -137,7 +137,7 @@ class AesCryptoModule : Module() {","       options?.additionalData?.let { cipher.updateAAD(it.toBytes()) }"," ","       val plaintext = cipher.decrypt(sealedData)","-      return plaintext.array().formatted(options?.output)","+      return plaintext.formatted(options?.output)","     } catch (err: Throwable) {","       throw DecryptionFailed(err)","     }"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/expo-crypto/android/src/main/java/expo/modules/crypto/aes/extensions/CipherExtensions.kt","lines":["@@ -14,11 +14,13 @@ internal fun Cipher.encrypt(plaintext: ByteBuffer): SealedData {","   }"," }"," ","-internal fun Cipher.decrypt(sealedData: SealedData): ByteBuffer {","+internal fun Cipher.decrypt(sealedData: SealedData): ByteArray {","   val inputBuf = sealedData.taggedCiphertextBuffer","-  val plaintextSize = getOutputSize(inputBuf.remaining())","-","-  return ByteBuffer.allocate(plaintextSize).also { outputBuf ->","-    doFinal(inputBuf, outputBuf)","+  val output = ByteArray(getOutputSize(inputBuf.remaining()))","+  val written = doFinal(inputBuf, ByteBuffer.wrap(output))","+  return if (written == output.size) {","+    output","+  } else {","+    output.copyOf(written)","   }"," }"],"additions":7,"deletions":5,"truncated":false},{"path":"packages/expo-crypto/android/src/test/java/expo/modules/crypto/aes/extensions/CipherExtensionsTest.kt","lines":["@@ -0,0 +1,88 @@","+package expo.modules.crypto.aes.extensions","+","+import expo.modules.crypto.aes.AesConfig","+import expo.modules.crypto.aes.objects.SealedData","+import org.junit.Assert.assertArrayEquals","+import org.junit.Test","+import java.nio.ByteBuffer","+import java.security.AlgorithmParameters","+import java.security.Key","+import java.security.SecureRandom","+import java.security.spec.AlgorithmParameterSpec","+import javax.crypto.Cipher","+import javax.crypto.CipherSpi","+import javax.crypto.spec.GCMParameterSpec","+import javax.crypto.spec.SecretKeySpec","+","+class CipherExtensionsTest {","+  @Test","+  fun decryptReturnsEmptyPlaintextWhenOutputSizeIsOverestimated() {","+    assertDecryptsTo(byteArrayOf())","+  }","+","+  @Test","+  fun decryptPreservesTrailingZerosWhenOutputSizeIsOverestimated() {","+    assertDecryptsTo(byteArrayOf(1, 2, 0, 0))","+  }","+","+  private fun assertDecryptsTo(plaintext: ByteArray) {","+    val iv = ByteArray(AesConfig.DEFAULT_IV_SIZE)","+    val params = GCMParameterSpec(AesConfig.DEFAULT_TAG_SIZE * Byte.SIZE_BITS, iv)","+    val key = SecretKeySpec(ByteArray(16), AesConfig.CRYPTO_KEY_ALGORITHM)","+","+    val encryptor = Cipher.getInstance(AesConfig.CIPHER_TRANSFORMATION_NAME)","+    encryptor.init(Cipher.ENCRYPT_MODE, key, params)","+    val sealedData = SealedData(iv, encryptor.doFinal(plaintext), AesConfig.DEFAULT_TAG_SIZE)","+","+    val decryptor = OversizedOutputCipher(Cipher.getInstance(AesConfig.CIPHER_TRANSFORMATION_NAME))","+    decryptor.init(Cipher.DECRYPT_MODE, key, params)","+","+    assertArrayEquals(plaintext, decryptor.decrypt(sealedData))","+  }","+","+  private class OversizedOutputCipher(delegate: Cipher) :","+    Cipher(OversizedOutputCipherSpi(delegate), delegate.provider, delegate.algorithm)","+","+  private class OversizedOutputCipherSpi(private val delegate: Cipher) : CipherSpi() {","+    override fun engineGetOutputSize(inputLen: Int): Int =","+      delegate.getOutputSize(inputLen) + AesConfig.DEFAULT_TAG_SIZE","+","+    override fun engineDoFinal(input: ByteBuffer, output: ByteBuffer): Int =","+      delegate.doFinal(input, output)","+","+    override fun engineGetBlockSize(): Int = delegate.blockSize","+","+    override fun engineGetIV(): ByteArray? = delegate.iv","+","+    override fun engineGetParameters(): AlgorithmParameters? = delegate.parameters","+","+    override fun engineInit(opmode: Int, key: Key, random: SecureRandom?) =","+      delegate.init(opmode, key, random)","+","+    override fun engineInit(opmode: Int, key: Key, params: AlgorithmParameterSpec?, random: SecureRandom?) =","+      delegate.init(opmode, key, params, random)","+","+    override fun engineInit(opmode: Int, key: Key, params: AlgorithmParameters?, random: SecureRandom?) =","+      delegate.init(opmode, key, params, random)","+","+    override fun engineUpdate(input: ByteArray, inputOffset: Int, inputLen: Int): ByteArray? =","+      delegate.update(input, inputOffset, inputLen)","+","+    override fun engineUpdate(input: ByteArray, inputOffset: Int, inputLen: Int, output: ByteArray, outputOffset: Int): Int =","+      delegate.update(input, inputOffset, inputLen, output, outputOffset)","+","+    override fun engineDoFinal(input: ByteArray, inputOffset: Int, inputLen: Int): ByteArray =","+      delegate.doFinal(input, inputOffset, inputLen)","+","+    override fun engineDoFinal(input: ByteArray, inputOffset: Int, inputLen: Int, output: ByteArray, outputOffset: Int): Int =","+      delegate.doFinal(input, inputOffset, inputLen, output, outputOffset)","+","+    override fun engineSetMode(mode: String) {","+      throw UnsupportedOperationException()","+    }","+","+    override fun engineSetPadding(padding: String) {","+      throw UnsupportedOperationException()","+    }","+  }","+}",""],"additions":88,"deletions":0,"truncated":false}],"additions":111,"deletions":6,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-26T18:55:26.371385+00:00"}