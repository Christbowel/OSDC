{"id":"ccad1b951347283ce211a66e6253967f6b57c07a","axis":"silent","repo":"openvinotoolkit/openvino","sha":"ccad1b951347283ce211a66e6253967f6b57c07a","parsed":{"files":[{"path":"docs/articles_en/openvino-workflow/running-inference/inference-devices-and-modes/auto-device-selection.rst","lines":["@@ -169,6 +169,9 @@ the following setup options:"," |                                              | Enables/disables CPU as acceleration (or the helper device) in the |"," |                                              | beginning. The default value is ``true``, indicating that CPU is   |"," |                                              | used as acceleration by default.                                   |","+|                                              |                                                                    |","+|                                              | As a trade-off, two model instances will be kept, resulting in     |","+|                                              | additional memory usage of approximately one model’s size.         |"," +----------------------------------------------+--------------------------------------------------------------------+"," | ``ov::intel_auto::enable_runtime_fallback``  | **Values**:                                                        |"," |                                              |                                                                    |","@@ -193,6 +196,42 @@ the following setup options:"," |                                              |                                                                    |"," |                                              | The default value is ``DEVICE_PRIORITY``.                          |"," +----------------------------------------------+--------------------------------------------------------------------+","+| ``ov::intel_auto::compile_for_all``          | **Values**:                                                        |","+|                                              |                                                                    |","+|                                              | ``true``                                                           |","+|                                              |                                                                    |","+|                                              | ``false``                                                          |","+|                                              |                                                                    |","+|                                              | Compiles the model to the remaining candidate devices in the       |","+|                                              | background, after the actual device is ready, to populate cache    |","+|                                              | blobs for faster device switching later. Devices whose cache blob  |","+|                                              | already exists are skipped. CPU candidates are excluded from       |","+|                                              | background pre-compilation.                                        |","+|                                              |                                                                    |","+|                                              | Enabling it disables ``ov::intel_auto::enable_startup_fallback``   |","+|                                              | and ``ov::intel_auto::enable_runtime_fallback``.                   |","+|                                              |                                                                    |","+|                                              | Requires ``ov::cache_dir`` or ``ov::cache_path``. Without them,    |","+|                                              | compiling the model throws on every host.                          |","+|                                              |                                                                    |","+|                                              | Ignored in cumulative throughput mode, when there is no            |","+|                                              | other candidate device to compile, and when ``ov::cache_blob_id``  |","+|                                              | is set for AUTO or for any candidate device.                       |","+|                                              |                                                                    |","+|                                              | A device whose cache path is a single-file cache (``*.bin``) is    |","+|                                              | skipped with a warning.                                            |","+|                                              |                                                                    |","+|                                              | Only the devices listed in ``ov::device::priorities`` or in the    |","+|                                              | device string, for example ``AUTO:GPU,NPU``, are compiled; other   |","+|                                              | available devices are not. With ``AUTO:GPU,NPU``, if GPU becomes   |","+|                                              | actual device, NPU is compiled in the background (and vice versa). |","+|                                              |                                                                    |","+|                                              | Warm-up compiles one device at a time and releases each compiled   |","+|                                              | model right away. The memory needed by the background compilation  |","+|                                              | itself is not included.                                            |","+|                                              |                                                                    |","+|                                              | The default value is ``false``.                                    |","++----------------------------------------------+--------------------------------------------------------------------+"," "," Inference with AUTO is configured similarly to when device plugins are used:"," you compile the model on the plugin with configuration and execute inference."],"additions":39,"deletions":0,"truncated":false},{"path":"src/bindings/c/docs/api_overview.md","lines":["@@ -350,6 +350,7 @@ OPENVINO_C_VAR(const char*) ov_property_key_intel_auto_device_bind_buffer;"," OPENVINO_C_VAR(const char*) ov_property_key_intel_auto_enable_startup_fallback;"," "," OPENVINO_C_VAR(const char*) ov_property_key_intel_auto_enable_runtime_fallback;","+OPENVINO_C_VAR(const char*) ov_property_key_intel_auto_compile_for_all;"," ```"," "," ### GPU plugin specified properties"],"additions":1,"deletions":0,"truncated":false},{"path":"src/bindings/c/include/openvino/c/auto/properties.h","lines":["@@ -31,4 +31,12 @@ ov_property_key_intel_auto_enable_startup_fallback;","  * @ingroup ov_property_c_api","  */"," OPENVINO_C_VAR(const char*)","-ov_property_key_intel_auto_enable_runtime_fallback;","\\ No newline at end of file","+ov_property_key_intel_auto_enable_runtime_fallback;","+","+/**","+ * @brief Read-write property<string> to enable/disable compiling the model to all candidate devices in the","+ * background to populate cache blobs for faster subsequent loading (requires ov::cache_dir or ov::cache_path)","+ * @ingroup ov_property_c_api","+ */","+OPENVINO_C_VAR(const char*)","+ov_property_key_intel_auto_compile_for_all;","\\ No newline at end of file"],"additions":9,"deletions":1,"truncated":false},{"path":"src/bindings/c/src/ov_auto_property.cpp","lines":["@@ -8,3 +8,4 @@"," const char* ov_property_key_intel_auto_device_bind_buffer = \"DEVICE_BIND_BUFFER\";"," const char* ov_property_key_intel_auto_enable_startup_fallback = \"ENABLE_STARTUP_FALLBACK\";"," const char* ov_property_key_intel_auto_enable_runtime_fallback = \"ENABLE_RUNTIME_FALLBACK\";","+const char* ov_property_key_intel_auto_compile_for_all = \"COMPILE_FOR_ALL\";"],"additions":1,"deletions":0,"truncated":false},{"path":"src/bindings/c/tests/ov_auto_property_test.cpp","lines":["@@ -46,6 +46,9 @@ const std::vector<test_params> test_property_config = {","     test_params{\"AUTO\", ov_property_key_intel_auto_enable_runtime_fallback, \"YES\", false},","     test_params{\"AUTO\", ov_property_key_intel_auto_enable_runtime_fallback, \"NO\", false},","     test_params{\"AUTO\", ov_property_key_intel_auto_enable_runtime_fallback, \"TEST\", true},","+    test_params{\"AUTO\", ov_property_key_intel_auto_compile_for_all, \"YES\", false},","+    test_params{\"AUTO\", ov_property_key_intel_auto_compile_for_all, \"NO\", false},","+    test_params{\"AUTO\", ov_property_key_intel_auto_compile_for_all, \"TEST\", true},"," };"," "," INSTANTIATE_TEST_SUITE_P(ov_auto_plugin_test_properties,"],"additions":3,"deletions":0,"truncated":false},{"path":"src/bindings/python/src/pyopenvino/core/properties/properties.cpp","lines":["@@ -340,6 +340,7 @@ void regmodule_properties(py::module m) {","     wrap_property_RW(m_intel_auto, ov::intel_auto::device_bind_buffer, \"device_bind_buffer\");","     wrap_property_RW(m_intel_auto, ov::intel_auto::enable_startup_fallback, \"enable_startup_fallback\");","     wrap_property_RW(m_intel_auto, ov::intel_auto::enable_runtime_fallback, \"enable_runtime_fallback\");","+    wrap_property_RW(m_intel_auto, ov::intel_auto::compile_for_all, \"compile_for_all\");","     wrap_property_RW(m_intel_auto, ov::intel_auto::schedule_policy, \"schedule_policy\");","     wrap_property_RW(m_intel_auto, ov::intel_auto::devices_utilization_threshold, \"devices_utilization_threshold\");","     // perf_curve_table: name/string/map overloads (map form uses pybind11's default STL caster)."],"additions":1,"deletions":0,"truncated":false},{"path":"src/bindings/python/tests/test_runtime/test_properties.py","lines":["@@ -420,6 +420,16 @@ def test_properties_ro(ov_property_ro, expected_value):","                 (0, False),","             ),","         ),","+        (","+            intel_auto.compile_for_all,","+            \"COMPILE_FOR_ALL\",","+            (","+                (True, True),","+                (False, False),","+                (1, True),","+                (0, False),","+            ),","+        ),","         (device.id, \"DEVICE_ID\", ((\"0\", \"0\"),)),","         (","             log.level,"],"additions":10,"deletions":0,"truncated":false},{"path":"src/inference/include/openvino/runtime/auto/properties.hpp","lines":["@@ -30,6 +30,27 @@ static constexpr Property<bool> enable_startup_fallback{\"ENABLE_STARTUP_FALLBACK","  */"," static constexpr Property<bool> enable_runtime_fallback{\"ENABLE_RUNTIME_FALLBACK\"};"," ","+/**","+ * @brief auto device setting that enables compiling the model to the remaining candidate devices in the background,","+ * after the actual device is ready, to populate cache blobs for faster device switching.","+ * Enabling it disables ov::intel_auto::enable_startup_fallback and ov::intel_auto::enable_runtime_fallback.","+ * Requires ov::cache_dir or ov::cache_path, otherwise compiling the model throws on every host. Ignored in","+ * cumulative throughput mode, when there is no other candidate device, and when","+ * ov::cache_blob_id is set. Devices are skipped when the cache path is a single-file cache (*.bin).","+ *","+ * When ov::device::priorities (or a device string such as \"AUTO:GPU,NPU\") is set, it determines the candidates;","+ * otherwise AUTO discovers its usual eligible devices. For example, to warm up the cache for GPU and NPU, so that","+ * the one not selected by AUTO is compiled in the background:","+ * @code","+ * core.compile_model(model,","+ *                    \"AUTO\",","+ *                    ov::device::priorities(\"GPU,NPU\"),","+ *                    ov::cache_dir(\"model_cache\"),","+ *                    ov::intel_auto::compile_for_all(true));","+ * @endcode","+ */","+static constexpr Property<bool> compile_for_all{\"COMPILE_FOR_ALL\"};","+"," /**","  * @brief Enum to define the policy of scheduling inference request to target device in cumulative throughput mode on","  * AUTO"],"additions":21,"deletions":0,"truncated":false},{"path":"src/inference/src/dev/core_impl.hpp","lines":["@@ -272,7 +272,7 @@ class CoreImpl : public ov::ICore, public std::enable_shared_from_this<ov::ICore"," ","     ov::AnyMap create_compile_config(const ov::Plugin& plugin, const ov::AnyMap& orig_config) const;","     ov::AnyMap create_compile_config(const std::string& device_name, const ov::AnyMap& orig_config) const override {","-        return create_compile_config(get_plugin(device_name), orig_config);","+        return create_compile_config(get_plugin(device_name, orig_config), orig_config);","     }"," ","     bool is_hidden_device(const std::string& device_name) const;"],"additions":1,"deletions":1,"truncated":false},{"path":"src/plugins/auto/CMakeLists.txt","lines":["@@ -12,6 +12,7 @@ set(SOURCES","     ${CMAKE_CURRENT_SOURCE_DIR}/src/async_infer_request.cpp","     ${CMAKE_CURRENT_SOURCE_DIR}/src/auto_compiled_model.cpp","     ${CMAKE_CURRENT_SOURCE_DIR}/src/auto_schedule.cpp","+    ${CMAKE_CURRENT_SOURCE_DIR}/src/cache_warmup.cpp","     ${CMAKE_CURRENT_SOURCE_DIR}/src/compiled_model.cpp","     ${CMAKE_CURRENT_SOURCE_DIR}/src/cumulative_compiled_model.cpp","     ${CMAKE_CURRENT_SOURCE_DIR}/src/cumulative_schedule.cpp"],"additions":1,"deletions":0,"truncated":false},{"path":"src/plugins/auto/src/auto_schedule.cpp","lines":["@@ -3,13 +3,14 @@"," //"," "," ///////////////////////////////////////////////////////////////////////////////////////////////////","+#include <algorithm>","+#include <chrono>","+"," #include \"auto_schedule.hpp\""," "," #include <stdexcept>"," "," #include \"async_infer_request.hpp\"","-#include \"openvino/runtime/compilation_context.hpp\"","-#include \"openvino/util/file_util.hpp\""," #include \"plugin.hpp\""," "," // ------------------------------AutoSchedule----------------------------","@@ -124,9 +125,6 @@ void AutoSchedule::init() {","     // loadContext[ACTUALDEVICE] is always enabled,","     // when there is CPU and there are more than two devices, loadContext[CPU] is enabled","     m_compile_context[ACTUALDEVICE].m_is_enabled = true;","-    if (m_context->m_runtime_fallback) {","-        m_compile_context[FALLBACKDEVICE].m_is_enabled = true;","-    }","     m_compile_context[ACTUALDEVICE].m_model_precision = m_context->m_model_precision;","     m_compile_context[ACTUALDEVICE].m_meta_devices = m_context->m_device_priorities;","     m_compile_context[ACTUALDEVICE].m_device_info =","@@ -139,6 +137,31 @@ void AutoSchedule::init() {","         // nothing was reserved by select_device() in this mode","         m_compile_context[ACTUALDEVICE].m_priority_released = true;","     }","+    if (m_context->m_compile_for_all) {","+        const auto& actual_device = m_compile_context[ACTUALDEVICE].m_device_info.device_name;","+        const auto& candidates = m_compile_context[ACTUALDEVICE].m_meta_devices;","+        const bool has_warmup_candidate = std::any_of(candidates.begin(), candidates.end(), [&](const auto& device) {","+            return device.device_name != actual_device && ov::DeviceIDParser(device.device_name).get_device_name() != \"CPU\";","+        });","+        if (!has_warmup_candidate) {","+            LOG_WARNING_TAG(\"compile_for_all is ignored: no other non-CPU candidate device to compile\");","+            m_context->m_compile_for_all = false;","+        } else {","+            // Fallbacks switch devices non-deterministically and would overlap with the background warm-up.","+            LOG_INFO_TAG(\"compile_for_all disables startup and runtime fallback\");","+            m_context->m_startup_fallback = false;","+            m_context->m_runtime_fallback = false;","+            // Capture before the actual-device task releases the model.","+            m_cache_warmup = std::make_shared<CacheWarmup>(m_plugin->get_cache_warmup_manager(),","+                                                           m_context->m_ov_core,","+                                                           m_context->m_model,","+                                                           m_context->m_model_path,","+                                                           get_log_tag());","+        }","+    }","+    if (m_context->m_runtime_fallback) {","+        m_compile_context[FALLBACKDEVICE].m_is_enabled = true;","+    }"," ","     auto load_device_task = [&](AutoCompileContext* context_ptr, const std::shared_ptr<ov::Model>& model) {","         try_to_compile_model(*context_ptr, model);","@@ -350,6 +373,12 @@ void AutoSchedule::init() {","         }","     }","     m_context->m_hw_compiled_model = wait_first_compiled_model_ready();","+    // compile_for_all disables the CPU helper, so the warm-up can start as soon as the actual device is ready.","+    if (m_cache_warmup && m_compile_context[ACTUALDEVICE].m_is_already) {","+        // Failed startup devices were already removed from the actual context's candidates.","+        m_cache_warmup->start(m_compile_context[ACTUALDEVICE].m_device_info.device_name,","+                              m_compile_context[ACTUALDEVICE].m_meta_devices);","+    }"," }"," "," void AutoSchedule::try_to_compile_model(AutoCompileContext& context, const std::shared_ptr<ov::Model>& model) {","@@ -455,9 +484,9 @@ void AutoSchedule::try_to_compile_model(AutoCompileContext& context, const std::","         }","     }","     // if the select device is CPU, need to check the config of m_compile_context[CPU]","-    // if they are same, do not need to compile again","+    // if they are same, do not need to compile again (only when the CPU helper is enabled)","     cur_dev_is_cpu = (context.m_device_info.device_name.find(\"CPU\") != std::string::npos);","-    if (cur_dev_is_cpu) {","+    if (cur_dev_is_cpu && m_compile_context[CPU].m_is_enabled) {","         auto compare = [](ov::AnyMap& a, ov::AnyMap& b) -> bool {","             if (a.size() != b.size()) {","                 return false;","@@ -878,6 +907,10 @@ AutoSchedule::~AutoSchedule() {","         m_plugin->get_executor_manager()->clear(\"AutoDeviceAsyncCompile\");","         m_executor.reset();","     }","+    // After the recycle task has stopped, so no new warm-up can be queued.","+    if (m_cache_warmup) {","+        m_cache_warmup->stop();","+    }","     if (m_plugin && !m_context->m_dynamic_device_selection) {","         m_plugin->unregister_priority(m_context->m_model_priority,","                                       m_compile_context[ACTUALDEVICE].m_device_info.unique_name);"],"additions":40,"deletions":7,"truncated":false},{"path":"src/plugins/auto/src/auto_schedule.hpp","lines":["@@ -10,6 +10,7 @@"," "," #include \"schedule.hpp\""," #include \"async_infer_request.hpp\"","+#include \"cache_warmup.hpp\""," "," namespace ov {"," namespace auto_plugin {","@@ -36,6 +37,8 @@ class AutoSchedule : public Schedule {","     SoCompiledModel wait_first_compiled_model_ready() override;","     void try_to_compile_model(AutoCompileContext& context, const std::shared_ptr<ov::Model>& model) override;","     bool select_other_device(const std::string& cur_dev_name) override;","+    // Null unless ov::intel_auto::compile_for_all is enabled; set before any background task starts.","+    std::shared_ptr<CacheWarmup>                                         m_cache_warmup;","     void release_execution_slot() override;","     /**","      * @brief Serialize the incoming request behind the execution gate when per inference device selection is on."],"additions":3,"deletions":0,"truncated":false},{"path":"src/plugins/auto/src/cache_warmup.cpp","lines":["@@ -0,0 +1,297 @@","+// Copyright (C) 2018-2026 Intel Corporation","+// SPDX-License-Identifier: Apache-2.0","+//","+","+#include \"cache_warmup.hpp\"","+","+#include <algorithm>","+#include <chrono>","+#include <map>","+#include <optional>","+","+#include \"openvino/runtime/compilation_context.hpp\"","+#include \"openvino/runtime/device_id_parser.hpp\"","+#include \"openvino/runtime/intel_gpu/properties.hpp\"","+#include \"openvino/util/container_util.hpp\"","+#include \"openvino/util/file_util.hpp\"","+","+namespace ov {","+namespace auto_plugin {","+namespace {","+// Core keeps all blobs of a *.bin cache path in one archive. Its writes are only locked per blob ID, so a background","+// warm-up must not write into it concurrently with other compilations.","+bool is_single_file_cache(const std::filesystem::path& cache_location) {","+    std::error_code ec;","+    const auto status = std::filesystem::status(cache_location, ec);","+    if (!ec && std::filesystem::exists(status)) {","+        return !std::filesystem::is_directory(status);","+    }","+    // Core creates the cache directory on the first write and picks the storage by extension until then.","+    return cache_location.extension() == \".bin\";","+}","+","+// Core moves the ID of e.g. \"GPU.1\" into ov::device::id, so the cache key must be built for that device instance.","+ov::AnyMap create_compile_config(const ov::ICore& core, const std::string& device_name, const ov::AnyMap& config) {","+    const ov::DeviceIDParser parser(device_name);","+    auto device_config = config;","+    if (!parser.get_device_id().empty()) {","+        device_config.emplace(ov::device::id.name(), parser.get_device_id());","+    }","+    return core.create_compile_config(parser.get_device_name(), device_config);","+}","+","+// Keys are compared as strings, like the cache hash does: ov::Any::operator== throws for values such as ov::device::UUID.","+std::map<std::string, std::string> get_cache_key(const ov::ICore& core,","+                                                 const std::string& device_name,","+                                                 const ov::AnyMap& config) {","+    std::map<std::string, std::string> key;","+    for (const auto& [name, value] : create_compile_config(core, device_name, config)) {","+        key.emplace(name, value.as<std::string>());","+    }","+    return key;","+}","+","+// Lowers the host-side cost of the background compilation without changing the cache key.","+ov::AnyMap make_warmup_config(const ov::ICore& core, const DeviceInformation& device) {","+    std::vector<ov::PropertyName> supported;","+    try {","+        supported = core.get_property(device.device_name, ov::supported_properties);","+    } catch (const ov::Exception&) {","+        return device.config;","+    }","+    auto config = device.config;","+    if (ov::util::contains(supported, ov::intel_gpu::hint::host_task_priority.name())) {","+        config.emplace(ov::intel_gpu::hint::host_task_priority(ov::hint::Priority::LOW));","+    }","+    if (ov::util::contains(supported, ov::compilation_num_threads.name())) {","+        config.emplace(ov::compilation_num_threads(std::max(1, static_cast<int>(std::thread::hardware_concurrency()) / 4)));","+    }","+    if (config.size() == device.config.size()) {","+        return config;","+    }","+    if (get_cache_key(core, device.device_name, config) != get_cache_key(core, device.device_name, device.config)) {","+        return device.config;","+    }","+    return config;","+}","+}  // namespace","+","+// The caller may modify its model once compile_model() returns, so warm-up works on a private clone; a clone failure","+// propagates to the caller.","+CacheWarmup::CacheWarmup(CacheWarmupManager& manager,","+                         std::weak_ptr<ov::ICore> core,","+                         std::shared_ptr<const ov::Model> model,","+                         std::filesystem::path model_path,","+                         std::string log_tag)","+    : m_manager(manager),","+      m_core(std::move(core)),","+      m_model(model ? model->clone() : nullptr),","+      m_model_path(std::move(model_path)),","+      m_log_tag(std::move(log_tag)) {}","+","+const std::string& CacheWarmup::get_log_tag() const noexcept {","+    return m_log_tag;","+}","+","+void CacheWarmup::start(const std::string& actual_device, const std::vector<DeviceInformation>& candidates) {","+    std::vector<DeviceInformation> devices;","+    for (const auto& device : candidates) {","+        if (device.device_name != actual_device && ov::DeviceIDParser(device.device_name).get_device_name() != \"CPU\") {","+            devices.push_back(device);","+        }","+    }","+    {","+        std::lock_guard<std::mutex> lock(m_mutex);","+        if (m_state != State::Created) {","+            return;","+        }","+        if (devices.empty() || (!m_model && m_model_path.empty())) {","+            m_model.reset();","+            m_state = State::Done;","+            return;","+        }","+        m_state = State::Idle;","+        m_devices = std::move(devices);","+        LOG_INFO_TAG(\"start cache pre-compilation for %zu device(s)\", m_devices.size());","+    }","+    m_manager.enqueue(shared_from_this());","+}","+","+void CacheWarmup::request_stop_unsafe() {","+    m_model.reset();","+    if (m_state == State::Compiling) {","+        m_state = State::Stopping;","+    } else if (m_state != State::Stopping) {","+        m_state = State::Stopped;","+    }","+}","+","+void CacheWarmup::stop() {","+    std::unique_lock<std::mutex> lock(m_mutex);","+    request_stop_unsafe();","+    m_cv.wait(lock, [this] {","+        return m_state != State::Stopping;","+    });","+}","+","+void CacheWarmup::run() {","+    std::shared_ptr<const ov::Model> model;","+    std::vector<DeviceInformation> devices;","+    {","+        std::lock_guard<std::mutex> lock(m_mutex);","+        model = std::move(m_model);","+        devices = std::move(m_devices);","+    }","+    for (const auto& device : devices) {","+        {","+            std::lock_guard<std::mutex> lock(m_mutex);","+            if (m_state != State::Idle) {","+                return;","+            }","+            m_state = State::Compiling;","+        }","+        const auto begin = std::chrono::steady_clock::now();","+        try {","+            if (auto core = m_core.lock()) {","+                const auto config = make_warmup_config(*core, device);","+                const auto cache_location =","+                    CacheWarmupManager::get_cache_location(*core, config, device.device_name);","+                if (cache_location.empty()) {","+                    LOG_INFO_TAG(\"cache pre-compilation skipped for device: %s, caching is disabled for it\",","+                                 device.device_name.c_str());","+                } else if (is_single_file_cache(cache_location)) {","+                    LOG_WARNING_TAG(\"cache pre-compilation skipped for device: %s, single-file cache %s is not \"","+                                    \"supported\",","+                                    device.device_name.c_str(),","+                                    cache_location.string().c_str());","+                } else {","+                    // The compiled model is dropped on purpose: Core writes the cache blob as a side effect.","+                    if (model) {","+                        core->compile_model(model, device.device_name, config);","+                    } else {","+                        core->compile_model(m_model_path, device.device_name, config);","+                    }","+                    LOG_INFO_TAG(\"cache pre-compilation finished for device: %s, compile time: %lf ms\",","+                                 device.device_name.c_str(),","+                                 std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin)","+                                     .count());","+                }","+            }","+        } catch (const std::exception& e) {","+            LOG_WARNING_TAG(\"cache pre-compilation failed for device: %s, %s\", device.device_name.c_str(), e.what());","+        } catch (...) {","+            LOG_WARNING_TAG(\"cache pre-compilation failed for device: %s, unknown exception\",","+                            device.device_name.c_str());","+        }","+        {","+            std::lock_guard<std::mutex> lock(m_mutex);","+            m_state = m_state == State::Stopping ? State::Stopped : State::Idle;","+        }","+        m_cv.notify_all();","+    }","+    std::lock_guard<std::mutex> lock(m_mutex);","+    if (m_state == State::Idle) {","+        m_state = State::Done;","+    }","+}","+","+CacheWarmupManager::~CacheWarmupManager() {","+    {","+        std::lock_guard<std::mutex> lock(m_mutex);","+        m_stop = true;","+    }","+    m_cv.notify_all();","+    if (m_worker.joinable()) {","+        m_worker.join();","+    }","+}","+","+void CacheWarmupManager::enqueue(std::shared_ptr<CacheWarmup> warmup) {","+    {","+        std::lock_guard<std::mutex> lock(m_mutex);","+        if (!m_worker.joinable()) {","+            m_worker = std::thread([this] {","+                worker_loop();","+            });","+        }","+        m_queue.push_back(std::move(warmup));","+    }","+    m_cv.notify_one();","+}","+","+void CacheWarmupManager::worker_loop() {","+    while (true) {","+        std::shared_ptr<CacheWarmup> warmup;","+        {","+            std::unique_lock<std::mutex> lock(m_mutex);","+            m_cv.wait(lock, [this] {","+                return m_stop || !m_queue.empty();","+            });","+            if (m_stop) {","+                return;","+            }","+            warmup = std::move(m_queue.front());","+            m_queue.pop_front();","+        }","+        warmup->run();","+    }","+}","+","+std::filesystem::path CacheWarmupManager::get_cache_location(const ov::ICore& core,","+                                                             const ov::AnyMap& config,","+                                                             const std::string& devi