{"id":"dfc63adfbf38ea8a70e9c710ccc56be260a4793a","axis":"silent","repo":"microsoft/DeepSpeed","sha":"dfc63adfbf38ea8a70e9c710ccc56be260a4793a","parsed":{"files":[{"path":"deepspeed/ops/transformer/transformer.py","lines":["@@ -140,12 +140,19 @@ def from_json_file(cls, json_file):","         return cls.from_dict(json.loads(text))"," "," ","+def _validate_stochastic_mode(config):","+    if config.stochastic_mode and torch.are_deterministic_algorithms_enabled():","+        raise RuntimeError(\"Deterministic execution requires stochastic_mode=False for DeepSpeedTransformerLayer\")","+","+"," class DeepSpeedTransformerFunction(Function):"," ","     @staticmethod","     def forward(ctx, input, input_mask, self, grads, layer_id, attn_qkvw, attn_qkvb, attn_ow, attn_ob, attn_nw,","                 attn_nb, inter_w, inter_b, output_w, output_b, norm_w, norm_b, config):"," ","+        # Engines can enable deterministic execution after the layer was constructed.","+        _validate_stochastic_mode(config)","         cuda_module = stochastic_transformer_cuda_module if config.stochastic_mode else transformer_cuda_module","         forward_func = cuda_module.forward_fp16 if config.fp16 else cuda_module.forward_fp32"," ","@@ -249,6 +256,7 @@ def backward(ctx, grad_output):","             (output, input, input_mask, attn_qkvw, attn_qkvb, attn_ow, attn_ob, attn_nw, attn_nb, inter_w, inter_b,","              output_w, output_b, norm_w, norm_b) = ctx.saved_tensors"," ","+        _validate_stochastic_mode(ctx.config)","         cuda_module = stochastic_transformer_cuda_module if ctx.config.stochastic_mode else transformer_cuda_module","         backward_func = cuda_module.backward_fp16 if ctx.config.fp16 else cuda_module.backward_fp32"," ","@@ -311,6 +319,7 @@ class DeepSpeedTransformerLayer(nn.Module):","     def __init__(self, config, initial_weights=None, initial_biases=None):","         super(DeepSpeedTransformerLayer, self).__init__()"," ","+        _validate_stochastic_mode(config)","         self.config = config","         self.config.layer_id = DeepSpeedTransformerLayer.layer_id","         DeepSpeedTransformerLayer.layer_id = DeepSpeedTransformerLayer.layer_id + 1"],"additions":9,"deletions":0,"truncated":false},{"path":"deepspeed/ops/triton_ops/group_gemm_triton.py","lines":["@@ -86,6 +86,7 @@ def _group_gemm_kernel(","         stride_om,","         stride_on,","         NUM_GROUPS: tl.constexpr,","+        USE_IEEE: tl.constexpr,","         BLOCK_M: tl.constexpr,","         BLOCK_N: tl.constexpr,","         BLOCK_K: tl.constexpr,","@@ -143,7 +144,11 @@ def _group_gemm_kernel(","                 mask=mask_k[:, None] & mask_n[None, :],","                 other=0.0,","             )","-            acc += tl.dot(a_tile, b_tile)  # For FP32 inputs, it use TF32 tensor core for better performance on sm8x","+            if USE_IEEE:","+                acc += tl.dot(a_tile, b_tile, input_precision=\"ieee\")","+            else:","+                # The regular FP32 path uses TF32 tensor cores for performance.","+                acc += tl.dot(a_tile, b_tile)"," ","         out = acc.to(out_ptr.dtype.element_ty)","         tl.store(","@@ -191,6 +196,7 @@ def _group_gemm_dw_kernel(","         stride_ok,","         stride_on,","         NUM_GROUPS: tl.constexpr,","+        USE_IEEE: tl.constexpr,","         BLOCK_M: tl.constexpr,","         BLOCK_K: tl.constexpr,","         BLOCK_N: tl.constexpr,","@@ -228,9 +234,11 @@ def _group_gemm_dw_kernel(","                 mask=mask_m[:, None] & mask_n[None, :],","                 other=0.0,","             )  # [BLOCK_M, BLOCK_N]","-            acc += tl.dot(","-                tl.trans(a_tile),","-                g_tile)  # [BLOCK_K, BLOCK_N]; For FP32 inputs, it use TF32 tensor core for better performance on sm8x","+            if USE_IEEE:","+                acc += tl.dot(tl.trans(a_tile), g_tile, input_precision=\"ieee\")","+            else:","+                # The regular FP32 path uses TF32 tensor cores for performance.","+                acc += tl.dot(tl.trans(a_tile), g_tile)"," ","         out = acc.to(out_ptr.dtype.element_ty)","         out_base = out_ptr + pid_e * stride_oe","@@ -300,6 +308,17 @@ def _validate(mat_a: torch.Tensor, mat_b: torch.Tensor, offs: torch.Tensor, tran","         raise ValueError(f\"Contraction dim mismatch: mat_a K={mat_a.shape[1]} vs mat_b K={mat_b_k}.\")"," "," ","+def _launch_group_gemm(kernel, configs, grid, *args, **kwargs):","+    deterministic = torch.are_deterministic_algorithms_enabled()","+    kwargs[\"USE_IEEE\"] = deterministic","+    if deterministic:","+        # Bypass timing-dependent autotuning without changing its shared cache/configs.","+        config = configs[0]","+        kernel.fn[grid](*args, **kwargs, **config.kwargs, num_warps=config.num_warps, num_stages=config.num_stages)","+    else:","+        kernel[grid](*args, **kwargs)","+","+"," def _group_gemm(mat_a: torch.Tensor, mat_b: torch.Tensor, offs: torch.Tensor) -> torch.Tensor:","     \"\"\"Forward-style grouped GEMM: a[M,KC] x b[E,KC,NO] -> out[M,NO], grouped over M.\"\"\"","     M, KC = mat_a.shape","@@ -317,7 +336,10 @@ def grid(meta):","         max_m_tiles = (M + block_m - 1) // block_m + E","         return (max_m_tiles, triton.cdiv(NO, meta[\"BLOCK_N\"]))"," ","-    _group_gemm_kernel[grid](","+    _launch_group_gemm(","+        _group_gemm_kernel,","+        _gmm_configs(),","+        grid,","         mat_a,","         mat_b,","         out,","@@ -358,7 +380,10 @@ def _grouped_dw(mat_a: torch.Tensor, grad_out: torch.Tensor, offs: torch.Tensor,","     def grid(meta):","         return (E, triton.cdiv(K, meta[\"BLOCK_K\"]), triton.cdiv(NO, meta[\"BLOCK_N\"]))"," ","-    _group_gemm_dw_kernel[grid](","+    _launch_group_gemm(","+        _group_gemm_dw_kernel,","+        _dw_configs(),","+        grid,","         mat_a,","         grad_out,","         out,"],"additions":31,"deletions":6,"truncated":false},{"path":"deepspeed/runtime/config.py","lines":["@@ -479,6 +479,8 @@ def __init__(self, config: Union[str, dict], mpu=None, mesh_device=None):","         param_dict = copy.copy(self._param_dict)","         self._initialize_params(param_dict)","         self._configure_train_batch_size()","+        from .determinism import configure_determinism","+        configure_determinism(self, param_dict)","         self._do_sanity_check()"," ","     def _initialize_params(self, param_dict):"],"additions":2,"deletions":0,"truncated":false},{"path":"deepspeed/runtime/determinism.py","lines":["@@ -0,0 +1,38 @@","+# SPDX-License-Identifier: Apache-2.0","+# DeepSpeed Team","+\"\"\"Opt-in deterministic execution policy, independent of numerical compatibility.\"\"\"","+","+import os","+","+import torch","+","+","+def configure_determinism(config, param_dict):","+    enabled = param_dict.get(\"deterministic_mode\", False)","+    if type(enabled) is not bool:","+        raise ValueError(\"deterministic_mode must be a JSON boolean\")","+    config.deterministic_mode = enabled","+","+","+def _is_nvidia_cuda(accelerator):","+    # device_name() is the torch device string. KLXPU inherits it from CUDA","+    # while identifying itself as \"klxpu\"; ROCm also reports \"cuda\".","+    return (accelerator.device_name() == \"cuda\" and getattr(accelerator, \"_name\", None) == \"cuda\"","+            and getattr(torch.version, \"hip\", None) is None)","+","+","+def apply_determinism(config):","+    if not config.deterministic_mode:","+        return","+    from deepspeed.accelerator import get_accelerator","+","+    if not _is_nvidia_cuda(get_accelerator()):","+        raise ValueError(\"deterministic_mode currently supports NVIDIA CUDA only\")","+    # Do not set this here: CUDA may already have initialized cuBLAS workspaces.","+    if os.environ.get(\"CUBLAS_WORKSPACE_CONFIG\") not in (\":4096:8\", \":16:8\"):","+        raise ValueError(\"deterministic_mode requires CUBLAS_WORKSPACE_CONFIG=:4096:8 or :16:8 before CUDA use\")","+    torch.use_deterministic_algorithms(True, warn_only=False)","+    torch.backends.cuda.matmul.allow_tf32 = False","+    torch.backends.cudnn.allow_tf32 = False","+    torch.backends.cudnn.benchmark = False","+    torch.backends.cudnn.deterministic = True"],"additions":38,"deletions":0,"truncated":false},{"path":"deepspeed/runtime/engine.py","lines":["@@ -542,6 +542,9 @@ def __init__(self,","         self.warn_unscaled_loss = True","         self.config = config","         self._config = config_class","+        if self._config.deterministic_mode:","+            from .determinism import apply_determinism","+            apply_determinism(self._config)","         self.loaded_checkpoint_mp_world_size = None","         self.loaded_checkpoint_dp_world_size = None","         self.enable_backward_allreduce = True"],"additions":3,"deletions":0,"truncated":false},{"path":"deepspeed/sequence/fpdt_layer.py","lines":["@@ -404,7 +404,7 @@ def backward(ctx, grad_output):","                                          window_size[1],","                                          0.0,","                                          alibi_slopes,","-                                         False,","+                                         torch.are_deterministic_algorithms_enabled(),","                                          rng_state=None)","                 elif flash_attn_version >= version.parse(\"2.6.0\"):","                     _flash_attn_backward(d_out,","@@ -422,7 +422,7 @@ def backward(ctx, grad_output):","                                          window_size,","                                          softcap=0.0,","                                          alibi_slopes=alibi_slopes,","-                                         deterministic=False,","+                                         deterministic=torch.are_deterministic_algorithms_enabled(),","                                          rng_state=None)","                 else:","                     _flash_attn_backward(d_out,","@@ -439,7 +439,7 @@ def backward(ctx, grad_output):","                                          causal_chunk,","                                          window_size,","                                          alibi_slopes=alibi_slopes,","-                                         deterministic=False,","+                                         deterministic=torch.are_deterministic_algorithms_enabled(),","                                          rng_state=None)"," ","                 dq[q_i].add_(dq_this.to(torch.float))","@@ -902,7 +902,7 @@ def backward(ctx, grad_output):","                                              window_size[1],","                                              0.0,","                                              alibi_slopes,","-                                             False,","+                                             torch.are_deterministic_algorithms_enabled(),","                                              rng_state=None)","                     elif flash_attn_version >= version.parse(\"2.6.0\"):","                         _flash_attn_backward(grad_global_attn_output[q_compute_chunk_idx].get_gpu_chunk(),","@@ -920,7 +920,7 @@ def backward(ctx, grad_output):","                                              window_size,","                                              softcap=0.0,","                                              alibi_slopes=alibi_slopes,","-                                             deterministic=False,","+                                             deterministic=torch.are_deterministic_algorithms_enabled(),","                                              rng_state=None)","                     else:","                         _flash_attn_backward(grad_global_attn_output[q_compute_chunk_idx].get_gpu_chunk(),","@@ -937,7 +937,7 @@ def backward(ctx, grad_output):","                                              causal_chunk,","                                              window_size,","                                              alibi_slopes=alibi_slopes,","-                                             deterministic=False,","+                                             deterministic=torch.are_deterministic_algorithms_enabled(),","                                              rng_state=None)"," ","                 if i != (len(global_k) - 1):"],"additions":6,"deletions":6,"truncated":false},{"path":"docs/_pages/config-json.md","lines":["@@ -4,6 +4,20 @@ toc: true"," toc_label: \"Contents\""," ---"," ","+### Deterministic Execution","+","+`deterministic_mode` is a JSON boolean, default `false`. On NVIDIA CUDA, enabling it","+selects strict PyTorch deterministic algorithms, disables TF32 and cuDNN","+benchmarking, and enables deterministic cuDNN algorithms at engine initialization.","+Set `CUBLAS_WORKSPACE_CONFIG=:4096:8` or `:16:8` before CUDA use.","+Enabling it on any accelerator other than NVIDIA CUDA, including a CUDA-compatible accelerator such as KLXPU, is currently unsupported; disabled behavior is unchanged.","+","+The flag does not change precision, NCCL algorithm, parallelism or overlap.","+PyTorch checks do not cover all custom kernels or distributed scheduling;","+configuration acceptance does not certify workload bitwise repeatability or","+Megatron compatibility. Settings are process-global and not restored at teardown.","+See [Deterministic Mode](/tutorials/deterministic-mode/) for details.","+"," ### Batch Size Related Parameters"," "," **Note:** <i>**train_batch_size**</i> must be equal to  <i>**train_micro_batch_size_per_gpu**</i> * <i>**gradient_accumulation_steps**</i> * number of GPUs. For simplicity, you can choose to only specify two of the three parameters, the last one will be inferred automatically by DeepSpeed."],"additions":14,"deletions":0,"truncated":false},{"path":"docs/_tutorials/deterministic-mode.md","lines":["@@ -0,0 +1,58 @@","+---","+title: \"Deterministic Mode\"","+---","+","+The JSON boolean `deterministic_mode` selects an NVIDIA CUDA/PyTorch execution policy.","+It defaults to `false` and does not select a Megatron numerical strategy.","+Set the workspace environment before the first CUDA operation:","+","+```bash","+export CUBLAS_WORKSPACE_CONFIG=:4096:8","+```","+","+```json","+{","+    \"train_micro_batch_size_per_gpu\": 2,","+    \"deterministic_mode\": true,","+    \"zero_optimization\": {\"stage\": 2}","+}","+```","+","+Parsing does not change input configuration or process-global PyTorch settings.","+Engine initialization enables strict deterministic algorithms, disables TF32","+and cuDNN benchmarking, and enables deterministic cuDNN algorithms.","+PyTorch raises for recognized nondeterministic operations without an alternative.","+Non-NVIDIA-CUDA enabling currently raises, including a CUDA-compatible accelerator whose DeepSpeed identity is not `cuda`, such as KLXPU. The disabled flag is a no-op.","+","+The flag does not change gradient precision, GAS, TP/EP, overlap, NCCL algorithms","+or AutoEP arithmetic, and does not reject configurations merely because they","+have not been tested. Existing configuration validation still applies.","+Custom kernels, collectives and scheduling are not fully covered by PyTorch's","+checks: independently validate complete workload repeatability on a pinned","+software/hardware stack and topology. No Megatron bitwise guarantee is implied.","+","+Callers own model initialization, seeds, data ordering and checkpoint RNG/","+dataloader state. Engine initialization cannot retroactively make earlier","+model construction or CUDA operations deterministic. Workspace settings are","+validated, not installed too late. Process-global runtime settings are not","+restored by engine teardown or a subsequent disabled engine.","+","+Custom paths also consult PyTorch's deterministic setting:","+","+- FPDT passes the setting to FlashAttention backward in GPU/offloaded paths.","+- Legacy DeepSpeedTransformerLayer rejects stochastic_mode=True at construction","+  and execution, including when determinism is enabled after model construction.","+- Triton grouped GEMM bypasses timing autotuning and uses the first fixed","+  configuration for forward, input gradients and weight gradients. Deterministic","+  launches also select IEEE `tl.dot` precision, because disabling PyTorch TF32","+  does not control Triton input precision. Default autotuning and TF32 precision","+  remain unchanged when deterministic algorithms are disabled.","+","+Fixed kernel selection is not certification of every shape/backend, and may","+reduce performance. FPDT RNG/communication and full distributed repeatability","+still require workload validation. Warn-only PyTorch mode also selects these","+paths; legacy stochastic execution raises rather than silently proceeding.","+","+There is no OpGuard or Transformer Engine runtime dependency.","+The broader compatibility proposal is","+https://github.com/deepspeedai/DeepSpeed/issues/8915."],"additions":58,"deletions":0,"truncated":false},{"path":"tests/unit/runtime/test_custom_determinism.py","lines":["@@ -0,0 +1,66 @@","+# SPDX-License-Identifier: Apache-2.0","+# DeepSpeed Team","+\"\"\"Policy checks that do not require compiling a CUDA extension.\"\"\"","+","+from types import SimpleNamespace","+","+import pytest","+import torch","+","+","+@pytest.fixture","+def deterministic_policy():","+    before = (torch.are_deterministic_algorithms_enabled(), torch.is_deterministic_algorithms_warn_only_enabled())","+    torch.use_deterministic_algorithms(True)","+    try:","+        yield","+    finally:","+        torch.use_deterministic_algorithms(before[0], warn_only=before[1])","+","+","+def test_stochastic_layer_rejected_before_extension_load(deterministic_policy):","+    from deepspeed.ops.transformer.transformer import DeepSpeedTransformerConfig, DeepSpeedTransformerLayer","+    with pytest.raises(RuntimeError, match=\"stochastic_mode=False\"):","+        DeepSpeedTransformerLayer(DeepSpeedTransformerConfig(stochastic_mode=True))","+","+","+def test_stochastic_forward_rejected_after_construction(deterministic_policy):","+    from deepspeed.ops.transformer.transformer import DeepSpeedTransformerFunction","+    # No tensor/extension access should precede the strict-policy rejection.","+    config = SimpleNamespace(stochastic_mode=True)","+    with pytest.raises(RuntimeError, match=\"stochastic_mode=False\"):","+        DeepSpeedTransformerFunction.forward(*([None] * 18), config)","+","+","+@pytest.mark.parametrize(\"enabled\", [False, True])","+def test_grouped_kernel_launch_policy(enabled):","+    from deepspeed.ops.triton_ops.group_gemm_triton import _launch_group_gemm","+    before = (torch.are_deterministic_algorithms_enabled(), torch.is_deterministic_algorithms_warn_only_enabled())","+    calls = []","+","+    class Kernel:","+","+        def __getitem__(self, grid):","+","+            def launch(*args, **kwargs):","+                calls.append((grid, args, kwargs))","+","+            return launch","+","+    kernel = Kernel()","+    kernel.fn = Kernel()","+    config = SimpleNamespace(kwargs={\"BLOCK_M\": 32}, num_warps=8, num_stages=4)","+    try:","+        torch.use_deterministic_algorithms(enabled)","+        _launch_group_gemm(kernel, [config], (1, 1), \"input\", NUM_GROUPS=2)","+        assert calls == [((1, 1), (\"input\", ), {","+            \"NUM_GROUPS\": 2,","+            \"USE_IEEE\": enabled,","+            **({","+                \"BLOCK_M\": 32,","+                \"num_warps\": 8,","+                \"num_stages\": 4","+            } if enabled else {})","+        })]","+    finally:","+        torch.use_deterministic_algorithms(before[0], warn_only=before[1])"],"additions":66,"deletions":0,"truncated":false},{"path":"tests/unit/runtime/test_determinism.py","lines":["@@ -0,0 +1,182 @@","+# SPDX-License-Identifier: Apache-2.0","+# DeepSpeed Team","+\"\"\"Execution-policy contract and independent-process CUDA training tests.\"\"\"","+","+import os","+from pathlib import Path","+import subprocess","+import sys","+","+import pytest","+import torch","+","+from deepspeed.accelerator import get_accelerator","+from deepspeed.runtime.config import DeepSpeedConfig","+from deepspeed.runtime.determinism import _is_nvidia_cuda, apply_determinism","+","+","+def test_runtime_rejects_rocm(monkeypatch):","+","+    class MockAccelerator:","+        _name = \"cuda\"","+","+        @staticmethod","+        def device_name():","+            return \"cuda\"","+","+    monkeypatch.setattr(\"deepspeed.accelerator.get_accelerator\", lambda: MockAccelerator())","+    monkeypatch.setattr(torch.version, \"hip\", \"6.0\")","+    monkeypatch.setenv(\"CUBLAS_WORKSPACE_CONFIG\", \":4096:8\")","+    with pytest.raises(ValueError, match=\"NVIDIA CUDA\"):","+        apply_determinism(DeepSpeedConfig({\"train_batch_size\": 1, \"deterministic_mode\": True}))","+","+","+def test_runtime_rejects_cuda_compatible_accelerator(monkeypatch):","+","+    class MockAccelerator:","+        _name = \"klxpu\"","+","+        @staticmethod","+        def device_name():","+            return \"cuda\"","+","+    monkeypatch.setattr(\"deepspeed.accelerator.get_accelerator\", lambda: MockAccelerator())","+    monkeypatch.setattr(torch.version, \"hip\", None)","+    monkeypatch.setenv(\"CUBLAS_WORKSPACE_CONFIG\", \":4096:8\")","+    before = torch.are_deterministic_algorithms_enabled()","+    with pytest.raises(ValueError, match=\"NVIDIA CUDA\"):","+        apply_determinism(DeepSpeedConfig({\"train_batch_size\": 1, \"deterministic_mode\": True}))","+    assert torch.are_deterministic_algorithms_enabled() == before","+","+","+@pytest.mark.parametrize(\"workspace\", [None, \"\", \"invalid\"])","+def test_runtime_requires_workspace(monkeypatch, workspace):","+    if not _is_nvidia_cuda(get_accelerator()):","+        pytest.skip(\"NVIDIA CUDA policy\")","+    if workspace is None:","+        monkeypatch.delenv(\"CUBLAS_WORKSPACE_CONFIG\", raising=False)","+    else:","+        monkeypatch.setenv(\"CUBLAS_WORKSPACE_CONFIG\", workspace)","+    with pytest.raises(ValueError, match=\"CUBLAS_WORKSPACE_CONFIG\"):","+        apply_determinism(DeepSpeedConfig({\"train_batch_size\": 1, \"deterministic_mode\": True}))","+","+","+def test_disabled_runtime_is_noop(monkeypatch):","+    monkeypatch.delenv(\"CUBLAS_WORKSPACE_CONFIG\", raising=False)","+    before = torch.are_deterministic_algorithms_enabled()","+    apply_determinism(DeepSpeedConfig({\"train_batch_size\": 1}))","+    assert torch.are_deterministic_algorithms_enabled() == before","+","+","+def assert_equal(left, right):","+    if torch.is_tensor(left):","+        assert left.shape == right.shape and left.dtype == right.dtype","+        assert torch.equal(left.contiguous().reshape(-1).view(torch.uint8),","+                           right.contiguous().reshape(-1).view(torch.uint8))","+    elif isinstance(left, dict):","+        assert left.keys() == right.keys()","+        for key in left:","+            assert_equal(left[key], right[key])","+    elif isinstance(left, (tuple, list)):","+        assert type(left) is type(right) and len(left) == len(right)","+        for a, b in zip(left, right):","+            assert_equal(a, b)","+    else:","+        assert type(left) is type(right) and left == right","+","+","+@pytest.mark.parametrize(\"stage\", [0, 2, 3])","+def test_independent_cuda_training(stage, tmp_path):","+    if not _is_nvidia_cuda(get_accelerator()) or not get_accelerator().is_available():","+        pytest.skip(\"NVIDIA CUDA training\")","+    env = dict(os.environ, CUBLAS_WORKSPACE_CONFIG=\":4096:8\", OMP_NUM_THREADS=\"1\")","+    results = []","+    for repeat in range(2):","+        output = tmp_path / f\"repeat{repeat}.pt\"","+        subprocess.run([","+            sys.executable,","+            str(Path(torch.__file__).parent / \"distributed\" / \"run.py\"), \"--standalone\", \"--nproc_per_node=1\",","+            str(Path(__file__).resolve()), \"--stage\",","+            str(stage), \"--output\",","+            str(output)","+        ],","+                       env=env,","+                       check=True,","+                       timeout=180)","+        results.append(torch.load(output, map_location=\"cpu\", weights_only=False))","+    assert_equal(*results)","+","+","+def worker(stage, output):","+    import deepspeed","+    from deepspeed import comm as dist","+    from deepspeed.utils import safe_get_full_grad, safe_get_full_fp32_param, safe_get_full_optimizer_state","+","+    get_accelerator().set_device(int(os.environ[\"LOCAL_RANK\"]))","+    torch.manual_seed(1234)","+    model = torch.nn.Sequential(torch.nn.Linear(8, 16), torch.nn.Tanh(), torch.nn.Linear(16, 4))","+    optimizer = torch.optim.AdamW(model.parameters(), lr=0.001)","+    engine, _, _, _ = deepspeed.initialize(model=model,","+                                           optimizer=optimizer,","+                                           config={","+                                               \"train_micro_batch_size_per_gpu\": 2,","+                                               \"gradient_accumulation_steps\": 2,","+                                               \"deterministic_mode\": True,","+                                               \"zero_allow_untested_optimizer\": True,","+                                               \"zero_optimization\": {","+                                                   \"stage\": stage,","+                                                   \"overlap_comm\": False","+                                               },","+                                           })","+    assert torch.are_deterministic_algorithms_enabled()","+    assert not torch.is_deterministic_algorithms_warn_only_enabled()","+    assert not torch.backends.cuda.matmul.allow_tf32","+    assert not torch.backends.cudnn.allow_tf32","+    assert not torch.backends.cudnn.benchmark","+    assert torch.backends.cudnn.deterministic","+    snapshots = []","+","+    def collect(kind):","+        values = []","+        for parameter in engine.module.parameters():","+            if stage == 0:","+                if kind == \"gradient\":","+                    value = parameter.grad","+                elif kind == \"master\":","+                    value = parameter","+                else:","+                    value = optimizer.state[parameter][kind]","+            elif kind == \"gradient\":","+                value = safe_get_full_grad(parameter)","+            elif kind == \"master\":","+                value = safe_get_full_fp32_param(parameter)","+            else:","+                value = safe_get_full_optimizer_state(parameter, kind)","+            assert value is not None","+            values.append(value.detach().cpu().clone())","+        return values","+","+    for microstep in range(6):","+        value = engine(torch.randn(2, 8, device=engine.device))","+        engine.backward(value.square().mean())","+        boundary = engine.is_gradient_accumulation_boundary()","+        snapshot = {\"output\": value.detach().cpu().clone()}","+        if boundary:","+            snapshot[\"gradient\"] = collect(\"gradient\")","+        engine.step()","+        if boundary:","+            snapshot.update({kind: collect(kind) for kind in (\"master\", \"exp_avg\", \"exp_avg_sq\")})","+            snapshot.update(global_steps=engine.global_steps, micro_steps=engine.micro_steps)","+        snapshots.append(snapshot)","+    torch.save(snapshots, output)","+    engine.destroy()","+    dist.destroy_process_group()","+","+","+if __name__ == \"__main__\":","+    import argparse","+    parser = argparse.ArgumentParser()","+    parser.add_argument(\"--stage\", type=int, required=True)","+    parser.add_argument(\"--output\", type=Path, required=True)","+    args = parser.parse_args()","+    worker(args.stage, args.output)"],"additions":182,"deletions":0,"truncated":false},{"path":"tests/unit/runtime/test_ds_config_model.py","lines"