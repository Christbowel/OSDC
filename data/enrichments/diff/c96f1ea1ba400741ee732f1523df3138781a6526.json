mrc_info;","+    let (pnpr_url, token) = start_pnpr(mock_instance.url());","+    configure_pnpr_auth(&npmrc_path, &pnpr_url, &token);","+    fs::write(workspace.join(\"package.json\"), r#\"{\"dependencies\":{\"@foo/no-deps\":\"1.0.0\"}}\"#)","+        .expect(\"write package.json\");","+    let workspace_config = workspace.join(\"pnpm-workspace.yaml\");","+    let mut settings = fs::read_to_string(&workspace_config).expect(\"read workspace config\");","+    settings.push_str(\"\\nminimumReleaseAge: 52560000\\nminimumReleaseAgeStrict: true\\n\");","+    fs::write(&workspace_config, settings).expect(\"write release-age settings\");","+","+    let output = pacquet_at(&workspace)","+        .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+        .with_args([\"install\", \"--pnpr-server\", &pnpr_url])","+        .output()","+        .expect(\"run pnpm install\");","+    assert!(!output.status.success(), \"strict pnpr install unexpectedly succeeded\");","+    assert!(","+        String::from_utf8_lossy(&output.stderr).contains(\"ERR_PNPR_NO_MATURE_MATCHING_VERSION\"),","+        \"expected the stable maturity error code, got: {}\",","+        String::from_utf8_lossy(&output.stderr),","+    );","+    drop((root, mock_instance));","+}"],"additions":120,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/pnpr_install/workspace.rs","lines":["@@ -19,6 +19,7 @@ use super::{","     replace_workspace_dependency,","     seed_filtered_repair_workspace,","     selected_only_pnpr_lockfile,","+    selected_only_pnpr_lockfile_for,","     start_pnpr,","     workspace_has_link,","     workspace_importer,","@@ -27,6 +28,11 @@ use super::{","     workspace_snapshot_entries,","     write_workspace_project,"," };","+use crate::_utils::{","+    append_workspace_yaml_key,","+    bravo_dep_mature_up_to_1_0_1_minimum_release_age,","+    set_minimum_release_age,","+};"," use assert_cmd::assert::OutputAssertExt;"," use std::fmt::Write as _;"," ","@@ -262,7 +268,7 @@ f