  \"allowedPicks\": allowed_picks,","     });","+    let expects_release_age = !allowed_picks.is_empty();","     let resolve = server","         .mock(\"POST\", \"/-/pnpr/v0/resolve\")","         .with_status(200)","         .with_header(\"content-type\", \"application/x-ndjson\")","-        .with_body_from_request(move |request| pnpr_done_frame(request, response.clone()))","+        .with_body_from_request(move |request| {","+            if expects_release_age {","+                let request_body: serde_json::Value =","+                    serde_json::from_slice(request.body().unwrap()).unwrap();","+                assert!(","+                    request_body[\"minimumReleaseAge\"].as_u64().is_some(),","+                    \"allowed-pick test request did not include minimumReleaseAge: {request_body}\",","+                );","+            }","+            pnpr_done_frame(request, response.clone())","+        })","         .expect(1)","         .create();","     (handshake, resolve)","@@ -797,6 +814,7 @@ fn pnpr_done_frame(request: &mockito::Request, mut frame: serde_json::Value) ->","         \"minimumReleaseAge\": null,","         \"minimumReleaseAgeExclude\": [],","         \"minimumReleaseAgeIgnoreMissingTime\": true,","+        \"minimumReleaseAgeStrict\": false,","         \"trustPolicy\": null,","         \"trustPolicyExclude\": [],","         \"trustPolicyIgnoreAfter\": null,"],"additions":22,"deletions":4,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/pnpr_install/resolution.rs","lines":["@@ -1011,3 +1011,123 @@ fn delegated_install_rekeys_an_existing_secondary_registry_alias() {","     assert!(workspace.join(\"node_modules/@foo/no-deps/package.json\").exists());","     drop((root, mock_instance));"," }","+","+#[test]","+fn loose_minimum_release_age_picks_are_persisted_and_reused_via_pnpr() {","+    let CommandTempCwd {","+        pacquet: _,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { npmrc_path, mock_instance, .. } = npmrc_info;","+    let (pnpr_url, token) = start_pnpr(mock_instance.url());","+    configure_pnpr_auth(&npmrc_path, &pnpr_url, &token);","+    fs::write(workspace.join(\"package.json\"), r#\"{\"dependencies\":{\"@foo/no-deps\":\"1.0.0\"}}\"#)","+        .expect(\"write package.json\");","+    let workspace_config = workspace.join(\"pnpm-workspace.yaml\");","+    let mut settings = fs::read_to_string(&workspace_config).expect(\"read workspace config\");","+    settings.push_str(\"\\nminimumReleaseAge: 52560000\\nminimumReleaseAgeStrict: false\\n\");","+    fs::write(&workspace_config, settings).expect(\"write release-age settings\");","+","+    let install = || {","+        let assert = pacquet_at(&workspace)","+            .with_env(\"PNPM_CONFIG_REGISTRY\", mock_instance.url())","+            .with_args([\"install\", \"--pnpr-server\", &pnpr_url])","+            .assert()","+            .success();","+        String::from_utf8_lossy(&assert.get_output().stdout).into_owned()","+    };","+    let stdout = install();","+    assert!(","+        stdout.contains(","+            \"Added 1 entry to minimumReleaseAgeExclude in pnpm-workspace.yaml (set minimumReleaseAgeStrict to true to gate these updates with a prompt):\\n  @foo/no-deps@1.0.0\"","+        ),","+        \"loose pnpr resolution did not report the saved pick:\\n{stdout}\",","+    );","+    let workspace_yaml = fs::read_to_string(&workspace_config).expect(\"read collected excludes\");","+    assert!(","+        workspace_yaml.contains(\"minimumReleaseAgeExclude:\")","+            && workspace_yaml.contains(\"@foo/no-deps@1.0.0\"),","+        \"loose pnpr resolution did not persist the allowed pick: {workspace_yaml}\",","+    );","+    install();","+","+    drop((root, mock_instance));","+}","+","+#[test]","+fn pnpr_patch_refresh_does_not_persist_release_age_picks_under_no_save() {","+    let CommandTempCwd {","+        