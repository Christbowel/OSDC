{"id":"c96f1ea1ba400741ee732f1523df3138781a6526","axis":"silent","repo":"pnpm/pnpm","sha":"c96f1ea1ba400741ee732f1523df3138781a6526","parsed":{"files":[{"path":".changeset/pnpr-release-age-policy.md","lines":["@@ -0,0 +1,8 @@","+---","+\"pnpm\": patch","+\"pacquet\": patch","+\"@pnpm/pnpr.client\": patch","+\"@pnpm/pnpr\": patch","+---","+","+Installs through a pnpr server now enforce `minimumReleaseAgeStrict` and add fallback versions to `minimumReleaseAgeExclude` when strict mode is off."],"additions":8,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install.rs","lines":["@@ -6,6 +6,10 @@ pub use arguments::{","     LockfileUpdateArgs,"," };"," ","+pub(crate) use pnpr_link::{","+    PnprLink,","+    PnprLockfilePolicy,","+};"," pub(crate) use pnpr_pnpmfile::{","     PnprTarget,","     pnpr_target,","@@ -357,6 +361,7 @@ impl InstallArgs {","             skip_runtimes: config.skip_runtimes || self.materialization.no_runtime,","             lockfile_path: Some(lockfile_path),","             use_state_lockfile: true,","+            save_workspace_manifest: true,","             lockfile: PnprLockfilePolicy {","                 frozen: frozen_lockfile,","                 prefer_frozen: self","@@ -490,54 +495,6 @@ pub(crate) fn workspace_install_selection(","     }"," }"," ","-/// Per-invocation install knobs forwarded to the frozen link pass,","-/// already resolved from the CLI flags + config by [`InstallArgs::run`].","-pub(crate) struct PnprLink<'a> {","-    pub(crate) dependency_groups: Vec<DependencyGroup>,","-    pub(crate) supported_architectures: Option<pnpm_package_is_installable::SupportedArchitectures>,","-    pub(crate) node_linker: NodeLinker,","-    pub(crate) skip_runtimes: bool,","-    pub(crate) lockfile_path: Option<&'a std::path::Path>,","-    pub(crate) use_state_lockfile: bool,","-    pub(crate) lockfile: PnprLockfilePolicy,","-}","-","-pub(crate) struct PnprLockfilePolicy {","-    /// Governs the *server's* resolution behavior (frozen vs","-    /// reuse-and-update); forwarded to `/-/pnpr/v0/resolve`. The local","-    /// materialization always runs frozen against the server-produced","-    /// lockfile.","-    pub(crate) frozen: bool,","-    /// The *effective* `preferFrozenLockfile` (the CLI tri-state already","-    /// resolved against `config.prefer_frozen_lockfile`, exactly as the","-    /// local `Install` resolves it); forwarded to `/-/pnpr/v0/resolve`. `false`","-    /// forces the server to re-resolve. Resolving here (rather than","-    /// sending the raw CLI override) keeps a yaml `preferFrozenLockfile:","-    /// false` honored on the pnpr path without `--no-prefer-frozen-lockfile`.","-    pub(crate) prefer_frozen: bool,","-    /// Refresh registry artifacts while retaining every locked package","-    /// version. This disables the exchange-free satisfied-lockfile path and","-    /// is forwarded to `/-/pnpr/v0/resolve`.","-    pub(crate) update_patches: bool,","-    /// Regenerate derived lockfile metadata while retaining compatible pins.","-    pub(crate) fix: bool,","-    /// `--lockfile-only`. Forwarded to `/-/pnpr/v0/resolve` so the server","-    /// resolves only (returning the lockfile without fetching files)","-    /// after which [`install_via_pnpr`] writes the lockfile and skips","-    /// materialization, mirroring pnpm's resolve + write, fetch nothing,","-    /// link nothing. See","-    /// [pnpm/pnpm#12146](https://github.com/pnpm/pnpm/issues/12146).","-    pub(crate) only: bool,","-    /// `--ignore-manifest-check`; forwarded so the server's frozen","-    /// freshness check and the local materialization both skip the","-    /// manifest ↔ lockfile comparison.","-    pub(crate) ignore_manifest_check: bool,","-    /// The effective `trustLockfile` (yaml `trustLockfile` OR","-    /// `--trust-lockfile`); forwarded so the server skips verifying the","-    /// input lockfile when the user opted out, mirroring the local path.","-    pub(crate) trust: bool,","-}","-"," /// `--prefer-frozen-lockfile` / `--no-prefer-frozen-lockfile` map to"," /// `Option<bool>`: `Some` when either flag is set, `None` otherwise (use"," /// config). The pair's mutual `overrides_with` collapses both spellings","@@ -566,6 +523,8 @@ mod frozen_validation;"," "," mod pnpr_config_validation;"," ","+mod pnpr_link;","+"," mod pnpr_local_specs;"," "," mod pnpr_pnpmfile;"],"additions":7,"deletions":48,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install/pnpr_link.rs","lines":["@@ -0,0 +1,55 @@","+//! The install settings the pnpr path carries from the CLI to the server","+//! request and the local link pass.","+","+use pnpm_config::NodeLinker;","+use pnpm_package_manifest::DependencyGroup;","+","+/// Per-invocation install knobs forwarded to the frozen link pass,","+/// already resolved from the CLI flags + config by","+/// [`InstallArgs::run`](super::InstallArgs::run).","+pub(crate) struct PnprLink<'a> {","+    pub(crate) dependency_groups: Vec<DependencyGroup>,","+    pub(crate) supported_architectures: Option<pnpm_package_is_installable::SupportedArchitectures>,","+    pub(crate) node_linker: NodeLinker,","+    pub(crate) skip_runtimes: bool,","+    pub(crate) lockfile_path: Option<&'a std::path::Path>,","+    pub(crate) use_state_lockfile: bool,","+    pub(crate) save_workspace_manifest: bool,","+    pub(crate) lockfile: PnprLockfilePolicy,","+}","+","+pub(crate) struct PnprLockfilePolicy {","+    /// Governs the *server's* resolution behavior (frozen vs","+    /// reuse-and-update); forwarded to `/-/pnpr/v0/resolve`. The local","+    /// materialization always runs frozen against the server-produced","+    /// lockfile.","+    pub(crate) frozen: bool,","+    /// The *effective* `preferFrozenLockfile` (the CLI tri-state already","+    /// resolved against `config.prefer_frozen_lockfile`, exactly as the","+    /// local `Install` resolves it); forwarded to `/-/pnpr/v0/resolve`. `false`","+    /// forces the server to re-resolve. Resolving the effective value here","+    /// keeps a yaml `preferFrozenLockfile:","+    /// false` honored on the pnpr path without `--no-prefer-frozen-lockfile`.","+    pub(crate) prefer_frozen: bool,","+    /// Refresh registry artifacts while retaining every locked package","+    /// version. This disables the exchange-free satisfied-lockfile path and","+    /// is forwarded to `/-/pnpr/v0/resolve`.","+    pub(crate) update_patches: bool,","+    /// Regenerate derived lockfile metadata while retaining compatible pins.","+    pub(crate) fix: bool,","+    /// `--lockfile-only`. Forwarded to `/-/pnpr/v0/resolve` so the server","+    /// resolves only and returns the lockfile without fetching files,","+    /// after which [`install_via_pnpr`](super::install_via_pnpr) writes the lockfile and skips","+    /// materialization, mirroring pnpm's resolve + write, fetch nothing,","+    /// link nothing. See","+    /// [pnpm/pnpm#12146](https://github.com/pnpm/pnpm/issues/12146).","+    pub(crate) only: bool,","+    /// `--ignore-manifest-check`; forwarded so the server's frozen","+    /// freshness check and the local materialization both skip the","+    /// manifest ↔ lockfile comparison.","+    pub(crate) ignore_manifest_check: bool,","+    /// The effective `trustLockfile` (yaml `trustLockfile` OR","+    /// `--trust-lockfile`); forwarded so the server skips verifying the","+    /// input lockfile when the user opted out, mirroring the local path.","+    pub(crate) trust: bool,","+}"],"additions":55,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/install/pnpr_request.rs","lines":["@@ -406,6 +406,7 @@ pub(super) fn verification_policy(","         minimum_release_age: config.minimum_release_age,","         minimum_release_age_exclude: config.minimum_release_age_exclude.clone(),","         minimum_release_age_ignore_missing_time: config.minimum_release_age_ignore_missing_time,","+        minimum_release_age_strict: config.resolved_minimum_release_age_strict(),","