+import { AlertingPageWrapper } from '../../components/AlertingPageWrapper';","+import { useAlertRulesNav } from '../../navigation/useAlertRulesNav';","+import { withPageErrorBoundary } from '../../withPageErrorBoundary';","+","+import { AlertRulesDeletedView } from './AlertRulesDeletedView';","+","+function AlertRulesDeletedPage() {","+  const { navId, pageNav } = useAlertRulesNav();","+","+  return (","+    <AlertingPageWrapper navId={navId} pageNav={pageNav}>","+      <AlertRulesDeletedView />","+    </AlertingPageWrapper>","+  );","+}","+","+export default withPageErrorBoundary(AlertRulesDeletedPage);"],"additions":17,"deletions":0,"truncated":false},{"path":"public/app/features/alerting/unified/gma-rule-list/alert-rules/AlertRulesDeletedView.test.tsx","lines":["@@ -0,0 +1,84 @@","+import { HttpResponse, http } from 'msw';","+import { render, screen, userEvent } from 'test/test-utils';","+","+import server from '@grafana/test-utils/server';","+","+jest.mock('@grafana/runtime', () => ({","+  ...jest.requireActual('@grafana/runtime'),","+  reportInteraction: jest.fn(),","+}));","+","+import { setupMswServer } from '../../mockApi';","+import { FOLDER_PARENTS_URL, TRASH_RULES_URL, makeDeletedRule, mockTrashRules } from '../mocks/handlers';","+","+import { AlertRulesDeletedView } from './AlertRulesDeletedView';","+","+setupMswServer();","+","+describe('AlertRulesDeletedView', () => {","+  beforeEach(() => {","+    server.use(","+      http.get(FOLDER_PARENTS_URL, () => HttpResponse.json({ items: [] })),","+      // Return a known display name so tests can wait for IAM resolution","+      // by asserting on the displayed name before interacting with buttons.","+      http.get(/\\/apis\\/iam\\.grafana\\.app\\/.*\\/display/, () =>","+        HttpResponse.json({","+          display: [{ identity: { type: 'user', name: 'user-uid-123' }, displayName: 'Test Admin', internalId: 1 }],","+          keys: ['user:user-uid-123'],","+        })","+      )","+    );","+  });","+","+  it('shows loading state initially', async () => {","+    let releasePage: () => void = () => {};","+    const gate = new Promise<void>((resolve) => {","+      releasePage = resolve;","+    });","+    server.use(","+      http.get(TRASH_RULES_URL, async () => {","+        await gate;","+        return HttpResponse.json({ kind: 'AlertRuleList', metadata: {}, items: [] });","+      })","+    );","+    render(<AlertRulesDeletedView />);","+    expect(screen.getByRole('list', { name: /Loading rules/i })).toBeInTheDocument();","+    releasePage();","+    expect(await screen.findByText(/No recently deleted/i)).toBeInTheDocument();","+  });","+","+  it('shows deleted rules after load', async () => {","+    mockTrashRules([makeDeletedRule()]);","+    render(<AlertRulesDeletedView />);","+    expect(await screen.findByText('Deleted rule')).toBeInTheDocument();","+  });","+","+  it('shows empty state when no deleted rules', async () => {","+    mockTrashRules([]);","+    render(<AlertRulesDeletedView />);","+    expect(await screen.findByText(/No recently deleted/i)).toBeInTheDocument();","+  });","+","+  it('opens Review drawer when Review is clicked', async () => {","+    mockTrashRules([makeDeletedRule()]);","+    render(<AlertRulesDeletedView />);","+    // Wait for IAM user-name resolution to settle before clicking","+    await screen.findByText('Test Admin');","+    await userEvent.click(screen.getByRole('button', { name: /Review/i }));","+    expect(await screen.findByRole('dialog')).toBeInTheDocument();","+  });","+","+  it('opens Restore modal when Restore is clicked', async () => {","+    mockTrashRules([makeDeletedRule()]);","+    render(<AlertRulesDeletedView />);","+    await screen.findByText('Test Admin');","+    await userEvent.click(screen.getByRole('button', { name: /Restore/i }));","+    expect(await screen.findByText(/Restore \"Deleted rule\"/i)).toBeInTheDocument();","+  });","+","+  it('shows error state with retry on fetch failure', async () => {","+    server.use(http.get(TRASH_RULES_URL, () => HttpResponse.json({ message: 'boom' }, { status: 500 })));","+    render(<AlertRulesDeletedView />);","+    expect(await screen.findByRole('button', { name: /Retry/i })).toBeInTheDocument();","+  });","+});"],"additions":84,"deletions":0,"truncated":false},{"path":"public/app/features/alerting/unified/gma-rule-list/alert-rules/AlertRulesDeletedView.tsx","lines":["@@ -0,0 +1,105 @@","+import { skipToken } from '@reduxjs/toolkit/query';","+import { useMemo, useState } from 'react';","+","+import { type AlertRule } from '@grafana/api-clients/rtkq/rules.alerting/v0alpha1';","+import { Trans, t } from '@grafana/i18n';","+import { Alert, Button } from '@grafana/ui';","+import { useGetDisplayMappingQuery } from 'app/api/clients/iam/v0alpha1';","+","+import { DeletedRulesTable } from '../deleted-rules/DeletedRulesTable';","+import { RestoreModal } from '../deleted-rules/RestoreModal';","+import { ReviewDrawer } from '../deleted-rules/ReviewDrawer';","+import { trackJsonOpened, trackReviewOpened, useTrackDeletedRulesPageView } from '../deleted-rules/analytics';","+import { RuleListSkeleton } from '../rule-row/RuleListSkeleton';","+","+import { useDeletedAlertRules } from './useDeletedAlertRules';","+","+/** Batch-resolves user UIDs to display names via IAM getDisplayMapping. */","+function useDeletedByNames(rules: AlertRule[]): Record<string, string> {","+  const userUids = useMemo(() => {","+    const uids = new Set<string>();","+    for (const rule of rules) {","+      const uid = rule.metadata?.annotations?.['grafana.app/updatedBy'];","+      if (uid) {","+        uids.add(uid);","+      }","+    }","+    return Array.from(uids);","+  }, [rules]);","+","+  // The annotation may already be an identity ref (\"user:<uid>\") or a raw UID.","+  // Normalise to \"user:<uid>\" for the IAM key without double-prefixing.","+  const iamKeys = userUids.map((uid) => (uid.includes(':') ? uid : `user:${uid}`));","+","+  const { data } = useGetDisplayMappingQuery(iamKeys.length > 0 ? { key: iamKeys } : skipToken);","+","+  return useMemo(() => {","+    const map: Record<string, string> = {};","+    for (const entry of data?.display ?? []) {","+      if (entry.identity.type && entry.identity.name) {","+        // Store under both \"user:<name>\" and raw \"<name>\" to handle annotations","+        // that may carry either an identity ref or a plain UID.","+        map[`${entry.identity.type}:${entry.identity.name}`] = entry.displayName;","+        map[entry.identity.name] = entry.displayName;","+      }","+    }","+    return map;","+  }, [data]);","+}","+","+export function AlertRulesDeletedView() {","+  const { items, hasMore, isLoading, isFetchingMore, error, loadMore, refetch, totalFromApi } = useDeletedAlertRules();","+  const [reviewing, setReviewing] = useState<AlertRule | null>(null);","+  const [restoring, setRestoring] = useState<AlertRule | null>(null);","+  const userNames = useDeletedByNames(items);","+","+  useTrackDeletedRulesPageView(totalFromApi);","+","+  if (isLoading) {","+    return <RuleListSkeleton />;","+  }","+","+  if (error && items.length === 0) {","+    return (","+      <Alert title={t('alerting.recently-deleted.error', 'Failed to load deleted rules')} severity=\"error\">","+        <Button variant=\"secondary\" onClick={refetch}>","+          <Trans i18nKey=\"alerting.recently-deleted.retry\">Retry</Trans>","+        </Button>","+      </Alert>","+    );","+  }","+","+  return (","+    <>","+      <DeletedRulesTable","+        rules={items}","+        folderPaths={{}}","+        userNames={userNames}","+        onReview={(rule) => {","+          trackReviewOpened();","+          setReviewing(rule);","+        }}","+        onRestore={setRestoring}","+        hasMore={hasMore}","+        isLoadingMore={isFetchingMore}","+        onLoadMore={loadMore}","+      />","+      {reviewing && (","+        <ReviewDrawer","+          rule={reviewing}","+          deletedByName={userNames[reviewing.metadata?.annotations?.['grafana.app/updatedBy'] ?? '']}","+          onClose={() => setReviewing(null)}","+          onJsonOpen={trackJsonOpened}","+        />","+      )}","+      {restoring && (","+        <RestoreModal","+          rule={restoring}","+          onDismiss={() => setRestoring(null)}","+          onSuccess={() => setRestoring(null)}","+          onRefetch={refetch}","+        />","+      )}","+    </>","+  );","+}"],"additions":105,"deletions":0,"truncated":false},{"path":"public/app/features/alerting/unified/gma-rule-list/alert-rules/AlertRulesPage.tsx","lines":["@@ -23,6 +23,7 @@ import { type AlertRuleFilter, alertRuleSearchSchema } from './alertRuleFilters'"," import { useAlertRuleSearchRejection } from './alertRuleSearch';"," "," function AlertRulesPage() {","+  const { navId, pageNav } = useAlertRulesNav();","   const { query, filter, parseIssues, filterHelp, mode, hasNonFolderFilters, applyQuery, setMode } =","     useRuleListSearchState(alertRuleSearchSchema);","   const rejectionIssues = useAlertRuleSearchRejection(filter, { parseIssues, mode });","@@ -30,7 +31,6 @@ function AlertRulesPage() {"," ","   useTrackRuleListPageView('alert', mode);"," ","-  const { navId, pageNav } = useAlertRulesNav();","   const headerHeight = useChromeHeaderHeight() ?? 0;","   const styles = useStyles2(getStyles, headerHeight);"," "],"additions":1,"deletions":1,"truncated":false},{"path":"public/app/features/alerting/unified/gma-rule-list/alert-rules/useDeletedAlertRules.test.ts","lines":["@@ -0,0 +1,69 @@","+import { HttpResponse, http } from 'msw';","+import { act, getWrapper, renderHook, waitFor } from 'test/test-utils';","+","+import { type AlertRule } from '@grafana/api-clients/rtkq/rules.alerting/v0alpha1';","+import server from '@grafana/test-utils/server';","+","+import { setupMswServer } from '../../mockApi';","+import { TRASH_RULES_URL, makeDeletedRule, mockTrashRules } from '../mocks/handlers';","+","+import { useDeletedAlertRules } from './useDeletedAlertRules';","+","+setupMswServer();","+","+function make(n: number): AlertRule[] {","+  return Array.from({ length: n }, (_, i) =>","+    makeDeletedRule({ metadata: { name: `rule-${i}`, annotations: { 'grafana.app/folder': 'f' } } })","+  );","+}","+","+describe('useDeletedAlertRules', () => {","+  it('returns first 40 items when server sends more (legacy mode)', async () => {","+    mockTrashRules(make(90));","+    const { result } = renderHook(() => useDeletedAlertRules(), { wrapper: getWrapper({}) });","+    await waitFor(() => expect(result.current.items).toHaveLength(40));","+    expect(result.current.hasMore).toBe(true);","+  });","+","+  it('reveals next 40 from local buffer without a network request on loadMore', async () => {","+    mockTrashRules(make(90));","+    const { result } = renderHook(() => useDeletedAlertRules(), { wrapper: getWrapper({}) });","+    await waitFor(() => expect(result.current.items).toHaveLength(40));","+","+    await act(async () => {","+      result.current.loadMore();","+    });","+","+    expect(result.current.items).toHaveLength(80);","+  });","+","+  it('returns isLoading true while request is in flight', async () => {","+    let release: () => void = () => {};","+    const gate = new Promise<void>((resolve) => {","+      release = resolve;","+    });","+    server.use(","+      http.get(TRASH_RULES_URL, async () => {","+        await gate;","+        return HttpResponse.json({ kind: 'AlertRuleList', metadata: {}, items: [] });","+      })","+    );","+    const { result } = renderHook(() => useDeletedAlertRules(), { wrapper: getWrapper({}) });","+    expect(result.current.isLoading).toBe(true);","+    release();","+  });","+","+  it('returns error when request fails', async () => {","+    server.use(http.get(TRASH_RULES_URL, () => HttpResponse.json({ message: 'boom' }, { status: 500 })));","+    const { result } = renderHook(() => useDeletedAlertRules(), { wrapper: getWrapper({}) });","+    await waitFor(() => expect(result.current.error).toBeTruthy());","+  });","+","+  it('shows empty list and hasMore false when no rules', async () => {","+    mockTrashRules([]);","+    const { result } = renderHook(() => useDeletedAlertRules(), { wrapper: getWrapper({}) });","+    await waitFor(() => expect(result.current.isLoading).toBe(false));","+    expect(result.current.items).toHaveLength(0);","+    expect(result.current.hasMore).toBe(false);","+  });","+});"],"additions":69,"deletions":0,"truncated":false},{"path":"public/app/features/alerting/unified/gma-rule-list/alert-rules/useDeletedAlertRules.ts","lines":["@@ -0,0 +1,106 @@","+import { useCallback, useState } from 'react';","+","+import { type AlertRule, generatedAPI } from '@grafana/api-clients/rtkq/rules.alerting/v0alpha1';","+import { DEFAULT_PER_PAGE_PAGINATION } from 'app/core/constants';","+","+const PAGE_SIZE = DEFAULT_PER_PAGE_PAGINATION;","+const TRASH_LABEL_SELECTOR = 'grafana.app/get-trash=true';","+","+/**","+ * Infinite query for the trash list. The continue token from each page becomes","+ * the pageParam for the next, matching the pattern used by searchRecordingRules.","+ */","+const trashAPI = generatedAPI.injectEndpoints({","+  endpoints: (build) => ({","+    listDeletedAlertRules: build.infiniteQuery<","+      { items: AlertRule[]; continueToken?: string },","+      void,","+      string | undefined","+    >({","+      infiniteQueryOptions: {","+        initialPageParam: undefined,","+        getNextPageParam: (lastPage) => lastPage.continueToken || undefined,","+      },","+      keepUnusedDataFor: 0,","+      queryFn: async ({ pageParam }, { dispatch }) => {","+        const response = await dispatch(","+          generatedAPI.endpoints.listAlertRule.initiate(","+            { labelSelector: TRASH_LABEL_SELECTOR, limit: PAGE_SIZE, continue: pageParam },","+            { subscribe: false, forceRefetch: true }","+          )","+        );","+        if (response.error) {","+          return { error: response.error };","+        }","+        return {","+          data: {","+            items: response.data?.items ?? [],","+            continueToken: response.data?.metadata?.continue,","+          },","+        };","+      },","+      providesTags: ['AlertRule'],","+    }),","+  }),","+});","+","+const { useListDeletedAlertRulesInfiniteQuery } = trashAPI;","+","+export interface UseDeletedAlertRulesResult {","+  items: AlertRule[];","+  hasMore: boolean;","+  isLoading: boolean;","+  isFetchingMore: boolean;","+  error: unknown;","+  /** Total items returned by the API (all pages combined) — use for analytics, not display. */","+  totalFromApi: number | undefined;","+  loadMore: () => void;","+  refetch: () => void;","+}","+","+/**","+ * Fetches soft-deleted alert rules and normalizes pagination.","+ * Legacy storage ignores `limit` and returns all tombstones — we normalize","+ * by revealing items in 40-row chunks from a local buffer.","+ */","+export function useDeletedAlertRules(): UseDeletedAlertRulesResult {","+  const [revealed, setRevealed] = useState(PAGE_SIZE);","+","+  const { data, isLoading, isFetching, error, fetchNextPage, hasNextPage, refetch } =","+    useListDeletedAlertRulesInfiniteQuery(undefined, { refetchOnMountOrArgChange: true });","+","+  const allItems = data?.pages.flatMap((page) => page.items) ?? [];","+  const items = allItems.slice(0, revealed);","+  const isFetchingMore = isFetching && !isLoading;","+  // Keep hasMore true while fetching more or when a next-page fetch failed so","+  // the Load more button stays visible (showing spinner or allowing retry).","+  const hasMore =","+    revealed < allItems.length || Boolean(hasNextPage) || isFetchingMore || Boolean(error && allItems.length > 0);","+","+  const loadMore = useCallback(() => {","+    if (revealed < allItems.length) {","+      setRevealed((r) => r + PAGE_SIZE);","+    } else if (!isFetching && (hasNextPage || error)) {","+      // Allow retry when a previous next-page fetch failed (error is set but","+      // hasNextPage may be false since the error response had no continueToken).","+      void fetchNextPage();","+      setRevealed((r) => r + PAGE_SIZE);","+    }","+  }, [revealed, allItems.length, hasNextPage, error, isFetching, fetchNextPage]);","+","+  const handleRefetch = useCallback(() => {","+    setRevealed(PAGE_SIZE);","+    void refetch();","+  }, [refetch]);","+","+  return {","+    items,","+    hasMore,","+    isLoading,","+    isFetchingMore,","+    error,","+    totalFromApi: data ? allItems.length : undefined,","+    loadMore,","+    refetch: handleRefetch,","+  };","+}"],"additions":106,"deletions":0,"truncated":false},{"path":"public/app/features/alerting/unified/gma-rule-list/deleted-rules/DeletedRulesTable.test.tsx","lines":["@@ -0,0 +1,76 @@","+import { render, screen, userEvent } from 'test/test-utils';","+","+import { type AlertRule } from '@grafana/api-clients/rtkq/rules.alerting/v0alpha1';","+","+import { makeDeletedRule } from '../mocks/handlers';","+","+import { DeletedRulesTable } from './DeletedRulesTable';","+","+function renderTable(rules: AlertRule[], overrides = {}) {","+  return render(","+    <DeletedRulesTable","+      rules={rules}","+      folderPaths={{ 'folder-uid': 'Platform / Infra' }}","+      userNames={{ 'user-uid-123': 'Alice Smith' }}","+      onReview={jest.fn()}","+      onRestore={jest.fn()}","+      hasMore={false}","+      isLoadingMore={false}","+      onLoadMore={jest.fn()}","+      {...overrides}","+    />","+  );","+}","+","+describe('DeletedRulesTable', () => {","+  it('renders rule title', async () => {","+    renderTable([makeDeletedRule()]);","+    expect(await screen.findByText('Deleted rule')).toBeInTheDocument();","+  });","+","+  it('shows resolved folder path', () => {","+    renderTable([makeDeletedRule()]);","+    expect(screen.getByText('Platform / Infra')).toBeInTheDocument();","+  });","+","+  it('shows resolved user display name', () => {","+    renderTable([makeDeletedRule()]);","+    expect(screen.getByText('Alice Smith')).toBeInTheDocument();","+  });","+","+  it('falls back to UID when user name is unavailable', () => {","+    renderTable([makeDeletedRule()], { userNames: {} });","+    expect(screen.getByText('user-uid-123')).toBeInTheDocument();","+  });","+","+  it('shows \"Unknown\" when updatedBy annotation is absent', () => {","+    const rule = makeDeletedRule();","+    delete rule.metadata.annotations?.['grafana.app/updatedBy'];","+    renderTable([rule]);","+    expect(screen.getByText('Unknown')).toBeInTheDocument();","+  });","+","+  it('calls onReview when Review button is clicked', async () => {","+    const onReview = jest.fn();","+    renderTable([makeDeletedRule()], { onReview });","+    await userEvent.click(screen.getByRole('button', { name: /Review/i }));","+    expect(onReview).toHaveBeenCalledWith(expect.objectContaining({ metadata: expect.any(Object) }));","+  });","+","+  it('calls onRestore when Restore button is clicked', async () => {","+    const onRestore = jest.fn();","+    renderTable([makeDeletedRule()], { onRestore });","+    await userEvent.click(screen.getByRole('button', { name: /Restore/i }));","+    expect(onRestore).toHaveBeenCalled();","+  });","+","+  it('shows Load more button when hasMore is true', () => {","+    renderTable([makeDeletedRule()], { hasMore: true });","+    expect(screen.getByRole('button', { name: /Load more/i })).toBeInTheDocument();","+  });","+","+  it('shows empty state when no rules', () => {","+    renderTable([]);","+    expect(screen.getByText(/No recently deleted/i)).toBeInTheDocument();","+  });","+});"],"additions":76,"deletions":0,"truncated":false},{"path":"public/app/features/alerting/unified/gma-rule-list/deleted-rules/DeletedRulesTable.tsx","lines":["@@ -0,0 +1,113 @@","+import { type AlertRule } from '@grafana/api-clients/rtkq/rules.alerting/v0alpha1';","+import { dateTimeFormat, dateTimeFormatTimeAgo } from '@grafana/data';","+import { Trans, t } from '@grafana/i18n';","+import { Button, type Column, EmptyState, InteractiveTable, Spinner, Stack } from '@grafana/ui';","+","+import { FolderByUid } from '../folder-browsing/FolderByUid';","+","+interface DeletedRulesTableProps {","+  rules: AlertRule[];","+  /** Pre-resolved folder paths: uid → display path string (override for tests) */","+  folderPaths: Record<string, string>;","+  /** Pre-resolved user names from IAM getDisplayMapping: uid → display name */","+  userNames: Record<string, string>;","+  onReview: (rule: AlertRule) => void;","+  onRestore: (rule: AlertRule) => void;","+  hasMore: boolean;","+  isLoadingMore: boolean;","+  onLoadMore: () => void;","+}","+","+export function DeletedRulesTable({","+  rules,","+  folderPaths,","+  userNames,","+  onReview,","+  onRestore,","+  hasMore,","+  isLoadingMore,","+  onLoadMore,","+}: DeletedRulesTableProps) {","+  if (rules.length === 0) {","+    return (","+      <EmptyState","+        variant=\"not-found\"","+        message={t('alerting.recently-deleted.empty', 'No recently deleted rules found')}","+      />","+    );","+  }","+","+  const columns: Array<Column<AlertRule>> = [","+    {","+      id: 'title',","+      header: t('alerting.recently-deleted.table.title', 'Title'),","+      cell: ({ row }) => row.original.spec?.title ?? '',","+    },","+    {","+      id: 'folder',","+      header: t('alerting.recently-deleted.table.folder', 'Folder'),","+      cell: ({ row }) => {","+        const folderUid = row.original.metadata?.annotations?.['grafana.app/folder'];","+        if (!folderUid) {","+          return null;","+        }","+        if (folderPaths[folderUid]) {","+          return <>{folderPaths[folderUid]}</>;","+        }","+        return <FolderByUid folderUid={folderUid} />;","+      },","+    },","+    {","+      id: 'deleted',","+      header: t('alerting.recently-deleted.table.deleted', 'Deleted'),","+      cell: ({ row }) => {","+        const ts = row.original.metadata?.deletionTimestamp;","+        if (!ts) {","+          return null;","+        }","+        return (","+          <Stack direction=\"column\" gap={0}>","+            <span>{dateTimeFormat(ts)}</span>","+            <span>{dateTimeFormatTimeAgo(ts)}</span>","+          </Stack>","+        );","+      },","+    },","+    {","+      id: 'deletedBy',","+      header: t('alerting.recently-deleted.table.deleted-by', 'Deleted by'),","+      cell: ({ row }) => {","+        const uid = row.original.metadata?.annotations?.['grafana.app/updatedBy'];","+        if (!uid) {","+          return t('alerting.recently-deleted.unknown', 'Unknown');","+        }","+        return userNames[uid] ?? uid;","+      },","+    },","+    {","+      id: 'actions',","+      header: '',","+      cell: ({ row }) => (","+        <Stack direction=\"row\" gap={1}>","+          <Button size=\"sm\" variant=\"secondary\" onClick={() => onReview(row.original)}>","+            <Trans i18nKey=\"alerting.recently-deleted.action.review\">Review</Trans>","+          </Button>","+          <Button size=\"sm\" variant=\"secondary\" onClick={() => onRestore(row.original)}>","+            <Trans i18nKey=\"alerting.recently-deleted.action.restore\">Restore</Trans>","+          </Button>","+        </Stack>","+      ),","+    },","+  ];","+","+  return (","+    <Stack direction=\"column\" gap={2}>","+      <InteractiveTable columns={columns} data={rules} getRowId={(rule) => rule.metadata?.name ?? ''} />","+      {hasMore && (","+        <Button variant=\"secondary\" onClick={onLoadMore} disabled={isLoadingMore}>","+          {isLoadingMore ? <Spinner /> : <Trans i18nKey=\"alerting.recently-deleted.load-more\">Load more</Trans>}","+        </Button>","+      )}","+    </Stack>","+  );","+}"],"additions":113,"deletions":0,"truncated":false},{"path":"public/app/features/alerting/unified/gma-rule-list/deleted-rules/RestoreModal.test.tsx","lines":["@@ -0,0 +1,50 @@","+import { HttpResponse, http } from 'msw';","+import { render, screen, userEvent, waitFor } from 'test/test-utils';","+","+import { API_GROUP, API_VERSION } from '@grafana/api-clients/rtkq/rules.alerting/v0alpha1';","+","+import { setupMswServer } from '../../mockApi';","+import { makeDeletedRule } from '../mocks/handlers';","+","+import { RestoreModal } from './RestoreModal';","+","+const server = setupMswServer();","+const CREATE_URL = `/apis/${API_GROUP}/${API_VERSION}/namespaces/default/alertrules`;","+","+describe('RestoreModal', () => {","+  it('shows the rule title in the confirmation', () => {","+    render(<RestoreModal rule={makeDeletedRule()} onDismiss={jest.fn()} onSuccess={jest.fn()} />);","+    expect(screen.getByText(/Deleted rule/i)).toBeInTheDocument();","+  });","+","+  it('calls onDismiss when cancelled', async () => {","+    const onDismiss = jest.fn();","+    render(<RestoreModal rule={makeDeletedRule()} onDismiss={onDismiss} onSuccess={jest.fn()} />);","+    await userEvent.click(screen.getByRole('button', { name: /Cancel/i }));","+    expect(onDismiss).toHaveBeenCalled();","+  });","+","+  it('calls onSuccess and navigates to the rule after a successful restore', async () => {","+    server.use(http.post(CREATE_URL, () => HttpResponse.json({}, { status: 200 })));","+    const onSuccess = jest.fn();","+    render(<RestoreModal rule={makeDeletedRule()} onDismiss={jest.fn()} onSuccess={onSuccess} />);","+    await userEvent.click(screen.getByRole('button', { name: /Restore/i }));","+    await waitFor(() => expect(onSuccess).toHaveBeenCalled());","+  });","+","+  it('shows the API error message inline on failure (e.g. folder not writable)', async () => {","+    server.use(","+      http.post(CREATE_URL, () => HttpResponse.json({ message: 'folder not found or not writable' }, { status: 403 }))","+    );","+    render(<RestoreModal rule={makeDeletedRule()} onDismiss={jest.fn()} onSuccess={jest.fn()} />);","+    await userEvent.click(screen.getByRole('button', { name: /Restore/i }));","+    expect(await screen.findByText(/folder not found or not writable/i)).toBeInTheDocument();","+  });","+","+  it('shows conflict message on 409', async () => {","+    server.use(http.post(CREATE_URL, () => HttpResponse.json({ message: 'conflict' }, { status: 409 })));","+    render(<RestoreModal rule={makeDeletedRule()} onDismiss={jest.fn()} onSuccess={jest.fn()} />);","+    await userEvent.click(screen.getByRole('button', { name: /Restore/i }));","+    expect(await screen.findByText(/already exists/i)).toBeInTheDocument();","+  });","+});"],"additions":50,"deletions":0,"truncated":false},{"path":"public/app/features/alerting/unified/gma-rule-list/deleted-rules/RestoreModal.tsx","lines":["@@ -0,0 +1,83 @@","+import { useState } from 'react';","+","+import { type AlertRule } from '@grafana/api-clients/rtkq/rules.alerting/v0alpha1';","+import { t } from '@grafana/i18n';","+import { isFetchError, locationService } from '@grafana/runtime';","+import { Alert, ConfirmModal } from '@grafana/ui';","+","+import { grafanaRulesNav } from '../../utils/navigation';","+","+import { trackRestoreAttempt, trackRestoreFailure, trackRestoreSuccess } from './analytics';","+import { useRestoreAlertRule } from './useRestoreRule';","+","+interface RestoreModalProps {","+  rule: AlertRule;","+  onDismiss: () => void;","+  onSuccess: (restoredName: string) => void;","+  onRefetch?: () => void;","+}","+","+export function RestoreModal({ rule, onDismiss, onSuccess, onRefetch }: RestoreModalProps) {","+  const { restore, isRestoring } = useRestoreAlertRule();","+  const [error, setError] = useState<string | null>(null);","+  const title = rule.spec?.title ?? '';","+  const uid = rule.metadata?.name ?? '';","+","+  const handleConfirm = async () => {","+    setError(null);","+    trackRestoreAttempt();","+    try {","+      const result = await restore(rule);","+      if (result.success) {","+        trackRestoreSuccess();","+        onSuccess(uid);","+        locationService.push(grafanaRulesNav.viewLink(uid, { includeReturnTo: true }));","+      } else if (result.isConflict) {","+        trackRestoreFailure('conflict');","+        onRefetch?.();","+        setError(t('alerting.recently-deleted.restore.conflict', 'A rule with this name already exists.'));","+      } else {","+        trackRestoreFailure('error');","+        // Show the API's error message (e.g. folder missing/not writable) if available","+        const errorData = isFetchError(result.error) ? result.error.data : null;","+        const apiMessage =","+          errorData !== null &&","+          typeof errorData === 'object' &&","+          'message' in errorData &&","+          typeof errorData.message === 'string'","+            ? errorData.message","+            : '';","+        setError(","+          apiMessage || t('alerting.recently-deleted.restore.error', 'Failed to restore rule. Please try again.')","+        );","+      }","+    } catch (err) {","+      trackRestoreFailure('error');","+      setError(t('alerting.recently-deleted.restore.error', 'Failed to restore rule. Please try again.'));","+    }","+  };","+","+  return (","+    <ConfirmModal","+      isOpen","+      title={t('alerting.recently-deleted.restore.title', 'Restore alert rule')}","+      body={","+        <>","+          {t('alerting.recently-deleted.restore.body', 'Restore \"{{title}}\"?', {"],"additions":66,"deletions":0,"truncated":false}],"additions":700,"deletions":2,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-11-19T17:59:09.609753+00:00"}