?: string[];","   trace_count?: number;","+  last_seen_timestamp?: number;","+  last_updated_by?: string;","+  metadata?: Record<string, string>;"," }"," "," type SearchIssuesResponse = {"],"additions":3,"deletions":0,"truncated":false},{"path":"mlflow/server/js/src/experiment-tracking/constants.ts","lines":["@@ -155,6 +155,7 @@ export enum ExperimentPageTabName {","   Models = 'models',","   EvaluationMonitoring = 'evaluation-monitoring',","   Judges = 'judges',","+  Issues = 'issues',","   EvaluationRuns = 'evaluation-runs',","   Datasets = 'datasets',","   LabelingSessions = 'labeling-sessions',"],"additions":1,"deletions":0,"truncated":false},{"path":"mlflow/server/js/src/experiment-tracking/pages/experiment-issues/ExperimentIssueDetail.tsx","lines":["@@ -0,0 +1,191 @@","+import {","+  Alert,","+  Button,","+  ChevronDownIcon,","+  DropdownMenu,","+  Typography,","+  useDesignSystemTheme,","+} from '@databricks/design-system';","+import { GenAIMarkdownRenderer } from '../../../shared/web-shared/genai-markdown-renderer';","+import { FormattedMessage, useIntl } from 'react-intl';","+import Utils from '../../../common/utils/Utils';","+import type { Issue, IssueStatus } from '../../components/run-page/hooks/useSearchIssuesQuery';","+import { IssueCompletionIcon, IssueStatusMarker } from './ExperimentIssueRow';","+import { IssueCategoryTag } from './IssueCategoryTag';","+import { SEVERITY_LABELS, STATUS_LABELS } from './issueLabels';","+import { IssueDetailSectionTitle } from './IssueDetailSectionTitle';","+import { IssueDetailColumn } from './IssueDetailColumn';","+import { useTriageExperimentIssue } from './useExperimentIssues';","+import { Link } from '../../../common/utils/RoutingUtils';","+import Routes from '../../routes';","+","+const IssueAge = ({ issue }: { issue: Issue }) => {","+  const timeAgo = Utils.timeSinceStr(issue.created_timestamp);","+","+  return <Typography.Text color=\"secondary\">{timeAgo}</Typography.Text>;","+};","+","+export interface ExperimentIssueDetailProps {","+  issue: Issue;","+  onUpdateStatus: (status: IssueStatus) => void;","+  isUpdatingStatus?: boolean;","+}","+","+/**","+ * An issue's title, triage actions, and severity, categories and age: the part of the detail pane","+ * that names the issue, pinned full width above the scrolling body.","+ */","+export const ExperimentIssueDetailHeader = ({","+  issue,","+  onUpdateStatus,","+  isUpdatingStatus,","+}: ExperimentIssueDetailProps) => {","+  const { theme } = useDesignSystemTheme();","+  const intl = useIntl();","+  const severityColor: 'error' | 'warning' | 'secondary' =","+    issue.severity === 'high' ? 'error' : issue.severity === 'medium' ? 'warning' : 'secondary';","+","+  return (","+    <div css={{ display: 'flex', flexDirection: 'column', gap: theme.spacing.sm }}>","+      <div css={{ display: 'flex', alignItems: 'flex-start', gap: theme.spacing.md }}>","+        <div css={{ flex: 1, minWidth: 0 }}>","+          <div css={{ display: 'flex', alignItems: 'center', gap: theme.spacing.sm, minWidth: 0 }}>","+            <IssueCompletionIcon status={issue.status} />","+            <Typography.Title level={3} withoutMargins>","+              {issue.name}","+            </Typography.Title>","+          </div>","+        </div>","+        <div css={{ display: 'flex', alignItems: 'center', gap: theme.spacing.xs, flexShrink: 0 }}>","+          <DropdownMenu.Root>","+            <DropdownMenu.Trigger asChild>","+              <Button","+                componentId=\"mlflow.experiment-issues.detail.status\"","+                size=\"small\"","+                endIcon={<ChevronDownIcon />}","+                loading={isUpdatingStatus}","+              >","+                <span css={{ display: 'inline-flex', alignItems: 'center', gap: theme.spacing.xs }}>","+                  <IssueStatusMarker status={issue.status} />","+                  {intl.formatMessage(STATUS_LABELS[issue.status])}","+                </span>","+              </Button>","+            </DropdownMenu.Trigger>","+            <DropdownMenu.Content align=\"end\">","+              {issue.status === 'pending' ? (","+                <>","+                  <DropdownMenu.Item","+                    componentId=\"mlflow.experiment-issues.detail.status.resolve\"","+                    disabled={isUpdatingStatus}","+                    onClick={() => onUpdateStatus('resolved')}","+                  >","+                    <FormattedMessage defaultMessage=\"Mark resolved\" description=\"Experiment issue resolve action\" />","+                  </DropdownMenu.Item>","+                  <DropdownMenu.Item","+                    componentId=\"mlflow.experiment-issues.detail.status.reject\"","+                    disabled={isUpdatingStatus}","+                    onClick={() => onUpdateStatus('rejected')}","+                  >","+                    <FormattedMessage defaultMessage=\"Not an issue\" description=\"Experiment issue reject action\" />","+                  </DropdownMenu.Item>","+                </>","+              ) : (","+                <DropdownMenu.Item","+                  componentId=\"mlflow.experiment-issues.detail.status.reopen\"","+                  disabled={isUpdatingStatus}","+                  onClick={() => onUpdateStatus('pending')}","+                >","+                  <FormattedMessage defaultMessage=\"Reopen\" description=\"Experiment issue reopen action\" />","+                </DropdownMenu.Item>","+              )}","+            </DropdownMenu.Content>","+          </DropdownMenu.Root>","+        </div>","+      </div>","+      <div css={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: theme.spacing.sm }}>","+        {issue.severity && (","+          <Typography.Text bold color={severityColor}>","+            {intl.formatMessage(SEVERITY_LABELS[issue.severity ?? 'not_an_issue'])}","+          </Typography.Text>","+        )}","+        {issue.categories?.map((category) => (","+          <IssueCategoryTag key={category} category={category} componentId=\"mlflow.experiment-issues.detail.category\" />","+        ))}","+        <IssueAge issue={issue} />","+      </div>","+    </div>","+  );","+};","+","+/**","+ * The issue's description, rendered as Markdown. Traces and experiment editors shape it, so it uses the","+ * trace drawer's renderer: an image from an untrusted host loads only when the reader asks, so a stored","+ * image URL can't send data out from every reader's browser.","+ */","+export const ExperimentIssueDescription = ({ description }: { description: string }) => {","+  const { theme } = useDesignSystemTheme();","+  return (","+    <div css={{ display: 'flex', flexDirection: 'column', gap: theme.spacing.xs }}>","+      <IssueDetailSectionTitle>","+        <FormattedMessage","+          defaultMessage=\"Description\"","+          description=\"Experiment issues tab > Issue detail > Description section heading\"","+        />","+      </IssueDetailSectionTitle>","+      <GenAIMarkdownRenderer compact>{description}</GenAIMarkdownRenderer>","+    </div>","+  );","+};","+","+export const ExperimentIssueDetail = ({ issue }: { issue: Issue }) => {","+  const triage = useTriageExperimentIssue(issue.experiment_id);","+  return (","+    <IssueDetailColumn","+      issueKey={issue.issue_id}","+      bodyMaxWidth={960}","+      testId=\"experiment-issue-detail\"","+      header={","+        <ExperimentIssueDetailHeader","+          issue={issue}","+          onUpdateStatus={(status) => triage.mutate({ issueId: issue.issue_id, status })}","+          isUpdatingStatus={triage.isLoading}","+        />","+      }","+    >","+      {triage.error instanceof Error && (","+        <Alert","+          componentId=\"mlflow.experiment-issues.triage-error\"","+          type=\"error\"","+          closable={false}","+          message={","+            <FormattedMessage","+              defaultMessage=\"Unable to update issue\"","+              description=\"Experiment Issues triage error title\"","+            />","+          }","+          description={triage.error.message}","+        />","+      )}","+      <ExperimentIssueDescription description={issue.description ?? ''} />","+      <Typography.Text color=\"secondary\">","+        <FormattedMessage","+          defaultMessage=\"Last seen {time}\"","+          description=\"Experiment Issue last observation timestamp\"","+          values={{ time: Utils.formatTimestamp(issue.last_seen_timestamp ?? issue.created_timestamp) }}","+        />","+        {issue.source_run_id && (","+          <>","+            {' '}","+            ·{' '}","+            <Link","+              componentId=\"mlflow.experiment-issues.source-run\"","+              to={Routes.getRunPageRoute(issue.experiment_id, issue.source_run_id)}","+            >","+              <FormattedMessage defaultMessage=\"Source run\" description=\"Experiment Issue source run link\" />","+            </Link>","+          </>","+        )}","+      </Typography.Text>","+    </IssueDetailColumn>","+  );","+};"],"additions":191,"deletions":0,"truncated":false},{"path":"mlflow/server/js/src/experiment-tracking/pages/experiment-issues/ExperimentIssueRow.tsx","lines":["@@ -0,0 +1,256 @@","+import {","+  CheckCircleIcon,","+  PreviewCard,","+  Typography,","+  useDesignSystemTheme,","+  VisibleOffIcon,","+} from '@databricks/design-system';","+import { FormattedMessage, useIntl } from 'react-intl';","+import Utils from '../../../common/utils/Utils';","+import type { Issue, IssueSeverity, IssueStatus } from '../../components/run-page/hooks/useSearchIssuesQuery';","+import { IssueCategoryTag } from './IssueCategoryTag';","+import { categoryDescription, SEVERITY_GLYPH_LABELS, STATUS_LABELS } from './issueLabels';","+","+// Severity is the list's primary scan key, so it gets a glyph rather than a text tag: three","+// signal bars, filled by rank. Bar count carries the ordering on its own, so severity survives","+// without the colour (WCAG 1.4.1), and the glyph costs a fraction of a \"Medium\" tag's width.","+const SEVERITY_GLYPH_BARS = 3;","+const SEVERITY_FILLED_BARS: Record<IssueSeverity, number> = { high: 3, medium: 2, low: 1, not_an_issue: 0 };","+","+export const IssueSeverityGlyph = ({ severity }: { severity: IssueSeverity }) => {","+  const { theme } = useDesignSystemTheme();","+  const intl = useIntl();","+  const filledColor = {","+    high: theme.colors.textValidationDanger,","+    medium: theme.colors.textValidationWarning,","+    low: theme.colors.textSecondary,","+    not_an_issue: theme.colors.textSecondary,","+  }[severity];","+  const filledBars = SEVERITY_FILLED_BARS[severity];","+","+  return (","+    <svg","+      width={12}","+      height={11}","+      viewBox=\"0 0 12 11\"","+      role=\"img\"","+      aria-label={intl.formatMessage(SEVERITY_GLYPH_LABELS[severity])}","+      // Centred in its cell, whose height is the title's line box, so the glyph reads as","+      // sitting on the name rather than floating above it.","+      css={{ display: 'block', alignSelf: 'center' }}","+    >","+      {Array.from({ length: SEVERITY_GLYPH_BARS }, (_, index) => {","+        const height = 4 + index * 3;","+        return (","+          <rect","+            key={index}","+            x={index * 4.5}","+            y={11 - height}","+            width={3}","+            height={height}","+            rx={0.5}","+            fill={index < filledBars ? filledColor : theme.colors.borderDecorative}","+          />","+        );","+      })}","+    </svg>","+  );","+};","+","+export const IssueStatusMarker = ({ status, compact = false }: { status: IssueStatus; compact?: boolean }) => {","+  const { theme } = useDesignSystemTheme();","+  const backgroundColor = {","+    pending: theme.colors.textValidationDanger,","+    resolved: theme.colors.textValidationSuccess,","+    rejected: theme.colors.textSecondary,","+  }[status];","+","+  return (","+    <span","+      aria-hidden","+      css={{","+        width: compact ? 6 : 7,","+        height: compact ? 6 : 7,","+        flexShrink: 0,","+        borderRadius: theme.borders.borderRadiusFull,","+        backgroundColor,","+      }}","+    />","+  );","+};","+","+export const IssueCompletionIcon = ({ status }: { status: IssueStatus }) => {","+  const { theme } = useDesignSystemTheme();","+  const intl = useIntl();","+","+  if (status === 'resolved') {","+    return (","+      <span","+        role=\"img\"","+        aria-label={intl.formatMessage(STATUS_LABELS.resolved)}","+        css={{ display: 'inline-flex', color: theme.colors.textValidationSuccess, flexShrink: 0 }}","+      >","+        <CheckCircleIcon aria-hidden />","+      </span>","+    );","+  }","+  if (status === 'rejected') {","+    return (","+      <span","+        role=\"img\"","+        aria-label={intl.formatMessage(STATUS_LABELS.rejected)}","+        css={{ display: 'inline-flex', color: theme.colors.textSecondary, flexShrink: 0 }}","+      >","+        <VisibleOffIcon aria-hidden />","+      </span>","+    );","+  }","+  return null;","+};","+","+export interface ExperimentIssueRowProps {","+  issue: Issue;","+  isSelected: boolean;","+  onSelect: () => void;","+  /**","+   * The trace count to show, or null to show none. Defaults to the exact SQL trace count.","+   */","+  affectedTraceCount?: number | null;","+}","+","+/**","+ * One issue as a single scannable row: severity, name, categories, blast radius and age.","+ *","+ * Built on `PreviewCard`, which is the only dbui control that is simultaneously interactive","+ * (`role=\"button\"`, `tabIndex`, Enter/Space), selectable from *outside* state via `selected`","+ * (this tab's selection lives in the URL), and restyleable without `!important` -- its","+ * `dangerouslyAppendEmotionCSS` is applied after the container styles, so the flush 61px row","+ * below wins on ordering. Its header/children split maps onto the two lines directly.","+ *","+ * The alternatives, for the next person who asks: `Button` bakes height/display/radius behind","+ * `!important` and wraps children in a span, so a two-line grid needs `!important` to land at","+ * all; `Listbox` is the ideal semantic but its selection is internal `useState` with no `value`","+ * prop, which cannot be driven from the URL; `Card` is a roleless div, so `aria-pressed` is","+ * inert on it -- the reason the retired IssueCard's selected state was invisible to assistive","+ * tech; `RadioTile` takes no children.","+ *","+ * The description is deliberately absent -- a list of full descriptions fits about ten issues in","+ * a viewport, and the detail pane is where an issue is read.","+ */","+export const ExperimentIssueRow = ({","+  issue,","+  isSelected,","+  onSelect,","+  affectedTraceCount = issue.trace_count ?? null,","+}: ExperimentIssueRowProps) => {","+  const { theme } = useDesignSystemTheme();","+  const descriptionId = `issue-${issue.issue_id}-categories`;","+  const age = Utils.timeSinceStr(issue.created_timestamp);"],"additions":148,"deletions":0,"truncated":false}],"additions":410,"deletions":21,"truncated":true,"file_count":15},"error":null,"fetched_at":"2026-10-19T15:00:40.169417+00:00"}