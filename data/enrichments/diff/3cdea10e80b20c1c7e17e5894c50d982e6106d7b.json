{"id":"3cdea10e80b20c1c7e17e5894c50d982e6106d7b","axis":"silent","repo":"pnpm/pnpm","sha":"3cdea10e80b20c1c7e17e5894c50d982e6106d7b","parsed":{"files":[{"path":".changeset/frozen-install-absent-workspace-project.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/installing.deps-installer\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm install --frozen-lockfile` again succeeds when a workspace project recorded in `pnpm-lock.yaml` has no directory, such as a project left out of a Docker build context. It still fails if the project's directory exists without a `package.json` [#16453](https://github.com/pnpm/pnpm/issues/16453)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/lockfile_resolution_reuse/mutations.rs","lines":["@@ -566,7 +566,7 @@ fn a_remove_keeps_the_specifiers_a_project_rewriting_pnpmfile_recorded() {"," }"," "," #[test]","-fn a_frozen_install_rejects_the_importer_of_a_deleted_workspace_project() {","+fn a_frozen_install_skips_the_importer_of_an_absent_workspace_project() {","     let CommandTempCwd { workspace, root, npmrc_info, .. } =","         CommandTempCwd::init().add_mocked_registry();","     let AddMockedRegistry { mock_instance, .. } = npmrc_info;","@@ -576,19 +576,14 @@ fn a_frozen_install_rejects_the_importer_of_a_deleted_workspace_project() {","         .assert()","         .success();"," ","+    // A Docker build context can leave a project out (pnpm/pnpm#16453).","     fs::remove_dir_all(workspace.join(\"packages/b\")).expect(\"remove the member\");"," ","-    let output = pacquet_at(&workspace)","+    pacquet_at(&workspace)","         .with_args([\"install\", \"--frozen-lockfile\"])","-        .output()","-        .expect(\"run frozen install\");","-    let stderr = String::from_utf8_lossy(&output.stderr);","-    assert!(!output.status.success(), \"frozen install accepted the deleted member\");","-    assert!(","-        stderr.contains(\"ERR_PNPM_OUTDATED_LOCKFILE\")","-            