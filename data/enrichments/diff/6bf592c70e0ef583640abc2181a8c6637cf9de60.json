ager/ai_filter_state.h\""," #include \"source/extensions/filters/http/ai_protocol_manager/filter_pipeline.h\""," #include \"source/extensions/filters/http/ai_protocol_manager/replay_awaitable.h\""," #include \"source/extensions/filters/http/ai_protocol_manager/serializer.h\"","@@ -157,6 +158,7 @@ class RequestFilterManager::AsyncState"," ","     final_req_ = std::move(*res);","     ASSERT(final_req_ != nullptr);","+    publishRequestProtocol();"," ","     if (always_serialize_) {","       CO_RETURN_IF_ERROR(co_await serializeFinalRequest());","@@ -192,6 +194,18 @@ class RequestFilterManager::AsyncState","     co_return co_await ReplayAwaitable(*buffer_manager_, 0, length);","   }"," ","+  // Names the API a filter detected, which makes the request an AI call to whatever reads the key.","+  void publishRequestProtocol() {","+    const LLMProtocol protocol = final_req_->protocol();","+    if (protocol == LLMProtocol::Unspecified || stream_info_.filterState() == nullptr ||","+        stream_info_.filterState()->hasDataWithName(FilterStateKeys::LlmProtocolRequest)) {","+      return;","+    }","+    stream_info_.filterState()->setData(FilterStateKeys::LlmProtocolRequest,","+                                        std::make_shared<RequestLlmProtocol>(protocol),","+                                        StreamInfo::FilterState::LifeSpan::FilterChain);","+  }","+","   void publishPayloadIndex(JsonWithExtBuf index) {","     if (stream_info_.filterState() != nullptr) {","       stream_info_.filterState()->setData("],"additions":14,"deletions":0,"truncated":false},{"path":"test/extensions/filters/http/ai_protocol_manager/filter_test.cc","lines":["@@ -186,7 +186,7 @@ class AiProtocolManagerFilterTest : public testing::Test {","     filter_->setEncoderFilterCallbacks(encoder_callbacks_);","   }"," ","-  // Parses unconfigured routes too, so a test can show the chain is not run there.","+  // Parses unconfigured routes too, so a test can show the chain runs there.","   void createFilterWithAiFilters(","       AiFilterFactories ai_filter_factories,","       envoy::extensions::filters::http::ai_protocol_manager::v3::RequestHandling::","@@ -1711,11 +1711,11 @@ TEST_F(AiProtocolManagerFilterStateTest, FilterStateDoesNotDeclareARequestThatCa","   }"," }"," ","-TEST_F(AiProtocolManagerFilterTest, DoesNotRunAiFiltersOnUnconfiguredRoute) {","+// A dynamic forward proxy's catch-all route declares no API, but its parsed payload still runs the","+// AI filters.","+TEST_F(AiProtocolManagerFilterTest, RunsAiFiltersOnUnconfiguredRoute) {","   std::vector<ContextRecordingAiFilter::Seen> seen;","-  int built = 0;","   createFilterWithAiFilters({[&](const AiFilterContext& context) -> AiFilterSharedPtr {","-    ++built;","     return std::make_unique<ContextRecordingAiFilter>(context, seen);","   }});","   EXPECT_EQ(decodeHeadersEngaging(), Http::FilterHeadersStatus::StopIteration);","@@ -1724,10 +1724,73 @@ TEST_F(AiProtocolManagerFilterTest, DoesNotRunAiFiltersOnUnconfiguredRoute) {","   EXPECT_EQ(filter_->decodeData(body, true), Http::FilterDataStatus::StopIterationNoBuffer);","   drain();"," ","+  EXPECT_EQ(local_reply_calls_, 0);","+  ASSERT_EQ(seen.size(), 1);","+  EXPECT_EQ(seen[0].protocol, LLMProtocol::Unspecified);","+  EXPECT_EQ(seen[0].request_protocol, LLMProtocol::Unspecified);","+  EXPECT_EQ(seen[0].request_binding, nullptr);","+  EXPECT_EQ(nlohmann::json::parse(injected_.toString())[\"model\"], \"rewritten\");","+  EXPECT_TRUE(injected_end_stream_);","+}","+","+TEST_F(AiProtocolManagerFilterTest, RunsAiFiltersOnUnconfiguredRouteEndedByTrailers) {","+  std::vector<ContextRecordingAiFilter::Seen> seen;","+  createFilterWithAiFilters({[&](const AiFilterContext& context) -> AiFilterSharedPtr {","+    return std::make_unique<ContextRecordingAiFilter>(context, seen);","+  }});","+  EXPECT_EQ(decodeHeadersEngaging(), Http::FilterHeadersStatus::StopIteration);","+","+  Buffer::OwnedImpl body(R\"({\"model\":\"gpt-4\"})\");","+  EXPECT_EQ(filter_->de