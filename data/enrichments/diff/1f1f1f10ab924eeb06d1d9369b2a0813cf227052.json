ectedSsrContent: string,","+      ): Promise<Error> {","+        const html = await ssr(component);","+        const ssrContents = getAppContents(html);","+","+        expect(ssrContents).toContain('<app ngh');","+        expect(ssrContents).toContain(expectedSsrContent);","+","+        resetTViewsFor(component);","+","+        try {","+          await prepareEnvironmentAndHydrate(doc, html, component, {","+            envProviders: [withNoopErrorHandler()],","+          });","+        } catch (e: unknown) {","+          return e as Error;","+        }","+        fail('Expected the hydration process to throw.');","+        return null!;","+      }","+","+      it('should throw when a form control clobbers `form.firstChild`', async () => {","+        @Component({","+          selector: 'app',","+          template: `","+            <form>","+              <span>{{ label }}</span>","+              <div><input [name]=\"key\" /></div>","+              <div>{{ help }}</div>","+            </form>","+          `,","+        })","+        class SimpleComponent {","+          label = 'Label';","+          help = 'Help text';","+          key = 'firstChild';","+","+          constructor() {","+            emulateFormDomClobberingOnClient();","+          }","+        }","+","+        const error = await expectHydrationToFailWithClobbering(","+          SimpleComponent,","+          '<input name=\"firstChild\">',","+        );","+        expect(error.message).toBe(","+          'Action failed because the element is clobbered: <input name=\"firstChild\">',","+        );","+      });","+","+      it('should throw when a form control clobbers `form.firstChild` in production mode (ngDevMode off)', async () => {","+        @Component({","+          selector: 'app',","+          template: `","+            <form>","+              <span>{{ label }}</span>","+              <div><input [name]=\"key\" /></div>","+              <div>{{ help }}</div>","+            </form>","+          `,"