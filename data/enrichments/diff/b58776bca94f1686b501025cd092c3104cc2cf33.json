reads every block as that type. Without","+/// the data type argument, the result type is the stored type of the first block, or STRING before any block.","+/// The single-stage engine accepts convertible explicit types; the multi-stage engine requires the inferred type.","+///"," /// **Example:**"," ///"," /// ```","@@ -58,12 +67,52 @@"," /// ```"," public class AnyValueAggregationFunction extends BaseSingleInputAggregationFunction<Object, Comparable<?>> {","   private static final DataType[] DATA_TYPE_VALUES = DataType.values();","-  // Result type is determined at runtime based on input expression type","+  // Data type argument, or null when the result type is determined at runtime from the input blocks","+  @Nullable","+  private final DataType _dataType;","   private ColumnDataType _resultType;"," ","   public AnyValueAggregationFunction(List<ExpressionContext> arguments, boolean nullHandlingEnabled) {","-    super(verifySingleArgument(arguments, \"ANY_VALUE\"), nullHandlingEnabled);","-    _resultType = null;","+    super(getValueArgument(arguments), nullHandlingEnabled);","+    if (arguments.size() == 2) {","+      ExpressionContext dataTypeArgument = arguments.get(1);","+      Preconditions.checkArgument(dataTypeArgument.getType() == ExpressionContext.Type.LITERAL,","+          \"ANY_VALUE expects the 2nd argument to be literal, got: %s\", dataTypeArgument.getType());","+      String dataType = dataTypeArgument.getLiteral().getStringValue();","+      try {","+        _dataType = DataType.valueOf(dataType.toUpperCase());","+      } catch (IllegalArgumentException e) {","+        throw new BadQueryRequestException(\"Unsupported data type for ANY_VALUE: \" + dataType, e);","+      }","+      _resultType = getResultType(_dataType);","+    } else {","+      _dataType = null;","+    }","+  }","+","+  private static ExpressionContext getValueArgument(List<ExpressionContext> arguments) {","+    int numArguments = arguments.size();","+    Preconditions.checkArgument