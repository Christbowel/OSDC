{"id":"a36dc0e46d98f9fa4306bccd137c74983a30f41c","axis":"silent","repo":"expo/expo","sha":"a36dc0e46d98f9fa4306bccd137c74983a30f41c","parsed":{"files":[{"path":".changeset/autolinking-scan-expo-modules.md","lines":["@@ -0,0 +1,6 @@","+---","+'expo-modules-autolinking': patch","+'expo': patch","+---","+","+[iOS] Detect native module classes annotated with the `@ExpoModule` macro and add them to the generated modules provider automatically, without listing them in `expo-module.config.json`. Generating the modules provider runs the scanner from `expo-modules-macros` once over all package sources and links only the classes that compile for the target platform. When the scan fails, packages that declare their modules still link them, and the build fails if a package relies on the scan for its module classes."],"additions":6,"deletions":0,"truncated":false},{"path":".changeset/scan-migrated-apple-modules.md","lines":["@@ -0,0 +1,8 @@","+---","+'expo-application': patch","+'expo-brownfield': patch","+'expo-haptics': patch","+'expo-sqlite': patch","+---","+","+[iOS] Remove the module class declarations from `expo-module.config.json`. Autolinking now detects the `@ExpoModule`-annotated classes."],"additions":8,"deletions":0,"truncated":false},{"path":"apps/bare-expo/modules/benchmarking/expo-module.config.json","lines":["@@ -1,8 +1,5 @@"," {","   \"platforms\": [\"apple\", \"android\"],","-  \"apple\": {","-    \"modules\": [\"BenchmarkingExpoModule\"]","-  },","   \"android\": {","     \"modules\": [\"expo.modules.benchmark.BenchmarkingExpoModule\"]","   }"],"additions":0,"deletions":3,"truncated":false},{"path":"packages/expo-application/expo-module.config.json","lines":["@@ -1,8 +1,5 @@"," {","   \"platforms\": [\"apple\", \"android\", \"web\"],","-  \"apple\": {","-    \"modules\": [\"ApplicationModule\"]","-  },","   \"android\": {","     \"publication\": {","       \"groupId\": \"host.exp.exponent\","],"additions":0,"deletions":3,"truncated":false},{"path":"packages/expo-brownfield/expo-module.config.json","lines":["@@ -1,8 +1,5 @@"," {","   \"platforms\": [\"apple\", \"android\", \"web\"],","-  \"apple\": {","-    \"modules\": [\"ExpoBrownfieldModule\", \"ExpoBrownfieldStateModule\"]","-  },","   \"android\": {","     \"modules\": [","       \"expo.modules.brownfield.ExpoBrownfieldModule\","],"additions":0,"deletions":3,"truncated":false},{"path":"packages/expo-haptics/expo-module.config.json","lines":["@@ -1,8 +1,5 @@"," {","   \"platforms\": [\"apple\", \"android\"],","-  \"apple\": {","-    \"modules\": [\"HapticsModule\"]","-  },","   \"android\": {","     \"publication\": {","       \"groupId\": \"host.exp.exponent\","],"additions":0,"deletions":3,"truncated":false},{"path":"packages/expo-modules-autolinking/scripts/ios/autolinking_manager.rb","lines":["@@ -84,9 +84,9 @@ class AutolinkingManager","             # `pod install` may fail if there is no `use_modular_headers!` declaration or","             # `:modular_headers => true` is not used for this particular dependency.","             # The latter require adding transitive dependencies to user's Podfile that we'd rather like to avoid.","-            if package.has_something_to_link?","-              use_modular_headers_for_dependencies(pod.spec.all_dependencies)","-            end","+            # Not gated on having something to link: scanned classes are only known when the","+            # provider is generated.","+            use_modular_headers_for_dependencies(pod.spec.all_dependencies)"," ","             debug_configurations = @target_definition.build_configurations ? @target_definition.build_configurations.select { |config| config.include?('Debug') }.keys : ['Debug']"," ","@@ -158,9 +158,9 @@ class AutolinkingManager","       platform = @target_definition.platform"," ","       @packages.select do |package|","-        # Check whether the package has any module to autolink","-        # and if there is any pod that supports target's platform.","-        package.has_something_to_link? && package.pods.any? { |pod| pod.supports_platform?(platform) }","+        # Not gated on having something to link: scanned classes are only known when the","+        # provider is generated.","+        package.pods.any? { |pod| pod.supports_platform?(platform) }","       end","     end"," ","@@ -255,6 +255,7 @@ class AutolinkingManager"," ","     public def generate_modules_provider_command_args(target_name, target_path)","       command_args = ['--target', target_path, '--target-name', target_name, \"--podfile-properties-file-path\", \"\\\"#{@podfile_properties_path}\\\"\"]","+      command_args.concat(['--target-platform', platform_name.downcase])"," ","       if !custom_app_root.nil?","         command_args.concat(['--app-root', custom_app_root])"],"additions":7,"deletions":6,"truncated":false},{"path":"packages/expo-modules-autolinking/scripts/ios/project_integrator.rb","lines":["@@ -323,6 +323,8 @@ def self.generate_support_script(autolinking_manager, target_name, modules_provi","       entitlement_param = entitlement_path.nil? ? '' : \"--entitlement \\\"#{entitlement_path}\\\"\"","       app_root_param = autolinking_manager.custom_app_root.nil? ? '' : \"--app-root \\\"#{autolinking_manager.custom_app_root}\\\"\"","       podfile_properties_param = \"--podfile-properties-file-path \\\"#{autolinking_manager.get_podfile_properties_path()}\\\"\"","+      # Links only the scanned classes that compile for this platform.","+      target_platform_param = \"--target-platform \\\"#{platform}\\\"\""," ","       <<~SUPPORT_SCRIPT","       #!/usr/bin/env bash","@@ -379,6 +381,7 @@ def self.generate_support_script(autolinking_manager, target_name, modules_provi","         #{app_root_param} \\\\","         #{podfile_properties_param} \\\\","         --platform \"apple\" \\\\","+        #{target_platform_param} \\\\","         --packages #{package_names.join(' ')}","       SUPPORT_SCRIPT","     end"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/expo-modules-autolinking/src/ExpoModuleConfig.ts","lines":["@@ -85,6 +85,11 @@ export class ExpoModuleConfig {","     return appleConfig?.modules ?? [];","   }"," ","+  /** Whether the config declares the Apple modules list. Even an empty list disables scanning. */","+  declaresAppleModules(): boolean {","+    return this.getAppleConfig()?.modules != null;","+  }","+","   /**","    * Returns a list of names of Swift classes that receives AppDelegate life-cycle events.","    */"],"additions":5,"deletions":0,"truncated":false},{"path":"packages/expo-modules-autolinking/src/autolinking/__tests__/resolveModules-test.ts","lines":["@@ -0,0 +1,110 @@","+import { getLinkingImplementationForPlatform } from '../../platforms';","+import { resolveModulesAsync } from '../resolveModules';","+","+jest.mock('../../platforms');","+","+const mockGetLinkingImplementation = getLinkingImplementationForPlatform as jest.MockedFunction<","+  typeof getLinkingImplementationForPlatform","+>;","+","+const searchResults = {","+  'expo-clipboard': {","+    name: 'expo-clipboard',","+    path: '/app/node_modules/expo-clipboard',","+    version: '1.0.0',","+  },","+};","+","+const autolinkingOptions = {","+  platform: 'apple' as const,","+  searchPaths: [],","+  nativeModulesDir: null,","+  exclude: [],","+  include: [],","+  legacy_shallowReactNativeLinking: false,","+};","+","+describe(resolveModulesAsync, () => {","+  it('hands the scan results to resolveModuleAsync through extraOutput', async () => {","+    const scannedModules = { 'expo-clipboard': [{ name: null, class: 'ClipboardModule' }] };","+    const resolveModuleAsync = jest.fn().mockResolvedValue({ packageName: 'expo-clipboard' });","+    mockGetLinkingImplementation.mockReturnValue({","+      scanNativeModulesAsync: jest.fn().mockResolvedValue(scannedModules),","+      resolveModuleAsync,","+    } as any);","+","+    await resolveModulesAsync(searchResults, autolinkingOptions, { scanNativeModules: true });","+","+    expect(resolveModuleAsync).toHaveBeenCalledWith(","+      'expo-clipboard',","+      searchResults['expo-clipboard'],","+      expect.objectContaining({ scannedModules })","+    );","+  });","+","+  it('scans for the scan platform while resolving for the umbrella platform', async () => {","+    const scanNativeModulesAsync = jest.fn().mockResolvedValue({});","+    mockGetLinkingImplementation.mockReturnValue({","+      scanNativeModulesAsync,","+      resolveModuleAsync: jest.fn().mockResolvedValue({ packageName: 'expo-clipboard' }),","+    } as any);","+","+    await resolveModulesAsync(searchResults, autolinkingOptions, {","+      scanNativeModules: true,","+      scanPlatform: 'tvos',","+    });","+","+    expect(mockGetLinkingImplementation).toHaveBeenCalledWith('apple');","+    expect(scanNativeModulesAsync).toHaveBeenCalledWith(searchResults, 'tvos');","+  });","+","+  it('does not scan unless the caller asks for it', async () => {","+    // Resolution at pod install must not scan: its result is baked into the generated build phase,","+    // where a scan that failed once would keep a package unlinked until the next pod install.","+    const scanNativeModulesAsync = jest.fn().mockResolvedValue({});","+    const resolveModuleAsync = jest.fn().mockResolvedValue({ packageName: 'expo-clipboard' });","+    mockGetLinkingImplementation.mockReturnValue({","+      scanNativeModulesAsync,","+      resolveModuleAsync,","+    } as any);","+","+    await resolveModulesAsync(searchResults, autolinkingOptions);","+","+    expect(scanNativeModulesAsync).not.toHaveBeenCalled();","+    expect(resolveModuleAsync).toHaveBeenCalledWith(","+      'expo-clipboard',","+      searchResults['expo-clipboard'],","+      expect.objectContaining({ scannedModules: null })","+    );","+  });","+","+  it('resolves without scan results when the platform has no scan hook', async () => {","+    const resolveModuleAsync = jest.fn().mockResolvedValue({ packageName: 'expo-clipboard' });","+    mockGetLinkingImplementation.mockReturnValue({ resolveModuleAsync } as any);","+","+    const result = await resolveModulesAsync(searchResults, autolinkingOptions);","+","+    expect(result).toHaveLength(1);","+    expect(resolveModuleAsync).toHaveBeenCalledWith(","+      'expo-clipboard',","+      searchResults['expo-clipboard'],","+      expect.objectContaining({ scannedModules: null })","+    );","+  });","+","+  it('resolves without scan results when the scan hook throws', async () => {","+    const warn = jest.spyOn(console, 'warn').mockImplementation();","+    const resolveModuleAsync = jest.fn().mockResolvedValue({ packageName: 'expo-clipboard' });","+    mockGetLinkingImplementation.mockReturnValue({","+      scanNativeModulesAsync: jest.fn().mockRejectedValue(new Error('scan exploded')),","+      resolveModuleAsync,","+    } as any);","+","+    const result = await resolveModulesAsync(searchResults, autolinkingOptions, {","+      scanNativeModules: true,","+    });","+","+    expect(result).toHaveLength(1);","+    expect(warn).toHaveBeenCalledWith(expect.stringContaining('scan exploded'));","+  });","+});"],"additions":110,"deletions":0,"truncated":false},{"path":"packages/expo-modules-autolinking/src/autolinking/resolveModules.ts","lines":["@@ -8,14 +8,43 @@ import type {","   SupportedPlatform,"," } from '../types';"," ","+export type ResolveModulesParams = {","+  /**","+   * Whether to scan native sources for annotated module classes, on platforms that support it.","+   * Only the modules provider generation asks for it.","+   */","+  scanNativeModules?: boolean;","+  /** Called with whether the requested scan produced a result. */","+  onScanResult?: (succeeded: boolean) => void;","+  /** The platform to scan for, when narrower than the resolved one (the umbrella `apple`). */","+  scanPlatform?: SupportedPlatform;","+};","+"," /** Resolves search results to a list of platform-specific configuration. */"," export async function resolveModulesAsync(","   searchResults: SearchResults,","-  autolinkingOptions: AutolinkingOptions & { platform: SupportedPlatform }","+  autolinkingOptions: AutolinkingOptions & { platform: SupportedPlatform },","+  { scanNativeModules = false, onScanResult, scanPlatform }: ResolveModulesParams = {}"," ): Promise<ModuleDescriptor[]> {","   const platformLinking = getLinkingImplementationForPlatform(autolinkingOptions.platform);","+  // One scan for all packages, passed down through `extraOutput`. A failed scan never fails","+  // resolution.","+  let scannedModules = null;","+  if (scanNativeModules && 'scanNativeModulesAsync' in platformLinking) {","+    try {","+      scannedModules = await platformLinking.scanNativeModulesAsync(","+        searchResults,","+        scanPlatform ?? autolinkingOptions.platform","+      );","+    } catch (error: any) {","+      console.warn(","+        `warning: Scanning for native modules failed, only modules declared in the module config will be linked: ${error.message ?? error}`","+      );","+    }","+    onScanResult?.(scannedModules != null);","+  }","   // Additional output property for Cocoapods flags","-  const extraOutput = { flags: autolinkingOptions.flags };","+  const extraOutput = { flags: autolinkingOptions.flags, scannedModules };"," ","   const moduleDescriptorList = await taskAll(","     Object.entries(searchResults),"],"additions":31,"deletions":2,"truncated":false},{"path":"packages/expo-modules-autolinking/src/commands/__tests__/generateModulesProviderCommand-test.ts","lines":["@@ -0,0 +1,130 @@","+import { vol } from 'memfs';","+","+import type { ModuleDescriptorIos, SearchResults } from '../../types';","+import { findPackagesMissingScannedModules } from '../generateModulesProviderCommand';","+","+function descriptor(partial: Partial<ModuleDescriptorIos>): ModuleDescriptorIos {","+  return {","+    packageName: 'expo-haptics',","+    pods: [],","+    flags: undefined,","+    modules: [],","+    swiftModuleNames: [],","+    appDelegateSubscribers: [],","+    reactDelegateHandlers: [],","+    debugOnly: false,","+    ...partial,","+  };","+}","+","+function searchResultsFor(","+  packages: Record<string, { declaresAppleModules?: boolean }>","+): SearchResults {","+  return Object.fromEntries(","+    Object.entries(packages).map(([packageName, { declaresAppleModules = false }]) => [","+      packageName,","+      {","+        path: `/app/node_modules/${packageName}`,","+        version: '1.0.0',","+        config: { declaresAppleModules: () => declaresAppleModules },","+      },","+    ])","+  ) as unknown as SearchResults;","+}","+","+const annotatedSource = '@ExpoModule(\"ExpoHaptics\")\\npublic class HapticsModule: Module {}\\n';","+","+afterEach(() => {","+  vol.reset();","+});","+","+describe(findPackagesMissingScannedModules, () => {","+  it('returns nothing when every expected package is present in the resolution', () => {","+    const warn = jest.spyOn(console, 'warn').mockImplementation();","+    expect(","+      findPackagesMissingScannedModules(","+        ['expo-haptics', 'expo-dev-menu'],","+        [","+          descriptor({ modules: [{ name: null, class: 'HapticsModule' }] }),","+          descriptor({","+            packageName: 'expo-dev-menu',","+            reactDelegateHandlers: ['DevMenuHandler'],","+          }),","+        ],","+        true,","+        searchResultsFor({ 'expo-haptics': {}, 'expo-dev-menu': {} })","+      )","+    ).toEqual([]);","+    expect(warn).not.toHaveBeenCalled();","+  });","+","+  it('accepts a package that resolves with nothing to link after a successful scan', () => {","+    // Every package whose pods support the target is passed here, so the ones carrying no modules","+    // at all are expected members of the list rather than a sign of stale state.","+    vol.fromJSON({ '/app/node_modules/expo-haptics/ios/HapticsModule.swift': annotatedSource });","+    const warn = jest.spyOn(console, 'warn').mockImplementation();","+    expect(","+      findPackagesMissingScannedModules(","+        ['expo-haptics'],","+        [descriptor({})],","+        true,","+        searchResultsFor({ 'expo-haptics': {} })","+      )","+    ).toEqual([]);","+    expect(warn).not.toHaveBeenCalled();","+  });","+","+  it('returns an annotated package left empty by a failed scan', () => {","+    vol.fromJSON({ '/app/node_modules/expo-haptics/ios/HapticsModule.swift': annotatedSource });","+    expect(","+      findPackagesMissingScannedModules(","+        ['expo-haptics'],","+        [descriptor({})],","+        false,","+        searchResultsFor({ 'expo-haptics': {} })","+      )","+    ).toEqual(['expo-haptics']);","+  });","+","+  it('ignores a package without annotated classes after a failed scan', () => {","+    vol.fromJSON({","+      '/app/node_modules/expo-modules-core/ios/ModuleHolder.swift': '/// See `@ExpoModule`.\\n',","+    });","+    expect(","+      findPackagesMissingScannedModules(","+        ['expo-modules-core'],","+        [descriptor({ packageName: 'expo-modules-core' })],","+        false,","+        searchResultsFor({ 'expo-modules-core': {} })","+      )","+    ).toEqual([]);","+  });","+","+  it('ignores a package that declares its modules after a failed scan', () => {","+    // A declared list, even an empty one, opts the package out of scanning, so the failed scan","+    // took nothing from it.","+    vol.fromJSON({ '/app/node_modules/expo-haptics/ios/HapticsModule.swift': annotatedSource });","+    expect(","+      findPackagesMissingScannedModules(","+        ['expo-haptics'],","+        [descriptor({})],","+        false,","+        searchResultsFor({ 'expo-haptics': { declaresAppleModules: true } })","+      )","+    ).toEqual([]);","+  });","+","+  it('warns when an expected package is missing from the resolution', () => {","+    const warn = jest.spyOn(console, 'warn').mockImplementation();","+    expect(","+      findPackagesMissingScannedModules(['expo-haptics'], [], true, searchResultsFor({}))","+    ).toEqual([]);","+    expect(warn).toHaveBeenCalledWith(expect.stringMatching(/^warning: .*expo-haptics/));","+  });","+","+  it('ignores resolved packages that were not expected', () => {","+    expect(","+      findPackagesMissingScannedModules([], [descriptor({})], false, searchResultsFor({}))","+    ).toEqual([]);","+  });","+});"],"additions":130,"deletions":0,"truncated":false},{"path":"packages/expo-modules-autolinking/src/commands/generateModulesProviderCommand.ts","lines":["@@ -1,9 +1,12 @@"," import type commander from 'commander';","+import { Option } from 'commander';"," import fs from 'fs';"," "," import { findModulesAsync } from '../autolinking/findModules';"," import { generateModulesProviderAsync } from '../autolinking/generatePackageList';"," import { resolveModulesAsync } from '../autolinking/resolveModules';","+import { hasModuleAnnotations } from '../platforms/apple/moduleScanner';","+import type { SearchResults, SupportedPlatform } from '../types';"," import type { AutolinkingCommonArguments } from './autolinkingOptions';"," import { createAutolinkingOptionsLoader, registerAutolinkingArguments } from './autolinkingOptions';"," ","@@ -13,6 +16,7 @@ interface GenerateModulesProviderArguments extends AutolinkingCommonArguments {","   podfilePropertiesFilePath: string;","   entitlement?: string;","   packages?: string[] | null;","+  targetPlatform?: SupportedPlatform;","   appRoot?: string;"," }"," ","@@ -21,7 +25,41 @@ type PartialPodfileProperties = {","   'expo.inlineModules.xcodeProjectTargets'?: string;"," };"," ","-/** Generates a source file listing all packages to link in the runtime */","+/**","+ * Warns about expected packages missing from the resolution. When the scan failed, returns the","+ * packages left empty that don't declare their modules but have `@ExpoModule` in their sources.","+ */","+export function findPackagesMissingScannedModules(","+  expectedPackageNames: string[],","+  resolvedModules: { packageName: string; modules?: unknown[] }[],","+  scanSucceeded: boolean,","+  searchResults: SearchResults","+): string[] {","+  const modulesByName = new Map(resolvedModules.map((module) => [module.packageName, module]));","+  const packagesMissingModules: string[] = [];","+","+  for (const packageName of expectedPackageNames) {","+    const resolvedModule = modulesByName.get(packageName);","+    if (!resolvedModule) {","+      console.warn(","+        `warning: Package '${packageName}' was integrated at pod install but is missing from the current resolution. Run pod install if it should still be linked.`","+      );","+      continue;","+    }","+    const revision = searchResults[packageName];","+    if (","+      !scanSucceeded &&","+      !resolvedModule.modules?.length &&","+      revision &&","+      !revision.config?.declaresAppleModules() &&","+      hasModuleAnnotations(revision.path)","+    ) {","+      packagesMissingModules.push(packageName);","+    }","+  }","+  return packagesMissingModules;","+}","+"," export function generateModulesProviderCommand(cli: commander.CommanderStatic) {","   return registerAutolinkingArguments(cli.command('generate-modules-provider [searchPaths...]'))","     .option(","@@ -37,6 +75,12 @@ export function generateModulesProviderCommand(cli: commander.CommanderStatic) {","       '-p, --packages <packages...>',","       'Names of the packages to include in the generated modules provider.'","     )","+    .addOption(","+      new Option(","+        '--target-platform <platform>',","+        'The concrete Apple platform the target builds for. Decides which conditionally compiled module classes are linked; without it every scanned class is linked.'","+      ).choices(['ios', 'macos', 'tvos'])","+    )","     .option('--app-root <path>', 'Path to the app root directory.')","     .option('--podfile-properties-file-path <path>', 'Path to the Podfile properties file.')","     .action(","@@ -53,9 +97,16 @@ export function generateModulesProviderCommand(cli: commander.CommanderStatic) {","           autolinkingOptions: await autolinkingOptionsLoader.getPlatformOptions(platform),","           appRoot,","         });","+        let scanSucceeded = false;","         const expoModulesResolveResults = await resolveModulesAsync(","           expoModulesSearchResults,","-          autolinkingOptions","+          { ...autolinkingOptions, platform },","+          // Runs on every build, so a failed scan is retried by the next one.","+          {","+            scanNativeModules: true,","+            scanPlatform: commandArguments.targetPlatform,","+            onScanResult: (succeeded) => (scanSucceeded = succeeded),","+          }","         );"," ","         const includeModules = new Set(commandArguments.packages ?? []);","@@ -63,6 +114,13 @@ export function generateModulesProviderCommand(cli: commander.CommanderStatic) {","           includeModules.has(module.packageName)","         );"," ","+        const packagesMissingModules = findPackagesMissingScannedModules(","+          commandArguments.packages ?? [],","+          filteredModules,","+          scanSucceeded,","+          expoModulesSearchResults","+        );","+","         const podfileProperties: PartialPodfileProperties = await fs.promises","           .readFile(commandArguments.podfilePropertiesFilePath, {","             encoding: 'utf8',","@@ -87,6 +145,14 @@ export function generateModulesProviderCommand(cli: commander.CommanderStatic) {","           inlineModulesTargets,","           appRoot,","         });","+","+        // Otherwise the app would fail at runtime with a missing native module.","+        if (packagesMissingModules.length > 0) {","+          console.error(","+            `error: Scanning for @ExpoModule classes didn't complete (see the warnings above), so the module classes of these packages are missing from the modules provider: ${packagesMissingModules.join(', ')}. Build again to retry the scan, or declare the classes in the package's expo-module.confi