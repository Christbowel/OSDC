elegateFactory.js';","+import { Codicon } from '../../../../../base/common/codicons.js';","+import { Disposable, IDisposable, MutableDisposable } from '../../../../../base/common/lifecycle.js';","+import { ThemeIcon } from '../../../../../base/common/themables.js';","+import { localize } from '../../../../../nls.js';","+import { IConfigurationChangeEvent, IConfigurationService } from '../../../../../platform/configuration/common/configuration.js';","+import { IHoverService } from '../../../../../platform/hover/browser/hover.js';","+import { mcpAllowedServersConfig } from '../../../../../platform/mcp/common/mcpManagement.js';","+import { IOpenerService } from '../../../../../platform/opener/common/opener.js';","+import { COPILOT_ALLOW_MANAGED_HOOKS_ONLY_CONFIG, COPILOT_ALLOW_MANAGED_MCP_SERVERS_ONLY_CONFIG, COPILOT_STRICT_PLUGIN_ONLY_CUSTOMIZATION_CONFIG, getManagedSupportUrl, IManagedSettingsService } from '../../../../../platform/policy/common/copilotManagedSettings.js';","+import { appendContactAdministratorLink } from '../../../../services/policies/browser/organizationSupportLink.js';","+import { AICustomizationManagementSection } from '../../common/aiCustomizationWorkspaceService.js';","+import { ICustomizationOrganizationControl } from '../../common/customizationHarnessService.js';","+","+const $ = DOM.$;","+","+/**","+ * How an organization restricts the customizations of one section.","+ * - `pluginOnly`: only customizations supplied by plugins load.","+ * - `organizationOnly`: only customizations the organization supplies or approves load.","+ * - `allowlist`: only customizations the organization approved by name load.","+ */","+export type CustomizationOrganizationRestriction = 'pluginOnly' | 'organizationOnly' | 'allowlist';","+","+const organizationRestrictionSettings = [","+\tCOPILOT_STRICT_PLUGIN_ONLY_CUSTOMIZATION_CONFIG,","+\tCOPILOT_ALLOW_MANAGED_HOOKS_ONLY_CONFIG,","+\tCOPILOT_ALLOW_MANAGED_MCP_SERVERS_ONLY_CONFIG,","+\tmcpAllowedServersConfig,","+];","+","+function affectsOrganizationRestriction(event: IConfigurationChangeEvent): boolean {","+\treturn organizationRestrictionSettings.some(setting => event.affectsConfiguration(setting));","+}","+","+/**","+ * The restriction an organization's managed policy places on `section`.","+ * Reads only policy values, so a user's own settings never claim to come from their organization.","+ * Customizations excluded by these settings are not listed, so the section explains their absence.","+ */","+export function getCustomizationOrganizationRestriction(configurationService: Pick<IConfigurationService, 'inspect'>, section: string): CustomizationOrganizationRestriction | undefined {","+\tconst policy = <T>(key: string) => configurationService.inspect<T>(key).policyValue;","+\tconst strictPluginOnly = policy<boolean>(COPILOT_STRICT_PLUGIN_ONLY_CUSTOMIZATION_CONFIG) === true;","+\tswitch (section) {","+\t\tcase AICustomizationManagementSection.Skills:","+\t\tcase AICustomizationManagementSection.Agents:","+\t\tcase AICustomizationManagementSection.Instructions:","+\t\t\treturn strictPluginOnly ? 'pluginOnly' : undefined;","+\t\tcase AICustomizationManagementSection.Hooks:","+\t\t\tif (policy<boolean>(COPILOT_ALLOW_MANAGED_HOOKS_ONLY_CONFIG) === true) {","+\t\t\t\treturn 'organizationOnly';","+\t\t\t}","+\t\t\treturn strictPluginOnly ? 'pluginOnly' : undefined;","+\t\tcase AICustomizationManagementSection.McpServers:","+\t\t\tif (strictPluginOnly) {","+\t\t\t\treturn 'pluginOnly';","+\t\t\t}","+\t\t\tif (policy<boolean>(COPILOT_ALLOW_MANAGED_MCP_SERVERS_ONLY_CONFIG) === true) {","+\t\t\t\treturn 'organizationOnly';","+\t\t\t}","+\t\t\treturn Array.isArray(policy<unknown>(mcpAllowedServersConfig)) ? 'allowlist' : undefined;","+\t}","+\treturn undefined;","+}","+","+/** Explains an organization-managed customization, including any enablement it requires. */","+export function getOrganizationManagedTooltip(control: ICustomizationOrganizationControl): string {","+\tswitch (control.requiredEnabled) {","+\t\tcase true:","+\t\t\treturn localize('organizationManagedEnabled', \"Managed by your organization. It is always enabled and can't be disabled.\");","+\t\tcase false:","+\t\t\treturn localize('organizationManagedDisabled', \"Managed by your organization. It is disabled and can't be enabled.\");","+\t\tdefault:","+\t\t\treturn localize('organizationManaged', \"Managed by your organization.\");","+\t}","+}","+","+/** The \"Managed\" tag shown next to the name of an organization-managed customization. */","+export class OrganizationManagedTag extends Disposable {","+","+\tprivate readonly element: HTMLElement;","+\tprivate readonly hover: IManagedHover;","+","+\tconstructor(container: HTMLElement, hoverService: IHoverService) {","+\t\tsuper();","+\t\tthis.element = DOM.append(container, $('.inline-badge.organization-managed-tag'));","+\t\tDOM.append(this.element, $(`span${ThemeIcon.asCSSSelector(Codicon.shield)}`, { 'aria-hidden': 'true' }));","+\t\tDOM.append(this.element, $('span')).textContent = localize('organizationManagedTag', \"Managed\");","+\t\tthis.hover = this._register(hoverService.setupManagedHover(getDefaultHoverDelegate('mouse'), this.element, ''));","+\t\tthis.update(undefined);","+\t}","+","+\t/** Shows the tag for `control`, or hides it when the customization isn't organization managed. */","+\tupdate(control: ICustomizationOrganizationControl | undefined): void {","+\t\tconst tooltip = control ? getOrganizationManagedTooltip(control) : '';","+\t\tthis.element.style.display = control ? '' : 'none';","+\t\tthis.element.setAttribute('aria-label', tooltip);","+\t\tthis.hover.update(tooltip);","+\t}","+}","+","+function getRestrictionMessage(section: string, restriction: CustomizationOrganizationRestriction): string | undefined {","+\tswitch (section) {","+\t\tcase AICustomizationManagementSection.Skills:","+\t\t\treturn localize('organizationSkillsPluginOnly', \"Your organization only allows skills from plugins. Other skills are hidden.\");","+\t\tcase AICustomizationManagementSection.Agents:","+\t\t\treturn localize('organizationAgentsPluginOnly', \"Your organization only allows agents from plugins. Other agents are hidden.\");","+\t\tcase AICustomizationManagementSection.Instructions:","+\t\t\treturn localize('organizationInstructionsPluginOnly', \"Your organization only allows instructions from plugins. Other instructions are hidden.\");","+\t\tcase AICustomizationManagementSection.Hooks:","+\t\t\treturn restriction === 'organizationOnly'","+\t\t\t\t? localize('organizationHooksOrganizationOnly', \"Your organization only allows hooks it provides. Other hooks are hidden.\")","+\t\t\t\t: localize('organizationHooksPluginOnly', \"Your organization only allows hooks from plugins. Other hooks are hidden.\");","+\t\tcase AICustomizationManagementSection.McpServers:","+\t\t\tswitch (restriction) {","+\t\t\t\tcase 'pluginOnly': return localize('organizationMcpPluginOnly', \"Your organization only allows MCP servers from plugins. Other servers are hidden.\");","+\t\t\t\tcase 'organizationOnly': return localize('organizationMcpOrganizationOnly', \"Your organization only allows MCP servers it provides or approves. Other servers are hidden.\");","+\t\t\t\tcase 'allowlist': return localize('organizationMcpAllowlist', \"Your organization only allows approved MCP servers. Other servers are hidden.\");","+\t\t\t}","+\t}","+\treturn undefined;","+}","+","+/** A notice explaining that the user's organization restricts which customizations of a section load. */","+export class CustomizationOrganizationPolicyNotice extends Disposable {","+","+\treadonly element: HTMLElement;","+\tprivate readonly message: HTMLElement;","+\tprivate readonly supportLink = this._register(new MutableDisposable<IDisposable>());","+\tprivate section: string | undefined;","+","+\tconstructor(","+\t\t@IConfigurationService private readonly configurationService: IConfigurationService,","+\t\t@IHoverService private readonly hoverService: IHoverService,","+\t\t@IOpenerService private readonly openerService: IOpenerService,","+\t\t@IManagedSettingsService private readonly managedSettingsService: IManagedSettingsService,","+\t) {","+\t\tsuper();","+\t\tthis.element = $('.organization-policy-notice', { role: 'note' });","+\t\tDOM.append(this.element, $(`.organization-policy-notice-icon${ThemeIcon.asCSSSelector(Codicon.shield)}`, { 'aria-hidden': 'true' }));","+\t\tthis.message = DOM.append(this.element, $('.organization-policy-notice-message'));","+\t\tthis.element.style.display = 'none';","+\t\tthis._register(this.configurationService.onDidChangeConfiguration(e => {","+\t\t\tif (affectsOrganizationRestriction(e)) {","+\t\t\t\tthis.render();","+\t\t\t}","+\t\t}));","+\t\tthis._register(this.managedSettingsService.onDidChangeManagedSettings(() => this.render()));","+\t}","+","+\t/** Shows the notice for `section`, or hides it when the organization doesn't restrict it. */","+\tsetSection(section: string): void {","+\t\tthis.section = section;","+\t\tthis.render();","+\t}","+","+\tprivate render(): void {","+\t\tconst restriction = this.section ? getCustomizationOrganizationRestriction(this.configurationService, this.section) : undefined;","+\t\tconst text = this.section && restriction ? getRestrictionMessage(this.section, restriction) : undefined;","+\t\tthis.supportLink.clear();","+\t\tDOM.clearNode(this.message);","+\t\tif (!text) {","+\t\t\tthis.element.style.display = 'none';","+\t\t\treturn;","+\t\t}","+\t\tthis.element.style.display = '';","+\t\tthis.message.appendChild(document.createTextNode(text));","+\t\tconst supportUrl = getManagedSupportUrl(this.managedSettingsService);","+\t\tif (supportUrl) {","+\t\t\tthis.message.appendChild(document.createTextNode(' '));","+\t\t\tthis.supportLink.value = appendContactAdministratorLink(this.message, 'section-title-link', supportUrl, this.openerService, this.hoverService);","+\t\t}","+\t}","+}"],"additions":181,"deletions":0,"truncated":false},{"path