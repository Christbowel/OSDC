{"id":"186505d2bd01f3564a67f6917515747769d1709c","axis":"silent","repo":"sidorares/node-mysql2","sha":"186505d2bd01f3564a67f6917515747769d1709c","parsed":{"files":[{"path":"lib/base/connection.js","lines":["@@ -22,12 +22,12 @@ const EventEmitter = require('events').EventEmitter;"," const Readable = require('stream').Readable;"," const Queue = require('../ring_queue.js');"," const SqlString = require('sql-escaper');","-const { createLRU } = require('lru.min');"," const PacketParser = require('../packet_parser.js');"," const Packets = require('../packets/index.js');"," const Commands = require('../commands/index.js');"," const ConnectionConfig = require('../connection_config.js');"," const TlsSessionSlot = require('../tls_session_cache.js');","+const createStatementCache = require('../statement_cache.js');"," const CharsetToEncoding = require('../constants/charset_encodings.js');"," const ServerStatus = require('../constants/server_status.js');"," const {","@@ -128,12 +128,7 @@ class BaseConnection extends EventEmitter {","     this._command = null;","     this._paused = false;","     this._paused_packets = new Queue();","-    this._statements = createLRU({","-      max: this.config.maxPreparedStatements,","-      onEviction: function (_, statement) {","-        statement.close();","-      },","-    });","+    this._statements = createStatementCache(this.config.maxPreparedStatements);","     this.serverCapabilityFlags = 0;","     this.serverStatus = 0;","     this._sqlModeOverride = null;"],"additions":2,"deletions":7,"truncated":false},{"path":"lib/connection_config.js","lines":["@@ -204,7 +204,11 @@ class ConnectionConfig {","       ...defaultConnectAttributes,","       ...(options.connectAttributes || {}),","     };","-    this.maxPreparedStatements = options.maxPreparedStatements || 16000;","+    const { maxPreparedStatements = 16000 } = options;","+    if (!Number.isInteger(maxPreparedStatements) || maxPreparedStatements < 1) {","+      throw new TypeError('maxPreparedStatements must be a positive integer');","+    }","+    this.maxPreparedStatements = maxPreparedStatements;","     this.jsonStrings = options.jsonStrings || false;","     this.gracefulEnd = options.gracefulEnd || false;","   }"],"additions":5,"deletions":1,"truncated":false},{"path":"lib/statement_cache.js","lines":["@@ -0,0 +1,30 @@","+'use strict';","+","+const { createLRU } = require('lru.min');","+","+const INITIAL_CAPACITY = 16;","+","+function closeStatement(_key, statement) {","+  statement.close();","+}","+","+// lru.min allocates every slot of `max` up front, so the cache starts small","+// and doubles on demand until it reaches `limit`.","+function createStatementCache(limit) {","+  const statements = createLRU({","+    max: Math.min(limit, INITIAL_CAPACITY),","+    onEviction: closeStatement,","+  });","+  const set = statements.set;","+","+  statements.set = function (key, statement) {","+    if (statements.size === statements.max && statements.max < limit) {","+      statements.resize(Math.min(statements.max * 2, limit));","+    }","+    return set.call(statements, key, statement);","+  };","+","+  return statements;","+}","+","+module.exports = createStatementCache;"],"additions":30,"deletions":0,"truncated":false},{"path":"test/common.test.mts","lines":["@@ -103,6 +103,7 @@ export const createConnection = function (args?: ConnectionOptions) {","     jsonStrings: args && args.jsonStrings,","     disableEval,","     flags: args && args.flags,","+    maxPreparedStatements: args && args.maxPreparedStatements,","   };"," ","   const conn = driver.createConnection(params);"],"additions":1,"deletions":0,"truncated":false},{"path":"test/integration/connection/test-execute-statement-cache-limit.test.mts","lines":["@@ -0,0 +1,83 @@","+import type { Connection, RowDataPacket } from '../../../promise.js';","+import { describe, it, strict } from 'poku';","+import { createConnection } from '../../common.test.mjs';","+","+type Counters = { prepared: number; closed: number };","+","+const readCounters = async (connection: Connection): Promise<Counters> => {","+  const [rows] = await connection.query<RowDataPacket[]>(","+    \"SHOW SESSION STATUS WHERE Variable_name IN ('Com_stmt_prepare', 'Com_stmt_close')\"","+  );","+  const value = (name: string) =>","+    Number(rows.find((row) => row.Variable_name === name)?.Value);","+","+  return {","+    prepared: value('Com_stmt_prepare'),","+    closed: value('Com_stmt_close'),","+  };","+};","+","+const executeEach = async (connection: Connection, ids: number[]) => {","+  for (const id of ids) {","+    const [rows] = await connection.execute<RowDataPacket[]>(","+      `SELECT ${id} AS id`","+    );","+    strict.deepEqual(rows, [{ id }]);","+  }","+};","+","+const range = (from: number, to: number) =>","+  Array.from({ length: to - from }, (_, index) => from + index);","+","+await describe('Statement cache: default limit keeps statements past the initial capacity', async () => {","+  const base = createConnection();","+  const connection = base.promise();","+  const before = await readCounters(connection);","+","+  await executeEach(connection, range(0, 40));","+  await executeEach(connection, range(0, 40));","+  const after = await readCounters(connection);","+","+  it('prepares each statement once and closes none', () => {","+    strict.equal(after.prepared - before.prepared, 40);","+    strict.equal(after.closed - before.closed, 0);","+    // @ts-expect-error: internal access","+    strict.equal(base._statements.size, 40);","+  });","+","+  await connection.end();","+});","+","+await describe('Statement cache: closes the least recently used statement at maxPreparedStatements', async () => {","+  const base = createConnection({ maxPreparedStatements: 20 });","+  const connection = base.promise();","+  const before = await readCounters(connection);","+","+  await executeEach(connection, range(0, 25));","+  const filled = await readCounters(connection);","+","+  await executeEach(connection, [24]);","+  const cachedHit = await readCounters(connection);","+","+  await executeEach(connection, [0]);","+  const evictedMiss = await readCounters(connection);","+","+  it('closes only the statements beyond the limit', () => {","+    strict.equal(filled.prepared - before.prepared, 25);","+    strict.equal(filled.closed - before.closed, 5);","+    // @ts-expect-error: internal access","+    strict.equal(base._statements.size, 20);","+  });","+","+  it('reuses a cached statement without preparing it again', () => {","+    strict.equal(cachedHit.prepared, filled.prepared);","+    strict.equal(cachedHit.closed, filled.closed);","+  });","+","+  it('prepares an evicted statement again and evicts the next oldest', () => {","+    strict.equal(evictedMiss.prepared - cachedHit.prepared, 1);","+    strict.equal(evictedMiss.closed - cachedHit.closed, 1);","+  });","+","+  await connection.end();","+});"],"additions":83,"deletions":0,"truncated":false},{"path":"test/unit/connection/test-connection_config.test.mts","lines":["@@ -105,3 +105,53 @@ describe('ConnectionConfig', () => {","     );","   });"," });","+","+describe('ConnectionConfig: maxPreparedStatements', () => {","+  const isLimitError = (err: unknown) =>","+    err instanceof TypeError &&","+    err.message === 'maxPreparedStatements must be a positive integer';","+","+  it('should default to 16000', () => {","+    strict.equal(new ConnectionConfig({}).maxPreparedStatements, 16000);","+  });","+","+  it('should accept a positive integer', () => {","+    strict.equal(","+      new ConnectionConfig({ maxPreparedStatements: 1 }).maxPreparedStatements,","+      1","+    );","+    strict.equal(","+      new ConnectionConfig(","+        'mysql://test:pass@localhost/db?maxPreparedStatements=64'","+      ).maxPreparedStatements,","+      64","+    );","+  });","+","+  for (const maxPreparedStatements of [","+    0,","+    -1,","+    1.5,","+    NaN,","+    Infinity,","+    '100',","+    null,","+  ]) {","+    it(`should reject ${String(maxPreparedStatements)} instead of falling back to the default`, () => {","+      strict.throws(","+        () => new ConnectionConfig({ maxPreparedStatements }),","+        isLimitError","+      );","+    });","+  }","+","+  it('should reject 0 from a URL', () => {","+    strict.throws(","+      () =>","+        new ConnectionConfig(","+          'mysql://test:pass@localhost/db?maxPreparedStatements=0'","+        ),","+      isLimitError","+    );","+  });","+});"],"additions":50,"deletions":0,"truncated":false},{"path":"test/unit/connection/test-statement-cache.test.mts","lines":["@@ -0,0 +1,71 @@","+import { describe, it, strict } from 'poku';","+import createStatementCache from '../../../lib/statement_cache.js';","+","+type FakeStatement = { id: number; close: () => void };","+","+const fill = (limit: number, count: number) => {","+  const closed: number[] = [];","+  const cache = createStatementCache(limit);","+  const capacities: number[] = [];","+","+  for (let id = 0; id < count; id++) {","+    const statement: FakeStatement = { id, close: () => closed.push(id) };","+    cache.set(`SELECT ${id}`, statement);","+    capacities.push(cache.max);","+  }","+","+  return { cache, closed, capacities };","+};","+","+describe('Statement cache: grows on demand up to maxPreparedStatements', () => {","+  it('allocates a small cache regardless of the limit', () => {","+    strict.equal(createStatementCache(16000).max, 16);","+    strict.equal(createStatementCache(4).max, 4);","+  });","+","+  it('doubles its capacity only when full, capped at the limit', () => {","+    const { cache, closed, capacities } = fill(40, 40);","+","+    strict.equal(capacities[15], 16);","+    strict.equal(capacities[16], 32);","+    strict.equal(capacities[31], 32);","+    strict.equal(capacities[32], 40);","+    strict.equal(cache.max, 40);","+    strict.equal(cache.size, 40);","+    strict.deepEqual(closed, []);","+  });","+","+  it('closes the least recently used statement once the limit is reached', () => {","+    const { cache, closed } = fill(40, 40);","+","+    cache.get('SELECT 0');","+    cache.set('SELECT 40', { id: 40, close: () => closed.push(40) });","+","+    strict.equal(cache.max, 40);","+    strict.equal(cache.size, 40);","+    strict.deepEqual(closed, [1]);","+    strict.equal(cache.has('SELECT 0'), true);","+    strict.equal(cache.has('SELECT 1'), false);","+  });","+","+  it('keeps every statement reachable across growth', () => {","+    const { cache } = fill(16000, 100);","+","+    strict.equal(cache.max, 128);","+    for (let id = 0; id < 100; id++) {","+      strict.equal(cache.get(`SELECT ${id}`)?.id, id);","+    }","+  });","+","+  it('closes every statement on clear', () => {","+    const { cache, closed } = fill(16000, 20);","+","+    cache.clear();","+","+    strict.equal(cache.size, 0);","+    strict.deepEqual(","+      closed.sort((a, b) => a - b),","+      Array.from({ length: 20 }, (_, id) => id)","+    );","+  });","+});"],"additions":71,"deletions":0,"truncated":false},{"path":"typings/mysql/lib/Connection.d.ts","lines":["@@ -306,6 +306,13 @@ export interface ConnectionOptions {"," ","   isServer?: boolean;"," ","+  /**","+   * Maximum number of prepared statements cached per connection. The cache grows","+   * as statements are prepared, and the least recently used statement is closed","+   * once the limit is reached. Must be a positive integer.","+   *","+   * (Default: 16000)","+   */","   maxPreparedStatements?: number;"," ","   namedPlaceholders?: boolean;"],"additions":7,"deletions":0,"truncated":false},{"path":"website/docs/documentation/prepared-statements.mdx","lines":["@@ -45,7 +45,9 @@ Note that you should not use statement after connection reset (`changeUser()`, ["," "," ## Configuration"," ","-`maxPreparedStatements` : We keep the cached statements in a [lru-cache](https://github.com/isaacs/node-lru-cache). Default size is `16000` but you can use this option to override it. Any statements that are dropped from cache will be `closed`.","+`maxPreparedStatements` : Each connection keeps its prepared statements in an LRU cache that grows as statements are prepared, up to this limit. Default is `16000`, and the value must be a positive integer. Once the limit is reached, the least recently used statement is dropped from the cache and `closed`.","+","+Keep the limit in mind across connections: the MySQL server caps prepared statements for all connections together with [`max_prepared_stmt_count`](https://dev.mysql.com/doc/refman/8.4/en/server-system-variables.html#sysvar_max_prepared_stmt_count) (default `16382`)."," "," ## Serialization of bind parameters"," ",""],"additions":3,"deletions":1,"truncated":false}],"additions":252,"deletions":9,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-27T19:02:51.048696+00:00"}