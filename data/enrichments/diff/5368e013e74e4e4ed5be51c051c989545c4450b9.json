.await?`.","+","+use crate as turbo_tasks;","+","+/// A `u64` cell that is persisted at its full 8 bytes. Use this for hashes, or other values that","+/// usually use more than 32 bits.","+///","+/// Reads as a plain `u64`.","+#[turbo_tasks::value(transparent)]","+pub struct FixintU64(#[bincode(fixint)] u64);","+","+/// A `u128` cell that is persisted at its full 16 bytes. Use this for hashes, or other values","+/// that usually use more than 64 bits.","+///","+/// Reads as a plain `u128`.","+#[turbo_tasks::value(transparent)]","+pub struct FixintU128(#[bincode(fixint)] u128);","+","+#[cfg(test)]","+mod tests {","+    use bincode::{Decode, Encode};","+    use turbo_bincode::{TurboBincodeBuffer, new_turbo_bincode_decoder, new_turbo_bincode_encoder};","+","+    use super::*;","+","+    fn roundtrip<T: Encode + Decode<()>>(value: &T) -> (usize, T) {","+        let mut buf = TurboBincodeBuffer::new();","+        value","+            .encode(&mut new_turbo_bincode_encoder(&mut buf))","+            .unwrap();","+        let decoded = T::decode(&mut new_turbo_bincode_decoder(&buf)).unwrap();","+        (buf.len(), decoded)","+    }","+","+    #[test]","+    fn encodes_at_natural_width() {","+        // Small and large values take the same space: a varint would use 1 and 9/17 bytes.","+        for value in [1, u64::MAX] {","+            let (len, decoded) = roundtrip(&FixintU64(value));","+            assert_eq!(len, 8);","+            assert_eq!(decoded.0, value);","+        }","+        for value in [1, u128::MAX] {","+            let (len, decoded) = roundtrip(&FixintU128(value));","+            assert_eq!(len, 16);","+            assert_eq!(decoded.0, value);","+        }","+    }","+}"],"additions":60,"deletions":0,"truncated":false},{"path":"turbopack/crates/turbo-tasks/src/id.rs","lines":["@@ -9,11 +9,10 @@ use bincode::{","     Decode, Encode,","     de::Decoder,","     enc::Encoder,","-    error::{DecodeError, EncodeError, IntegerType},","+    error::{DecodeError, 