ingify!($ty), \"` written by [`\", stringify!($encode), \"`].\")]","-        #[inline]","-        pub fn $decode<D: Decoder>(decoder: &mut D) -> Result<$ty, DecodeError> {","-            let mut bytes = [0u8; size_of::<$ty>()];","-            decoder.claim_bytes_read(bytes.len())?;","-            decoder.reader().read(&mut bytes)?;","-            Ok(<$ty>::from_le_bytes(bytes))","-        }","-    )*};","-}","-","-fixed_width! {","-    u8: encode_u8, decode_u8;","-    u16: encode_u16, decode_u16;","-    u32: encode_u32, decode_u32;","-    u64: encode_u64, decode_u64;","-}","-","-#[cfg(test)]","-mod tests {","-    use super::*;","-    use crate::{TurboBincodeBuffer, new_turbo_bincode_decoder, new_turbo_bincode_encoder};","-","-    #[test]","-    fn roundtrip_at_natural_width() {","-        let mut buf = TurboBincodeBuffer::new();","-        let mut encoder = new_turbo_bincode_encoder(&mut buf);","-        encode_u8(&mut encoder, 3).unwrap();","-        encode_u16(&mut encoder, 7).unwrap();","-        encode_u32(&mut encoder, u32::MAX).unwrap();","-        encode_u64(&mut encoder, 1 << 40).unwrap();","-        assert_eq!(buf.len(), 1 + 2 + 4 + 8);","-","-        let mut decoder = new_turbo_bincode_decoder(&buf);","-        assert_eq!(decode_u8(&mut decoder).unwrap(), 3);","-        assert_eq!(decode_u16(&mut decoder).unwrap(), 7);","-        assert_eq!(decode_u32(&mut decoder).unwrap(), u32::MAX);","-        assert_eq!(decode_u64(&mut decoder).unwrap(), 1 << 40);","-        assert!(decode_u16(&mut decoder).is_err());","-    }","-}"],"additions":0,"deletions":67,"truncated":false},{"path":"turbopack/crates/turbo-bincode/src/lib.rs","lines":["@@ -1,4 +1,3 @@","-pub mod fixed_width;"," mod len_prefixed;"," #[doc(hidden)]"," pub mod macro_helpers;"],"additions":0,"deletions":1,"truncated":false},{"path":"turbopack/crates/turbo-tasks-backend/src/backend/gc.rs","lines":["@@ -64,7 +64,7 @@ pub enum TtlCounter {","     /// Pinned, or found as a root, by the most recent pass."