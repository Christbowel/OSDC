","+\t\t\tw.Header().Set(\"X-Frame-Options\", \"DENY\")","+\t\t}","+\t\tw.headerWritten = true","+\t\tw.ResponseWriter.WriteHeader(http.StatusOK)","+\t}","+\treturn w.ResponseWriter.Write(b)","+}","+","+// Flush implements http.Flusher interface","+func (w *cspResponseWriter) Flush() {","+\tif flusher, ok := w.ResponseWriter.(http.Flusher); ok {","+\t\tflusher.Flush()","+\t}","+}","+"," // Handler is the http.Handler that serves the Consul UI. It may serve from the"," // embedded fs.FS or from an external directory. It provides a few important"," // transformations on the index.html file and includes a proxy for metrics","@@ -67,6 +107,9 @@ func NewHandler(runtimeCfg *config.RuntimeConfig, logger hclog.Logger, transform"," "," // ServeHTTP implements http.Handler and serves UI HTTP requests"," func (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {","+\t// Wrap the response writer to inject CSP headers for HTML responses","+\tw = &cspResponseWriter{ResponseWriter: w}","+"," \t// We need to support the path being trimmed by http.StripTags just like the"," \t// file servers do since http.StripPrefix will remove the leading slash in our"," \t// current config. Everything else works fine that way so we should to."],"additions":43,"deletions":0,"truncated":false},{"path":"ui/packages/consul-ui/ember-cli-build.js","lines":["@@ -158,6 +158,10 @@ module.exports = function (defaults, $ = process.env) {","       },","       trees: trees,","       addons: addons,","+      fingerprint: {","+        // referenced by name from the extensionless oidc/callback page","+        exclude: ['oidc/callback.js'],","+      },","       'ember-cli-babel': {","         includePolyfill: false,","       },"],"additions":4,"deletions":0,"truncated":false},{"path":"ui/packages/consul-ui/public/oidc/callback","lines":["@@ -3,17 +3,6 @@","   <head>","     <meta charset=\"UTF-8\">","     <title>Consul</title>","-    <script>","-      var CURRENT_REQUEST_KEY = '__torii_request';","-    