ardOpenOption;","+import java.util.Arrays;","+import org.apache.lucene.search.DocIdSetIterator;","+import org.apache.lucene.util.IOUtils;","+import org.apache.lucene.util.hnsw.HnswGraph;","+import org.apache.pinot.segment.spi.index.creator.VectorIndexConfig;","+","+","+/// Mutable merge graph with neighbor IDs and scores stored in a confined temporary mapping.","+final class MmapHnswGraph extends HnswGraph implements Closeable {","+  private static final int WINDOW_BYTES = 1 << 20;","+","+  private final FileChannel _channel;","+  private final ByteBuffer _reservationBuffer = ByteBuffer.allocate(64 << 10);","+  private final Arena _arena = Arena.ofConfined();","+  private final MmapHnswNeighborList[][] _nodes;","+  private final int _maxConn;","+","+  private int[] _levelCounts = new int[4];","+  private int[][] _upperLevelNodes;","+  private MemorySegment _window;","+  private int _windowPosition = WINDOW_BYTES;","+  private long _nextFileOffset;","+  private int _entryNode = -1;","+  private int _numLevels;","+  private MmapHnswNeighborList _current;","+  private int _currentNeighbor;","+","+  static MmapHnswGraph open(Path directory, int vectorCount, int maxConn)","+      throws IOException {","+    Path file;","+    try {","+      file = Files.createTempFile(directory, \"hnsw-merge-\", \".adjacency\");","+    } catch (IOException e) {","+      throw scratchFailure(e);","+    }","+    FileChannel channel = null;","+    try {","+      channel = FileChannel.open(file, StandardOpenOption.READ, StandardOpenOption.WRITE,","+          StandardOpenOption.DELETE_ON_CLOSE);","+      return new MmapHnswGraph(channel, vectorCount, maxConn);","+    } catch (IOException | RuntimeException | Error e) {","+      IOUtils.closeWhileHandlingException(channel);","+      try {","+        Files.deleteIfExists(file);","+      } catch (IOException cleanup) {","+        e.addSuppressed(cleanup);","+      }","+      if (e instanceof IOException ioException) {","+        throw scratchFailure(ioException);","+      }","+      throw e;","+    }","+  }","+","+  private MmapHnswGraph(FileChannel channel, int vectorCount, int maxConn) {","+    _channel = channel;","+    _nodes = new MmapHnswNeighborList[vectorCount][];","+    _maxConn = maxConn;","+  }","+","+  boolean contains(int node) {","+    return _nodes[node] != null;","+  }","+","+  void addNode(int node, int topLevel)","+      throws IOException {","+    assert !contains(node);","+    if (topLevel >= _levelCounts.length) {","+      _levelCounts = Arrays.copyOf(_levelCounts, topLevel + 1);","+    }","+    MmapHnswNeighborList[] levels = new MmapHnswNeighborList[topLevel + 1];","+    for (int level = topLevel; level >= 0; level--) {","+      // Allow one unused slot for the candidate before pruning an overfull neighbor list.","+      levels[level] = allocate(neighborLimit(level) + 1);","+      _levelCounts[level]++;","+    }","+    _nodes[node] = levels;","+  }","+","+  void setEntryNode(int node, int level) {","+    _entryNode = node;","+    _numLevels = level + 1;","+  }","+","+  int neighborLimit(int level) {","+    return level == 0 ? 2 * _maxConn : _maxConn;","+  }","+","+  MmapHnswNeighborList neighbors(int level, int node) {","+    return _nodes[node][level];","+  }","+","+  @Override","+  public void seek(int level, int target) {","+    _current = neighbors(level, target);","+    _currentNeighbor = 0;","+  }","+","+  @Override","+  public int nextNeighbor() {","+    return _currentNeighbor < _current.size() ? _current.node(_currentNeighbor++) : DocIdSetIterator.NO_MORE_DOCS;","+  }","+","+  @Override","+  public int size() {","+    return _levelCounts[0];","+  }","+","+  @Override","+  public int maxNodeId() {","+    return _nodes.length - 1;","+  }","+","+  @Override","+  public int numLevels() {","+    return _numLevels;","+  }","+","+  @Override","+  public int entryNode() {","+    return _entryNode;","+  }","+","+  @Override","+  public NodesIterator getNodesOnLevel(int level) {","+    assert size() == _nodes.length : \"graph build is incomplete\";","+    if (level == 0) {","+      return new ArrayNodesIterator(_nodes.length);","+    }","+    if (_upperLevelNodes == null) {","+      _upperLevelNodes = new int[_numLevels][];","+      int[] offsets = new int[_numLevels];","+      for (int upperLevel = 1; upperLevel < _numLevels; upperLevel++) {","+        _upperLevelNodes[upperLevel] = new int[_levelCounts[upperLevel]];","+      }","+      for (int node = 0; node < _nodes.length; node++) {","+        for (int upperLevel = 1; upperLevel < _nodes[node].length; upperLevel++) {","+          _upperLevelNodes[upperLevel][offsets[upperLevel]++] = node;","+        }","+      }","+    }","+    return new ArrayNodesIterator(_upperLevelNodes[level], _levelCounts[level]);","+  }","+","+  private MmapHnswNeighborList allocate(int capacity)","+      throws IOException {","+    int bytes = capacity * MmapHnswNeighborList.EDGE_BYTES;","+    assert bytes <= WINDOW_BYTES;","+    if (_windowPosition + bytes > WINDOW_BYTES) {","+      try {","+        reserveWindow();","+        _window = _channel.map(FileChannel.MapMode.READ_WRITE, _nextFileOffset, WINDOW_BYTES, _arena);","+      } catch (IOException e) {","+        throw scratchFailure(e);","+      }","+      _nextFileOffset += WINDOW_BYTES;","+      _windowPosition = 0;","+    }","+    MmapHnswNeighborList list = new MmapHnswNeighborList(_window, _windowPosition, capacity);","+    _windowPosition += bytes;","+    return list;","+  }","+","+  private static IOException scratchFailure(IOException cause) {","+    return new IOException(\"Failed to allocate local HNSW merge scratch space. Check the build directory or set \"","+        + VectorIndexConfig.MMAP_GRAPH_ON_MERGE + \" to false\", cause);","+  }","+","+  private void reserveWindow()","+      throws IOException {","+    // Write and force the range before mapping so disk allocation failure can surface as IOException.","+    long end = _nextFileOffset + WINDOW_BYTES;","+    for (long offset = _nextFileOffset; offset < end; ) {","+      _reservationBuffer.clear();","+      _reservationBuffer.limit((int) Math.min(_reservationBuffer.capacity(), end - offset));","+      while (_reservationBuffer.hasRemaining()) {","+        int written = _channel.write(_reservationBuffer, offset);","+        if (written == 0) {","+          throw new IOException(\"Failed to reserve HNSW merge adjacency at offset \" + offset);","+        }","+        offset += written;","+      }","+    }","+    _channel.force(false);","+  }","+","+  @Override","+  public void close()","+      throws IOException {","+    try (_channel; _arena) {","+      // Resources close in reverse order, unmapping before the channel closes.","+    }","+  }","+}"],"additions":223,"deletions":0,"truncated":false},{"path":"pinot-segment-local/src/main/java/org/apache/pinot/segment/local/segment/creator/impl/vector/lucene99/MmapHnswGraphBuilder.java","lines":["@@ -0,0 +1,404 @@","+/**","+ * Licensed to the Apache Software Foundation (ASF) under one","+ * or more contributor license agreements.  See the NOTICE file","+ * distributed with this work for additional information","+ * regarding copyright ownership.  The ASF licenses this file","+ * to you under the Apache License, Version 2.0 (the","+ * \"License\"); you may not use this file except in compliance","+ * with the License.  You may obtain a copy of the License at","+ *","+ *   http://www.apache.org/licenses/LICENSE-2.0","+ *","+ * Unless required by applicable law or agreed to in writing,","+ * software distributed under the License is distributed on an","+ * \"AS IS\" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY","+ * KIND, either express or implied.  See the License for the","+ * specific language governing permissions and limitations","+ * under the License.","+ */","+package org.apache.pinot.segment.local.segment.creator.impl.vector.lucene99;","+","+import java.io.IOException;","+import java.nio.file.Path;","+import java.util.ArrayList;","+import java.util.List;","+import java.util.SplittableRandom;","+import javax.annotation.Nullable;","+import org.apache.lucene.codecs.KnnVectorsWriter.MergedVectorValues;","+import org.apache.lucene.codecs.hnsw.HnswGraphProvider;","+import org.apache.lucene.index.FieldInfo;","+import org.apache.lucene.index.MergeState;","+import org.apache.lucene.search.DocIdSetIterator;","+import org.apache.lucene.util.Bits;","+import org.apache.lucene.util.FixedBitSet;","+import org.apache.lucene.util.hnsw.CloseableRandomVectorScorerSupplier;","+import org.apache.lucene.util.hnsw.HnswGraph;","+import org.apache.lucene.util.hnsw.HnswGraphBuilder;","+import org.apache.lucene.util.hnsw.IncrementalHnswGraphMerger;","+import org.apache.lucene.util.hnsw.NeighborArray;","+import org.apache.lucene.util.hnsw.NeighborQueue;","+import org.apache.lucene.util.hnsw.RandomVectorScorer;","+import org.apache.lucene.util.hnsw.RandomVectorScorerSupplier;","+","+","+/// Serial Lucene 9.12 HNSW merge algorithm using mapped neighbor rows. Reuses Lucene's selection","+/// of a compatible source graph and mapping of its vector ordinals into the merged segment.","+final class MmapHnswGraphBuilder extends IncrementalHnswGraphMerger {","+  private static final int MIN_CACHED_VECTOR_DIMENSION = 256;","+","+  private final MmapHnswGraph _graph;","+  private final SplittableRandom _random = new SplittableRandom(HnswGraphBuilder.randSeed);","+  private final double _levelMultiplier;","+  private final FixedBitSet _visited;","+  private final NeighborQueue _frontier;","+  private final NeighborQueue _entryCandidates = new NeighborQueue(1, false);","+  private final NeighborQueue _beamCandidates;","+","+  static MmapHnswGraph build(Path scratchDir, FieldInfo fieldInfo, CloseableRandomVectorScorerSupplier scorerSupplier,","+      MergeState mergeState, int maxConn, int beamWidth)","+      throws IOException {","+    int count = scorerSupplier.totalVectorCount();","+    MmapHnswGraph graph = MmapHnswGraph.open(scratchDir, count, maxConn);","+    try {","+      new MmapHnswGraphBuilder(graph, fieldInfo, scorerSupplier, maxConn, beamWidth).build(mergeState, count);","+      return graph;","+    } catch (IOException | RuntimeException | Error e) {","+      try {","+        graph.close();","+      } catch (IOException | RuntimeException closeFailure) {","+        e.addSuppressed(closeFailure);","+      }","+      throw e;","+    }","+  }","+","+  private MmapHnswGraphBuilder(MmapHnswGraph graph, FieldInfo fieldInfo,","+      CloseableRandomVectorScorerSupplier scorerSupplier, int maxConn, int beamWidth) {","+    super(fieldInfo, fieldInfo.getVectorDimension() >= MIN_CACHED_VECTOR_DIMENSION","+        ? new ScoreCachingSupplier(scorerSupplier) : scorerSupplier, maxConn, beamWidth);","+    _graph = graph;","+    _levelMultiplier = maxConn == 1 ? 1 : 1 / Math.log(maxConn);","+    _visited = new FixedBitSet(graph.maxNodeId() + 1);","+    _frontier = new NeighborQueue(beamWidth, true);","+    _beamCandidates = new NeighborQueue(beamWidth, false);","+  }","+","+  private void build(MergeState mergeState, int count)","+      throws IOException {","+    for (int i = 0; i < mergeState.liveDocs.length; i++) {","+      if (MergedVectorValues.hasVectorValues(mergeState.fieldInfos[i], fieldInfo.name)) {","+        addReader(mergeState.knnVectorsReaders[i], mergeState.docMaps[i], mergeState.liveDocs[i]);","+      }","+    }","+    if (initReader != null) {","+      DocIdSetIterator mergedValues = switch (fieldInfo.getVectorEncoding()) {","+        case BYTE -> MergedVectorValues.mergeByteVectorValues(fieldInfo, mergeState);","+        case FLOAT32 -> MergedVectorValues.mergeFloatVectorValues(fieldInfo, mergeState);","+      };","+      initialize(((HnswGraphProvider) initReader).getGraph(fieldInfo.name),","+          getNewOrdMapping(mergedValues, new FixedBitSet(count)));","+    }","+    for (int node = 0; node < count; node++) {","+      if (!_graph.contains(node)) {","+        insert(node);","+      }","+    }","+    connectComponents();","+  }","+","+  private void initialize(HnswGraph source, int[] ordinalMap)","+      throws IOException {","+    for (int level = source.numLevels() - 1; level >= 0; level--) {","+      HnswGraph.NodesIterator nodes = source.getNodesOnLevel(level);","+      while (nodes.hasNext()) {","+        int oldNode = nodes.nextInt();","+        int node = ordinalMap[oldNode];","+        if (!_graph.contains(node)) {","+          _graph.addNode(node, level);","+        }","+        if (_graph.entryNode() == -1) {","+          _graph.setEntryNode(node, level);","+        }","+        MmapHnswNeighborList neighbors = _graph.neighbors(level, node);","+        source.seek(level, oldNode);","+        for (int oldNeighbor = source.nextNeighbor(); oldNeighbor != DocIdSetIterator.NO_MORE_DOCS;","+            oldNeighbor = source.nextNeighbor()) {","+          // Scores from the reused graph are computed lazily if this row needs pruning.","+          neighbors.appendAndPrune(ordinalMap[oldNeighbor], Float.NaN, node, scorerSupplier);","+        }","+      }","+    }","+  }","+","+  private void insert(int node)","+      throws IOException {","+    int nodeLevel = nextLevel();","+    _graph.addNode(node, nodeLevel);","+    if (_graph.entryNode() == -1) {","+      _graph.setEntryNode(node, nodeLevel);","+      return;","+    }","+","+    RandomVectorScorer scorer = scorerSupplier.scorer(node);","+    int highestLevel = _graph.numLevels() - 1;","+    int[] entryPoints = {_graph.entryNode()};","+    for (int level = highestLevel; level > nodeLevel; level--) {","+      searchLevel(scorer, level, entryPoints, _entryCandidates, 1, null);","+      entryPoints[0] = _entryCandidates.pop();","+    }","+    NeighborArray[] candidates = new NeighborArray[Math.min(highestLevel, nodeLevel) + 1];","+    for (int level = candidates.length - 1; level >= 0; level--) {","+      searchLevel(scorer, level, entryPoints, _beamCandidates, beamWidth, null);","+      entryPoints = _beamCandidates.nodes();","+      NeighborArray row = new NeighborArray(_beamCandidates.size(), false);","+      while (_beamCandidates.size() > 0) {","+        float score = _beamCandidates.topScore();","+        row.addInOrder(_beamCandidates.pop(), score);","+      }","+      candidates[level] = row;","+    }","+    for (int level = 0; level < candidates.length; level++) {","+      linkNeighbors(level, node, candidates[level]);","+    }","+    if (nodeLevel > highestLevel) {","+      _graph.setEntryNode(node, nodeLevel);","+    }","+  }","+","+  private int nextLevel() {","+    double sample;","+    do {","+      sample = _random.nextDouble();","+    } while (sample == 0);","+    return (int) (-Math.log(sample) * _levelMultiplier);","+  }","+","+  private void linkNeighbors(int level, int node, NeighborArray candidates)","+      throws IOException {","+    MmapHnswNeighborList neighbors = _graph.neighbors(level, node);","+    int limit = _graph.neighborLimit(level);","+    int[] nodeIds = candidates.nodes();","+    float[] scores = candidates.scores();","+    // Add outgoing edges first. A selected neighbor must be closer to this node than to any","+    // neighbor already selected.","+    int[] chosen = new int[Math.min(limit, candidates.size())];","+    int chosenCount = 0;","+    for (int i = candidates.size() - 1; i >= 0 && chosenCount < chosen.length; i--) {","+      if (isDiverse(nodeIds[i], scores[i], neighbors)) {","+        neighbors.appendInOrder(nodeIds[i], scores[i]);","+        chosen[chosenCount++] = i;","+      }","+    }","+    // Traverse the selected candidates in the original worst-to-best order for backlinks.","+    for (int i = chosenCount - 1; i >= 0; i--) {","+      int candidate = chosen[i];","+      int neighbor = nodeIds[candidate];","+      _graph.neighbors(level, neighbor).appendAndPrune(node, scores[candidate], neighbor, scorerSupplier);","+    }","+  }","+","+  private boolean isDiverse(int 