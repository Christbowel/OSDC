{"id":"20c1e72e50e8c20060abcae7988cc3e51fedcee0","axis":"silent","repo":"envoyproxy/envoy","sha":"20c1e72e50e8c20060abcae7988cc3e51fedcee0","parsed":{"files":[{"path":"changelogs/current/bug_fixes/dynamic_modules__rerun-failed-program-init.rst","lines":["@@ -0,0 +1,6 @@","+Fixed the use of a dynamic module whose ``envoy_dynamic_module_on_program_init`` failed. A module","+that stayed loaded after the failure, for example with ``do_not_close``, was returned by its next","+load without calling the init function again. Such a load now calls the init function again, and","+fails again if the init function fails. This behavioral change can be temporarily reverted by","+setting runtime guard ``envoy.reloadable_features.dynamic_modules_rerun_failed_program_init`` to","+``false``."],"additions":6,"deletions":0,"truncated":false},{"path":"source/common/runtime/runtime_features.cc","lines":["@@ -60,6 +60,11 @@ RUNTIME_GUARD(envoy_reloadable_features_default_client_tls_max_version_is_1_3);"," RUNTIME_GUARD(envoy_reloadable_features_direct_local_reply_flush_saved_response_metadata);"," RUNTIME_GUARD(envoy_reloadable_features_disallow_quic_client_udp_mmsg);"," RUNTIME_GUARD(envoy_reloadable_features_disallow_redirect_prefix_rewrite_with_path_match_policy);","+// When enabled, which is the default, a load of a dynamic module that is already loaded runs its","+// envoy_dynamic_module_on_program_init again if it failed before, for example on a module that","+// do_not_close keeps loaded. Disable to restore the previous behavior, in which such a load skips","+// the init function and uses the module without it.","+RUNTIME_GUARD(envoy_reloadable_features_dynamic_modules_rerun_failed_program_init);"," // When enabled, which is the default, dynamic modules are loaded with RTLD_NOW so that every"," // referenced symbol is resolved at load time instead of lazily on first use. A module that"," // references a symbol the main program does not provide then fails to load rather than crashing"],"additions":5,"deletions":0,"truncated":false},{"path":"source/extensions/dynamic_modules/BUILD","lines":["@@ -14,6 +14,7 @@ envoy_cc_library(","     srcs = [","         \"background_fetch_manager.cc\",","         \"dynamic_module_stats.cc\",","+        \"program_init_state.cc\",","     ] + select({","         \"//bazel:windows_x86_64\": [\"win32/dynamic_modules.cc\"],","         \"//conditions:default\": [\"posix/dynamic_modules.cc\"],","@@ -22,6 +23,7 @@ envoy_cc_library(","         \"background_fetch_manager.h\",","         \"dynamic_module_stats.h\",","         \"dynamic_modules.h\",","+        \"program_init_state.h\",","     ],","     external_deps = [\"ssl\"],","     deps = [","@@ -34,6 +36,7 @@ envoy_cc_library(","         \"//source/common/common:assert_lib\",","         \"//source/common/common:hex_lib\",","         \"//source/common/common:logger_lib\",","+        \"//source/common/common:macros\",","         \"//source/common/common:utility_lib\",","         \"//source/common/config:remote_data_fetcher_lib\",","         \"//source/common/runtime:runtime_features_lib\",","@@ -41,9 +44,11 @@ envoy_cc_library(","         \"//source/extensions/common/wasm:remote_async_datasource_lib\",","         \"//source/extensions/dynamic_modules/abi\",","         \"@abseil-cpp//absl/container:flat_hash_map\",","+        \"@abseil-cpp//absl/container:flat_hash_set\",","         \"@abseil-cpp//absl/status\",","         \"@abseil-cpp//absl/status:statusor\",","         \"@abseil-cpp//absl/strings\",","+        \"@abseil-cpp//absl/synchronization\",","         \"@abseil-cpp//absl/types:span\",","         \"@envoy_api//envoy/config/core/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/extensions/dynamic_modules/v3:pkg_cc_proto\","],"additions":5,"deletions":0,"truncated":false},{"path":"source/extensions/dynamic_modules/abi/abi.h","lines":["@@ -714,8 +714,8 @@ typedef void* envoy_dynamic_module_type_load_shed_point_envoy_ptr;"," "," /**","  * envoy_dynamic_module_on_program_init is called by the main thread exactly when the module is","- * loaded. The function returns the ABI version of the dynamic module. If null is returned, the","- * module will be unloaded immediately.","+ * loaded. The function returns the ABI version of the dynamic module. If null is returned, the load","+ * fails, and the next load of the module calls this function again.","  *","  * For Envoy, the return value is recorded and logged for diagnostics only. Envoy does not","  * validate it against its own ABI version, so returning a version that differs from Envoy's does","@@ -729,7 +729,7 @@ typedef void* envoy_dynamic_module_type_load_shed_point_envoy_ptr;","  * report an error to Envoy.","  *","  * @return envoy_dynamic_module_type_abi_version_module_ptr is the ABI version the dynamic module","- * was built against. Null means the error and the module will be unloaded immediately.","+ * was built against. Null means the error and the load fails.","  */"," envoy_dynamic_module_type_abi_version_module_ptr envoy_dynamic_module_on_program_init(void);"," "],"additions":3,"deletions":3,"truncated":false},{"path":"source/extensions/dynamic_modules/dynamic_modules.h","lines":["@@ -91,6 +91,11 @@ using DynamicModulePtr = std::unique_ptr<DynamicModule>;","  * The binding mode is not a parameter: the loader binds now (RTLD_NOW) by default and falls back to","  * lazy binding (RTLD_LAZY) when the ``envoy.reloadable_features.dynamic_modules_rtld_now`` runtime","  * guard is disabled.","+ *","+ * A call that finds the module already loaded runs its envoy_dynamic_module_on_program_init again","+ * only if it failed, and never when the","+ * ``envoy.reloadable_features.dynamic_modules_rerun_failed_program_init`` runtime guard is","+ * disabled.","  */"," absl::StatusOr<DynamicModulePtr>"," newDynamicModule(const std::filesystem::path& object_file_absolute_path, const bool do_not_close,"],"additions":5,"deletions":0,"truncated":false},{"path":"source/extensions/dynamic_modules/posix/dynamic_modules.cc","lines":["@@ -17,6 +17,7 @@"," #include \"source/extensions/dynamic_modules/abi/abi.h\""," #include \"source/extensions/dynamic_modules/background_fetch_manager.h\""," #include \"source/extensions/dynamic_modules/dynamic_module_stats.h\"","+#include \"source/extensions/dynamic_modules/program_init_state.h\""," "," #include \"absl/strings/ascii.h\""," #include \"absl/strings/str_cat.h\"","@@ -65,28 +66,34 @@ newDynamicModule(const std::filesystem::path& object_file_absolute_path, const b","   void* handle = dlopen(object_file_absolute_path.c_str(), RTLD_NOLOAD | binding_mode);","   if (handle != nullptr) {","     // This means the module is already loaded, and the return value is the handle of the already","-    // loaded module. We don't need to call the init function again.","-    return std::make_unique<DynamicModule>(handle);","-  }","-  int mode = binding_mode;","-  if (load_globally) {","-    mode |= RTLD_GLOBAL;","+    // loaded module. We don't need to call the init function again, unless it failed.","+    if (programInitSucceeded(handle) ||","+        !Runtime::runtimeFeatureEnabled(","+            \"envoy.reloadable_features.dynamic_modules_rerun_failed_program_init\")) {","+      return std::make_unique<DynamicModule>(handle);","+    }","   } else {","-    // RTLD_LOCAL is used by default to avoid collisions between multiple modules.","-    mode |= RTLD_LOCAL;","-  }","-  if (do_not_close) {","-    mode |= RTLD_NODELETE;","-  }","-  handle = dlopen(object_file_absolute_path.c_str(), mode);","-  if (handle == nullptr) {","-    // `dlerror()` returns null when no error is pending, so do not pass it along unchecked.","-    const char* dlopen_error = dlerror();","-    const absl::string_view reason =","-        dlopen_error != nullptr ? dlopen_error : \"unknown dlopen error\";","-    logModuleLoadFailure(object_file_absolute_path.c_str(), reason);","-    return absl::InvalidArgumentError(absl::StrCat(","-        \"Failed to load dynamic module: \", object_file_absolute_path.c_str(), \" : \", reason));","+    int mode = binding_mode;","+    if (load_globally) {","+      mode |= RTLD_GLOBAL;","+    } else {","+      // RTLD_LOCAL is used by default to avoid collisions between multiple modules.","+      mode |= RTLD_LOCAL;","+    }","+    if (do_not_close) {","+      mode |= RTLD_NODELETE;","+    }","+    handle = dlopen(object_file_absolute_path.c_str(), mode);","+    if (handle == nullptr) {","+      // `dlerror()` returns null when no error is pending, so do not pass it along unchecked.","+      const char* dlopen_error = dlerror();","+      const absl::string_view reason =","+          dlopen_error != nullptr ? dlopen_error : \"unknown dlopen error\";","+      logModuleLoadFailure(object_file_absolute_path.c_str(), reason);","+      return absl::InvalidArgumentError(absl::StrCat(","+          \"Failed to load dynamic module: \", object_file_absolute_path.c_str(), \" : \", reason));","+    }","+    setProgramInitSucceeded(handle, false);","   }"," ","   DynamicModulePtr dynamic_module = std::make_unique<DynamicModule>(handle);","@@ -107,6 +114,7 @@ newDynamicModule(const std::filesystem::path& object_file_absolute_path, const b","     return absl::InvalidArgumentError(","         absl::StrCat(\"Failed to initialize dynamic module: \", object_file_absolute_path.c_str()));","   }","+  setProgramInitSucceeded(handle, true);","   // Copy the version out of module memory right away, since the returned pointer is only","   // guaranteed valid immediately after on_program_init returns.","   const std::string module_abi_version(abi_version);"],"additions":29,"deletions":21,"truncated":false},{"path":"source/extensions/dynamic_modules/program_init_state.cc","lines":["@@ -0,0 +1,41 @@","+#include \"source/extensions/dynamic_modules/program_init_state.h\"","+","+#include \"source/common/common/macros.h\"","+","+#include \"absl/container/flat_hash_set.h\"","+#include \"absl/synchronization/mutex.h\"","+","+namespace Envoy {","+namespace Extensions {","+namespace DynamicModules {","+","+namespace {","+","+struct ProgramInitState {","+  absl::Mutex mutex;","+  absl::flat_hash_set<const void*> succeeded ABSL_GUARDED_BY(mutex);","+};","+","+ProgramInitState& programInitState() { MUTABLE_CONSTRUCT_ON_FIRST_USE(ProgramInitState); }","+","+} // namespace","+","+bool programInitSucceeded(const void* handle) {","+  ProgramInitState& state = programInitState();","+  absl::MutexLock lock(state.mutex);","+  return state.succeeded.contains(handle);","+}","+","+void setProgramInitSucceeded(const void* handle, bool succeeded) {","+  ProgramInitState& state = programInitState();","+  absl::MutexLock lock(state.mutex);","+  if (succeeded) {","+    state.succeeded.insert(handle);","+  } else {","+    state.succeeded.erase(handle);","+  }","+}","+","+} // namespace DynamicModules","+} // namespace Extensions","+} // namespace Envoy"],"additions":41,"deletions":0,"truncated":false},{"path":"source/extensions/dynamic_modules/program_init_state.h","lines":["@@ -0,0 +1,25 @@","+#pragma once","+","+namespace Envoy {","+namespace Extensions {","+namespace DynamicModules {","+","+/**","+ * @return whether the envoy_dynamic_module_on_program_init of the loaded shared object succeeded,","+ * so that a load that finds the shared object already loaded runs it again only if it failed.","+ * @param handle the handle of the shared object.","+ */","+bool programInitSucceeded(const void* handle);","+","+/**","+ * Records whether the envoy_dynamic_module_on_program_init of the loaded shared object succeeded. A","+ * load that opens a shared object records that it has not succeeded yet, since a shared object","+ * that was unloaded can leave its handle to another one.","+ * @param handle the handle of the shared object.","+ * @param succeeded whether the init function succeeded.","+ */","+void setProgramInitSucceeded(const void* handle, bool succeeded);","+","+} // namespace DynamicModules","+} // namespace Extensions","+} // namespace Envoy"],"additions":25,"deletions":0,"truncated":false},{"path":"source/extensions/dynamic_modules/sdk/rust/src/abi.rs","lines":["@@ -834,8 +834,8 @@ pub type envoy_dynamic_module_type_load_shed_point_envoy_ptr = *mut ::std::os::r"," #[cfg_attr(envoy_dynamic_module_dll, link(name = \"envoy\", kind = \"raw-dylib\"))]"," unsafe extern \"C\" {","     /** envoy_dynamic_module_on_program_init is called by the main thread exactly when the module is","- loaded. The function returns the ABI version of the dynamic module. If null is returned, the","- module will be unloaded immediately.","+ loaded. The function returns the ABI version of the dynamic module. If null is returned, the load","+ fails, and the next load of the module calls this function again."," ","  For Envoy, the return value is recorded and logged for diagnostics only. Envoy does not","  validate it against its own ABI version, so returning a version that differs from Envoy's does","@@ -849,7 +849,7 @@ unsafe extern \"C\" {","  report an error to Envoy."," ","  @return envoy_dynamic_module_type_abi_version_module_ptr is the ABI version the dynamic module","- was built against. Null means the error and the module will be unloaded immediately.*/","+ was built against. Null means the error and the load fails.*/","     pub fn envoy_dynamic_module_on_program_init() -> envoy_dynamic_module_type_abi_version_module_ptr;"," }"," #[cfg_attr(envoy_dynamic_module_dll, link(name = \"envoy\", kind = \"raw-dylib\"))]"],"additions":3,"deletions":3,"truncated":false},{"path":"source/extensions/dynamic_modules/sdk/rust/src/lib.rs","lines":["@@ -603,7 +603,8 @@ macro_rules! set_factory_once {"," /// The function signature for the program init function."," ///"," /// This is called when the dynamic module is loaded, and it must return true on success, and false","-/// on failure. When it returns false, the dynamic module will not be loaded.","+/// on failure. When it returns false, the dynamic module will not be loaded, and its next load","+/// calls it again."," ///"," /// This is useful to perform any process-wide initialization that the dynamic module needs."," pub type ProgramInitFunction = fn() -> bool;"],"additions":2,"deletions":1,"truncated":false},{"path":"source/extensions/dynamic_modules/win32/dynamic_modules.cc","lines":["@@ -19,9 +19,11 @@"," #include \"source/common/common/hex.h\""," #include \"source/common/common/logger.h\""," #include \"source/common/common/utility.h\"","+#include \"source/common/runtime/runtime_features.h\""," #include \"source/extensions/dynamic_modules/abi/abi.h\""," #include \"source/extensions/dynamic_modules/background_fetch_manager.h\""," #include \"source/extensions/dynamic_modules/dynamic_module_stats.h\"","+#include \"source/extensions/dynamic_modules/program_init_state.h\""," "," #include \"absl/status/status.h\""," #include \"absl/status/statusor.h\"","@@ -86,46 +88,51 @@ newDynamicModule(const std::filesystem::path& object_file_absolute_path, const b"," ","   // GetModuleHandleExW without GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT returns the handle of","   // an already resident module and increments its reference count, which mirrors","-  // dlopen(RTLD_NOLOAD). This avoids the duplicate call to the init function.","+  // dlopen(RTLD_NOLOAD). This avoids the duplicate call to the init function, unless it failed.","   HMODULE handle = nullptr;","   if (::GetModuleHandleExW(0, wide_path.c_str(), &handle) && handle != nullptr) {","-    return std::make_unique<DynamicModule>(handle);","-  }","-","-  // LOAD_WITH_ALTERED_SEARCH_PATH makes the loader resolve the module's own dependencies from the","-  // module's directory. It is only defined for absolute paths; a bare module name is searched in","-  // the standard DLL search order instead.","-  const DWORD load_flags =","-      object_file_absolute_path.is_absolute() ? LOAD_WITH_ALTERED_SEARCH_PATH : 0;","-  // Suppress the system error dialog boxes that the loader may otherwise show for missing or","-  // corrupt images, so that a failure is reported only through the returned status.","-  DWORD previous_error_mode = 0;","-  const bool error_mode_set =","-      ::SetThreadErrorMode(SEM_FAILCRITICALERRORS | SEM_NOOPENFILEERRORBOX, &previous_error_mode);","-  handle = ::LoadLibraryExW(wide_path.c_str(), nullptr, load_flags);","-  const DWORD load_error = ::GetLastError();","-  if (error_mode_set) {","-    ::SetThreadErrorMode(previous_error_mode, nullptr);","-  }","-  if (handle == nullptr) {","-    const std::string reason = errorDetails(static_cast<int>(load_error));","-    logModuleLoadFailure(path_string, reason);","-    return absl::InvalidArgumentError(","-        absl::StrCat(\"Failed to load dynamic module: \", path_string, \" : \", reason));","-  }","-  if (do_not_close) {","-    // Pin the module so that it stays loaded until the process exits, regardless of FreeLibrary","-    // calls. This is the equivalent of RTLD_NODELETE.","-    HMODULE pinned = nullptr;","-    if (!::GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |","-                                  GET_MODULE_HANDLE_EX_FLAG_PIN,","-                              reinterpret_cast<LPCWSTR>(handle), &pinned)) {","-      const std::string reason = errorDetails(static_cast<int>(::GetLastError()));","-      ::FreeLibrary(handle);","+    if (programInitSucceeded(handle) ||","+        !Runtime::runtimeFeatureEnabled(","+            \"envoy.reloadable_features.dynamic_modules_rerun_failed_program_init\")) {","+      return std::make_unique<DynamicModule>(handle);","+    }","+  } else {","+    // LOAD_WITH_ALTERED_SEARCH_PATH makes the loader resolve the module's own dependencies from","+    // the module's directory. It is only defined for absolute paths; a bare module name is","+    // searched in the standard DLL search order instead.","+    const DWORD load_flags =","+        object_file_absolute_path.is_absolute() ? LOAD_WITH_ALTERED_SEARCH_PATH : 0;","+    // Suppress the system error dialog boxes that the loader may otherwise show for missing or","+    // corrupt images, so that a failure is reported only through the returned status.","+    DWORD previous_error_mode = 0;","+    const bool error_mode_set =","+        ::SetThreadErrorMode(SEM_FAILCRITICALERRORS | SEM_NOOPENFILEERRORBOX, &previous_error_mode);","+    handle = ::LoadLibraryExW(wide_path.c_str(), nullptr, load_flags);","+    const DWORD load_error = ::GetLastError();","+    if (error_mode_set) {","+      ::SetThreadErrorMode(previous_error_mode, nullptr);","+    }","+    if (handle == nullptr) {","+      const std::string reason = errorDetails(static_cast<int>(load_error));","       logModuleLoadFailure(path_string, reason);","       return absl::InvalidArgumentError(","-          absl::StrCat(\"Failed to pin dynamic module: \", path_string, \" : \", reason));","+          absl::StrCat(\"Failed to load dynamic module: \", path_string, \" : \", reason));","+    }","+    if (do_not_close) {","+      // Pin the module so that it stays loaded until the process exits, regardless of","+      // FreeLibrary calls. This is the equivalent of RTLD_NODELETE.","+      HMODULE pinned = nullptr;","+      if (!::GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |","+                                    GET_MODULE_HANDLE_EX_FLAG_PIN,","+                                reinterpret_cast<LPCWSTR>(handle), &pinned)) {","+        const std::string reason = errorDetails(static_cast<int>(::GetLastError()));","+        ::FreeLibrary(handle);","+        logModuleLoadFailure(path_string, reason);","+        return absl::InvalidArgumentError(","+            absl::StrCat(\"Failed to pin dynamic module: \", path_string, \" : \", reason));","+      }","     }","+    setProgramInitSucceeded(handle, false);","   }"," ","   DynamicModulePtr dynamic_module = std::make_unique<DynamicModule>(handle);","@@ -145,6 +152,7 @@ newDynamicModule(const std::filesystem::path& object_file_absolute_path, const b","     return absl::InvalidArgumentError(","         absl::StrCat(\"Failed to initialize dynamic module: \", path_string));","   }","+  setProgramInitSucceeded(handle, true);","   // Copy the version out of module memory right away, since the returned pointer is only","   // guaranteed valid immediately after on_program_init returns.","   const std::string module_abi_version(abi_version);"],"additions":43,"deletions":35,"truncated":false},{"path":"test/extensions/dynamic_modules/BUILD","lines":["@@ -27,7 +27,9 @@ envoy_cc_dyn_module_test(","         \"//test/extensions/dynamic_modules/test_data/c:program_child\",","         \"//test/extensions/dynamic_modules/test_data/c:program_global\",","         \"//test/extensions/dynamic_modules/test_data/c:program_init_assert\",","+        \"//test/extensions/dynamic_modules/test_data/c:program_init_count\",","         \"//test/extensions/dynamic_modules/test_data/c:program_init_fail\",","+        \"//test/extensions/dynamic_modules/test_data/c:program_init_fail_once\",","         \"//test/extensions/dynamic_modules/test_data/rust:abi_version_mismatch\",","         \"//test/extensions/dynamic_modules/test_data/rust:no_op\",","         \"//test/extensions/dynamic_modules/test_data/rust:no_program_init\",","@@ -57,9 +59,11 @@ envoy_cc_dyn_module_test(","         \"//test/extensions/dynamic_modules/test_data/rust:no_op_static\",","         \"//test/mocks/init:init_mocks\",","         \"//test/mocks/server:server_factory_context_mocks\",","+        \"//test/test_common:environment_lib\",","         \"//test/test_common:logging_lib\",","         \"//test/test_common:status_utility_lib\",","         \"//test/test_common:test_runtime_lib\",","+        \"@abseil-cpp//absl/strings\",","         \"@envoy_api//envoy/extensions/dynamic_modules/v3:pkg_cc_proto\",","     ],"," )"],"additions":4,"deletions":0,"truncated":false},{"path":"test/extensions/dynamic_modules/dynamic_modules_test.cc","lines":["@@ -13,12 +13,14 @@"," #include \"test/extensions/dynamic_modules/util.h\""," #include \"test/mocks/init/mocks.h\""," #include \"test/mocks/server/server_factory_context.h\"","+#include \"test/test_common/environment.h\""," #include \"test/test_common/logging.h\""," #include \"test/test_common/status_utility.h\""," #include \"test/test_common/test_runtime.h\""," #include \"test/test_common/utility.h\""," "," #include \"absl/strings/ascii.h\"","+#include \"absl/strings/str_cat.h\""," #include \"gmock/gmock.h\""," #include \"gtest/gtest.h\""," ","@@ -59,6 +61,55 @@ TEST(DynamicModuleTestGeneral, TruncatedSharedObject) {","   std::filesystem::remove(truncated);"," }"," ","+// The parameter is the value of the dynamic_modules_rerun_failed_program_init runtime guard.","+class RerunFailedProgramInitTest : public testing::TestWithParam<bool> {","+protected:","+  RerunFailedProgramInitTest() {","+    scoped_runtime_.mergeValues(","+        {{\"envoy.reloadable_features.dynamic_modules_rerun_failed_program_init\",","+          GetParam() ? \"true\" : \"false\"}});","+  }","+","+  TestScopedRuntime scoped_runtime_;","+};","+","+INSTANTIATE_TEST_SUITE_P(RuntimeGuard, RerunFailedProgramInitTest, testing::Bool(),","+                         testing::PrintToStringParamName());","+","+TEST_P(RerunFailedProgramInitTest, NextLoadAfterAFailedProgramInit) {","+  // Every run loads a copy of its own, since do_not_close keeps the module loaded after its program","+  // init function fails.","+  static int runs = 0;","+  const std::filesystem::path path =","+      TestEnvironment::temporaryPath(absl::StrCat(\"program_init_fail_once_\", ++runs, \".so\"));","+  // A copy that an earlier process left behind is read-only, like the shared object that it copies.","+  std::filesystem::remove(path);","+  std::filesystem::copy_file(testSharedObjectPath(\"program_init_fail_once\", \"c\"), path);","+  EXPECT_LOG_CONTAINS(\"error\", \"envoy_dynamic_module_on_program_init returned null\", {","+    EXPECT_THAT(newDynamicModule(path, /*do_not_close=*/true),","+                HasStatusCode(absl::StatusCode::kInvalidArgument));","+  });","+  absl::StatusOr<DynamicModulePtr> module = newDynamicModule(path, /*do_not_close=*/true);","+  ASSERT_OK(module);","+  const auto get_init_calls = (*module)->getFunctionPointer<int (*)()>(\"get_init_calls\");","+  ASSERT_OK(get_init_calls);","+  // Without the runtime guard, the next load uses the module without its program init function.","+  EXPECT_EQ(GetParam() ? 2 : 1, (*get_init_calls)());","+}","+","+TEST(DynamicModuleTestGeneral, ProgramInitRunsAgainAfterTheModuleIsUnloaded) {","+  for (int load = 0; load < 2; ++load) {","+    SCOPED_TRACE(load);","+    absl::StatusOr<DynamicModulePtr> module =","+        newDynamicModule(testSharedObjectPath(\"program_init_count\", \"c\"), /*do_not_close=*/false);","+    ASSERT_OK(module);","+    const auto get_init_calls = (*module)->getFunctionPointer<int (*)()>(\"get_init_calls\");","+    ASSERT_OK(get_init_calls);","+    // The previous load unloaded its copy, so every load initializes a fresh one.","+    EXPECT_EQ(1, (*get_init_calls)());","+  }","+}","+"," INSTANTIATE_TEST_SUITE_P(LanguageTests, DynamicModuleTestLanguages, testing::Values(\"c\", \"rust\"),","                          DynamicModuleTestLanguages::languageParamToTestName);"," "],"additions":51,"deletions":0,"truncated":false},{"path":"test/extensions/dynamic_modules/test_data/c/BUILD","lines":["@@ -48,8 +48,12 @@ test_program(name = \"no_program_init\")"," "," test_program(name = \"program_init_assert\")"," ","+test_program(name = \"program_init_count\")","+"," test_program(name = \"program_init_fail\")"," ","+test_program(name = \"program_init_fail_once\")","+"," test_program(name = \"abi_version_mismatch\")"," "," test_program(name = \"no_http_config_new\")"],"additions":4,"deletions":0,"truncated":false},{"path":"test/extensions/dynamic_modules/test_data/c/program_init_count.c","lines":["@@ -0,0 +1,12 @@","+#include <stdatomic.h>","+","+#include \"source/extensions/dynamic_modules/abi/abi.h\"","+","+static atomic_int init_calls;","+","+envoy_dynamic_module_type_abi_version_module_ptr envoy_dynamic_module_on_program_init(void) {","+  atomic_fetch_add(&init_calls, 1);","+  return envoy_dynamic_modules_abi_version;","+}","+","+int get_init_calls(void) { return atomic_load(&init_calls); }"],"additions":12,"deletions":0,"truncated":false},{"path":"test/extensions/dynamic_modules/test_data/c/program_init_fail_once.c","lines":["@@ -0,0 +1,12 @@","+#include <stdatomic.h>","+","+#include \"source/extensions/dynamic_modules/abi/abi.h\"","+","+static atomic_int init_calls;","+","+// Fails the first init, so that a test can load the module again after a failed init.","+envoy_dynamic_module_type_abi_version_module_ptr envoy_dynamic_module_on_program_init(void) {","+  return atomic_fetch_add(&init_calls, 1) == 0 ? NULL : envoy_dynamic_modules_abi_version;","+}","+","+int get_init_calls(void) { return atomic_load(&init_calls); }",""],"additions":12,"deletions":0,"truncated":false}],"additions":250,"deletions":63,"truncated":false,"file_count":16},"error":null,"fetched_at":"2026-11-25T18:25:04.013387+00:00"}