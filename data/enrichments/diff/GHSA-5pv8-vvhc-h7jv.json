{"id":"GHSA-5pv8-vvhc-h7jv","axis":"advisories","repo":"aio-libs/aiohttp","sha":"6963ee0befec1502b6bb7b4db6c72d044c08f4fa","parsed":{"files":[{"path":"CHANGES/13930.breaking.rst","lines":["@@ -0,0 +1,4 @@","+Changed ``Set-Cookie`` parsing to create exactly one cookie per field, as RFC 6265","+and browsers do. Later ``name=value`` pairs and unknown attributes no longer create","+extra cookies, a leading pair such as ``Path=/`` or ``$Version=1`` is the cookie itself,","+and legacy ``$Path`` and ``$Domain`` attributes are ignored -- by :user:`iamibi`."],"additions":4,"deletions":0,"truncated":false},{"path":"CHANGES/13930.bugfix.rst","lines":["@@ -0,0 +1,4 @@","+Added limits to client cookie parsing, :class:`~aiohttp.CookieJar` storage and","+generated ``Cookie`` headers, with Firefox-style eviction, and fixed a replaced cookie","+keeping the previous cookie's expiry when the new cookie has none","+-- by :user:`iamibi` and :user:`bdraco`."],"additions":4,"deletions":0,"truncated":false},{"path":"CONTRIBUTORS.txt","lines":["@@ -372,6 +372,7 @@ Sunghyun Hwang"," Sunit Deshpande"," Sviatoslav Bulbakha"," Sviatoslav Sydorenko","+Syed Mohammad Ibrahim"," Taha Jahangir"," Taras Voinarovskyi"," Terence Honles"],"additions":1,"deletions":0,"truncated":false},{"path":"aiohttp/_cookie_helpers.py","lines":["@@ -8,7 +8,6 @@"," import re"," from collections.abc import Sequence"," from http.cookies import CookieError, Morsel","-from typing import cast"," "," from .log import internal_logger"," ","@@ -44,6 +43,18 @@","     (\"secure\", \"httponly\", \"partitioned\")"," )"," ","+# Implementation limits as permitted by RFC 6265 Section 6.1.","+_MAX_COOKIES_PER_RESPONSE = 50","+_MAX_COOKIE_PAIR_LENGTH = 4096","+_MAX_COOKIE_ATTRIBUTE_VALUE_LENGTH = 1024","+# Like Chromium's ParsedCookie::kMaxPairs, but more lenient.","+_MAX_COOKIE_ATTRIBUTES = 32","+","+# Where the next attribute can start: skips runs of \";\" and whitespace.","+_ATTRIBUTE_START_RE = re.compile(r\"[^;\\s]\", re.ASCII)","