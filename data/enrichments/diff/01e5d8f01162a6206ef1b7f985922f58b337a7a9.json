elper = next(","+            node","+            for node in tree.body","+            if isinstance(node, ast.FunctionDef) and node.name == \"setup_platform\"","+        )","+        native_platform = mock.Mock()","+        namespace = {","+            \"native\": SimpleNamespace(platform=native_platform),","+            \"REMOTE_EXECUTION_CONTAINERS\": {\"ubuntu24\": {\"container-url\": \"docker://image\"}},","+        }","+        exec(compile(ast.Module(body=[helper], type_ignores=[]), str(path), \"exec\"), namespace)","+        namespace[\"setup_platform\"](\"amd64\", \"ubuntu24\", \"\")","+        execution_platform = native_platform.call_args.kwargs","+        self.assertEqual(execution_platform[\"name\"], \"ubuntu24_amd64_windows_cross_exec\")","+        compiler_flag = next(","+            flag for flag in execution_platform[\"flags\"] if \"compiler_type=\" in flag","+        )","+        # Bazel parses inherited flags in the child platform's repository. An explicit","+        # main-repository qualifier keeps this flag usable from windows_cross:exec.","+        self.assertEqual(compiler_flag, \"--@//bazel/config:compiler_type=clang\")","+","+"," if __name__ == \"__main__\":","     unittest.main()"],"additions":26,"deletions":0,"truncated":false},{"path":"bazel/platforms/platform_util.bzl","lines":["@@ -29,7 +29,9 @@ def setup_platform(arch, distro_or_os, cache_silo, name_suffix = \"\", extra_const","             name = distro_or_os + \"_\" + arch + cache_silo + \"_windows_cross_exec\",","             parents = [\":\" + distro_or_os + \"_\" + arch + cache_silo],","             flags = [","-                \"--//bazel/config:compiler_type=clang\",","+                # Inherited flags are parsed in the child platform's repository.","+                # The Windows wrapper's generated execution platform is external.","+                \"--@//bazel/config:compiler_type=clang\",","                 \"--@rules_rust//rust/settings:toolchain_linker_preference=cc\",","             ],","         )"],"additions":3,"deletions":1,"truncated":false},{"path":"bazel/toolchains/cc/mongo_wasm/toolchain/BUILD.bazel","lines":["@@ -1,9 +1,12 @@"," load(\"@rules_cc//cc/toolchains:cc_toolchain.bzl\", \"cc_toolchain\")","+load(\"@rules_shell//shell:sh_test.bzl\", \"sh_test\")"," load(\":cc_toolchain_config_wasip2.bzl\", \"wasi_cc_toolchain_config_wasip2\")","-load(\":wasi_repo_test.bzl\", \"wasi_repo_test_suite\")","+load(\":wasi_repo_test.bzl\", \"linux_tool_wrapper_fixture\", \"wasi_repo_test_suite\")"," "," package(default_visibility = [\"//visibility:public\"])"," ","+exports_files([\"linux_tool_wrapper.sh\"])","+"," # --- WASI Preview2 (wasm32-wasip2) toolchain/platform ---"," "," wasi_cc_toolchain_config_wasip2(","@@ -13,6 +16,32 @@ wasi_cc_toolchain_config_wasip2(","     clangpp = \"@wasi_sdk//:wasm32-wasip2-clang++\","," )"," ","+linux_tool_wrapper_fixture(","+    name = \"wasi_tool_wrapper_fixture\",","+    testonly = True,","+)","+","+sh_test(","+    name = \"wasi_tool_wrapper_test\",","+    srcs = [\"wasi_tool_wrapper_test.sh\"],","+    args = [","+        \"$(location @wasi_sdk//:wasm32-wasip2-clang)\",","+        \"$(location :wasi_tool_wrapper_fixture/bin/mongo-wasm32-wasip2-clang)\",","+        \"$(location :wasi_tool_wrapper_fixture/bin/mongo-wasm32-wasip2-clang++)\",","+        \"$(location :wasi_tool_wrapper_fixture/bin/mongo-llvm-ar)\",","+    ],","+    data = [","+        \":wasi_tool_wrapper_fixture/bin/mongo-llvm-ar\",","+        \":wasi_tool_wrapper_fixture/bin/mongo-wasm32-wasip2-clang\",","+        \":wasi_tool_wrapper_fixture/bin/mongo-wasm32-wasip2-clang++\",","+        \"@wasi_sdk//:bin\",","+        \"@wasi_sdk//:lib\",","+        \"@wasi_sdk//:share\",","+        \"@wasi_sdk//:wasm32-wasip2-clang\",","+    ],","+    target_compatible_with = [\"@platforms//os:linux\"],","+)","+"," cc_toolchain(","     name = \"wasi_cc_toolchain_wasip2_impl\",","     all_files = \":wasi_files\","],"additions":30,"deletions":1,"truncated":false},{"path":"bazel/toolchains/cc/mongo_wasm/toolchain/linux_tool_wrapper.sh","lines":["@@ -0,0 +1,83 @@","+#!/bin/bash","+# Windows cross builds download the Linux WASI SDK on a Windows client but run","+# its tools on Linux workers. Downloaded tools can lose execute permissions, and","+# actions can inherit Windows paths. This wrapper makes the SDK runnable on","+# Linux while preserving the compiler's driver and header lookup behavior.","+set -euo pipefail","+","+# The repository rule and test fixture substitute the SDK tool and driver name.","+tool_name=\"@MONGO_WASI_REAL_TOOL@\"","+argv0=\"@MONGO_WASI_ARGV0@\"","+this_path=\"${BASH_SOURCE[0]}\"","+this_dir=\"${this_path%/*}\"","+if [[ \"${this_dir}\" == \"${this_path}\" ]]; then","+    this_dir=\".\"","+fi","+raw_dir=\"${this_dir}\"","+this_dir=\"$(cd -- \"${this_dir}\" && pwd)\"","+# Bazel actions may intentionally provide a tool-only PATH. The wrapper needs","+# both the downloaded SDK's tools and these host utilities to make a Linux SDK","+# executable. Append inherited search paths only when nonempty so an empty","+# entry does not add the action's working directory to the search path.","+export PATH=\"${this_dir}:/usr/bin:/bin${PATH:+:${PATH}}\"","+real_tool=\"${this_dir}/${tool_name}\"","+export LD_LIBRARY_PATH=\"${this_dir}/../lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}\"","+# Windows Evergreen hosts pass TMP/TEMP=Z:/b through --action_env, which reaches","+# Linux RBE workers verbatim. LLVM consults TMPDIR, TMP, then TEMP for temporary","+# files, so any of them naming a missing directory breaks linking with \"unable","+# to make temporary file\". Point all of them at a directory that exists here.","+tmp_dir=\"${TMPDIR:-}\"","+if [[ ! -d \"${tmp_dir}\" || ! -w \"${tmp_dir}\" ]]; then","+    tmp_dir=/tmp","+fi","+export TMPDIR=\"${tmp_dir}\" TMP=\"${tmp_dir}\" TEMP=\"${tmp_dir}\"","+# Use a private, atomically created directory and keep it alive until the tool","+# exits. A parent shell is needed to clean up after both success and failure.","+stage_dir=\"$(mktemp -d -- \"$TMPDIR/mongo-wasi-${argv0}.XXXXXX\")\"","+trap 'rm -rf -- \"$stage_dir\"' EXIT","+tool_pid=\"\"","+terminate() {","+    trap '' HUP INT TERM","+    if [[ -n \"$tool_pid\" ]]; then","+        kill -s \"$1\" \"$tool_pid\" 2>/dev/null || true","+        wait \"$tool_pid\" 2>/dev/null || true","+    fi","+    exit \"$2\"","+}","+trap 'terminate HUP 129' HUP","+trap 'terminate INT 130' INT","+trap 'terminate TERM 143' TERM","+tmp_tool=\"$stage_dir/$argv0\"","+cp -- \"${real_tool}\" \"${tmp_tool}\"","+chmod u+x \"${tmp_tool}\"","+exec_args=()","+if [[ \"$tool_name\" == clang-22 ]]; then","+    # LLD selects its driver from the executable name. Keep wasm-ld's","+    # basename when staging it. Preview2 also uses wasm-component-ld,","+    # which Clang finds alongside wasm-ld using the -B search prefix.","+    for linker in wasm-ld wasm-component-ld; do","+        cp -- \"$this_dir/$linker\" \"$stage_dir/$linker\"","+        chmod u+x \"$stage_dir/$linker\"","+    done","+","+    # Clang's builtin headers (stddef.h, stdarg.h, ...) live in the resource","+    # dir. Derive it from the wrapper's own invoked path and strip the","+    # action's working directory prefix so the dir stays relative and free of","+    # \"..\" components: a clean relative resource dir makes clang report","+    # relative header paths, which bazel accepts for sandboxed and","+    # persistent-container compiles. (A hardcoded canonical repo name broke","+    # on bazel 9's repo-name mangling; an absolute or \"..\"-containing dir","+    # makes clang canonicalize paths through the sandbox symlinks and emit","+    # absolute paths in the .d file, which bazel rejects.)","+    resource_dir=\"${raw_dir%/*}/lib/clang/22\"","+    case \"$resource_dir\" in","+    \"$PWD\"/*) resource_dir=\"${resource_dir#\"$PWD\"/}\" ;;","+    esac","+    exec_args=(-resource-dir \"$resource_dir\" \"-B$stage_dir\")","+fi","+(","+    trap - HUP INT TERM","+    exec -a \"$argv0\" \"${tmp_tool}\" \"${exec_args[@]}\" \"$@\"","+) <&0 &","+tool_pid=$!","+wait \"$tool_pid\""],"additions":83,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_wasm/toolchain/wasi_repo.bzl","lines":["@@ -41,8 +41,10 @@ WASI_SDK_DIST = {","     },"," }"," ","+_WASI_SDK_OS_ENV = \"MONGO_BAZEL_WASI_SDK_OS\"","+"," def _normalize_os(name):","-    if name.startswith(\"mac os\"):","+    if name == \"macos\" or name.startswith(\"mac os\"):","         return \"macos\"","     if name.startswith(\"windows\"):","         return \"windows\"","@@ -87,7 +89,8 @@ def cross_execution_arch(selector):"," def wasi_execution_arch(rctx):","     \"\"\"Select an SDK executable architecture, independent of the target CPU.\"\"\""," ","-    os = _normalize_os(rctx.os.name)","+    requested_os = rctx.os.environ.get(_WASI_SDK_OS_ENV, \"\")","+    os = _normalize_os(requested_os) if requested_os else _normalize_os(rctx.os.name)"," ","     # The explicit execution override is authoritative.  tools/bazel adds it","     # before bootstrap and the cross-RBE hook adds it to the final invocation,","@@ -112,8 +115,39 @@ def wasi_execution_arch(rctx):","     # substitute an x86_64/aarch64 executable for a native IBM SDK.","     return _normalize_execution_arch(_normalize_arch(rctx.os.arch), os)"," ","+LINUX_TOOL_WRAPPER_TEMPLATE = Label(\":linux_tool_wrapper.sh\")","+","+def linux_tool_wrapper_substitutions():","+    \"\"\"Return template substitutions used by the repository and test fixture.\"\"\"","+    return {","+        wrapper: {","+            \"@MONGO_WASI_REAL_TOOL@\": real_tool,","+            \"@MONGO_WASI_ARGV0@\": argv0,","+        }","+        for wrapper, real_tool, argv0 in [","+            (\"mongo-wasm32-wasip2-clang\", \"clang-22\", \"wasm32-wasip2-clang\"),","+            (\"mongo-wasm32-wasip2-clang++\", \"clang-22\", \"wasm32-wasip2-clang++\"),","+            (\"mongo-llvm-ar\", \"llvm-ar\", \"llvm-ar\"),","+        ]","+    }","+","+def _write_linux_tool_wrappers(rctx):","+    \"\"\"Creates executable entrypoints for Linux tools downloaded on Windows.\"\"\"","+    for wrapper, substitutions in linux_tool_wrapper_substitutions().items():","+        rctx.template(","+            \"bin/\" + wrapper,","+            template = LINUX_TOOL_WRAPPER_TEMPLATE,","+            substitutions = substitutions,","+            executable = True,","+        )","+"," def _setup_wasi_deps(rctx):","-    os = _normalize_os(rctx.os.name)","+    # Repository rules run on the Bazel client, while WASI compile actions may","+    # run on a different execution platform. Windows cross builds execute","+    # these actions in Linux RBE containers, so use the Linux SDK there rather","+    # than passing Windows .exe tools to the remote worker.","+    requested_os = rctx.getenv(_WASI_SDK_OS_ENV)","+    os = _normalize_os(requested_os) if requested_os else _normalize_os(rctx.os.name)","     arch = wasi_execution_arch(rctx)","     key = (os, arch)"," ","@@ -174,9 +208,23 @@ esac","         \"share/wasi-sysroot/include/c++/v1/nonexistent.txt\",","     )"," ","-    # On Windows the binaries have .exe suffixes. Create wrapper scripts so","-    # the toolchain config can use the same label on all platforms.","+    # On Windows the binaries have .exe suffixes. Create aliases so the","+    # toolchain config can use the same labels on all platforms.","     exe = \".exe\" if os == \"windows\" else \"\"","+    if os == \"linux\" and _normalize_os(rctx.os.name) == \"windows\":","+        # A Linux SDK downloaded by a Windows Bazel client can lose Unix","+        # executable bits and symlink behavior in the local repository. These","+        # generated entrypoints are executable Bazel inputs, copy the real","+        # binaries to a writable path with the correct mode inside the RBE","+        # action, and preserve Clang's driver name through argv[0].","+        _write_linux_tool_wrappers(rctx)","+        clang = \"bin/mongo-wasm32-wasip2-clang\"","+        clangpp = \"bin/mongo-wasm32-wasip2-clang++\"","+        ar = \"bin/mongo-llvm-ar\"","+    else:","+        clang = \"bin/wasm32-wasip2-clang\" + exe","+        clangpp = \"bin/wasm32-wasip2-clang++\" + exe","+        ar = \"bin/llvm-ar\" + exe"," ","     rctx.file(","         \"BUILD.bazel\",","@@ -190,10 +238,10 @@ filegroup(name = \"share\",   srcs = glob([\"share/**\"]))"," "," # Platform-independent aliases for the WASI SDK tools so the toolchain"," # config can use the same labels on Linux, macOS, and Windows.","-alias(name = \"wasm32-wasip2-clang\",   actual = \"bin/wasm32-wasip2-clang{exe}\")","-alias(name = \"wasm32-wasip2-clang++\", actual = \"bin/wasm32-wasip2-clang++{exe}\")","-alias(name = \"llvm-ar\",               actual = \"bin/llvm-ar{exe}\")","-        \"\"\".format(exe = exe),","+alias(name = \"wasm32-wasip2-clang\",   actual = \"{clang}\")","+alias(name = \"wasm32-wasip2-clang++\", actual = \"{clangpp}\")","+alias(name = \"llvm-ar\",               actual = \"{ar}\")","+        \"\"\".format(clang = clang, clangpp = clangpp, ar = ar),","     )"," "," setup_wasi_deps = repository_rule(","@@ -208,5 +256,5 @@ setup_wasi_deps = repository_rule(","     # re-evaluated when the cross execution platform changes even though the","     # target platform remains wasm32.","     configure = True,","-    environ = [_LINUX_CROSS_TOOLCHAIN_ENV, _WASI_SDK_EXEC_ARCH_ENV],","+    environ = [_LINUX_CROSS_TOOLCHAIN_ENV, _WASI_SDK_EXEC_ARCH_ENV, _WASI_SDK_OS_ENV],"," )"],"additions":58,"deletions":10,"truncated":false},{"path":"bazel/toolchains/cc/mongo_wasm/toolchain/wasi_repo_test.bzl","lines":["@@ -1,11 +1,40 @@"," load(\"@bazel_skylib//lib:unittest.bzl\", \"asserts\", \"unittest\")"," load(","     \":wasi_repo.bzl\",","+    \"LINUX_TOOL_WRAPPER_TEMPLATE\",","     \"WASI_SDK_DIST\",","     \"cross_execution_arch\",","+    \"linux_tool_wrapper_substitutions\",","     \"wasi_execution_arch\","," )"," ","+def _linux_tool_wrapper_fixture_impl(ctx):","+    wrappers = [ctx.outputs.clang, ctx.outputs.clangpp, ctx.outputs.ar]","+    substitutions = linux_tool_wrapper_substitutions()","+    for wrapper in wrappers:","+        ctx.actions.expand_template(","+            template = ctx.file._wrapper_template,","+            output = wrapper,","+            substitutions = substitutions[wrapper.basename],","+            is_executable = True,","+        )","+    return [DefaultInfo(files = depset(wrappers))]","+","+linux_tool_wrapper_fixture = rule(","+    implementation = _linux_tool_wrapper_fixture_impl,","+    attrs = {","+        \"_wrapper_template\": attr.label(","+            default = LINUX_TOOL_WRAPPER_TEMPLATE,","+            allow_single_file = True,","+        ),","+    },","+    outputs = {","+        \"clang\": \"%{name}/bin/mongo-wasm32-wasip2-clang\",","+        \"clangpp\": \"%{name}/bin/mongo-wasm32-wasip2-clang++\",","+        \"ar\": \"%{name}/bin/mongo-llvm-ar\",","+    },","+)","+"," def _fake_repository_context(environ, arch, name = \"linux\"):","     return struct(os = struct(environ = environ, arch = arch, name = name))"," ","@@ -71,6 +100,34 @@ _wasi_sdk_dist_test = unittest.make(_wasi_sdk_dist_test_impl)"," def _wasi_execution_arch_test_impl(ctx):","     env = unittest.begin(ctx)"," ","+    # A Windows client can hydrate an SDK that executes on Linux workers.","+    asserts.equals(","+        env,","+        \"amd64\",","+        wasi_execution_arch(_fake_repository_context({","+            \"MONGO_BAZEL_WASI_SDK_OS\": \"linux\",","+        }, \"x86_64\", name = \"windows\")),","+    )","+","+    # Canonical OS overrides use the SDK's architecture spelling, even when","+    # the Bazel client runs on another OS.","+    for host_os in (\"linux\", \"mac os x\"):","+        asserts.equals(","+            env,","+            \"x86_64\",","+            wasi_execution_arch(_fake_repository_context({","+                \"MONGO_BAZEL_WASI_SDK_OS\": \"macos\",","+            }, \"x86_64\", name = host_os)),","+        )","+        asserts.equals(","+            env,","+            \"x86_64\",","+            wasi_execution_arch(_fake_repository_context({","+                \"MONGO_BAZEL_WASI_SDK_OS\": \"macos\",","+                \"MONGO_WASI_SDK_EXEC_ARCH\": \"amd64\",","+            }, \"aarch64\", name = host_os)),","+        )","+","     # The direct execution override is the source of truth and wins over a","     # stale selector during repository hydration.","     asserts.equals("],"additions":57,"deletions":0,"truncated":false},{"path":"bazel/toolchains/cc/mongo_wasm/toolchain/wasi_tool_wrapper_test.sh","lines":["@@ -0,0 +1,164 @@","+#!/bin/bash","+set -euo pipefail","+","+sdk_root=\"$(cd -- \"${1%/*}/..\" && pwd)\"","+test_dir=\"$(mktemp -d \"${TEST_TMPDIR:-/tmp}/wasi-wrapper-test.XXXXXX\")\"","+trap 'rm -rf -- \"$test_dir\"' EXIT","+","+copy_sdk_tool() {","+    local source_root=\"$1\" tool=\"$2\" destination=\"$3\"","+    local source=\"$source_root/bin/$tool\"","+    if [[ \"$tool\" == llvm-ar && -f \"$source_root/bin/llvm-ar.sdk\" ]]; then","+        source=\"$source_root/bin/llvm-ar.sdk\"","+    fi","+    cp -L -- \"$source\" \"$destination\"","+    chmod a-x \"$destination\"","+    [[ ! -x \"$destination\" ]]","+}","+","+# Generate the production entrypoints on Linux, and reproduce a Windows SDK","+# materialization without executable bits. Never change the downloaded SDK.","+fixture=\"$test_dir/sdk with spaces\"","+mkdir -p \"$fixture/bin\" \"$test_dir/tools tmp\"","+for tool in clang-22 llvm-ar wasm-ld wasm-component-ld; do","+    copy_sdk_tool \"$sdk_root\" \"$tool\" \"$fixture/bin/$tool\"","+done","+for wrapper in \"${@:2}\"; do","+    cp -- \"$wrapper\" \"$fixture/bin/\"","+done","+ln -s -- \"$sdk_root/lib\" \"$fixture/lib\"","+ln -s -- \"$sdk_root/share\" \"$fixture/share\"","+","+clang=\"$fixture/bin/mongo-wasm32-wasip2-clang\"","+clangpp=\"$fixture/bin/mongo-wasm32-wasip2-clang++\"","+ar=\"$fixture/bin/mongo-llvm-ar\"","+export TMPDIR=\"$test_dir/tools tmp\" TMP=Z:/b TEMP=Z:/b","+","+assert_clean() {","+    local staged","+    shopt -s nullglob","+    staged=(\"$TMPDIR\"/mongo-wasi-*)","+    if [[ ${#staged[@]} != 0 ]]; then","+        printf 'Wrapper left temporary tools behind: %s\\n' \"${staged[@]}\" >&2","+        return 1","+    fi","+}","+","+for tool in \"$clang\" \"$clangpp\" \"$ar\"; do","+    PATH=/nonexistent LD_LIBRARY_PATH= \"$tool\" --version >/dev/null","+    assert_clean","+done","+","+# Include builtin and C++ headers to verify the default resource directory and","+# the clang++ driver name, then link with a non-executable SDK wasm-ld.","+cat >\"$test_dir/main.cpp\" <<'SOURCE'","+#include <stddef.h>","+#include <stdarg.h>","+#include <vector>","+int main() { return std::vector<int>{1, 2}.size() != 2; }","+SOURCE","+PATH=/nonexistent \"$clangpp\" \\","+    --target=wasm32-wasip2 \\","+    -fno-exceptions \\","+    --sysroot=\"$fixture/share/wasi-sysroot\" \\","+    -o \"$test_dir/default-resource-dir.wasm\" \\","+    \"$test_dir/main.cpp\"","+[[ -s \"$test_dir/default-resource-dir.wasm\" ]]","+assert_clean","+","+PATH=/nonexistent \"$clangpp\" \\","+    --target=wasm32-wasip2 \\","+    -fwasm-exceptions \\","+    --sysroot=\"$fixture/share/wasi-sysroot\" \\","+    -resource-dir=\"$fixture/lib/clang/22\" \\","+    -L\"$fixture/share/wasi-sysroot/lib/wasm32-wasip2/eh\" \\","+    -lc++ \\","+    -lc++abi \\","+    -lwasi-emulated-signal \\","+    -lwasi-emulated-mman \\","+    -lwasi-emulated-process-clocks \\","+    -lwasi-emulated-getpid \\","+    -lunwind \\","+    -o \"$test_dir/explicit-resource-dir.wasm\" \\","+    \"$test_dir/main.cpp\"","+[[ -s \"$test_dir/explicit-resource-dir.wasm\" ]]","+assert_clean","+","+# Also exercise the C entrypoint, the archiver, and TMP/TEMP normalization when","+# TMPDIR is a Windows path that does not exist on the Linux worker.","+echo 'int answer(void) { return 42; }' | PATH=/nonexistent TMPDIR=Z:/b \"$clang\" \\","+    --target=wasm32-wasip2 --sysroot=\"$fixture/share/wasi-sysroot\" \\","+    -c -x c - -o \"$test_dir/answer.o\"","+PATH=/nonexistent \"$ar\" rcs \"$test_dir/answer.a\" \"$test_dir/answer.o\"","+[[ -s \"$test_dir/answer.a\" ]]","+assert_clean","+","+# IBM repositories keep the SDK archiver in llvm-ar.sdk and replace llvm-ar","+# with a dispatcher. The fixture must use the payload so relocation does not","+# break that dispatcher's sibling paths. Exercise this layout on every host.","+ibm_sdk=\"$test_dir/ibm sdk\"","+ibm_fixture=\"$test_dir/ibm fixture\"","+mkdir -p \"$ibm_sdk/bin\" \"$ibm_fixture/bin\"","+ln -s -- \"$fixture/bin/llvm-ar\" \"$ibm_sdk/bin/llvm-ar.sdk\"","+printf '#!/bin/sh\\nexit 99\\n' >\"$ibm_sdk/bin/llvm-ar\"","+copy_sdk_tool \"$ibm_sdk\" llvm-ar \"$ibm_fixture/bin/llvm-ar\"","+cp -- \"$ar\" \"$ibm_fixture/bin/mongo-llvm-ar\"","+ln -s -- \"$sdk_root/lib\" \"$ibm_fixture/lib\"","+PATH=/nonexistent \"$ibm_fixture/bin/mongo-llvm-ar\" \\","+    rcs \"$test_dir/ibm-answer.a\" \"$test_dir/answer.o\"","+[[ -s \"$test_dir/ibm-answer.a\" ]]","+assert_clean","+","+# A stub tool inspects the wrapper environment, including empty, unset, and","+# inherited search paths, and verifies cleanup and status propagation on error.","+cat >\"$fixture/bin/clang-22\" <<'STUB'","+#!/bin/bash","+set -euo pipefail","+[[ \"$PATH\" != :* && \"$PATH\" != *: && \"$PATH\" != *::* ]]","+[[ \"$LD_LIBRARY_PATH\" != :* && \"$LD_LIBRARY_PATH\" != *: && \"$LD_LIBRARY_PATH\" != *::* ]]","+[[ \"$TMPDIR\" == \"$TMP\" && \"$TMPDIR\" == \"$TEMP\" && -d \"$TMPDIR\" ]]","+[[ -x \"${0%/*}/wasm-ld\" ]]","+[[ -x \"${0%/*}/wasm-component-ld\" ]]","+[[ \"$(stat -c %a \"${0%/*}\")\" == 700 ]]","+if [[ \"${EXPECT_INHERITED:-}\" == 1 ]]; then","+    [[ \"$PATH\" == *:/sentinel/bin && \"$LD_LIBRARY_PATH\" == *:/sentinel/lib ]]","+fi","+if [[ \"${WAIT_FOR_SIGNAL:-}\" == 1 ]]; then","+    printf '%s\\n' \"$BASHPID\" > \"$READY_FILE\"","+    trap 'exit 143' TERM","+    while true; do sleep 0.1; done","+fi","+exit \"${TOOL_STATUS:-0}\"","+STUB","+chmod a-x \"$fixture/bin/clang-22\"","+PATH= LD_LIBRARY_PATH= \"$clang\"","+assert_clean","+env -u PATH -u LD_LIBRARY_PATH \"$clang\"","+assert_clean","+EXPECT_INHERITED=1 PATH=/sentinel/bin LD_LIBRARY_PATH=/sentinel/lib \"$clang\"","+assert_clean","+status=0","+TOOL_STATUS=42 PATH=/nonexistent \"$clang\" || status=$?","+[[ \"$status\" == 42 ]]","+assert_clean","+","+# Terminating the wrapper must stop the child and remove its staged tools.","+WAIT_FOR_SIGNAL=1 READY_FILE=\"$test_dir/ready\" PATH=/nonexistent \"$clang\" &","+wrapper_pid=$!","+for attempt in {1..100}; do","+    [[ -s \"$test_dir/ready\" ]] && break","+    sleep 0.05","+done","+if [[ ! -s \"$test_dir/ready\" ]]; then","+    kill -TERM \"$wrapper_pid\"","+    wait \"$wrapper_pid\" || true","+    echo 'Tool did not start before the signal-test deadline' >&2","+    exit 1","+fi","+tool_pid=\"$(cat \"$test_dir/ready\")\"","+kill -TERM \"$wrapper_pid\"","+status=0","+wait \"$wrapper_pid\" || status=$?","+[[ \"$status\" == 143 ]]","+! kill -0 \"$tool_pid\" 2>/dev/null","+assert_clean"],"additions":164,"deletions":0,"truncated":false},{"path":"bazel/toolchains/python/BUILD.bazel","lines":["@@ -0,0 +1,10 @@","+load(\"@rules_python//python:defs.bzl\", \"py_test\")","+","+py_test(","+    name = \"python_toolchain_test\",","+    srcs = [\"python_toolchain_test.py\"],","+    data = [","+        \"python_toolchain.BUILD.tmpl\",","+        \"python_toolchain.bzl\",","+    ],","+)"],"additions":10,"deletions":0,"truncated":false},{"path":"bazel/toolchains/python/python_toolchain.bzl","lines":["@@ -168,6 +168,12 @@ toolchain(","         stripPrefix = \"python\",","     )"," ","+    if is_host_windows and is_toolchain_linux:","+        # Linux terminfo aliases that differ only by case become symlink cycles on","+        # Windows filesystems. Build-time Python does not need this terminal database,","+        # and excluding it from glob() does not prevent traversal of the cycles.","+        ctx.delete(\"dist/share/terminfo\")","+","     windows_python = False","     for name in ctx.path(\"dist\").readdir():","         if name.basename == \"python.exe\":"],"additions":6,"deletions":0,"truncated":false},{"path":"bazel/toolchains/python/python_toolchain_test.py","lines":["@@ -0,0 +1,129 @@","+\"\"\"Regression tests for hydrating Python execution toolchains on Windows.\"\"\"","+","+import ast","+import shutil","+import tempfile","+import unittest","+from collections.abc import Callable","+from pathlib import Path","+from types import SimpleNamespace"],"additions":9,"deletions":0,"truncated":false}],"additions":506,"deletions":25,"truncated":true,"file_count":17},"error":null,"fetched_at":"2026-11-04T16:06:44.964723+00:00"}