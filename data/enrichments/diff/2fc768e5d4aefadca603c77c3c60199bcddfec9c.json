      Publication = new(true, true)","+        }, \"CLR\", \"ClrWorkflowMaterializer\");","+        var populator = CreatePopulatorWithTenant(\"tenant-b\", restamper, workflow);","+","+        var result = (await populator.PopulateStoreAsync()).ToList();","+","+        Assert.Empty(result);","+        await restamper.Received(1).RestampAsync(\"owned-workflow\", 1, \"tenant-a\", Arg.Any<CancellationToken>());","+        await _storeMock.DidNotReceive().SaveManyAsync(Arg.Any<IEnumerable<WorkflowDefinition>>(), Arg.Any<CancellationToken>());","+    }","+","+    [Fact(DisplayName = \"A failing CLR re-stamp is skipped so later workflows still populate, index, and reload\")]","+    public async Task PopulateAsync_MalformedClrRestamp_StillPopulatesIndexesAndReloads()","+    {","+        var restamper = Substitute.For<IClrWorkflowDefinitionTenantRestamper>();","+        restamper","+            .RestampAsync(\"bad-workflow\", Arg.Any<int>(), Arg.Any<string>(), Arg.Any<CancellationToken>())","+            .Returns<Task<bool>>(_ => throw new InvalidOperationException(\"malformed Props\"));","+        restamper","+            .RestampAsync(\"good-workflow\", Arg.Any<int>(), Arg.Any<string>(), Arg.Any<CancellationToken>())","+            .Returns(true);","+","+        var triggerIndexer = Substitute.For<ITriggerIndexer>();","+        var notificationSender = Substitute.For<INotificationSender>();","+        var logger = new CapturingLogger();","+        var bad = new MaterializedWorkflow(new()","+        {","+            Identity = new(\"bad-workflow\", 1, \"bad-v1\", Tenant.AgnosticTenantId),","+            Publication = new(true, true)","+        }, \"CLR\", \"ClrWorkflowMaterializer\");","+        var good = new MaterializedWorkflow(new()","+        {","+            Identity = new(\"good-workflow\", 1, \"good-v1\", Tenant.AgnosticTenantId),","+            Publication = new(true, true)","+        }, \"CLR\", \"ClrWorkflowMaterializer\");","+        var storePopulator = CreatePopulatorWithTenant(\"tenant-a\", logger, restamper, triggerIndexer, bad, good);","+        var registries = new DefaultRegistriesPopulator(","+            storePopulator,","+            Substitute.For<IActivityRegistryPopulator>(),","+            notificationSender);","+","+        await registries.PopulateAsync();","+","+        await _storeMock.Received().SaveManyAsync(Arg.Is<IEnumerable<WorkflowDefinition>>(definitions =>","+            definitions.Any(definition => definition.DefinitionId == \"good-workflow\")), Arg.Any<CancellationToken>());","+        await triggerIndexer.Received().IndexTriggersAsync(","+            Arg.Is<WorkflowDefinition>(definition => definition.DefinitionId == \"good-workflow\"),","+            Arg.Any<CancellationToken>());","+        await notificationSender.Received().SendAsync(","+            Arg.Is<WorkflowDefinitionsReloaded>(notification =>","+                notification.ReloadedWorkflowDefinitions.Any(definition => definition.DefinitionId == \"good-workflow\")),","+            Arg.Any<CancellationToken>());","+        Assert.Contains(logger.Messages, message =>","+            message.Contains(\"Skipping CLR tenant re-stamp\", StringComparison.Ordinal)","+            && message.Contains(\"bad-workflow\", StringComparison.Ordinal));","+    }","+","     [Theory(DisplayName = \"PopulateStoreAsync handles null/empty tenant IDs correctly\")]","     [InlineData(null, null, true)]  // Both null - should import","     [InlineData(\"\", \"\", true)]      // Both empty - should import","@@ -295,7 +418,34 @@ private MaterializedWorkflow CreateMaterializedWorkflow(string definitionId, str","         }, \"Test\", \"TestProvider\");","     }"," ","-    private DefaultWorkflowDefinitionStorePopulator CreatePopulatorWithTenant(string? tenantId, params MaterializedWorkflow[] workflows)","+    private DefaultWorkflowDefinitionStorePopulator CreatePopulatorWithTenant(string? tenantId, params MaterializedWorkflow[] workflows) =>","+        CreatePopulatorWithTenant(tenantId, Substitute.For<ILogger<DefaultWorkflowDefinitionStorePopulator>>(), restamper: null, workflows);","+","+    private DefaultWorkflowDefinitionStorePopulator CreatePopulatorWithTenant(","+        string? tenantId,","+        ILogger<DefaultWorkflowDefinitionStorePopulator> logger,","+        params MaterializedWorkflow[] workflows) =>","+        CreatePopulatorWithTenant(tenantId, logger, restamper: null, workflows);","+","+    private DefaultWorkflowDefinitionStorePopulator CreatePopulatorWithTenant(","+        string? tenantId,","+        IClrWorkflowDefinitionTenantRestamper restamper,","+        params MaterializedWorkflow[] workflows) =>","+        CreatePopulatorWithTenant(tenantId, Substitute.For<ILogger<DefaultWorkflowDefinitionStorePopulator>>(), restamper, workflows);","+","+    private DefaultWorkflowDefinitionStorePopulator CreatePopulatorWithTenant(","+        string? tenantId,","+        ILogger<DefaultWorkflowDefinitionStorePopulator> logger,","+        IClrWorkflowDefinitionTenantRestamper? restamper,","+        params MaterializedWorkflow[] workflows) =>","+        CreatePopulatorWithTenant(tenantId, logger, restamper, triggerIndexer: null, workflows);","+","+    private DefaultWorkflowDefinitionStorePopulator CreatePopulatorWithTenant(","+        string? tenantId,","+        ILogger<DefaultWorkflowDefinitionStorePopulator> logger,","+        IClrWorkflowDefinitionTenantRestamper? restamper,","+        ITriggerIndexer? triggerIndexer,","+        params MaterializedWorkflow[] workflows)","     {","         var tenantAccessor = Substitute.For<ITenantAccessor>();","         tenantAccessor.Tenant.Returns(tenantId != null ? new Tenant { Id = tenantId } : null);","@@ -308,13 +458,36 @@ private DefaultWorkflowDefinitionStorePopulator CreatePopulatorWithTenant(string"," ","         return new(","             () => new List<IWorkflowsProvider> { provider },","-            Substitute.For<ITriggerIndexer>(),","+            triggerIndexer ?? Substitute.For<ITriggerIndexer>(),","             _storeMock,","             Substitute.For<IActivitySerializer>(),","             Substitute.For<IPayloadSerializer>(),","             Substitute.For<ISystemClock>(),","             Substitute.For<IIdentityGraphService>(),","             tenantAccessor,","-            Substitute.For<ILogger<DefaultWorkflowDefinitionStorePopulator>>());","+            logger,","+            restamper);","+    }","+","+    private sealed class CapturingLogger : ILogger<DefaultWorkflowDefinitionStorePopulator>","+    {","+        public List<string> Messages { get; } = [];","+","+        public IDisposable BeginScope<TState>(TState state) where TState : notnull => NullScope.Instance;","+","+        public bool IsEnabled(LogLevel logLevel) => true;","+","+        public void Log<TState>(LogLevel logLevel, EventId eventId, TState state, Exception? exception, Func<TState, Exception?, string> formatter)","+        {","+            Messages.Add(formatter(state, exception));","+        }","+","+        private sealed class NullScope : IDisposable","+        {","+            public static readonly NullScope Instance = new();","+            public void Dispose()","+            {","+            }","+        }","     }"," }","\\ No newline at end of file"],"additions":176,"deletions":3,"truncated":false},{"path":"extensions/docs/README.md","lines":["@@ -38,5 +38,7 @@ The former [Extensions repository README](../../docs/integration-program/legacy/"," is retained as import provenance. Its planned-provider table, old repository"," paths and examples are historical claims. Use each active module's documentation"," and released package metadata for availability. The [3.6](changelogs/3.6.0.md) and","-[3.7](changelogs/3.7.0.md) notes remain release history. Follow the root","+[3.7](changelogs/3.7.0.md) notes are release history.","+The [3.10.1](changelogs/3.10.1.md) note covers the upcoming patch, including the","+automatic CLR tenant re-stamp for multi-tenant Dapper hosts. Follow the root"," [contribution guide](../../CONTRIBUTING.md) for changes and contributor attribution."],"additions":3,"deletions":1,"truncated":false},{"path":"extensions/docs/changelogs/3.10.1.md","lines":["@@ -0,0 +1,22 @@","+# Elsa 3.10.1 — Extensions notes","+","+## Persistence (Dapper)","+","+- Dapper `Store<T>` now matches EF Core tenant-agnostic visibility on reads: a concrete tenant also sees `*` rows (and the default tenant still sees `NULL` / `''` rows). [#9010](https://github.com/elsa-workflows/elsa-core/issues/9010)","+- `DapperWorkflowDefinitionStore.TryUpdateLatest` uses the same `*` read visibility, so a concrete tenant can update the latest version of a shared definition without restamping it. [#9023](https://github.com/elsa-workflows/elsa-core/issues/9023)","+- Upserts and `UpdateAsync` are scoped to the tenant. A save whose Id already belongs to another concrete tenant throws instead of overwriting that row.","+- Stamping keeps an explicit `*`, stamps only when `TenantId` is null, and throws when an explicit concrete tenant id differs from the ambient tenant. A concrete tenant cannot restamp an existing `*` row to itself.","+- **SQLite hosts must use SQLite 3.24 or later.** The Dapper provider emits `INSERT … ON CONFLICT DO UPDATE` (UPSERT) instead of `INSERT OR REPLACE`. Microsoft.Data.Sqlite with the bundled e_sqlite3 engine already meets this. A host that swaps in an older system SQLite library will fail on save.","+","+## Upgrade: multi-tenant Dapper hosts","+","+`ClrWorkflowsProvider` marks a workflow as shared when the workflow identity declares no tenant (`workflow.Identity.TenantId ?? \"*\"`). Before 3.10.1, Dapper restamped that `*` to the ambient tenant and moved the row on each load, so upgraded databases hold each such definition under the last tenant that loaded it.","+","+On the first startup after this patch, the definition-store populator re-stamps each CLR (`ProviderName = 'CLR'`) workflow that is currently registered in code to the tenant declared in that code. Older stored versions of the same definition that are no longer registered are left as they are. No operator SQL is required, and a failing re-stamp is logged and skipped so later workflows still populate.","+","+- A shared CLR workflow (no declared tenant) that was stamped to the last loading tenant is re-stamped to `*` and becomes visible to every tenant again.","+- A CLR workflow that declares a concrete tenant and was stored as `*` is restored to that tenant and is no longer visible to or runnable by other tenants.","+- Non-CLR rows are not re-stamped. Normal `Store<T>` saves still refuse a tenant takeover of `*`.","+- On EF Core, the same populator also aligns a visible CLR row's `TenantId` with the tenant declared in code when that declaration changes between deployments.","+","+Single-tenant and fresh multi-tenant hosts do not need a data step: the default tenant still sees `NULL` / `''` rows, and a new database stores shared CLR workflows as `*`."],"additions":22,"deletions":0,"truncated":false},{"path":"extensions/src/persistence/Elsa.Persistence.Dapper/Abstractions/SqlDialectBase.cs","lines":["@@ -109,12 +109,13 @@ public virtual string Upsert(string table, string primaryKeyField, string[] fiel","         var fieldList = string.Join(\", \", fields);","         var fieldParamNames = fields.Select(x => $\"@{getParamName(x)}\");","         var fieldParamList = string.Join(\", \", fieldParamNames);","+        var tenantMatch = SqlDialectStatements.TenantScopedMatchAnd(fields, \"Target.TenantId\", \"Source.TenantId\");","         return @$\"","                       MERGE INTO {table} WITH (HOLDLOCK) AS Target","                       USING (VALUES (@{getParamName(primaryKeyField)}, {fieldParamList}))","                       AS Source ({primaryKeyField}, {fieldList})","                       ON Target.{primaryKeyField} = Source.{primaryKeyField}","-                      WHEN MATCHED THEN ","+                      WHEN MATCHED{tenantMatch} THEN ","                       UPDATE SET {string.Join(\", \", fields.Select(x => $\"{x} = Source.{x}\"))}","                       WHEN NOT MATCHED THEN","                       INSERT ({primaryKeyField}, {fieldList})"],"additions":2,"deletions":1,"truncated":false},{"path":"extensions/src/persistence/Elsa.Persistence.Dapper/Contracts/ISqlDialect.cs","lines":["@@ -166,10 +166,33 @@ string Update(string table, string[] fields, Func<string, string>? getParamName"," "," internal static class SqlDialectStatements"," {","+    public const string TenantIdColumn = \"TenantId\";","+","     public static string Update(string table, string[] fields, Func<string, string>? getParamName)","     {","         getParamName ??= static x => x;","         var fieldList = string.Join(\", \", fields.Select(x => $\"{x} = @{getParamName(x)}\"));","         return $\"UPDATE {table} SET {fieldList} WHERE 1=1\";","     }","+","+    public static bool HasTenantId(string[] fields) =>","+        fields.Contains(TenantIdColumn, StringComparer.Ordinal);","+","+    /// <summary>","+    /// Treats <c>NULL</c> and <c>''</c> as the same default tenant, matching","+    /// <c>ApplyTenantFilter</c>. <c>IS NOT DISTINCT FROM</c> would miss that pair and","+    /// is not available on SQL Server before 2022.","+    /// </summary>","+    public static string TenantIdEquals(string left, string right) =>","+        $\"COALESCE({left}, '') = COALESCE({right}, '')\";","+","+    public static string TenantScopedUpdateWhere(string[] fields, Func<string, string> quoteColumn, Func<string, string> getParamName) =>","+        HasTenantId(fields)","+            ? $\" WHERE {TenantIdEquals(quoteColumn(TenantIdColumn), $\"@{getParamName(TenantIdColumn)}\")}\"","+            : string.Empty;","+","+    public static string TenantScopedMatchAnd(string[] fields, string targetColumn, string sourceColumn) =>","+        HasTenantId(fields)","+            ? $\" AND {TenantIdEquals(tar