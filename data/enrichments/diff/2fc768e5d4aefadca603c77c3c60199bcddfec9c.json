{"id":"2fc768e5d4aefadca603c77c3c60199bcddfec9c","axis":"silent","repo":"elsa-workflows/elsa-core","sha":"2fc768e5d4aefadca603c77c3c60199bcddfec9c","parsed":{"files":[{"path":".github/workflows/dapper-provider-tests.yml","lines":["@@ -22,7 +22,7 @@ permissions:"," "," env:","   PROJECT: extensions/test/modules/persistence/Elsa.Persistence.Dapper.UnitTests/Elsa.Persistence.Dapper.UnitTests.csproj","-  FILTER: FullyQualifiedName~DapperWorkflowDefinitionStoreTests","+  FILTER: FullyQualifiedName~DapperWorkflowDefinitionStoreTests|FullyQualifiedName~DapperStoreTenantUpsertTests|FullyQualifiedName~DapperSharedWorkflowStartupTests"," "," jobs:","   store-tests:"],"additions":1,"deletions":1,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Runtime/Contracts/IClrWorkflowDefinitionTenantRestamper.cs","lines":["@@ -0,0 +1,16 @@","+namespace Elsa.Workflows.Runtime;","+","+/// <summary>","+/// Re-stamps a CLR workflow definition's <c>TenantId</c> to the tenant declared in code.","+/// Used only by <see cref=\"DefaultWorkflowDefinitionStorePopulator\"/>.","+/// </summary>","+public interface IClrWorkflowDefinitionTenantRestamper","+{","+    /// <summary>","+    /// Finds the CLR row for <paramref name=\"definitionId\"/> and <paramref name=\"version\"/>","+    /// without a tenant filter. When its stored tenant differs from","+    /// <paramref name=\"declaredTenantId\"/>, updates only that row. Returns","+    /// <c>true</c> when a CLR row was found. Does not materialize the definition.","+    /// </summary>","+    Task<bool> RestampAsync(string definitionId, int version, string declaredTenantId, CancellationToken cancellationToken = default);","+}"],"additions":16,"deletions":0,"truncated":false},{"path":"core/src/modules/Elsa.Workflows.Runtime/Providers/ClrWorkflowsProvider.cs","lines":["@@ -16,8 +16,13 @@ public class ClrWorkflowsProvider(","     IWorkflowBuilderFactory workflowBuilderFactory,","     IServiceProvider serviceProvider) : IWorkflowsProvider"," {","+  