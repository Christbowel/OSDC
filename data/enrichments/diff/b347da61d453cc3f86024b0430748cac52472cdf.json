on_status, creation_status);"],"additions":1,"deletions":0,"truncated":false},{"path":"source/common/tls/context_config_impl.h","lines":["@@ -62,6 +62,7 @@ class ContextConfigImpl : public virtual Ssl::ContextConfig,","   }","   unsigned minProtocolVersion() const override { return min_protocol_version_; };","   unsigned maxProtocolVersion() const override { return max_protocol_version_; };","+  std::optional<uint32_t> maxSendFragment() const override { return max_send_fragment_; }","   const Network::Address::IpList& tlsKeyLogLocal() const override { return *tls_keylog_local_; };","   const Network::Address::IpList& tlsKeyLogRemote() const override { return *tls_keylog_remote_; };","   const std::string& tlsKeyLogPath() const override { return tls_keylog_path_; };","@@ -129,6 +130,7 @@ class ContextConfigImpl : public virtual Ssl::ContextConfig,","   Envoy::Common::CallbackHandlePtr cvc_validation_callback_handle_;","   const unsigned min_protocol_version_;","   const unsigned max_protocol_version_;","+  const std::optional<uint32_t> max_send_fragment_;"," ","   Ssl::HandshakerFactoryCb handshaker_factory_cb_;","   Ssl::HandshakerCapabilities capabilities_;"],"additions":2,"deletions":0,"truncated":false},{"path":"source/common/tls/context_impl.cc","lines":["@@ -142,6 +142,13 @@ ContextImpl::ContextImpl(","     rc = SSL_CTX_set_max_proto_version(ctx.ssl_ctx_.get(), config.maxProtocolVersion());","     RELEASE_ASSERT(rc == 1, Utility::getLastCryptoError().value_or(\"\"));"," ","+    // Caps the plaintext of every record sent, handshake messages included.","+    if (const std::optional<uint32_t> max_send_fragment = config.maxSendFragment();","+        max_send_fragment.has_value()) {","+      rc = SSL_CTX_set_max_send_fragment(ctx.ssl_ctx_.get(), max_send_fragment.value());","+      RELEASE_ASSERT(rc == 1, Utility::getLastCryptoError().value_or(\"\"));","+    }","+","     if (!capabilities_.provides_ciphers_and_curves || !capabilities_.provides_sigalgs) {","       creation_status = Utility::validateCipherCurveAndSigalgsOnSslCtx(","           capabilities_.provides_ciphers_and_curves ? \"\" : config.cipherSuites(),"],"additions":7,"deletions":0,"truncated":false},{"path":"test/common/tls/context_impl_test.cc","lines":["@@ -2020,6 +2020,46 @@ TEST_F(ServerContextConfigImplTest, TlsCertificatesAndSdsConfig) {","       \"SDS and non-SDS TLS certificates may not be mixed in server contexts\");"," }"," ","+// max_send_fragment is read from CommonTlsContext, is unset by default, and the configured value","+// builds a working server context.","+TEST_F(ServerContextConfigImplTest, MaxSendFragment) {","+  const std::string yaml = R\"EOF(","+  common_tls_context:","+    tls_certificates:","+    - certificate_chain:","+        filename: \"{{ test_rundir }}/test/common/tls/test_data/selfsigned_cert.pem\"","+      private_key:","+        filename: \"{{ test_rundir }}/test/common/tls/test_data/selfsigned_key.pem\"","+  )EOF\";","+  envoy::extensions::transport_sockets::tls::v3::DownstreamTlsContext tls_context;","+  TestUtility::loadFromYaml(TestEnvironment::substitute(yaml), tls_context);","+  EXPECT_EQ(std::nullopt,","+            (*ServerContextConfigImpl::create(tls_context, factory_context_, {}, false))","+                ->maxSendFragment());","+","+  tls_context.mutable_common_tls_context()->mutable_max_send_fragment()->set_value(8192);","+  TestUtility::validate(tls_context);","+  auto server_context_config =","+      *ServerContextConfigImpl::create(tls_context, factory_context_, {}, false);","+  EXPECT_EQ(8192, server_context_config->maxSendFragment());","+","+  ContextManagerImpl manager(factory_context_.server_context_);","+  Envoy::Ssl::ServerContextSharedPtr server_context =","+      *manager.createSslServerContext(*store_.rootScope(), *server_context_config, nullptr);","+  EXPECT_NE(nullptr, server_context);","+  manager.removeContext(server_context);","+}","+","+// max_send_fragment must be within the TLS record plaintext limits that BoringSSL accepts.","+TEST_F(ServerContextConfigImplTest, MaxSendFragmentOutOfRange) {","+  for (const uint32_t max_send_fragment : {0u, 511u, 16385u}) {","+    envoy::extensions::transport_sockets::tls::v3::DownstreamTlsContext tls_context;","+    tls_context.mutable_common_tls_context()->mutable_max_send_fragment()->set_value(","+        max_send_fragment);","+    EXPECT_THROW_WITH_REGEX(TestUtility::validate(tls_context), EnvoyException, \"MaxSendFragment\");","+  }","+}","+"," TEST_F(ServerContextConfigImplTest, SdsConfigNoName) {","   envoy::extensions::transport_sockets::tls::v3::DownstreamTlsContext tls_context;","   tls_context.mutable_common_tls_context()->add_tls_certificate_sds_secret_configs();"],"additions":40,"deletions":0,"truncated":false},{"path":"test/common/tls/ssl_socket_test.cc","lines":["@@ -8682,6 +8682,10 @@ class SslReadBufferLimitTest : public SslSocketTest {","   void initialize() {","     TestUtility::loadFromYaml(TestEnvironment::substitute(server_ctx_yaml_),","                               downstream_tls_context_);","+    if (max_send_fragment_.has_value()) {","+      downstream_tls_context_.mutable_common_tls_context()->mutable_max_send_fragment()->set_value(","+          max_send_fragment_.value());","+    }","     auto server_cfg =","         *ServerContextConfigImpl::create(downstream_tls_context_, factory_context_, {}, false);","     manager_ = std::make_unique<ContextManagerImpl>(factory_context_.serverFactoryContext());","@@ -8696,6 +8700,10 @@ class SslReadBufferLimitTest : public SslSocketTest {","                                overload_state, *dispatcher_);"," ","     TestUtility::loadFromYaml(TestEnvironment::substitute(client_ctx_yaml_), upstream_tls_context_);","+    if (max_send_fragment_.has_value()) {","+      upstream_tls_context_.mutable_common_tls_context()->mutable_max_send_fragment()->set_value(","+          max_send_fragment_.value());","+    }","     auto client_cfg = *ClientContextConfigImpl::create(upstream_tls_context_, factory_context_);"," ","     client_ssl_socket_factory_ = *ClientSslSocketFactory::create(std::move(client_cfg), *manager_,","@@ -8858,6 +8866,84 @@ class SslReadBufferLimitTest : public SslSocketTest {","     dispatcher_->run(Event::Dispatcher::RunType::Block);","   }"," ","+  // The length of every TLS record the client sent and received.","+  struct TlsRecordLengths {","+    std::vector<uint16_t> sent;","+    std::vector<uint16_t> received;","+  };","+","+  // Connects, sends payload from the client to the server, and returns the length of every TLS","+  // record the client sent and received, starting with the first handshake record.","+  TlsRecordLengths sendAndRecordTlsRecordLengths(const std::string& payload) {","+    initialize();","+","+    TlsRecordLengths record_lengths;","+#ifndef ENVOY_SSL_OPENSSL","+    SSL* client_ssl = dynamic_cast<SslSocket*>(client_transport_socket_)->rawSslForTest();","+    SSL_set_msg_callback(client_ssl, [](int is_write, int, int content_type, const void* buf,","+                                        size_t len, SSL*, void* arg) {","+      if (content_type != SSL3_RT_HEADER || len != SSL3_RT_HEADER_LENGTH) {","+        return;","+      }","+      const auto* header = static_cast<const uint8_t*>(buf);","+      auto* lengths = static_cast<TlsRecordLengths*>(arg);","+      (is_write ? lengths->sent : lengths->received).push_back((header[3] << 8) | header[4]);","+    });","+    SSL_set_msg_callback_arg(client_ssl, &record_lengths);","+#endif","+","+    EXPECT_CALL(listener_callbacks_, onAccept_(_))","+        .WillOnce([&](Network::ConnectionSocketPtr& socket) -> void {","+          server_connection_ = dispatcher_->createServerConnection(","+              std::move(socket), server_ssl_socket_factory_->createDownstreamTransportSocket(),","+              stream_info_);","+          server_connection_->addConnectionCallbacks(server_callbacks_);","+          server_connection_->addReadFilter(read_filter_);","+        });","+    EXPECT_CALL(listener_callbacks_, recordConnectionsAcceptedOnSocketEvent(_));","+","+    EXPECT_CALL(client_callbacks_, onEvent(Network::ConnectionEvent::Connected))","+        .WillOnce([&](Network::ConnectionEvent) -> void { dispatcher_->exit(); });","+    dispatcher_->run(Event::Dispatcher::RunType::Block);","+","+    std::string received;","+    EXPECT_CALL(*read_filter_, onNewConnection());","+    EXPECT_CALL(*read_filter_, onData(_, _))","+        .WillRepeatedly([&](Buffer::Instance& data, bool) -> Network::FilterStatus {","+          received.append(data.toString());","+          data.drain(data.length());","+          if (received.size() == payload.size()) {","+            server_connection_->close(Network::ConnectionCloseType::FlushWrite);","+          }","+          return Network::FilterStatus::StopIteration;","+        });","+    EXPECT_CALL(client_callbacks_, onEvent(Network::ConnectionEvent::RemoteClose))","+        .WillOnce([&](Network::ConnectionEvent) -> void { dispatcher_->exit(); });","+","+    Buffer::OwnedImpl data(payload);","+    client_connection_->write(data, false);","+    dispatcher_->run(Event::Dispatcher::RunType::Block);","+","+    EXPECT_EQ(payload, received);","+    EXPECT_EQ(0UL, server_stats_store_.counter(\"ssl.connection_error\").value());","+    EXPECT_EQ(0UL, client_stats_store_.counter(\"ssl.connection_error\").value());","+#ifndef ENVOY_SSL_OPENSSL","+    // record_lengths goes out of scope on return, but the client connection does not.","+    SSL_set_msg_callback(client_ssl, nullptr);","+#endif","+    return record_lengths;","+  }","+","+  static std::string generatePayload(uint32_t size) {","+    std::string payload;","+    payload.reserve(size);","+    for (uint32_t i = 0; i < size; i++) {","+      payload.push_back('a' + i % 26);","+    }","+    return payload;","+  }","+","+  std::optional<uint32_t> max_send_fragment_;","   Stats::TestUtil::TestStore server_stats_store_;","   Stats::TestUtil::TestStore client_stats_store_;","   std::shared_ptr<Network::Test::TcpListenSocketImmediateListen> socket_;","@@ -9013,6 +9099,65 @@ TEST_P(SslReadBufferLimitTest, SmallReadsIntoSameSlice) {","   dispatcher_->run(Event::Dispatcher::RunType::Block);"," }"," ","+// A record carries at most max_send_fragment bytes of plaintext plus at most 256 bytes of TLS","+// overhead.","+constexpr uint32_t MaxTlsRecordOverhead = 256;","+","+// max_send_fragment caps every TLS record both sides send, handshake records included, and the data","+// still arrives intact.","+BORINGSSL_TEST_P(SslReadBufferLimitTest, MaxSendFragment) {","+  constexpr uint32_t max_send_fragment = 512;","+  constexpr uint32_t write_size = 3 * 16384;","+  max_send_fragment_ = max_send_fragment;","+","+  const TlsRecordLengths record_lengths =","+      sendAndRecordTlsRecordLengths(generatePayload(write_size));","+","+  // The client's records include its handshake messages and the data.","+  EXPECT_GE(record_lengths.sent.size(), write_size / max_send_fragment);","+  for (const uint16_t length : record_lengths.sent) {","+    EXPECT_LE(length, max_send_fragment + MaxTlsRecordOverhead);","+  }","+  // The server's records are its handshake messages, including its certificate.","+  EXPECT_FALSE(record_lengths.received.empty());","+  for (const uint16_t length : record_lengths.received) {","+    EXPECT_LE(length, max_send_fragment + MaxTlsRecordOverhead);","+  }","+}","+","+// A configured value other than BoringSSL's 512 floor is applied as given: the data fills records","+// to max_send_fragment bytes of plaintext and no record exceeds it.","+BORINGSSL_TEST_P(SslReadBufferLimitTest, MaxSendFragment8192) {","+  constexpr uint32_t max_send_fragment = 8192;","+  constexpr uint32_t write_size = 3 * 16384;","+  max_send_fragment_ = max_send_fragment;","+","+  const TlsRecordLengths record_lengths =","+      sendAndRecordTlsRecordLengths(generatePayload(write_size));","+","+  ASSERT_FALSE(record_lengths.sent.empty());","+  const uint16_t largest =","+      *std::max_element(record_lengths.sent.begin(), record_lengths.sent.end());","+  // A record length includes the TLS overhead, so a full max_send_fragment record exceeds it.","+  EXPECT_GT(largest, max_send_fragment);","+  EXPECT_LE(largest, max_send_fragment + MaxTlsRecordOverhead);","+}","+","+// Without max_send_fragment, the same exchange sends records larger than MaxSendFragment allows, so","+// that test would catch the setting not being applied.","+BORINGSSL_TEST_P(SslReadBufferLimitTest, NoMaxSendFragmentSendsFullSizeRecords) {","+  constexpr uint32_t write_size = 3 * 16384;","+","+  const TlsRecordLengths record_lengths =","+      sendAndRecordTlsRecordLengths(generatePayload(write_size));","+","+  ASSERT_FALSE(record_lengths.sent.empty());","+  ASSERT_FALSE(record_lengths.received.empty());","+  EXPECT_GT(*std::max_element(record_lengths.sent.begin(), record_lengths.sent.end()), 16384);","+  EXPECT_GT(*std::max_element(record_lengths.received.begin(), record_lengths.received.end()),","+            512 + MaxTlsRecordOverhead);","+}","+"," // Test asynchronous signing (ECDHE) using a private key provider."," BORINGSSL_TEST_P(SslSocketTest, RsaPrivateKeyProviderAsyncSignSuccess) {","   const std::string server_ctx_yaml = R\"EOF("],"additions":145,"deletions":0,"truncated":false},{"path":"test/mocks/ssl/mocks.cc","lines":["@@ -30,6 +30,7 @@ MockClientContextConfig::MockClientContextConfig() {","   ON_CALL(*this, ecdhCurves()).WillByDefault(testing::ReturnRef(curves_));","   ON_CALL(*this, minProtocolVersion()).WillByDefault(testing::Return(0));","   ON_CALL(*this, maxProtocolVersion()).WillByDefault(testing::Return(0));","+  ON_CALL(*this, maxSendFragment()).WillByDefault(testing::Return(std::nullopt));","   ON_CALL(*this, capabilities()).WillByDefault(testing::Return(capabilities_));","   ON_CALL(*this, alpnProtocols()).WillByDefault(testing::ReturnRef(alpn_));","   ON_CALL(*this, signatureAlgorithms()).WillByDefault(testing::ReturnRef(sigalgs_));","@@ -48,6 +49,7 @@ MockServerContextConfig::MockServerContextConfig() {","   ON_CALL(*this, ecdhCurves()).WillByDefault(testing::ReturnRef(curves_));","   ON_CALL(*this, minProtocolVersion()).WillByDefault(testing::Return(0));","   ON_CALL(*this, maxProtocolVersion()).WillByDefault(testing::Return(0));","+  ON_CALL(*this, maxSendFragment()).WillByDefault(testing::Return(std::nullopt));","   ON_CALL(*this, capabilities()).WillByDefault(testing::Return(capabilities_));","   ON_CALL(*this, alpnProtocols()).WillByDefault(testing::ReturnRef(alpn_));","   ON_CALL(*this, signatureAlgorithms()).WillByDefault(testing::ReturnRef(sigalgs_));"],"additions":2,"deletions":0,"truncated":false},{"path":"test/mocks/ssl/mocks.h","lines":["@@ -117,6 +117,7 @@ class MockClientContextConfig : public ClientContextConfig {","   MOCK_METHOD(bool, validationContextConfigured, (), (const));","   MOCK_METHOD(unsigned, minProtocolVersion, (), (const));","   MOCK_METHOD(unsigned, maxProtocolVersion, (), (const));","+  MOCK_METHOD(std::optional<uint32_t>, maxSendFragment, (), (const));","   MOCK_METHOD(bool, isReady, (), (const));","   MOCK_METHOD(void, setSecretUpdateCallback, (std::function<absl::Status()> callback));"," ","@@ -165,6 +166,7 @@ class MockServerContextConfig : public ServerContextConfig {","   MOCK_METHOD(bool, validationContextConfigured, (), (const));","   MOCK_METHOD(unsigned, minProtocolVersion, (), (const));","   MOCK_METHOD(unsigned, maxProtocolVersion, (), (const));","+  MOCK_METHOD(std::optional<uint32_t>, maxSendFragment, (), (const));","   MOCK_METHOD(bool, isReady, (), (const));","   MOCK_METHOD(std::optional<std::chrono::seconds>, sessionTimeout, (), (const));","   MOCK_METHOD(void, setSecretUpdateCallback, (std::function<absl::Status()> callback));",""],"additions":2,"deletions":0,"truncated":false}],"additions":219,"deletions":1,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-23T19:31:50.679404+00:00"}