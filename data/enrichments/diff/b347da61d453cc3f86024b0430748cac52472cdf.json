{"id":"b347da61d453cc3f86024b0430748cac52472cdf","axis":"silent","repo":"envoyproxy/envoy","sha":"b347da61d453cc3f86024b0430748cac52472cdf","parsed":{"files":[{"path":"api/envoy/extensions/transport_sockets/tls/v3/tls.proto","lines":["@@ -184,7 +184,7 @@ message TlsKeyLog {"," }"," "," // TLS context shared by both client and server TLS contexts.","-// [#next-free-field: 17]","+// [#next-free-field: 18]"," message CommonTlsContext {","   option (udpa.annotations.versioning).previous_message_type = \"envoy.api.v2.auth.CommonTlsContext\";"," ","@@ -368,4 +368,11 @@ message CommonTlsContext {"," ","   // TLS key log configuration","   TlsKeyLog key_log = 15;","+","+  // The maximum plaintext size, in bytes, of each TLS record sent, handshake records included.","+  // Must be 512 to 16384 inclusive, and defaults to 16384. Applies to every certificate in the","+  // context. Smaller values send more records, which costs CPU, socket writes and bytes on the","+  // wire. This field has no effect on QUIC.","+  google.protobuf.UInt32Value max_send_fragment = 17","+      [(validate.rules).uint32 = {lte: 16384 gte: 512}];"," }"],"additions":8,"deletions":1,"truncated":false},{"path":"changelogs/current/new_features/tls__max-send-fragment.rst","lines":["@@ -0,0 +1,4 @@","+Added :ref:`max_send_fragment","+<envoy_v3_api_field_extensions.transport_sockets.tls.v3.CommonTlsContext.max_send_fragment>` to","+``CommonTlsContext``. It caps the plaintext size of every TLS record Envoy sends, handshake messages","+included, for peers that cannot handle full 16384-byte records, such as some PostgreSQL clients."],"additions":4,"deletions":0,"truncated":false},{"path":"compat/openssl/BUILD","lines":["@@ -725,6 +725,7 @@ mapping_func_filegroup(","         \"SSL_CTX_set_ex_data\",","         \"SSL_CTX_set_keylog_callback\",","         \"SSL_CTX_set_max_proto_version\",","+        \"SSL_CTX_set_max_send_fragment\",","         \"SSL_CTX_set_min_proto_version\",","         \"SSL_CTX_set_next_prot