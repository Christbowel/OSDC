nk ThreadSafeSimpleCounter}.","  */"," public final class UdfMetrics {"," ","     private static final int HISTORY_SIZE = 128;"," ","+    // One operator can host several generated classes that call the same function, and each of","+    // them registers on the operator's metric group. The group rejects a second metric with the","+    // same name, so all of them share the handle of the first registration, keyed by the","+    // udf.<udfName> group instance. Weak keys are compared by identity and do not keep the group of","+    // a finished task reachable; a restarted task registers on a new group and gets a new handle."],"additions":14,"deletions":3,"truncated":false}],"additions":327,"deletions":12,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-11-27T19:04:03.625477+00:00"}