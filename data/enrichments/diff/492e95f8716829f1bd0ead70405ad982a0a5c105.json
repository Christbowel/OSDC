,"lines":["@@ -4,6 +4,7 @@ import type { RouteData } from '../../types/public/internal.js';"," import { markFeatureUsed, FetchFeatures } from '../fetch/features.js';"," import type { FetchState } from '../fetch/fetch-state.js';"," import { getRouteGenerator } from '../routing/generator.js';","+import { rejectInvalidEncoding } from '../routing/invalid-encoding.js';"," "," function isExternalURL(url: string): boolean {"," \treturn url.startsWith('http://') || url.startsWith('https://') || url.startsWith('//');","@@ -90,3 +91,19 @@ export async function renderRedirect(state: FetchState) {"," \t}"," \treturn new Response(null, { status, headers });"," }","+","+/**","+ * Renders the redirect `Response` when the matched route is a redirect, or","+ * returns `undefined` so the caller continues processing. Returns an empty","+ * `400` when the request path is over-encoded.","+ */","+export function handleRedirects(state: FetchState): Promise<Response> | undefined {","+\tconst invalidEncodingResponse = rejectInvalidEncoding(state);","+\tif (invalidEncodingResponse) {","+\t\treturn Promise.resolve(invalidEncodingResponse);","+\t}","+\tif (state.routeData?.type === 'redirect') {","+\t\treturn renderRedirect(state);","+\t}","+\treturn undefined;","+}"],"additions":17,"deletions":0,"truncated":false},{"path":"packages/astro/src/core/routing/handler.ts","lines":["@@ -2,6 +2,7 @@ import { handleAction } from '../../actions/handler.js';"," import type { APIContext } from '../../types/public/context.js';"," import { REROUTABLE_STATUS_CODES } from '../constants.js';"," import { handleTrailingSlash } from './trailing-slash-handler.js';","+import { rejectInvalidEncoding } from './invalid-encoding.js';"," import { handleCache, provideCache } from '../cache/handler.js';"," import { getEnvironment, type RequestLogPayload } from '../environment/index.js';"," import { renderErrorFromState } from '../errors/handler.js';","@@ -62,12 +63,9 @@ export async function handleRequest(state: FetchState): Promise<Response> {"," \t// forget to include anything."," \tmarkFeatureUsed(state.manifest, ALL_FETCH_FEATURES);"," ","-\t// Reject paths that were encoded too many times to fully decode, before","-\t// any routing or middleware runs. If we let them through, middleware","-\t// could check one path while a later decode turns it into a different","-\t// route.","-\tif (state.invalidEncoding) {","-\t\treturn new Response(null, { status: 400, statusText: 'Bad Request' });","+\tconst invalidEncodingResponse = rejectInvalidEncoding(state);","+\tif (invalidEncodingResponse) {","+\t\treturn invalidEncodingResponse;"," \t}"," "," \tconst trailingSlashRedirect = handleTrailingSlash(state);"],"additions":4,"deletions":6,"truncated":false},{"path":"packages/astro/src/core/routing/invalid-encoding.ts","lines":["@@ -0,0 +1,19 @@","+import type { FetchState } from '../fetch/fetch-state.js';","+","+/**","+ * Returns an empty `400 Bad Request` response when the request path was","+ * encoded too many times to fully decode (`state.invalidEncoding`), or","+ * `undefined` otherwise.","+ *","+ * Every entry point that routes the request or runs middleware calls this","+ * first, so composable pipelines reject the request the same way","+ * `handleRequest` does regardless of which handlers they include.","+ */","+export function rejectInvalidEncoding(state: FetchState): Response | undefined {","+\t// If the half-decoded path were let through, middleware could check one","+\t// path while a later decode turns it into a different route.","+\tif (state.invalidEncoding) {","+\t\treturn new Response(null, { status: 400, statusText: 'Bad Request' });","+\t}","+\treturn undefined;","+}"],"additions":19,"deletions":0,"truncated":false},{"path":"packages/astro/src/core/routing/trailing-slash-handler.ts","lines":["@@ -8,14 +8,20 @@ import {"," import type { FetchState } from '../fetch/fetch-state.js';"," import { prepareResponse } from '../app/prepare-response.js';"," import { redirectTemplate } from './3xx.js';","+import { rejectInvalidEncoding } from './invalid-encoding.js';"," "," /**","  * Handles trailing-slash normalization for incoming requests. If the","  * request's pathname does not match the manifest's configured","  * `trailingSlash` policy, a redirect `Response` is returned. Otherwise,","  * returns `undefined` so the caller can continue processing the request.","+ * Paths encoded too many times to decode get a 400 instead of a redirect.","  */"," export function handleTrailingSlash(state: FetchState): Response | undefined {","+\tconst invalidEncodingResponse = rejectInvalidEncoding(state);","+\tif (invalidEncodingResponse) {","+\t\treturn invalidEncodingResponse;","+\t}"," \t// Use a fresh URL parse from the raw request so we see the"," \t// un-normalized pathname (e.g. duplicate slashes like `///`)."," \t// state.url has already been normalized by the FetchState"],"additions":6,"deletions":0,"truncated":false},{"path":"packages/astro/test/units/fetch/index.test.ts","lines":["@@ -865,6 +865,59 @@ describe('Composed pipeline', () => {"," \t});"," });"," ","+describe('Composed pipeline with an over-encoded path', () => {","+\t// Encoded more times than `validateAndDecodePathname` decodes.","+\tconst overEncodedUrl = 'http://example.com/api/%2525252525252525252561dmin';","+","+\tfunction createOverEncodedState(onMiddleware?: () => void) {","+\t\tconst app = createTestApp([createPage(simplePage, { route: '/api/admin' })], {","+\t\t\ttrailingSlash: 'always',","+\t\t\tmiddleware: async () => ({","+\t\t\t\tonRequest: async (_ctx: any, next: any) => {","+\t\t\t\t\tonMiddleware?.();","+\t\t\t\t\treturn next();","+\t\t\t\t},","+\t\t\t}),","+\t\t});","+\t\treturn new FetchState(stampApp(new Request(overEncodedUrl), app));","+\t}","+","+\tit('trailingSlash() returns 400 instead of a redirect', async () => {","+\t\tconst response = trailingSlash(createOverEncodedState());","+\t\tassert.equal(response?.status, 400);","+\t\tassert.equal(await response?.text(), '');","+\t});","+","+\tit('middleware() returns 400 without running user middleware', async () => {","+\t\tlet middlewareRan = false;","+\t\tconst state = createOverEncodedState(() => {","+\t\t\tmiddlewareRan = true;","+\t\t});","+\t\tconst response = await middleware(state, () => pages(state));","+\t\tassert.equal(response.status, 400);","+\t\tassert.equal(await response.text(), '');","+\t\tassert.equal(middlewareRan, false, 'user middleware should not run');","+\t});","+","+\tit('redirects() returns 400', async () => {","+\t\tconst response = await redirects(createOverEncodedState());","+\t\tassert.equal(response?.status, 400);","+\t\tassert.equal(await response?.text(), '');","+\t});","+","+\tit('actions() returns 400', async () => {","+\t\tconst response = await actions(createOverEncodedState());","+\t\tassert.equal(response?.status, 400);","+\t\tassert.equal(await response?.text(), '');","+\t});","+","+\tit('pages() returns 400', async () => {","+\t\tconst response = await pages(createOverEncodedState());","+\t\tassert.equal(response.status, 400);","+\t\tassert.equal(await response.text(), '');","+\t});","+});","+"," // #endregion"," "," // #region state.response",""],"additions":53,"deletions":0,"truncated":false}],"additions":125,"deletions":13,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-10-06T14:35:07.027694+00:00"}