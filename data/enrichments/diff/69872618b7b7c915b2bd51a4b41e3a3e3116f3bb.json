matter } = parseFrontmatter('---\\n# just a comment\\n---\\nBody');","+\t\tassert.deepEqual(frontmatter, {});","+\t});","+","+\tit('returns an empty object when there is no frontmatter', () => {","+\t\tconst { frontmatter, content } = parseFrontmatter('Body');","+\t\tassert.deepEqual(frontmatter, {});","+\t\tassert.equal(content, 'Body');","+\t});","+","+\tit('parses TOML frontmatter', () => {","+\t\tconst { frontmatter } = parseFrontmatter('+++\\ntitle = \"Hello\"\\n+++\\nBody');","+\t\tassert.deepEqual(frontmatter, { title: 'Hello' });","+\t});","+});","+","+describe('parseYaml', () => {","+\tit('parses a YAML document', () => {","+\t\tassert.deepEqual(parseYaml('a: 1\\nb: true'), { a: 1, b: true });","+\t});","+","+\tit('parses unquoted dates as Date objects', () => {","+\t\tconst data = parseYaml('date: 2022-01-01') as Record<string, unknown>;","+\t\tassert.ok(data.date instanceof Date);","+\t});","+","+\tit('returns undefined for empty input', () => {","+\t\tassert.equal(parseYaml(''), undefined);","+\t});","+","+\tit('returns undefined for comment-only input', () => {","+\t\tassert.equal(parseYaml('# just a comment'), undefined);","+\t});","+","+\tit('throws on multi-document input', () => {","+\t\tassert.throws(() => parseYaml('a: 1\\n---\\nb: 2'), /multiple documents/);","+\t});","+","+\tit('identifies YAML parse errors', () => {","+\t\tassert.equal(isYAMLParseError(new Error('invalid YAML')), false);","+\t\tassert.throws(","+\t\t\t() => parseYaml('a: ['),","+\t\t\t(error) => isYAMLParseError(error),","+\t\t);","+\t});","+});"],"additions":89,"deletions":0,"truncated":false},{"path":"packages/language-tools/vscode/package.json","lines":["@@ -247,7 +247,6 @@","   \"devDependencies\": {","     \"@astrojs/language-server\": \"^2.17.0\",","     \"@astrojs/ts-plugin\": \"^1.10.12\",","-    \"@types/js-yaml\": \"^4.0.9\",","     \"@types/mocha\": \"^10.0.10\",","     \"@types/node\": \"^22.10.6\",","     \"@types/vscode\": \"^1.101.0\",","@@ -258,7 +257,7 @@","   