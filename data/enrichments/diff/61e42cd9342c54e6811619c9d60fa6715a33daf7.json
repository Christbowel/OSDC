{"id":"61e42cd9342c54e6811619c9d60fa6715a33daf7","axis":"silent","repo":"hashicorp/consul","sha":"61e42cd9342c54e6811619c9d60fa6715a33daf7","parsed":{"files":[{"path":".changelog/24084.txt","lines":["@@ -0,0 +1,3 @@","+```release-note:bug","+agent: Apply `default_query_time` and `max_query_time` to cache-backed blocking queries so they no longer outlive `http_config.write_timeout`. This fixes the periodic `connect_roots` watch error in the built-in `consul connect proxy`.","+```"],"additions":3,"deletions":0,"truncated":false},{"path":"agent/agent_endpoint.go","lines":["@@ -1654,6 +1654,7 @@ func (s *HTTPHandlers) AgentConnectCARoots(resp http.ResponseWriter, req *http.R"," \t// issue the request directly via RPC instead."," \tvar reply *structs.IndexedCARoots"," \tif s.agent.config.HTTPUseCache {","+\t\ts.boundCacheBlockingWait(&args.QueryOptions)"," \t\traw, m, err := s.agent.cache.Get(req.Context(), cachetype.ConnectCARootName, &args)"," \t\tif err != nil {"," \t\t\treturn nil, err"],"additions":1,"deletions":0,"truncated":false},{"path":"agent/agent_endpoint_test.go","lines":["@@ -6844,6 +6844,47 @@ func TestAgentConnectCARoots_empty(t *testing.T) {"," \trequire.Contains(t, resp.Body.String(), \"Connect must be enabled\")"," }"," ","+// A blocking request without ?wait must be bounded by default_query_time rather","+// than blocking until the roots change, otherwise it outlives","+// http_config.write_timeout and gets reset.","+func TestAgentConnectCARoots_BlockingDefaultQueryTime(t *testing.T) {","+\tif testing.Short() {","+\t\tt.Skip(\"too slow for testing.Short\")","+\t}","+","+\ta := NewTestAgent(t, `","+\t\tdefault_query_time = \"2s\"","+\t\tpeering { enabled = false }","+\t`)","+\tdefer a.Shutdown()","+\ttestrpc.WaitForTestAgent(t, a.RPC, \"dc1\")","+","+\treq, _ := http.NewRequest(\"GET\", \"/v1/agent/connect/ca/roots\", nil)","+\tresp := httptest.NewRecorder()","+\ta.srv.h.ServeHTTP(resp, req)","+\trequire.Equal(t, http.StatusOK, resp.Code)","+\tindex := resp.Header().Get(\"X-Consul-Index\")","+\trequire.NotEmpty(t, index)","+","+\tstart := time.Now()","+\treq, _ = http.NewRequest(\"GET\", \"/v1/agent/connect/ca/roots?index=\"+index, nil)","+\tresp = httptest.NewRecorder()","+\tdone := make(chan struct{})","+\tgo func() {","+\t\tdefer close(done)","+\t\ta.srv.h.ServeHTTP(resp, req)","+\t}()","+","+\tselect {","+\tcase <-done:","+\tcase <-time.After(10 * time.Second):","+\t\tt.Fatal(\"blocking query without wait did not return after default_query_time\")","+\t}","+\trequire.Equal(t, http.StatusOK, resp.Code)","+\trequire.Equal(t, index, resp.Header().Get(\"X-Consul-Index\"))","+\trequire.GreaterOrEqual(t, time.Since(start), 2*time.Second)","+}","+"," func TestAgentConnectCARoots_list(t *testing.T) {"," \tif testing.Short() {"," \t\tt.Skip(\"too slow for testing.Short\")"],"additions":41,"deletions":0,"truncated":false},{"path":"agent/catalog_endpoint.go","lines":["@@ -286,6 +286,7 @@ func (s *HTTPHandlers) CatalogServices(resp http.ResponseWriter, req *http.Reque"," \tdefer setMeta(resp, &out.QueryMeta)"," "," \tif args.UseCache {","+\t\ts.boundCacheBlockingWait(&args.QueryOptions)"," \t\traw, m, err := s.agent.cache.Get(req.Context(), cachetype.CatalogListServicesName, &args)"," \t\tif err != nil {"," \t\t\tmetrics.IncrCounterWithLabels([]string{\"client\", \"rpc\", \"error\", \"catalog_services\"}, 1,","@@ -378,6 +379,7 @@ func (s *HTTPHandlers) catalogServiceNodes(resp http.ResponseWriter, req *http.R"," \tdefer setMeta(resp, &out.QueryMeta)"," "," \tif args.UseCache {","+\t\ts.boundCacheBlockingWait(&args.QueryOptions)"," \t\traw, m, err := s.agent.cache.Get(req.Context(), cachetype.CatalogServicesName, &args)"," \t\tif err != nil {"," \t\t\tmetrics.IncrCounterWithLabels([]string{\"client\", \"rpc\", \"error\", \"catalog_service_nodes\"}, 1,"],"additions":2,"deletions":0,"truncated":false},{"path":"agent/discovery_chain_endpoint.go","lines":["@@ -63,6 +63,7 @@ func (s *HTTPHandlers) DiscoveryChainRead(resp http.ResponseWriter, req *http.Re"," \tdefer setMeta(resp, &out.QueryMeta)"," "," \tif args.UseCache {","+\t\ts.boundCacheBlockingWait(&args.QueryOptions)"," \t\traw, m, err := s.agent.cache.Get(req.Context(), cachetype.CompiledDiscoveryChainName, &args)"," \t\tif err != nil {"," \t\t\treturn nil, err"],"additions":1,"deletions":0,"truncated":false},{"path":"agent/http.go","lines":["@@ -1019,6 +1019,27 @@ func parseWait(resp http.ResponseWriter, req *http.Request, b QueryOptionsCompat"," \treturn false"," }"," ","+// boundCacheBlockingWait applies the default and maximum query time to a","+// blocking request that is served by the agent cache.","+//","+// Requests forwarded over RPC get this treatment from the servers, but","+// cache.Get only honors QueryOptions.MaxQueryTime. Without a ?wait param it","+// would block until the data changes, which can outlive http_config.write_timeout","+// and cause the stream to be reset (e.g. the connect_roots watch of the built-in","+// proxy).","+func (s *HTTPHandlers) boundCacheBlockingWait(q *structs.QueryOptions) {","+\tif q.MinQueryIndex == 0 {","+\t\treturn","+\t}","+\tcfg := s.agent.config","+\tif q.MaxQueryTime > cfg.MaxQueryTime {","+\t\tq.MaxQueryTime = cfg.MaxQueryTime","+\t} else if q.MaxQueryTime <= 0 {","+\t\tq.MaxQueryTime = cfg.DefaultQueryTime","+\t}","+\tq.MaxQueryTime += lib.RandomStagger(q.MaxQueryTime / structs.JitterFraction)","+}","+"," // parseCacheControl parses the CacheControl HTTP header value. So far we only"," // support maxage directive."," func parseCacheControl(resp http.ResponseWriter, req *http.Request, b QueryOptionsCompat) bool {"],"additions":21,"deletions":0,"truncated":false},{"path":"agent/http_test.go","lines":["@@ -2129,3 +2129,31 @@ func TestWithRemoteAddrHandler_InvalidAddr(t *testing.T) {"," "," \tassert.True(t, nextHandlerCalled, \"expected next handler to be called\")"," }","+","+func TestHTTPHandlers_boundCacheBlockingWait(t *testing.T) {","+\ta := NewTestAgent(t, `","+\t\tdefault_query_time = \"30s\"","+\t\tmax_query_time = \"60s\"","+\t`)","+\tdefer a.Shutdown()","+","+\twithJitter := func(d time.Duration) time.Duration { return d + d/structs.JitterFraction }","+","+\ttests := []struct {","+\t\tname     string","+\t\topts     structs.QueryOptions","+\t\tmin, max time.Duration","+\t}{","+\t\t{name: \"non-blocking is untouched\", opts: structs.QueryOptions{MaxQueryTime: 5 * time.Minute}, min: 5 * time.Minute, max: 5 * time.Minute},","+\t\t{name: \"no wait uses default\", opts: structs.QueryOptions{MinQueryIndex: 1}, min: 30 * time.Second, max: withJitter(30 * time.Second)},","+\t\t{name: \"explicit wait is kept\", opts: structs.QueryOptions{MinQueryIndex: 1, MaxQueryTime: 10 * time.Second}, min: 10 * time.Second, max: withJitter(10 * time.Second)},","+\t\t{name: \"wait is capped\", opts: structs.QueryOptions{MinQueryIndex: 1, MaxQueryTime: time.Hour}, min: 60 * time.Second, max: withJitter(60 * time.Second)},","+\t}","+\tfor _, tc := range tests {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\ta.srv.boundCacheBlockingWait(&tc.opts)","+\t\t\trequire.GreaterOrEqual(t, tc.opts.MaxQueryTime, tc.min)","+\t\t\trequire.LessOrEqual(t, tc.opts.MaxQueryTime, tc.max)","+\t\t})","+\t}","+}"],"additions":28,"deletions":0,"truncated":false},{"path":"agent/intentions_endpoint.go","lines":["@@ -165,6 +165,7 @@ func (s *HTTPHandlers) IntentionMatch(resp http.ResponseWriter, req *http.Reques"," \tdefer setMeta(resp, &out.QueryMeta)"," "," \tif s.agent.config.HTTPUseCache && args.UseCache {","+\t\ts.boundCacheBlockingWait(&args.QueryOptions)"," \t\traw, m, err := s.agent.cache.Get(req.Context(), cachetype.IntentionMatchName, args)"," \t\tif err != nil {"," \t\t\treturn nil, err"],"additions":1,"deletions":0,"truncated":false},{"path":"agent/prepared_query_endpoint.go","lines":["@@ -124,6 +124,7 @@ func (s *HTTPHandlers) preparedQueryExecute(id string, resp http.ResponseWriter,"," \tdefer setMeta(resp, &reply.QueryMeta)"," "," \tif args.UseCache {","+\t\ts.boundCacheBlockingWait(&args.QueryOptions)"," \t\traw, m, err := s.agent.cache.Get(req.Context(), cachetype.PreparedQueryName, &args)"," \t\tif err != nil {"," \t\t\t// Don't return error if StaleIfError is set and we are within it and had",""],"additions":1,"deletions":0,"truncated":false}],"additions":99,"deletions":0,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-17T18:45:09.259969+00:00"}