{"id":"deec352ed03cb0d85c4befdc74a111341a3a8ddd","axis":"silent","repo":"electron/electron","sha":"deec352ed03cb0d85c4befdc74a111341a3a8ddd","parsed":{"files":[{"path":"patches/node/api_remove_deprecated_getisolate.patch","lines":["@@ -85,7 +85,7 @@ index cc60ddddb037e0279615bbe24821eb20fd8da677..37d83e41b618a07aca98118260abe961","  ","    return handle;"," diff --git a/src/crypto/crypto_context.cc b/src/crypto/crypto_context.cc","-index 114b0c920882dd267f057c6414563c57e91eb236..ec217aadc4a34ce09742c3b9490634727f387c1d 100644","+index 57e4bc771fafc2eee2c13ff0d35295d9c3d6fd67..c78551c250acb14a988677aa6bf6949068a7fe41 100644"," --- a/src/crypto/crypto_context.cc"," +++ b/src/crypto/crypto_context.cc"," @@ -1174,7 +1174,7 @@ bool ArrayOfStringsToX509s(Local<Context> context,","@@ -98,7 +98,7 @@ index 114b0c920882dd267f057c6414563c57e91eb236..ec217aadc4a34ce09742c3b949063472","    uint32_t array_length = cert_array->Length();","  "," diff --git a/src/crypto/crypto_x509.cc b/src/crypto/crypto_x509.cc","-index 1bf003f830812664ad903dbdfe30366835767c0b..337cd5899f9ced88e9d2eda61ba194b7f70b910a 100644","+index fbca682b804a0a1b7e688d01359c20a416584f15..624102e31b593e0b72872f53d5cfd46d0f54d6e2 100644"," --- a/src/crypto/crypto_x509.cc"," +++ b/src/crypto/crypto_x509.cc"," @@ -109,7 +109,7 @@ MaybeLocal<Value> ToV8Value(Local<Context> context, BIOPointer&& bio) {"],"additions":2,"deletions":2,"truncated":false},{"path":"patches/node/electron_enable_node_startup_snapshot_generation_in_chromium_s_v8.patch","lines":["@@ -318,7 +318,7 @@ index 0842cba257d0ca36e07c97736e5b24cc77f2a053..0ee1bd02a03b6d303861cd0f8353db6c","        node::InitializeOncePerProcess(","            std::vector<std::string>(argv, argv + argc),"," diff --git a/unofficial.gni b/unofficial.gni","-index fdb258adabea6607f617e374026562366c8bac0e..512ca7a1c5e12aa8fa4fdbfc7bb2025dc0a8667a 100644","+index fdb258adabea6607f617e374026562366c8bac0e..d55f69133a3ba870c4b1dd23b6580c82ee590c77 100644"," --- a/unofficial.gni"," +++ b/unofficial.gni"," @@ -32,7 +32,22 @@ template(\"node_gn_build\") {","@@ -424,7 +424,7 @@ index fdb258adabea6607f617e374026562366c8bac0e..512ca7a1c5e12aa8fa4fdbfc7bb2025d","        }","  ","        # This config disables a link time optimization \"ICF\", which may merge","-@@ -324,26 +358,127 @@ template(\"node_gn_build\") {","+@@ -324,26 +358,135 @@ template(\"node_gn_build\") {","            ldflags = [ \"/OPT:NOICF\" ]  # link.exe, but also lld-link.exe.","          } else if (is_apple && !use_lld) {","            ldflags = [ \"-Wl,-no_deduplicate\" ]  # ld64.","@@ -516,6 +516,10 @@ index fdb258adabea6607f617e374026562366c8bac0e..512ca7a1c5e12aa8fa4fdbfc7bb2025d"," +      \"$node_v8_path\","," +      \"$node_v8_path:v8_libplatform\","," +    ]","++    if (node_use_openssl) {","++      # node headers include OpenSSL headers when HAVE_OPENSSL is set.","++      deps += [ \"$node_openssl_path\" ]","++    }"," +    sources = [ \"src/node_snapshot_stub.cc\" ]"," +  }"," +","@@ -545,6 +549,10 @@ index fdb258adabea6607f617e374026562366c8bac0e..512ca7a1c5e12aa8fa4fdbfc7bb2025d"," +      \"$node_v8_path\","," +      \"$node_v8_path:v8_libplatform\","," +    ]","++    if (node_use_openssl) {","++      # node headers include OpenSSL headers when HAVE_OPENSSL is set.","++      deps += [ \"$node_openssl_path\" ]","++    }"," +    if (node_use_node_snapshot) {"," +      _run_node_mksnapshot = \":run_node_mksnapshot($default_toolchain)\""," +      sources = [ get_label_info(_run_node_mksnapshot, \"target_gen_dir\") +"],"additions":10,"deletions":2,"truncated":false},{"path":"patches/node/fix_add_externalpointertypetag_to_v8_external_api_calls.patch","lines":["@@ -8,7 +8,7 @@ an ExternalPointerTypeTag parameter. Use kExternalPointerTypeTagDefault"," for all existing call sites."," "," diff --git a/src/crypto/crypto_context.cc b/src/crypto/crypto_context.cc","-index ec217aadc4a34ce09742c3b9490634727f387c1d..e857de97428bde0bcd76f486fe29f1befa076e2c 100644","+index c78551c250acb14a988677aa6bf6949068a7fe41..4d6d9accd1970eca3ab065884e445d662e9f0c5a 100644"," --- a/src/crypto/crypto_context.cc"," +++ b/src/crypto/crypto_context.cc"," @@ -2622,7 +2622,7 @@ int SecureContext::TicketCompatibilityCallback(SSL* ssl,"],"additions":1,"deletions":1,"truncated":false},{"path":"patches/node/fix_handle_boringssl_and_openssl_incompatibilities.patch","lines":["@@ -3,21 +3,21 @@ From: Shelley Vohr <shelley.vohr@gmail.com>"," Date: Wed, 12 Feb 2020 15:08:04 -0800"," Subject: fix: handle BoringSSL and OpenSSL incompatibilities"," ","-This patch corrects for imcompatibilities between OpenSSL, which Node.js uses,","-and BoringSSL which Electron uses via Chromium. Each incompatibility typically has","-~2 paths forward:","-* Upstream a shim or adapted implementation to BoringSSL","-* Alter Node.js functionality to something which both libraries can handle.","+This patch corrects for incompatibilities between OpenSSL, which Node.js","+uses, and BoringSSL, which Electron uses via Chromium."," ","-Where possible, we should seek to make this patch as minimal as possible.","+BoringSSL's sk_*_num() and EVP_MD_size() return size_t where OpenSSL","+returns int, so code that hard codes int for these values does not build","+cleanly against BoringSSL."," ","-Upstreams:","-- https://github.com/nodejs/node/pull/39054","-- https://github.com/nodejs/node/pull/39138","-- https://github.com/nodejs/node/pull/39136","+This is a backport of https://github.com/nodejs/node/pull/66752, which","+switches those call sites to ncrypto's OPENSSL_SIZE_T (size_t under","+BoringSSL, int under OpenSSL). The hunks are kept identical to upstream,","+so this patch can be removed once Electron updates to a Node.js version","+that includes that change."," "," diff --git a/src/crypto/crypto_common.cc b/src/crypto/crypto_common.cc","-index ea0747511a107c96befd2dae1d7bd56759dd95b6..14dccb316ae600e55b2321e185e6d5833ba54575 100644","+index ea0747511a107c96befd2dae1d7bd56759dd95b6..ad056b5610bc8f0db2137402cecc07e18ff0cd09 100644"," --- a/src/crypto/crypto_common.cc"," +++ b/src/crypto/crypto_common.cc"," @@ -90,7 +90,7 @@ StackOfX509 CloneSSLCerts(X509Pointer&& cert,","@@ -25,7 +25,7 @@ index ea0747511a107c96befd2dae1d7bd56759dd95b6..14dccb316ae600e55b2321e185e6d583","    if (cert && !sk_X509_push(peer_certs.get(), cert.release()))","      return StackOfX509();"," -  for (int i = 0; i < sk_X509_num(ssl_certs); i++) {","-+  for (size_t i = 0; i < sk_X509_num(ssl_certs); i++) {","++  for (OPENSSL_SIZE_T i = 0; i < sk_X509_num(ssl_certs); i++) {","      X509Pointer cert(X509_dup(sk_X509_value(ssl_certs, i)));","      if (!cert || !sk_X509_push(peer_certs.get(), cert.get()))","        return StackOfX509();","@@ -34,12 +34,12 @@ index ea0747511a107c96befd2dae1d7bd56759dd95b6..14dccb316ae600e55b2321e185e6d583","    cert->reset(sk_X509_delete(peer_certs.get(), 0));","    for (;;) {"," -    int i;","-+    size_t i;","++    OPENSSL_SIZE_T i;","      for (i = 0; i < sk_X509_num(peer_certs.get()); i++) {","        X509View ca(sk_X509_value(peer_certs.get(), i));","        if (!cert->view().isIssuedBy(ca)) continue;"," diff --git a/src/crypto/crypto_context.cc b/src/crypto/crypto_context.cc","-index 74ea622dad505586a9437097d36e84b7c11f0aa5..114b0c920882dd267f057c6414563c57e91eb236 100644","+index 74ea622dad505586a9437097d36e84b7c11f0aa5..57e4bc771fafc2eee2c13ff0d35295d9c3d6fd67 100644"," --- a/src/crypto/crypto_context.cc"," +++ b/src/crypto/crypto_context.cc"," @@ -170,7 +170,7 @@ int SSL_CTX_use_certificate_chain(SSL_CTX* ctx,","@@ -47,7 +47,7 @@ index 74ea622dad505586a9437097d36e84b7c11f0aa5..114b0c920882dd267f057c6414563c57","      SSL_CTX_clear_extra_chain_certs(ctx);","  "," -    for (int i = 0; i < sk_X509_num(extra_certs); i++) {","-+    for (size_t i = 0; i < sk_X509_num(extra_certs); i++) {","++    for (OPENSSL_SIZE_T i = 0; i < sk_X509_num(extra_certs); i++) {","        X509* ca = sk_X509_value(extra_certs, i);","  ","        // NOTE: Increments reference count on `ca`","@@ -56,12 +56,12 @@ index 74ea622dad505586a9437097d36e84b7c11f0aa5..114b0c920882dd267f057c6414563c57","  ","    // Add CA certs too"," -  for (int i = 0; i < sk_X509_num(extra_certs.get()); i++) {","-+  for (size_t i = 0; i < sk_X509_num(extra_certs.get()); i++) {","++  for (OPENSSL_SIZE_T i = 0; i < sk_X509_num(extra_certs.get()); i++) {","      X509* ca = sk_X509_value(extra_certs.get(), i);","  ","      X509_STORE_add_cert(sc->GetCertStoreOwnedByThisSecureContext(), ca);"," diff --git a/src/crypto/crypto_hash.cc b/src/crypto/crypto_hash.cc","-index 2cf971347b9ea98bf76a8d277a46d7a6842efda6..326120e21d38ad0c78a92658353c8252db49ff28 100644","+index 2cf971347b9ea98bf76a8d277a46d7a6842efda6..9391b884e18557815365e0b3c2442e364543ddd0 100644"," --- a/src/crypto/crypto_hash.cc"," +++ b/src/crypto/crypto_hash.cc"," @@ -380,7 +380,7 @@ void OneShotDigestWithMD(Environment* env,","@@ -69,46 +69,21 @@ index 2cf971347b9ea98bf76a8d277a46d7a6842efda6..326120e21d38ad0c78a92658353c8252","  ","    bool is_xof = (EVP_MD_flags(md) & EVP_MD_FLAG_XOF) != 0;"," -  int output_length = EVP_MD_size(md);","-+  size_t output_length = EVP_MD_size(md);","++  OPENSSL_SIZE_T output_length = EVP_MD_size(md);","  ","    // This is to cause hash() to fail when an incorrect","    // outputLength option was passed for a non-XOF hash function."," diff --git a/src/crypto/crypto_x509.cc b/src/crypto/crypto_x509.cc","-index 0050e5591e2ae0afb517500934ddfb223078bd76..944802925def832be06a05f05a9ff535b5e0d97c 100644","+index 0050e5591e2ae0afb517500934ddfb223078bd76..cd5217a960c539a799d05e306776430b32cf5144 100644"," --- a/src/crypto/crypto_x509.cc"," +++ b/src/crypto/crypto_x509.cc","-@@ -946,7 +946,7 @@ MaybeLocal<Object> X509Certificate::NewWithIssuers(","+@@ -946,7 +946,8 @@ MaybeLocal<Object> X509Certificate::NewWithIssuers(","    }","  ","    Local<Object> issuer;"," -  if (issuer_chain != nullptr && start < sk_X509_num(issuer_chain)) {","-+  if (issuer_chain != nullptr && start < static_cast<int>(sk_X509_num(issuer_chain))) {","++  if (issuer_chain != nullptr &&","++      static_cast<OPENSSL_SIZE_T>(start) < sk_X509_num(issuer_chain)) {","      X509Pointer issuer_cert =","          X509View(sk_X509_value(issuer_chain, start)).clone();","      if (!issuer_cert) [[unlikely]] {","-diff --git a/src/node_metadata.h b/src/node_metadata.h","-index 8703e4315a999df505ff322aea05a268e017831e..18ddb44400f90f2fbea4ffad09cc1a8f986bf997 100644","-+++ b/src/node_metadata.h","-@@ -8,7 +8,7 @@","- #include <utility>","- #include \"node_version.h\"","- ","--#if HAVE_OPENSSL","-+#if 0","- #include <openssl/crypto.h>","- #include <quic/guard.h>","- #ifndef OPENSSL_NO_QUIC","-diff --git a/src/node_options.h b/src/node_options.h","-index b55fae0a32175fdff7a0c3ecb479297bd035eb7e..04eaa705e8023dab7104ac4d55f9d4179b7f30d4 100644","-+++ b/src/node_options.h","-@@ -11,7 +11,7 @@","- #include \"node_mutex.h\"","- #include \"util.h\"","- ","--#if HAVE_OPENSSL","-+#if 0","- #include \"openssl/opensslv.h\"","- #include \"quic/guard.h\"","- #endif"],"additions":22,"deletions":45,"truncated":false},{"path":"patches/node/fix_use_a_dedicated_cppheappointertag_for_cppgc_wrappables.patch","lines":["@@ -77,7 +77,7 @@ index f86232b125d9967f3021348cf88f132c391b2e0e..f72aafe07c039c6d63b74c80cd252f83","  ","  void IsolateData::MemoryInfo(MemoryTracker* tracker) const {"," diff --git a/unofficial.gni b/unofficial.gni","-index 512ca7a1c5e12aa8fa4fdbfc7bb2025dc0a8667a..19a5b14876711f2481ebc58dfc3bce6ea3e57a11 100644","+index d55f69133a3ba870c4b1dd23b6580c82ee590c77..ceeed26dfaeace32e9ef761a68062ce93e9277b6 100644"," --- a/unofficial.gni"," +++ b/unofficial.gni"," @@ -73,6 +73,12 @@ template(\"node_gn_build\") {"],"additions":1,"deletions":1,"truncated":false},{"path":"patches/node/fix_use_embedder_perfetto_client_when_available.patch","lines":["@@ -379,7 +379,7 @@ index 3765d931f8e17b33e2201ff3a0e4be84a3216356..17b990455e7d6a791998ab304418c256"," +","  #endif  // SRC_TRACING_TRACE_EVENT_PERFETTO_H