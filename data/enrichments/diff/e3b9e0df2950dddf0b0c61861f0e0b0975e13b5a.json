    const std::string env_s = GetEnvironmentVar(\"ORT_QMOE_SHARED_CPU_THREADS\");","+    int t = def_t;","+    if (!env_s.empty()) {","+      static_cast<void>(TryParseStringWithClassicLocale(env_s, t));","+    }","+    return std::clamp(t, 1, 64);","+  }","+","+  int CpuForWorker(int threads, int worker_idx) {","+    return Pool(threads).CpuForWorker(worker_idx);","+  }","+","+  template <typename Fn>","+  void ParallelFor(int threads, int num_tasks, Fn&& fn) {","+    if (num_tasks <= 0) return;","+    if (num_tasks == 1) {","+      fn(0);","+      return;","+    }","+    auto task_fn = [&](ptrdiff_t idx) { fn(static_cast<int>(idx)); };","+    Pool(threads).ParallelFor(static_cast<ptrdiff_t>(num_tasks), task_fn, 1);","+  }","+","+  void Shutdown() noexcept {","+    registry_.Shutdown();","+  }","+","+ private:","+  MoEPackedParallelPool() = default;","+  ~MoEPackedParallelPool() = default;","+","+  qmoe::SpinPool& Pool(int threads) {","+    return registry_.GetOrCreate(threads, [](int n) {","+      return std::make_unique<qmoe::SpinPool>(n, 2000);","+    });","+  }","+","+  qmoe::SpinPoolRegistry registry_;","+};","+","+}  // namespace","+","+// Prefill double-buffered wave staging shared by the MoEPacked layers on one CUDA device. All members are guarded by","+// `mu`. Device memory, streams and events belong to `device_id`.","+struct MoEPackedSharedPrefillWaveStaging {","+  static constexpr int kWaveExperts = 32;","+  std::mutex mu;","+  int device_id{-1};","+  size_t bank_bytes{0};","+  uint8_t* pinned_bank[2]{nullptr, nullptr};","+  uint8_t* gpu_bank[2]{nullptr, nullptr};","+  cudaStream_t copy_stream{nullptr};","+  cudaEvent_t h2d_done[2]{nullptr, nullptr};","+  cudaEvent_t compute_done[2]{nullptr, nullptr};","+  bool bank_in_flight[2]{false, false};","+  // Recorded on the caller stream after the last asynchronous read of the shared pinned route buffers.","+  cudaEvent_t last_use_done{nullptr};","+  bool last_use_pending{false};","+  int32_t* pinned_topk_idx{