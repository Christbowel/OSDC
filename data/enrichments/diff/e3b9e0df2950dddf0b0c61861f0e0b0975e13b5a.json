me/contrib_ops/cuda/moe/moe_packed.cc","lines":["@@ -4,9 +4,29 @@"," #include \"contrib_ops/cuda/moe/moe_packed.h\""," "," #include <algorithm>","+#include <atomic>","+#include <chrono>","+#include <cmath>","+#include <cstdio>","+#include <cstring>","+#include <map>","+#include <memory>","+#include <mutex>","+#include <new>","+#include <thread>"," #include <type_traits>","+#include <vector>"," ","+#include \"contrib_ops/cuda/moe/moe_packed_cpu.h\"","+","+#if ORT_MOE_PACKED_CPU_X86_64","+#include <immintrin.h>","+#endif","+","+#include \"contrib_ops/cpu/moe/qmoe_shared_layout.h\""," #include \"contrib_ops/cpu/quantization/gguf_quant_tables.h\"","+#include \"contrib_ops/cuda/moe/qmoe_spin_pool.h\"","+#include \"core/common/parse_string.h\""," #include \"core/common/safeint.h\""," #include \"core/framework/allocator.h\""," #include \"core/providers/cuda/cuda_common.h\"","@@ -24,8 +44,841 @@ bool PackedTensorBytesFit(int64_t rows, int64_t columns, size_t element_bytes) {","          IAllocator::CalcMemSizeForArray(static_cast<size_t>(rows), row_bytes, &bytes) &&","          bytes <= static_cast<size_t>(std::numeric_limits<ptrdiff_t>::max());"," }","+","+size_t AlignUp256(size_t v) {","+  return (v + 255u) & ~size_t{255u};","+}","+","+// Round-to-nearest-even BF16 bits. NaN keeps its sign and is forced quiet so that truncation cannot turn it into","+// infinity, and rounding cannot carry it into the sign bit.","+inline uint16_t FloatToBf16Bits(float x) {","+  uint32_t bits = 0;","+  std::memcpy(&bits, &x, sizeof(bits));","+  if ((bits & 0x7FFFFFFFu) > 0x7F800000u) {","+    return static_cast<uint16_t>((bits >> 16) | 0x0040u);","+  }","+  bits += 0x7FFFu + ((bits >> 16) & 1u);","+  return static_cast<uint16_t>(bits >> 16);","+}","+","+inline float RoundBf16Scalar(float x) {","+  const uint32_t bits = static_cast<uint32_t>(FloatToBf16Bits(x)) << 16;","+  float out = 0.0f;","+  std::memcpy(&out, &bits, sizeof(out));","+  return out;","+}","+","+// Rounds to the activation type with round-to-nearest-even at the points where the CUDA kernels store T: gate/up","+// dot products, the SwiGLU output, and each route's FC2 output. Both BF16 and FP16 overflow to infinity as on the GPU.","+inline float RoundToActivationType(float x, bool is_bf16) {","+  return is_bf16 ? RoundBf16Scalar(x) : MLFloat16(x).ToFloat();","+}","+","+#if ORT_MOE_PACKED_CPU_X86_64","+bool UseAvx2CpuKernels() {","+  static const bool use_avx2 = qmoe_shared::CpuHasAvx2FmaF16c();","+  return use_avx2;","+}","+#endif","+","+// Dot product of one GGUF quantized row against R activation vectors x_rows[0..R-1].","+void GgufDotRowCpu(","+    const uint8_t* down_row,","+    int down_type,","+    int K,","+    const float* const* inter_rows,","+    int R,","+    float* down_dots) {","+#if ORT_MOE_PACKED_CPU_X86_64","+  if (UseAvx2CpuKernels() && moe_packed_cpu::GgufDotRowAvx2(down_row, down_type, K, inter_rows, R, down_dots)) {","+    return;","+  }","+#endif","+  // FC2 passes K = inter_size, which kMoEPackedMaxHiddenSize does not bound.","+  alignas(32) float stack_buf[kMoEPackedMaxHiddenSize];","+  std::unique_ptr<float[]> heap_buf;","+  float* buf_d = stack_buf;","+  if (K > kMoEPackedMaxHiddenSize) {","+    heap_buf = std::make_unique<float[]>(static_cast<size_t>(K));","+    buf_d = heap_buf.get();","+  }","+  gguf_quant::DequantizeGgufRowCpu(down_row, down_type, K, buf_d);","+  for (int r = 0; r < R; ++r) {","+    float sd = 0.0f;","+    const float* xr = inter_rows[r];","+    for (int k = 0; k < K; ++k) {","+      sd += buf_d[k] * xr[k];","+    }","+    down_dots[r] = sd;","+  }","+}","+","+// Dot products of one (gate_row, up_row) pair against R token activation vectors x_rows[0..R-1].","+void GgufDualDotRowCpu(","+    const uint8_t* gate_row,","+    const uint8_t* up_row,","+    int gate_type,","+    int up_type,","+    int K,","+    const float* const* x_rows,","+    int R,","+    float* gate_dots,","+    float* up_dots) {","+#if ORT_MOE_PACKED_CPU_X86_64","+  if (gate_