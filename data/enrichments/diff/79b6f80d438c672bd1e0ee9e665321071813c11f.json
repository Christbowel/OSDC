es\").asFile","+                generated.parentFile.mkdirs()","+                generated.text = \"generated=true\"","+            }","+        }","+        // Registering the generator's output as a resource source directory establishes the","+        // builtBy dependency the audit must honour.","+        sourceSets.main.resources.srcDir(generateResources)","+        \"\"\"","+        file(\"src/main/java/org/example/Foo.java\").text = \"package org.example; public class Foo {}\"","+","+        when:","+        // Also run `classes`, so `processResources` pulls the generator into the task graph. Without","+        // the audit declaring a dependency on the generated source directory, Gradle 9.9 fails the","+        // build with an implicit-dependency validation error, exactly as observed in CI.","+        def result = gradleRunner(\"classes\", \"splitPackagesAudit\").build()","+","+        then:","+        result.task(\":generateResources\").outcome == TaskOutcome.SUCCESS","+        result.task(\":splitPackagesAudit\").outcome == TaskOutcome.SUCCESS","+","+        and: \"the generator runs before the audit\"","+        def executed = result.tasks.collect { it.path }","+        executed.indexOf(\":generateResources\") < executed.indexOf(\":splitPackagesAudit\")","+","+        and: \"no implicit-dependency validation error is reported\"","+        result.output.contains(\"without declaring an explicit or implicit dependency\") == false","+    }","+}"],"additions":63,"deletions":0,"truncated":false},{"path":"build-tools-internal/src/main/java/org/elasticsearch/gradle/internal/precommit/SplitPackagesAuditPrecommitPlugin.java","lines":["@@ -31,7 +31,12 @@ public TaskProvider<? extends Task> createTask(Project project) {","             t.setProjectBuildDirs(getProjectBuildDirs(project));","             t.setClasspath(project.getConfigurations().getByName(JavaPlugin.COMPILE_CLASSPATH_CONFIGURATION_NAME));","             SourceSet mainSourceSet = GradleUtils.getJavaSour