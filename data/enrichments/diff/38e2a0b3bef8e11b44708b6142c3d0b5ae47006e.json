 workspace.join(\"package.json\");","+    let mut manifest: serde_json::Value =","+        serde_json::from_str(&fs::read_to_string(&manifest_path).expect(\"read package.json\"))","+            .expect(\"parse package.json\");","+    manifest[\"description\"] = json!(\"edited\");","+    fs::write(&manifest_path, manifest.to_string()).expect(\"write the edited package.json\");","+    bump_mtime(&manifest_path);","+    run_hello();","+","+    drop(root);","+}","+","+/// [`error_action_applies_runtime_on_fail_to_the_manifest`] for a workspace","+/// project, after an install that reads the workspace projects itself.","+#[cfg(unix)]","+#[test]","+fn error_action_applies_runtime_on_fail_to_workspace_projects() {","+    let CommandTempCwd { pacquet, root, workspace, .. } = CommandTempCwd::init();","+    fs::write(workspace.join(\"package.json\"), json!({ \"name\": \"root\" }).to_string())","+        .expect(\"write the root package.json\");","+    fs::write(","+        workspace.join(\"pnpm-workspace.yaml\"),","+        \"packages:\\n  - packages/*\\nruntimeOnFail: warn\\n\",","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+    let project_dir = workspace.join(\"packages/project\");","+    fs::create_dir_all(&project_dir).expect(\"create the workspace project\");","+    let marker = workspace.join(\"marker.txt\");","+    write_named_manifest_with_dependency_groups(","+        &project_dir,","+        \"project\",","+        &marker,","+        json!({","+            \"devEngines\": {","+                \"runtime\": { \"name\": \"node\", \"version\": \"24.22.3\", \"onFail\": \"download\" },","+            },","+        }),","+    );","+    let linked = workspace.join(\"linked-dep\");","+    fs::create_dir_all(&linked).expect(\"create the linked package\");","+    fs::write(linked.join(\"package.json\"), json!({ \"name\": \"linked-dep\" }).to_string())","+        .expect(\"write the linked package manifest\");","+    pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+    // Not recursive, so the install reads the other workspace projects itself.","+    pacquet_in(&workspace)","+        .with_args([\"add\", \"--workspace-root\", \"link:./linked-dep\"])","+        .assert()","+        .success();","+    let lockfile = fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).expect(\"read the lockfile\");","+    assert!(!lockfile.contains(\"runtime:\"), \"the install must skip the runtime:\\n{lockfile}\");","+","+    let manifest_path = project_dir.join(\"package.json\");","+    let mut manifest: serde_json::Value =","+        serde_json::from_str(&fs::read_to_string(&manifest_path).expect(\"read package.json\"))","+            .expect(\"parse package.json\");","+    manifest[\"description\"] = json!(\"edited\");","+    fs::write(&manifest_path, manifest.to_string()).expect(\"write the edited package.json\");","+    bump_mtime(&manifest_path);","+    pacquet_in(&project_dir)","+        .with_args([\"--config.verify-deps-before-run=error\", \"run\", \"hello\"])","+        .assert()","+        .success();","+    assert!(marker.exists(), \"the script must run\");","+","+    drop(root);","+}","+"," /// A lockfile that records overrides the root manifest now keeps only in its"," /// ignored `pnpm` field must not be rewritten by an implicit install, which"," /// would drop them. The gate refuses and leaves the lockfile alone"],"additions":107,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/add/workspace_specifier.rs","lines":["@@ -23,14 +23,16 @@ pub(super) fn workspace_projects_for_add(","     let workspace_dir =","         crate::install::configured_or_discovered_workspace_dir(config, project_dir).ok()??;","     let manifest = pnpm_workspace::read_workspace_manifest(&workspace_dir).ok()??;","-    pnpm_workspace::find_workspace_projects(","+    let mut projects = pnpm_workspace::find_workspace_projects(","         &workspace_dir,","         &pnpm_workspace::FindWorkspaceP