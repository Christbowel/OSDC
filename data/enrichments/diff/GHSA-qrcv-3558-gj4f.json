ansion bool","+\t\twantArgLen    int","+\t}{","+\t\t{","+\t\t\tname:       \"converted subject at leaf control line limit is accepted\",","+\t\t\ttopic:      bytes.Repeat([]byte{'a'}, leafControlLimit-len(\" 25 25\")),","+\t\t\twantErr:    false,","+\t\t\twantArgLen: leafControlLimit,","+\t\t},","+\t\t{","+\t\t\tname:       \"literal topic exceeds leaf control line limit\",","+\t\t\ttopic:      bytes.Repeat([]byte{'a'}, leafControlLimit-len(\" 25 25\")+1),","+\t\t\twantErr:    true,","+\t\t\twantArgLen: leafControlLimit + 1,","+\t\t},","+\t\t{","+\t\t\tname:          \"dot expansion can make a shorter topic exceed leaf control line limit\",","+\t\t\ttopic:         makeRepeatedLevelTopic(21845),","+\t\t\twantErr:       true,","+\t\t\twantExpansion: true,","+\t\t},","+\t\t{","+\t\t\tname:          \"slash escaping can make a shorter topic exceed leaf control line limit\",","+\t\t\ttopic:         makeSlashExpansionTopic(t),","+\t\t\twantErr:       true,","+\t\t\twantExpansion: true,","+\t\t},","+\t} {","+\t\tt.Run(test.name, func(t *testing.T) {","+\t\t\tsubject := convertMQTTTopic(t, test.topic)","+\t\t\tif test.wantArgLen > 0 {","+\t\t\t\trequire_Equal(t, leafHMSGArgLen(subject), test.wantArgLen)","+\t\t\t}","+\t\t\tif test.wantExpansion {","+\t\t\t\trequire_True(t, len(test.topic) <= len(subject))","+\t\t\t}","+\t\t\tif err := parseLeafHMSG(subject); test.wantErr {","+\t\t\t\trequire_Error(t, err, ErrMaxControlLine)","+\t\t\t} else {","+\t\t\t\trequire_NoError(t, err)","+\t\t\t}","+\t\t})","+\t}","+","+\tfor _, test := range []struct {","+\t\tname  string","+\t\ttopic []byte","+\t}{","+\t\t{name: \"space\", topic: []byte(\"foo bar\")},","+\t\t{name: \"tab\", topic: []byte(\"foo\\tbar\")},","+\t\t{name: \"carriage return\", topic: []byte(\"foo\\rbar\")},","+\t\t{name: \"line feed\", topic: []byte(\"foo\\nbar\")},","+\t\t{name: \"carriage return line feed\", topic: []byte(\"foo\\r\\nbar\")},","+\t\t{name: \"null\", topic: []byte(\"foo\\x00bar\")},","+\t\t{name: \"inva