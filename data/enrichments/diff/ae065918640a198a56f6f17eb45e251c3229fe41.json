testing.assert_close(staged, common_attn_metadata.block_table_tensor[:, 0])","+","+","+@pytest.mark.skipif(not current_platform.is_cuda(), reason=\"Kimi-K3 NVIDIA KDA layer\")","+def test_recoverssm_layer_keeps_records_outside_kv_cache(","+    monkeypatch: pytest.MonkeyPatch, default_vllm_config","+):","+    \"\"\"A RecoverSSM KDA layer stores the stock conv and SSM state in its Mamba","+    pages and its verify records in a buffer with one row per schedulable","+    request.\"\"\"","+    monkeypatch.setattr(","+        \"vllm.distributed.parallel_state.get_tp_group\",","+        lambda: SimpleNamespace(world_size=1, rank_in_group=0),","+    )","+    default_vllm_config.model_config = SimpleNamespace(dtype=torch.bfloat16)","+    default_vllm_config.speculative_config = SimpleNamespace(num_speculative_tokens=2)","+    default_vllm_config.scheduler_config.max_num_seqs = 5","+    default_vllm_config.cache_config.use_replayssm = True","+    default_vllm_config.cache_config.use_kda_recoverssm = True","+    config = KimiLinearConfig(","+        hidden_size=16,","+        linear_attn_config={","+            \"kda_layers\": [0],","+            \"full_attn_layers\": [],","+            \"head_dim\": 32,","+            \"num_heads\": 4,","+            \"short_conv_kernel_size\": 4,","+            \"use_full_rank_gate\": True,","+        },","+    )","+    layer = KimiK3DeltaAttention(","+        config, default_vllm_config, prefix=\"model.layers.0.self_attn\"","+    )","+    # The CuTe kernels need 128-wide heads: this layer runs the Triton ones.","+    assert layer.recoverssm_backend == \"triton\"","+    assert len(layer.get_state_shape()) == len(layer.get_state_dtype()) == 2","+    records = layer.recoverssm_records","+    assert records is not None","+    assert records.correction.shape == (5, 4, 3, 32)","+    assert records.correction.dtype == torch.float32","+    assert records.key_gate.shape == (5, 4, 3, 64)","+    assert records.key_gate.dtype == torch.bfloat16"],"additions":48,"deletions":3,"truncated":false},{"path":"tests/models/kimi_k3/test_recoverssm_kernels.py","lines":["@@ -0,0 +1,722 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+\"\"\"The CuTe KDA RecoverSSM verify and state commit against the Triton reference","+(``causal_conv1d_update`` + ``kda_recoverssm_verify``, and the Triton commit), on","+Mamba page views as vLLM binds them (one padded page per slot holding the conv","+and SSM state) and per-layer verify records indexed by batch row.\"\"\"","+","+from math import prod","+from types import SimpleNamespace","+","+import pytest","+import torch","+","+from vllm.platforms import current_platform","+","+if not (","+    current_platform.is_cuda() and current_platform.is_device_capability_family(100)","+):","+    pytest.skip(\"The CuTe RecoverSSM kernels need SM10x\", allow_module_level=True)","+pytest.importorskip(\"cutlass\")","+","+from vllm.model_executor.layers.mamba.ops.causal_conv1d import (  # noqa: E402","+    causal_conv1d_update,","+)","+from vllm.models.kimi_k3.nvidia.ops.recoverssm import (  # noqa: E402","+    KDARecoverSSMCommitContext,","+    KDARecoverSSMRecords,","+    kda_recoverssm_verify,","+)","+from vllm.models.kimi_k3.nvidia.recoverssm.kernels import (  # noqa: E402","+    CuteRecoverSSMVerify,","+    compile_state_commit,","+)","+","+D = 128","+LOWER_BOUND = -5.0","+DEVICE = torch.device(\"cuda\")","+# Extra bytes per page: vLLM pads Mamba pages to the attention page size.","+PAGE_PADDING = 4096","+","+","+def _pages(slots: int, heads: int, window: int, dim_first: bool):","+    \"\"\"Page views of (conv state, SSM state) with a padded slot stride, filled","+    with random values.\"\"\"","+    conv_dim, conv_len = 3 * heads * D, window + 2","+    conv_shape = (","+        (slots, conv_dim, conv_len) if dim_first else (slots, conv_len, conv_dim)","+    )","+    specs = [","+        (torch.bfloat16, conv_shape),","+        (torch.bfloat16, (slots, heads, D, D)),","+    ]","+    sizes = [dtype.itemsize * prod(shape[1:]) for dtype, shape in specs]","+    page = sum(sizes) + PAGE_PADDING","+    raw = torch.randn(slots, page // 4, device=DEVICE).view(torch.uint8)","+    views = []","+    for i, (dtype, shape) in enumerate(specs):","+        inner = torch.empty(shape[1:], device=\"meta\").stride()","+        views.append(","+            raw.view(dtype)","+            .view(-1)","+            .as_strided(","+                shape,","+                (page // dtype.itemsize, *inner),","+                sum(sizes[:i]) // dtype.itemsize,","+            )","+        )","+    conv, state = views","+    # Bounded values: random bits are not finite floats.","+    conv.copy_(torch.randn_like(conv))","+    state.copy_(torch.randn_like(state) * 0.1)","+    return (raw, *views)","+","+","+def _records(rows: int, heads: int, window: int) -> KDARecoverSSMRecords:","+    records = KDARecoverSSMRecords.allocate(","+        rows, heads, window, D, torch.bfloat16, DEVICE","+    )","+    records.correction.normal_()","+    records.key_gate.normal_()","+    return records","+","+","+def _clone_records(records: KDARecoverSSMRecords) -> KDARecoverSSMRecords:","+    return KDARecoverSSMRecords(records.correction.clone(), records.key_gate.clone())","+","+","+def _clone_pages(pages):","+    raw = pages[0].clone()","+    base = pages[0].data_ptr()","+    return (","+        raw,","+        *(","+            raw.view(t.dtype)","+            .view(-1)","+            .as_strided(t.shape, t.stride(), (t.data_ptr() - base) // t.element_size())","+            for t in pages[1:]","+        ),","+    )","+","+","+def _inputs(","+    batch: int, heads: int, window: int, varlen: bool, row_pad: int, row_offset: int","+):","+    \"\"\"Raw projections laid out as the KDA in-projection output: q/k/v, then the","+    output gate, f_a, beta and the alignment padding in one row; the spec-decode","+    tokens start ``row_offset`` rows in (after a batch's non-spec tokens).\"\"\"","+    lens = torch.full((batch,), window, dtype=torch.int32)","+    if varlen and batch > 2:","+        lens[0] = window - 2","+        lens[1] = 0","+    query_start = torch.zeros(batch + 1, dtype=torch.int32)","+    query_start[1:] = torch.cumsum(lens, 0)","+    tokens = int(query_start[-1])","+    width = 4 * heads * D + D + heads + row_pad","+    projected = torch.randn(","+        row_offset + tokens, width, device=DEVICE, dtype=torch.bfloat16","+    )[row_offset:]","+    mixed_qkv = projected[:, : 3 * heads * D]","+    raw_beta = projected[:, 4 * heads * D + D : 4 * heads * D + D + heads]","+    raw_gate = torch.randn(tokens, heads * D, device=DEVICE, dtype=torch.bfloat16)","+    return lens, query_start.to(DEVICE), mixed_qkv, raw_gate, raw_beta","+","+","+def _compiled_verify(heads, window, dim_first, conv_weight_dtype):","+    verify = CuteRecoverSSMVerify(","+        num_heads=heads,","+        window=window,","+        conv_dim_first=dim_first,","+        conv_weight_dtype=conv_weight_dtype,","+        device=DEVICE,","+    )","+    verify.compile()","+    return verify","+","+","+def _check_verify(","+    heads=96,","+    dim_first=True,","+    conv_weight_dtype=torch.float32,","+    batch=8,","+    varlen=False,","+    row_pad=0,","+    recoverssm_accepted=True,","+    window=5,","+    row_offset=0,","+    dead_slot=0,","+):","+    \"\"\"Run the CuTe verify and the Triton reference on the same pages; returns","+    whether the CuTe verify launched (it declines unaligned inputs).\"\"\"","+    torch.manual_seed(batch * 7 + heads + row_pad + window)","+    slots = 3 * batch + 1","+    lens, query_start, mixed_qkv, raw_gate, raw_beta = _inputs(","+        batch, heads, window, varlen, row_pad, row_offset","+    )","+    tokens = mixed_qkv.shape[0]","+    A_log = torch.randn(heads, device=DEVICE) * 0.5","+    dt_bias = torch.randn(heads * D, device=DEVICE) * 0.5","+    conv_weight = (torch.randn(3 * heads * D, 4, device=DEVICE) * 0.5).to(","+        conv_weight_dtype","+    )","+    accepted = (","+        torch.ones(batch, dtype=torch.int32, device=DEVICE)","+        if recoverssm_accepted","+        else torch.randint(1, window + 1, (batch,), dtype=torch.int32, device=DEVICE)","+    )","+    state_indices = torch.randperm(slots - 1, device=DEVICE)[:batch].to(torch.int32) + 1","+    if varlen and batch > 4:","+        # Padded requests: CUDA graph batches pad with the null block.","+        state_indices[3:5] = dead_slot","+","+    pages = _pages(slots, heads, window, dim_first)","+    ref = _clone_pages(pages)","+    initial = _clone_pages(pages)","+    _, conv, state = pages","+    _, ref_conv, ref_state = ref","+    # More rows than requests: rows past the batch are left alone.","+    records = _records(batch + 2, heads, window)","+    ref_records = _clone_records(records)","+    initial_records = _clone_records(records)","+","+    # Reference: the stock convolution, then the Triton verify. (The stock","+    # convolution writes out of bounds for slot -1, so it gets the null block.)","+    ref_indices = state_indices.clamp(min=0)","+    ref_out = torch.full(","+        (1, tokens, heads, D), 7.0, device=DEVICE, dtype=torch.bfloat16","+    )","+    conv_out = torch.empty_like(mixed_qkv)","+    causal_conv1d_update(","+        mixed_qkv,","+        ref_conv if dim_first else ref_conv.transpose(-1, -2),","+        conv_weight,","+        None,","+        activation=\"silu\",","+        conv_state_indices=ref_indices,","+        num_accepted_tokens=accepted,","+        query_start_loc=query_start,","+        max_query_len=window,","+        validate_data=False,","+        out=conv_out,","+    )","+    q, k, v = (","+        x.unflatten(-1, (heads, D)).unsqueeze(0) for x in conv_out.split(heads * D, -1)","+    )","+    kda_recoverssm_verify(","+        q=q,","+        k=k,","+        v=v,","+        raw_g=raw_gate.view(1, tokens, heads, D),","+        raw_beta=raw_beta.unsqueeze(0),","+        A_log=A_log,","+        dt_bias=dt_bias,","+        lower_bound=LOWER_BOUND,","+        checkpoint_state=ref_state,","+        records=ref_records,","+        query_start_loc=query_start,","+        state_indices=ref_indices,","+        spec_query_len=window,","+        out=ref_out,","+    )","+","+    verify = _compiled_verify(heads, window, dim_first, conv_weight_dtype)","+    out = torch.full((tokens, heads * D), 7.0, device=DEVICE, dtype=torch.bfloat16)","+    launched = verify(","+        mixed_qkv=mixed_qkv,","+        raw_gate=raw_gate,","+        raw_beta=raw_beta,","+        A_log=A_log,","+        dt_bias=dt_bias,","+        lower_bound=LOWER_BOUND,","+        state=state,","+        records=records,","+        query_start_loc=query_start,","+        state_indices=state_indices,","+        num_accepted_tokens=accepted,","+        conv_state=conv,","+        conv_weight=conv_weight,","+        out=out,","+    )","+    torch.accelerator.synchronize()","+    if not launched:","+        assert (out == 7.0).all()","+        for page, before in zip(pages[1:], initial[1:]):","+            assert torch.equal(page, before)","+        return False","+    assert int(verify.counter) == 0  # left zeroed for the next launch","+","+    live = [b for b in range(batch) if int(state_indices[b]) > 0 and int(lens[b]) > 0]","+    bounds = query_start.tolist()","+    live_tokens = [t for b in live for t in range(bounds[b], bounds[b + 1])]","+    dead_tokens = [","+        t","+        for b in range(batch)","+        if int(state_indices[b]) <= 0","+        for t in range(bounds[b], bounds[b + 1])","+    ]","+    ref_out = ref_out.view(tokens, heads * D)","+    torch.testing.assert_close(","+        out[live_tokens].float(), ref_out[live_tokens].float(), atol=3e-2, rtol=3e-2","+    )","+    if dead_tokens:","+        assert (out[dead_tokens] == 0).all()","+    for b in live:","+        slot, n = int(state_indices[b]), int(lens[b])","+        torch.testing.assert_close(","+            records.correction[b, :, :n],","+            ref_records.correction[b, :, :n],","+            atol=3e-2,","+            rtol=3e-2,","+        )","+        torch.testing.assert_close(","+            records.key_gate[b, :, :n], ref_records.key_gate[b, :, :n]","+        )","+        # The rolled conv state: two history rows, then the raw tokens.","+        if dim_first:","+            torch.testing.assert_close(","+                conv[slot, :, : n + 2], ref_conv[slot, :, : n + 2]","+            )","+        else:","+            torch.testing.assert_close(conv[slot, : n + 2], ref_conv[slot, : n + 2])","+    # The checkpoint is never written; other slots' pages and other rows'","+    # records are untouched.","+    torch.testing.assert_close(state, ref_state, atol=0, rtol=0)","+    untouched = sorted(set(range(slots)) - {int(state_indices[b]) for b in live})","+    for page, before in zip(pages[1:], initial[1:]):","+        assert torch.equal(page[untouched], before[untouched])","+    for record, before in zip(","+        (records.correction, records.key_gate),","+        (initial_records.correction, initial_records.key_gate),","+    ):","+        assert torch.equal(record[batch:], before[batch:])","+    return True","+","+","+@pytest.mark.parametrize(\"heads\", [96, 12])","+@pytest.mark.parametrize(\"dim_first\", [True, False])","+@pytest.mark.parametrize(\"conv_weight_dtype\", [torch.float32, torch.bfloat16])","+@pytest.mark.parametrize(\"batch,varlen\", [(1, False), (8, False), (13, True)])","+@pytest.mark.parametrize(\"row_pad\", [0, 3])","+@pytest.mark.parametrize(\"recoverssm_accepted\", [True, False])","+@torch.inference_mode()","+def test_cute_verify_matches_triton(","+    heads, dim_first, conv_weight_dtype, batch, varlen, row_pad, recoverssm_accepted","+):","+    \"\"\"``row_pad`` 3 misaligns the projection rows, so the dim-first layout falls","+    back from the warp-specialized verify to the plain tcgen05 one.","+    ``recoverssm_accepted`` feeds RecoverSSM's accepted counts (always 1: the","+    commit compacts the conv state); otherwise the stock spec-decode counts.\"\"\"","+    assert _check_verify(","+        heads, dim_first, conv_weight_dtype, batch, varlen, row_pad, recoverssm_accepted","+    )","+","+","+@pytest.mark.parametrize(\"window\", [2, 8])","+@pytest.mark.parametrize(\"dim_first\", [True, False])","+@torch.inference_mode()","+def test_cute_verify_window_sizes(window, dim_first):","+    \"\"\"1 and 7 speculative tokens (the 1-8 token windows the kernels support).\"\"\"","+    assert _check_verify(window=window, dim_first=dim_first, batch=13, varlen=True)","+","+","+@pytest.mark.parametrize(\"row_pad,launches\", [(0, True), (3, False)])","+@torch.inference_mode()","+def test_cute_verify_token_offset(row_pad, launches):","+    \"\"\"Spec-decode tokens after a mixed batch's other tokens start one row into","+    the projection: with 16-byte aligned rows the CuTe verify runs, otherwise it","+    declines (writing nothing) and the caller runs the Triton verify.\"\"\"","+    assert _check_verify(row_pad=row_pad, row_offset=1) == launches","+","+","+@torch.inference_mode()","+def test_cute_verify_pad_slot_id():","+    \"\"\"Requests padded with PAD_SLOT_ID (-1) are dead like null-block ones.\"\"\"","+    assert _check_verify(batch=13, varlen=True, dead_slot=-1)","+","+","+@torch.inference_mode()","+def test_cute_verify_rejects_unsupported_state_pages():","+    \"\"\"The CuTe verify rejects state pages the TMA cannot stream: padded value","+    rows, or a page off a 16-byte boundary.\"\"\"","+    heads, window, batch = 16, 5, 2","+    _, query_start, mixed_qkv, raw_gate, raw_beta = _inputs(","+        batch, heads, window, False, 0, 0","+    )","+    tokens = mixed_qkv.shape[0]","+    _, conv, state = _pages(4, heads, window, True)","+    verify = _compiled_verify(heads, window, True, torch.float32)","+    args = dict(","+        mixed_qkv=mixed_qkv,","+        raw_gate=raw_gate,","+        raw_beta=raw_beta,","+        A_log=torch.zeros(heads, device=DEVICE),","+        dt_bias=torch.zeros(heads * D, device=DEVICE),","+        lower_bound=LOWER_BOUND,","+        state=state,","+        records=_records(batch, heads, window),","+        query_start_loc=query_start,","+        state_indices=torch.arange(1, batch + 1, dtype=torch.int32, device=DEVICE),","+        num_accepted_tokens=torch.ones(batch, dtype=torch.int32, device=DEVICE),","+        conv_state=conv,","+        conv_weight=torch.zeros(3 * heads * D, 4, device=DEVICE),","+        out=torch.empty(tokens, heads * D, device=DEVICE, dtype=torch.bfloat16),","+    )","+    # Padded value rows: the state TMA reads K-element rows back to back.","+    padded = torch.zeros(*state.shape[:-1], D + 8, device=DEVICE, dtype=torch.bfloat16)[","+        ..., :D","+    ]","+    with pytest.raises(ValueError, match=\"state strides\"):","+        verify(**{**args, \"state\": padded})","+    # A state 8 bytes off a 16-byte boundary.","+    shifted = torch.zeros(state.numel() + 8, device=DEVICE, dtype=torch.bfloat16)","+    with pytest.raises(ValueError, match=\"16-byte boundaries\"):","+        verify(**{**args, \"state\": shifted[4 : 4 + state.numel()].view(state.shape)})","+","+","+def _layer(pages, records: KDARecoverSSMRecords, heads: int) -> SimpleNamespace:","+    _, conv, state = pages","+    return SimpleNamespace(","+        pages=pages,","+        kv_cache=(conv, state),","+        recoverssm_records=records,","+        A_log=torch.randn(heads, device=DEVICE) * 0.5,","+        dt_bias=torch.randn(heads * D, device=DEVICE) * 0.5,","+        local_num_heads=heads,","+        head_dim=D,","+        gate_lower_bound=LOWER_BOUND,","+    )","+","+","+@pytest.mark.parametrize(\"heads\", [96, 12, 3])","+@pytest.mark.parametrize(\"batch\", [1, 8, 13])","+@pytest.mark.parametrize(\"window\", [2, 5, 8])","+@torch.inference_mode()","+def test_cute_state_commit_matches_triton(heads, batch, window, monkeypatch):","+    \"\"\"The CuTe fold of every layer's accepted tokens equals the Triton fold,","+    with varlen windows, rejected-everything (0 accepted) and dead requests.\"\"\"","+    monkeypatch.setattr(","+        \"vllm.model_executor.layers.mamba.mamba_utils.get_conv_state_layout\",","+        lambda: \"DS\",","+    )","+    torch.manual_seed(heads + batch + window)","+    num_layers = 3","+    slots = 2 * batch + 1","+    layers = []","+    for _ in range(num_layers):","+        layers.append(","+            _layer(","+                _pages(slots, heads, window, dim_first=True),","+                _records(batch, heads, window),","+                heads,","+            )","+        )","+    lens = torch.full((batch,), window, dtype=torch.int32)","+    if batch > 2:","+        lens[0] = min(2, window)","+    query_start = torch.zeros(batch + 1, dtype=torch.int32)","+    query_start[1:] = torch.cumsum(lens, 0)","+    query_start = query_start.to(DEVICE)","+    accepted = torch.randint(0, window + 1, (batch,), dtype=torch.int32, device=DEVICE)","+    state_indices = torch.randperm(slots - 1, device=DEVICE)[:batch].to(torch.int32) + 1","+    if batch > 3:","+        state_indices[3] = 0","+","+    compile_state_commit(heads, window, DEVICE, align=False)","+    initial = [_clone_pages(layer.pages) for layer in layers]","+    results = {}","+    for cute in (False, True):","+        for layer, before in zip(layers, initial):","+            layer.pages[0].copy_(before[0])","+        context = KDARecoverSSMCommitContext.create(","+            layers,","+            spec_query_len=window,","+            max_num_reqs=batch,","+            backend=\"cute\" if cute else \"triton\",","+        )","+        context.commit(accepted, state_indices, query_start)","+        torch.accelerator.synchronize()","+        results[cute] = [layer.kv_cache[1].clone() for layer in layers]","+    states_before = [before[2] for before in initial]","+","+    for triton_state, cute_state, before in zip(","+        results[False], results[True], states_before","+    ):","+        torch.testing.assert_close(","+            cute_state.float(), triton_state.float(), atol=2e-2, rtol=2e-2","+        )","+        # Requests with no accepted tokens keep their state, as do unused slots.","+        for b in range(batch):","+            slot = int(state_indices[b])","+            if slot > 0 and int(accepted[b]) == 0:","+                assert torch.equal(cute_state[slot], before[slot])","+        unused = sorted(set(range(slots)) - set(state_indices.tolist()))","+        assert torch.equal(cute_state[unused], before[unused])","+","+","+@pytest.mark.parametrize(\"heads\", [96, 16])","+@torch.inference_mode()","+def test_recoverssm_steps_match_stock_spec_decode(heads, monkeypatch):","+    \"\"\"Several verify -> sample -> commit steps of RecoverSSM (CuTe verify and","+    commit, one state slot per request) produce the outputs of stock","+    speculative decoding (``causal_conv1d_update`` + ``fused_recurrent_kda``","+    over 1 + k state slots per request).\"\"\"","+    from vllm.models.kimi_k3.nvidia.ops.third_party.kda import fused_recurrent_kda","+","+    monkeypatch.setattr(","+        \"vllm.model_executor.layers.mamba.mamba_utils.get_conv_state_layout\",","+        lambda: \"DS\",","+    )","+    torch.manual_seed(heads)","+    window, batch, steps = 5, 6, 4","+    tokens = batch * window","+    query_start = torch.arange(0, tokens + 1, window, dtype=torch.int32, device=DEVICE)","+    conv_weight = torch.randn(3 * heads * D, 4, device=DEVICE) * 0.5","+","+    # RecoverSSM: one slot per request.","+    layer = _layer(","+        _pages(batch + 1, heads, window, dim_first=True),","+        _records(batch, heads, window),","+        heads,","+    )","+    rss_slots = torch.arange(1, batch + 1, dtype=torch.int32, device=DEVICE)","+    # Stock: 1 + k slots per request; the request's state starts in column 0.","+    _, ref_conv, ref_state = _pages(batch * window + 1, heads, window, True)","+    ref_slots = torch.arange(","+        1, batch * window + 1, dtype=torch.int32, device=DEVICE","+    ).view(batch, window)","+    ref_conv[ref_slots[:, 0]] = layer.kv_cache[0][rss_slots]","+    ref_state[ref_slots[:, 0]] = layer.kv_cache[1][rss_slots]","+","+    verify = _compiled_verify(heads, window, True, torch.float32)","+    compile_state_commit(heads, window, DEVICE, align=False)","+    context = KDARecoverSSMCommitContext.create(","+        [layer], spec_query_len=window, max_num_reqs=batch, backend=\"cute\"","+    )","+    ones = torch.ones(batch, dtype=torch.int32, device=DEVICE)","+    accepted = ones.clone()  # the stock path's counts from the previous step","+    for _ in range(steps):","+        _, _, mixed_qkv, raw_gate, raw_beta = _inputs(batch, heads, window, False, 0, 0)","+        out = torch.empty(tokens, heads * D, device=DEVICE, dtype=torch.bfloat16)","+        assert verify(","+            mixed_qkv=mixed_qkv,","+            raw_gate=raw_gate,","+            raw_beta=raw_beta,","+            A_log=layer.A_log,","+            dt_bias=layer.dt_bias,","+            lower_bound=LOWER_BOUND,","+            state=layer.kv_cache[1],","+            records=layer.recoverssm_records,","+            query_start_loc=query_start,","+            state_indices=rss_slots,","+            num_accepted_tokens=ones,","+            conv_state=layer.kv_cache[0],","+            conv_weight=conv_weight,","+            out=out,","+        )","+        conv_out = torch.empty_like(mixed_qkv)","+        causal_conv1d_update(","+            mixed_qkv,","+            ref_conv,","+            conv_weight,","+            None,","+            activation=\"silu\",","+            conv_state_indices=ref_slots[:, 0],","+            num_accepted_tokens=accepted,","+            query_start_loc=query_start,","+            max_query_len=window,","+            validate_data=False,","+            out=conv_out,","+        )","+        q, k, v = (","+            x.unflatten(-1, (heads, D)).unsqueeze(0)","+            for x in conv_out.split(heads * D, -1)","+        )","+        ref_out, _ = fused_recurrent_kda(","+            q=q,","+            k=k,","+            v=v,","+            raw_g=raw_gate.view(1, tokens, heads, D),","+            raw_beta=raw_beta.unsqueeze(0),","+            A_log=layer.A_log,","+            dt_bias=layer.dt_bias,","+            lower_bound=LOWER_BOUND,","+            initial_state=ref_state,","+            cu_seqlens=query_start,","+            ssm_state_indices=ref_slots,","+            num_accepted_tokens=accepted,","+        )","+        torch.testing.assert_close(","+            out.float(), ref_out.view(tokens, -1).float(), atol=3e-2, rtol=3e-2","+        )","+        # Sample: accept 1..k+1 tokens per request, then commit them.","+        accepted = torch.randint(","+            1, window + 1, (batch,), dtype=torch.int32, device=DEVICE","+        )","+        context.commit(accepted, rss_slots, query_start)","+","+","+@pytest.mark.parametrize(\"window\", [2, 8])","+@torch.inference_mode()","+def test_cute_verify_cuda_graph_replay(window):","+    \"\"\"A captured verify replays with new inputs (every launch, including the","+    captured one, leaves the work counter zeroed).\"\"\"","+    heads, batch = 96, 8","+    torch.manual_seed(window)","+    _, query_start, mixed_qkv, raw_gate, raw_beta = _inputs(","+        batch, heads, window, False, 0, 0","+    )","+    tokens = mixed_qkv.shape[0]","+    A_log = torch.randn(heads, device=DEVICE) * 0.5","+    dt_bias = torch.randn(heads * D, device=DEVICE) * 0.5","+    conv_weight = torch.randn(3 * heads * D, 4, device=DEVICE) * 0.5","+    slots = torch.arange(1, batch + 1, dtype=torch.int32, device=DEVICE)","+    ones = torch.ones(batch, dtype=torch.int32, device=DEVICE)","+    pages = _pages(batch + 1, heads, window, True)"],"additions":574,"deletions":0,"truncated":false}],"additions":636,"deletions":29,"truncated":true,"file_count":3},"error":nul