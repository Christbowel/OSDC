   PhysicalPlan plan = plannerOptimizer.plan(\"\"\"","+            FROM test","+            | WHERE MATCH(LENGTH(last_name), 5)","+            | SORT emp_no","+            | LIMIT 10","+            | KEEP emp_no","+            \"\"\");","+","+        List<FieldAttribute> pushed = findPushedFields(plan, \"last_name\", BlockLoaderFunctionConfig.Function.LENGTH);","+        assertThat(\"LENGTH feeding MATCH should fuse\", pushed, hasSize(1));","+","+        List<Match> matches = new ArrayList<>();","+        plan.forEachExpressionDown(Match.class, matches::add);","+        assertThat(\"MATCH must survive as a runtime expression, not be pushed to Lucene\", matches, hasSize(1));","+","+        Match match = matches.get(0);","+        FieldAttribute field = as(match.field(), FieldAttribute.class);","+        assertThat(as(field.field(), FunctionEsField.class).functionConfig().function(), is(BlockLoaderFunctionConfig.Function.LENGTH));","+        assertTrue(\"MATCH over a fused LENGTH must run at runtime, not be pushed\", match.isRuntimeSearch());","+    }","+","     // ---- field_extract into a function that requires an exact string argument ----"," ","     public void testFieldExtractIntoExactStringArgumentIsFused() {",""],"additions":25,"deletions":0,"truncated":false}],"additions":129,"deletions":10,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-16T14:20:06.342250+00:00"}