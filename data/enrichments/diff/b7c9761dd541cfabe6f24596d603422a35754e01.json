 1","+        x = torch.randn(batch * 64 * 256 + 1, dtype=torch.bfloat16, device=device)","+        b_shape = (2, 256, 128) if op == \"bmm\" else (256, 128)","+        b = torch.randn(b_shape, dtype=x.dtype, device=device)","+        bias = torch.randn(128, dtype=x.dtype, device=device)","+        with (","+            config.patch(_nvgemm_config(max_autotune_gemm_backends=\"NVGEMM,ATEN\")),","+            _force_nvgemm_choice(","+                lambda choice: isinstance(choice, NVUniversalGemmCaller)","+            ),","+        ):","+            result, code = run_and_get_code(","+                torch.compile(fn, dynamic=False, fullgraph=True), x, b, bias","+            )","+        self.assertNotIn(\"_nvgemm_run(\", \"\\n\".join(code))","+        self.assertEqual(result, fn(x, b, bias))","+","+    def test_compatible_shapes_share_graph(self, device):","+        def fn(a, b):","+            return a @ b","+","+        torch._dynamo.reset()","+        counters.clear()","+        with config.patch(_nvgemm_config(nvgemm_max_profiling_configs=2)):","+            compiled = torch.compile(fn, dynamic=True)","+            for m, n, k in ((64, 128, 256), (65, 128, 256), (128, 256, 512)):","+                a = torch.randn(m, k, device=device, dtype=torch.bfloat16)","+                b = torch.randn(k, n, device=device, dtype=torch.bfloat16)","+                self.assertEqual(compiled(a, b), fn(a, b))","+        self.assertEqual(counters[\"stats\"][\"unique_graphs\"], 1)","+","+    @parametrize(","+        \"operand,valid,invalid\",","+        ((\"a\", 264, 262), (\"b\", 264, 262), (\"extent\", 256, 254)),","+    )","+    def test_view_layout_guard(self, device, operand, valid, invalid):","+        def fn(a, b):","+            return a @ b","+","+        def inputs(pitch):","+            a = torch.randn(64, 256, device=device, dtype=torch.bfloat16)","+            b = torch.randn(256, 128, device=device, dtype=torch.bfloat16)","+            if operand == \"extent\":","+                a = torch.randn(64, 264, device=device, dtype=a.dtype)[:, :pitch]","+                b = torch.randn(pitch, 128, device=device, dtype=b.dtype)","+            elif operand == \"a\":","+                a = torch.randn(64, pitch, device=device, dtype=a.dtype)[:, :256]","+            else:","+                b = torch.randn(128, pitch, device=device, dtype=b.dtype)[:, :256].T","+            return a, b","+","+        torch._dynamo.reset()","+        with config.patch(_nvgemm_config(nvgemm_max_profiling_configs=2)):","+            compiled = torch.compile(fn, dynamic=True)","+            args = inputs(valid)","+            self.assertEqual(compiled(*args), fn(*args))","             with self.assertRaisesRegex(","                 Exception, \"NoValidChoicesError|no valid choice\"","             ):","-                compiled_fn(a, b)","+                compiled(*inputs(invalid))","+            self.assertEqual(compiled(*args), fn(*args))","+","+    def test_symbolic_scalar_epilogue_stays_unfused(self, device):","+        def fn(a, b):","+            return (a @ b) * a.shape[0]","+","+        torch._dynamo.reset()","+        counters.clear()","+        with config.patch(_nvgemm_config(nvgemm_max_profiling_configs=2)):","+            compiled = torch.compile(fn, dynamic=True)","+            code = None","+            for m in (64, 128):","+                a = torch.randn(m, 256, device=device, dtype=torch.bfloat16)","+                b = torch.randn(256, 128, device=device, dtype=torch.bfloat16)","+                if code is None:","+                    actual, code = run_and_get_code(compiled, a, b)","+                else:","+                    actual = compiled(a, b)","+                self.assertEqual(actual, fn(a, b), atol=1e-1, rtol=1e-2)","+        self.assertIn(\"_nvgemm_run(\", \"\\n\".join(code))","+        self.assertEqual(counters[\"stats\"][\"unique_graphs\"], 1)","+","+    def test_symbolic_reduction_group_stays_unfused(self, device):","+        def fn(a, b):","+            return (a @ b).sum(-1, keepdim=True)","+","+        torch._dynamo.reset()","+        counters.clear()","+        with config.patch(_nvgemm_config(nvgemm_max_profiling_configs=2)):","+            compiled = torch.compile(fn, dynamic=True)","+            code = None","+            for n in (128, 256):","+                a = torch.randn(64, 256, device=device, dtype=torch.bfloat16)","+                b = torch.randn(256, n, device=device, dtype=torch.bfloat16)","+                if code is None:","+                    actual, code = run_and_get_code(compiled, a, b)","+                else:","+                    actual = compiled(a, b)","+                self.assertEqual(actual, fn(a, b), atol=1e-2, rtol=1e-2)","+                self.assertNotIn(","+                    \"'local_reduce': GemmReductionArguments\", \"\\n\".join(code)","+                )","+        self.assertEqual(counters[\"stats\"][\"unique_graphs\"], 1)","+","+","+instantiate_device_type_tests(","+    TestNVUniversalGemmDynamicShapeComments, globals(), only_for=\"cuda\"","+)","+","+","+@unittest.skipIf(","+    not ensure_nv_universal_gemm_available(),","+    \"Requires cutlass.operators\",","+)","+@instantiate_parametrized_tests","+class TestNVUniversalGemmLaunchContract(TestCase):","+    \"\"\"Boundary tests for _kernel_launch_checks on synthetic layouts.\"\"\"","+","+    INT32_MAX = 2**31 - 1","+","+    def _launch_ok(","+        self,","+        values,","+        *,","+        batch=None,","+        clc=False,","+        provider=None,","+        workspace=0,","+        offset=0,","+        static=False,","+    ):","+        from cutlass.operators.providers.cutedsl.gemm.sm100_persistent import (","+            PersistentDenseGemmOperator,","+        )","+","+        from torch._inductor.codegen.nv_universal_gemm.nv_universal_gemm import (","+            NVUniversalGemmCaller,","+        )","+","+        m, n, k = (","+            values if static else (sympy.Symbol(name, integer=True) for name in \"mnk\")","+        )","+        lead = [] if batch is None else [batch]","+","+        def layout(rows, cols, layout_offset=0):","+            size = [*lead, rows, cols]","+            stride = [rows * cols, cols, 1][-len(size) :]","+            return ir.FixedLayout(","+                torch.device(\"cuda\"), torch.bfloat16, size, stride, layout_offset","+            )","+","+        operand = SimpleNamespace(ptr_alignment_bytes=16)","+        caller = object.__new__(NVUniversalGemmCaller)","+        caller.variant = GemmVariant.GEMM","+        caller.swap_ab = False","+        caller.workspace_size = workspace","+        caller.input_nodes = [","+            SimpleNamespace(get_layout=lambda: layout(m, k, offset)),","+            SimpleNamespace(get_layout=lambda: layout(k, n)),","+        ]","+        caller.layout = layout(m, n)","+        metadata = SimpleNamespace(","+            operands=SimpleNamespace(A=operand, B=operand, out=operand),","+            design=SimpleNamespace(","+                tile_shape=(64, 128, 64), cluster_shape=(1, 2, 1), use_2cta_mma=False","+            ),","+        )","+        if provider is None:","+            caller.kernel = object.__new__(PersistentDenseGemmOperator)","+            caller.kernel._metadata = metadata","+        else:","+            caller.kernel = provider(metadata=metadata)","+        caller.kernel.impl = SimpleNamespace(use_clc_dynamic_scheduler=clc)","+        subs = {} if static else dict(zip((m, n, k), values, strict=True))","+        return all(","+            sympy.sympify(condition).xreplace(subs) is sympy.true","+            for condition, _ in caller._kernel_launch_checks()","+        )","+","+    @parametrize(\"clc\", (False, True))","+    def test_grid_y_limit(self, clc):","+        # ceil(N / 128) rounded up to cluster_n = 2 must stay <= 65535.","+        self.assertTrue(self._launch_ok((64, 65534 * 128, 8), clc=clc))","+        self.assertFalse(self._launch_ok((64, 