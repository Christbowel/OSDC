and_unbacked_rows_choose_same_kernel(self):","+        from torch._dynamo.decorators import mark_unbacked","+        from torch._inductor.codegen.nv_universal_gemm.nv_universal_gemm import (","+            NVUniversalGemmCaller,","+        )","+        from torch._inductor.select_algorithm import AlgorithmSelectorCache","+","+        def fn(a, b):","+            return a @ b","+","+        expected_guard_counts = []","+        check = NVUniversalGemmCaller._check_guarded_requirements","+","+        def track_checks(caller, *, install_guards):","+            env = V.graph.sizevars.shape_env","+            before = len(env.guards)","+            result = check(caller, install_guards=install_guards)","+            expected_guard_counts.append(len(env.guards) - before)","+            return result","+","+        candidates = []","+","+        def deterministic_benchmark(_selector, choices, *_args, **_kwargs):","+            candidates.append(tuple(choice.description for choice in choices))","+            return {choice: float(i + 1) for i, choice in enumerate(choices)}","+","+        b = torch.randn(256, 128, dtype=torch.bfloat16, device=\"cuda\")","+        providers = []","+        for mark_rows in (torch._dynamo.mark_dynamic, mark_unbacked):","+            torch._dynamo.reset()","+            a = torch.randn(65, 256, dtype=b.dtype, device=b.device)","+            mark_rows(a, 0, min=2, max=256, hint_override=65)","+            with (","+                config.patch(_nvgemm_config(force_disable_caches=True)),","+                mock.patch.object(","+                    NVUniversalGemmCaller, \"_check_guarded_requirements\", track_checks","+                ),","+                mock.patch.object(","+                    AlgorithmSelectorCache,","+                    \"benchmark\",","+                    autospec=True,","+                    side_effect=deterministic_benchmark,","+                ),","+            ):","+                result, code = run_and_get_code(torch.compile(fn, fullgraph=True), a, b)","+            self.assertEqual(result, fn(a, b))","+            self.assertIn(\"_nvgemm_run(\", \"\\n\".join(code))","+            providers.append(","+                re.findall(r\"^_KERNEL_NAME = (.+)$\", \"\\n\".join(code), re.MULTILINE)","+            )","+        self.assertTrue(providers[0])","+        self.assertEqual(providers[0], providers[1])","+        self.assertEqual(len(candidates), 2)","+        self.assertEqual(candidates[0], candidates[1])","+        self.assertTrue(expected_guard_counts)","+        self.assertEqual(set(expected_guard_counts), {0})","+","+    @torch._dynamo.config.patch({\"capture_scalar_outputs\": True})","+    def test_unbounded_unbacked_rows_decline(self):","+        from torch._inductor.codegen.nv_universal_gemm import NVUniversalGemmCaller","+","+        def fn(count, w):","+            # Unlike nonzero on a fixed-size tensor, the scalar has no implicit","+            # upper bound from the number of input elements.","+            m = count.item()","+            torch._check(m > 0)","+            torch._dynamo.override_optimization_hint(m, 65)","+            return torch.ones((m, 256), dtype=w.dtype, device=w.device) @ w","+","+        w = torch.randn(256, 128, dtype=torch.bfloat16, device=\"cuda\")","+        with (","+            config.patch(_nvgemm_config(max_autotune_gemm_backends=\"NVGEMM,ATEN\")),","+            _force_nvgemm_choice(","+                lambda choice: isinstance(choice, NVUniversalGemmCaller)","+            ),","+        ):","+            count = torch.tensor(65, device=\"cuda\")","+            result, code = run_and_get_code(torch.compile(fn, fullgraph=True), count, w)","+        self.assertNotIn(\"_nvgemm_run(\", \"\\n\".join(code))","+        self.assertEqual(result, fn(count, w))","+","+    def test_dynamic_shapes(self):","+        \"\"\"Test NVGEMM across backed symbolic shapes.\"\"\""," ","         def matmul(a, b):","             return a @ b","@@ -4273,12 +44