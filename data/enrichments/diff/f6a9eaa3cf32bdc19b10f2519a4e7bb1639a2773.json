eter);","+          index.pop_back();","+          if (res != nullptr && res->opcode() != HloOpcode::kAsyncDone) {","+            return res;","+          }","+        }","+        return nullptr;","+      }","+      int64_t idx = index.back();","+      index.pop_back();","+      InstT* res = FindAsyncProducerImpl(GetOperand(instr, idx), index,","+                                         stop_at_parameter);","+      if (res != nullptr) {","+        return res;","+      }","+      index.push_back(idx);","+      return nullptr;","+    }","+    case HloOpcode::kWhile: {","+      const HloComputation* comp = instr->while_body();","+      InstT* comp_root = comp->root_instruction();","+      ShapeIndex comp_index = index;","+      InstT* comp_producer = FindAsyncProducerImpl(comp_root, comp_index,","+                                                   /*stop_at_parameter=*/true);","+      if (comp_producer != nullptr) {","+        if (comp_producer->opcode() == HloOpcode::kParameter &&","+            comp_producer->parent() == comp) {","+          return FindAsyncProducerImpl(","+              GetOperand(instr, comp_producer->parameter_number()), comp_index,","+              stop_at_parameter);","+        }","+        return comp_producer;","+      }","+      return nullptr;","+    }","+    case HloOpcode::kParameter: {","+      if (stop_at_parameter) {","+        return instr;","+      }","+      const HloComputation* comp = instr->parent();","+      if (comp == nullptr || comp->parent() == nullptr ||","+          comp->IsEntryComputation()) {","+        return nullptr;","+      }","+      auto callers = comp->caller_instructions();","+      for (HloInstruction* caller : callers) {","+        if (caller->opcode() == HloOpcode::kWhile) {","+          InstT* res = FindAsyncProducerImpl(","+              GetOperand(caller, instr->parameter_number()), index,","+              stop_at_parameter);","+          if (res != nullptr) {","+            return res;","+          }","+ 