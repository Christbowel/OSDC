escriptionToCacheKey("],"additions":1,"deletions":1,"truncated":false},{"path":"third_party/xla/xla/service/gpu/gpu_executable.cc","lines":["@@ -115,6 +115,7 @@ limitations under the License."," #include \"xla/stream_executor/rocm/rocm_platform_id.h\""," #include \"xla/stream_executor/stream.h\""," #include \"xla/stream_executor/stream_executor.h\"","+#include \"xla/stream_executor/sycl/oneapi_compute_capability.h\""," #include \"xla/stream_executor/sycl/sycl_platform_id.h\""," #include \"xla/tsl/platform/env_time.h\""," #include \"xla/tsl/platform/logging.h\"","@@ -564,7 +565,10 @@ absl::Status GpuExecutable::CheckCompatibilityWithServiceExecutableRunOptions(","         << \"Compute capability mismatch; expected {\" << gpu_version_.ToString()","         << \"}, but was {\" << cc.ToString() << \"}\";","   } else if (platform_id == se::sycl::kSyclPlatformId) {","-    // TODO: Add check.","+    se::OneAPIComputeCapability cc = main_stream->GetOneAPIComputeCapability();","+    TF_RET_CHECK(cc == *gpu_version_.oneapi_compute_capability())","+        << \"Compute capability mismatch; expected {\" << gpu_version_.ToString()","+        << \"}, but was {\" << cc.ToString() << \"}\";","   } else {","     return Internal(\"Unknown platform\");","   }"],"additions":5,"deletions":1,"truncated":false},{"path":"third_party/xla/xla/stream_executor/sycl/oneapi_compute_capability.cc","lines":["@@ -15,194 +15,70 @@ limitations under the License."," "," #include \"xla/stream_executor/sycl/oneapi_compute_capability.h\""," ","-#include <cassert>"," #include <cstddef>"," #include <cstdint>"," #include <string>","-#include <utility>"," ","-#include \"absl/strings/ascii.h\"","-#include \"absl/strings/numbers.h\"","+#include \"absl/strings/match.h\""," #include \"absl/strings/str_cat.h\""," #include \"absl/strings/string_view.h\""," #include \"xla/stream_executor/sycl/oneapi_compute_capability.pb.h\""," "," namespace stream_executor {"," ","-// ==============================================================================","-// Battlemage (BMG) variant codec","-// ==============================================================================","-template <>","-struct OneAPIComputeCapability::OneAPIDeviceVariantOps<OneAPIDeviceType::kBMG> {","-  static bool IsKnown(uint32_t version) { return (version - 1) < 2; }","-","-  static std::string Decode(uint32_t version) {","-    return absl::StrCat(\"G\", version * 10 + 11);","-  }","-","-  static uint32_t Encode(absl::string_view variant) {","-    int value;","-    if (variant.length() < 2 || variant[0] != 'G' ||","-        !absl::SimpleAtoi(variant.substr(1), &value)) {","-      return OneAPIComputeCapability::kUnknownVariantValue;","-    }","-    return (value - 11) / 10;","-  }","-};","-","-// ==============================================================================","-// Ponte Vecchio (PVC) variant codec","-// ==============================================================================","-template <>","-struct OneAPIComputeCapability::OneAPIDeviceVariantOps<OneAPIDeviceType::kPVC> {","-  static bool IsKnown(uint32_t version) { return (version & 0xfe) == 0x3c; }","-","-  static std::string Decode(uint32_t version) {","-    return (version == 0x3d) ? \"VG\" : \"\";","-  }","-","-  static uint32_t Encode(absl::string_view variant) {","-    constexpr uint32_t kDefaultVersion = 0x3c;","-    return variant.empty()     ? kDefaultVersion","-           : (variant == \"VG\") ? (kDefaultVersion + 1)","-                               : OneAPIComputeCapability::kUnknownVariantValue;","-  }","-};","-","-// ==============================================================================","-// Alchemist (DG2) variant codec","-// ==============================================================================","-template <>","-struct OneAPIComputeCapability::OneAPIDeviceVariantOps<OneAPIDeviceType::kDG2> {","-  static bool IsKnown(uint32_t version) {","-    return version == 0x37 || (version & 0xfe) == 0x38;","-  }","-","-  static std::string Decode(uint32_t version) {","-    return absl::StrCat(\"G\", version - 45);","-  }","-","-  static uint32_t Encode(absl::string_view variant) {","-    int value;","-    if (!absl::SimpleAtoi(variant.substr(1), &value)) {","-      return OneAPIComputeCapability::kUnknownVariantValue;","+OneAPIComputeCapability::OneAPIComputeCapability(XeGeneration generation,","+                                                 uint8_t version)","+    : generation_(generation) {","+  // The first range that matches selects the arch. If none does, the arch","+  // stays kUnknown but the generation is kept.","+  for (const ArchRange& range : kXeArchRanges) {","+    if (GetArchInfo(range.arch).generation == generation &&","+        version >= range.min_version && version <= range.max_version) {","+      arch_ = range.arch;","+      return;","     }","-    return value + 45;","   }","-};","-","-template <std::size_t... I>","-OneAPIDeviceType OneAPIComputeCapability::InferDeviceType(","-    uint32_t generation, uint32_t version, std::index_sequence<I...>) {","-  OneAPIDeviceType resolved = OneAPIDeviceType::kUnknown;","-  ([&] {","-    constexpr OneAPIDeviceType type = kKnownDevices[I].type;","-    constexpr uint32_t arch_val = (static_cast<uint32_t>(type) >> 22) & 0x3ff;","-    if (generation == arch_val &&","-        OneAPIDeviceVariantOps<type>::IsKnown(version)) {","-      resolved = type;","-      return true;","-    }","-    return false;","-  }() ||","-   ...);  // NOLINT(whitespace/indent)","-  return resolved;","-}","-","-template <std::size_t... I>","-uint32_t OneAPIComputeCapability::ApplyVariantToIpVersion(","-    absl::string_view variant, uint32_t ip_version, OneAPIDeviceType type,","-    std::index_sequence<I...>) {","-  uint32_t encoded_device = 0;","-  ([&] {","-    constexpr auto T = kKnownDevices[I].type;","-    if (type == T) {","-      encoded_device =","-          (ip_version & 0xffc00000) |","-          (OneAPIDeviceVariantOps<T>::Encode(absl::AsciiStrToUpper(variant))","-           << 14);","-      return true;","-    }","-    return false;","-  }() ||","-   ...);  // NOLINT(whitespace/indent)","-  return encoded_device;"," }"," ","-template <std::size_t... I>","-std::string OneAPIComputeCapability::VariantStringForDevice(","-    std::index_sequence<I...>) const {","-  std::string result;","-  ([&] {","-    constexpr auto T = kKnownDevices[I].type;","-    if (device_ == T) {","-      result = OneAPIDeviceVariantOps<T>::Decode(version_);","-      return true;","-    }","-    return false;","-  }() ||","-   ...);  // NOLINT(whitespace/indent)","-  return result;","-}","-","-OneAPIComputeCapability::OneAPIComputeCapability(uint32_t generation,","-                                                 uint32_t version)","-    : generation_(generation),","-      version_(version),","-      device_(InferDeviceType(","-          generation, version,","-          std::make_index_sequence<std::size(kKnownDevices)>{})) {}","-","-OneAPIComputeCapability::OneAPIComputeCapability(absl::string_view arch,","-                                                 absl::string_view variant)","-    : OneAPIComputeCapability([&]() -> uint32_t {","-        OneAPIDeviceType type = NameToDeviceType(arch);","-        auto ip_version = static_cast<uint32_t>(type);","-        if ((ip_version & 0x3fff) >= std::size(kKnownDevices)) {","-          return 0;","-        }","-        if (variant.empty()) {","-          return ip_version;","-        }","-        return ApplyVariantToIpVersion(","-            variant, ip_version, type,","-            std::make_index_sequence<std::size(kKnownDevices)>{});","-      }()) {}","-","-std::string OneAPIComputeCapability::architecture() const {","-  for (const auto& info : kKnownDevices) {","-    if (device_ == info.type) {","-      return info.name;","+OneAPIComputeCapability::OneAPIComputeCapability(absl::string_view arch) {","+  for (size_t i = 0; i < static_cast<size_t>(XeArch::kUnknown); ++i) {","+    if (absl::EqualsIgnoreCase(kXeArchInfos[i].name, arch)) {","+      *this = OneAPIComputeCapability(static_cast<XeArch>(i));","+      return;","     }","   }","-  if (generation_ == 0) {","-    return \"Unknown\";","-  }","-  return absl::StrCat(\"Xe\", generation_ / 10,","-                      (generation_ % 10 == 5) ? \"P\" : \"\");"," }"," ","-std::string OneAPIComputeCapability::variant() const {","-  return VariantStringForDevice(","-      std::make_index_sequence<std::size(kKnownDevices)>{});","+std::string OneAPIComputeCapability::architecture() const {","+  return std::string(GetArchInfo(arch_).name);"," }"," "," OneAPIComputeCapability OneAPIComputeCapability::FromProto(","     const OneAPIComputeCapabilityProto& proto) {","-  return OneAPIComputeCapability{proto.architecture(), proto.variant()};","+  OneAPIComputeCapability cc{proto.architecture()};","+  // A known architecture name takes precedence; the generation is only needed","+  // to identify devices whose architecture is unknown.","+  if (cc.arch_ == XeArch::kUnknown && proto.has_generation()) {","+    cc.generation_ = static_cast<XeGeneration>(proto.generation());","+  }","+  return cc;"," }"," "," OneAPIComputeCapabilityProto OneAPIComputeCapability::ToProto() const {","   OneAPIComputeCapabilityProto proto;","   proto.set_architecture(architecture());","-  proto.set_variant(variant());","+  if (IsSpecified()) {","+    proto.set_generation(static_cast<uint32_t>(generation_));","+  }","   return proto;"," }"," "," std::string OneAPIComputeCapability::ToString() const {","-  const std::string& variant_string = variant();","-  return absl::StrCat(architecture(), variant_string.empty() ? \"\" : \"_\",","-                      variant_string);","+  if (arch_ == XeArch::kUnknown && IsSpecified()) {","+    return absl::StrCat(architecture(),","+                        \"(gen=\", static_cast<uint32_t>(generation_), \")\");","+  }","+  return architecture();"," }"," "," }  // namespace stream_executor"],"additions":33,"deletions":157,"truncated":false},{"path":"third_party/xla/xla/stream_executor/sycl/oneapi_compute_capability.h","lines":["@@ -16,78 +16,127 @@ limitations under the License."," #ifndef XLA_STREAM_EXECUTOR_SYCL_ONEAPI_COMPUTE_CAPABILITY_H_"," #define XLA_STREAM_EXECUTOR_SYCL_ONEAPI_COMPUTE_CAPABILITY_H_"," ","-#include <cassert>"," #include <cstddef>"," #include <cstdint>"," #include <string>","-#include <utility>"," ","-#include \"absl/strings/match.h\"","-#include \"absl/strings/str_cat.h\""," #include \"absl/strings/string_view.h\""," #include \"xla/stream_executor/sycl/oneapi_compute_capability.pb.h\""," "," namespace stream_executor {"," ","-#define FOR_KNOWN_ONEAPI_DEVICES(EMIT)                               \\","-  EMIT(/*device=*/PVC, /*idx=*/0, /*gen=*/0xc, /*default_ver=*/0x3c) \\","-  EMIT(/*device=*/BMG, /*idx=*/1, /*gen=*/0x14, /*default_ver=*/0x1) \\","-  EMIT(/*device=*/DG2, /*idx=*/2, /*gen=*/0xc, /*default_ver=*/0x37)","-","-#define DEVICE_INFO(HW, ...) {#HW, OneAPIDeviceType::k##HW},","-#define DEVICE_ENTRIES(HW, I, G, V) k##HW = ((G << 22) | (V << 14) | (I)),","-","-// Convenience utilities for each known device family. For example, PVC()","-// returns the compute capability for PVC variants and IsPVC() checks whether","-// this capability corresponds to a PVC variant.","-#define DEVICE_UTILITIES(HW, ...)                                              \\","-  static OneAPIComputeCapability HW() { return OneAPIComputeCapability{#HW}; } \\","-  bool Is##HW() const { return device_ == OneAPIDeviceType::k##HW; }","+enum class XeGeneration : uint32_t {","+  kUnknown = 0,","+  kXe = 12,","+  kXe2 = 20,","+  kXe3 = 30,","+  kXe3P = 35","+};"," ","-// Each enum entry encodes the generation, version, and index of a given device","-enum class OneAPIDeviceType : uint32_t {","-  FOR_KNOWN_ONEAPI_DEVICES(DEVICE_ENTRIES) kUnknown","+// Known Xe architectures as (architecture, generation, min_version,","+// max_version) rows. A row matches a device of the given generation whose","+// release version lies in the inclusive range [min_version, max_version]. The","+// architecture name is the string used by architecture(), ToString() and the","+// proto.","+//","+// Use EMIT_ARCH_DEFINE once per arch (it defines the XeArch enumerator) and","+// EMIT_ARCH_EXTEND for additional version ranges of the same arch. When","+// inferring the arch, the first row whose generation matches and whose range","+// contains the version is selected.","+#define FOR_KNOWN_ONEAPI_ARCHS(EMIT_ARCH_DEFINE, EMIT_ARCH_EXTEND) \\","+  EMIT_ARCH_DEFINE(XeLP, Xe, 0, 4)        /* TGL, RKL, ADL */      \\","+  EMIT_ARCH_EXTEND(XeLP, Xe, 10, 10)      /* DG1 */                \\","+  EMIT_ARCH_DEFINE(XeHPG, Xe, 55, 57)     /* DG2 */                \\","+  EMIT_ARCH_DEFINE(XeHPC, Xe, 60, 61)     /* PVC */                \\","+  EMIT_ARCH_DEFINE(XeLPG, Xe, 70, 71)     /* MTL */                \\","+  EMIT_ARCH_DEFINE(XeLPGPlus, Xe, 74, 74) /* ARL-H */              \\","+  /* Add new Xe rows above this. */                                \\","+  EMIT_ARCH_DEFINE(XeOther, Xe, 0, 0xff) /* Other Xe */            \\","+  EMIT_ARCH_DEFINE(Xe2HPG, Xe2, 1, 2)    /* BMG */                 \\","+  EMIT_ARCH_DEFINE(Xe2LPG, Xe2, 4, 4)    /* LNL */                 \\","+  /* Add new Xe2 rows above this. */                               \\","+  EMIT_ARCH_DEFINE(Xe2Other, Xe2, 0, 0xff) /* Other Xe2 */         \\","+  EMIT_ARCH_DEFINE(Xe3, Xe3, 0, 0xff)      /* PTL, WCL, NVL-S/U */ \\","+  EMIT_ARCH_DEFINE(Xe3PLPG, Xe3P, 10, 10)  /* NVL-P */             \\","+  EMIT_ARCH_DEFINE(Xe3PXPC, Xe3P, 11, 11)  /* CRI */               \\","+  /* Add new Xe3P rows above this. */                              \\","+  EMIT_ARCH_DEFINE(Xe3POther, Xe3P, 0, 0xff) /* Other Xe3P */","+","+#define ONEAPI_ARCH_SKIP(...)","+#define ONEAPI_ARCH_ENTRIES(ARCH, ...) k##ARCH,","+#define ONEAPI_ARCH_INFO(ARCH, GEN, ...) {#ARCH, XeGeneration::k##GEN},","+#define ONEAPI_ARCH_RANGE(ARCH, GEN, MIN, MAX) {XeArch::k##ARCH, MIN, MAX},","+","+// Convenience utilities for each known arch. For example, IsXeLPG()","+// checks whether this capability corresponds to an XeLPG device.","+#define ONEAPI_ARCH_UTILITIES(ARCH, ...) \\","+  constexpr bool Is##ARCH() const { return arch_ == XeArch::k##ARCH; }","+","+// Only EMIT_ARCH_DEFINE rows become enumerators, so each name appears once.","+enum class XeArch : uint8_t {","+  FOR_KNOWN_ONEAPI_ARCHS(ONEAPI_ARCH_ENTRIES, ONEAPI_ARCH_SKIP) kUnknown"," };"," "," class OneAPIComputeCapability {","  public:","   OneAPIComputeCapability() = default;"," ","-  explicit OneAPIComputeCapability(uint32_t generation, uint32_t version);","+  // The generation is taken from the arch's row.","+  // XeArch::kUnknown gives an unspecified capability.","+  constexpr explicit OneAPIComputeCapability(XeArch arch)","+      : generation_(GetArchInfo(arch).generation), arch_(arch) {}","+","+  explicit OneAPIComputeCapability(XeGeneration generation, uint8_t version);"," ","   explicit OneAPIComputeCapability(const OneAPIComputeCapabilityProto& proto)","       : OneAPIComputeCapability(FromProto(proto)) {}"," ","-  // Device's architecture and variant are encoded in an IP version. The 10 most","-  // significant bits represent the architecture, the next 8 bits represent the","-  // architecture variant, and the 14 least significant bits hold the","-  // architecture family index. The IP version can be queried via Level Zero","-  // calls.","-  explicit OneAPIComputeCapability(const uint32_t ip_version)","-      : OneAPIComputeCapability((ip_version >> 22) & 0x3ff,","-                                (ip_version >> 14) & 0xff) {}","-","-  explicit OneAPIComputeCapability(absl::string_view arch,","-                                   absl::string_view variant = \"\");","+  // The IP version can be queried via Level Zero. Its 10 most significant bits","+  // hold the Xe generation and the next 8 bits hold the release version. The","+  // pair selects the Xe architecture from the FOR_KNOWN_ONEAPI_ARCHS table.","+  explicit OneAPIComputeCapability(uint32_t ip_version)","+      : OneAPIComputeCapability(","+            static_cast<XeGeneration>((ip_version >> 22) & 0x3ff),","+            static_cast<uint8_t>((ip_version >> 14) & 0xff)) {}"," ","-  uint32_t generation() const { return generation_; }","-  uint32_t version() const { return version_; }","+  explicit OneAPIComputeCapability(absl::string_view arch);"," ","   std::string architecture() const;"," ","-  std::string variant() const;","+  constexpr XeGeneration generation() const { return generation_; }"," ","   std::string ToString() const;"," ","-  FOR_KNOWN_ONEAPI_DEVICES(DEVICE_UTILITIES)","-","   OneAPIComputeCapabilityProto ToProto() const;"," ","   static OneAPIComputeCapability FromProto(","       const OneAPIComputeCapabilityProto& proto);"," ","+  FOR_KNOWN_ONEAPI_ARCHS(ONEAPI_ARCH_UTILITIES, ONEAPI_ARCH_SKIP)","+","+  static constexpr OneAPIComputeCapability BMG() {","+    return OneAPIComputeCapability(XeArch::kXe2HPG);","+  }","+  static constexpr OneAPIComputeCapability PVC() {","+    return OneAPIComputeCapability(XeArch::kXeHPC);","+  }","+  static constexpr OneAPIComputeCapability DG2() {","+    return OneAPIComputeCapability(XeArch::kXeHPG);","+  }","+  static constexpr OneAPIComputeCapability CRI() {","+    return OneAPIComputeCapability(XeArch::kXe3PXPC);","+  }","+","+  // Returns true if this capability names a known Xe architecture or carries","+  // the generation of a real (possibly unknown) device.","+  constexpr bool IsSpecified() const {","+    return generation_ != XeGeneration::kUnknown;","+  }","+","+  // For known architectures the generation is implied by the architecture, so","+  // it only distinguishes devices whose architecture is unknown.","   bool operator==(const OneAPIComputeCapability& other) const {","-    return generation_ == other.generation_ && version_ == other.version_;","+    return arch_ == other.arch_ &&