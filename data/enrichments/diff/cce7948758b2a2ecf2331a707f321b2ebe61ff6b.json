ocal = Http::Utility::resolveMostSpecificPerFilterConfig<","+      RoleBasedAccessControlRouteSpecificFilterConfig>(callbacks_);","+","+  EngineResult shadow;","+  evaluateShadowEngine(headers, route_local, shadow);","+  EngineResult enforced;","+  const Http::FilterHeadersStatus status = evaluateEnforcedEngine(headers, route_local, enforced);","+","+  // A config with neither engine writes no dynamic metadata.","+  if (shadow.result_.empty() && enforced.result_.empty()) {","+    return status;","+  }","+","+  // The fields are written after both engines ran and after any local reply returned, so nothing","+  // sendLocalReply() runs sees them, such as the onLocalReply() callbacks, the local reply mapper,","+  // the route's response header formatters and the encoder filters of a reply sent at once. One","+  // namespace lookup serves every field, and each field replaces the value an earlier filter wrote","+  // under the same name.","+  auto& fields =","+      *(*callbacks_->streamInfo().dynamicMetadata().mutable_filter_metadata())[metadata_namespace]","+           .mutable_fields();","+  const auto write = [&fields](EngineResult& result, const DynamicMetadataFieldNames& names) {","+    if (result.result_.empty()) {","+      return;","+    }","+    if (!result.effective_policy_id_.empty()) {","+      fields[names.effective_policy_id_].set_string_value(std::move(result.effective_policy_id_));","+    }","+    fields[names.engine_result_].set_string_value(result.result_);","+  };","+  write(shadow, config_->fieldNames(route_local, Filters::Common::RBAC::EnforcementMode::Shadow));","+  write(enforced,","+        config_->fieldNames(route_local, Filters::Common::RBAC::EnforcementMode::Enforced));","+","+  return status;","+}","+"," Http::FilterHeadersStatus"," RoleBasedAccessControlFilter::decodeHeaders(Http::RequestHeaderMap& headers, bool) {","   ENVOY_LOG(","@@ -266,24 +317,7 @@ RoleBasedAccessControlFilter::decodeHeaders(Http::RequestHeaderMap& headers, boo","      