(\"http\"));","+  auto allowed = codec_client_->makeHeaderOnlyRequest(Http::TestRequestHeaderMapImpl{","+      {\":method\", \"GET\"}, {\":path\", \"/\"}, {\":scheme\", \"http\"}, {\":authority\", \"host\"}});","+  waitForNextUpstreamRequest();","+  upstream_request_->encodeHeaders(Http::TestResponseHeaderMapImpl{{\":status\", \"200\"}}, true);","+  ASSERT_TRUE(allowed->waitForEndStream());","+  EXPECT_EQ(\"200\", allowed->headers().getStatusValue());","+  EXPECT_THAT(waitForAccessLog(access_log_name_, 0),","+              testing::HasSubstr(\"result=allowed policy=foo;\"));","+  codec_client_->close();","+","+  codec_client_ = makeHttpConnection(lookupPort(\"http\"));","+  auto denied = codec_client_->makeHeaderOnlyRequest(Http::TestRequestHeaderMapImpl{","+      {\":method\", \"POST\"}, {\":path\", \"/\"}, {\":scheme\", \"http\"}, {\":authority\", \"host\"}});","+  ASSERT_TRUE(denied->waitForEndStream());","+  EXPECT_EQ(\"403\", denied->headers().getStatusValue());","+  EXPECT_THAT(waitForAccessLog(access_log_name_, 1), testing::HasSubstr(\"result=denied policy=-;\"));","+}","+","+TEST_P(RBACIntegrationTest, AccessLogReadsEngineResultWithDenyAction) {","+  useAccessLog(\"result=%DYNAMIC_METADATA(envoy.filters.http.rbac:enforced_engine_result)% \"","+               \"policy=%DYNAMIC_METADATA(envoy.filters.http.rbac:enforced_effective_policy_id)%;\");","+  config_helper_.prependFilter(RBAC_CONFIG_WITH_DENY_ACTION);"],"additions":31,"deletions":0,"truncated":false}],"additions":242,"deletions":114,"truncated":true,"file_count":7},"error":null,"fetched_at":"2026-11-14T15:13:50.352243+00:00"}