s_wsgi_server,","+)"," from ray.serve._private.common import (","     NodeId,","     ReplicaID,","@@ -37,6 +43,7 @@","     RAY_SERVE_HAPROXY_BROADCAST_COALESCE_S,","     RAY_SERVE_HAPROXY_CLOSE_SPREAD_TIME_S,","     RAY_SERVE_HAPROXY_CONFIG_FILE_LOC,","+    RAY_SERVE_HAPROXY_EXPORTER_SOCKET_PATH,","     RAY_SERVE_HAPROXY_H2_BE_INITIAL_WINDOW_SIZE,","     RAY_SERVE_HAPROXY_H2_BE_MAX_CONCURRENT_STREAMS,","     RAY_SERVE_HAPROXY_H2_FE_INITIAL_WINDOW_SIZE,","@@ -733,6 +740,8 @@ class HAProxyConfig:","     stats_uri: str = \"/stats\"","     metrics_port: int = RAY_SERVE_HAPROXY_METRICS_PORT","     metrics_uri: str = \"/metrics\"","+    metrics_auth_required: bool = False","+    exporter_socket_path: str = RAY_SERVE_HAPROXY_EXPORTER_SOCKET_PATH","     # All timeout values are in seconds","     timeout_queue_s: Optional[int] = None","     timeout_connect_s: Optional[int] = RAY_SERVE_HAPROXY_TIMEOUT_CONNECT_S","@@ -985,6 +994,8 @@ def _initialize_directories_and_error_files(self) -> None:","         # Create a socket directory","         socket_dir = os.path.dirname(self.cfg.socket_path)","         os.makedirs(socket_dir, exist_ok=True)","+        if self.cfg.metrics_auth_required:","+            os.makedirs(os.path.dirname(self.cfg.exporter_socket_path), exist_ok=True)"," ","         # Sweep std-stream logs left by a previous incarnation on this node.","         # No worker has spawned yet, so any match belongs to a dead actor.","@@ -1821,6 +1832,81 @@ async def is_running(self) -> bool:","             return False"," "," ","+def haproxy_metrics_auth_required() -> bool:","+    \"\"\"Whether HAProxy's exporter and stats page need the token: token auth is","+    on and RAY_AUTH_SKIP_METRICS is unset, the rule Ray's metrics endpoints use.\"\"\"","+    return (","+        auth_utils.is_token_auth_enabled() and not auth_utils.is_metrics_auth_skipped()","+    )","+","+","+class _UnixHTTPConnection(http.client.HTTPConnection):","+    def __init__(self, path: str, timeout: float):","+        super().__init__(\"localhost\", timeout=timeout)","+        self._path = path","+","+    def connect(self) -> None:","+        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)","+        sock.settimeout(self.timeout)","+        try:","+            sock.connect(self._path)","+        except BaseException:","+            # Close now: a failed connect never reaches self.sock, so","+            # HTTPConnection.close() wouldn't close it.","+            sock.close()","+            raise","+        self.sock = sock","+","+","+def _fetch_from_unix_socket(","+    socket_path: str, method: str, target: str, timeout_s: float","+) -> Tuple[str, str, bytes]:","+    \"\"\"Returns (status line, content type, body) for one HTTP request.\"\"\"","+    conn = _UnixHTTPConnection(socket_path, timeout=timeout_s)","+    try:","+        conn.request(method, target)","+        resp = conn.getresponse()","+        content_type = resp.getheader(\"Content-Type\", \"text/plain\")","+        return f\"{resp.status} {resp.reason}\", content_type, resp.read()","+    finally:","+        conn.close()","+","+","+def make_exporter_proxy_app(cfg: HAProxyConfig, timeout_s: float = 10.0):","+    \"\"\"WSGI app that forwards GETs for HAProxy's exporter and stats page to","+    HAProxy's unix-socket listener. HAProxyManager serves it behind the token","+    check, so it does no auth itself.\"\"\"","+    stats_uri = cfg.stats_uri","+","+    def app(environ, start_response):","+        method = environ.get(\"REQUEST_METHOD\")","+        path = environ.get(\"PATH_INFO\", \"\")","+        is_stats = path == stats_uri or path.startswith(stats_uri + \";\")","+        if method not in (\"GET\", \"HEAD\") or not (path == cfg.metrics_uri or is_stats):","+            start_response(\"404 Not Found\", [(\"Content-Type\", \"text/plain\")])","+            return [b\"Not Found\"]","+        query = environ.get(\"QUERY_STRING\")","+        target = path + (\"?\" + query if query else \"\")","+        fetch = functools.partial(","+            _fetch_from_unix_socket, cfg.exporter_socket_path, method, target, timeout_s","+        )","+        try:","+            try:","+                status, content_type, body = fetch()","+            except (OSError, http.client.HTTPException):","+                # An -sf reload can reset a connection still queued on the old","+                # worker's listener; the retry reaches the new worker. -x hands","+                # the listener over and avoids this.","+                status, content_type, body = fetch()","+        except (OSError, http.client.HTTPException) as e:","+            start_response(\"503 Service Unavailable\", [(\"Content-Type\", \"text/plain\")])","+            return [f\"HAProxy exporter unavailable: {e}\".encode()]","+        start_response(status, [(\"Content-Type\", content_type)])","+        return [body]","+","+    return app","+","+"," @ray.remote(num_cpus=0)"," class HAProxyManager(ProxyActorInterface):","     def __init__(","@@ -1916,6 +2002,7 @@ def _per_node(path: str) -> str:","             d, f = os.path.split(path)","             return os.path.join(d, self._node_id, f)"," ","+        metrics_auth_required = haproxy_metrics_auth_required()","         self._haproxy = HAProxyApi(","             cfg=HAProxyConfig(","                 http_options=http_options,","@@ -1927,10 +2014,22 @@ def _per_node(path: str) -> str:","                 ),","                 server_state_file=_per_node(RAY_SERVE_HAPROXY_SERVER_STATE_FILE),","                 metrics_socket_path=_per_node(RAY_SERVE_HAPROXY_METRICS_SOCKET_PATH),","+                metrics_auth_required=metrics_auth_required,","+                exporter_socket_path=_per_node(RAY_SERVE_HAPROXY_EXPORTER_SOCKET_PATH),","             ),","             config_file_path=_per_node(RAY_SERVE_HAPROXY_CONFIG_FILE_LOC),","         )"," ","+        self._exporter_server = None","+        if metrics_auth_required:","+            self._exporter_server = start_metrics_wsgi_server(","+                self._haproxy.cfg.metrics_port,","+                make_exporter_proxy_app(self._haproxy.cfg),","+                # Co-located managers share the port when HAProxy uses","+                # SO_REUSEPORT for its own listeners.","+                reuse_port=self._haproxy.cfg.enable_so_reuseport,","+            )","+","         self._metrics_collector = None","         self._metrics_attach_task: Optional[asyncio.Task] = None","         if RAY_SERVE_HAPROXY_METRICS_ENABLED:","@@ -1982,6 +2081,11 @@ async def shutdown(self) -> None:","         except Exception as e:","             raise RuntimeError(f\"Error stopping HAProxy during shutdown: {e}\")","         finally:","+            if self._exporter_server is not None:","+                # Free the metrics port before a replacement manager binds it.","+                await asyncio.to_thread(self._exporter_server.shutdown)","+                self._exporter_server.server_close()","+                self._exporter_server = None","             if self._metrics_collector is not None:","                 self._metrics_collector.close()","                 self._metrics_collector = None"],"additions":104,"deletions":0,"truncated":false},{"path":"python/ray/serve/_private/haproxy_templates.py","lines":["@@ -137,11 +137,24 @@","     load-server-state-from-file global","     {%- endif %}","     balance {{ config.balance_algorithm }}","+{%- if config.metrics_auth_required %}","+# Metrics need the token: the exporter and stats page listen only on a 0600","+# unix socket. HAProxyManager serves both on metrics_port behind the token check.","+listen internal_metrics","+    bind unix@{{ config.exporter_socket_path }} mode 600","+    mode http","+    http-request use-service prometheus-exporter if { path {{ config.metrics_uri }} }","+    stats enable","+    stats uri {{ config.stats_uri }}","+    stats refresh 1s","+    no log","+{%- else %}"," frontend prometheus","     bind :{{ config.metrics_port }}","     mode http","     http-request use-service prometheus-exporter if { path {{ config.metrics_uri }} }","     no log","+{%- endif %}"," frontend http_frontend","     bind {{ config.frontend_host }}:{{ config.frontend_port }}","     {%- if has_ingress_request_router or has_router_applications %}","@@ -487,9 +500,11 @@","     {%- endif %}"," {%- endfor %}"," {%- endif %}","+{%- if not config.metrics_auth_required %}"," listen stats","   bind *:{{ config.stats_port }}","   stats enable","   stats uri {{ config.stats_uri }}","   stats refresh 1s","+{%- endif %}"," \"\"\""],"additions":15,"deletions":0,"truncated":false},{"path":"python/ray/serve/tests/test_haproxy.py","lines":["@@ -20,6 +20,19 @@","     SignalActor,","     wait_for_condition,"," )","+from ray._private.authentication.authentication_token_generator import (","+    generate_new_authentication_token,","+)","+from ray._private.authentication.http_token_authentication import (","+    get_auth_headers_if_auth_enabled,","+)","+from ray._private.authentication_test_utils import (","+    authentication_env_guard,","+    clear_auth_token_sources,","+    reset_auth_token_state,","+    set_auth_mode,","+    set_env_auth_token,","+)"," from ray.actor import ActorHandle"," from ray.cluster_utils import Cluster"," from ray.serve._private.build_app import CUSTOM_INGRESS_REQUEST_ROUTER_UNSUPPORTED_ERROR","@@ -721,7 +734,10 @@ def function(_):"," ","     def metrics_show_2xx_response():","         assert httpx.get(\"http://localhost:8000/\").text == \"hello1\"","-        resp = httpx.get(\"http://localhost:9101/metrics\")","+        resp = httpx.get(","+            \"http://localhost:9101/metrics\",","+            headers=get_auth_headers_if_auth_enabled({}),","+        )","         assert resp.status_code == 200","         last_metrics[0] = resp.text","         for line in resp.text.splitlines():","@@ -740,6 +756,138 @@ def metrics_show_2xx_response():","     serve.shutdown()"," "," ","+@pytest.fixture","+def serve_with_auth(request, monkeypatch):","+    \"\"\"Start Ray and Serve with the auth setup named by the param: \"token\",","+    \"skip_metrics\" (token auth plus RAY_AUTH_SKIP_METRICS=1) or \"disabled\".","+    Yields the token.\"\"\"","+    token = generate_new_authentication_token()","+    with authentication_env_guard():","+        if request.param == \"disabled\":","+            set_auth_mode(\"disabled\")","+            clear_auth_token_sources(remove_default=True)","+        else:","+            set_auth_mode(\"token\")","+            set_env_auth_token(token)","+        if request.param == \"skip_metrics\":","+            # Set before ray.init so every Ray process inherits it.","+            monkeypatch.setenv(\"RAY_AUTH_SKIP_METRICS\", \"1\")","+        reset_auth_token_state()","+        try:","+            ray.init(num_cpus=4)","+            serve.start()","+","+            @serve.deployment","+            def hello(_):","+                return \"hello\"","+","+            serve.run(hello.bind())","+            yield token","+        finally:","+            if ray.is_initialized():","+                serve.shutdown()","+                ray.shutdown()","+            reset_auth_token_state()","+","+","+def _get_haproxy_endpoint(port: int, path: str, **kwargs) -> requests.Response:","+    return requests.get(f\"http://127.0.0.1:{port}{path}\", timeout=5, **kwargs)","+","+","+def _haproxy_exporter_up(**kwargs) -> bool:","+    \"\"\"Whether :9101/metrics returns HAProxy's own exporter output.\"\"\"","+    resp = _get_haproxy_endpoint(9101, \"/metrics\", **kwargs)","+    return b\"haproxy_process_\" in resp.content","+","+","+@pytest.mark.parametrize(\"serve_with_auth\", [\"token\"], indirect=True)","+def test_haproxy_metrics_and_stats_require_token(serve_with_auth):","+    \"\"\"With token auth on, HAProxy's exporter and stats page answer on the","+    metrics port only with the token, and nothing listens on the stats port.\"\"\"","+    token = serve_with_auth","+    accepted_forms = [","+        {\"headers\": {\"Authorization\": f\"Bearer {token}\"}},","+        {\"headers\": {\"X-Ray-Authorization\": f\"Bearer {token}\"}},","+        {\"cookies\": {\"ray-authentication-token\": token}},","+    ]","+    wait_for_condition(_haproxy_exporter_up, timeout=30, **accepted_forms[0])","+","+    missing = _get_haproxy_endpoint(9101, \"/metrics\")","+    assert missing.status_code == 401","+    assert missing.headers[\"WWW-Authenticate\"] == \"Bearer\"","+    wrong = _get_haproxy_endpoint(","+        9101, \"/metrics\", headers={\"Authorization\": \"Bearer \" + \"0\" * 64}","+    )","+    assert wrong.status_code == 403","+    for form in accepted_forms:","+        assert _get_haproxy_endpoint(9101, \"/metrics\", **form).status_code == 200","+","+    assert _get_haproxy_endpoint(9101, \"/stats\").status_code == 401","+    stats = _get_haproxy_endpoint(9101, \"/stats;csv\", **accepted_forms[0])","+    assert stats.status_code == 200","+    assert stats.text.startswith(\"# pxname\")","+    with pytest.raises(requests.ConnectionError):","+        _get_haproxy_endpoint(8404, \"/stats\")","+","+","+@pytest.mark.parametrize(\"serve_with_auth\", [\"skip_metrics\", \"disabled\"], indirect=True)","+def test_haproxy_metrics_and_stats_open_without_token(serve_with_auth):","+    \"\"\"With RAY_AUTH_SKIP_METRICS=1 or auth disabled, HAProxy serves the","+    exporter and stats page itself, as before, and needs no token.\"\"\"","+    wait_for_condition(_haproxy_exporter_up, timeout=30)","+    assert _get_haproxy_endpoint(8404, \"/stats\").status_code == 200","+","+","+def test_haproxy_metrics_token_auth_with_colocated_reuse_port_proxies(monkeypatch):","+    \"\"\"With SERVE_SOCKET_REUSE_PORT_ENABLED=1, co-located EveryNode proxies","+    share the metrics port. In token mode each HAProxyManager's metrics server","+    must share it too, or the second manager fails to bind.\"\"\"","+    # Set before the nodes start so every Ray process inherits it.","+    monkeypatch.setenv(\"SERVE_SOCKET_REUSE_PORT_ENABLED\", \"1\")","+    token = generate_new_authentication_token()","+    with authentication_env_guard():","+        set_auth_mode(\"token\")","+        set_env_auth_token(token)","+        reset_auth_token_state()","+        cluster = Cluster()","+        try:","+            head_node = cluster.add_node(num_cpus=0)","+            cluster.add_node(num_cpus=1)","+            cluster.wait_for_nodes()","+            ray.init(address=head_node.address)","+            serve.start(http_options={\"location\": \"EveryNode\"})","+","+            @serve.deployment","+            def hello(_):","+                return \"hello\"","+","+            serve.run(hello.bind())","+            client = _get_global_client()","+","+            def both_proxies_healthy() -> bool:","+                details = ServeInstanceDetails(","+                    **ray.get(client._controller.get_serve_instance_details.remote())","+                )","+                return len(details.proxies) == 2 and all(","+                    proxy.status == ProxyStatus.HEALTHY","+                    for proxy in details.proxies.values()","+                )","+","+            wait_for_condition(both_proxies_healthy, timeout=60)","+            wait_for_condition(","+                _haproxy_exporter_up,","+                timeout=30,","+                headers={\"Authorization\": f\"Bearer {token}\"},","+            )","+            assert _get_haproxy_endpoint(9101, \"/metrics\").status_code == 401","+        finally:","+            if ray.is_initialized():","+                serve.shutdown()","+                ray.shutdown()","+            cluster.shutdown()","+            reset_auth_token_state()","+","+"," def test_haproxy_safe_name():","     \"\"\"Test that the safe name is generated correctly.\"\"\"","     assert HAProxyManager.get_safe_name(\"HTTP-test_foo.bar\") == \"HTTP-test_foo.bar\""],"additions":149,"deletions":1,"truncated":false},{"path":"python/ray/serve/tests/test_haproxy_api.py","lines":["@@ -5,12 +5,14 @@"," import logging"," import os"," import signal","+import socketserver","+import stat"," import subprocess"," import sys"," import tempfile"," import threading"," import time","-from typing import Optional","+from typing import Optional, Tuple"," from unittest import mock"," "," import httpx","@@ -1906,6 +1908,116 @@ async def test_start(haproxy_api_cleanup):","         assert not api._is_running()"," "," ","+def _call_wsgi(app, path: str, method: str = \"GET\") -> Tuple[str, bytes]:","+    \"\"\"Call a WSGI app directly and return (status line, body).\"\"\"","+    path, _, query = path.partition(\"?\")","+    captured = {}","+","+    def start_response(status, headers):","+        captured[\"status\"] = status","+","+    environ = {\"REQUEST_METHOD\": method, \"PATH_INFO\": path, \"QUERY_STRING\": query}","+    body = b\"\".join(app(environ, start_response))","+    return captured[\"status\"], body","+","+","+@pytest.mark.asyncio","+@pytest.mark.parametrize(\"enable_hap_optimization\", [True, False])","+async def test_metrics_auth_required_moves_exporter_to_unix_socket(","+    haproxy_api_cleanup, enable_hap_optimization","+):","+    \"\"\"With metrics_auth_required, HAProxy binds neither the metrics nor the","+    stats port. The exporter and stats page answer only on a 0600 unix socket,","+    which make_exporter_proxy_app forwards to, and keep answering after a","+    reload hands the socket to a new HAProxy process: with -x when","+    enable_hap_optimization is on, with a plain -sf when it is off.\"\"\"","+    with tempfile.TemporaryDirectory() as temp_dir:","+        metrics_port = find_free_port()","+        stats_port = find_free_port()","+        exporter_socket_path = os.path.join(temp_dir, \"exporter.sock\")","+        config = HAProxyConfig(","+            http_options=HTTPOptions(host=\"127.0.0.1\", port=find_free_port()),","+            metrics_port=metrics_port,","+            stats_port=stats_port,","+            socket_path=os.path.join(temp_dir, \"admin.sock\"),","+            enable_hap_optimization=enable_hap_optimization,","+            server_state_base=temp_dir,","+            server_state_file=os.path.join(temp_dir, \"server-state\"),","+            metrics_auth_required=True,","+            exporter_socket_path=exporter_socket_path,","+            has_received_routes=True,","+            has_received_servers=True,","+        )","+        api = HAProxyApi(","+            cfg=config, config_file_path=os.path.join(temp_dir, \"haproxy.cfg\")","+        )","+        haproxy_api_cleanup(api)","+        await api.start()","+","+        with open(api.config_file_path) as f:","+            config_content = f.read()","+        assert f\"bind unix@{exporter_socket_path} mode 600\" in config_content","+        assert \"frontend prometheus\" not in config_content","+        assert \"listen stats\" not in config_content","+        assert stat.S_IMODE(os.stat(exporter_socket_path).st_mode) == 0o600","+        for port in (metrics_port, stats_port):","+            with pytest.raises(requests.ConnectionError):","+                requests.get(f\"http://127.0.0.1:{port}/\", timeout=2)","+","+        app = haproxy.make_exporter_proxy_app(config)","+","+        def assert_both_pages_answer():","+            status, body = _call_wsgi(app, \"/metrics\")","+            assert status.startswith(\"200\")","+            assert b\"haproxy_process_\" in body","+            status, body = _call_wsgi(app, \"/stats;csv\")","+            assert status.startswith(\"200\")","+            assert body.startswith(b\"# pxname\")","+","+        assert_both_pages_answer()","+        assert _call_wsgi(app, \"/other\")[0].startswith(\"404\")","+        assert _call_wsgi(app, \"/metrics\", method=\"POST\")[0].startswith(\"404\")","+","+        old_pid = api._proc.pid","+        await api.reload()","+        assert api._proc.pid != old_pid","+        assert_both_pages_answer()","+","+        await api.stop()","+        assert _call_wsgi(app, \"/metrics\")[0].startswith(\"503\")","+","+","+def test_exporter_proxy_app_retries_after_dropped_connection():","+    \"\"\"An -sf reload can reset a connection still queued on the old HAProxy","+    worker. The proxy app retries once and gets the new worker's answer.\"\"\"","+    with tempfile.TemporaryDirectory() as temp_dir:","+        socket_path = os.path.join(temp_dir, \"exporter.sock\")","+        connections = []","+","+        class Handler(socketserver.StreamRequestHandler):","+            def handle(self):","+                connections.append(1)","+                if len(connections) == 1:","+                    return  # Close without answering, like a reset listener.","+                self.rfile.readline()","+                self.wfile.write(","+                    b\"HTTP/1.1 200 OK\\r\\nContent-Type: text/plain\\r\\n\"","+                    b\"Content-Length: 2\\r\\nConnection: close\\r\\n\\r\\nok\"","+                )","+","+        server = socketserver.ThreadingUnixStreamServer(socket_path, Handler)","+        threading.Thread(target=server.serve_forever, daemon=True).start()","+        try:","+            app = haproxy.make_exporter_proxy_app(","+                HAProxyConfig(exporter_socket_path=socket_path)","+            )","+            assert _call_wsgi(app, \"/metrics\") == (\"200 OK\", b\"ok\")","+        finally:","+            server.shutdown()","+            server.server_close()","+        assert len(connections) == 2","+","+"," @pytest.mark.asyncio"," async def test_get_running_pid_matches_live_proc(haproxy_api_cleanup):","     \"\"\"`_get_running_pid` parses real `show info` and returns the forked pid.",""],"additions":113,"deletions":1,"truncated":false}],"additions":411,"deletions":6,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-30T15:55:57.657927+00:00"}