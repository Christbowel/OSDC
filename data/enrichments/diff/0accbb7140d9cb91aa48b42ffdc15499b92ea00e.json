{"id":"0accbb7140d9cb91aa48b42ffdc15499b92ea00e","axis":"silent","repo":"quarkusio/quarkus","sha":"0accbb7140d9cb91aa48b42ffdc15499b92ea00e","parsed":{"files":[{"path":"docs/src/main/asciidoc/jfr.adoc","lines":["@@ -197,7 +197,7 @@ This means that after we identify the trace and span IDs of interest from the UI"," If we have not enabled the OpenTelemetry extension, this extension creates an ID for each request and links it to JFR events as a traceId."," In this case, the span ID will be null."," ","-For now, Quarkus only records REST events, but we plan to use this ID to link each event to each other as we add more events in the future.","+For now, Quarkus only records REST server and REST Client events, but we plan to use this ID to link each event to each other as we add more events in the future."," "," === Event Implementation Policy"," ","@@ -250,6 +250,45 @@ We can check if the Resource Method was executed as expected by the HTTP Method"," "," Client records information about the accessing client."," ","+=== REST Client Event","+","+This event is recorded when the Quarkus REST Client extension is enabled.","+","+RestClient::","+","+  Records the time period from the moment the REST Client starts sending a request until the response has been received or the request has failed.","+","+This event has the following information.","+","+- HTTP Method","+- URI","+- Address","+- Client Name","+- Status","+- Failure","+","+HTTP Method records the HTTP Method of the outgoing request.","+","+URI records the URI path template of the invoked REST Client method, for example `/hello/{name}`.","+If no template is available, the URI path is recorded instead.","+Query parameters are never recorded.","+","+Address records the host and port of the remote endpoint.","+","+Client Name records the config key of the REST Client that sent the request.","+","+Status records the HTTP status code of the response, or `0` if no response was received.","+","+Failure records the class name of the exception if the request failed, for example when the connection was refused.","+","+When the request is sent while a REST server request is being processed, the event shares the trace ID of the corresponding REST server event.","+This makes it possible to see which remote calls were made by each REST server request.","+","+[NOTE]","+====","+Requests whose response is streamed as a `Multi` are not recorded.","+====","+"," === Runtime Event"," This event is recorded by default."," The following three JFR events are recorded in JFR chunks."],"additions":40,"deletions":1,"truncated":false},{"path":"extensions/jfr/deployment/pom.xml","lines":["@@ -38,6 +38,26 @@","             <artifactId>quarkus-junit-internal</artifactId>","             <scope>test</scope>","         </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-rest-deployment</artifactId>","+            <scope>test</scope>","+        </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-rest-client-deployment</artifactId>","+            <scope>test</scope>","+        </dependency>","+        <dependency>","+            <groupId>io.rest-assured</groupId>","+            <artifactId>rest-assured</artifactId>","+            <scope>test</scope>","+        </dependency>","+        <dependency>","+            <groupId>org.assertj</groupId>","+            <artifactId>assertj-core</artifactId>","+            <scope>test</scope>","+        </dependency>"," ","     </dependencies>","     <build>"],"additions":20,"deletions":0,"truncated":false},{"path":"extensions/jfr/deployment/src/main/java/io/quarkus/jfr/deployment/JfrProcessor.java","lines":["@@ -15,6 +15,7 @@"," import io.quarkus.deployment.annotations.BuildSteps;"," import io.quarkus.deployment.annotations.ExecutionTime;"," import io.quarkus.deployment.annotations.Record;","+import io.quarkus.deployment.builditem.AdditionalIndexedClassesBuildItem;"," import io.quarkus.deployment.builditem.FeatureBuildItem;"," import io.quarkus.deployment.builditem.nativeimage.RuntimeInitializedClassBuildItem;"," import io.quarkus.jfr.runtime.internal.JfrRecorder;","@@ -22,6 +23,7 @@"," import io.quarkus.jfr.runtime.internal.QuarkusIdProducer;"," import io.quarkus.jfr.runtime.internal.http.rest.classic.ClassicServerEventRecorderProducer;"," import io.quarkus.jfr.runtime.internal.http.rest.classic.ClassicServerFilter;","+import io.quarkus.jfr.runtime.internal.http.rest.client.RestClientFilter;"," import io.quarkus.jfr.runtime.internal.http.rest.reactive.ReactiveServerEventRecorderProducer;"," import io.quarkus.jfr.runtime.internal.http.rest.reactive.ReactiveServerFilters;"," import io.quarkus.jfr.runtime.internal.http.rest.reactive.ServerStartRecordingHandler;","@@ -103,6 +105,19 @@ void registerRestIntegration(Capabilities capabilities,","         }","     }"," ","+    @BuildStep","+    void registerRestClientIntegration(Capabilities capabilities,","+            BuildProducer<AdditionalIndexedClassesBuildItem> additionalIndexed,","+            BuildProducer<AdditionalBeanBuildItem> additionalBeans) {","+        if (capabilities.isPresent(Capability.REST_CLIENT_REACTIVE)) {","+            // the REST Client picks up the @Provider annotation from the index","+            additionalIndexed.produce(new AdditionalIndexedClassesBuildItem(RestClientFilter.class.getName()));","+            additionalBeans.produce(AdditionalBeanBuildItem.builder().setUnremovable()","+                    .addBeanClasses(RestClientFilter.class)","+                    .build());","+        }","+    }","+","     @BuildStep","     void registerResteasyClassicIntegration(Capabilities capabilities,","             BuildProducer<ResteasyJaxrsProviderBuildItem> resteasyJaxrsProviderBuildItemBuildProducer,"],"additions":15,"deletions":0,"truncated":false},{"path":"extensions/jfr/deployment/src/test/java/io/quarkus/jfr/deployment/JfrConfigurationTest.java","lines":["@@ -16,6 +16,7 @@ public class JfrConfigurationTest {","     static final QuarkusExtensionTest TEST = new QuarkusExtensionTest()","             .overrideConfigKey(\"quarkus.jfr.enabled\", \"false\")","             .overrideConfigKey(\"quarkus.jfr.rest.enabled\", \"false\")","+            .overrideConfigKey(\"quarkus.jfr.rest-client.enabled\", \"false\")","             .overrideConfigKey(\"quarkus.jfr.runtime.enabled\", \"false\");"," ","     @Inject","@@ -25,6 +26,7 @@ public class JfrConfigurationTest {","     void config() {","         assertFalse(runtimeConfig.enabled());","         assertFalse(runtimeConfig.restEnabled());","+        assertFalse(runtimeConfig.restClientEnabled());","         assertFalse(runtimeConfig.runtimeEnabled());","     }"," }"],"additions":2,"deletions":0,"truncated":false},{"path":"extensions/jfr/deployment/src/test/java/io/quarkus/jfr/deployment/http/JfrRestClientTest.java","lines":["@@ -0,0 +1,167 @@","+package io.quarkus.jfr.deployment.http;","+","+import static io.restassured.RestAssured.when;","+import static org.assertj.core.api.Assertions.assertThat;","+import static org.hamcrest.Matchers.is;","+","+import java.io.IOException;","+import java.nio.file.Files;","+import java.time.Duration;","+import java.util.List;","+","+import jakarta.ws.rs.GET;","+import jakarta.ws.rs.Path;","+import jakarta.ws.rs.PathParam;","+import jakarta.ws.rs.ProcessingException;","+import jakarta.ws.rs.Produces;","+import jakarta.ws.rs.core.MediaType;","+","+import org.eclipse.microprofile.rest.client.inject.RegisterRestClient;","+import org.eclipse.microprofile.rest.client.inject.RestClient;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.test.QuarkusExtensionTest;","+import io.smallrye.mutiny.Multi;","+import jdk.jfr.Recording;","+import jdk.jfr.consumer.RecordedEvent;","+import jdk.jfr.consumer.RecordingFile;","+","+public class JfrRestClientTest {","+","+    @RegisterExtension","+    static final QuarkusExtensionTest TEST = new QuarkusExtensionTest()","+            .withApplicationRoot((jar) -> jar","+                    .addClasses(Resource.class, HelloClient.class, UnreachableClient.class, StreamingClient.class))","+            .overrideConfigKey(\"quarkus.rest-client.hello.url\", \"${test.url}\")","+            .overrideConfigKey(\"quarkus.rest-client.unreachable.url\", \"http://localhost:1\")","+            .overrideConfigKey(\"quarkus.rest-client.streaming.url\", \"${test.url}\");","+","+    @Test","+    public void test() throws IOException {","+        final java.nio.file.Path dumpPath = java.nio.file.Path.of(\"./dump.jfr\");","+        try {","+            try (Recording r = new Recording()) {","+                r.start();","+","+                // 1) server resource /exercise calls HelloClient#hello(\"world\") -> GET /hello/world on this server","+                when().get(\"/exercise\").then().statusCode(200).body(is(\"Hello world\"));","+                // 2) server resource /exercise-failure calls UnreachableClient#hello(\"world\") -> GET http://localhost:1/hello/world,","+                // the connection is refused and the resource swallows the ProcessingException","+                when().get(\"/exercise-failure\").then().statusCode(200).body(is(\"failed\"));","+                // 3) server resource /exercise-stream calls StreamingClient#stream() -> GET /stream, consumed as an SSE Multi","+                when().get(\"/exercise-stream\").then().statusCode(200).body(is(\"a,b,c\"));","+","+                r.stop();","+                r.dump(dumpPath);","+            }","+            List<RecordedEvent> recordedEvents = RecordingFile.readAllEvents(dumpPath);","+","+            List<RecordedEvent> clientEvents = recordedEvents.stream()","+                    .filter(e -> e.getEventType().getName().equals(\"quarkus.RestClient\")).toList();","+            // only 1) and 2) produce an event, the streaming invocation 3) is not recorded","+            assertThat(clientEvents).hasSize(2);","+","+            // 1) the successful call: GET /hello/world made by the \"hello\" client","+            RecordedEvent success = clientEvents.stream().filter(e -> e.getInt(\"status\") == 200).findFirst().orElseThrow();","+            assertThat(success.getString(\"httpMethod\")).isEqualTo(\"GET\");","+            // the URI is the @Path template of HelloClient#hello, not the concrete /hello/world path","+            assertThat(success.getString(\"uri\")).isEqualTo(\"/hello/{name}\");","+            assertThat(success.getString(\"address\")).startsWith(\"localhost:\");","+            assertThat(success.getString(\"clientName\")).isEqualTo(\"hello\");","+            assertThat(success.getString(\"failure\")).isNull();","+            assertThat(success.getDuration()).isPositive();","+","+            // the client event shares the trace ID of the quarkus.Rest server event for GET /exercise that triggered it","+            RecordedEvent server = recordedEvents.stream()","+                    .filter(e -> e.getEventType().getName().equals(\"quarkus.Rest\"))","+                    .filter(e -> e.getString(\"uri\").equals(\"/exercise\"))","+                    .findFirst().orElseThrow();","+            assertThat(success.getString(\"traceId\")).isNotNull().isEqualTo(server.getString(\"traceId\"));","+","+            // 2) the failed call: GET http://localhost:1/hello/world made by the \"unreachable\" client, no response received","+            RecordedEvent failure = clientEvents.stream().filter(e -> e.getInt(\"status\") == 0).findFirst().orElseThrow();","+            assertThat(failure.getString(\"httpMethod\")).isEqualTo(\"GET\");","+            // the @Path template is recorded even though the request never reached a server","+            assertThat(failure.getString(\"uri\")).isEqualTo(\"/hello/{name}\");","+            assertThat(failure.getString(\"address\")).isEqualTo(\"localhost:1\");","+            assertThat(failure.getString(\"clientName\")).isEqualTo(\"unreachable\");","+            assertThat(failure.getString(\"failure\")).contains(\"ConnectException\");","+        } finally {","+            Files.deleteIfExists(dumpPath);","+        }","+    }","+","+    @RegisterRestClient(configKey = \"hello\")","+    public interface HelloClient {","+","+        @GET","+        @Path(\"/hello/{name}\")","+        String hello(@PathParam(\"name\") String name);","+    }","+","+    @RegisterRestClient(configKey = \"unreachable\")","+    public interface UnreachableClient {","+","+        @GET","+        @Path(\"/hello/{name}\")","+        String hello(@PathParam(\"name\") String name);","+    }","+","+    @RegisterRestClient(configKey = \"streaming\")","+    public interface StreamingClient {","+","+        @GET","+        @Path(\"/stream\")","+        @Produces(MediaType.SERVER_SENT_EVENTS)","+        Multi<String> stream();","+    }","+","+    @Path(\"/\")","+    public static class Resource {","+","+        @RestClient","+        HelloClient helloClient;","+","+        @RestClient","+        UnreachableClient unreachableClient;","+","+        @RestClient","+        StreamingClient streamingClient;","+","+        @GET","+        @Path(\"/hello/{name}\")","+        public String hello(@PathParam(\"name\") String name) {","+            return \"Hello \" + name;","+        }","+","+        @GET","+        @Path(\"/stream\")","+        @Produces(MediaType.SERVER_SENT_EVENTS)","+        public Multi<String> stream() {","+            return Multi.createFrom().items(\"a\", \"b\", \"c\");","+        }","+","+        @GET","+        @Path(\"/exercise\")","+        public String exercise() {","+            return helloClient.hello(\"world\");","+        }","+","+        @GET","+        @Path(\"/exercise-failure\")","+        public String exerciseFailure() {","+            try {","+                return unreachableClient.hello(\"world\");","+            } catch (ProcessingException e) {","+                return \"failed\";","+            }","+        }","+","+        @GET","+        @Path(\"/exercise-stream\")","+        public String exerciseStream() {","+            return String.join(\",\", streamingClient.stream().collect().asList().await().atMost(Duration.ofSeconds(5)));","+        }","+    }","+}"],"additions":167,"deletions":0,"truncated":false},{"path":"extensions/jfr/runtime/pom.xml","lines":["@@ -25,6 +25,11 @@","             <artifactId>quarkus-rest</artifactId>","             <scope>provided</scope>","         </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-rest-client</artifactId>","+            <scope>provided</scope>","+        </dependency>"," ","         <!-- Optional Dependencies-->","         <dependency>"],"additions":5,"deletions":0,"truncated":false},{"path":"extensions/jfr/runtime/src/main/java/io/quarkus/jfr/runtime/internal/JfrRecorder.java","lines":["@@ -9,6 +9,7 @@"," import io.quarkus.jfr.runtime.internal.http.rest.RestEndEvent;"," import io.quarkus.jfr.runtime.internal.http.rest.RestPeriodEvent;"," import io.quarkus.jfr.runtime.internal.http.rest.RestStartEvent;","+import io.quarkus.jfr.runtime.internal.http.rest.client.RestClientPeriodEvent;"," import io.quarkus.jfr.runtime.internal.runtime.QuarkusRuntimeInfo;"," import io.quarkus.runtime.ImageMode;"," import io.quarkus.runtime.RuntimeValue;","@@ -36,6 +37,10 @@ public void runtimeInit() {","                 logger.info(\"quarkus-jfr for REST server is disabled at runtime\");","                 this.disabledRestJfr();","             }","+            if (!runtimeConfig.getValue().restClientEnabled()) {","+                logger.info(\"quarkus-jfr for REST Client is disabled at runtime\");","+                this.disabledRestClientJfr();","+            }","         }","     }"," ","@@ -45,8 +50,13 @@ public void disabledRestJfr() {","         FlightRecorder.unregister(RestPeriodEvent.class);","     }"," ","+    public void disabledRestClientJfr() {","+        FlightRecorder.unregister(RestClientPeriodEvent.class);","+    }","+","     public void disabledQuarkusJfr() {","         this.disabledRestJfr();","+        this.disabledRestClientJfr();","     }"," ","     public Supplier<QuarkusRuntimeInfo> quarkusInfoSupplier(String version, List<String> features) {"],"additions":10,"deletions":0,"truncated":false},{"path":"extensions/jfr/runtime/src/main/java/io/quarkus/jfr/runtime/internal/config/JfrRuntimeConfig.java","lines":["@@ -28,6 +28,16 @@ public interface JfrRuntimeConfig {","     @WithDefault(\"true\")","     boolean restEnabled();"," ","+    /**","+     * If false, only REST Client events in quarkus-jfr are not recorded even if JFR is enabled.","+     * In this case, other quarkus-jfr, Java standard API and virtual machine information will be recorded according to the","+     * setting.","+     * Default value is <code>true</code>","+     */","+    @WithName(\"rest-client.enabled\")","+    @WithDefault(\"true\")","+    boolean restClientEnabled();","+","     /**","      * If false, only Runtime events in quarkus-jfr are not recorded even if JFR is enabled.","      * In this case, other quarkus-jfr, Java standard API and virtual machine information will be recorded according to the"],"additions":10,"deletions":0,"truncated":false},{"path":"extensions/jfr/runtime/src/main/java/io/quarkus/jfr/runtime/internal/http/rest/client/RestClientFilter.java","lines":["@@ -0,0 +1,99 @@","+package io.quarkus.jfr.runtime.internal.http.rest.client;","+","+import java.net.URI;","+","+import jakarta.ws.rs.ProcessingException;","+import jakarta.ws.rs.client.ClientResponseContext;","+import jakarta.ws.rs.ext.Provider;","+","+import org.jboss.resteasy.reactive.client.impl.RestClientRequestContext;","+import org.jboss.resteasy.reactive.client.spi.ResteasyReactiveClientRequestContext;","+import org.jboss.resteasy.reactive.client.spi.ResteasyReactiveClientRequestFilter;","+import org.jboss.resteasy.reactive.client.spi.ResteasyReactiveClientResponseFilter;","+","+import io.quarkus.arc.Arc;","+import io.quarkus.jfr.api.IdProducer;","+import io.vertx.core.http.HttpClientOptions;","+","+/**","+ * Records a {@link RestClientPeriodEvent} for every REST Client invocation.","+ * <p>","+ * The event is started before the request is sent and committed once the response has been received","+ * or the request has failed. Streaming responses (Multi, SSE) are not recorded as their duration is","+ * not well-defined.","+ */","+@Provider","+public class RestClientFilter implements ResteasyReactiveClientRequestFilter, ResteasyReactiveClientResponseFilter {","+","+    private static final String JFR_EVENT_PROPERTY = \"quarkus.jfr.restClientEvent\";","+    private static final String URL_PATH_TEMPLATE_PROPERTY = \"UrlPathTemplate\";","+    private static final String CLIENT_NAME_SEPARATOR = \"|\";","+","+    private final IdProducer idProducer;","+","+    public RestClientFilter(IdProducer idProducer) {","+        this.idProducer = idProducer;","+    }","+","+    @Override","+    public void filter(ResteasyReactiveClientRequestContext requestContext) {","+        // streaming invocations (Multi, SSE) do not register a body handler as the body is consumed as it arrives","+        if (!requestContext.unwrap(RestClientRequestContext.class).isRegisterBodyHandler()) {","+            return;","+        }","+        RestClientPeriodEvent event = new RestClientPeriodEvent();","+        // the IDs are captured now because the request scope is not active anymore when the response arrives","+        if (Arc.container().requestContext().isActive()) {","+            event.traceId = idProducer.getTraceId();","+            event.spanId = idProducer.getSpanId();","+        }","+        event.begin();","+        requestContext.setProperty(JFR_EVENT_PROPERTY, event);","+    }","+","+    @Override","+    public void filter(ResteasyReactiveClientRequestContext requestContext, ClientResponseContext responseContext) {","+        RestClientPeriodEvent event = (RestClientPeriodEvent) requestContext.getProperty(JFR_EVENT_PROPERTY);","+        if (event == null) {","+            return;","+        }","+        event.end();","+        if (!event.shouldCommit()) {","+            return;","+        }","+        event.httpMethod = requestContext.getMethod();","+        URI uri = requestContext.getUri();","+        String pathTemplate = (String) requestContext.getProperty(URL_PATH_TEMPLATE_PROPERTY);","+        event.uri = pathTemplate != null ? pathTemplate : uri.getPath();","+        event.address = uri.getPort() > 0 ? uri.getHost() + \":\" + uri.getPort() : uri.getHost();","+        event.clientName = clientName(requestContext);","+        event.status = responseContext.getStatus();","+        event.failure = effectiveFailureClassName(requestContext);","+        event.commit();","+    }","+","+    private static String clientName(ResteasyReactiveClientRequestContext requestContext) {","+        HttpClientOptions httpClientOptions = requestContext.unwrap(HttpClientOptions.class);","+        if (httpClientOptions == null) {","+            return null;","+        }","+        // the REST Client sets the metrics name to \"rest-client|<configKey>\"","+        String metricsName = httpClientOptions.getMetricsName();","+        if (metricsName == null || !metricsName.contains(CLIENT_NAME_SEPARATOR)) {","+            return null;","+        }","+        return metricsName.substring(metricsName.indexOf(CLIENT_NAME_SEPARATOR) + 1);","+    }","+","+    private static String effectiveFailureClassName(ResteasyReactiveClientRequestContext requestContext) {","+        Throwable throwable = requestContext.unwrap(RestClientRequestContext.class).getThrowable();","+        if (throwable == null) {","+            return null;","+        }","+        // the actual I/O failure is more informative than the ProcessingException wrapping it","+        if (throwable instanceof ProcessingException && throwable.getCause() != null) {","+            throwable = throwable.getCause();","+        }","+        return throwable.getClass().getName();","+    }","+}"],"additions":99,"deletions":0,"truncated":false},{"path":"extensions/jfr/runtime/src/main/java/io/quarkus/jfr/runtime/internal/http/rest/client/RestClientPeriodEvent.java","lines":["@@ -0,0 +1,52 @@","+package io.quarkus.jfr.runtime.internal.http.rest.client;","+","+import io.quarkus.jfr.api.SpanIdRelational;","+import io.quarkus.jfr.api.TraceIdRelational;","+import jdk.jfr.Category;","+import jdk.jfr.Description;","+import jdk.jfr.Event;","+import jdk.jfr.Label;","+import jdk.jfr.Name;","+import jdk.jfr.StackTrace;","+","+@Label(\"REST Client\")","+@Category({ \"Quarkus\", \"HTTP\" })","+@Name(\"quarkus.RestClient\")","+@Description(\"REST Client has been invoking a remote endpoint during this period\")","+@StackTrace(false)","+public class RestClientPeriodEvent extends Event {","+","+    @Label(\"Trace ID\")","+    @Description(\"Trace ID to identify the request\")","+    @TraceIdRelational","+    String traceId;","+","+    @Label(\"Span ID\")","+    @Description(\"Span ID to identify the request if necessary\")","+    @SpanIdRelational","+    String spanId;","+","+    @Label(\"HTTP Method\")","+    @Description(\"HTTP Method of the outgoing request\")","+    String httpMethod;","+","+    @Label(\"URI\")","+    @Description(\"URI path template of the invoked REST Client method, or the URI path if no template is available\")","+    String uri;","+","+    @Label(\"Address\")","+    @Description(\"Host and port of the remote endpoint\")","+    String address;","+","+    @Label(\"Client Name\")","+    @Description(\"Config key of the REST Client that sent the request\")","+    String clientName;","+","+    @Label(\"Status\")","+    @Description(\"HTTP status code of the response, or 0 if no response was received\")","+    int status;","+","+    @Label(\"Failure\")","+    @Description(\"Class name of the exception if the request failed\")","+    String failure;","+}"],"additions":52,"deletions":0,"truncated":false},{"path":"extensions/resteasy-reactive/rest-client-jaxrs/deployment/src/main/java/io/quarkus/jaxrs/client/reactive/deployment/JaxrsClientReactiveProcessor.java","lines":["@@ -424,6 +424,7 @@ public void accept(EndpointIndexer.ResourceMethodCallbackEntry entry) {","                 .build();"," ","         boolean observabilityIntegrationNeeded = (capabilities.isPresent(Capability.OPENTELEMETRY_TRACER) ||","+                capabilities.isPresent(Capability.JFR) ||","                 (metricsCapability.isPresent()","                         && metricsCapability.get().metricsSupported(MetricsFactory.MICROMETER)));"," "],"additions":1,"deletions":0,"truncated":false},{"path":"independent-projects/resteasy-reactive/client/runtime/src/main/java/org/jboss/resteasy/reactive/client/impl/ClientRequestContextImpl.java","lines":["@@ -106,11 +106,11 @@ public void setCallStatsCollector(ServiceInstance statCollectingServiceInstance)","     @Override","     public <T> T unwrap(Class<T> theType) {","         if (theType == RestClientRequestContext.class) {","-            return (T) restClientRequestContext;","+            return theType.cast(restClientRequestContext);","         } else if (theType == HttpClientRequest.class) {","-            return (T) restClientRequestContext.getHttpClientRequest();","+            return theType.cast(restClientRequestContext.getHttpClientRequest());","         } else if (theType == HttpClientOptions.class) {","-            return (T) restClientRequestContext.getHttpClientOptions();","+            return theType.cast(restClientRequestContext.getHttpClientOptions());","         }","         return null;","     }",""],"additions":3,"deletions":3,"truncated":false}],"additions":424,"deletions":4,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-10-14T13:05:50.663565+00:00"}