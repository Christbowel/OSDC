{"id":"b81ab83696c3175fb7d76f1ddd9431b2a39c1393","axis":"silent","repo":"pnpm/pnpm","sha":"b81ab83696c3175fb7d76f1ddd9431b2a39c1393","parsed":{"files":[{"path":".changeset/pnpr-scope-verdict-cache-and-grant-invalidation.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+`POST /-/pnpr/v0/verify-lockfile` and `POST /-/pnpr/v0/resolve` now enforce caller read permissions for every private route recorded in a cached lockfile verdict. Updating grants through the admin API now invalidates cached resolutions and lockfile verdicts immediately. A running server applies a `pnpr grants import` within about 10 seconds."],"additions":5,"deletions":0,"truncated":false},{"path":"Cargo.lock","lines":["@@ -7496,6 +7496,8 @@ dependencies = [","  \"pnpr-policy\",","  \"pnpr-registry\",","  \"reqwest\",","+ \"serde\",","+ \"serde_json\",","  \"sha2 0.10.9\",","  \"tracing\",","  \"url\","],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/cache_maintenance/sqlite.rs","lines":["@@ -116,8 +116,8 @@ fn estimate_expired_verdict_bytes(verdict: &AnchoredVerdictDb, cutoff_ms: i64) -"," fn query_verdict_weights(conn: &Connection, cutoff_ms: i64) -> (u64, u64) {","     conn.query_row(","         \"SELECT","-             COALESCE(SUM(CASE WHEN verified_at_ms <= ?1 THEN 2 * LENGTH(hash) + LENGTH(policy) + 24 ELSE 0 END), 0),","-             COALESCE(SUM(2 * LENGTH(hash) + LENGTH(policy) + 24), 0)","+             COALESCE(SUM(CASE WHEN verified_at_ms <= ?1 THEN 2 * (LENGTH(hash) + LENGTH(footprint_key)) + LENGTH(footprint) + LENGTH(policy) + LENGTH(epoch) + 24 ELSE 0 END), 0),","+             COALESCE(SUM(2 * (LENGTH(hash) + LENGTH(footprint_key)) + LENGTH(footprint) + LENGTH(policy) + LENGTH(epoch) + 24), 0)","          FROM lockfile_verdicts\",","         [cutoff_ms],","         |row| {","@@ -284,7 +284,7 @@ fn execute_verdict_trim(conn: &Connection, live_reclaimable: u64, needed_from_ro"," fn load_row_weights(conn: &Connection, floor_ms: i64) -> Option<Vec<u64>> {","     let mut stmt = conn","         .prepare(","-            \"SELECT 2 * LENGTH(hash) + LENGTH(policy) + 24","+            \"SELECT 2 * (LENGTH(hash) + LENGTH(footprint_key)) + LENGTH(footprint) + LENGTH(policy) + LENGTH(epoch) + 24","              FROM lockfile_verdicts","              WHERE verified_at_ms > ?1","              ORDER BY verified_at_ms ASC, rowid ASC\","],"additions":3,"deletions":3,"truncated":false},{"path":"pnpr/crates/pnpr/src/resolver.rs","lines":["@@ -158,13 +158,19 @@ pub(crate) struct ResolverShared {"," }"," "," impl ResolverShared {","-    /// Drop every cached resolution. Called when the registry graph changes:","-    /// a resolution may have read a name the new graph routes elsewhere.","+    /// Drop every cached resolution and lockfile verdict. Called when the","+    /// registry graph or its grants change: a resolution or verdict cached as","+    /// public under the previous policy may depend on a route the new one","+    /// restricts or routes elsewhere.","     pub(crate) fn forget_results(&self) {","+        self.cache.generation.fetch_add(1, std::sync::atomic::Ordering::AcqRel);","         self.cache.entries","             .lock()","             .unwrap_or_else(std::sync::PoisonError::into_inner)","             .clear();","+        if let Some(verdicts) = self.cache.verdicts.as_ref() {","+            verdicts.clear();","+        }","     }"," ","     fn new(config: &RegistryConfig) -> Self {","@@ -197,6 +203,10 @@ struct ResolverCache {","     verdicts: Option<VerdictCache>,","     /// HMAC secret namespacing a private footprint's cache descriptor.","     secret: Arc<[u8]>,","+    /// Monotonic counter incremented by [`ResolverShared::forget_results`], so","+    /// an in-flight resolve started before a grant or graph change cannot","+    /// populate the post-change cache namespace when it finishes.","+    generation: std::sync::atomic::AtomicU64,"," }"," "," struct IndexCache {","@@ -225,6 +235,7 @@ impl ResolverCache {","             ttl: config.http.packument_ttl,","             verdicts: verdict_cache,","             secret: Arc::clone(&config.resolution_cache_secret),","+            generation: std::sync::atomic::AtomicU64::new(0),","         }","     }"," ","@@ -330,9 +341,21 @@ impl Resolver {","         }","     }"," ","-    /// `key`, a resolution cache key, scoped to this engine's graph.","+    pub(super) fn cache_generation(&self) -> u64 {","+        self.cache.generation.load(std::sync::atomic::Ordering::Acquire)","+    }","+","+    /// `key`, a resolution cache key, scoped to this engine's graph and the","+    /// active invalidation `generation`.","+    pub(super) fn scoped_cache_key(&self, generation: u64, key: &str) -> String {","+        format!(\"{}:{generation}:{key}\", self.graph_epoch)","+    }","+","+    /// `key`, a resolution cache key, scoped to this engine's graph and","+    /// current invalidation generation.","+    #[cfg(test)]","     fn graph_cache_key(&self, key: &str) -> String {","-        format!(\"{}:{key}\", self.graph_epoch)","+        self.scoped_cache_key(self.cache_generation(), key)","     }"," ","     /// Where `registry`'s Cargo sparse-index files are cached. The origin"],"additions":27,"deletions":4,"truncated":false},{"path":"pnpr/crates/pnpr/src/resolver/dispatch.rs","lines":["@@ -131,7 +131,7 @@ async fn resolve_npm_request(","             Ok(inputs) => inputs,","             Err(response) => return response,","         };","-    let verified_dist_stats = match verify_request_lockfile(runtime, &inputs).await {","+    let verified_dist_stats = match verify_request_lockfile(runtime, &identity, &inputs).await {","         Ok(stats) => stats,","         Err(response) => return response,","     };","@@ -162,12 +162,17 @@ fn short_circuit_npm_resolve(","     ) {","         return Some(within_deadline(response, inputs.deadline));","     }","-    inputs.cache_key =","-        resolution_cache_key(&inputs.request).map(|key| runtime.graph_cache_key(&key));","+    let generation = match inputs.cache_scope {","+        super::streaming::CacheScope::Pending(generation) => generation,","+        super::streaming::CacheScope::Key(_) => runtime.cache_generation(),","+    };","+    let key = resolution_cache_key(&inputs.request)","+        .map(|raw_key| runtime.scoped_cache_key(generation, &raw_key));","+    inputs.cache_scope = super::streaming::CacheScope::Key(key);","     cached_resolution_response(","         runtime,","         identity,","-        inputs.cache_key.as_ref(),","+        inputs.cache_scope.key(),","         &inputs.request,","         inputs.deadline,","     )","@@ -198,6 +203,7 @@ async fn prepare_npm_resolve(","     // forwarded from the client. Every metadata/tarball fetch the","     // resolve+verify performs records its route into `footprint`, which","     // then decides whether the resolution may populate the shared cache.","+    let cache_scope = super::streaming::CacheScope::Pending(runtime.cache_generation());","     let footprint = Arc::new(Mutex::new(Footprint::default()));","     let request_auth = runtime.hooked_auth(&request, identity, &footprint);","     let tarball_router = request_tarball_router(runtime, identity, &config);","@@ -207,7 +213,7 @@ async fn prepare_npm_resolve(","         request_auth,","         tarball_router,","         footprint,","-        cache_key: None,","+        cache_scope,","         permit: Arc::new(permit),","         deadline,","     })"],"additions":11,"deletions":5,"truncated":false},{"path":"pnpr/crates/pnpr/src/resolver/streaming.rs","lines":["@@ -61,13 +61,27 @@ impl TerminalSender {","     }"," }"," ","+pub(super) enum CacheScope {","+    Pending(u64),","+    Key(Option<String>),","+}","+","+impl CacheScope {","+    pub(super) fn key(&self) -> Option<&String> {","+        match self {","+            CacheScope::Pending(_) => None,","+            CacheScope::Key(key) => key.as_ref(),","+        }","+    }","+}","+"," pub(super) struct StreamedResolveInputs {","     pub(super) config: ActiveConfig,","     pub(super) request: ResolveRequest,","     pub(super) request_auth: Arc<AuthHeaders>,","     pub(super) tarball_router: TarballRouter,","     pub(super) footprint: Arc<Mutex<Footprint>>,","-    pub(super) cache_key: Option<String>,","+    pub(super) cache_scope: CacheScope,","     pub(super) permit: Arc<ResolvePermit>,","     pub(super) deadline: Instant,"," }","@@ -338,7 +352,7 @@ impl ResolutionFinalizer {","             Err(error_frame) => return Some(error_frame),","         };","         if !cancel.is_cancelled()","-            && let Some(key) = self.inputs.cache_key.clone()","+            && let Some(key) = self.inputs.cache_scope.key().cloned()","         {","             self.store_candidate(key, &lockfile);","         }"],"additions":16,"deletions":2,"truncated":false},{"path":"pnpr/crates/pnpr/src/resolver/tests/authorization.rs","lines":["@@ -222,3 +222,152 @@ fn reject_inline_url_auth_scans_catalogs() {","     // gate still decides whether the host may be fetched at all).","     assert!(reject_inline_url_auth(&ssh_catalog).is_none());"," }","+","+#[tokio::test]","+async fn warm_resolve_retains_private_footprint_from_verdict_cache_hit() {","+    use crate::resolver::{","+        Resolver,","+        dispatch::handle_resolve,","+        resolution_cache_key,","+        verdict_cache::{VerdictLookup, VerdictRecord},","+        verify_lockfile::handle_verify_lockfile,","+    };","+    use axum::body::{Bytes, to_bytes};","+    use pnpm_lockfile_verification::hash_lockfile;","+    use pnpr_config::{IpNetwork, PublicRoute};","+    use serde_json::json;","+    use tokio::{","+        io::{AsyncReadExt as _, AsyncWriteExt as _},","+        net::TcpListener,","+    };","+","+    let listener = TcpListener::bind(\"127.0.0.1:0\").await.unwrap();","+    let origin = format!(\"http://{}\", listener.local_addr().unwrap());","+    let server_origin = origin.clone();","+    let server = tokio::spawn(async move {","+        while let Ok((mut socket, _)) = listener.accept().await {","+            let mut buf = [0_u8; 512];","+            let read = socket.read(&mut buf).await.unwrap_or(0);","+            let head = String::from_utf8_lossy(&buf[..read]);","+            let name = if head.contains(\"public-dep\") { \"public-dep\" } else { \"@private/pkg\" };","+            let packument = json!({","+                \"name\": name,","+                \"dist-tags\": { \"latest\": \"1.0.0\" },","+                \"versions\": {","+                    \"1.0.0\": {","+                        \"name\": name,","+                        \"version\": \"1.0.0\",","+                        \"dist\": {","+                            \"tarball\": format!(\"{server_origin}/pkg.tgz\"),","+                            \"integrity\": ssri::Integrity::from(b\"pkg-bytes\").to_string(),","+                        },","+                    },","+                },","+            })","+            .to_string();","+            let reply = format!(","+                \"HTTP/1.1 200 OK\\r\\nContent-Type: application/json\\r\\nContent-Length: {}\\r\\nConnection: close\\r\\n\\r\\n{packument}\",","+                packument.len(),","+            );","+            let _ = socket.write_all(reply.as_bytes()).await;","+        }","+    });","+","+    let dir = tempfile::tempdir().unwrap();","+    let mut config = registry_config();","+    config.storage.cache_dir = dir.path().to_path_buf();","+    config.http.public_url = \"http://example.test\".into();","+    config.routing.route_policy.public.push(PublicRoute {","+        registry: Some(format!(\"{origin}/\")),","+        package: None,","+    });","+    config.routing.route_policy.allowed_private_networks =","+        vec![IpNetwork::parse(\"127.0.0.0/8\").unwrap()];","+    set_local_hosted_rules(&mut config, \"@private/*\", \"alice\");","+    let resolver = Resolver::build(&config, None);","+","+    let input_lockfile = package_lockfile(\"@private/pkg\", \"1.0.0\");","+    let payload = json!({","+        \"registry\": format!(\"{origin}/\"),","+        \"dependencies\": { \"@private/pkg\": \"^1.0.0\", \"public-dep\": \"^1.0.0\" },","+        \"lockfile\": input_lockfile,","+        \"frozenLockfile\": false,","+        \"trustPolicy\": \"off\",","+        \"minimumReleaseAge\": 0,","+    });","+    let request: ResolveRequest = serde_json::from_value(payload.clone()).unwrap();","+    let verified =","+        handle_verify_lockfile(&resolver, user(\"alice\"), Bytes::from(payload.to_string())).await;","+    assert_eq!(verified.status(), StatusCode::OK);","+","+    let hash = hash_lockfile(","+        &tarball_router(&config, user(\"alice\"))","+            .verification_lockfile(request.lockfile.as_ref().unwrap()),","+    );","+    let epoch = resolver.local_registry.verdict_epoch().expect(\"stable epoch\");","+    let verdicts = resolver.cache.verdicts.as_ref().expect(\"verdict cache\");","+    let captured_policy = std::cell::RefCell::new(None);","+    assert!(","+        verdicts","+            .verified_footprint(","+                &VerdictLookup {","+                    hash: &hash,","+                    epoch: &epoch,","+                    secret: &resolver.cache.secret,","+                    route_context: &resolver.route_context,","+                    identity: &user(\"alice\"),","+                },","+                |policy| {","+                    *captured_policy.borrow_mut() = Some(policy.clone());","+                    true","+                },","+            )","+            .is_some(),","+    );","+    let expected_footprint = private_hosted_footprint(\"local\", \"@private/pkg\");","+    verdicts.clear();","+    verdicts.record(VerdictRecord {","+        hash: &hash,","+        footprint: &expected_footprint,","+        secret: &resolver.cache.secret,","+        epoch: &epoch,","+        policy: captured_policy.into_inner().expect(\"policy recorded\"),","+    });","+","+    let response = handle_resolve(&resolver, user(\"alice\"), Bytes::from(payload.to_string())).await;","+    assert_eq!(response.status(), StatusCode::OK);","+    let body =","+        String::from_utf8(to_bytes(response.into_body(), usize::MAX).await.unwrap().to_vec())","+            .unwrap();","+    assert!(body.contains(r#\"\"type\":\"done\"\"#), \"{body}\");","+","+    let raw_key = resolution_cache_key(&request).expect(\"cacheable request\");","+    let key = resolver.scoped_cache_key(resolver.cache_generation(), &raw_key);","+    {","+        let entries = resolver.cache.entries.lock().unwrap();","+        let candidates = entries.get(&key).expect(\"warm resolution cached\");","+        assert_eq!(candidates.len(), 1);","+        assert_eq!(candidates[0].footprint, expected_footprint);","+    }","+    assert!(","+        cached_resolution(","+            &resolver.cache.entries,","+            resolver.cache.ttl,","+            &key,","+            &resolver.route_context,","+            &user(\"alice\"),","+        )","+        .is_some(),","+    );","+    assert!(","+        cached_resolution(","+            &resolver.cache.entries,","+            resolver.cache.ttl,","+            &key,","+            &resolver.route_context,","+            &user(\"bob\"),","+        )","+        .is_none(),","+    );","+    server.abort();","+}"],"additions":149,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/resolver/tests/bounds_review_round2.rs","lines":["@@ -32,7 +32,7 @@ use super::{","         protocol::{AppliedPolicies, ResolveRequest},","         request_tarball_router, serve_resolve_request,","         streaming::{","-            StreamCacheTarget, StreamedResolve, StreamedResolveInputs, TerminalSender,","+            CacheScope, StreamCacheTarget, StreamedResolve, StreamedResolveInputs, TerminalSender,","             finish_before_deadline,","         },","         wire::{StreamObserver, try_done_frame_until},","@@ -341,7 +341,7 @@ async fn finish_before_deadline_drops_sender_for_immediate_eof_and_skips_cache_o","             request_auth,","             tarball_router,","             footprint,","-            cache_key: Some(\"timed-out-key\".to_string()),","+            cache_scope: CacheScope::Key(Some(\"timed-out-key\".to_string())),","             permit: Arc::new(permit),","             deadline: expired_deadline,","         },"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpr/crates/pnpr/src/resolver/tests/graph_swap.rs","lines":["@@ -48,3 +48,89 @@ async fn a_resolution_cached_under_one_graph_is_not_served_under_the_next() {","     assert!(store(&key), \"a resolution still running under the old graph finishes\");","     assert!(!cached(&next_key, next_engine), \"and stays out of the new graph's key\");"," }","+","+#[tokio::test]","+async fn forget_results_clears_verdicts_and_rotates_cache_generation() {","+    use crate::resolver::verdict_cache::{VerdictLookup, VerdictRecord};","+","+    let tmp = tempfile::tempdir().unwrap();","+    let path = tmp.path().join(\"pnpr.yaml\");","+    std::fs::write(","+        &path,","+        \"storage: ./store\\nregistries:\\n  npmjs:\\n    type: upstream\\n    url: https://registry.npmjs.org/\\n    public: true\\ndefaultRegistry: npmjs\\n\",","+    )","+    .unwrap();","+    let config = pnpr_fixtures::load_seeded_config(&path, \"127.0.0.1:0\".parse().unwrap(), None);","+    let state = crate::server::state_and_router(config, AuthState::in_memory(), None).unwrap().0;","+    let ttl = Duration::from_mins(1);","+    let routing = state.inner.current_routing();","+    let engine = state.test_resolver(&routing);","+    let before_key = engine.graph_cache_key(\"request\");","+","+    assert!(store_resolution(","+        &engine.cache.entries,","+        ttl,","+        before_key.clone(),","+        Footprint::default(),","+        b\"secret\",","+        &lockfile(\"1.0.0\"),","+    ));","+    let verdicts = engine.cache.verdicts.as_ref().expect(\"verdict cache opened\");","+    let public_footprint = Footprint::default();","+    let epoch = engine.local_registry.verdict_epoch().expect(\"stable epoch\");","+    verdicts.record(VerdictRecord {","+        hash: \"hash-1\",","+        footprint: &public_footprint,","+        secret: &engine.cache.secret,","+        epoch: &epoch,","+        policy: serde_json::Map::new(),","+    });","+    let lookup = VerdictLookup {","+        hash: \"hash-1\",","+        epoch: &epoch,","+        secret: &engine.cache.secret,","+        route_context: &engine.route_context,","+        identity: &Identity::Anonymous,","+    };","+    assert!(verdicts.verified_footprint(&lookup, |_| true).is_some());","+","+    state.test_with_grant_transition(|| {","+        assert_eq!(engine.local_registry.verdict_epoch(), None);","+    });","+    assert_eq!(engine.local_registry.verdict_epoch().as_deref(), Some(epoch.as_str()));","+","+    state.test_forget_resolver_results();","+","+    let after_key = engine.graph_cache_key(\"request\");","+    assert_ne!(before_key, after_key, \"forget_results advances the cache generation\");","+    assert!(","+        cached_resolution(","+            &engine.cache.entries,","+            ttl,","+            &before_key,","+            &engine.route_context,","+            &Identity::Anonymous,","+        )","+        .is_none(),","+    );","+    assert!(verdicts.verified_footprint(&lookup, |_| true).is_none());","+","+    assert!(store_resolution(","+        &engine.cache.entries,","+        ttl,","+        before_key,","+        Footprint::default(),","+        b\"secret\",","+        &lockfile(\"1.0.0\"),","+    ));","+    assert!(","+        cached_resolution(","+            &engine.cache.entries,","+            ttl,","+            &after_key,","+            &engine.route_context,","+            &Identity::Anonymous,","+        )","+        .is_none(),","+    );","+}"],"additions":86,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/resolver/tests/refresh_bounds.rs","lines":["@@ -26,7 +26,7 @@ use super::{","         protocol::ResolveRequest,","         request_tarball_router,","         streaming::{","-            StreamCacheTarget, StreamedResolve, StreamedResolveInputs, TerminalSender,","+            CacheScope, StreamCacheTarget, StreamedResolve, StreamedResolveInputs, TerminalSender,","             stream_resolution,","         },","         wire::StreamObserver,","@@ -214,7 +214,7 @@ fn build_post_fetch_cancel_task(","             request_auth,","             tarball_router: router,","             footprint,","-            cache_key: Some(\"peer-cancel-key\".to_string()),","+            cache_scope: CacheScope::Key(Some(\"peer-cancel-key\".to_string())),","             permit: Arc::new(permit),","             deadline,","         },"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpr/crates/pnpr/src/resolver/tests/streaming.rs","lines":["@@ -1,7 +1,7 @@"," use super::{Arc, Identity, Mutex, ResolveRequest, deps};"," use crate::resolver::{","     Resolver, request_tarball_router,","-    streaming::{StreamedResolveInputs, send_keepalives, stream_resolve_response},","+    streaming::{CacheScope, StreamedResolveInputs, send_keepalives, stream_resolve_response},"," };"," use pnpr_config::Config;"," use pnpr_fixtures::MockConfigPresets;","@@ -63,7 +63,7 @@ async fn dropping_a_stream_cancels_pending_resolution_and_releases_admission() {","             request_auth,","             tarball_router,","             footprint,","-            cache_key: None,","+            cache_scope: CacheScope::Key(None),","             permit: Arc::new(permit),","             deadline,","         },"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpr/crates/pnpr/src/resolver/verdict_cache.rs","lines":["@@ -1,24 +1,27 @@"," //! SQLite-backed whole-lockfile verification verdict cache for the pnpr"," //! resolver ([pnpm/pnpm#12139](https://github.com/pnpm/pnpm/issues/12139))."," //!","-//! Caches the *result* of verifying an entire input lockfile. Like the","-//! local `lockfile-verified.jsonl` cache","-//! ([`pnpm_lockfile_verification::CacheRecord`]), a row is keyed by","-//! the lockfile content hash and stores the merged policy snapshot; a","-//! lookup is a hit only when every active verifier's","-//! [`ResolutionVerifier::can_trust_past_check`] accepts that stored","-//! snapshot (a looser current policy can trust a stricter cached run).","-//! One row per hash — a later pass overwrites the snapshot, matching the","-//! local cache's last-write-wins-by-hash rather than keeping a row per","-//! policy. Backed by `SQLite` so many client connections can read/write","-//! concurrently and the server can evict without the JSONL","+//! Caches the *result* of verifying an entire input lockfile, scoped by the","+//! private-route [`Footprint`] verification touched and the stored","+//! `(graph, grants)` epoch. Like the local `lockfile-verified.jsonl` cache","+//! ([`pnpm_lockfile_verification::CacheRecord`]), each row stores the merged","+//! policy snapshot; a lookup is a hit only when the caller is authorized for","+//! every private route in the stored [`Footprint`] and every active verifier's","+//! [`ResolutionVerifier::can_trust_past_check`] accepts that stored snapshot","+//! (a looser current policy can trust a stricter cached run).","+//!","+//! Rows are keyed by `(hash, epoch, footprint_key)` so callers resolving the","+//! same lockfile through distinct private upstream aliases each keep their own","+//! cached verdict without overwriting one another, an earlier-epoch verification","+//! cannot clobber a pass recorded in the current epoch, and callers sharing the","+//! same access reuse one row. Backed by `SQLite` so many client connections","+//! can read/write concurrently and the server can evict without the JSONL"," //! append/compaction races."," //!"," //! Only *passes* are cached. An age-pass is monotonic (versions only get","-//! older) and the lockfile hash pins the exact versions, so a cached","-//! pass stays time-correct without storing a cutoff — the same reason","-//! the local cache is correct via `can_trust_past_check` alone. A hit is","-//! O(1): one lookup by hash, then the policy-trust check.","+//! older) and the lockfile hash pins the exact versions, so a cached pass","+//! stays time-correct while the grant and graph epoch is unchanged and the","+//! caller still satisfies the [`Footprint`]."," //!"," //! Deliberately whole-lockfile, not per-entry: the expensive fetches are"," //! already covered by the warm packument cache, so per-entry keying would","@@ -28,18 +31,47 @@"," "," use std::{","     path::Path,","-    sync::Mutex,","+    sync::{Mutex, PoisonError},","     time::{Duration, SystemTime, UNIX_EPOCH},"," };"," ","+use pnpr_policy::Identity;","+use pnpr_route::{Footprint, RouteContext};"," use rusqlite::Connection;"," use serde_json::{Map, Value};"," "," /// Soft cap on cached verdicts; the oldest rows (by `verified_at_ms`)","-/// are evicted past this. Generous — each row is a hash plus a small","-/// policy JSON blob.","+/// are evicted past this."," const MAX_ROWS: i64 = 10_000;"," ","+/// Cap on distinct private-footprint candidates retained for a single lockfile","+/// hash, mirroring `MAX_RESOLUTION_CACHE_CANDIDATES_PER_KEY`.","+const MAX_CANDIDATES_PER_HASH: i64 = 8;","+","+/// Inputs to a [`VerdictCache::verified_footprint`] lookup.","+pub(crate) struct VerdictLookup<'a> {","+    pub(crate) hash: &'a str,","+    pub(crate) epoch: &'a str,","+    pub(crate) secret: &'a [u8],","+    pub(crate) route_context: &'a RouteContext,","+    pub(crate) identity: &'a Identity,","+}","+","+/// Inputs to [`VerdictCache::record`].","+pub(crate) struct VerdictRecord<'a> {","+    pub(crate) hash: &'a str,","+    pub(crate) footprint: &'a Footprint,","+    pub(crate) secret: &'a [u8],","+    pub(crate) epoch: &'a str,","+    pub(crate) policy: Map<String, Value>,","+}","+","+struct StoredVerdict 