","+            $reader = new ListCache($readerCache, $key);","+            $writer = new ListCache($writerCache, $key);","+            ListCache::purged([$reader], fn (): string => 'initial');","+            $version = $reader->getVersion();","+","+            ListCache::purged([$writer], fn (): string => 'permission revoked');","+            $reader->save([self::FIELD => ['stale row']], $version);","+","+            $this->assertFalse($readerCache->load($key, self::TTL, self::FIELD));","+            $this->assertNotSame($version, $reader->getVersion());","+            $this->assertGreaterThan(0, $this->redis->ttl($key.':version'));","+            $this->assertGreaterThan(0, $this->redis->ttl('v2:'.$key.':version'));","+        }","+    }","+","     public function testVersionMarkerExpires(): void","     {","         ListCache::purged([new ListCache($this->cache, $this->key)], fn (): string => 'stored');",""],"additions":39,"deletions":0,"truncated":false}],"additions":52,"deletions":10,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-10-31T14:36:00.417444+00:00"}