fn check_c_buffer_length(&self, hir_id: HirId, target: Target, pointer: Ident, length: Ident) {","+        if !matches!(target, Target::Fn | Target::ForeignFn) {","+            return;","+        }","+        let def_id = hir_id.owner.def_id;","+        let names = self.tcx.fn_arg_idents(def_id);","+        let sig = self.tcx.fn_sig(def_id).instantiate_identity().skip_norm_wip().skip_binder();","+        for (ident, is_pointer) in [(pointer, true), (length, false)] {","+            let normalized_ident = ident.normalize_to_macro_rules();","+            let reason = match names.iter().zip(sig.inputs()).find(|(name, _)| {","+                name.is_some_and(|n| n.normalize_to_macro_rules() == normalized_ident)","+            }) {","+                None => \"the name must refer to a parameter of this function\",","+                Some((_, ty)) => {","+                    if is_pointer && !ty.is_raw_ptr() {","+                        \"the buffer parameter must have a raw pointer type\"","+                    } else if !is_pointer && !ty.is_integral() {","+                        \"the length parameter must have an integer type\"","+                    } else {","+                        continue;","+                    }","+                }","+            };","+            self.dcx().emit_err(diagnostics::CBufferLengthParameter {","+                span: ident.span,","+                name: ident.name,","+                reason,","+            });","+        }","+    }","+","     /// Checks use of generic formatting parameters in `#[diagnostic::on_unimplemented]`","     fn check_diagnostic_on_unimplemented(&self, hir_id: HirId, directive: Option<&Directive>) {","         if let Some(directive) = directive {"],"additions":35,"deletions":0,"truncated":false},{"path":"compiler/rustc_passes/src/diagnostics.rs","lines":["@@ -10,6 +10,16 @@ use rustc_span::{DUMMY_SP, Ident, Span, Symbol};"," "," use crate::check_attr::ProcMacroKind;"," ","+#[derive(Diagnostic)]","+#[diag(