ute currently validates the parameter names and types, but does not","+check calls to the annotated function.","+","+<!-- FIXME(JohnTitor): describe more once a lint is implemented. -->"],"additions":29,"deletions":0,"truncated":false},{"path":"tests/ui/feature-gates/feature-gate-lint-c-buffer-length.rs","lines":["@@ -0,0 +1,10 @@","+#![feature(register_tool)]","+#![register_tool(lint)]","+","+unsafe extern \"C\" {","+    #[lint::c_buffer_length(buffer, length)]","+    //~^ ERROR the `lint::c_buffer_length` attribute is an experimental feature","+    fn c_fn(buffer: *const u8, length: usize);","+}","+","+fn main() {}"],"additions":10,"deletions":0,"truncated":false},{"path":"tests/ui/feature-gates/feature-gate-lint-c-buffer-length.stderr","lines":["@@ -0,0 +1,13 @@","+error[E0658]: the `lint::c_buffer_length` attribute is an experimental feature","+  --> $DIR/feature-gate-lint-c-buffer-length.rs:5:7","+   |","+LL |     #[lint::c_buffer_length(buffer, length)]","+   |       ^^^^^^^^^^^^^^^^^^^^^","+   |","+   = note: see issue #162563 <https://github.com/rust-lang/rust/issues/162563> for more information","+   = help: add `#![feature(lint_c_buffer_length)]` to the crate attributes to enable","+   = note: this compiler was built on YYYY-MM-DD; consider upgrading it if it is out of date","+","+error: aborting due to 1 previous error","+","+For more information about this error, try `rustc --explain E0658`."],"additions":13,"deletions":0,"truncated":false},{"path":"tests/ui/lint_helper_namespace/c_buffer_length/duplicate.rs","lines":["@@ -0,0 +1,9 @@","+#![feature(lint_c_buffer_length, register_tool)]","+#![register_tool(lint)]","+","+#[lint::c_buffer_length(buffer, length)]","+#[lint::c_buffer_length(buffer, length)]","+//~^ ERROR duplicate `lint::c_buffer_length` attributes","+fn duplicate(buffer: *const u8, length: usize) {}","+","+fn main() {}"],"additions":9,"deletions":0,"truncated":false},{"path":"tests/ui/lint_helper_namespace/c_buffer_length/duplicate.stderr","