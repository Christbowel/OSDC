E_NOINLINE int accessPayloadChecked(","     /* The row is gone, and the cursor was restored onto a neighbor. */","     return SQLITE_ABORT;","   }","-  return sqlite3BtreePayloadChecked(pCur, offset, amt, pBuf);","+  return SQLITE_MOVED;"," }"," int sqlite3BtreePayloadChecked(BtCursor *pCur, u32 offset, u32 amt, void *pBuf){","-  if( pCur->eState!=CURSOR_VALID ){","-    return accessPayloadChecked(pCur, offset, amt, pBuf);","-  }","-  assert( cursorOwnsBtShared(pCur) );","-  /* The size of the row might have changed.  Recompute it. */","-  if( pCur->info.nSize==0 ) getCellInfo(pCur);","-  if( (u64)offset+(u64)amt > (u64)pCur->info.nPayload ){","-    /* Size of the row has changed and the caller didn't notice. */","-    return SQLITE_ABORT;","+  if( pCur->eState==CURSOR_VALID ){","+    assert( cursorOwnsBtShared(pCur) );","+    return accessPayload(pCur, offset, amt, pBuf, 0);","+  }else{","+    return accessPayloadChecked(pCur);","   }","-  return accessPayload(pCur, offset, amt, pBuf, 0);"," }"," #endif /* SQLITE_OMIT_INCRBLOB */"," "],"additions":13,"deletions":17,"truncated":false},{"path":"src/sqlite.h.in","lines":["@@ -476,6 +476,7 @@ int sqlite3_exec("," #define SQLITE_NOTADB      26   /* File opened that is not a database file */"," #define SQLITE_NOTICE      27   /* Notifications from sqlite3_log() */"," #define SQLITE_WARNING     28   /* Warnings from sqlite3_log() */","+#define SQLITE_MOVED       29   /* Internal use only:  Cursor moved */"," #define SQLITE_ROW         100  /* sqlite3_step() has another row ready */"," #define SQLITE_DONE        101  /* sqlite3_step() has finished executing */"," /* end-of-error-codes */"],"additions":1,"deletions":0,"truncated":false},{"path":"src/vdbeblob.c","lines":["@@ -26,6 +26,7 @@ struct Incrblob {","   int nByte;              /* Size of open blob, in bytes */","   int iOffset;            /* Byte offset of blob in cursor data */","   u16 iCol;               /* Table column this handle is open on */","+  u8 bRetry;              /* Doing a blobReadWrite() retry */","   BtCursor *pCsr;         /* Cursor pointing at blob row */","   sqlite3_stmt *pStmt;    /* Statement holding cursor open */","   sqlite3 *db;            /* The associated database */","@@ -375,6 +376,65 @@ int sqlite3_blob_close(sqlite3_blob *pBlob){","   return rc;"," }"," ","+/* Forward reference */","+static int blobReadWrite(","+  sqlite3_blob *pBlob, ","+  void *z, ","+  int n, ","+  int iOffset, ","+  int (*xCall)(BtCursor*, u32, u32, void*)","+);","+","+/*","+** The b-tree cursor for blob handle p was restored to its saved position by","+** sqlite3BtreePayloadChecked(), which then returned SQLITE_MOVED.  The","+** position is saved, for example, by a ROLLBACK, and that might have changed","+** the content of the row.  So the iOffset and nByte values computed when the","+** handle was opened or last moved cannot be trusted.  A ROLLBACK can change","+** the size of a column that precedes the blob, which moves the blob within","+** the row.","+**","+** Recompute iOffset and nByte in the same way that sqlite3_blob_reopen()","+** does.  Then retry the blobReadWrite().","+*/","+static SQLITE_NOINLINE int blobReadWriteRetry(","+  Incrblob *p,","+  void *z, ","+  int n, ","+  int iOffset, ","+  int (*xCall)(BtCursor*, u32, u32, void*)","+){","+  int rc;","+  sqlite3_int64 iRow;","+  char *zErr = 0;","+  sqlite3 *db = p->db;","+","+  sqlite3BtreeEnterCursor(p->pCsr);","+  iRow = sqlite3BtreeIntegerKey(p->pCsr);","+  sqlite3BtreeLeaveCursor(p->pCsr);","+  ((Vdbe*)p->pStmt)->rc = SQLITE_OK;","+  if( NEVER(p->bRetry) || sqlite3FaultSim(210) ){","+    /* It should not be possible for blobReadWrite() and blobReadWriteRetry()","+    ** to get into a loop, but we check anyway, for safety. */","+    rc = SQLITE_ABORT;","+    sqlite3VdbeFinalize((Vdbe*)p->pStmt);","+    p->pStmt = 0;","+  }else{","+    rc = blobSeekToRow(p, iRow, &zErr);","+  }","+  sqlite3DbFree(db, zErr);","+  assert( rc==SQLITE_OK || p->pStmt==0 );","+  if( rc==SQLITE_OK ){","+    p->bRetry = 1;","+    rc = blobReadWrite((sqlite3_blob*)p,z,n,iOffset,xCall);","+    p->bRetry = 0;","+  }else{","+    rc = sqlite3ApiExit(db, rc);","+  }","+  sqlite3_mutex_leave(db->mutex);","+  return rc;","+}","+"," /*"," ** Perform a read or write operation on a blob"," */","@@ -452,11 +512,21 @@ static int blobReadWrite("," #endif"," ","     sqlite3BtreeLeaveCursor(p->pCsr);","-    if( rc==SQLITE_ABORT ){","-      sqlite3VdbeFinalize(v);","-      p->pStmt = 0;","+    if( rc==SQLITE_OK ){","+      v->rc = SQLITE_OK;","     }else{","-      v->rc = rc;","+      if( rc==SQLITE_MOVED ){","+        /* The cursor was restored and no data was read.  Refresh the","+        ** handle and try the read again. */","+        return blobReadWriteRetry(p,z,n,iOffset,xCall);","+      }","+      if( rc==SQLITE_ABORT ){","+        assert( p->pStmt );","+        sqlite3VdbeFinalize(v);","+        p->pStmt = 0;","+      }else{","+        v->rc = rc;","+      }","     }","   }","   sqlite3Error(db, rc);"],"additions":74,"deletions":4,"truncated":false},{"path":"test/incrblob.test","lines":["@@ -756,4 +756,83 @@ do_test incrblob-10.3.2 {","   execsql { SELECT id FROM t2 }"," } {1 3}"," ","+# If a ROLLBACK changes the size of prior columns in a row, incrblob","+# reads do not fail as long as the area being read is still within the","+# row, but the content is incorrect.","+#","+do_test incrblob-10.4.1 {","+  db close","+  forcedelete test.db","+  sqlite3 db test.db","+  execsql {","+    CREATE TABLE t4(id INTEGER PRIMARY KEY, d1 BLOB, d2 BLOB);","+    INSERT INTO t4 VALUES(1, x'505152535455565758595a5b5c5d5e5f',","+                             x'707172737475767778797a');","+    BEGIN;","+    UPDATE t4 SET d1 = x'2a' WHERE id=1;","+  }","+  set ::blob [db incrblob -readonly t4 d2 1]","+  fconfigure $::blob -translation binary","+  read $::blob 10","+} {pqrstuvwxy}","+do_test incrblob-10.4.2 {","+  execsql ROLLBACK;","+  seek $::blob 0","+  read $::blob 10","+} {pqrstuvwxy}","+catch { close $::blob }","+","+# A read-only handle whose cursor is saved and restored because other rows","+# of the same table are changed (not a ROLLBACK) keeps working, and keeps","+# reading the right content.","+#","+do_test incrblob-10.5.1 {","+  db close","+  forcedelete test.db","+  sqlite3 db test.db","+  execsql {","+    CREATE TABLE t5(id INTEGER PRIMARY KEY, d1 BLOB, d2 BLOB);","+    INSERT INTO t5 VALUES(1, x'5051', x'707172737475');","+    BEGIN;","+  }","+  set ::blob [db incrblob -readonly t5 d2 1]","+  fconfigure $::blob -translation binary","+  execsql {","+    INSERT INTO t5 VALUES(2, zeroblob(3000), zeroblob(3000));","+    INSERT INTO t5 VALUES(3, zeroblob(3000), zeroblob(3000));","+  }","+  seek $::blob 1","+  read $::blob 3","+} {qrs}","+do_test incrblob-10.5.2 {","+  execsql ROLLBACK","+  seek $::blob 0","+  read $::blob 6","+} {pqrstu}","+catch { close $::blob }","+","+# If a ROLLBACK changes the column that a read-only handle is open on so","+# that it no longer holds a blob, the handle is expired.","+#","+do_test incrblob-10.6.1 {","+  db close","+  forcedelete test.db","+  sqlite3 db test.db","+  execsql {","+    CREATE TABLE t6(id INTEGER PRIMARY KEY, d1 BLOB, d2);","+    INSERT INTO t6 VALUES(1, x'50', 5);","+    BEGIN;","+    UPDATE t6 SET d2 = x'7071727374';","+  }","+  set ::blob [db incrblob -readonly t6 d2 1]","+  fconfigure $::blob -translation binary","+  read $::blob 5","+} {pqrst}","+do_test incrblob-10.6.2 {","+  execsql ROLLBACK","+  seek $::blob 0","+  list [catch {read $::blob 5} msg]","+} {1}","+catch { close $::blob }","+"," finish_test",""],"additions":79,"deletions":0,"truncated":false}],"additions":178,"deletions":32,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-13T17:05:18.744104+00:00"}