ire.NoError(t, err)","+}"],"additions":67,"deletions":0,"truncated":false},{"path":"openapi3filter/testdata/encoded_path_authorization_bypass.yml","lines":["@@ -0,0 +1,30 @@","+openapi: 3.0.3","+info:","+  title: encoded path route identity fixture","+  version: 1.0.0","+security:","+  - ApiKeyAuth: []","+paths:","+  /public/status:","+    get:","+      security: []","+      responses:","+        \"204\":","+          description: public route","+  /{id}:","+    get:","+      parameters:","+        - name: id","+          in: path","+          required: true","+          schema:","+            type: string","+      responses:","+        \"202\":","+          description: protected route","+components:","+  securitySchemes:","+    ApiKeyAuth:","+      type: apiKey","+      in: header","+      name: X-API-Key"],"additions":30,"deletions":0,"truncated":false},{"path":"openapi3filter/validation_handler.go","lines":["@@ -3,6 +3,7 @@ package openapi3filter"," import ("," \t\"context\""," \t\"net/http\"","+\t\"strings\""," "," \t\"github.com/getkin/kin-openapi/openapi3\""," \t\"github.com/getkin/kin-openapi/routers\"","@@ -79,6 +80,12 @@ func (h *ValidationHandler) before(w http.ResponseWriter, r *http.Request) (hand"," \treturn false"," }"," ","+// ErrEncodedPathSeparator is returned when a request path holds an encoded path","+// separator and the decoded path resolves to another operation than the escaped","+// path does. Serving such a request would validate one operation while the","+// wrapped handler serves the other one.","+var ErrEncodedPathSeparator error = &routers.RouteError{Reason: \"path contains an encoded path separator resolving to another operation\"}","+"," func (h *ValidationHandler) validateRequest(r *http.Request) error {"," \t// Find route"," \troute, pathParams, err := h.router.FindRoute(r)","@@ -86,6 +93,10 @@ func (h *ValidationHandler) validateRequest(r *http.Request) error {"," \t\treturn err"," \t}"," ","+\tif err := h.checkEncodedPathSeparator(r, route); err != nil {","+\t\treturn err","+\t}","+"," \toptions := &Options{"," \t\tAuthenticationFunc: h.AuthenticationFunc,"," \t}","@@ -103,3 +114,31 @@ func (h *ValidationHandler) validateRequest(r *http.Request) error {"," "," \treturn nil"," }","+","+// checkEncodedPathSeparator rejects a request whose encoded path separators make","+// r.URL.Path and r.URL.RawPath select different operations. The router matches","+// on the decoded path while routers such as gorilla/mux with UseEncodedPath","+// match on the escaped one, so the operation validated here — its security","+// requirements included — would not be the operation the wrapped handler serves.","+func (h *ValidationHandler) checkEncodedPathSeparator(r *http.Request, route *routers.Route) error {","+\tescapedPath := r.URL.EscapedPath()","+\tsegment := escapedPath","+\tfor _, separator := range []string{\"%2F\", \"%2f\"} {","+\t\tsegment = strings.ReplaceAll(segment, separator, \"~\")","+\t}","+\tif segment == escapedPath {","+\t\treturn nil","+\t}","+","+\tshadow := r.Clone(r.Context())","+\tshadow.URL.Path, shadow.URL.RawPath = segment, \"\"","+\tescapedRoute, _, err := h.router.FindRoute(shadow)","+\tif err != nil ||","+\t\tescapedRoute.Method != route.Method ||","+\t\tescapedRoute.Path != route.Path ||","+\t\tescapedRoute.Operation != route.Operation {","+\t\treturn ErrEncodedPathSeparator","+\t}","+","+\treturn nil","+}",""],"additions":39,"deletions":0,"truncated":false}],"additions":271,"deletions":0,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-10-16T14:18:35.263280+00:00"}