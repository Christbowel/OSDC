atus\")","+\t\trequire.Equal(t, http.StatusUnauthorized, status)","+\t\troute, _ := downstreamRoute.Load().(string)","+\t\trequire.Equal(t, \"/public/status\", route)","+\t\tid, _ := protectedID.Load().(string)","+\t\trequire.Equal(t, \"\", id)","+\t\trequire.Equal(t, before, authCalls.Load())","+\t})","+","+\tt.Run(\"documented Router.Use wiring has the same bypass\", func(t *testing.T) {","+\t\tvar useAuthCalls atomic.Int64","+\t\tvar useRoute atomic.Value","+\t\tvar useProtectedID atomic.Value","+\t\tuseHandler := &openapi3filter.ValidationHandler{","+\t\t\tFile: \"testdata/encoded_path_authorization_bypass.yml\",","+\t\t\tAuthenticationFunc: func(_ context.Context, input *openapi3filter.AuthenticationInput) error {","+\t\t\t\tuseAuthCalls.Add(1)","+\t\t\t\treturn input.NewError(errors.New(\"missing or invalid X-API-Key\"))","+\t\t\t},","+\t\t\tErrorEncoder: func(_ context.Context, _ error, w http.ResponseWriter) {","+\t\t\t\tw.WriteHeader(http.StatusUnauthorized)","+\t\t\t},","+\t\t}","+\t\terr := useHandler.Load()","+\t\trequire.NoError(t, err)","+","+\t\tuseRouter := mux.NewRouter().UseEncodedPath()","+\t\tuseRouter.HandleFunc(\"/public/status\", func(w http.ResponseWriter, _ *http.Request) {","+\t\t\tuseRoute.Store(\"/public/status\")","+\t\t\tw.WriteHeader(http.StatusNoContent)","+\t\t}).Methods(http.MethodGet)","+\t\tuseRouter.HandleFunc(\"/{id}\", func(w http.ResponseWriter, r *http.Request) {","+\t\t\tuseRoute.Store(\"/{id}\")","+\t\t\tuseProtectedID.Store(mux.Vars(r)[\"id\"])","+\t\t\tw.WriteHeader(http.StatusAccepted)","+\t\t}).Methods(http.MethodGet)","+\t\tuseRouter.Use(useHandler.Middleware)","+","+\t\tuseServer := httptest.NewServer(useRouter)","+\t\tdefer useServer.Close()","+\t\tresponse, err := http.Get(useServer.URL + \"/public%2Fstatus\")","+\t\trequire.NoError(t, err)","+\t\tdefer response.Body.Close()","+","+\t\trequire.Equal(t, http.StatusUnauthorized, response.StatusCode)","+\t\troute, _ := useRoute.Load().(string)","+\t\trequire.Equal(t, \