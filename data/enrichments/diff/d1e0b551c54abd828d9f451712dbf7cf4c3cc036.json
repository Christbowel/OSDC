ed DST state, since the offset in the label is date-aware', () => {","+    const labels = TIMEZONES_BY_IANA.map((entry) => entry.text)","+    expect(labels.filter((label) => /Daylight|Standard/.test(label))).toEqual([])","   })"," ","   it('preserves entries that have no collision', () => {","@@ -29,6 +37,34 @@ describe('TIMEZONES_BY_IANA', () => {","   })"," })"," ","+describe('catalog integrity', () => {","+  const getOffsetHours = (timeZone: string, date: Date) => {","+    const value = new Intl.DateTimeFormat('en-US', { timeZone, timeZoneName: 'longOffset' })","+      .formatToParts(date)","+      .find((part) => part.type === 'timeZoneName')?.value","+    const match = value?.match(/GMT([+-])(\\d\\d):(\\d\\d)/)","+    if (!match) return 0","+    return (match[1] === '-' ? -1 : 1) * (Number(match[2]) + Number(match[3]) / 60)","+  }","+","+  const winter = new Date('2026-01-15T12:00:00Z')","+  const summer = new Date('2026-07-15T12:00:00Z')","+","+  const cases = TIMEZONES_BY_IANA.flatMap((entry) =>","+    entry.utc.map((iana) => [entry.text, iana, entry] as const)","+  )","+","+  it.each(cases)('%s: %s has the offset in its label in winter or summer', (_text, iana, entry) => {","+    const match = entry.text.match(/^\\(UTC(?:([+-])(\\d\\d):(\\d\\d))?\\)/)","+    expect(match).not.toBeNull()","+    const labelOffset = match?.[1]","+      ? (match[1] === '-' ? -1 : 1) * (Number(match[2]) + Number(match[3]) / 60)","+      : 0","+","+    expect([getOffsetHours(iana, winter), getOffsetHours(iana, summer)]).toContain(labelOffset)","+  })","+})","+"," describe('findTimezoneByIana', () => {","   it('matches the entry by its primary IANA name', () => {","     const entry = findTimezoneByIana('America/Danmarkshavn')","@@ -42,7 +78,98 @@ describe('findTimezoneByIana', () => {","     expect(entry?.utc).toContain('Asia/Tokyo')","   })"," ","+  it('returns the deduplicated row when the zone belongs to a collapsed catalog row', () => {","+    // Europe/Nicosia is only listed on the \"E. Europe\" row, which collapses into","+    // \"Athens, Bucharest\" because both share the primary Asia/Nicosia.","+    const entry = findTimezoneByIana('Europe/Nicosia')","+    expect(entry).toBe(TIMEZONES_BY_IANA.find((row) => row.utc[0] === entry?.utc[0]))","+    expect(entry?.text).toContain('Athens, Bucharest')","+  })","+","   it('returns undefined for an unknown IANA name', () => {","     expect(findTimezoneByIana('Not/A/Real_Zone')).toBeUndefined()","   })"," })","+","+const getTimezone = (zone: string) => {","+  const timezone = findTimezoneByIana(zone)","+  if (!timezone) throw new Error(`Timezone ${zone} not found`)","+  return timezone","+}","+","+describe('getTimezoneLabel', () => {","+  it.each([","+    ['2026-01-09T03:12:00Z', '(UTC+01:00) Brussels, Copenhagen, Madrid, Paris'],","+    ['2026-10-09T03:12:00Z', '(UTC+02:00) Brussels, Copenhagen, Madrid, Paris'],","+  ])('shows Madrid offset at %s', (date, label) => {","+    expect(getTimezoneLabel(getTimezone('Europe/Madrid'), dayjs(date))).toBe(label)","+  })","+","+  it.each([","+    ['2026-03-29T00:59:59Z', '(UTC+01:00)'],","+    ['2026-03-29T01:00:00Z', '(UTC+02:00)'],","+    ['2026-10-25T00:59:59Z', '(UTC+02:00)'],","+    ['2026-10-25T01:00:00Z', '(UTC+01:00)'],","+  ])('updates Madrid offset across daylight saving transitions at %s', (date, offset) => {","+    expect(getTimezoneLabel(getTimezone('Europe/Madrid'), dayjs(date))).toBe(","+      `${offset} Brussels, Copenhagen, Madrid, Paris`","+    )","+  })","+","+  it.each([","+    ['America/New_York', '2026-01-09T03:12:00Z', '(UTC-05:00)'],","+    ['America/New_York', '2026-10-09T03:12:00Z', '(UTC-04:00)'],","+    ['Asia/Kolkata', '2026-10-09T03:12:00Z', '(UTC+05:30)'],","+    ['Asia/Kathmandu', '2026-10-09T03:12:00Z', '(UTC+05:45)'],","+    ['Europe/London', '2026-10-09T03:12:00Z', '(UTC+01:00)'],","+    ['America/St_Johns', '2026-01-09T03:12:00Z', '(UTC-03:30)'],","+    ['Etc/GMT', '2026-10-09T03:12:00Z', '(UTC+00:00)'],","+  ])('formats %s offset including its sign and minutes', (zone, date, offset) => {","+    expect(getTimezoneLabel(getTimezone(zone), dayjs(date)).startsWith(offset)).toBe(true)","+  })","+","+  it('preserves the selected timezone and recovery timestamp', () => {","+    const timezone = getTimezone('Europe/Madrid')","+    const originalTimezone = structuredClone(timezone)","+    const recoveryDate = dayjs('2026-10-09T03:12:00Z').tz(timezone.utc[0])","+    const recoveryTimestamp = recoveryDate.unix()","+","+    expect(recoveryDate.format('HH:mm:ss')).toBe('05:12:00')","+    expect(recoveryDate.utc().format('HH:mm:ss')).toBe('03:12:00')","+    expect(getTimezoneLabel(timezone, recoveryDate)).toBe(","+      '(UTC+02:00) Brussels, Copenhagen, Madrid, Paris'","+    )","+    expect(recoveryDate.unix()).toBe(recoveryTimestamp)","+    expect(timezone).toEqual(originalTimezone)","+  })","+})","+","+describe('getTimezoneLabel at a zero offset', () => {","+  it('formats it as +00:00 like every other row', () => {","+    const utc = TIMEZONES_BY_IANA.find((entry) => entry.value === 'UTC')!","+    expect(getTimezoneLabel(utc, '2026-07-15T12:00:00Z')).toBe(","+      '(UTC+00:00) Coordinated Universal Time'","+    )","+  })","+})","+","+describe('getTimezoneLabelByIana', () => {","+  it('uses the offset in effect at the given date', () => {","+    expect(getTimezoneLabelByIana('Europe/Madrid', '2026-01-09T03:12:00Z')).toBe(","+      '(UTC+01:00) Brussels, Copenhagen, Madrid, Paris'","+    )","+    expect(getTimezoneLabelByIana('Europe/Madrid', '2026-10-09T03:12:00Z')).toBe(","+      '(UTC+02:00) Brussels, Copenhagen, Madrid, Paris'","+    )","+  })","+","+  it('defaults to the current date', () => {","+    expect(getTimezoneLabelByIana('Europe/Madrid')).toBe(","+      getTimezoneLabel(getTimezone('Europe/Madrid'), dayjs())","+    )","+  })","+","+  it('falls back to the IANA name when the zone is not in the catalog', () => {","+    expect(getTimezoneLabelByIana('Not/A/Real_Zone')).toBe('Not/A/Real_Zone')","+  })","+})"],"additions":134,"deletions":7,"truncated":false},{"path":"apps/studio/lib/constants/timezones.ts","lines":["@@ -1,34 +1,30 @@","+import dayjs from 'dayjs'","+","+// [Joshen] Retrieved from the following repo, although some of its values are stale","+// so we've made some amendments here"," // https://github.com/dmfilipenko/timezones.json/blob/master/timezones.json"," export interface Timezone {","   value: string","-  abbr: string","-  offset: number","   isdst: boolean","   text: string","   utc: string[]"," }"," ","-export const ALL_TIMEZONES: Timezone[] = [","+const ALL_TIMEZONES: Timezone[] = [","   {","     value: 'Dateline Standard Time',","-    abbr: 'DST',","-    offset: -12,","     isdst: false,","     text: '(UTC-12:00) International Date Line West',","     utc: ['Etc/GMT+12'],","   },","   {","     value: 'UTC-11',","-    abbr: 'U',","-    offset: -11,","     isdst: false,","     text: '(UTC-11:00) Coordinated Universal Time-11',","     utc: ['Etc/GMT+11', 'Pacific/Midway', 'Pacific/Niue', 'Pacific/Pago_Pago'],","   },","   {","     value: 'Hawaiian Standard Time',","-    abbr: 'HST',","-    offset: -10,","     isdst: false,","     text: '(UTC-10:00) Hawaii',","     utc: [","@@ -41,8 +37,6 @@ export const ALL_TIMEZONES: Timezone[] = [","   },","   {","     value: 'Alaskan Standard Time',","-    abbr: 'AKDT',","-    offset: -8,","     isdst: true,","     text: '(UTC-09:00) Alaska',","     utc: [","@@ -55,32 +49,24 @@ export const ALL_TIMEZONES: Timezone[] = [","   },","   {","     value: 'Pacific Standard Time (Mexico)',","-    abbr: 'PDT',","-    offset: -7,","     isdst: true,","     text: '(UTC-08:00) Baja California',","     utc: ['America/Santa_Isabel'],","   },","   {","     value: 'Pacific Daylight Time',","-    abbr: 'PDT',","-    offset: -7,","     isdst: true,","     text: '(UTC-07:00) Pacific Daylight Time (US & Canada)',","     utc: ['America/Los_Angeles', 'America/Tijuana', 'America/Vancouver'],","   },","   {"," 