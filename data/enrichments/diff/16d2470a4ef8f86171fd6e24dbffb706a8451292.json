.AuthInfoFrom(ctx)","+\trequire.True(t, ok)","+\t// Seed an older writer's invalid row directly so the no-op path cannot","+\t// bypass validation merely because its bytes match the stored body.","+\tevent, failure := srv.newEvent(ctx, user, key, 0, value, nil)","+\trequire.Nil(t, failure)","+\trv, err := backend.WriteEvent(ctx, *event)","+\trequire.NoError(t, err)","+\treads, writes := backend.reads.Load(), backend.writes.Load()","+\trsp, err := srv.Update(ctx, &resourcepb.UpdateRequest{Key: key, Value: value, ResourceVersion: rv})","+\terr = ErrorFromResponse(rsp.GetError(), err)","+\trequire.Error(t, err)","+\trequire.EqualValues(t, http.StatusBadRequest, AsErrorResult(err).Code)","+\trequire.Equal(t, reads, backend.reads.Load())","+\trequire.Equal(t, writes, backend.writes.Load())","+}","+","+func TestResourceBlobValidationPreservesAuthentication(t *testing.T) {","+\tsrv := &server{}","+\tkey := &resourcepb.ResourceKey{Group: \"playlist.grafana.app\", Resource: \"playlists\", Namespace: \"default\", Name: \"item\"}","+\tvalue := blobValidationBody(`,\"blobs\":{\"dashboard\":{\"data\":\"e30=\"}}`)","+\tcreated, err := srv.Create(t.Context(), &resourcepb.CreateRequest{Key: key, Value: value})","+\trequire.NoError(t, err)","+\trequire.EqualValues(t, http.StatusUnauthorized, created.GetError().GetCode())","+\tupdated, err := srv.Update(t.Context(), &resourcepb.UpdateRequest{Key: key, Value: value})","+\trequire.NoError(t, err)","+\trequire.EqualValues(t, http.StatusUnauthorized, updated.GetError().GetCode())","+}","+","+func TestResourceWritesPreserveBlobReferences(t *testing.T) {","+\tsrv, _, _ := newBlobAuthzTestServer(t, nil)","+\tctx := ctxWithUserInNs(\"default\")","+\tfor i, blobs := range []string{","+\t\t\"\",","+\t\t`,\"blobs\":null`,","+\t\t`,\"blobs\":{}`,","+\t\t`,\"blobs\":{\"dashboard\":{\"uid\":\"existing\",\"contentType\":\"application/json\",\"size\":9007199254740993,\"custom\":{\"data\":\"not inline\"}}}`,","+\t\t`,\"blobs\":{\"dashboard\":null,\"o