oes not affect deployment versions.\"","+        ),","+    )"," ","     @field_validator(\"applications\")","     @classmethod","@@ -1393,6 +1400,15 @@ class ReplicaDetails(ServeActorDetails):","             \"state from the running replica actor.\"","         )","     )","+    version: Optional[str] = Field(","+        default=None,","+        description=(","+            \"Deployment version tracked by the controller. During UPDATING, this \"","+            \"is the version being applied. During RECOVERING, it may be the \"","+            \"target version until the actor reports its actual version. Check \"","+            \"the replica state before treating a matching version as applied.\"","+        ),","+    )"," "," "," @PublicAPI(stability=\"alpha\")","@@ -1488,6 +1504,13 @@ class DeploymentDetails(BaseModel):","     required_resources: Dict = Field(","         description=\"The resources required per replica of this deployment.\"","     )","+    target_version: Optional[str] = Field(","+        default=None,","+        description=(","+            \"Target deployment version. Use each replica's `version` and `state` \"","+            \"together to track rollout progress.\"","+        ),","+    )","     replicas: List[ReplicaDetails] = Field(","         description=\"Details about the live replicas of this deployment.\"","     )","@@ -1939,6 +1962,13 @@ class ServeInstanceDetails(BaseModel):","             \"defined in code. Older versions omit this field and keep the override.\"","         ),","     )","+    applied_config_id: Optional[str] = Field(","+        default=None,","+        description=(","+            \"Identifier of the last config accepted by the controller. Replica \"","+            \"updates may still be in progress.\"","+        ),","+    )"," ","     @staticmethod","     def get_empty_schema_dict() -> Dict:"],"additions":30,"deletions":0,"truncated":false},{"path":"python/ray/serve/tests/test_controller.py","lines":["@@ -299,6 +299,7 @@ def autoscaling_app():","                             },","                             \"target_num_replicas\": 1,","                             \"required_resources\": {\"CPU\": 1},","+                            \"target_version\": replica.version,","                             \"replicas\": [","                                 {","                                     \"node_id\": node_id,","@@ -312,6 +313,7 @@ def autoscaling_app():","                                     \"state\": \"RUNNING\",","                                     \"pid\": replica.pid,","                                     \"start_time_s\": replica.start_time_s,","+                                    \"version\": replica.version,","                                 }","                             ],","                             \"recent_dead_replicas\": [],","@@ -336,6 +338,7 @@ def autoscaling_app():","             # Set by the controller: this version restores a deployment option","             # that a re-applied config stops setting.","             \"restores_unset_config_options\": True,","+            \"applied_config_id\": None,","             \"target_groups\": [","                 {","                     \"targets\": ["],"additions":3,"deletions":0,"truncated":false},{"path":"python/ray/serve/tests/test_deploy_app_2.py","lines":["@@ -1490,6 +1490,131 @@ def test_instance_details_report_restoring_unset_options(serve_instance):","     assert details[\"restores_unset_config_options\"] is True"," "," ","+def test_instance_details_echo_config_id_and_versions(serve_instance):","+    \"\"\"Config id, target version, and replica pids survive a controller restart.\"\"\"","+    client = serve_instance","+    client.deploy_apps(","+        ServeDeploySchema(","+            applications=[","+                {","+                    \"name\": SERVE_DEFAULT_APP_NAME,","+                    \"import_path\": FAIL_ON_FLAG_IMPORT_PATH,","+                }","+            ],","+            config_id=\"c1\",","+        )","+    )","+    wait_for_condition(lambda: len(_running_replica_pids(client)) == 2, timeout=60)","+","+    def snapshot():","+        \"\"\"Return (target_version, replica pids) once every replica is RUNNING.\"\"\"","+        details = ServeInstanceDetails(","+            **ray.get(client._controller.get_serve_instance_details.remote())","+        )","+        deployment = details.applications[SERVE_DEFAULT_APP_NAME].deployments[","+            \"FailOnFlag\"","+        ]","+        assert details.applied_config_id == \"c1\"","+        assert deployment.target_version","+        assert len(deployment.replicas) == 2","+        assert all(","+            r.state == \"RUNNING\" and r.version == deployment.target_version","+            for r in deployment.replicas","+        )","+        return deployment.target_version, sorted(r.pid for r in deployment.replicas)","+","+    before = snapshot()","+    old_pid = ray.get(client._controller.get_pid.remote())","+    ray.kill(client._controller, no_restart=False)","+    wait_for_condition(lambda: ray.get(client._controller.get_pid.remote()) != old_pid)","+    wait_for_condition(lambda: snapshot() is not None, timeout=60)","+    assert snapshot() == before","+","+    # A config without an id clears the echo rather than keeping a stale one.","+    client.deploy_apps(_rolling_update_config())","+    wait_for_condition(","+        lambda: ray.get(client._controller.get_serve_instance_details.remote()).get(","+            \"applied_config_id\"","+        )","+        is None,","+        timeout=60,","+    )","+","+","+def test_versions_follow_the_kind_of_config_change(serve_instance):","+    \"\"\"Only changes that restart or reconfigure replicas produce a new version.\"\"\"","+    client = serve_instance","+","+    def deploy(config, num_replicas, previous_target=None):","+        \"\"\"Deploy and return (target_version, replica pids) once converged on it.\"\"\"","+        client.deploy_apps(config)","+","+        def converged():","+            details = _deployment_details(client)","+            return (","+                details.status == \"HEALTHY\"","+                and details.target_version != previous_target","+                and len(details.replicas) == num_replicas","+                and all(","+                    r.state == \"RUNNING\" and r.version == details.target_version","+                    for r in details.replicas","+                )","+            )","+","+        wait_for_condition(converged, timeout=60)","+        details = _deployment_details(client)","+        return details.target_version, sorted(r.pid for r in details.replicas)","+","+    v1, pids = deploy(_rolling_update_config(), 2)","+","+    # Replica count only: same version, same replicas plus one.","+    target, new_pids = deploy(","+        _rolling_update_config({\"name\": \"FailOnFlag\", \"num_replicas\": 3}), 3","+    )","+    assert target == v1 and set(pids) < set(new_pids)","+    pids = new_pids","+","+    # user_config: new version applied by reconfiguring the same replicas.","+    v2, new_pids = deploy(","+        _rolling_update_config(","+            {\"name\": \"FailOnFlag\", \"num_replicas\": 3, \"user_config\": {\"k\": 1}}","+        ),","+        3,","+        previous_target=v1,","+    )","+    assert v2 != v1 and new_pids == pids","+","+    # Actor options: new version with restarted replicas.","+    v3, new_pids = deploy(","+        _rolling_update_config(","+            {","+                \"name\": \"FailOnFlag\",","+                \"num_replicas\": 3,","+                \"user_config\": {\"k\": 1},","+                \"ray_actor_options\": {\"runtime_env\": {\"env_vars\": {\"RESTART\": \"1\"}}},","+            }","+        ),","+        3,","+        previous_target=v2,","+    )","+    assert v3 not in (v1, v2) and not set(new_pids) & set(pids)","+    pids = new_pids","+","+    # Application runtime_env: rebuilt app, new version, restarted replicas.","+    rebuilt = ServeDeploySchema(","+        applications=[","+            {","+                \"name\": SERVE_DEFAULT_APP_NAME,","+                \"import_path\": FAIL_ON_FLAG_IMPORT_PATH,","+                \"runtime_env\": {\"env_vars\": {\"REBUILD\": \"1\"}},","+                \"deployments\": [{\"name\": \"FailOnFlag\", \"num_replicas\": 3}],","+            }","+        ]","+    )","+    v4, new_pids = deploy(rebuilt, 3, previous_target=v3)","+    assert v4 not in (v1, v2, v3) and not set(new_pids) & set(pids)","+","+"," @pytest.mark.parametrize(\"restart_controller\", [False, True])"," def test_sparse_config_rollback_restores_code_defined_options(","     serve_instance, restart_controller"],"additions":125,"deletions":0,"truncated":false},{"path":"python/ray/serve/tests/test_direct_ingress.py","lines":["@@ -2643,6 +2643,7 @@ def snapshot_has_all_target_groups() -> bool:","                             },","                             \"target_num_replicas\": 1,","                             \"required_resources\": {\"CPU\": 1},","+                            \"target_version\": replica.version,","                             \"replicas\": [","                                 {","                                     \"node_id\": node_id,","@@ -2656,6 +2657,7 @@ def snapshot_has_all_target_groups() -> bool:","                                     \"state\": \"RUNNING\",","                                     \"pid\": replica.pid,","                                     \"start_time_s\": replica.start_time_s,","+                                    \"version\": replica.version,","                                 }","                             ],","                             \"recent_dead_replicas\": [],","@@ -2680,6 +2682,7 @@ def snapshot_has_all_target_groups() -> bool:","             # Set by the controller: this version restores a deployment option","             # that a re-applied config stops setting.","             \"restores_unset_config_options\": True,","+            \"applied_config_id\": None,","             \"target_groups\": [","                 {","                     \"targets\": ["],"additions":3,"deletions":0,"truncated":false},{"path":"python/ray/serve/tests/unit/test_controller.py","lines":["@@ -1,9 +1,12 @@","+import pickle"," from copy import deepcopy","+from types import SimpleNamespace"," "," import pytest"," "," from ray.serve._private.common import TargetCapacityDirection"," from ray.serve._private.controller import (","+    ServeController,","     applications_match,","     calculate_target_capacity_direction,"," )","@@ -714,6 +717,30 @@ def test_component_duration_rolling_window(self):","         assert tracker.dsm_update_durations[0] == 50.0"," "," ","+class TestConfigCheckpoint:","+    def _read(self, checkpoint):","+        return ServeController._read_config_checkpoint(","+            SimpleNamespace(kv_store=SimpleNamespace(get=lambda _key: checkpoint))","+        )","+","+    def test_reads_checkpoint_written_before_config_id(self):","+        \"\"\"Four-field checkpoints from older controllers still load.\"\"\"","+        app = {\"name\": \"a\", \"import_path\": \"fake.a\"}","+        legacy = pickle.dumps((1.0, None, TargetCapacityDirection.UP, {\"a\": app}))","+        deployment_time, config, direction = self._read(legacy)","+        assert deployment_time == 1.0","+        assert direction == TargetCapacityDirection.UP","+        assert [a.name for a in config.applications] == [\"a\"]","+        assert config.config_id is None","+","+    def test_reads_config_id(self):","+        app = {\"name\": \"a\", \"import_path\": \"fake.a\"}","+        current = pickle.dumps((1.0, None, None, {\"a\": app}, \"c1\"))","+        _, config, _ = self._read(current)","+        assert config.config_id == \"c1\"","+        assert self._read(None) == (0.0, None, None)","+","+"," if __name__ == \"__main__\":","     import sys"," "],"additions":27,"deletions":0,"truncated":false},{"path":"python/ray/serve/tests/unit/test_deployment_state.py","lines":["@@ -1543,6 +1543,147 @@ def test_deploy_new_config_same_code_version(","     )"," "," ","+def test_details_report_replica_and_target_versions(mock_deployment_state_manager):","+    \"\"\"Replica versions tell a rolling update apart from autoscaling churn.\"\"\"","+    create_dsm, _, _, _ = mock_deployment_state_manager","+    dsm: DeploymentStateManager = create_dsm()","+    autoscaling_config = {","+        \"min_replicas\": 1,","+        \"max_replicas\": 10,","+        \"initial_replicas\": 3,","+        \"upscale_delay_s\": 0,","+        \"downscale_delay_s\": 0,","+    }","+    ds = _deploy_running(","+        dsm,","+        TEST_DEPLOYMENT_ID,","+        num_replicas=3,","+        version=\"1\",","+        autoscaling_config=autoscaling_config,","+    )","+    v1 = ds.target_version","+","+    def versions():","+        details = dsm.get_deployment_details(TEST_DEPLOYMENT_ID)","+        return details.target_version, sorted(","+            (r.state, r.version) for r in details.replicas","+        )","+","+    def settle_one_batch():","+        for replica in ds._replicas.get(states=[ReplicaState.STOPPING]):","+            replica._actor.set_done_stopping()","+        for replica in ds._replicas.get(states=[ReplicaState.STARTING]):","+            replica._actor.set_ready()","+        dsm.update()","+","+    assert versions() == (v1.version_id, [(ReplicaState.RUNNING, v1.version_id)] * 3)","+","+    # A code change replaces replicas one at a time. Once a new one runs,","+    # autoscaling hides the rolling update behind an UPSCALING status while an","+    # old replica is still RUNNING.","+    info_2, v2 = deployment_info(","+        num_replicas=3, version=\"2\", autoscaling_config=autoscaling_config","+    )","+    assert dsm.deploy(TEST_DEPLOYMENT_ID, info_2)","+    dsm.update()","+    settle_one_batch()","+    assert dsm.autoscale(TEST_DEPLOYMENT_ID, 6)","+    dsm.update()","+    assert ds.curr_status_info.status == DeploymentStatus.UPSCALING","+    assert ds.curr_status_info.status_trigger == DeploymentStatusTrigger.AUTOSCALING","+    target, replicas = versions()","+    assert target == v2.version_id != v1.version_id","+    assert (ReplicaState.RUNNING, v1.version_id) in replicas","+    assert (ReplicaState.RUNNING, v2.version_id) in replicas","+","+    for _ in range(6):","+        settle_one_batch()","+    assert versions() == (v2.version_id, [(ReplicaState.RUNNING, v2.version_id)] * 6)","+","+","+def test_details_report_versions_through_recovery(mock_deployment_state_manager):","+    \"\"\"A recovering replica carries the target version until its actor answers.\"\"\"","+    create_dsm, _, _, _ = mock_deployment_state_manager","+    dsm: DeploymentStateManager = create_dsm()","+    autoscaling_config = {","+        \"min_replicas\": 1,","+        \"max_replicas\": 10,","+        \"initial_replicas\": 2,","+        \"upscale_delay_s\": 0,","+        \"downscale_delay_s\": 0,","+    }","+    ds = _deploy_running(","+        dsm,","+        TEST_DEPLOYMENT_ID,","+        num_replicas=2,","+        version=\"1\",","+        autoscaling_config=autoscaling_config,","+    )","+    v1 = ds.target_version","+    dsm.save_checkpoint()","+    old_replicas = ds._replicas.get()","+","+    # Checkpoint the new target, then simulate a controller restart.","+    info_2, v2 = deployment_info(","+        num_replicas=2, version=\"2\", autoscaling_config=autoscaling_config","+    )","+    assert dsm.deploy(TEST_DEPLOYMENT_ID, info_2)","+    dsm.save_checkpoint()","+    new_dsm = create_dsm([r.replica_id.to_full_id_str() for r in old_replicas])","+    new_ds = new_dsm._get_deployment_state_for_testing(TEST_DEPLOYMENT_ID)","+","+    def versions():","+        details = new_dsm.get_deployment_details(TEST_DEPLOYMENT_ID)","+        return details.target_version, sorted(","+            (r.state, r.version) for r in details.replicas","+        )","+","+    # Both old replicas report the provisional target version while recovering.","+    assert versions() == (","+        v2.version_id,","+        [(ReplicaState.RECOVERING, v2.version_id)] * 2,","+    )","+","+    # Recover one actor at the new version, then autoscale. Both version IDs","+    # match the target, but the other actor's version is still unconfirmed.","+    recovering = new_ds._replicas.get()","+    recovering[0]._actor.set_ready(v2)","+    new_dsm.update()","+    assert new_dsm.autoscale(TEST_DEPLOYMENT_ID, 3)","+    new_dsm.update()","+    assert new_ds.curr_status_info.status == DeploymentStatus.UPSCALING","+    assert new_ds.curr_status_info.status_trigger == DeploymentStatusTrigger.AUTOSCALING","+    target, replicas = versions()","+    assert target == v2.version_id","+    assert (ReplicaState.RECOVERING, v2.version_id) in replicas","+    assert (ReplicaState.RUNNING, v2.version_id) in replicas","+","+    # The other actor answers with its real, old version.","+    recovering[1]._actor.set_ready(v1)","+    new_dsm.update()","+    target, replicas = versions()","+    assert (ReplicaState.RUNNING, v1.version_id) in replicas","+    assert (ReplicaState.RECOVERING, v2.version_id) not in replicas","+","+","+def test_details_report_version_while_reconfiguring(mock_deployment_state_manager):","+    \"\"\"A replica mid-reconfigure already carries the new version.\"\"\"","+    create_dsm, _, _, _ = mock_deployment_state_manager","+    dsm: DeploymentStateManager = create_dsm()","+    ds = _deploy_running(dsm, TEST_DEPLOYMENT_ID, version=\"1\")","+    v1 = ds.target_version","+","+    info_2, v2 = deployment_info(version=\"1\", user_config={\"a\": 1})","+    assert v2 != v1","+    assert dsm.deploy(TEST_DEPLOYMENT_ID, info_2)","+    dsm.update()","+    details = dsm.get_deployment_details(TEST_DEPLOYMENT_ID)","+    assert details.target_version == v2.version_id","+    assert [(r.state, r.version) for r in details.replicas] == [","+        (ReplicaState.UPDATING, v2.version_id)","+    ]","+","+"," def test_deploy_new_config_same_code_version_2(mock_deployment_state_manager):","     \"\"\"Make sure we don't transition from STARTING to UPDATING directly.\"\"\""," "],"additions":141,"deletions":0,"truncated":false},{"path":"python/ray/serve/tests/unit/test_schema.py","lines":["@@ -25,9 +25,11 @@"," from ray.serve.deployment import Deployment, deployment_to_schema, schema_to_deployment"," from ray.serve.schema import (","     ControllerHealthMetrics,","+    DeploymentDetails,","     DeploymentSchema,","     LoggingConfig,","     RayActorOptionsSchema,","+    ReplicaDetails,","     ServeApplicationSchema,","     ServeDeploySchema,","     ServeInstanceDetails,","@@ -1552,6 +1554,47 @@ def test_serve_instance_details_restores_unset_config_options_is_opt_in():","     assert reported[\"restores_unset_config_options\"] is True"," "," ","+def test_deploy_schema_config_id_is_optional_and_echoed():","+    \"\"\"`config_id` is metadata: optional on the way in, reported back as applied.\"\"\"","+    assert ServeDeploySchema.model_validate({\"applications\": []}).config_id is None","+    cfg = ServeDeploySchema.model_validate({\"applications\": [], \"config_id\": \"c1\"})","+    assert cfg.config_id == \"c1\"","+    assert cfg.model_dump(exclude_unset=True)[\"config_id\"] == \"c1\"","+","+    details = ServeInstanceDetails(","+        controller_info={\"node_id\": \"fake_node_id\"},","+        proxy_location=\"EveryNode\",","+        proxies={},","+        applications={},","+    )","+    assert details.applied_config_id is None","+    reported = ServeInstanceDetails(","+        controller_info={\"node_id\": \"fake_node_id\"},","+        proxy_location=\"EveryNode\",","+        proxies={},","+        applications={},","+        applied_config_id=\"c1\",","+    )._get_user_facing_json_serializable_dict(exclude_unset=True)","+    assert reported[\"applied_config_id\"] == \"c1\"","+","+","+def test_replica_and_deployment_versions_default_to_none():","+    \"\"\"Versions are optional so older payloads still parse.\"\"\"","+    replica = ReplicaDetails(replica_id=\"r\", state=\"RUNNING\", start_time_s=0)","+    assert replica.version is None","+    deployment = DeploymentDetails(","+        name=\"d\",","+        status=\"HEALTHY\",","+        status_trigger=\"CONFIG_UPDATE_COMPLETED\",","+        message=\"\",","+        deployment_config={\"name\": \"d\"},","+        target_num_replicas=1,","+        required_resources={},","+        replicas=[replica],","+    )","+    assert deployment.target_version is None","+","+"," def test_serve_instance_details_includes_controller_health_metrics():","     \"\"\"When controller_health_metrics is explicitly set, it should appear in the","     user-facing JSON-serializable representation.\"\"\"",""],"additions":43,"deletions":0,"truncated":false}],"additions":392,"deletions":2,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-10-30T15:55:57.191383+00:00"}