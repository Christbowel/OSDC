,"+public delegate int KindCallback(KindCallbackValue? value);","+","+public delegate object ReferenceCallback(ReferenceCallbackValue value);","+","+public static class DelegateCaller","+{","+    [MethodImpl(MethodImplOptions.NoInlining)]","+    public static int Invoke(Callback callback)","+    {","+        return callback(null);","+    }","+","+    [MethodImpl(MethodImplOptions.NoInlining)]","+    public static int Invoke(KindCallback callback)","+    {","+        return callback(null);","+    }","+","+    [MethodImpl(MethodImplOptions.NoInlining)]","+    public static int Invoke(ReferenceCallback callback)","+    {","+        object instance = new object();","+        WeakReference reference = new WeakReference(instance);","+        object result = callback(new ReferenceCallbackValue { Value = instance });","+        return result is not null && object.ReferenceEquals(result, reference.Target) ? 100 : 101;","+    }","+}"],"additions":45,"deletions":0,"truncated":false},{"path":"src/tests/Regressions/coreclr/GitHub_136814/delegatecaller.csproj","lines":["@@ -0,0 +1,8 @@","+<Project Sdk=\"Microsoft.NET.Sdk\">","+  <PropertyGroup>","+    <OutputType>Library</OutputType>","+  </PropertyGroup>","+  <ItemGroup>","+    <Compile Include=\"delegatecaller.cs\" />","+  </ItemGroup>","+</Project>"],"additions":8,"deletions":0,"truncated":false},{"path":"src/tests/Regressions/coreclr/GitHub_136814/test136814.cs","lines":["@@ -0,0 +1,66 @@","+// Licensed to the .NET Foundation under one or more agreements.","+// The .NET Foundation licenses this file to you under the MIT license.","+","+using System;","+using System.Runtime;","+using System.Runtime.CompilerServices;","+using Xunit;","+","+namespace System.Runtime","+{","+    [AttributeUsage(AttributeTargets.Method)]","+    internal sealed class BypassReadyToRunAttribute : Attribute","+    {","+    }","+}","+","+// This regression test only has strong meaning when run under GCStress, and covers the R2R","+// delegate-constructor path only when the test assemblies are also compiled with crossgen2.","+// Without GCStress, it passes without exercising the fix.","+[OuterLoop]","+public class Test136814","+{","+    [Fact]","+    public static int TestEntryPoint()","+    {","+        Test136814 test = new Test136814();","+        if (DelegateCaller.Invoke(test.Target) != 100)","+        {","+            return 101;","+        }","+","+        return CreateDelegateInJittedCode(test);","+    }","+","+    [Fact]","+    public static int ReferenceContainingStruct()","+    {","+        return DelegateCaller.Invoke(new Test136814().ReferenceTarget);","+    }","+","+    // Use a separate signature type so the first case cannot have loaded it already.","+    [BypassReadyToRun]","+    [MethodImpl(MethodImplOptions.NoInlining)]","+    private static int CreateDelegateInJittedCode(Test136814 test)","+    {","+        return DelegateCaller.Invoke(test.JittedConstructionTarget);","+    }","+","+    [BypassReadyToRun]","+    private int Target(CallbackValue? value)","+    {","+        return 100;","+    }","+","+    [BypassReadyToRun]","+    private int JittedConstructionTarget(KindCallbackValue? value)","+    {","+        return 100;","+    }","+","+    [BypassReadyToRun]","+    private object ReferenceTarget(ReferenceCallbackValue value)","+    {","+        return value.Value;","+    }","+}"],"additions":66,"deletions":0,"truncated":false},{"path":"src/tests/Regressions/coreclr/GitHub_136814/test136814.csproj","lines":["@@ -0,0 +1,9 @@","+<Project Sdk=\"Microsoft.NET.Sdk\">","+  <PropertyGroup>","+    <Optimize>true</Optimize>","+  </PropertyGroup>","+  <ItemGroup>","+    <Compile Include=\"test136814.cs\" />","+    <ProjectReference Include=\"delegatecaller.csproj\" />","+  </ItemGroup>","+</Project>",""],"additions":9,"deletions":0,"truncated":false}],"additions":356,"deletions":24,"truncated":false,"file_count":17},"error":null,"fetched_at":"2026-11-13T17:05:03.530526+00:00"}