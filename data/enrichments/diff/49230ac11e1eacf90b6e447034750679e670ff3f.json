{"id":"49230ac11e1eacf90b6e447034750679e670ff3f","axis":"silent","repo":"pnpm/pnpm","sha":"49230ac11e1eacf90b6e447034750679e670ff3f","parsed":{"files":[{"path":"pnpm/crates/cli/src/config_deps/network.rs","lines":["@@ -1,4 +1,4 @@","-use pnpm_config::Config;","+use pnpm_config::{Config, NetworkPolicy};"," use pnpm_network::{RetryOpts, ThrottledClient};"," use pnpm_resolving_npm_resolver::{","     InMemoryPackageMetaCache, NpmResolver, shared_packument_fetch_locker,","@@ -36,8 +36,7 @@ impl EnvironmentNetwork {","                 filter_metadata: config.requires_full_metadata_for_resolution(),","             },","             cache_policy: pnpm_resolving_npm_resolver::MetadataCachePolicy {","-                offline: self.offline,","-                prefer_offline: config.prefer_offline,","+                network: NetworkPolicy::from_settings(self.offline, config.prefer_offline),","                 ignore_missing_time_field: config.minimum_release_age_ignore_missing_time,","             },","             store_view: pnpm_resolving_npm_resolver::OfflineStoreView::open_for_offline("],"additions":2,"deletions":3,"truncated":false},{"path":"pnpm/crates/config/src/lib.rs","lines":["@@ -30,6 +30,7 @@ pub use crate::{"," };"," pub use cas::{CAS_LOADER_FILENAME, CAS_MANIFEST_FILENAME};"," pub use loading::ConfigLoadFailure;","+pub use network_policy::NetworkPolicy;"," pub use node_linker::{NodeLinkerOptions, NodeLinkerSetting};"," pub use pnpm_matcher as matcher;"," pub use setting_types::{","@@ -346,6 +347,7 @@ mod registry_options;"," mod layout;"," "," mod loading;","+mod network_policy;"," "," mod derive_layout;"," "],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/network_policy.rs","lines":["@@ -0,0 +1,76 @@","+use crate::Config;","+","+/// Which sources a resolve may read registry metadata from, and in which","+/// order.","+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]","+pub enum NetworkPolicy {","+    /// The registry settles every pick whose answer fresh metadata could","+    /// change. The mirror answers the rest.","+    #[default]","+    Online,","+    /// The mirror answers first and its pick is taken unverified. The","+    /// registry is the fallback.","+    PreferCache,","+    /// The registry is not a source. A pick the mirror and the store cannot","+    /// settle fails instead.","+    Offline,","+}","+","+impl NetworkPolicy {","+    /// The policy the `offline` and `preferOffline` settings describe","+    /// between them.","+    ///","+    /// `offline` withdraws the registry that `preferOffline` only reorders,","+    /// so it decides alone and the pair describes three states, not four.","+    #[must_use]","+    pub fn from_settings(offline: bool, prefer_offline: bool) -> Self {","+        match (offline, prefer_offline) {","+            (true, _) => Self::Offline,","+            (false, true) => Self::PreferCache,","+            (false, false) => Self::Online,","+        }","+    }","+","+    /// Whether the registry is out of reach, leaving the mirror and the","+    /// store as the only sources.","+    #[must_use]","+    pub fn forbids_registry(self) -> bool {","+        match self {","+            Self::Online | Self::PreferCache => false,","+            Self::Offline => true,","+        }","+    }","+","+    /// Whether the mirror is read before the registry. Its negation is the","+    /// pick the registry decides, which may not be settled from the mirror","+    /// at all when fresh metadata could change the answer.","+    #[must_use]","+    pub fn reads_cache_first(self) -> bool {","+        match self {","+            Self::Online => false,","+            Self::PreferCache | Self::Offline => true,","+        }","+    }","+","+    /// Whether the mirror is preferred while the registry remains","+    /// reachable, which is the one state in which a cached pick is taken","+    /// unverified rather than for want of an alternative.","+    #[must_use]","+    pub fn prefers_reachable_cache(self) -> bool {","+        match self {","+            Self::Online | Self::Offline => false,","+            Self::PreferCache => true,","+        }","+    }","+}","+","+impl Config {","+    /// See [`NetworkPolicy::from_settings`].","+    #[must_use]","+    pub fn network_policy(&self) -> NetworkPolicy {","+        NetworkPolicy::from_settings(self.offline, self.prefer_offline)","+    }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":76,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/network_policy/tests.rs","lines":["@@ -0,0 +1,24 @@","+use super::NetworkPolicy;","+use pretty_assertions::assert_eq;","+","+#[test]","+fn offline_decides_alone() {","+    assert_eq!(NetworkPolicy::from_settings(true, false), NetworkPolicy::Offline);","+    assert_eq!(NetworkPolicy::from_settings(true, true), NetworkPolicy::Offline);","+}","+","+#[test]","+fn prefer_offline_decides_while_the_registry_is_reachable() {","+    assert_eq!(NetworkPolicy::from_settings(false, true), NetworkPolicy::PreferCache);","+    assert_eq!(NetworkPolicy::from_settings(false, false), NetworkPolicy::Online);","+}","+","+#[test]","+fn each_state_answers_the_three_questions_differently() {","+    let answers = |policy: NetworkPolicy| {","+        (policy.forbids_registry(), policy.reads_cache_first(), policy.prefers_reachable_cache())","+    };","+    assert_eq!(answers(NetworkPolicy::Online), (false, false, false));","+    assert_eq!(answers(NetworkPolicy::PreferCache), (false, true, true));","+    assert_eq!(answers(NetworkPolicy::Offline), (true, true, false));","+}"],"additions":24,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_package_from_registry/tests.rs","lines":["@@ -306,8 +306,7 @@ async fn resolve_via_mock(","             filter_metadata: false,","         },","         cache_policy: pnpm_resolving_npm_resolver::MetadataCachePolicy {","-            offline: false,","-            prefer_offline: false,","+            netw