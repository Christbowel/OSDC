a: false,","         cache_policy: crate::MetadataCachePolicy {","-            offline: false,","-            prefer_offline: false,","+            network: pnpm_config::NetworkPolicy::Online,","             ignore_missing_time_field: false,","         },","         store_view: None,","@@ -497,8 +489,7 @@ async fn public_scope_falls_back_to_mirror_on_401() {","         needs_full_metadata_for: None,","         filter_metadata: false,","         cache_policy: crate::MetadataCachePolicy {","-            offline: false,","-            prefer_offline: false,","+            network: pnpm_config::NetworkPolicy::Online,","             ignore_missing_time_field: false,","         },","         store_view: None,"],"additions":9,"deletions":18,"truncated":false},{"path":"pnpm/crates/resolving-npm-resolver/src/pick_package/tests/cache_policy.rs","lines":["@@ -0,0 +1,507 @@","+//! What the three [`pnpm_config::NetworkPolicy`] states decide between,","+//! told apart by whether the registry is contacted at all. The `offline` and","+//! `preferOffline` settings reach the picker only through that policy.","+","+use super::{","+    ABBREVIATED_META_DIR, AuthHeaders, InMemoryPackageMetaCache, PACKAGE_BODY, PickPackageContext,","+    PickPackageError, PickPackageOptions, RetryOpts, TempDir, ThrottledClient, assert_eq,","+    default_opts, get_pkg_mirror_path, persist_meta_to_mirror, pick_package, range_spec,","+    shared_packument_fetch_locker,","+};","+","+/// A warm mirror alone does not force a fetch: an online pick may return a","+/// range's stable mirror pick unverified. `include_latest_tag` is one of the","+/// conditions that withdraws that shortcut, and then only the registry can","+/// answer. This test and the next differ only in the policy, `Online`","+/// against `PreferCache`.","+/// The pick reduced to a label, so a scenario table can assert on it.","+fn outcome_label(result: Result<crate::PickPackageResult, PickPackageError>) -> String {","+    match result {","+        Ok(result) => result.picked_package.map_or_else(","+            || \"none\".to_string(),","+            |picked| picked.version.to_string(),","+        ),","+        Err(PickPackageError::NoOfflineMeta { .. }) => \"no-offline-meta\".to_string(),","+        Err(error) => format!(\"{error:?}\"),","+    }","+}","+","+#[tokio::test]","+async fn an_online_pick_verifies_an_unstable_mirror_pick_against_the_registry() {","+    let preloaded: pnpm_registry::Package =","+        serde_json::from_str(PACKAGE_BODY).expect(\"parse packument\");","+    let mut server = mockito::Server::new_async().await;","+    let mock = server","+        .mock(\"GET\", \"/acme\")","+        .with_status(200)","+        .with_body(PACKAGE_BODY)","+        .expect(1)","+        .create_async()","+        .await;","+    let registry = format!(\"{}/\", server.url());","+    let cache_dir = TempDir::new().expect(\"tempdir\");","+    persist_meta_to_mirror(cache_dir.path(), ABBREVIATED_META_DIR, &registry, &preloaded)","+        .expect(\"warm the mirror\");","+","+    let http_client = ThrottledClient::default();","+    let auth_headers = AuthHeaders::default();","+    let meta_cache = InMemoryPackageMetaCache::default();","+    let fetch_locker = shared_packument_fetch_locker();","+    let ctx = PickPackageContext {","+        full_metadata: false,","+        needs_full_metadata_for: None,","+        filter_metadata: false,","+        cache_policy: crate::MetadataCachePolicy {","+            network: pnpm_config::NetworkPolicy::Online,","+            ignore_missing_time_field: false,","+        },","+        store_view: None,","+        metadata: crate::MetadataRequestContext {","+            meta_cache: &meta_cache,","+            fetch_locker: &fetch_locker,","+            cache_dir: Some(cache_dir.path()),","+            http: crate::MetadataHttpClient {","+                http_client: &http_client,","+                auth_headers: &auth_headers,","+                retry_opts: RetryOpts::default(),","+            },","+        },","+    };","+    let opts = PickPackageOptions { include_latest_tag: true, ..default_opts(&registry) };","+","+    let result =","+        pick_package(&ctx, &range_spec(\"acme\", \"^1.0.0\"), &opts).await.expect(\"the pick succeeds\");","+    assert_eq!(result.picked_package.expect(\"picked\").version.to_string(), \"1.1.0\");","+    mock.assert_async().await;","+}","+","+#[tokio::test]","+async fn prefer_offline_accepts_the_mirror_pick_the_registry_would_have_verified() {","+    let preloaded: pnpm_registry::Package =","+        serde_json::from_str(PACKAGE_BODY).expect(\"parse packument\");","+    let mut server = mockito::Server::new_async().await;","+    let mock = server","+        .mock(\"GET\", \"/acme\")","+        .with_status(200)","+        .expect(0)","+        .create_async()","+        .await;","+    let registry = format!(\"{}/\", server.url());","+    let cache_dir = TempDir::new().expect(\"tempdir\");","+    persist_meta_to_mirror(cache_dir.path(), ABBREVIATED_META_DIR, &registry, &preloaded)","+        .expect(\"warm the mirror\");","+","+    let http_client = ThrottledClient::default();","+    let auth_headers = AuthHeaders::default();"],"additions":95,"deletions":0,"truncated":false}],"additions":246,"deletions":75,"truncated":true,"file_count":25},"error":null,"fetched_at":"2026-10-15T13:21:35.520522+00:00"}