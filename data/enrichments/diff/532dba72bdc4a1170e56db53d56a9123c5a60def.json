{"id":"532dba72bdc4a1170e56db53d56a9123c5a60def","axis":"silent","repo":"pnpm/pnpm","sha":"532dba72bdc4a1170e56db53d56a9123c5a60def","parsed":{"files":[{"path":".changeset/quiet-rosters-recover.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": patch","+---","+","+pnpr now refuses stale authorization when a team roster, managed access rule, or SCIM directory read exceeds five seconds. A stalled roster or rule read no longer delays SCIM refreshes. [pnpm/pnpm#17836](https://github.com/pnpm/pnpm/issues/17836)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/Cargo.toml","lines":["@@ -125,7 +125,7 @@ pnpm-testing-utils = { workspace = true }"," pnpr-fixtures = { workspace = true }"," pnpr-libsql = { workspace = true, features = [\"testing\"] }"," tempfile = { workspace = true }","-tokio = { workspace = true }","+tokio = { workspace = true, features = [\"test-util\"] }"," tower = { workspace = true }"," "," [target.'cfg(not(target_family = \"wasm\"))'.dependencies]"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/managed_state.rs","lines":["@@ -9,10 +9,13 @@ use pnpr_config::{Management, Teams};"," use pnpr_policy::RuleTable;"," use pnpr_storage::{DocumentWrite, RegistryRecord};"," use std::{","+    future::Future,","     sync::{Arc, Mutex, PoisonError},","-    time::{Duration, Instant},","+    time::Duration,"," };","-use tokio::sync::OwnedMutexGuard;","+use tokio::{sync::OwnedMutexGuard, time::Instant};","+","+const READ_DEADLINE: Duration = Duration::from_secs(5);"," "," /// Minimum interval between successful request-triggered background reloads."," const STATE_TTL: Duration = Duration::from_secs(10);","@@ -101,23 +104,41 @@ pub(super) async fn refresh_managed_state(state: &AppState) {","     }"," }"," ","-/// Read every managed record concurrently, publishing each as soon as its own","-/// read finishes, so a slow registry does not hold back another's change.","-/// Rosters load before rules, because a rule can name a team.","+/// Reload SCIM alongside registry rosters and rules, publishing each record","+/// as its read finishes. Rosters load before rules, because a rule can name a team."," async fn reload_managed_state(state: AppState, _reload: OwnedMutexGuard<()>) {","+    let managed = &state.inner.identity.managed;","+    let directory = async {","+        match &managed.scim {","+            Some(scim) => reload_directory(&state, scim).await,","+            None => true,","+        }","+    };","+    let registries = reload_registries(&state);","+    let (registries_read, scim_read) = tokio::join!(registries, directory);","+    let all_read = registries_read && scim_read;","+    managed.schedule(if all_read { STATE_TTL } else { STATE_RETRY });","+}","+","+async fn reload_registries(state: &AppState) -> bool {","     let managed = &state.inner.identity.managed;","     let rosters =","-        managed.roster_seeds.iter().map(|(registry, seed)| reload_roster(&state, registry, seed));","+        managed.roster_seeds.iter().map(|(registry, seed)| reload_roster(state, registry, seed));","     let rosters_read = join_all(rosters).await.into_iter().all(|read| read);","     let rules =","-        managed.rule_bases.iter().map(|(registry, base)| reload_rules(&state, registry, base));","+        managed.rule_bases.iter().map(|(registry, base)| reload_rules(state, registry, base));","     let rules_read = join_all(rules).await.into_iter().all(|read| read);","-    let scim_read = match &managed.scim {","-        Some(scim) => reload_directory(&state, scim).await,","-        None => true,","-    };","-    let all_read = rosters_read && rules_read && scim_read;","-    managed.schedule(if all_read { STATE_TTL } else { STATE_RETRY });","+    rosters_read && rules_read","+}","+","+/// Bound refresh reads without cancelling writes whose commit outcome could be unknown.","+pub(super) async fn read_with_deadline<Output>(","+    read: impl Future<Output = Result<Output, RegistryError>>,","+) -> Result<Output, RegistryError> {","+    tokio::time::timeout(READ_DEADLINE, read).await","+        .map_err(|_| RegistryError::Internal {","+            reason: \"the managed authorization record read exceeded its deadline\".to_string(),","+        })?"," }"," "," /// Canonicalize a registry key as `<ecosystem>/<local_name>`, regardless of"],"additions":34,"deletions":13,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/rule_overrides.rs","lines":["@@ -1,7 +1,7 @@"," use super::{","     AppState, RegistryError,","     ecosystem::sha256_hex,","-    managed_state::{WRITE_ATTEMPTS, store_registry_record},","+    managed_state::{WRITE_ATTEMPTS, read_with_deadline, store_registry_record},"," };"," use pnpr_config::{TeamDirectory, compile_access_list};"," use pnpr_policy::{AccessList, AccessToken, RuleOverride, RuleTable};","@@ -52,7 +52,7 @@ enum Compile {"," /// that cannot be read or applied fail closed: every list of the registry"," /// admits nobody until a read succeeds. Reports whether the read succeeded."," pub(super) async fn reload_rules(state: &AppState, registry: &str, base: &RuleTable) -> bool {","-    let (table, read) = match read_rules(state, registry, base).await {","+    let (table, read) = match read_with_deadline(read_rules(state, registry, base)).await {","         Ok((table, _)) => (table, true),","         Err(err) => {","             tracing::error!(registry, error = %err, \"could not apply a registry's stored rules; it admits nobody\");"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/scim/directory.rs","lines":["@@ -3,7 +3,7 @@"," "," use super::super::{","     AppState, RegistryError,","-    managed_state::{WRITE_ATTEMPTS, store_registry_record},","+    managed_state::{WRITE_ATTEMPTS, read_with_deadline, store_registry_record},"," };"," use pnpr_storage::{RegistryRecord, SCIM_DIRECTORY};"," use serde::{Deserialize, Serialize};","@@ -130,7 +130,7 @@ fn directory_entry(state: &AppState, user_id: &str) -> Result<Option<bool>, Regi"," /// [`is_deprovisioned`] fails closed until a read succeeds. Reports whether the read"," /// succeeded."," pub(in super::super) async fn reload_directory(state: &AppState, scim: &ScimState) -> bool {","-    match read_directory(state).await {","+    match read_with_deadline(read_directory(state)).await {","         Ok((directory, _)) => {","             scim.publish(state, &directory);","             true"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/team_rosters.rs","lines":["@@ -1,6 +1,6 @@"," use super::{","     AppState, RegistryError,","-    managed_state::{WRITE_ATTEMPTS, store_registry_record},","+    managed_state::{WRITE_ATTEMPTS, read_with_deadline, store_registry_record},"," };"," use pnpr_config::Teams;"," use pnpr_storage::RegistryRecord;","@@ -9,7 +9,7 @@ use serde::{Deserialize, Serialize};"," /// Publish one registry's stored roster, or an empty one when it cannot be"," /// read. Reports whether the read succeeded."," pub(super) async fn reload_roster(state: &AppState, registry: &str, seed: &Teams) -> bool {","-    let (teams, read) = match read_roster(state, registry, seed).await {","+    let (teams, read) = match read_with_deadline(read_roster(state, registry, seed)).await {","         Ok(teams) => (teams, true),","         Err(err) => {","             tracing::error!(registry, error = %err, \"could not read a team roster; its teams admit nobody\");"],"additions":2,"deletions":2,"truncated":false},{"path":"pnpr/crates/pnpr/tests/common/pausing_store.rs","lines":["@@ -10,7 +10,7 @@ use tokio::sync::Notify;"," #[derive(Debug, Default)]"," pub struct PausingStore {","     inner: InMemory,","-    filename: Mutex<Option<String>>,","+    filenames: Mutex<Vec<String>>,","     write_filename: Mutex<Option<String>>,","     pub started: Notify,","     pub resume: Notify,","@@ -22,7 +22,10 @@ impl PausingStore {","     }"," ","     pub fn pause(&self, filename: String) {","-        *self.filename.lock().unwrap() = Some(filename);","+        self.filenames","+            .lock()","+            .unwrap()","+            .push(filename);","     }"," }"," ","@@ -40,14 +43,15 @@ impl ObjectStore for PausingStore {","         options: GetOptions,","     ) -> object_store::Result<GetResult> {","         let pause = {","-            let mut filename = self.filename.lock().unwrap();","-            let pause = filename","-                .as_ref()","-                .is_some_and(|filename| location.filename() == Some(filename.as_str()));","-            if pause {","-                *filename = None;","-            }","-            pause","+            let mut filenames = self.filenames.lock().unwrap();","+            let position = filenames","+                .iter()","+                .position(|filename| {","+                    location.filename() == Some(filename.as_str()) || location.as_ref() == filename","+                });","+            position","+                .map(|position| filenames.remove(position))","+                .is_some()","         };","         if pause {","             self.started.notify_one();"],"additions":14,"deletions":10,"truncated":false},{"path":"pnpr/crates/pnpr/tests/managed_refresh.rs","lines":["@@ -0,0 +1,215 @@","+use crate::{pausing_store::PausingStore, tokens::seeded_auth};","+use axum::{","+    Router,","+    body::Body,","+    http::{Request, StatusCode},","+};","+use object_store::{ObjectStoreExt, path::Path};","+use pnpr::{Config, HostedStoreConfig, router_with_auth};","+use pnpr_config::MetadataBackend;","+use pnpr_package_name::{CanonicalPackageName, Ecosystem};","+use pnpr_storage::{HostedDocumentVersion, Storage};","+use std::{sync::Arc, time::Duration};","+use tempfile::TempDir;","+use tower::ServiceExt;","+","+struct Replica {","+    app: Router,","+    token: String,","+    objects: Arc<PausingStore>,","+    _directory: TempDir,","+    _clock: ManualClock,","+}","+","+struct ManualClock(tokio::task::JoinHandle<()>);","+","+impl ManualClock {","+    fn new() -> Self {","+        // Keep the runtime ready so database I/O cannot auto-advance the test clock.","+        Self(tokio::spawn(async {","+            loop {","+                tokio::task::yield_now().await;","+            }","+        }))","+    }","+}","+","+impl Drop for ManualClock {","+    fn drop(&mut self) {","+        self.0.abort();","+    }","+}","+","+impl Replica {","+    async fn new() -> Self {","+        let clock = ManualClock::new();","+        let directory = TempDir::new().unwrap();","+        let path = directory.path().join(\"config.yaml\");","+        std::fs::write(","+            &path,","+            format!(","+                r\"","+storage: '{}'","+auth:","+  scim:","+    token: test-scim-secret-0123456789abcdef0123456789","+registries:","+  local:","+    type: hosted","+    org: ''","+    teamsManagedBy: api","+    rulesManagedBy: api","+    teams:","+      readers: {{ name: readers, members: [reader] }}","+    packages:","+      '**':","+        access: [team:readers]","+defaultRegistry: local","+\",","+                directory","+                    .path()","+                    .join(\"storage\")","+                    .display(),","+            ),","+        )","+        .unwrap();","+        let mut config = Config::from_yaml(&path, \"127.0.0.1:0\".parse().unwrap(), None).unwrap();","+        let objects = Arc::new(PausingStore::default());","+        config.storage.hosted_backend = HostedStoreConfig::ObjectStore {","+            store: Arc::<PausingStore>::clone(&objects),","+            prefix: String::new(),","+        };","+        config.storage.metadata = MetadataBackend::Sqlite(directory.path().join(\"metadata.sqlite\"));","+        let storage = Storage::from_config(&config.storage).unwrap();","+        let package = CanonicalPackageName::parse(\"example\", Ecosystem::Npm).unwrap();","+        storage","+            .write_hosted_document_if_current(","+                &package,","+                br#\"{\"name\":\"example\",\"versions\":{},\"dist-tags\":{}}\"#,","+                Some(&HostedDocumentVersion::Unversioned),","+                None,","+            )","+            .await","+            .unwrap();","+        let auth = seeded_auth(&config, &[(\"reader\", \"password\")]);","+        let token = auth.tokens.issue(\"reader\").await.unwrap();","+        let app = router_with_auth(config, auth);","+        Self { app, token, objects, _directory: directory, _clock: clock }","+    }","+","+    async fn get(&self, path: &str) -> StatusCode {","+        self.app","+            .clone()","+            .oneshot(","+                Request::get(path)","+                    .header(\"authorization\", format!(\"Bearer {}\", self.token))","+                    .body(Body::empty())","+                    .unwrap(),","+            )","+            .await","+            .unwrap()","+            .status()","+    }","+","+    async fn expect_status(&self, path: &str, expected: StatusCode) {","+        for _ in 0..100 {","+            if self.get(path).await == expected {","+                return;","+            }","+            tokio::task::yield_now().await;","+        }","+        assert_eq!(self.get(path).await, expected);","+    }","+","+    async fn start_stalled_refresh(&self, records: &[&str]) {","+        assert_eq!(self.get(\"/npm/example\").await, StatusCode::OK);","+        for record in records {","+            self.objects.pause((*record).to_string());","+        }","+        tokio::time::advance(Duration::from_secs(10)).await;","+        assert_eq!(self.get(\"/npm/example\").await, StatusCode::OK);","+        self.objects.started.notified().await;","+        tokio::time::advance(Duration::from_secs(4)).await;","+        assert_eq!(self.get(\"/npm/example\").await, StatusCode::OK);","+        tokio::time::advance(Duration::from_secs(1)).await;","+    }","+}","+","+#[tokio::test(start_paused = true)]","+async fn stalled_roster_denies_stale_membership_and_retries() {","+    let replica = Replica::new().await;","+    replica.start_stalled_refresh(&[\".team-rosters/npm/local.json\"]).await;","+    replica.expect_status(\"/npm/example\", StatusCode::FORBIDDEN).await;","+    tokio::time::advance(Duration::from_secs(1)).await;","+    replica.expect_status(\"/npm/example\", StatusCode::OK).await;","+    replica.objects","+        .put(&Path::from(\".team-rosters/npm/local.json\"), br#\"{\"teams\":[]}\"#.to_vec().into())","+        .await","+        .unwrap();","+    tokio::time::advance(Duration::from_secs(10)).await;","+    replica.expect_status(\"/npm/example\", StatusCode::FORBIDDEN).await;","+}","+","+#[tokio::test(start_paused = true)]","+async fn stalled_rules_deny_stale_access_and_recover() {","+    let replica = Replica::new().await;","+    replica.start_stalled_refresh(&[\".rule-overrides/npm/local.json\"]).await;","+    replica.expect_status(\"/npm/example\", StatusCode::NOT_FOUND).await;","+    tokio::time::advance(Duration::from_secs(1)).await;","+    replica.expect_status(\"/npm/example\", StatusCode::OK).await;","+}","+","+#[tokio::test(start_paused = true)]","+async fn stalled_scim_refuses_credentials_and_recovers() {","+    let replica = Replica::new().await;","+    replica.start_stalled_refresh(&[\".scim-users/directory.json\"]).await;","+    replica.expect_status(\"/-/whoami\", StatusCode::INTERNAL_SERVER_ERROR).await;","+    tokio::time::advance(Duration::from_secs(1)).await;","+    replica.expect_status(\"/-/whoami\", StatusCode::OK).await;","+}","+","+#[tokio::test(start_paused = true)]","+async fn stalled_roster_does_not_delay_the_scim_deadline() {","+    let replica = Replica::new().await;","+    replica.start_stalled_refresh(&[\".team-rosters/npm/local.json\", \".scim-users/directory.json\"])","+        .await;","+    replica.expect_status(\"/-/whoami\", StatusCode::INTERNAL_SERVER_ERROR).await;","+    tokio::time::advance(Duration::from_secs(1)).await;","+    replica.expect_status(\"/-/whoami\", StatusCode::OK).await;","+}","+","+#[tokio::test(start_paused = true)]","+async fn stalled_rules_do_not_delay_the_scim_deadline() {","+    let replica = Replica::new().await;","+    replica.start_stalled_refresh(&[","+        \".rule-overrides/npm/local.json\",","+        \".scim-users/directory.json\",","+    ])","+    .await;","+    replica.expect_status(\"/-/whoami\", StatusCode::INTERNAL_SERVER_ERROR).await;","+    tokio::time::advance(Duration::from_secs(1)).await;","+    replica.expect_status(\"/-/whoami\", StatusCode::OK).await;","+}","+","+#[tokio::test(start_paused = true)]","+async fn the_initial_read_has_a_deadline_and_retries() {","+    let replica = Replica::new().await;","+    replica.objects.pause(\".scim-users/directory.json\".to_string());","+    let request = replica.get(\"/-/whoami\");","+    tokio::pin!(request);","+    tokio::select! {","+        status = &mut request => panic!(\"initial authorization completed before the read: {status}\"),","+        () = replica.objects.started.notified() => {}","+    }","+    tokio::time::advance(Duration::from_secs(5)).await;","+    assert_eq!(request.await, StatusCode::INTERNAL_SERVER_ERROR);","+    replica.objects","+        .put(","+            &Path::from(\".scim-users/directory.json\"),","+            br#\"{\"users\":{\"reader\":{\"active\":false}}}\"#.to_vec().into(),","+        )","+        .await","+        .unwrap();","+    tokio::time::advance(Duration::from_secs(1)).await;","+    replica.expect_status(\"/-/whoami\", StatusCode::UNAUTHORIZED).await;","+}"],"additions":215,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/tests/suite.rs","lines":["@@ -28,6 +28,7 @@ mod cargo_registry;"," mod cargo_resolve;"," mod cross_ecosystem_publish;"," mod htpasswd_import;","+mod managed_refresh;"," mod multi_replica;"," mod oci_registry;"," mod package_ownership;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/docs/configuration.md","lines":["@@ -498,8 +498,20 @@ See [Admin endpoints](endpoints.md#admin-endpoints) and"," Team rosters, managed access rules, and the [SCIM directory](scim.md) reload"," when a request arrives after the replica's state is 10 seconds old. That"," request starts a background reload and can still use the existing state, so","-a change can take effect later than 10 seconds after it is made. After a","-failed read, pnpr retries on a request arriving at least one second later.","+a change can take effect later than 10 seconds after it is made. The first","+request after startup waits for the initial reload.","+","+Each record read has a five-second deadline. An error or expired deadline","+clears the affected roster, denies access under the affected registry's","+managed rules, or refuses user credentials when the SCIM directory cannot be","+read. A successful read restores the stored state. SCIM reloads independently","+of rosters and rules. Rosters load before rules, so a reload with both phases","+can take up to ten seconds.","+","+After any failed read, pnpr retries on a request arriving at least one second","+after the reload finishes. Reloads share a lock with management writes. These","+read deadlines do not cancel writes or limit the time spent waiting for a","+management write to release the lock."," "," ## `oci`"," ",""],"additions":14,"deletions":2,"truncated":false}],"additions":290,"deletions":32,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-07T15:03:33.907985+00:00"}