ers = inspect.signature(getattr(store, method_name)).parameters","+    return \"experiment_ids\" in parameters or any(","+        parameter.kind == inspect.Parameter.VAR_KEYWORD for parameter in parameters.values()","+    )","+","+","+def _scope_batch_trace_query() -> None:","+    message = BatchGetTraces() if request.method == \"GET\" else BatchGetTraceInfos()","+    message = _get_request_message(","+        message,","+        schema={\"experiment_ids\": [_assert_array, _assert_item_type_string]},","+        raise_on_parse_error=True,","+    )","+    scoped_ids = _scope_experiment_ids(message, allow_missing=True)","+    if scoped_ids is None:","+        return","+    setattr(g, SCOPED_EXPERIMENT_IDS, scoped_ids)","+    method_name = \"batch_get_traces\" if request.method == \"GET\" else \"batch_get_trace_infos\"","+    if _raw_request_has_field(","+        message.DESCRIPTOR.fields_by_name[\"experiment_ids\"]","+    ) or _supports_batch_trace_experiment_scope(_get_tracking_store(), method_name):","+        _set_request_field(message, \"experiment_ids\", scoped_ids)","+","+","+def _scope_logged_model_query() -> None:","+    message = _get_request_message(","+        SearchLoggedModels(),","+        schema={\"experiment_ids\": [_assert_array, _assert_item_type_string, _assert_required]},","+        raise_on_parse_error=True,","+    )","+    experiment_ids = _scope_experiment_ids(message, allow_missing=False)","+    if experiment_ids is None:","+        experiment_ids = list(","+            dict.fromkeys(str(_parse_experiment_id(value)) for value in message.experiment_ids)","+        )","+    can_read = _role_based_read_predicate(","+        authenticate_request().username,","+        RESOURCE_TYPE_EXPERIMENT,","+        also_require=[Requirement(RESOURCE_TYPE_LOGGED_MODEL, \"*\", ACTION_NOT_DENIED)],","+    )","+    scoped_ids = [value for value in experiment_ids if can_read(value)]","+    setattr(g, SCOPED_EXPERIMENT_IDS, scoped_ids)","+    _set_request_field(mess