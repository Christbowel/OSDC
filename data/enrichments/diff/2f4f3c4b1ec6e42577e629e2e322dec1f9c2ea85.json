{"id":"2f4f3c4b1ec6e42577e629e2e322dec1f9c2ea85","axis":"silent","repo":"facebook/rocksdb","sha":"2f4f3c4b1ec6e42577e629e2e322dec1f9c2ea85","parsed":{"files":[{"path":"db/db_impl/db_impl.h","lines":["@@ -636,6 +636,14 @@ class DBImpl : public DB"," ","   virtual bool IsFileDeletionsEnabled() const;"," ","+  // Returns whether the newest MANIFEST state that this instance has read","+  // lists a file that the instance could not find or verify. Only secondary","+  // and follower instances keep replaying the MANIFEST after open, so other","+  // instances return false.","+  //","+  // REQUIRES: mutex_ held","+  virtual bool SecondaryHasMissingFiles() { return false; }","+","   Status GetStatsHistory(","       uint64_t start_time, uint64_t end_time,","       std::unique_ptr<StatsHistoryIterator>* stats_iterator) override;"],"additions":8,"deletions":0,"truncated":false},{"path":"db/db_impl/db_impl_secondary.cc","lines":["@@ -1197,6 +1197,12 @@ Status DBImplSecondary::TryCatchUpWithPrimary() {","   return s;"," }"," ","+bool DBImplSecondary::SecondaryHasMissingFiles() {","+  mutex_.AssertHeld();","+  return static_cast_with_check<ReactiveVersionSet>(versions_.get())","+      ->NewestStateHasMissingFiles();","+}","+"," Status DB::OpenAsSecondary(const Options& options, const std::string& dbname,","                            const std::string& secondary_path,","                            std::unique_ptr<DB>* dbptr) {"],"additions":6,"deletions":0,"truncated":false},{"path":"db/db_impl/db_impl_secondary.h","lines":["@@ -298,6 +298,9 @@ class DBImplSecondary : public DBImpl {","   // method can take long time due to all the I/O and CPU costs.","   Status TryCatchUpWithPrimary() override;"," ","+  // REQUIRES: mutex_ held","+  bool SecondaryHasMissingFiles() override;","+","   // Try to find log reader using log_number from log_readers_ map, initialize","   // if it doesn't exist","   Status MaybeInitLogReader(uint64_t log_number,"],"additions":3,"deletions":0,"truncated":false},{"path":"db/db_secondary_test.cc","lines":["@@ -245,6 +245,14 @@ class DBSecondaryTestBase : public DBBasicTestWithTimestampBase {","     return records;","   }"," ","+  // Returns the value of `rocksdb.secondary-has-missing-files` for `db`.","+  static uint64_t GetSecondaryHasMissingFiles(DB* db) {","+    uint64_t value = 0;","+    EXPECT_TRUE(","+        db->GetIntProperty(DB::Properties::kSecondaryHasMissingFiles, &value));","+    return value;","+  }","+","   // Moves `path` aside so that opening it fails, and returns where it went.","   // Every DB holding the file open must be closed first, because not every","   // platform allows renaming an open file. The caller must move it back before","@@ -1964,6 +1972,128 @@ TEST_F(DBSecondaryTest, KeepsMemtableWhenFlushedFileIsMissing) {","   VerifySecondaryValue(\"foo\", \"v1\");"," }"," ","+// TryCatchUpWithPrimary() returns OK while a file that the newest MANIFEST","+// state lists is missing, so the property is how a caller can tell that the","+// secondary still serves an older Version.","+TEST_F(DBSecondaryTest, SecondaryHasMissingFilesProperty) {","+  Options options;","+  options.env = env_;","+  options.disable_auto_compactions = true;","+  Reopen(options);","+  ASSERT_OK(Put(\"foo\", \"v1\"));","+  ASSERT_OK(Flush());","+  ASSERT_EQ(0U, GetSecondaryHasMissingFiles(db_.get()));","+","+  Options secondary_options = options;","+  secondary_options.max_open_files = -1;","+  OpenSecondary(secondary_options);","+  ASSERT_EQ(0U, GetSecondaryHasMissingFiles(db_secondary_.get()));","+","+  // The file of the next flush goes away before the secondary reads the","+  // MANIFEST record that adds it.","+  ASSERT_OK(Put(\"foo\", \"v2\"));","+  ASSERT_OK(Flush());","+  const std::string table_file =","+      GetNewestTableFilePath(kDefaultColumnFamilyName);","+  Close();","+  const std::string aside_file = MoveFileAside(table_file);","+  bool restored = false;","+  Defer restore_file([&] {","+    if (!restored) {","+      EXPECT_OK(env_->RenameFile(aside_file, table_file));","+    }","+  });","+","+  ASSERT_OK(db_secondary_->TryCatchUpWithPrimary());","+  ASSERT_EQ(1U, GetSecondaryHasMissingFiles(db_secondary_.get()));","+  VerifySecondaryValue(\"foo\", \"v1\");","+","+  // The primary compacts the file into a new one, so the newest state no","+  // longer lists it.","+  ASSERT_OK(env_->RenameFile(aside_file, table_file));","+  restored = true;","+  Reopen(options);","+  ASSERT_OK(db_->CompactRange(CompactRangeOptions(), nullptr, nullptr));","+  ASSERT_OK(db_secondary_->TryCatchUpWithPrimary());","+  ASSERT_EQ(0U, GetSecondaryHasMissingFiles(db_secondary_.get()));","+  VerifySecondaryValue(\"foo\", \"v2\");","+}","+","+// The parameter is whether the primary drops the column family whose file is","+// missing. Either way, the primary then starts a new MANIFEST before the","+// secondary catches up again. The new MANIFEST leaves out a dropped column","+// family, so the property returns to 0. A column family that the new MANIFEST","+// lists again is checked again, and its missing file keeps the value at 1.","+class DBSecondaryMissingFileAcrossManifestSwitchTest","+    : public DBSecondaryTestBase,","+      public testing::WithParamInterface<bool> {","+ public:","+  DBSecondaryMissingFileAcrossManifestSwitchTest()","+      : DBSecondaryTestBase(","+            \"db_secondary_missing_file_across_manifest_switch_test\") {}","+};","+","+TEST_P(DBSecondaryMissingFileAcrossManifestSwitchTest,","+       PropertyFollowsNewManifest) {","+  const bool drop_column_family = GetParam();","+  Options options;","+  options.env = env_;","+  options.disable_auto_compactions = true;","+  CreateAndReopenWithCF({\"pikachu\"}, options);","+  ASSERT_OK(Put(1, \"foo\", \"v1\"));","+  ASSERT_OK(Flush(1));","+","+  Options secondary_options = options;","+  secondary_options.max_open_files = -1;","+  OpenSecondaryWithColumnFamilies({\"pikachu\"}, secondary_options);","+  ASSERT_EQ(0U, GetSecondaryHasMissingFiles(db_secondary_.get()));","+","+  // The file of the next flush of \"pikachu\" is away while the secondary reads","+  // the MANIFEST record that adds it.","+  ASSERT_OK(Put(1, \"foo\", \"v2\"));","+  ASSERT_OK(Flush(1));","+  const std::string table_file = GetNewestTableFilePath(\"pikachu\");","+  Close();","+  std::string aside_file = MoveFileAside(table_file);","+  bool file_is_aside = true;","+  Defer restore_file([&] {","+    if (file_is_aside) {","+      EXPECT_OK(env_->RenameFile(aside_file, table_file));","+    }","+  });","+  ASSERT_OK(db_secondary_->TryCatchUpWithPrimary());","+  ASSERT_EQ(1U, GetSecondaryHasMissingFiles(db_secondary_.get()));","+","+  // The primary needs the file to open. Each open starts a new MANIFEST, so the","+  // MANIFEST of the second open leaves out a column family that was dropped","+  // after the first open.","+  ASSERT_OK(env_->RenameFile(aside_file, table_file));","+  file_is_aside = false;","+  ReopenWithColumnFamilies({kDefaultColumnFamilyName, \"pikachu\"}, options);","+  if (drop_column_family) {","+    ASSERT_OK(db_->DropColumnFamily(handles_[1]));","+    Reopen(options);","+  } else {","+    ReopenWithColumnFamilies({kDefaultColumnFamilyName, \"pikachu\"}, options);","+  }","+  ASSERT_OK(Put(\"bar\", \"b1\"));","+  ASSERT_OK(Flush());","+  Close();","+  if (!drop_column_family) {","+    aside_file = MoveFileAside(table_file);","+    file_is_aside = true;","+  }","+","+  ASSERT_OK(db_secondary_->TryCatchUpWithPrimary());","+  VerifySecondaryValue(\"bar\", \"b1\");","+  ASSERT_EQ(drop_column_family ? 0U : 1U,","+            GetSecondaryHasMissingFiles(db_secondary_.get()));","+}","+","+INSTANTIATE_TEST_CASE_P(DBSecondaryMissingFileAcrossManifestSwitchTest,","+                        DBSecondaryMissingFileAcrossManifestSwitchTest,","+                        ::testing::Bool());","+"," // Same hazard reached without any missing file of the column family's own: an"," // atomic flush whose group is incomplete parks the new Version of every column"," // family in the group, including those whose files are all readable, while"],"additions":130,"deletions":0,"truncated":false},{"path":"db/internal_stats.cc","lines":["@@ -324,6 +324,8 @@ static const std::string num_running_flushes = \"num-running-flushes\";"," static const std::string actual_delayed_write_rate =","     \"actual-delayed-write-rate\";"," static const std::string is_write_stopped = \"is-write-stopped\";","+static const std::string secondary_has_missing_files =","+    \"secondary-has-missing-files\";"," static const std::string estimate_oldest_key_time = \"estimate-oldest-key-time\";"," static const std::string block_cache_capacity = \"block-cache-capacity\";"," static const std::string block_cache_usage = \"block-cache-usage\";","@@ -439,6 +441,8 @@ const std::string DB::Properties::kActualDelayedWriteRate =","     rocksdb_prefix + actual_delayed_write_rate;"," const std::string DB::Properties::kIsWriteStopped =","     rocksdb_prefix + is_write_stopped;","+const std::string DB::Properties::kSecondaryHasMissingFiles =","+    rocksdb_prefix + secondary_has_missing_files;"," const std::string DB::Properties::kEstimateOldestKeyTime =","     rocksdb_prefix + estimate_oldest_key_time;"," const std::string DB::Properties::kBlockCacheCapacity =","@@ -635,6 +639,9 @@ const UnorderedMap<std::string, DBPropertyInfo>","         {DB::Properties::kIsWriteStopped,","          {false, nullptr, &InternalStats::HandleIsWriteStopped, nullptr,","           nullptr}},","+        {DB::Properties::kSecondaryHasMissingFiles,","+         {false, nullptr, &InternalStats::HandleSecondaryHasMissingFiles,","+          nullptr, nullptr}},","         {DB::Properties::kEstimateOldestKeyTime,","          {false, nullptr, &InternalStats::HandleEstimateOldestKeyTime, nullptr,","           nullptr}},","@@ -1565,6 +1572,12 @@ bool InternalStats::HandleIsWriteStopped(uint64_t* value, DBImpl* db,","   return true;"," }"," ","+bool InternalStats::HandleSecondaryHasMissingFiles(uint64_t* value, DBImpl* db,","+                                                   Version* /*version*/) {","+  *value = db->SecondaryHasMissingFiles() ? 1 : 0;","+  return true;","+}","+"," bool InternalStats::HandleEstimateOldestKeyTime(uint64_t* value, DBImpl* /*db*/,","                                                 Version* /*version*/) {","   // TODO(yiwu): The property is currently available for fifo compaction"],"additions":13,"deletions":0,"truncated":false},{"path":"db/internal_stats.h","lines":["@@ -906,6 +906,8 @@ class InternalStats {","   bool HandleActualDelayedWriteRate(uint64_t* value, DBImpl* db,","                                     Version* version);","   bool HandleIsWriteStopped(uint64_t* value, DBImpl* db, Version* version);","+  bool HandleSecondaryHasMissingFiles(uint64_t* value, DBImpl* db,","+                                      Version* version);","   bool HandleEstimateOldestKeyTime(uint64_t* value, DBImpl* db,","                                    Version* version);","   bool HandleBlockCacheCapacity(uint64_t* value, DBImpl* db, Version* version);"],"additions":2,"deletions":0,"truncated":false},{"path":"db/version_edit_handler.cc","lines":["@@ -1175,6 +1175,9 @@ Status ManifestTailer::ApplyVersionEdit(VersionEdit& edit,","         cfs_awaiting_file_list_.erase(cf_id);","       }","       cfs_awaiting_from_previous_manifest_.clear();","+      cfs_left_out_of_manifest_.insert(cfs_not_yet_in_manifest_.begin(),","+                                       cfs_not_yet_in_manifest_.end());","+      cfs_not_yet_in_manifest_.clear();","     }","   }","   return s;","@@ -1217,6 +1220,17 @@ Status ManifestTailer::OnColumnFamilyAdd(VersionEdit& edit,"," void ManifestTailer::AwaitFileList(uint32_t cf_id) {","   cfs_awaiting_file_list_.insert(cf_id);","   cfs_awaiting_from_previous_manifest_.erase(cf_id);","+  cfs_not_yet_in_manifest_.erase(cf_id);","+}","+","+bool ManifestTailer::NewestStateHasMissingFiles() {","+  for (const auto& builder : builders_) {","+    if (cfs_left_out_of_manifest_.count(builder.first) == 0 &&","+        !builder.second->version_builder()->ValidVersionAvailable()) {","+      return true;","+    }","+  }","+  return false;"," }"," "," void ManifestTailer::CheckIterationResult(const log::Reader& reader,"],"additions":14,"deletions":0,"truncated":false},{"path":"db/version_edit_handler.h","lines":["@@ -453,6 +453,10 @@ class ManifestTailer : public VersionEditHandlerPointInTime {","     initialized_ = false;","     ResetReadState();","     cfs_awaiting_from_previous_manifest_ = cfs_awaiting_file_list_;","+    cfs_not_yet_in_manifest_.clear();","+    for (const auto& builder : builders_) {","+      cfs_not_yet_in_manifest_.insert(builder.first);","+    }","   }"," ","   // ReactiveVersionSet::ReadAndApply() calls this before it reads with a new","@@ -466,6 +470,14 @@ class ManifestTailer : public VersionEditHandlerPointInTime {","     GetReadBuffer().Clear();","   }"," ","+  // Returns whether catch-up cannot build a Version of the newest state of a","+  // column family that this instance opened, because a file of that state was","+  // not found or failed verification. A column family that the current","+  // MANIFEST left out does not count: the primary dropped it before this","+  // instance read the drop record, and its builder keeps the state from the","+  // previous MANIFEST.","+  bool NewestStateHasMissingFiles();","+","   std::unordered_set<ColumnFamilyData*>& GetUpdatedColumnFamilies() {","     return cfds_changed_;","   }","@@ -503,6 +515,12 @@ class ManifestTailer : public VersionEditHandlerPointInTime {","   // Column families that were awaiting their file list when the tailer","   // switched to the current MANIFEST, and that it has not added again.","   std::unordered_set<uint32_t> cfs_awaiting_from_previous_manifest_;","+  // Column families with a builder that the current MANIFEST has not added","+  // again since the tailer switched to it.","+  std::unordered_set<uint32_t> cfs_not_yet_in_manifest_;","+  // Column families that the snapshot opening a MANIFEST left out, because the","+  // primary dropped them. Their builders are never reset again.","+  std::unordered_set<uint32_t> cfs_left_out_of_manifest_;"," };"," "," class DumpManifestHandler : public VersionEditHandler {"],"additions":18,"deletions":0,"truncated":false},{"path":"db/version_set.cc","lines":["@@ -9303,6 +9303,11 @@ uint64_t ReactiveVersionSet::GetInstalledVersionLogNumber(","   return manifest_tailer_->GetInstalledVersionLogNumber(cf_id);"," }"," ","+bool ReactiveVersionSet::NewestStateHasMissingFiles() {","+  assert(manifest_tailer_ != nullptr);","+  return manifest_tailer_->NewestStateHasMissingFiles();","+}","+"," Status ReactiveVersionSet::MaybeSwitchManifest(","     log::Reader::Reporter* reporter,","     std::unique_ptr<log::FragmentBufferedReader>* manifest_reader) {"],"additions":5,"deletions":0,"truncated":false},{"path":"db/version_set.h","lines":["@@ -2349,6 +2349,13 @@ class ReactiveVersionSet : public VersionSet {","   // REQUIRES: db mutex","   uint64_t GetInstalledVersionLogNumber(uint32_t cf_id) const;"," ","+  // Returns whether the newest state that the MANIFEST records read so far","+  // describe lists, for any column family, a file that could not be found or","+  // verified, so that no Version of that state can be installed.","+  //","+  // REQUIRES: db mutex","+  bool NewestStateHasMissingFiles();","+"," #ifndef NDEBUG","   uint64_t TEST_read_edits_in_atomic_group() const;"," #endif  //! NDEBUG"],"additions":7,"deletions":0,"truncated":false},{"path":"include/rocksdb/db.h","lines":["@@ -1903,6 +1903,22 @@ class DB {","     //  \"rocksdb.is-write-stopped\" - Return 1 if write has been stopped.","     static const std::string kIsWriteStopped;"," ","+    //  \"rocksdb.secondary-has-missing-files\" - for a secondary or follower","+    //      instance, returns 1 while catch-up cannot build a Version of the","+    //      newest MANIFEST state of a column family that the instance opened,","+    //      because a table or blob file of that state is missing or failed","+    //      verification. TryCatchUpWithPrimary() returns OK in that case, and","+    //      the column family keeps serving an older Version. Otherwise, and","+    //      for other instances, returns 0.","+    //      A value of 0 does not prove that the instance is caught up. These","+    //      files do not count: files of column families that the instance did","+    //      not open, files listed at open with `open_files_async`, and, with","+    //      `verify_sst_unique_id_in_manifest` = false, a table file of the","+    //      right size that fails to open.","+    //      After a missing blob file is deleted, the value can stay 1 while a","+    //      table file still references a blob file with a lower number.","+    static const std::string kSecondaryHasMissingFiles;","+","     //  \"rocksdb.estimate-oldest-key-time\" - returns an estimation of","     //      oldest key timestamp in the DB. Currently only available for","     //      FIFO compaction with","@@ -2962,6 +2978,9 @@ class DB {","   // is reclaimed only once those files become readable or this instance is","   // reopened; `rocksdb.num-immutable-mem-table` reports how many memtables are","   // being held.","+  // When a table or blob file of the newest MANIFEST state is missing or fails","+  // verification, this call returns OK, and the column family keeps serving an","+  // older Version. `rocksdb.secondary-has-missing-files` reports this state.","   // If a read of the MANIFEST fails, this call returns the error. The next","   // call opens the MANIFEST again and continues after the last record that","   // this instance applied. If that fails, the call returns the error, and the"],"additions":19,"deletions":0,"truncated":false},{"path":"unreleased_history/new_features/secondary_has_missing_files_property.md","lines":["@@ -0,0 +1 @@","+Added DB property `rocksdb.secondary-has-missing-files`. It is 1 while a secondary or follower instance serves an older Version, because a table or blob file of its newest MANIFEST state is missing or fails verification.",""],"additions":1,"deletions":0,"truncated":false}],"additions":226,"deletions":0,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-19T17:59:12.331423+00:00"}