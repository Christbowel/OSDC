{"id":"b08e5937d00748246cd1a1e1995469610209fd1a","axis":"silent","repo":"grafana/loki","sha":"b08e5937d00748246cd1a1e1995469610209fd1a","parsed":{"files":[{"path":"docs/sources/shared/configuration.md","lines":["@@ -1161,6 +1161,14 @@ dataobj:","     # CLI flag: -dataobj.compaction.logs.min-compaction-size","     [logs_min_compaction_size: <int> | default = 4MiB]"," ","+    # Experimental: Maximum uncompressed input size of one LogMerge task. The","+    # planner splits a larger merge into tasks by stream sort prefix and never","+    # splits one sort prefix. A task exceeds the maximum in two cases: a sort","+    # prefix above it gets a task of its own, and the last task of a merge can","+    # take in a leftover of up to 10% of it. 0 disables the split.","+    # CLI flag: -dataobj.compaction.logs.max-task-size","+    [logs_max_task_size: <int> | default = 0B]","+","     # Experimental: Coordinator-side timeout around the inline ToC","     # ReplaceIndexPointers call. Not a task TTL.","     # CLI flag: -dataobj.compaction.toc-consolidate-timeout"],"additions":8,"deletions":0,"truncated":false},{"path":"pkg/dataobj/compaction/v2/key_range_proto.go","lines":["@@ -0,0 +1,16 @@","+package compactionv2","+","+import (","+\tcompactionv2pb \"github.com/grafana/loki/v3/pkg/dataobj/compaction/v2/proto\"","+\t\"github.com/grafana/loki/v3/pkg/dataobj/sections/streams\"","+)","+","+// FullKeyRangeProto returns the key range that holds every stream, from","+// [streams.MinSortPrefix] to [streams.SortPrefixLimit]. Each call returns a","+// new value that the caller owns.","+func FullKeyRangeProto() *compactionv2pb.KeyRange {","+\treturn &compactionv2pb.KeyRange{","+\t\tStart: &compactionv2pb.KeyRangePrefix{ShardBucket: streams.MinSortPrefix().ShardBucket},","+\t\tEnd:   &compactionv2pb.KeyRangePrefix{ShardBucket: streams.SortPrefixLimit().ShardBucket},","+\t}","+}"],"additions":16,"deletions":0,"truncated":false},{"path":"pkg/dataobj/compaction/v2/key_split.go","lines":["@@ -0,0 +1,136 @@","+package compactionv2","+","+import (","+\t\"fmt\"","+\t\"slices\"","+)","+","+// KeySize is the uncompressed size of the data that one section holds for one","+// key.","+type KeySize[K any] struct {","+\tKey              K","+\tUncompressedSize uint64","+}","+","+// KeyRange is the half-open key range [start, end) under its compare","+// function. Its start is always below its end.","+type KeyRange[K any] struct {","+\tstart, end K","+\tcompare    CompareFunc[K]","+}","+","+// NewKeyRange returns the range [start, end). It returns an error if start is","+// not below end under compare.","+func NewKeyRange[K any](start, end K, compare CompareFunc[K]) (KeyRange[K], error) {","+\tif compare(start, end) >= 0 {","+\t\treturn KeyRange[K]{}, fmt.Errorf(\"key range start %v is not below its end %v\", start, end)","+\t}","+\treturn KeyRange[K]{start: start, end: end, compare: compare}, nil","+}","+","+// Start returns the smallest key in r.","+func (r KeyRange[K]) Start() K { return r.start }","+","+// End returns the smallest key above r.","+func (r KeyRange[K]) End() K { return r.end }","+","+// Contains reports whether key is in r.","+func (r KeyRange[K]) Contains(key K) bool {","+\treturn r.compare(key, r.start) >= 0 && r.compare(key, r.end) < 0","+}","+","+// KeySplit is one range of a split by [SplitKeyRanges] and the input keys in","+// it. The range starts at its smallest input key.","+type KeySplit[K any] struct {","+\tRange KeyRange[K]","+","+\t// UncompressedSize is the total uncompressed size of the input keys in","+\t// the range.","+\tUncompressedSize uint64","+","+\t// Oversized reports whether the range holds one key larger than the","+\t// budget of the split. That key is the start of the range, unless keys of","+\t// size 0 come before it.","+\t//","+\t// An oversized range still excludes its end. Its end is the next input key","+\t// or the end of the split, so it never equals the start.","+\t//","+\t// A last range that exceeds the budget after a merge is not oversized.","+\tOversized bool","+}","+","+// SplitKeyRanges splits keys into contiguous half-open ranges of about budget","+// bytes each. Each range starts at its smallest key and excludes its end. The","+// last range ends at end, so end itself is in no range. Each other range ends","+// where the next one starts. Every key from the smallest input key up to, but","+// not including, end falls in exactly one range.","+//","+// The same key can occur many times in keys, for example once per section.","+// SplitKeyRanges adds up the sizes of equal keys and never splits a key across","+// ranges.","+//","+// A range exceeds the budget in two cases:","+//   - A key larger than budget gets a range of its own. Like every range, it","+//     starts at that key and excludes its end, the next input key or end.","+//   - The last range merges into the range before it if their total stays","+//     within 110% of budget. This avoids a small last range. A range that","+//     holds one oversized key never merges.","+//","+// SplitKeyRanges returns nil if keys is empty. It panics if budget is 0 or if","+// a key is not below end.","+func SplitKeyRanges[K any](keys []KeySize[K], compare CompareFunc[K], budget uint64, end K) []KeySplit[K] {","+\tif budget == 0 {","+\t\tpanic(fmt.Sprintf(\"key range budget must be > 0, got %d\", budget))","+\t}","+\tif len(keys) == 0 {","+\t\treturn nil","+\t}","+","+\tsorted := slices.Clone(keys)","+\tslices.SortStableFunc(sorted, func(a, b KeySize[K]) int { return compare(a.Key, b.Key) })","+\tif last := sorted[len(sorted)-1].Key; compare(last, end) >= 0 {","+\t\tpanic(fmt.Sprintf(\"key %v is not below the end %v of the split\", last, end))","+\t}","+","+\t// Each range starts at an input key and ends at a larger input key or at","+\t// end, so NewKeyRange never fails here.","+\tmustNewRange := func(start, end K) KeyRange[K] {","+\t\tr, err := NewKeyRange(start, end, compare)","+\t\tif err != nil {","+\t\t\tpanic(fmt.Sprintf(\"split key range: %v\", err))","+\t\t}","+\t\treturn r","+\t}","+","+\tvar (","+\t\tsplits    []KeySplit[K]","+\t\tstart     = sorted[0].Key","+\t\tsize      uint64","+\t\toversized bool","+\t)","+\tfor i := 0; i < len(sorted); {","+\t\tkey := sorted[i].Key","+\t\tvar keySize uint64","+\t\tfor ; i < len(sorted) && compare(sorted[i].Key, key) == 0; i++ {","+\t\t\tkeySize += sorted[i].UncompressedSize","+\t\t}","+","+\t\t// Close the current range before key if key does not fit. A range","+\t\t// over budget holds one oversized key, so this check also closes it.","+\t\tif size > 0 && size+keySize > budget {","+\t\t\tsplits = append(splits, KeySplit[K]{Range: mustNewRange(start, key), UncompressedSize: size, Oversized: oversized})","+\t\t\tstart, size, oversized = key, 0, false","+\t\t}","+\t\toversized = oversized || keySize > budget","+\t\tsize += keySize","+\t}","+","+\tif n := len(splits); n > 0 {","+\t\tprevious := splits[n-1]","+\t\tif !previous.Oversized && !oversized && previous.UncompressedSize+size <= budget+budget/10 {","+\t\t\tsplits[n-1] = KeySplit[K]{Range: mustNewRange(previous.Range.Start(), end), UncompressedSize: previous.UncompressedSize + size}","+\t\t\treturn splits","+\t\t}","+\t}","+\treturn append(splits, KeySplit[K]{Range: mustNewRange(start, end), UncompressedSize: size, Oversized: oversized})","+}"],"additions":136,"deletions":0,"truncated":false},{"path":"pkg/dataobj/compaction/v2/key_split_test.go","lines":["@@ -0,0 +1,211 @@","+package compactionv2","+","+import (","+\t\"cmp\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+)","+","+const splitEnd = 100","+","+func rng(start, end int) KeyRange[int] {","+\tr, err := NewKeyRange(start, end, cmp.Compare[int])","+\tif err != nil {","+\t\tpanic(err)","+\t}","+\treturn r","+}","+","+// withoutCompare returns splits without their compare functions, which","+// require.Equal cannot compare.","+func withoutCompare(splits []KeySplit[int]) []KeySplit[int] {","+\tfor i := range splits {","+\t\tsplits[i].Range.compare = nil","+\t}","+\treturn splits","+}","+","+func TestSplitKeyRanges(t *testing.T) {","+\tconst budget = 100","+","+\ttests := []struct {","+\t\tname string","+\t\tkeys []KeySize[int]","+\t\twant []KeySplit[int]","+\t}{","+\t\t{","+\t\t\tname: \"returns no ranges for no keys\",","+\t\t\tkeys: nil,","+\t\t\twant: nil,","+\t\t},","+\t\t{","+\t\t\tname: \"returns one range from the first key to the end when all keys fit the budget\",","+\t\t\tkeys: []KeySize[int]{{1, 40}, {2, 60}},","+\t\t\twant: []KeySplit[int]{{Range: rng(1, splitEnd), UncompressedSize: 100}},","+\t\t},","+\t\t{","+\t\t\tname: \"cuts before the key that would exceed the budget\",","+\t\t\tkeys: []KeySize[int]{{1, 60}, {2, 30}, {3, 20}, {4, 50}, {5, 45}},","+\t\t\twant: []KeySplit[int]{","+\t\t\t\t{Range: rng(1, 3), UncompressedSize: 90},","+\t\t\t\t{Range: rng(3, 5), UncompressedSize: 70},","+\t\t\t\t{Range: rng(5, splitEnd), UncompressedSize: 45},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"adds up equal keys from many sections and keeps them in one range\",","+\t\t\tkeys: []KeySize[int]{{2, 30}, {1, 50}, {2, 30}, {3, 51}},","+\t\t\twant: []KeySplit[int]{","+\t\t\t\t{Range: rng(1, 2), UncompressedSize: 50},","+\t\t\t\t{Range: rng(2, 3), UncompressedSize: 60},","+\t\t\t\t{Range: rng(3, splitEnd), UncompressedSize: 51},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"folds the last range into the previous one at exactly 110 percent of the budget\",","+\t\t\tkeys: []KeySize[int]{{1, 100}, {2, 10}},","+\t\t\twant: []KeySplit[int]{{Range: rng(1, splitEnd), UncompressedSize: 110}},","+\t\t},","+\t\t{","+\t\t\tname: \"keeps the last range separate just above 110 percent of the budget\",","+\t\t\tkeys: []KeySize[int]{{1, 100}, {2, 11}},","+\t\t\twant: []KeySplit[int]{","+\t\t\t\t{Range: rng(1, 2), UncompressedSize: 100},","+\t\t\t\t{Range: rng(2, splitEnd), UncompressedSize: 11},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"gives an oversized first key its own range\",","+\t\t\tkeys: []KeySize[int]{{1, 250}, {2, 50}, {3, 70}},","+\t\t\twant: []KeySplit[int]{","+\t\t\t\t{Range: rng(1, 2), UncompressedSize: 250, Oversized: true},","+\t\t\t\t{Range: rng(2, 3), UncompressedSize: 50},","+\t\t\t\t{Range: rng(3, splitEnd), UncompressedSize: 70},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"gives an oversized middle key its own range\",","+\t\t\tkeys: []KeySize[int]{{1, 50}, {2, 250}, {3, 50}},","+\t\t\twant: []KeySplit[int]{","+\t\t\t\t{Range: rng(1, 2), UncompressedSize: 50},","+\t\t\t\t{Range: rng(2, 3), UncompressedSize: 250, Oversized: true},","+\t\t\t\t{Range: rng(3, splitEnd), UncompressedSize: 50},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"does not fold a small last range into an oversized key\",","+\t\t\tkeys: []KeySize[int]{{1, 101}, {2, 1}},","+\t\t\twant: []KeySplit[int]{","+\t\t\t\t{Range: rng(1, 2), UncompressedSize: 101, Oversized: true},","+\t\t\t\t{Range: rng(2, splitEnd), UncompressedSize: 1},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"does not fold an oversized last key into a small range\",","+\t\t\tkeys: []KeySize[int]{{1, 1}, {2, 101}},","+\t\t\twant: []KeySplit[int]{","+\t\t\t\t{Range: rng(1, 2), UncompressedSize: 1},","+\t\t\t\t{Range: rng(2, splitEnd), UncompressedSize: 101, Oversized: true},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname: \"marks a merged last range above the budget as not oversized\",","+\t\t\tkeys: []KeySize[int]{{1, 60}, {2, 40}, {3, 5}},","+\t\t\twant: []KeySplit[int]{{Range: rng(1, splitEnd), UncompressedSize: 105}},","+\t\t},","+\t\t{","+\t\t\tname: \"puts a key that exactly fills the budget in the current range\",","+\t\t\tkeys: []KeySize[int]{{1, 40}, {2, 60}, {3, 100}},","+\t\t\twant: []KeySplit[int]{","+\t\t\t\t{Range: rng(1, 3), UncompressedSize: 100},","+\t\t\t\t{Range: rng(3, splitEnd), UncompressedSize: 100},","+\t\t\t},","+\t\t},","+\t}","+","+\tfor _, tc := range tests {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tgot := SplitKeyRanges(tc.keys, cmp.Compare[int], budget, splitEnd)","+\t\t\trequire.Equal(t, withoutCompare(tc.want), withoutCompare(got))","+\t\t})","+\t}","+","+\tt.Run(\"returns the same ranges for any input order\", func(t *testing.T) {","+\t\tkeys := []KeySize[int]{{1, 60}, {2, 30}, {3, 20}, {4, 50}, {5, 40}}","+\t\treversed := []KeySize[int]{{5, 40}, {4, 50}, {3, 20}, {2, 30}, {1, 60}}","+\t\trequire.Equal(t,","+\t\t\twithoutCompare(SplitKeyRanges(keys, cmp.Compare[int], budget, splitEnd)),","+\t\t\twithoutCompare(SplitKeyRanges(reversed, cmp.Compare[int], budget, splitEnd)),","+\t\t)","+\t})","+","+\tt.Run(\"places every key from the first input key to the end in exactly one range\", func(t *testing.T) {","+\t\tkeys := []KeySize[int]{{1, 60}, {2, 30}, {3, 250}, {4, 50}, {5, 40}, {6, 5}}","+\t\tranges := SplitKeyRanges(keys, cmp.Compare[int], budget, splitEnd)","+\t\trequire.Equal(t, 1, ranges[0].Range.Start())","+\t\trequire.Equal(t, splitEnd, ranges[len(ranges)-1].Range.End())","+\t\tfor i := 1; i < len(ranges); i++ {","+\t\t\trequire.Equal(t, ranges[i-1].Range.End(), ranges[i].Range.Start(), \"ranges %d and %d must share a bound\", i-1, i)","+\t\t}","+\t\tfor key := 1; key < splitEnd; key++ {","+\t\t\tvar matches int","+\t\t\tfor _, r := range ranges {","+\t\t\t\tif r.Range.Contains(key) {","+\t\t\t\t\tmatches++","+\t\t\t\t}","+\t\t\t}","+\t\t\trequire.Equal(t, 1, matches, \"key %d\", key)","+\t\t}","+\t})","+","+\tt.Run(\"panics when the budget is zero\", func(t *testing.T) {","+\t\trequire.PanicsWithValue(t, \"key range budget must be > 0, got 0\", func() {","+\t\t\tSplitKeyRanges([]KeySize[int]{{1, 1}}, cmp.Compare[int], 0, splitEnd)","+\t\t})","+\t})","+","+\tt.Run(\"panics when a key is not below the end\", func(t *testing.T) {","+\t\trequire.PanicsWithValue(t, \"key 100 is not below the end 100 of the split\", func() {","+\t\t\tSplitKeyRanges([]KeySize[int]{{splitEnd, 1}}, cmp.Compare[int], budget, splitEnd)","+\t\t})","+\t})","+}","+","+func TestNewKeyRange(t *testing.T) {","+\tt.Run(\"returns the range when start is below end\", func(t *testing.T) {","+\t\tr, err := NewKeyRange(2, 4, cmp.Compare[int])","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, 2, r.Start())","+\t\trequire.Equal(t, 4, r.End())","+\t})","+","+\tt.Run(\"returns an error when start equals end\", func(t *testing.T) {","+\t\t_, err := NewKeyRange(3, 3, cmp.Compare[int])","+\t\trequire.ErrorContains(t, err, \"is not below its end\")","+\t})","+","+\tt.Run(\"returns an error when start is above end\", func(t *testing.T) {","+\t\t_, err := NewKeyRange(4, 2, cmp.Compare[int])","+\t\trequire.ErrorContains(t, err, \"is not below its end\")","+\t})","+}","+","+func TestKeyRange_Contains(t *testing.T) {","+\tr := rng(2, 4)","+\ttests := []struct {","+\t\tname string","+\t\tkey  int","+\t\twant bool","+\t}{","+\t\t{name: \"includes the start key\", key: 2, want: true},","+\t\t{name: \"includes a key between the bounds\", key: 3, want: true},","+\t\t{name: \"excludes the end key\", key: 4, want: false},","+\t\t{name: \"excludes a key below the start\", key: 1, want: false},","+\t}","+\tfor _, tc := range tests {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\trequire.Equal(t, tc.want, r.Contains(tc.key))","+\t\t})","+\t}","+}"],"additions":211,"deletions":0,"truncated":false},{"path":"pkg/dataobj/compaction/v2/plan.go","lines":["@@ -13,6 +13,10 @@ type CompareFunc[K any] func(a, b K) int"," type Section[K any] struct {"," \tRef      *compactionv2pb.SectionRef"," \tMin, Max K","+","+\t// Keys holds the size of each key in the section, in any order. An empty","+\t// Keys means the sizes are unknown, not that the section holds no key.","+\tKeys []KeySize[K]"," }"," "," // Run is one strictly ordered sequence of sections."],"additions":4,"deletions":0,"truncated":false},{"path":"pkg/dataobj/compaction/v2/proto/compactionv2.pb.go","lines":["@@ -180,6 +180,13 @@ func (m *RunRef) GetSections() []*SectionRef {"," type TaskSpec struct {"," \tTenant string    `protobuf:\"bytes,1,opt,name=ten