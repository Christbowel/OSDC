s\", func(t *testing.T) {"," \t\tresponses := []queryrangebase.Response{"," \t\t\t&DetectedFieldsResponse{","@@ -3217,3 +3264,81 @@ func dataObjInstantRequest(eligible bool) *LokiInstantRequest {"," \t\tDataObjOptions: dataObjOptionsFor(eligible),"," \t}"," }","+","+func Test_codec_DetectedFieldsStatisticsProtobufRoundTrip(t *testing.T) {","+\tt.Run(\"older producer without statistics\", func(t *testing.T) {","+\t\t// Field 1 contains an empty metadata response; field 3 (statistics)","+\t\t// is absent, as in responses produced before statistics were added.","+\t\tvar response DetectedFieldsResponse","+\t\trequire.NoError(t, response.Unmarshal([]byte{0x0a, 0x00}))","+\t\trequire.Equal(t, stats.Result{}, response.Statistics)","+\t})","+","+\tfor _, tc := range []struct {","+\t\tname       string","+\t\tstatistics stats.Result","+\t}{","+\t\t{name: \"zero usage\", statistics: stats.Result{}},","+\t\t{name: \"scanned logs\", statistics: stats.Result{Summary: stats.Summary{TotalBytesProcessed: 1024, Splits: 2}}},","+\t} {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\twant := &DetectedFieldsResponse{Response: &logproto.DetectedFieldsResponse{Values: []string{\"value\"}}, Statistics: tc.statistics}","+\t\t\trequest := httptest.NewRequest(http.MethodGet, \"/loki/api/v1/detected_fields\", nil)","+\t\t\trequest.Header.Set(\"Accept\", ProtobufType)","+\t\t\tencoded, err := DefaultCodec.EncodeResponse(context.Background(), request, want)","+\t\t\trequire.NoError(t, err)","+\t\t\tdefer encoded.Body.Close()","+\t\t\tdecoded, err := DefaultCodec.DecodeResponse(context.Background(), encoded, &DetectedFieldsRequest{})","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Equal(t, want.Statistics, decoded.(*DetectedFieldsResponse).Statistics)","+\t\t\trequire.Equal(t, want.Response, decoded.(*DetectedFieldsResponse).Response)","+\t\t})","+\t}","+}","+","+func Test_codec_DetectedFieldsJSONRoundTrip(t *testing.T) {","+\tfor _, tc := range []struct {","+\t\tname     string","+\t\tmet