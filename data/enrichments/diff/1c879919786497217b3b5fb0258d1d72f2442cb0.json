{"id":"1c879919786497217b3b5fb0258d1d72f2442cb0","axis":"silent","repo":"vllm-project/vllm","sha":"1c879919786497217b3b5fb0258d1d72f2442cb0","parsed":{"files":[{"path":"tests/config/test_watchdog_config.py","lines":["@@ -0,0 +1,53 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+import pytest","+from pydantic import ValidationError","+","+from vllm.config import WatchdogConfig","+","+","+def test_watchdog_config_defaults():","+    \"\"\"Verify WatchdogConfig defaults stay in sync with the WatchDog module","+    defaults.\"\"\"","+    config = WatchdogConfig()","+    assert config.timeout == 300","+    assert config.check_interval == 10","+    assert config.dump_dir == \"\"","+","+","+def test_watchdog_config_custom_values():","+    \"\"\"Verify non-default watchdog parameters are honored.\"\"\"","+    config = WatchdogConfig(timeout=60, check_interval=5, dump_dir=\"/tmp/dumps\")","+    assert config.timeout == 60","+    assert config.check_interval == 5","+    assert config.dump_dir == \"/tmp/dumps\"","+","+","+@pytest.mark.parametrize(","+    \"kwargs\",","+    [","+        {\"timeout\": 0},","+        {\"timeout\": -1},","+        {\"check_interval\": 0},","+        {\"check_interval\": -1},","+    ],","+)","+def test_watchdog_config_rejects_non_positive_values(kwargs):","+    \"\"\"Verify timeout and check_interval must be greater than zero.\"\"\"","+    with pytest.raises(ValidationError):","+        WatchdogConfig(**kwargs)","+","+","+def test_watchdog_config_rejects_non_integral_check_interval():","+    \"\"\"Verify check_interval must be an int; non-integral floats are","+    rejected.\"\"\"","+    with pytest.raises(ValidationError):","+        WatchdogConfig(check_interval=0)","+","+","+def test_watchdog_config_check_interval_is_stored_as_int():","+    \"\"\"Verify check_interval is coerced to and stored as an int.\"\"\"","+    config = WatchdogConfig(check_interval=5)","+    assert config.check_interval == 5","+    assert isinstance(config.check_interval, int)"],"additions":53,"deletions":0,"truncated":false},{"path":"tests/utils_/test_watch_dog.py","lines":["@@ -0,0 +1,118 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+import os","+import time","+from unittest.mock import MagicMock, patch","+","+import pytest","+","+from vllm.config import WatchdogConfig","+from vllm.utils import watch_dog as watch_dog_module","+from vllm.utils.watch_dog import (","+    NoopWatchDog,","+    ThreadedWatchDog,","+    get_watch_dog,","+    start_watch_dog,","+)","+","+","+@pytest.fixture(autouse=True)","+def _reset_global_watch_dog():","+    original = watch_dog_module._watch_dog","+    yield","+    watch_dog_module._watch_dog = original","+","+","+def _make_watch_dog(dump_dir, **kwargs) -> ThreadedWatchDog:","+    config = WatchdogConfig(dump_dir=str(dump_dir), **kwargs)","+    return ThreadedWatchDog(\"engine_0\", config, MagicMock())","+","+","+def _run_check_loop(wd: ThreadedWatchDog, ticks: int) -> int:","+    \"\"\"Run the check loop for ``ticks`` checks; return the dump count.\"\"\"","+    with (","+        patch.object(wd.stop_event, \"wait\", side_effect=[False] * ticks + [True]),","+        patch.object(wd, \"handle_failure\") as handle_failure,","+    ):","+        wd._check_loop()","+    return handle_failure.call_count","+","+","+def test_check_loop_dumps_once_per_stall(tmp_path):","+    wd = _make_watch_dog(tmp_path)","+    wd.timeout = 0","+    assert _run_check_loop(wd, ticks=3) == 1","+    # A new feed followed by another stall dumps again.","+    wd.feed()","+    assert _run_check_loop(wd, ticks=3) == 1","+","+","+def test_check_loop_stays_quiet_while_fed(tmp_path):","+    wd = _make_watch_dog(tmp_path)","+    wd.feed()","+    assert _run_check_loop(wd, ticks=3) == 0","+","+","+def test_disable_suspends_detection_and_restarts_window(tmp_path):","+    wd = _make_watch_dog(tmp_path, timeout=60)","+    wd.last_feed_time = time.monotonic() - 3600","+    with wd.disable():","+        assert _run_check_loop(wd, ticks=3) == 0","+    assert _run_check_loop(wd, ticks=3) == 0","+","+","+def test_handle_failure_appends_numbered_dumps(tmp_path):","+    wd = _make_watch_dog(tmp_path / \"dumps\")","+    wd.handle_failure(\"feed timeout\")","+    wd.handle_failure(\"SIGTERM\")","+","+    with open(wd.dump_file) as f:","+        content = f.read()","+    assert \"dump #1\" in content and \"due to feed timeout\" in content","+    assert \"dump #2\" in content and \"due to SIGTERM\" in content","+    assert test_handle_failure_appends_numbered_dumps.__name__ in content","+","+","+@pytest.mark.timeout(10)","+def test_handle_failure_is_reentrant(tmp_path):","+    # A second SIGTERM can re-enter handle_failure() while a dump holds the lock.","+    wd = _make_watch_dog(tmp_path)","+    with wd.lock:","+        wd.handle_failure(\"SIGTERM\")","+    with open(wd.dump_file) as f:","+        assert \"due to SIGTERM\" in f.read()","+","+","+def test_handle_failure_does_not_raise_on_error(tmp_path):","+    logger = MagicMock()","+    config = WatchdogConfig(dump_dir=str(tmp_path))","+    wd = ThreadedWatchDog(\"engine_0\", config, logger)","+    with patch(\"builtins.open\", side_effect=OSError(\"boom\")):","+        wd.handle_failure(\"feed timeout\")","+    logger.warning.assert_called_once()","+","+","+def test_start_watch_dog_without_dump_dir_stays_noop():","+    logger = MagicMock()","+    wd = start_watch_dog(\"engine_0\", WatchdogConfig(), logger)","+    assert isinstance(wd, NoopWatchDog)","+    assert wd is get_watch_dog()","+    logger.info.assert_not_called()","+","+","+def test_start_watch_dog_with_dump_dir(tmp_path):","+    config = WatchdogConfig(dump_dir=str(tmp_path))","+    with patch(\"faulthandler.enable\") as enable:","+        wd = start_watch_dog(\"worker_1\", config, MagicMock())","+    assert isinstance(wd, ThreadedWatchDog)","+    try:","+        assert wd is get_watch_dog()","+        enable.assert_called_once_with(all_threads=True)","+        assert wd.thread is not None","+        assert wd.thread.is_alive() and wd.thread.daemon","+        wd.handle_failure(\"shutdown\")","+        assert os.path.exists(","+            tmp_path / f\"VLLM_STACK_DUMP_for_worker_1_{os.getpid()}.log\"","+        )","+    finally:","+        wd.stop()"],"additions":118,"deletions":0,"truncated":false},{"path":"tests/v1/engine/test_engine_core_shutdown_signal.py","lines":["@@ -36,6 +36,7 @@"," import signal as signal_module"," from typing import Any"," ","+from vllm.config import WatchdogConfig"," from vllm.v1.engine import EngineCoreRequestType"," from vllm.v1.engine import core as core_module"," from vllm.v1.engine.core import EngineCoreProc, EngineShutdownState","@@ -113,6 +114,9 @@ def __init__(self):","         self.logging_config = None","         self.kv_transfer_config = None","         self.shutdown_timeout = 0","+        # run_engine_core starts the watchdog from this field. The default","+        # config has no dump_dir, so start_watch_dog returns immediately.","+        self.watchdog_config = WatchdogConfig()"," "," "," def _run_engine_core("],"additions":4,"deletions":0,"truncated":false},{"path":"tests/v1/engine/test_startup_watch_processes.py","lines":["@@ -12,6 +12,7 @@"," import zmq"," "," import vllm.platforms as platforms","+from vllm.config import WatchdogConfig"," from vllm.utils import torch_utils"," from vllm.v1.engine import core as core_module"," from vllm.v1.engine import utils as engine_utils","@@ -224,11 +225,19 @@ def test_freeze_gc_after_clean_rocm_engine_core_shutdown(","     expected_calls: list[str],"," ):","     calls: list[str] = []","-    vllm_config = SimpleNamespace(shutdown_timeout=shutdown_timeout)","+    vllm_config = SimpleNamespace(","+        shutdown_timeout=shutdown_timeout,","+        # run_engine_core starts the watchdog from this field. The default","+        # config has no dump_dir, so start_watch_dog returns immediately.","+        watchdog_config=WatchdogConfig(),","+    )","     proc = SimpleNamespace(","         shutdown_state=EngineShutdownState.RUNNING,","         has_work=lambda: has_work,","         vllm_config=vllm_config,","+        # Mirrors EngineCore._send_engine_dead, which run_engine_core calls","+        # from its fatal-error handler.","+        _send_engine_dead=lambda: None,","     )"," ","     def run_busy_loop():"],"additions":10,"deletions":1,"truncated":false},{"path":"tests/v1/executor/test_multiproc_executor.py","lines":["@@ -5,6 +5,7 @@"," from collections import deque"," from types import SimpleNamespace"," from typing import Any","+from unittest.mock import MagicMock, patch"," "," import pytest"," ","@@ -45,7 +46,6 @@ def test_worker_rpc_payload_released_before_next_dequeue():","     worker_proc.rank = 0","     worker_proc.worker = SimpleNamespace(consume=lambda payload: payload)","     worker_proc.handle_output = lambda output: None","-","     with pytest.raises(_ExitWorkerLoop):","         worker_proc.worker_busy_loop()"," ","@@ -61,7 +61,6 @@ def fail():","     worker_proc.worker = SimpleNamespace(fail=fail)","     outputs: list[Any] = []","     worker_proc.handle_output = outputs.append","-","     worker_proc._execute_worker_rpc((\"fail\", (), {}, None))"," ","     assert len(outputs) == 1","@@ -101,3 +100,26 @@ def dequeue(*, timeout=None):","             getattr(executor, method)()","     else:","         assert getattr(executor, method)() is result","+","+","+def test_execute_worker_rpc_feeds_watchdog():","+    \"\"\"Verify the watchdog is fed immediately before and after each RPC.\"\"\"","+","+    def ok():","+        calls.append(\"rpc\")","+","+    worker_proc: Any = WorkerProc.__new__(WorkerProc)","+    worker_proc.rank = 0","+    worker_proc.worker = SimpleNamespace(ok=ok)","+    worker_proc.handle_output = lambda output: None","+    calls: list[str] = []","+    watchdog = MagicMock()","+    watchdog.feed.side_effect = lambda: calls.append(\"feed\")","+","+    with patch(","+        \"vllm.v1.executor.multiproc_executor.get_watch_dog\",","+        return_value=watchdog,","+    ):","+        worker_proc._execute_worker_rpc((\"ok\", (), {}, None))","+","+    assert calls == [\"feed\", \"rpc\", \"feed\"]"],"additions":24,"deletions":2,"truncated":false},{"path":"vllm/config/__init__.py","lines":["@@ -62,6 +62,7 @@","     get_layers_from_vllm_config,","     set_current_vllm_config,"," )","+from vllm.config.watchdog_config import WatchdogConfig"," from vllm.config.watermarking import WatermarkConfig"," from vllm.config.weight_transfer import WeightTransferConfig"," ","@@ -153,6 +154,7 @@","     \"get_current_vllm_config_or_none\",","     \"set_current_vllm_config\",","     \"get_layers_from_vllm_config\",","+    \"WatchdogConfig\",","     \"WeightTransferConfig\",","     \"WatermarkConfig\","," ]"],"additions":2,"deletions":0,"truncated":false},{"path":"vllm/config/vllm.py","lines":["@@ -53,6 +53,7 @@"," from .speculative import EagleModelTypes, NgramGPUTypes, SpeculativeConfig"," from .structured_outputs import StructuredOutputsConfig"," from .utils import SupportsHash, config, get_field, replace","+from .watchdog_config import WatchdogConfig"," from .watermarking import WatermarkConfig"," from .weight_transfer import WeightTransferConfig"," ","@@ -444,6 +445,9 @@ class VllmConfig:","     weight_transfer_config: WeightTransferConfig | None = None","     \"\"\"The configurations for weight transfer during RL training.\"\"\""," ","+    watchdog_config: WatchdogConfig = Field(default_factory=WatchdogConfig)","+    \"\"\"Configuration for the stack-dump watchdog.\"\"\"","+","     shutdown_timeout: int = Field(default=0, ge=0)","     \"\"\"Shutdown grace period for in-flight requests. Shutdown will be delayed for","     up to this amount of time to allow already-running requests to complete. Any"],"additions":4,"deletions":0,"truncated":false},{"path":"vllm/config/watchdog_config.py","lines":["@@ -0,0 +1,30 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+from pydantic import Field","+","+from vllm.config.utils import config","+","+_DEFAULT_TIMEOUT = 300","+_DEFAULT_CHECK_INTERVAL = 10","+","+","+@config","+class WatchdogConfig:","+    \"\"\"Configuration for the stack-dump watchdog.","+","+    The watchdog runs a background thread that periodically checks whether the","+    main thread has fed it in time. If not, it dumps the stack traces of all","+    threads to a dump file for debugging.","+    \"\"\"","+","+    timeout: int = Field(default=_DEFAULT_TIMEOUT, gt=0)","+    \"\"\"Timeout in seconds after which the watchdog considers the process to be","+    stuck and dumps stack traces. Must be greater than 0.\"\"\"","+","+    check_interval: int = Field(default=_DEFAULT_CHECK_INTERVAL, gt=0)","+    \"\"\"Interval in seconds at which the watchdog checks for feed timeouts.\"\"\"","+","+    dump_dir: str = \"\"","+    \"\"\"Directory to save stack dump files. Empty string disables the watchdog","+    feature.\"\"\""],"additions":30,"deletions":0,"truncated":false},{"path":"vllm/distributed/device_communicators/shm_broadcast.py","lines":["@@ -45,7 +45,6 @@"," "," logger = init_logger(__name__)"," ","-"," SPINLOOP_EXT_ENABLED = False"," if envs.VLLM_USE_SPINLOOP_EXT:","     try:","@@ -827,6 +826,46 @@ def should_warn(self) -> bool:","                     return True","             return False"," ","+    def _wait_until_readable(","+        self,","+        metadata_buffer,","+        read_timeout: ReadTimeoutWithWarnings,","+    ) -> bool:","+        \"\"\"Wait for the current block to be readable by this reader.\"\"\"","+","+        def check_readable():","+            memory_fence()","+            read_flag = metadata_buffer[self.local_reader_rank + 1]","+            written_flag = metadata_buffer[0]","+            return not (not written_flag or read_flag)","+","+        if SPINLOOP_EXT_ENABLED and not check_readable():","+            spinloop(","+                metadata_buffer[0 : self.local_reader_rank + 1],","+                check_readable,","+                timeout=SPINLOOP_TIMEOUT_SECONDS,","+            )","+","+        if check_readable():","+            return True","+","+        # this block is either","+        # (1) not written","+        # (2) already read by this reader","+","+        # for readers, `self.current_idx` is the next block to read","+        # if this block is not ready,","+        # we need to wait until it is written","+        self._spin_condition.wait(timeout_ms=read_timeout.timeout_ms())","+","+        if self.shutting_down:","+            raise RuntimeError(\"cancelled\")","+","+        # if we wait for a long time, log a message","+        if read_timeout.should_warn():","+            logger.info(LONG_WAIT_TIME_LOG_MSG, VLLM_RINGBUFFER_WARNING_INTERVAL)","+        return False","+","     @contextmanager","     def acquire_read(","         self,","@@ -839,39 +878,7 @@ def acquire_read(","         )","         with self.buffer.get_metadata(self.current_idx) as metadata_buffer:","             while True:","-","-                def check():","-                    memory_fence()","-                    read_flag = metadata_buffer[self.local_reader_rank + 1]","-                    written_flag = metadata_buffer[0]","-                    return not (not written_flag or read_flag)","-","-                if SPINLOOP_EXT_ENABLED and not check():","-                    spinloop(","-                        metadata_buffer[0 : self.local_reader_rank + 1],","-                        check,","-                        timeout=SPINLOOP_TIMEOUT_SECONDS,","-                    )","-","-                if not check():","-                    # this block is either","-                    # (1) not written","-                    # (2) already read by this reader","-","-                    # for readers, `self.current_idx` is the next block to read","-                    # if this block is not ready,","-                    # we need to wait until it is written","-                    self._spin_condition.wait(timeout_ms=read_timeout.timeout_ms())","-","-                    if self.shutting_down:","-                        raise RuntimeError(\"cancelled\")","-","-                    # if we wait for a long time, log a message","-                    if read_timeout.should_warn():","-                        logger.info(","-                            LONG_WAIT_TIME_LOG_MSG, VLLM_RINGBUFFER_WARNING_INTERVAL","-                        )","-","+                if not self._wait_until_readable(metadata_buffer, read_timeout):","                     continue","                 # found a block that is not read by this reader","                 # let caller read from the buffer"],"additions":41,"deletions":34,"truncated":false},{"path":"vllm/engine/arg_utils.py","lines":["@@ -68,6 +68,7 @@","     StructuredOutputsConfig,","     UVAOffloadConfig,","     VllmConfig,","+    WatchdogConfig,","     WeightTransferConfig,","     get_attr_docs,"," )","@@ -853,6 +854,8 @@ class EngineArgs:"," ","     shutdown_timeout: int = 0"," ","+    watchdog_config: WatchdogConfig = get_field(VllmConfig, \"watchdog_config\")","+","     weight_transfer_config: WeightTransferConfig | None = get_field(","         VllmConfig,","         \"weight_transfer_config\",","@@ -906,6 +909,9 @@ def __post_init__(self):","         if isinstance(self.ir_op_priority, dict):","             self.ir_op_priority = IrOpPriorityConfig(**self.ir_op_priority)"," ","+        if isinstance(self.watchdog_config, dict):","+            self.watchdog_config = WatchdogConfig(**self.watchdog_config)","+","         from vllm.config.quantization import resolve_quantization_config"," ","         self.quantization_config = resolve_quantization_config(","@@ -1890,6 +1896,7 @@ def add_cli_args(parser: FlexibleArgumentParser) -> FlexibleArgumentParser:","             \"--aux-output-config\", **vllm_kwargs[\"aux_output_config\"]","         )","         vllm_group.add_argument(\"--profiler-config\", **vllm_kwargs[\"profiler_config\"])","+        vllm_group.add_argument(\"--watchdog-config\", **vllm_kwargs[\"watchdog_config\"])","         vllm_group.add_argument(","             \"--optimization-level\", **vllm_kwargs[\"optimization_level\"]","         )","@@ -2891,6 +2898,7 @@ def create_engine_config(","             optimization_level=self.optimization_level,","             performance_mode=self.performance_mode,","             weight_transfer_config=self.weight_transfer_config,","+            watchdog_config=self.watchdog_config,","             shutdown_timeout=self.shutdown_timeout,","         )"," "],"additions":8,"deletions":0,"truncated":false},{"path":"vllm/utils/watch_dog.py","lines":["@@ -0,0 +1,174 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+import faulthandler","+import os","+import threading","+import time","+from abc import ABC, abstractmethod","+from collections.abc import Iterator","+from contextlib import AbstractContextManager, contextmanager","+from logging import Logger","+","+from vllm.config import WatchdogConfig","+","+","+class WatchDog(ABC):","+    @abstractmethod","+    def feed(self) -> None:","+        \"\"\"Mark that the process is making progress.\"\"\"","+","+    @abstractmethod","+    def disable(self) -> AbstractContextManager[None]:","+        \"\"\"Suspend timeout detection, e.g. while blocking on idle input.\"\"\"","+","+    @abstractmethod","+    def handle_failure(self, reason: str) -> None:","+        \"\"\"Record the state of all threads for debugging.\"\"\"","+","+","+class NoopWatchDog(WatchDog):","+    def feed(self) -> None:","+        pass","+","+    @contextmanager","+    def disable(self) -> Iterator[None]:","+        yield","+","+    def handle_failure(self, reason: str) -> None:","+        pass","+","+","+class ThreadedWatchDog(WatchDog):","+    \"\"\"Dumps the stacks of all threads when not fed within the timeout.\"\"\"","+","+    def __init__(self, name: str, watchdog_config: WatchdogConfig, logger: Logger):","+        self.name = name","+        self.timeout = watchdog_config.timeout","+        self.check_interval = watchdog_config.check_interval","+        self.dump_dir = watchdog_config.dump_dir","+        self.dump_file = os.path.join(","+            self.dump_dir, f\"VLLM_STACK_DUMP_for_{name}_{os.getpid()}.log\"","+        )","+        self.dump_seq = 1","+        self.logger = logger","+        self.last_feed_time = time.monotonic()","+        # 0.0 so that the first timeout is always dumped.","+        self.last_timeout_log = 0.0","+        self.active = True","+        # Reentrant: handle_failure() may be re-entered from a signal handler.","+        self.lock = threading.RLock()","+        self.stop_event = threading.Event()","+        self.thread: threading.Thread | None = None","+        self.handler = None","+","+    def feed(self) -> None:","+        self.last_feed_time = time.monotonic()","+","+    @contextmanager","+    def disable(self) -> Iterator[None]:","+        assert self.active, \"WatchDog.disable() is not re-entrant\"","+        self.active = False","+        try:","+            yield","+        finally:","+            self.active = True","+","+    def handle_failure(self, reason: str) -> None:","+        \"\"\"Append a numbered dump of all thread stacks to the dump file.\"\"\"","+        with self.lock:","+            if self.handler is None:","+                self.dump_stack(reason)","+            else:","+                self.handler(reason)","+","+    def dump_stack(self, reason: str) -> None:","+        try:","+            os.makedirs(self.dump_dir, exist_ok=True)","+            with open(self.dump_file, \"a\") as f:","+                f.write(","+                    f\"\\n>>> Call stack dump #{self.dump_seq} at \"","+                    f\"{time.ctime()} due to {reason}\\n\\n\"","+                )","+                faulthandler.dump_traceback(file=f, all_threads=True)","+                f.write(\"\\n\" + \"=\" * 64 + \"\\n\")","+            self.dump_seq += 1","+            self.logger.info(","+                \"[Watchdog]Dumped stack to %s due to %s\", self.dump_file, reason","+            )","+        except Exception as e:","+            self.logger.warning(","+                \"[Watchdog]Failed to dump stack trace to %s: %s\",","+                self.dump_file,","+                e,","+            )","+","+    def set_handler(self, handler) -> None:","+        self.handler = handler","+","+    def _check_loop(self) -> None:","+        while not self.stop_event.wait(self.check_interval):","+            now = time.monotonic()","+            # While disabled, treat the watchdog as continuously fed so the","+            # timeout window restarts once it is re-enabled.","+            if not self.active:","+                self.last_feed_time = now","+                continue","+            # Dump at most once per stall.","+            if (","+                now - self.last_feed_time > self.timeout","+                and self.last_timeout_log < self.last_feed_time","+            ):","+                self.last_timeout_log = now","+                self.handle_failure(\"feed timeout\")","+","+    def start(self) -> None:","+        if self.thread is not None and self.thread.is_alive():","+            return","+        self.stop_event.clear()","+        self.thread = threading.Thread(target=self._check_loop, daemon=True)","+        self.feed()","+        self.thread.start()","+        self.logger.info(","+            \"[Watchdog]Started thread for %s (pid=%d)\", self.name, os.getpid()","+        )","+","+    def stop(self) -> None:","+        self.stop_event.set()","+        if self.thread is not None:","+            self.thread.join(timeout=2)","+            # Keep a still-alive thread so a later start() won't spawn another.","+            if not self.thread.is_alive():","+                self.thread = None","+","+","+_watch_dog: WatchDog = NoopWatchDog()","+","+","+def get_watch_dog() -> WatchDog:","+    \"\"\"Return the process-wide WatchDog singleton.\"\"\"","+    return _watch_dog","+","+","+def start_watch_dog(","+    name: str,","+    watchdog_config: WatchdogConfig,","+    logger: Logger,","+) -> WatchDog:","+    \"\"\"Start the process-wide watchdog if ``watchdog_config.dump_dir`` is set.","+","+    Returns the WatchDog singleton either way.","+    \"\"\"","+    global _watch_dog","+    if not watchdog_config.dump_dir:","+        return _watch_dog","+","+    logger.info(","+        \"[Watchdog]Start with timeout=%s check_interval=%s dump_dir=%s\",","+        watchdog_config.timeout,","+        watchdog_config.check_interval,","+        watchdog_config.dump_dir,","+    )","+    faulthandler.enable(all_threads=True)","+    _watch_dog = ThreadedWatchDog(name, watchdog_config, logger)","+    _watch_dog.start()","+    return _watch_dog"],"additions":174,"deletions":0,"truncated":false},{"path":"vllm/v1/engine/core.py","lines":["@@ -51,6 +51,7 @@"," from vllm.utils.hashing import get_hash_fn_by_name"," from vllm.utils.network_utils import make_zmq_socket"," from vllm.utils.system_utils import decorate_logs, set_process_title","+from vllm.utils.watch_dog import get_watch_dog, start_watch_dog"," from vllm.v1.attention.backends.utils import resolve_kv_cache_layout"," from vllm.v1.core.kv_cache_planning import get_kv_cache_configs"," from vllm.v1.core.kv_cache_utils import (","@@ -1498,6 +1499,8 @@ def signal_handler(signum, frame):","                     \"[shutdown] EngineCore: trigger received signal=%s\",","                     signal_name,","                 )","+                if signum == signal.SIGTERM:","+                    get_watch_dog().handle_failure(signal_name)","                 # Record the request first so