ctory = $this->createDirectoryNode($folder, $childNodes);","+","+\t\t$this->tree->expects($this->once())","+\t\t\t->method('getNodeForPath')","+\t\t\t->with($folderPath)","+\t\t\t->willReturn($directory);","+","+\t\t$this->eventDispatcher->expects($this->once())","+\t\t\t->method('dispatchTyped')","+\t\t\t->willReturnCallback(function (BeforeZipCreatedEvent $event) use ($downloadBlocked, $filesFilter): BeforeZipCreatedEvent {","+\t\t\t\t$this->assertSame($filesFilter, $event->getFiles());","+\t\t\t\t$this->assertTrue($event->allowsPartialArchive());","+\t\t\t\t$event->addNodeFilter(static fn (OCPNode $node): ?string => in_array($node->getName(), $downloadBlocked, true) ? 'blocked' : null);","+","+\t\t\t\treturn $event;","+\t\t\t});","+","+\t\tob_start();","+\t\t$request = $this->createRequest($folderPath, $filesFilter);","+\t\t$continueHandling = $plugin->handleDownload($request, $this->response);","+","+\t\t$output = $this->getActualOutputForAssertion();","+\t\t$this->assertStringContainsString('missing_files.json', $output, \"$output does not contain missin_files.json\");","+\t\tforeach ($expectedMissingFiles as $file => $error) {","+\t\t\t$stringToMatch = sprintf('%s\": \"%s\"', $file, $error);","+\t\t\t$this->assertStringContainsString($stringToMatch, $output, \"$output does not contain $stringToMatch\");","+\t\t}","+","+\t\t// assert that the handling should be stopped","+\t\t$this->assertFalse($continueHandling);","+\t}","+","+\t/*","+\t * Tests that the content of an excluded folder is not listed, and that a","+\t * folder whose content cannot be listed is reported as missing without","+\t * aborting the archive.","+\t */","+\tpublic function testDownloadingAFolderWithExcludedAndUnreadableSubfolders(): void {","+\t\t$plugin = $this->createPlugin(true);","+","+\t\t$folderPath = '/user/files/folder';","+\t\t$allowedFile = $this->createFile(\"{$folderPath}/allowed.txt\", 'allowed', strlen('allowed'));","+\t\t$blockedFolder = $this->createFolderNode(\"{$folderPat