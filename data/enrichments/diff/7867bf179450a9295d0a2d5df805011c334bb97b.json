\t\t$folder->expects($this->never())->method('getDirectoryListing');","+","+\t\t$plugin->handleDownload($this->createRequest($folderPath), $this->response);","+\t}","+","+\tpublic static function dataDownloadingAFolderShouldFailWhenItemsAreBlocked(): array {","+\t\treturn [","+\t\t\t'no files filtering' => [ [] ],","+\t\t\t'files filtering' => [ ['allowed.txt', 'blocked.txt'] ],","+\t\t];","+\t}","+","+\t/*","+\t * Tests that when `archive_report_missing_files` is disabled, downloading","+\t * a directory which contains a non-downloadable item stops the entire","+\t * download.","+\t */","+\t#[DataProvider(methodName: 'dataDownloadingAFolderShouldFailWhenItemsAreBlocked')]","+\tpublic function testDownloadingAFolderShouldFailWhenItemsAreBlocked(array $filesFilter): void {","+\t\t$plugin = $this->createPlugin(false);","+\t\t$folderPath = '/user/files/folder';","+\t\t$allowedFile = $this->createFile(\"{$folderPath}/allowed.txt\", 'allowed', strlen('allowed'));","+\t\t$blockedFile = $this->createFile(\"{$folderPath}/blocked.txt\", 'secret', strlen('secret'));","+\t\t$files = [$allowedFile, $blockedFile];","+\t\t$childNodes = [","+\t\t\t'allowed.txt' => $this->createNode($allowedFile),","+\t\t\t'blocked.txt' => $this->createNode($blockedFile),","+\t\t];","+","+\t\t$folder = $this->createFolderNode($folderPath, $files);","+\t\t$directory = $this->createDirectoryNode($folder, $childNodes);","+","+\t\t$this->tree->expects($this->once())","+\t\t\t->method('getNodeForPath')","+\t\t\t->with($folderPath)","+\t\t\t->willReturn($directory);","+","+\t\t$errorMessage = 'Blocked by ACL';","+\t\t$this->eventDispatcher->expects($this->once())","+\t\t\t->method('dispatchTyped')","+\t\t\t->willReturnCallback(function (BeforeZipCreatedEvent $event) use ($errorMessage, $filesFilter): BeforeZipCreatedEvent {","+\t\t\t\t$this->assertSame($filesFilter, $event->getFiles());","+\t\t\t\t$this->assertFalse($event->allowsPartialArchive());","+\t\t\t\t$event->setSuccessful(false);","+\t\t\t\t$event->setErrorMessage($errorMessage);","+","+\t\t\t\treturn $event;","+\t\t\t});","+","+\t\t$this->expectException(Forbidden::class);","+\t\t$this->expectExceptionMessage($errorMessage);","+","+\t\t$plugin->handleDownload($this->createRequest($folderPath, $filesFilter), $this->response);","+\t}","+","+\tpublic static function dataDownloadingAFolderWithMissingFilesReportingShouldSucceed(): array {","+\t\treturn [","+\t\t\t// files are reporting as missing either because they are download-blocked or because some error happened","+\t\t\t'full directory download' => [","+\t\t\t\t'children' => [","+\t\t\t\t\t['name' => 'allowed.txt', 'content' => 'allowed', 'readSize' => null],","+\t\t\t\t\t[","+\t\t\t\t\t\t'name' => 'blocked.txt',","+\t\t\t\t\t\t'content' => 'blocked',","+\t\t\t\t\t\t'readSize' => null","+\t\t\t\t\t],","+\t\t\t\t\t[","+\t\t\t\t\t\t'name' => 'error.txt',","+\t\t\t\t\t\t'content' => new \\RuntimeException('read error'),","+\t\t\t\t\t\t'readSize' => null","+\t\t\t\t\t],","+\t\t\t\t],","+\t\t\t\t'filesFilter' => [],","+\t\t\t\t'downloadBlocked' => ['blocked.txt'],","+\t\t\t\t'expectedMissingFiles' => [","+\t\t\t\t\t'blocked.txt' => 'blocked',","+\t\t\t\t\t'error.txt' => 'File could not be added to the archive. Please check the server logs for more information.'","+\t\t\t\t],","+\t\t\t],","+\t\t\t// files filtered out should not be reported as missing","+\t\t\t'filtering some files' => [","+\t\t\t\t'children' => [","+\t\t\t\t\t['name' => 'allowed.txt', 'content' => 'allowed', 'readSize' => null],","+\t\t\t\t\t['name' => 'blocked.txt', 'content' => 'blocked', 'readSize' => null],","+\t\t\t\t\t['name' => 'error.txt', 'content' => new \\RuntimeException('read error'), 'readSize' => null],","+\t\t\t\t],","+\t\t\t\t'filesFilter' => ['allowed.txt', 'blocked.txt'],","+\t\t\t\t'downloadBlocked' => ['blocked.txt'],","+\t\t\t\t'expectedMissingFiles' => ['blocked.txt' => 'blocked'],","+\t\t\t],","+\t\t\t// incomplete download","+\t\t\t'incomplete file download' => [","+\