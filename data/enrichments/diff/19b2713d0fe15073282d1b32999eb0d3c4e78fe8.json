ould not check the IP');","+        $errors = [];","+        $downloader->download(","+            static function (): void {","+            },","+            static function (\\Throwable $e) use (&$errors): void {","+                $errors[] = $e;","+            },","+            'localhost',","+            'http://'.stream_socket_get_name($server, false).'/',","+            ['prevent_ip_access_callable' => static function () use ($exception): bool {","+                throw $exception;","+            }]","+        );","+","+        $this->tickUntil($downloader, function () use ($server, &$errors): bool {","+            $this->acceptClient($server);","+","+            return count($errors) > 0;","+        });","+","+        self::assertSame([$exception], $errors);","+        self::assertSame([], $this->readProperty($downloader, 'jobs'));","+    }","+","+    public function testRequestExceedingTheMaxFileSizeIsRejectedOnceAndRemovedFromTheTransfersInFlight(): void","+    {","+        $server = $this->createLocalServer();","+        $downloader = $this->createDownloader();","+        $errors = [];","+        $downloader->download(","+            static function (): void {","+            },","+            static function (\\Throwable $e) use (&$errors): void {","+                $errors[] = $e;","+            },","+            'localhost',","+            'http://'.stream_socket_get_name($server, false).'/',","+            ['max_file_size' => 10]","+        );","+","+        $this->tickUntil($downloader, function () use ($server, &$errors): bool {","+            if (null !== ($client = $this->acceptClient($server))) {","+                // only part of the body is sent so the transfer stays in flight, with both the announced and the received size over the limit","+                fwrite($client, \"HTTP/1.1 200 OK\\r\\nContent-Length: 1000\\r\\n\\r\\n\".str_repeat('a', 500));","+            }","+","+            return count($errors) > 0;","+        });","+","+        self::assertCount(1, $errors);","+        self::assertInstanceOf(MaxFileSizeExceededException::class, $errors[0]);","+        self::assertSame([], $this->readProperty($downloader, 'jobs'), 'a rejected request must not keep transferring');","+    }","+","+    public function testRejectionWhichAbortsAnotherTransferDoesNotBreakTheProgressLoop(): void","+    {","+        $server = $this->createLocalServer();","+        $downloader = $this->createDownloader();","+        $errors = [];","+        $reject = function (\\Throwable $e) use ($downloader, &$errors): void {","+            $errors[] = $e;","+            // e.g. a failed download aborting the rest of the batch","+            foreach (array_keys($this->readProperty($downloader, 'jobs')) as $id) {","+                $downloader->abortRequest((int) $id);","+            }","+        };","+        $url = 'http://'.stream_socket_get_name($server, false).'/';","+        $downloader->download(static function (): void {","+        }, $reject, 'localhost', $url, ['max_file_size' => 10]);","+        $downloader->download(static function (): void {","+        }, $reject, 'localhost', $url, ['max_file_size' => 10]);","+","+        $clients = [];","+        $sent = false;","+        $this->tickUntil($downloader, function () use ($server, &$clients, &$sent, &$errors): bool {","+            while (count($clients) < 2 && null !== ($client = $this->acceptClient($server))) {","+                $clients[] = $client;","+            }","+            // both responses are sent at once so both transfers go over the limit in the same tick","+            if (!$sent && count($clients) === 2) {","+                foreach ($clients as $client) {","+                    fwrite($client, \"HTTP/1.1 200 OK\\r\\nContent-Length: 1000\\r\\n\\r\\n\");","+                }","+                $sent = true;","+            }","+","+            return count($errors) > 0;","+        });","+","+        self::assertCount(1, $errors);","+        self::assertSame([], $this->readProperty($downloader, 'jobs'));","+    }","+","     /**","      * @param list<string> $headers","      */","@@ -538,4 +726,53 @@ private function writeProperty(CurlDownloader $downloader, string $name, $value)","         }","         $property->setValue($downloader, $value);","     }","+","+    /**","+     * @return resource","+     */","+    private function createLocalServer()","+    {","+        $server = @stream_socket_server('tcp://127.0.0.1:0', $errno, $errstr);","+        if (false === $server) {","+            self::markTestSkipped('Could not open a local socket: '.$errstr);","+        }","+        $this->sockets[] = $server;","+","+        return $server;","+    }","+","+    /**","+     * @param  resource      $server","+     * @return resource|null the connection which was waiting, if any","+     */","+    private function acceptClient($server)","+    {","+        $client = @stream_socket_accept($server, 0);","+        if (false === $client) {","+            return null;","+        }","+        $this->sockets[] = $client;","+","+        return $client;","+    }","+","+    /**","+     * @param callable(): bool $condition","+     */","+    private function tickUntil(CurlDownloader $downloader, callable $condition): void","+    {","+        // the local server never finishes its responses, so do not let curl_multi_select() wait for them","+        $this->writeProperty($downloader, 'selectTimeout', 0.01);","+        $deadline = microtime(true) + 5;","+        while (!$condition()) {","+            if (microtime(true) > $deadline) {","+                self::fail('Timed out waiting for the transfer');","+            }","+            $downloader->tick();","+        }","+        // let any further progress of the rejected transfer surface","+        for ($i = 0; $i < 10; $i++) {","+            $downloader->tick();","+        }","+    }"," }",""],"additions":237,"deletions":0,"truncated":false}],"additions":291,"deletions":10,"truncated":false,"file