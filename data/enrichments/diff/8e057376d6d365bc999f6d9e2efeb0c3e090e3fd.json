file, base_dir)?;","+    Ok(super::StorageConfig {","         hosted_dir,","         cache_dir,","+        cache,","         hosted_backend: file.s3.take().map_or(HostedStoreConfig::Fs, HostedStoreConfig::S3),","-    }","+    })"," }"],"additions":10,"deletions":5,"truncated":false},{"path":"pnpr/crates/config/src/presets.rs","lines":["@@ -78,6 +78,7 @@ impl Config {","             logs: LogConfig::default(),","             osv: OsvConfig::default(),","             resolution_cache_secret: random_secret(),","+            has_configured_secret: false,","             http: super::HttpConfig {","                 listen,","                 public_url: format!(\"http://{listen}\"),","@@ -91,6 +92,7 @@ impl Config {","             },","             storage: super::StorageConfig {","                 cache_dir: default_cache_dir(&storage),","+                cache: super::CacheConfig::default(),","                 hosted_dir: storage,","                 hosted_backend: HostedStoreConfig::Fs,","             },"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/storage_config.rs","lines":["@@ -0,0 +1,90 @@","+//! Configuration for authoritative storage and disposable proxy cache.","+","+use crate::{","+    ConfigFile, HostedStoreConfig, RegistryError,","+    byte_size::{ByteSize, parse_byte_size},","+    config_file::CacheFile,","+    upstream::{Interval, parse_interval},","+};","+use std::{","+    path::{Path, PathBuf},","+    time::Duration,","+};","+","+/// Configuration for the proxy cache budget and retention policies.","+#[derive(Debug, Default, Clone, PartialEq, Eq)]","+pub struct CacheConfig {","+    /// Maximum size of the cache in bytes. When set, LRU eviction reclaims","+    /// the oldest files when total cache size exceeds this limit.","+    pub max_size: Option<u64>,","+    /// Maximum age of cached entries. Files older than this duration are","+    /// evicted during cache cleanup.","+    pub max_age: Option<Duration>,","+}","+","+/// Configuration for authoritative package storage and disposable proxy cache.","+#[derive(Debug, Clone)]","+pub struct StorageConfig {","+    /// Directory under which authoritative packuments and tarballs live.","+    pub hosted_dir: PathBuf,","+    /// Directory under which the disposable proxy cache lives.","+    pub cache_dir: PathBuf,","+    /// Settings for proxy-cache budget, retention, and eviction.","+    pub cache: CacheConfig,","+    /// Where the authoritative (hosted) store lives (local filesystem or S3).","+    pub hosted_backend: HostedStoreConfig,","+}","+","+pub(crate) fn default_storage_string() -> String {","+    \"./storage\".to_string()","+}","+","+/// The default location for the disposable proxy cache directory.","+#[must_use]","+pub fn default_cache_dir(storage: &Path) -> PathBuf {","+    storage.join(\".pnpr-cache\")","+}","+","+pub(crate) fn resolve_relative(raw: &str, base_dir: &Path) -> PathBuf {","+    let path = PathBuf::from(raw);","+    if path.is_absolute() {","+        return path;","+    }","+    base_dir.join(path)","+}","+","+pub(crate) fn resolve_storage_paths(","+    file: &ConfigFile,","+    base_dir: &Path,","+) -> Result<(PathBuf, PathBuf, CacheConfig), RegistryError> {","+    let storage = resolve_relative(&file.storage, base_dir);","+    let (cache_dir, cache) = match &file.cache {","+        None => (default_cache_dir(&storage), CacheConfig::default()),","+        Some(CacheFile::Path(raw)) => (resolve_relative(raw, base_dir), CacheConfig::default()),","+        Some(CacheFile::Settings(settings)) => {","+            let cache_dir = settings.path","+                .as_deref()","+                .map_or_else(|| default_cache_dir(&storage), |raw| resolve_relative(raw, base_dir));","+            let max_size = settings.max_size","+                .as_ref()","+                .map(|ByteSize(raw)| {","+                    parse_byte_size(raw)","+                        .ok_or_else(|| RegistryError::InvalidConfig {","+                            reason: format!(\"cache.max_size: invalid byte size {raw:?}\"),","+                        })","+                })","+                .transpose()?;","+            let max_age = settings.max_age","+                .as_ref()","+                .map(|Interval(raw)| {","+                    parse_interval(raw)","+                        .ok_or_else(|| RegistryError::InvalidConfig {","+                            reason: format!(\"cache.max_age: invalid interval {raw:?}\"),","+                        })","+                })","+                .transpose()?;","+            (cache_dir, CacheConfig { max_size, max_age })","+        }","+    };","+    Ok((storage, cache_dir, cache))","+}"],"additions":90,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/tests/storage.rs","lines":["@@ -239,3 +239,47 @@ fn ecosystem_groups_scope_names_sources_defaults_and_hosted_storage() {","     }","     assert_eq!(config.routing.registries.addressed(\"cargo/internal\", Ecosystem::Npm), None);"," }","+","+#[test]","+fn cache_settings_parsed_from_table() {","+    let yaml = \"\\","+storage: /var/lib/pnpr","+cache:","+  path: /custom/cache","+  maxSize: 10GB","+  maxAge: 30d","+\";","+    let config = Config::from_yaml_str(yaml, Path::new(\"/etc/pnpr\"), listen(), None).unwrap();","+    assert_eq!(config.storage.cache_dir, PathBuf::from(\"/custom/cache\"));","+    assert_eq!(config.storage.cache.max_size, Some(10 * 1024 * 1024 * 1024));","+    assert_eq!(config.storage.cache.max_age, Some(std::time::Duration::from_hours(720)));","+}","+","+#[test]","+fn cache_settings_defaults_path_when_omitted_in_table() {","+    let yaml = \"\\","+storage: /var/lib/pnpr","+cache:","+  max_size: 500MB","+  max_age: 12h","+\";","+    let config = Config::from_yaml_str(yaml, Path::new(\"/etc/pnpr\"), listen(), None).unwrap();","+    assert_eq!(config.storage.cache_dir, PathBuf::from(\"/var/lib/pnpr/.pnpr-cache\"));","+    assert_eq!(config.storage.cache.max_size, Some(500 * 1024 * 1024));","+    assert_eq!(config.storage.cache.max_age, Some(std::time::Duration::from_hours(12)));","+}","+","+#[test]","+fn cache_rejects_invalid_max_size_or_age() {","+    let bad_size = \"storage: /x\\ncache:\\n  maxSize: not-a-size\\n\";","+    assert!(Config::from_yaml_str(bad_size, Path::new(\"/x\"), listen(), None).is_err());","+","+    let bad_age = \"storage: /x\\ncache:\\n  maxAge: whenever\\n\";","+    assert!(Config::from_yaml_str(bad_age, Path::new(\"/x\"), listen(), None).is_err());","+}","+","+#[test]","+fn cache_rejects_unknown_fields() {","+    let yaml = \"storage: /x\\ncache:\\n  unknownField: 123\\n\";","+    assert!(Config::from_yaml_str(yaml, Path::new(\"/x\"), listen(), None).is_err());","+}"],"additions":44,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/upstream.rs","lines":["@@ -370,7 +370,8 @@ fn upstream_headers<Sys: EnvVar>("," /// verdaccio) is read as **seconds**. A trailing number with no suffix"," /// is also seconds. Returns `None` for anything unparsable so the"," /// caller can surface a precise config error.","-pub(super) fn parse_interval(raw: &str) -> Option<Duration> {","+#[must_use]","+pub fn parse_interval(raw: &str) -> Option<Duration> {","     let raw = raw.trim();","     if raw.is_empty() {","         return None;"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/cache_maintenance.rs","lines":["@@ -0,0 +1,405 @@","+//! Upstream proxy cache reclamation, orphan pruning, and LRU eviction.","+//!","+//! Reclaims orphaned upstream cache namespaces left behind by per-process","+//! secrets or removed/reconfigured upstreams, evicts stale cached entries","+//! exceeding TTL, and enforces cache size caps via LRU eviction.","+","+use crate::{Config, Result};","+use std::{","+    collections::HashSet,","+    path::{Path, PathBuf},","+    time::{Duration, SystemTime},","+};","+use tokio::fs;","+","+/// Summary of items evicted and reclaimed during cache maintenance.","+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]","+pub struct CacheReport {","+    /// Number of orphaned namespace directories removed.","+    pub namespaces_removed: usize,","+    /// Number of individual cache files evicted.","+    pub files_evicted: usize,","+    /// Total bytes of cache storage reclaimed.","+    pub bytes_reclaimed: u64,","+}","+","+/// Options controlling cache reclamation and eviction.","+#[derive(Debug, Default, Clone, PartialEq, Eq)]","+pub struct CacheGcOptions {","+    /// Report reclaimable entries without deleting anything.","+    pub dry_run: bool,","+    /// Maximum total cache size to retain. Oldest files are evicted first.","+    pub max_size: Option<u64>,","+    /// Maximum age of cached entries. Files older than this are deleted.","+    pub max_age: Option<Duration>,","+    /// Only prune orphaned upstream namespaces without evicting active cache files.","+    pub orphans_only: bool,","+}","+","+struct CachedFile {","+    path: PathBuf,","+    size: u64,","+    effective_time: SystemTime,","+    age: Duration,","+}","+","+/// The set of active cache namespaces derived from configured upstreams.","+#[must_use]","+pub fn active_cache_namespaces(config: &Config) -> HashSet<String> {","+    config.routing.upstreams","+        .keys()","+        .map(|name| crate::server::compute_upstream_cache_namespace(config, name))","+        .collect()","+}","+","+/// Run a complete cache collection pass according to the given options.","+pub async fn collect_cache(config: &Config, options: &CacheGcOptions) -> Result<CacheReport> {","+    let active = active_cache_namespaces(config);","+    let mut report = prune_orphaned_namespaces(","+        &config.storage.cache_dir,","+        &active,","+        options.dry_run,","+        config.has_configured_secret,","+    )","+    .await?;","+    if options.orphans_only {","+        return Ok(report);","+    }","+    let max_age = options.max_age.or(config.storage.cache.max_age);","+    let max_size = options.max_size.or(config.storage.cache.max_size);"],"additions":69,"deletions":0,"truncated":false}],"additions":440,"deletions":121,"truncated":true,"file_count":14},"error":null,"fetched_at":"2026-10-15T13:21:34.873055+00:00"}