{"id":"8e057376d6d365bc999f6d9e2efeb0c3e090e3fd","axis":"silent","repo":"pnpm/pnpm","sha":"8e057376d6d365bc999f6d9e2efeb0c3e090e3fd","parsed":{"files":[{"path":".changeset/pnpr-cache-eviction.md","lines":["@@ -0,0 +1,5 @@","+---","+\"@pnpm/pnpr\": minor","+---","+","+pnpr now supports cache size caps, TTL retention, and orphan namespace pruning. The `cache:` setting accepts `maxSize` and `maxAge` limits to bound upstream proxy storage and evict stale files. Startup sweeps prune orphaned upstream namespaces left behind by ephemeral per-process secrets. The new `pnpr cache-gc` command reclaims cache storage on demand with support for dry runs, custom size caps, age limits, and orphan-only cleanup [pnpm/tasks#131](https://github.com/pnpm/tasks/issues/131)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/tasks/registry-mock/src/mock_instance.rs","lines":["@@ -76,7 +76,10 @@ impl MockInstanceOptions<'_> {","         }","     }"," ","-    pub(crate) async fn spawn(self) -> MockInstance {","+    pub(crate) async fn spawn_recording_pid(","+        self,","+        pid_tx: Option<tokio::sync::oneshot::Sender<u32>>,","+    ) -> MockInstance {","         let MockInstanceOptions {","             port, public_url, stdout, stderr, ..","         } = self;","@@ -93,6 +96,9 @@ impl MockInstanceOptions<'_> {","             .stderr(stderr)","             .spawn()","             .expect(\"spawn pnpr\");","+        if let Some(tx) = pid_tx {","+            let _ = tx.send(process.id());","+        }","         // Owning the child before the readiness wait is what lets a panicking","         // or cancelled startup still run the kill-and-wait destructor.","         let instance = MockInstance { process };","@@ -102,6 +108,10 @@ impl MockInstanceOptions<'_> {","         instance","     }"," ","+    pub(crate) async fn spawn(self) -> MockInstance {","+        self.spawn_recording_pid(None).await","+    }","+","     pub async fn spawn_if_necessary(self) -> Option<MockInstance> {","         let MockInstanceOptions { port, .. } = self;","         if self.is_registry_ready().await {"],"additions":11,"deletions":1,"truncated":false},{"path":"pnpm/tasks/registry-mock/src/mock_instance/tests.rs","lines":["@@ -1,10 +1,10 @@"," use super::{MockInstance, MockInstanceOptions};"," use crate::{pick_port::pick_unused_port, process_kill::kill_process_by_pid};"," use reqwest::{Client, Proxy};","-use std::{ffi::OsStr, process};","-use sysinfo::{Pid, ProcessRefreshKind, RefreshKind, Signal, System, UpdateKind};","+use sysinfo::{Pid, ProcessRefreshKind, RefreshKind, Signal, System};"," use tokio::{","     net::{TcpListener, TcpStream},","+    sync::oneshot,","     task::JoinHandle,","     time::{Duration, Instant, sleep, timeout},"," };","@@ -22,10 +22,7 @@ fn options(client: &Client, port: u16) -> MockInstanceOptions<'_> {"," }"," "," fn processes() -> System {","-    System::new_with_specifics(","-        RefreshKind::nothing()","-            .with_processes(ProcessRefreshKind::nothing().with_cmd(UpdateKind::Always)),","-    )","+    System::new_with_specifics(RefreshKind::nothing().with_processes(ProcessRefreshKind::nothing()))"," }"," "," /// How long [`ChildCleanup::assert_reaped`] waits for the process table to","@@ -74,24 +71,14 @@ async fn pending_startup() -> (JoinHandle<MockInstance>, TcpStream, ChildCleanup","         .build()","         .unwrap();","     let port = pick_unused_port().unwrap();","-    let startup = tokio::spawn(async move { options(&client, port).spawn().await });","+    let (pid_tx, pid_rx) = oneshot::channel();","+    let startup =","+        tokio::spawn(async move { options(&client, port).spawn_recording_pid(Some(pid_tx)).await });","     let (connection, _) = timeout(Duration::from_secs(10), proxy.accept()).await","         .expect(\"startup must reach its readiness request\")","         .unwrap();","-    let system = processes();","-    let address = format!(\"127.0.0.1:{port}\");","-    let child = system","-        .processes()","-        .values()","-        .find(|child| {","-            child.parent() == Some(Pid::from_u32(process::id()))","-                && child","-                    .cmd()","-                    .iter()","-                    .any(|arg| arg == OsStr::new(&address))","-        })","-        .expect(\"startup must have a live registry child\");","-    (startup, connection, ChildCleanup(Some(child.pid())))","+    let child_pid = pid_rx.await.expect(\"startup must have a live registry child\");","+    (startup, connection, ChildCleanup(Some(Pid::from_u32(child_pid))))"," }"," "," #[tokio::test]"],"additions":8,"deletions":21,"truncated":false},{"path":"pnpr/crates/config/config.yaml","lines":["@@ -7,6 +7,10 @@ storage: ./storage"," # to a `.pnpr-cache` subdirectory of `storage`; point it at a separate,"," # ephemeral volume to keep cached upstream content off the durable disk."," #cache: ./cache","+#cache:","+#  path: ./cache","+#  maxSize: 20GB","+#  maxAge: 30d"," # Cross-origin browser access is disabled unless exact origins are listed."," # This is enough to let a separately hosted registry UI read metadata, search,"," # organization listings, and tarballs without opening pnpr to every website."],"additions":4,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/byte_size.rs","lines":["@@ -0,0 +1,87 @@","+use serde::Deserialize;","+","+/// A byte size representation parsed from YAML or string input.","+///","+/// Accepts integer bytes directly or string values with standard unit","+/// suffixes (`B`, `KB`, `KiB`, `MB`, `MiB`, `GB`, `GiB`, `TB`, `TiB`,","+/// `PB`, `PiB`), case-insensitively.","+#[derive(Debug, Clone, PartialEq, Eq)]","+pub struct ByteSize(pub String);","+","+impl<'de> Deserialize<'de> for ByteSize {","+    fn deserialize<Deserializer>(deserializer: Deserializer) -> Result<Self, Deserializer::Error>","+    where","+        Deserializer: serde::Deserializer<'de>,","+    {","+        struct ByteSizeVisitor;","+        impl serde::de::Visitor<'_> for ByteSizeVisitor {","+            type Value = ByteSize;","+","+            fn expecting(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {","+                formatter.write_str(\"a byte size string or number of bytes\")","+            }","+","+            fn visit_str<DeError>(self, value: &str) -> Result<ByteSize, DeError> {","+                Ok(ByteSize(value.to_string()))","+            }","+","+            fn visit_i64<DeError>(self, value: i64) -> Result<ByteSize, DeError> {","+                Ok(ByteSize(value.to_string()))","+            }","+","+            fn visit_u64<DeError>(self, value: u64) -> Result<ByteSize, DeError> {","+                Ok(ByteSize(value.to_string()))","+            }","+","+            fn visit_f64<DeError>(self, value: f64) -> Result<ByteSize, DeError> {","+                Ok(ByteSize(value.to_string()))","+            }","+        }","+        deserializer.deserialize_any(ByteSizeVisitor)","+    }","+}","+","+/// Parse a byte size string with optional SI or binary suffix into bytes.","+///","+/// Multipliers use binary multiples (powers of 1024) customary for cache","+/// and memory budgets (`KB`/`KiB` = 1024, `MB`/`MiB` = 1024^2, `GB`/`GiB` = 1024^3).","+/// Returns `None` for negative, empty, non-finite, or out-of-range values.","+#[must_use]","+pub fn parse_byte_size(raw: &str) -> Option<u64> {","+    let raw = raw.trim();","+    if raw.is_empty() {","+        return None;","+    }","+    if let Ok(bytes) = raw.parse::<u64>() {","+        return Some(bytes);","+    }","+    let num_end = raw","+        .bytes()","+        .position(|byte| !(byte.is_ascii_digit() || byte == b'.'))","+        .unwrap_or(raw.len());","+    if num_end == 0 {","+        return None;","+    }","+    let num: f64 = raw[..num_end].parse().ok()?;","+    if num < 0.0 || !num.is_finite() {","+        return None;","+    }","+    let unit = raw[num_end..].trim().to_ascii_lowercase();","+    let multiplier: f64 = match unit.as_str() {","+        \"\" | \"b\" | \"bytes\" => 1.0,","+        \"k\" | \"kb\" | \"kib\" => 1024.0,","+        \"m\" | \"mb\" | \"mib\" => 1024.0 * 1024.0,","+        \"g\" | \"gb\" | \"gib\" => 1024.0 * 1024.0 * 1024.0,","+        \"t\" | \"tb\" | \"tib\" => 1024.0 * 1024.0 * 1024.0 * 1024.0,","+        \"p\" | \"pb\" | \"pib\" => 1024.0 * 1024.0 * 1024.0 * 1024.0 * 1024.0,","+        _ => return None,","+    };","+    let total = num * multiplier;","+    if total < 0.0 || total > (u64::MAX as f64) {","+        return None;","+    }","+    Some(total as u64)","+}","+","+#[cfg(test)]","+mod tests;"],"additions":87,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/byte_size/tests.rs","lines":["@@ -0,0 +1,42 @@","+use super::{ByteSize, parse_byte_size};","+","+#[test]","+fn parse_byte_size_handles_integers_and_units() {","+    assert_eq!(parse_byte_size(\"0\"), Some(0));","+    assert_eq!(parse_byte_size(\"1024\"), Some(1024));","+    assert_eq!(parse_byte_size(\"1024B\"), Some(1024));","+    assert_eq!(parse_byte_size(\"1024 bytes\"), Some(1024));","+    assert_eq!(parse_byte_size(\"10K\"), Some(10 * 1024));","+    assert_eq!(parse_byte_size(\"10KB\"), Some(10 * 1024));","+    assert_eq!(parse_byte_size(\"10KiB\"), Some(10 * 1024));","+    assert_eq!(parse_byte_size(\"500M\"), Some(500 * 1024 * 1024));","+    assert_eq!(parse_byte_size(\"500MB\"), Some(500 * 1024 * 1024));","+    assert_eq!(parse_byte_size(\"500MiB\"), Some(500 * 1024 * 1024));","+    assert_eq!(parse_byte_size(\"10G\"), Some(10 * 1024 * 1024 * 1024));","+    assert_eq!(parse_byte_size(\"10GB\"), Some(10 * 1024 * 1024 * 1024));","+    assert_eq!(parse_byte_size(\"10GiB\"), Some(10 * 1024 * 1024 * 1024));","+    assert_eq!(parse_byte_size(\"2TB\"), Some(2 * 1024 * 1024 * 1024 * 1024));","+}","+","+#[test]","+fn parse_byte_size_rejects_invalid_values() {","+    assert_eq!(parse_byte_size(\"\"), None);","+    assert_eq!(parse_byte_size(\"   \"), None);","+    assert_eq!(parse_byte_size(\"-10MB\"), None);","+    assert_eq!(parse_byte_size(\"invalid\"), None);","+    assert_eq!(parse_byte_size(\"100xyz\"), None);","+}","+","+#[test]","+fn byte_size_deserializes_from_yaml_types() {","+    #[derive(serde::Deserialize)]","+    struct Wrapper {","+        size: ByteSize,","+    }","+","+    let from_int: Wrapper = serde_saphyr::from_str(\"size: 1048576\").unwrap();","+    assert_eq!(from_int.size, ByteSize(\"1048576\".to_string()));","+","+    let from_str: Wrapper = serde_saphyr::from_str(\"size: 10GB\").unwrap();","+    assert_eq!(from_str.size, ByteSize(\"10GB\".to_string()));","+}"],"additions":42,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/config_file.rs","lines":["@@ -1,7 +1,7 @@"," use super::{","-    AccessSpec, Deserialize, Ecosystem, IndexMap, Interval, LibsqlSettings, LogConfig, LogFormat,","-    LogLevel, Management, OciConfig, PackageAccess, RegistryError, S3Settings, ScimConfig,","-    SystemEnv, UpstreamAuthFile, default_storage_string, env_replace_lossy, oidc,","+    AccessSpec, ByteSize, Deserialize, Ecosystem, IndexMap, Interval, LibsqlSettings, LogConfig,","+    LogFormat, LogLevel, Management, OciConfig, PackageAccess, RegistryError, S3Settings,","+    ScimConfig, SystemEnv, UpstreamAuthFile, default_storage_string, env_replace_lossy, oidc,"," };"," "," /// Disk shape of the `routes:` block.","@@ -166,6 +166,24 @@ pub(super) enum DefaultRegistryFile {"," /// `#[serde(default)]` on the fields we care about plus"," /// `#[serde(deny_unknown_fields)]` *not* being set — so the same"," /// `config.yaml` works for both servers.","+#[derive(Debug, Deserialize)]","+#[serde(untagged)]","+pub(super) enum CacheFile {","+    Path(String),","+    Settings(CacheSettingsFile),","+}","+","+#[derive(Debug, Default, Deserialize)]","+#[serde(deny_unknown_fields)]","+pub(super) struct CacheSettingsFile {","+    #[serde(default)]","+    pub(super) path: Option<String>,","+    #[serde(default, rename = \"maxSize\", alias = \"max_size\")]","+    pub(super) max_size: Option<ByteSize>,","+    #[serde(default, rename = \"maxAge\", alias = \"max_age\")]","+    pub(super) max_age: Option<Interval>,","+}","+"," #[derive(Debug, Deserialize)]"," #[cfg_attr(","     dylint_lib = \"perfectionist\",","@@ -177,10 +195,10 @@ pub(super) enum DefaultRegistryFile {"," pub(super) struct ConfigFile {","     #[serde(default = \"default_storage_string\")]","     pub(super) storage: String,","-    /// Disposable proxy-cache root. Not a verdaccio key — when omitted","+    /// Disposable proxy-cache root or settings table. Not a verdaccio key — when omitted","     /// it defaults to a `.pnpr-cache` subdirectory of `storage`.","     #[serde(default)]","-    pub(super) cache: Option<String>,","+    pub(super) cache: Option<CacheFile>,","     /// Reverse-proxy addresses trusted to supply client IP headers.","     #[serde(default, rename = \"trustedProxies\", alias = \"trusted_proxies\")]","     pub(super) trusted_proxies: Vec<String>,"],"additions":23,"deletions":5,"truncated":false},{"path":"pnpr/crates/config/src/lib.rs","lines":["@@ -3,46 +3,37 @@"," "," pub mod oidc;"," ","-pub use logging::{LogConfig, LogFormat, LogLevel};","-","+pub use access::{","+    AccessSpec, PackageAccess, compile_access_list, validate_member_name, validate_team_name,","+};","+pub use artifacts::{ArtifactQuota, ArtifactsFeature, StorageAccess};"," pub use backend_config::{","     AuthConfig, BackendConfig, HtpasswdConfig, IdentityConfig, LibsqlSettings, MaxUsers,","     SqlBackendSettings, TokensConfig,"," };","-","-pub use access::{","-    AccessSpec, PackageAccess, compile_access_list, validate_member_name, validate_team_name,","-};","+pub use byte_size::{ByteSize, parse_byte_size};"," pub use hosted::{HostedConfig, Management};","+pub use ip_network::{IpNetwork, parse_trusted_proxies};","+pub use logging::{LogConfig, LogFormat, LogLevel};"," pub use pnpr_policy::{TeamDirectory, Teams};","-","-pub use artifacts::{ArtifactQuota, Ar