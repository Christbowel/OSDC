tom-columns=STATUS:status.conditions\\[\\?\\(\\@.type==\\\"Ready\\\"\\)\\].status > \"$TMPALLREADY\"; then","+        if ! \"$KUBECTL\" get nodes --no-headers -o=custom-columns=STATUS:status.conditions\\[\\?\\(\\@.type==\\\"Ready\\\"\\)\\].status > \"$TMPALLREADY\"; then","                 sleep 5","                 continue","         fi"],"additions":6,"deletions":6,"truncated":false},{"path":"pkg/capr/planner/etcdrestore_scripts_test.go","lines":["@@ -0,0 +1,107 @@","+package planner","+","+import (","+\t\"context\"","+\t\"os\"","+\t\"os/exec\"","+\t\"path/filepath\"","+\t\"strings\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+// fakeKubectlScript logs its arguments to $KUBECTL_LOG and answers the calls that the etcd restore scripts make.","+const fakeKubectlScript = `#!/bin/sh","+echo \"$@\" >> \"$KUBECTL_LOG\"","+case \"$*\" in","+\t*custom-columns*) echo True ;;","+\t\"get nodes\"*) printf 'node-a\\nnode-b\\n' ;;","+\t*\"get pods\"*) ;;","+\t\"delete node\"*) ;;","+\t*) exit 1 ;;","+esac","+`","+","+// writeFakeKubectl writes a fake kubectl into a directory name that contains a space and returns its path and the log path.","+func writeFakeKubectl(t *testing.T) (string, string) {","+\tt.Helper()","+\tif _, err := os.Stat(\"/bin/sh\"); err != nil {","+\t\tt.Skipf(\"/bin/sh is not available: %v\", err)","+\t}","+\tbase := t.TempDir()","+\tbinDir := filepath.Join(base, \"my dir\", \"bin\")","+\trequire.NoError(t, os.MkdirAll(binDir, 0o700))","+\tkubectl := filepath.Join(binDir, \"kubectl\")","+\trequire.NoError(t, os.WriteFile(kubectl, []byte(fakeKubectlScript), 0o700))","+\treturn kubectl, filepath.Join(base, \"kubectl.log\")","+}","+","+func runScript(t *testing.T, script string, env []string, args ...string) string {","+\tt.Helper()","+\tscriptPath := filepath.Join(t.TempDir(), \"script.sh\")","+\trequire.NoError(t, os.WriteFile(scriptPath, []byte(script), 0o700))","+","+\t// A script that does not run kubectl retries with sleeps, so bound the run.","+\tctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)","+\tdefer cancel()","+\tcmd := exec.CommandContext(ctx, \"/bin/sh\", append([]string{scriptPath}, args...)...)","+\tcmd.Env = append(os.Environ(), env...)","+\tout, err := cmd.CombinedOutput()","+\trequire.NoError(t, err, \"output: %s\", out)","+\treturn string(out)","+}","+","+func readLog(t *testing.T, path string) string {","+\tt.Helper()","+\tb, err := os.ReadFile(path)","+\trequire.NoError(t, err)","+\treturn string(b)","+}","+","+// TestEtcdRestoreScriptsKubectlPathWithSpace checks that the scripts run kubectl when the path contains a space.","+func TestEtcdRestoreScriptsKubectlPathWithSpace(t *testing.T) {","+\tt.Parallel()","+","+\tt.Run(\"wait for pod list\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tkubectl, logPath := writeFakeKubectl(t)","+\t\trunScript(t, etcdRestorePostRestoreWaitForPodListCleanupScript, []string{\"KUBECTL_LOG=\" + logPath},","+\t\t\tkubectl, \"--kubeconfig\", \"/etc/rancher/rke2/rke2.yaml\", \"get\", \"pods\", \"--all-namespaces\")","+\t\tassert.Contains(t, readLog(t, logPath), \"get pods --all-namespaces\")","+\t})","+","+\tt.Run(\"wait for ready\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\t// The script compares the output of wc -l as a string. BSD wc pads that output, so the script never ends there.","+\t\tif out, err := exec.Command(\"/bin/sh\", \"-c\", \"wc -l < /dev/null\").Output(); err != nil || strings.TrimSpace(string(out)) != strings.TrimRight(string(out), \"\\n\") {","+\t\t\tt.Skip(\"wc -l pads its output on this platform\")","+\t\t}","+\t\tkubectl, logPath := writeFakeKubectl(t)","+\t\trunScript(t, etcdRestoreNodeWaitForReadyScript,","+\t\t\t[]string{\"KUBECTL_LOG=\" + logPath, \"KUBECTL=\" + kubectl, \"KUBECONFIG=/etc/rancher/rke2/rke2.yaml\"},","+\t\t\t\"machine-1\")","+\t\tlog := readLog(t, logPath)","+\t\tassert.Contains(t, log, \"rke.cattle.io/machine=machine-1\")","+\t\tassert.Contains(t, log, \"get nodes\")","+\t})","+","+\tt.Run(\"clean up nodes\", func(t *testing.T) {","+\t\tt.Parallel()","+\t\tkubectl, logPath := writeFakeKubectl(t)","+\t\tdir := t.TempDir()","+\t\tmachineIDs := filepath.Join(dir, \"machine-ids\")","+\t\tnodeNames := filepath.Join(dir, \"node-names\")","+\t\trequire.NoError(t, os.WriteFile(machineIDs, nil, 0o600))","+\t\trequire.NoError(t, os.WriteFile(nodeNames, []byte(\"node-a\\n\"), 0o600))","+","+\t\trunScript(t, etcdRestoreNodeCleanUpScript,","+\t\t\t[]string{\"KUBECTL_LOG=\" + logPath, \"KUBECTL=\" + kubectl, \"KUBECONFIG=/etc/rancher/rke2/rke2.yaml\"},","+\t\t\tmachineIDs, nodeNames)","+\t\tlog := readLog(t, logPath)","+\t\tassert.Contains(t, log, \"delete node node-b --wait=false\")","+\t\tassert.False(t, strings.Contains(log, \"delete node node-a\"), \"node-a must stay\")","+\t})","+}"],"additions":107,"deletions":0,"truncated":false},{"path":"pkg/capr/planner/idempotent.go","lines":["@@ -59,7 +59,7 @@ func generateIdempotencyCleanupInstruction(controlPlane *rkev1.RKEControlPlane,"," \t\t\tCommand: \"/bin/sh\","," \t\t\tArgs: []string{"," \t\t\t\t\"-c\",","-\t\t\t\tfmt.Sprintf(\"rm -rf %s/idempotence/%s\", capr.GetProvisioningDataDir(&controlPlane.Spec.ClusterConfiguration), key),","+\t\t\t\tfmt.Sprintf(\"rm -rf %s\", capr.ShellQuote(capr.GetProvisioningDataDir(&controlPlane.Spec.ClusterConfiguration)+\"/idempotence/\"+key)),"," \t\t\t},"," \t\t},"," \t}"],"additions":1,"deletions":1,"truncated":false},{"path":"pkg/capr/planner/instructions.go","lines":["@@ -141,7 +141,7 @@ func (p *Planner) addInitNodePeriodicInstruction(nodePlan plan.NodePlan, control"," \t\t\t\t\t\"-c\","," \t\t\t\t\t// the grep here is to make the command fail if we don't get the output we expect, like empty string."," \t\t\t\t\tfmt.Sprintf(\"curl -f --retry 100 --retry-delay 5 --cacert %s https://localhost:%d/db/info | grep 'clientURLs'\",","-\t\t\t\t\t\tpath.Join(capr.GetDistroDataDir(controlPlane), \"server/tls/server-ca.crt\"),","+\t\t\t\t\t\tcapr.ShellQuote(path.Join(capr.GetDistroDataDir(controlPlane), \"server/tls/server-ca.crt\")),"," \t\t\t\t\t\tcapr.GetRuntimeSupervisorPort(controlPlane.Spec.KubernetesVersion)),"," \t\t\t\t},"," \t\t\t},","@@ -153,7 +153,7 @@ func (p *Planner) addInitNodePeriodicInstruction(nodePlan plan.NodePlan, control"," \t\t\t\tCommand: \"sh\","," \t\t\t\tArgs: []string{"," \t\t\t\t\t\"-c\",","-\t\t\t\t\tfmt.Sprintf(\"cat %s\", path.Join(capr.GetDistroDataDir(controlPlane), \"server/db/etcd/name\")),","+\t\t\t\t\tfmt.Sprintf(\"cat %s\", capr.ShellQuote(path.Join(capr.GetDistroDataDir(controlPlane), \"server/db/etcd/name\"))),"," \t\t\t\t},"," \t\t\t},"," \t\t\tPeriodSeconds: 600,","@@ -174,7 +174,7 @@ func generateManifestRemovalInstruction(controlPlane *rkev1.RKEControlPlane, ent"," \t\t\tCommand: \"/bin/sh\","," \t\t\tArgs: []string{"," \t\t\t\t\"-c\",","-\t\t\t\tfmt.Sprintf(\"rm -rf %s/%s-*.yaml\", path.Join(capr.GetDistroDataDir(controlPlane), \"server/manifests\"), runtime),","+\t\t\t\tfmt.Sprintf(\"rm -rf %s/%s-*.yaml\", capr.ShellQuote(path.Join(capr.GetDistroDataDir(controlPlane), \"server/manifests\")), runtime),"," \t\t\t},"," \t\t},"," \t}"],"additions":3,"deletions":3,"truncated":false},{"path":"pkg/capr/planner/shell_quoting_test.go","lines":["@@ -0,0 +1,217 @@","+package planner","+","+import (","+\t\"os\"","+\t\"os/exec\"","+\t\"path/filepath\"","+\t\"strings\"","+\t\"testing\"","+","+\trkev1 \"github.com/rancher/rancher/pkg/apis/rke.cattle.io/v1\"","+\t\"github.com/rancher/rancher/pkg/apis/rke.cattle.io/v1/plan\"","+\t\"github.com/rancher/rancher/pkg/capr\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+// hostileDirNames returns directory names that a shell must treat as one literal word. Names that","+// contain a payload write to canary if the shell runs a second command.","+func hostileDirNames(canary string) map[string]string {","+\treturn map[string]string{","+\t\t\"space\":        \"with space\",","+\t\t\"newline\":      \"new\\nline\",","+\t\t\"single quote\": \"it's\",","+\t\t\"backslash\":    `back\\slash`,","+\t\t\"substitution\": \"$(touch \" + canary + \")\",","+\t\t\"backtick\":     \"`touch \" + canary + \"`\",","+\t\t\"semicolon\":    \"x;touch \" + canary,","+\t\t\"quote escape\": \"x'; touch \" + canary + \"; echo '\",","+\t}","+}","+","+func requireSh(t *testing.T) {","+\tt.Helper()","+\tif _, err := os.Stat(\"/bin/sh\"); err != nil {","+\t\tt.Skipf(\"/bin/sh is not available: %v\", err)","+\t}","+}","+","+func runInstruction(t *testing.T, instruction plan.OneTimeInstruction) string {","+\tt.Helper()","+\tcmd := exec.Command(instruction.Command, instruction.Args...)","+\tout, err := cmd.CombinedOutput()","+\trequire.NoError(t, err, \"output: %s\", out)","+\treturn string(out)","+}","+","+func requireNoCanary(t *testing.T, canary string) {","+\tt.Helper()","+\t_, err := os.Stat(canary)","+\trequire.True(t, os.IsNotExist(err), \"the command ran a second command\")","+}","+","+func newControlPlane(distroDir, provisioningDir string) *rkev1.RKEControlPlane {","+\tcp := &rkev1.RKEControlPlane{}","+\tcp.Spec.KubernetesVersion = \"v1.28.0+rke2r1\"","+\tcp.Spec.DataDirectories.K8sDistro = distroDir","+\tcp.Spec.DataDirectories.Provisioning = provisioningDir","+\treturn cp","+}","+","+// TestShellInstructionsKeepBytesForValidPaths pins the exact command strings for valid paths. A change","+// to these strings changes the plan of every existing cluster and restarts plan application.","+func TestShellInstructionsKeepBytesForValidPaths(t *testing.T) {","+\tt.Parallel()","+","+\ttests := []struct {","+\t\tname            string","+\t\tdistroDir       string","+\t\tprovisioningDir string","+\t\twantCleanup     string","+\t\twantCapture     string","+\t\twantEtcdName    string","+\t\twantManifests   string","+\t}{","+\t\t{","+\t\t\tname:          \"default directories\",","+\t\t\twantCleanup:   \"rm -rf /var/lib/rancher/capr/idempotence/etcd-restore\",","+\t\t\twantCapture:   \"curl -f --retry 100 --retry-delay 5 --cacert /var/lib/rancher/rke2/server/tls/server-ca.crt https://localhost:9345/db/info | grep 'clientURLs'\",","+\t\t\twantEtcdName:  \"cat /var/lib/rancher/rke2/server/db/etcd/name\",","+\t\t\twantManifests: \"rm -rf /var/lib/rancher/rke2/server/manifests/rke2-*.yaml\",","+\t\t},","+\t\t{","+\t\t\tname:            \"custom directories\",","+\t\t\tdistroDir:       \"/data/rke2\",","+\t\t\tprovisioningDir: \"/data/capr\",","+\t\t\twantCleanup:     \"rm -rf /data/capr/idempotence/etcd-restore\",","+\t\t\twantCapture:     \"curl -f --retry 100 --retry-delay 5 --cacert /data/rke2/server/tls/server-ca.crt https://localhost:9345/db/info | grep 'clientURLs'\",","+\t\t\twantEtcdName:    \"cat /data/rke2/server/db/etcd/name\",","+\t\t\twantManifests:   \"rm -rf /data/rke2/server/manifests/rke2-*.yaml\",","+\t\t},","+\t}","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tt.Parallel()","+\t\t\tcp := newControlPlane(tt.distroDir, tt.provisioningDir)","+","+\t\t\tcleanup := generateIdempotencyCleanupInstruction(cp, \"etcd-restore\")","+\t\t\tassert.Equal(t, \"remove idempotency tracking\", cleanup.Name)","+\t\t\tassert.Equal(t, []string{\"-c\", tt.wantCleanup}, cleanup.Args)","+","+\t\t\tnodePlan, err := (&Planner{}).addInitNodePeriodicInstruction(plan.NodePlan{}, cp)","+\t\t\trequire.NoError(t, err)","+\t\t\trequire.Len(t, nodePlan.PeriodicInstructions, 2)","+\t\t\tassert.Equal(t, captureAddressInstructionName, nodePlan.PeriodicInstructions[0].Name)","+\t\t\tassert.Equal(t, []string{\"-c\", tt.wantCapture}, nodePlan.PeriodicInstructions[0].Args)","+\t\t\tassert.Equal(t, etcdNameInstructionName, nodePlan.PeriodicInstructions[1].Name)","+\t\t\tassert.Equal(t, []string{\"-c\", tt.wantEtcdName}, nodePlan.PeriodicInstructions[1].Args)","+","+\t\t\tgenerated, removal := generateManifestRemovalInstruction(cp, &planEntry{Metadata: &plan.Metadata{","+\t\t\t\tLabels: map[string]string{capr.EtcdRoleLabel: \"true\"},","+\t\t\t}})","+\t\t\trequire.True(t, generated)","+\t\t\tassert.Equal(t, \"remove server manifests\", removal.Name)","+\t\t\tassert.Equal(t, []string{\"-c\", tt.wantManifests}, removal.Args)","+\t\t})","+\t}","+}","+","+func TestGenerateIdempotencyCleanupInstructionHostilePath(t *testing.T) {","+\tt.Parallel()","+\trequireSh(t)","+","+\tbase := t.TempDir()","+\tcanary := filepath.Join(base, \"canary\")","+\tfor name, dirName := range hostileDirNames(canary) {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tprovisioningDir := filepath.Join(base, \"cleanup-\"+strings.ReplaceAll(name, \" \", \"-\"), dirName)","+\t\t\ttarget := filepath.Join(provisioningDir, \"idempotence\", \"etcd-restore\")","+\t\t\trequire.NoError(t, os.MkdirAll(target, 0o700))","+\t\t\tkeep := filepath.Join(provisioningDir, \"idempotence\", \"other\")","+\t\t\trequire.NoError(t, os.MkdirAll(keep, 0o700))","+","+\t\t\trunInstruction(t, generateIdempotencyCleanupInstruction(newControlPlane(\"\", provisioningDir), \"etcd-restore\"))","+","+\t\t\tassert.NoDirExists(t, target)","+\t\t\tassert.DirExists(t, keep)","+\t\t\trequireNoCanary(t, canary)","+\t\t})","+\t}","+}","+","+func TestGenerateManifestRemovalInstructionHostilePath(t *testing.T) {","+\tt.Parallel()","+\trequireSh(t)","+","+\tbase := t.TempDir()","+\tcanary := filepath.Join(base, \"canary\")","+\tentry := &planEntry{Metadata: &plan.Metadata{Labels: map[string]string{capr.ControlPlaneRoleLabel: \"true\"}}}","+\tfor name, dirName := range hostileDirNames(canary) {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tdistroDir := filepath.Join(base, \"manifests-\"+strings.ReplaceAll(name, \" \", \"-\"), dirName)","+\t\t\tmanifestDir := filepath.Join(distroDir, \"server/manifests\")"],"additions":152,"deletions":0,"truncated":false}],"additions":515,"deletions":47,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-20T17:59:15.643390+00:00"}