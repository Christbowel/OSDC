{"id":"17e062e902399475aba8db6d14f7a19c18f2a4c9","axis":"silent","repo":"pnpm/pnpm","sha":"17e062e902399475aba8db6d14f7a19c18f2a4c9","parsed":{"files":[{"path":".changeset/global-peers-check.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": minor","+---","+","+`pnpm peers check` now accepts `--global` (`-g`) to check globally installed packages. After a global install or update, the peer dependency warning now suggests `pnpm peers check -g` [#17504](https://github.com/pnpm/pnpm/issues/17504)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/cli_command/commands.rs","lines":["@@ -311,7 +311,7 @@ impl CliCommand {"," ","     /// Whether `--global` was passed. pnpm parses it as one CLI-wide","     /// option; pacquet declares it per subcommand.","-    pub(super) fn is_global(&self) -> bool {","+    pub(crate) fn is_global(&self) -> bool {","         match self {","             CliCommand::Add(args) => args.target.global,","             CliCommand::ApproveBuilds(args) => args.global,","@@ -322,6 +322,7 @@ impl CliCommand {","             CliCommand::Set(args) => args.flags.is_global(),","             CliCommand::List(args) | CliCommand::Ll(args) => args.global,","             CliCommand::Outdated(args) => args.global,","+            CliCommand::Peers(args) => args.global,","             CliCommand::Prefix(args) => args.global,","             CliCommand::Remove(args) => args.global,","             CliCommand::Root(args) => args.global,"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch.rs","lines":["@@ -59,6 +59,7 @@ impl CliArgs {","     /// path fails with a proper diagnostic in [`Self::run`], and the","     /// reporter only uses it to shorten the paths it prints.","     pub fn configure_reporter(&self) {","+        pnpm_default_reporter::set_is_global(super::pre_command::is_global(&self.command));","         if let Some(color) = self.output.presentation.color.or_else(|| {","             self.output.presentation.no_color.then_some(ColorMode::Never)","         }) {"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch_query.rs","lines":["@@ -166,11 +166,13 @@ pub(super) fn sbom<'a>(ctx: &RunCtx<'a>, args: SbomArgs) -> miette::Result<Comma"," }"," "," pub(super) fn peers<'a>(ctx: &RunCtx<'a>, args: PeersArgs) -> miette::Result<CommandFuture<'a>> {","-    let cfg = (ctx.loaders.config)()?;","+    let cfg = if args.global { (ctx.loaders.global_config)()? } else { (ctx.loaders.config)()? };","     let recursive = ctx.workspace.recursive;","     let dir = ctx.locations.dir;","     Ok(Box::pin(async move {","-        apply_update_config(cfg, dir).await?;","+        if !args.global {","+            apply_update_config(cfg, dir).await?;","+        }","         if args.run(cfg, dir, recursive)? != PeersOutcome::NoIssues {","             // `peers` exits non-zero when peer issues are found or the subcommand is unknown, mirroring pnpm.","             pnpm_executor::exit(1);"],"additions":4,"deletions":2,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/peers.rs","lines":["@@ -1,5 +1,6 @@"," use crate::cli_args::{","     catalogs::configured_catalogs,","+    global::GlobalError,","     recursive::{AutoExcludeRoot, discover_workspace_projects, select_recursive_projects},"," };"," use clap::{Args, CommandFactory};","@@ -8,10 +9,16 @@ use pnpm_config::Config;"," use pnpm_deps_inspection_peers::{","     IssuesByProjects, check_peer_dependencies_from_lockfile, filter_peer_issues, render_peer_issues,"," };","+use pnpm_global::scan_global_packages;"," use pnpm_lockfile::Lockfile;","+use std::{collections::BTreeSet, path::Path};"," "," #[derive(Debug, Args)]"," pub struct PeersArgs {","+    /// Check each globally installed package group separately.","+    #[clap(short = 'g', long)]","+    pub global: bool,","+","     #[clap(long)]","     pub json: bool,"," ","@@ -47,37 +54,63 @@ impl PeersArgs {","             return Ok(PeersOutcome::UnknownSubcommand);","         }"," ","-        let lockfile_dir = config.lockfile_dir_for(dir);","-        let project_dirs = checked_project_dirs(config, dir, recursive)?;","-        let lockfile = self","-            .load_lockfile(config, lockfile_dir)","-            .into_diagnostic()","-            .wrap_err(\"load lockfile\")?;","-        let catalogs = configured_catalogs(config)?;","-        let catalogs =","-            (config.workspace_dir.is_some() || config.catalogs.is_some()).then_some(&catalogs);","-","-        // A missing lockfile yields empty issues, mirroring pnpm's","-        // `checkPeerDependencies`, so both output modes stay on the common","-        // path (`{}` for `--json`, \"No peer dependency issues found\" otherwise).","-        let issues = match &lockfile {","-            Some(lockfile) => check_peer_dependencies_from_lockfile(","-                lockfile,","-                lockfile_dir,","-                &project_dirs,","-                catalogs,","-                config.resolve_peers_from_workspace_root,","-            )?,","-            None => IssuesByProjects::new(),","+        let issues = if self.global {","+            self.global_issues(config)?","+        } else {","+            let lockfile_dir = config.lockfile_dir_for(dir);","+            let project_dirs = checked_project_dirs(config, dir, recursive)?;","+            let lockfile = self.load_lockfile(&config.install_state_dir, lockfile_dir)?;","+            checked_issues(config, lockfile_dir, &project_dirs, lockfile.as_ref())?","         };","-        let issues = filter_peer_issues(issues, &config.peer_dependency_rules);","+        self.print_issues(&issues)","+    }","+","+    fn global_issues(&self, config: &Config) -> miette::Result<IssuesByProjects> {","+        let global_dir =","+            config.global_pkg_dir.as_deref().ok_or(GlobalError::MissingGlobalPackageDir)?;","+        let groups = scan_global_packages(global_dir)","+            .into_diagnostic()","+            .wrap_err_with(|| format!(\"read global packages in {}\", global_dir.display()))?;","+        // Each group installs without catalogs and as its own workspace root","+        // (see `global_group_config`), so the home's catalogs must not","+        // resolve its peer ranges either.","+        let mut group_config = config.clone();","+        group_config.catalogs = None;","+        group_config.workspace_dir = None;","+        let mut checked_dirs = BTreeSet::new();","+        let mut issues = IssuesByProjects::new();","+        for group in groups {","+            if !checked_dirs.insert(group.install_dir.clone()) {","+                continue;","+            }","+            let install_state_dir = group.install_dir.join(\"node_modules\").join(\".pnpm\");","+            let lockfile = self.load_lockfile(&install_state_dir, &group.install_dir)?;","+            let mut group_issues = checked_issues(","+                &group_config,","+                &group.install_dir,","+                std::slice::from_ref(&group.install_dir),","+                lockfile.as_ref(),","+            )?;","+            if let Some(root_issues) = group_issues.remove(\".\") {","+                let mut aliases = group.aliases();","+                aliases.sort();","+                let mut key = aliases.join(\", \");","+                if issues.contains_key(&key) {","+                    key = format!(\"{key} ({})\", group.hash);","+                }","+                issues.insert(key, root_issues);","+            }","+        }","+        Ok(issues)","+    }"," ","+    fn print_issues(&self, issues: &IssuesByProjects) -> miette::Result<PeersOutcome> {","         let no_issues = issues","             .values()","             .all(|pi| pi.bad.is_empty() && pi.missing.is_empty());"," ","         if self.json {","-            let output = serde_json::to_string_pretty(&issues)","+            let output = serde_json::to_string_pretty(issues)","                 .into_diagnostic()","                 .wrap_err(\"serialize issues to JSON\")?;","             pnpm_diagnostics::println!(\"{output}\");","@@ -85,7 +118,7 @@ impl PeersArgs {","             pnpm_diagnostics::println!(\"No peer dependency issues found\");","         } else {","             pnpm_diagnostics::println!(\"Issues with peer dependencies found\\n\");","-            pnpm_diagnostics::println!(\"{}\", render_peer_issues(&issues));","+            pnpm_diagnostics::println!(\"{}\", render_peer_issues(issues));","         }"," ","         Ok(if no_issues { PeersOutcome::NoIssues } else { PeersOutcome::IssuesFound })","@@ -95,15 +128,23 @@ impl PeersArgs {","     /// `--lockfile-only` reads the wanted lockfile outright.","     fn load_lockfile(","         &self,","-        config: &Config,","-        lockfile_dir: &std::path::Path,","-    ) -> Result<Option<Lockfile>, pnpm_lockfile::LoadLockfileError> {","-        if self.lockfile_only {","-            return Lockfile::load_wanted_from_dir(lockfile_dir);","-        }","-        match Lockfile::load_current_from_install_state_dir(&config.install_state_dir)? {","+        install_state_dir: &Path,","+        lockfile_dir: &Path,","+    ) -> miette::Result<Option<Lockfile>> {","+        let current = if self.lockfile_only {","+            None","+        } else {","+            Lockfile::load_current_from_install_state_dir(install_state_dir)","+                .into_diagnostic()","+                .wrap_err_with(|| {","+                    format!(\"load current lockfile in {}\", install_state_dir.display())","+                })?","+        };","+        match current {","             Some(lockfile) => Ok(Some(lockfile)),","-            None => Lockfile::load_wanted_from_dir(lockfile_dir),","+            None => Lockfile::load_wanted_from_dir(lockfile_dir)","+                .into_diagnostic()","+                .wrap_err_with(|| format!(\"load lockfile in {}\", lockfile_dir.display())),","         }","     }"," }","@@ -135,3 +176,25 @@ fn checked_project_dirs(","         .cloned()","         .collect())"," }","+","+fn checked_issues(","+    config: &Config,","+    lockfile_dir: &Path,","+    project_dirs: &[std::path::PathBuf],","+    lockfile: Option<&Lockfile>,","+) -> miette::Result<IssuesByProjects> {","+    let catalogs = configured_catalogs(config)?;","+    let catalogs =","+        (config.workspace_dir.is_some() || config.catalogs.is_some()).then_some(&catalogs);","+    let issues = match lockfile {","+        Some(lockfile) => check_peer_dependencies_from_lockfile(","+            lockfile,","+            lockfile_dir,","+            project_dirs,","+            catalogs,","+            config.resolve_peers_from_workspace_root,","+        )?,","+        None => IssuesByProjects::new(),","+    };","+    Ok(filter_peer_issues(issues, &config.peer_dependency_rules))","+}"],"additions":96,"deletions":33,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/pre_command/input.rs","lines":["@@ -372,26 +372,10 @@ fn should_skip_invocation("," /// pnpm treats `--global` as an opt-out of the project's package manager"," /// and runtime pins — a global install does not belong to the project."," pub(crate) fn is_global(command: &CliCommand) -> bool {","-    match command {","-        CliCommand::Add(args) => args.target.global,","-        CliCommand::ApproveBuilds(args) => args.global,","-        CliCommand::Bin(args) => args.global,","-        CliCommand::Config(args) => args.flags.is_global(),","-        CliCommand::Get(args) => args.flags.is_global(),","-        CliCommand::Set(args) => args.flags.is_global(),","-        CliCommand::Env(args) => args.global,","-        CliCommand::List(args) | CliCommand::Ll(args) => args.global,","-        CliCommand::Outdated(args) => args.global,","-        CliCommand::Prefix(args) => args.global,","-        CliCommand::Remove(args) => args.global,","-        CliCommand::Root(args) => args.global,","-        CliCommand::Runtime(args) => args.global,","-        CliCommand::Update(args) => args.selection.global,","-        // `pnpm link` with no arguments links the current project into the","-        // global directory.","-        CliCommand::Link(args) => args.package_paths.is_empty(),","-        _ => false,","-    }","+    // `pnpm link` with no arguments links the current project into the","+    // global directory.","+    command.is_global()","+        || matches!(command, CliCommand::Link(args) if args.package_paths.is_empty())"," }"," "," /// The commands pnpm marks with `skipPackageManagerCheck`, plus `setup` —"],"additions":4,"deletions":20,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/tests.rs","lines":["@@ -392,7 +392,7 @@ fn workspace_fixture() -> (TempDir, std::path::PathBuf) {"," "," /// Every subcommand declaring `--global`. A new one added without wiring"," /// it into [`CliCommand::is_global`] slips past the conflict check.","-const GLOBAL_SUBCOMMAND_ARGV: [&[&str]; 12] = [","+const GLOBAL_SUBCOMMAND_ARGV: [&[&str]; 13] = [","     &[\"add\", \"foo\"],","     &[\"approve-builds\"],","     &[\"bin\"],","@@ -400,6 +400,7 @@ const GLOBAL_SUBCOMMAND_ARGV: [&[&str]; 12] = [","     &[\"list\"],","     &[\"ll\"],","     &[\"outdated\"],","+    &[\"peers\", \"check\"],","     &[\"prefix\"],","     &[\"remove\", \"foo\"],","     &[\"root\"],"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/global.rs","lines":["@@ -1472,3 +1472,6 @@ mod ownership;"," "," #[cfg(unix)]"," mod virtual_store;","+","+#[cfg(unix)]","+mod peers;"],"additions":3,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/global/peers.rs","lines":["@@ -0,0 +1,37 @@","+use super::{global_command, prepare_global_home};","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pnpm_testing_utils::bin::{AddMockedRegistry, CommandTempCwd};","+","+#[test]","+fn global_install_and_update_recommend_global_peer_checks() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let home = root.path().join(\"pnpm-home\");","+    prepare_global_home(&home, &npmrc_info);","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    let hint = r#\"Issues with peer dependencies found. Run \"pnpm peers check -g\" to list them.\"#;","+    let output = global_command(&workspace, &home)","+        .with_args([","+            \"add\",","+            \"-g\",","+            \"@pnpm.e2e/has-foo100-peer@1.0.0,@pnpm.e2e/foo@2.0.0\",","+            \"--ignore-scripts\",","+        ])","+        .assert()","+        .success();","+    assert!(String::from_utf8_lossy(&output.get_output().stdout).contains(hint));","+    let output = global_command(&workspace, &home)","+        .with_args([\"update\", \"--global\", \"--ignore-scripts\"])","+        .assert()","+        .success();","+    assert!(String::from_utf8_lossy(&output.get_output().stdout).contains(hint));","+    let output = global_command(&workspace, &home)","+        .with_args([\"peers\", \"check\", \"-g\"])","+        .assert()","+        .code(1);","+    assert!(","+        String::from_utf8_lossy(&output.get_output().stdout).contains(\"✕ unmet peer @pnpm.e2e/foo\"),","+    );","+    drop((root, mock_instance));","+}"],"additions":37,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/peers.rs","lines":["@@ -975,3 +975,5 @@ mod hooked_manifests;"," "," mod named_registry;"," mod workspace_root;","+","+mod global;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/peers/global.rs","lines":["@@ -0,0 +1,278 @@","+use assert_cmd::prelude::*;","+use command_extra::CommandExtra;","+use pnpm_testing_utils::{bin::CommandTempCwd, command_env::CommandTestExt};","+use serde_json::{Value, json};","+use std::{","+    fs,","+    path::{Path, PathBuf},","+    process::Command,","+};","+","+fn global_command(workspace: &Path, home: &Path) -> Command {","+    Command::cargo_bin(\"pnpm\")","+        .expect(\"find the pnpm binary\")","+        .with_current_dir(workspace)","+        .without_ambient_pnpm_config()","+        .with_env(\"PNPM_HOME\", home)","+        .with_env(\"XDG_CONFIG_HOME\", home.join(\"config\"))","+        .with_env(\"NO_COLOR\", \"1\")","+}","+","+// These lockfiles are inspected without fetching or extracting packages.","+const TARBALL: &str = \"https://example.invalid/fixture.tgz\";","+","+fn lockfile(peer_version: Option<&str>) -> Value {","+    let mut lockfile = json!({","+        \"lockfileVersion\": \"9.0\",","+        \"importers\": {\".\": {\"dependencies\": {","+            \"consumer\": {\"specifier\": \"1.0.0\", \"version\": \"1.0.0\"}","+        }}},","+        \"packages\": {\"consumer@1.0.0\": {\"resolution\": {\"tarball\": TARBALL}, \"peerDependencies\": {\"peer\": \"^2.0.0\"}}},","+        \"snapshots\": {\"consumer@1.0.0\": {}}","+    });","+    if let Some(version) = peer_version {","+        lockfile[\"packages\"][format!(\"peer@{version}\")] =","+            json!({\"resolution\": {\"tarball\": TARBALL}});","+        lockfile[\"snapshots\"][format!(\"peer@{version}\")] = json!({});","+        lockfile[\"snapshots\"][\"consumer@1.0.0\"][\"dependencies\"] = json!({\"peer\": version});","+    }","+    lockfile","+}","+","+fn write_group(home: &Path, name: &str, aliases: &[&str], lockfile: &Value) -> PathBuf {","+    let global_dir = home.join(\"global/v11\");","+    let install_dir = global_dir.join(format!(\"install-{name}\"));","+    fs::create_dir_all(&install_dir).expect(\"create global install directory\");","+    let dependencies: serde_json::Map<String, Value> = aliases","+        .iter()","+        .map(|alias| {","+            ((*alias).to_string(), json!(if *alias == \"peer\" { \"2.0.0\" } else { \"1.0.0\" }))","+        })","+        .collect();","+    fs::write(install_dir.join(\"package.json\"), json!({\"dependencies\": dependencies}).to_string())","+        .expect(\"write group manifest\");","+    let mut group_lockfile = lockfile.clone();","+    let mut root_dependencies = serde_json::Map::new();","+    for alias in aliases {","+        let version = if *alias == \"peer\" { \"2.0.0\" } else { \"1.0.0\" };","+        root_dependencies.insert(","+            (*alias).to_string(),","+            json!({\"specifier\": version, \"version\": version}),","+        );","+        group_lockfile[\"packages\"][format!(\"{alias}@{version}\")] =","+            json!({\"resolution\": {\"tarball\": TARBALL}});","+        group_lockfile[\"snapshots\"][format!(\"{alias}@{version}\")] = if *alias == \"peer\" {","+            json!({})","+        } else {","+            json!({\"dependencies\": {\"consumer\": \"1.0.0\"}})","+        };","+    }","+    group_lockfile[\"importers\"][\".\"][\"dependencies\"] = Value::Object(root_dependencies);","+    fs::write(install_dir.join(\"pnpm-lock.yaml\"), group_lockfile.to_string())","+        .expect(\"write group lockfile\");","+    pnpm_fs::symlink_dir(&install_dir, &global_dir.join(format!(\"hash-{name}\")))","+        .expect(\"activate the install group\");","+    install_dir","+}","+","+#[test]","+fn global_peers_flags_preserve_the_local_report_format() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    let home = root.path().join(\"home\");","+    let install = write_group(&home, \"tool\", &[\"@scope/tool\"], &lockfile(Some(\"1.0.0\")));","+    let local = global_command(&install, &home)","+        .with_args([\"peers\", \"check\"])","+        .output()","+        .expect(\"check the individual install\");","+    assert_eq!(local.status.code(), Some(1));","+    let local = String::from_utf8(local.stdout).expect(\"UTF-8 local output\");","+    let body = local","+        .strip_prefix(\"Issues with peer dependencies found\\n\\n\")","+        .expect(\"existing peers heading\")","+        .trim_end();","+    let body = body","+        .lines()","+        .map(|line| format!(\"  {line}\"))","+        .collect::<Vec<_>>()","+        .join(\"\\n\");","+    let expected = format!(\"Issues with peer dependencies found\\n\\n@scope/tool\\n{body}\\n\");","+    for flag in [\"-g\", \"--global\"] {","+        let output = global_command(&workspace, &home)","+            .with_args([\"peers\", \"check\", flag])","+            .output()","+            .expect(\"check global peers\");","+        assert_eq!(output.status.code(), Some(1), \"{output:?}\");","+        assert_eq!(String::from_utf8(output.stdout).unwrap(), expected);","+    }","+}","+","+#[test]","+fn global_peers_keeps_install_groups_isolated_and_ignores_inactive_slots() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    let home = root.path().join(\"home\");","+    let missing = write_group(&home, \"missing\", &[\"tool-a\"], &lockfile(None));","+    write_group(&home, \"provider\", &[\"peer\", \"tool-b\"], &lockfile(Some(\"2.0.0\")));","+    write_group(&home, \"bad\", &[\"tool-c\"], &lockfile(Some(\"1.0.0\")));","+    let orphan = write_group(&home, \"orphan\", &[\"old-tool\"], &lockfile(None));","+    pnpm_fs::remove_symlink_dir(&home.join(\"global/v11/hash-orphan\"))","+        .expect(\"deactivate the old install\");","+    assert!(orphan.exists());","+    pnpm_fs::symlink_dir(&missing, &home.join(\"global/v11/duplicate\"))","+        .expect(\"second link to the same install\");","+    let broken = write_group(&home, \"broken\", &[\"broken-tool\"], &lockfile(None));","+    fs::remove_dir_all(broken).expect(\"leave a dangling slot\");","+    let invalid = write_group(&home, \"invalid\", &[\"invalid-tool\"], &lockfile(None));","+    fs::write(invalid.join(\"package.json\"), \"invalid json\").unwrap();","+","+    let output = global_command(&workspace, &home)","+        .with_args([\"peers\", \"check\", \"-g\", \"--json\"])","+        .output()","+        .expect(\"check global peers as JSON\");","+    assert_eq!(output.status.code(), Some(1), \"{output:?}\");","+    let issues: Value = serde_json::from_slice(&output.stdout).unwrap();","+    assert_eq!(","+        issues","+            .as_object()","+            .unwrap()","+            .keys()","+            .collect::<Vec<_>>(),","+        [\"peer, tool-b\", \"tool-a\", \"tool-c\"],","+    );","+    assert_eq!(issues[\"tool-a\"][\"missing\"][\"peer\"][0][\"wantedRange\"], \"^2.0.0\");","+    assert_eq!(issues[\"peer, tool-b\"][\"bad\"], json!({}));","+    assert_eq!(issues[\"peer, tool-b\"][\"missing\"], json!({}));","+    assert_eq!(issues[\"tool-c\"][\"bad\"][\"peer\"][0][\"foundVersion\"], \"1.0.0\");","+}","+","+#[test]","+fn global_peers_prefers_each_current_lockfile_and_honors_lockfile_only() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    let home = root.path().join(\"home\");","+    let install = write_group(&home, \"tool\", &[\"tool\"], &lockfile(Some(\"1.0.0\")));","+    let install_state = install.join(\"node_modules/.pnpm\");","+    fs::create_dir_all(&install_state).unwrap();","+    fs::write(install_state.join(\"lock.yaml\"), lockfile(Some(\"2.0.0\")).to_string()).unwrap();","+    global_command(&workspace, &home)","+        .with_args([\"peers\", \"check\", \"-g\"])","+        .assert()","+        .success()","+        .stdout(\"No peer dependency issues found\\n\");","+    let output = global_command(&workspace, &home)","+        .with_args([\"peers\", \"check\", \"-g\", \"--lockfile-only\"])","+        .assert()","+        .code(1);","+    assert!(String::from_utf8_lossy(&output.get_output().stdout).contains(\"✕ unmet peer peer\"));","+}","+","+#[test]","+fn global_peers_ignores_the_callers_workspace_and_uses_global_peer_rules() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    let home = root.path().join(\"home\");","+    write_group(&home, \"tool\", &[\"tool\"], &lockfile(Some(\"1.0.0\")));","+    fs::write(workspace.join(\"package.json\"), r#\"{\"