arser/parsed_data/copy_info.cpp","lines":["@@ -1,5 +1,7 @@"," #include \"duckdb/parser/parsed_data/copy_info.hpp\""," ","+#include \"duckdb/common/algorithm.hpp\"","+"," #include \"duckdb/common/sql_identifier.hpp\""," #include \"duckdb/parser/query_node.hpp\""," ","@@ -70,18 +72,27 @@ string CopyInfo::CopyOptionsToString() const {"," \tif (!format.empty() && !is_format_auto_detected) {"," \t\tstringified.push_back(StringUtil::Format(\" FORMAT %s\", SQLString(format)));"," \t}","+\t// render the options in sorted order so the generated text is deterministic across platforms","+\tvector<Identifier> parsed_option_names;"," \tfor (auto &opt : parsed_options) {","-\t\tauto &name = opt.first;","-\t\tauto &expr = opt.second;","+\t\tparsed_option_names.push_back(opt.first);","+\t}","+\tstd::sort(parsed_option_names.begin(), parsed_option_names.end());","+\tfor (auto &name : parsed_option_names) {","+\t\tauto &expr = parsed_options.find(name)->second;"," \t\tstring option_string = StringUtil::Format(\"%s\", name);"," \t\tif (expr) {"," \t\t\toption_string += \" \" + expr->ToString();"," \t\t}"," \t\tstringified.push_back(option_string);"," \t}","+\tvector<Identifier> option_names;"," \tfor (auto &opt : options) {","-\t\tauto &name = opt.first;","-\t\tauto &values = opt.second;","+\t\toption_names.push_back(opt.first);","+\t}","+\tstd::sort(option_names.begin(), option_names.end());","+\tfor (auto &name : option_names) {","+\t\tauto &values = options.find(name)->second;"," "," \t\tauto option = StringUtil::Format(\"%s \", name);"," \t\tif (values.empty()) {"],"additions":15,"deletions":4,"truncated":false},{"path":"src/parser/query_node/statement_node.cpp","lines":["@@ -5,6 +5,10 @@ namespace duckdb {"," StatementNode::StatementNode(SQLStatement &stmt_p) : QueryNode(QueryNodeType::STATEMENT_NODE), stmt(stmt_p) {"," }"," ","+StatementNode::StatementNode(unique_ptr<SQLStatement> stmt_p)","+    : QueryNode(QueryNodeType::STATEMENT_NODE), stmt(*stmt_p), owned_statement(std::move(stmt_p)) {","+}","+"," //! Convert the query node to a string"," string StatementNode::ToString() const {"," \treturn stmt.ToString();","@@ -23,6 +27,9 @@ bool StatementNode::Equals(const QueryNode *other_p) const {"," "," //! Create a copy of this SelectNode"," unique_ptr<QueryNode> StatementNode::Copy() const {","+\tif (owned_statement) {","+\t\treturn make_uniq<StatementNode>(owned_statement->Copy());","+\t}"," \treturn make_uniq<StatementNode>(stmt);"," }"," "],"additions":7,"deletions":0,"truncated":false},{"path":"src/planner/binder/statement/bind_explain.cpp","lines":["@@ -1,4 +1,6 @@"," #include \"duckdb/planner/binder.hpp\"","+#include \"duckdb/parser/parsed_data/create_table_info.hpp\"","+#include \"duckdb/parser/statement/create_statement.hpp\""," #include \"duckdb/parser/statement/explain_statement.hpp\""," #include \"duckdb/planner/operator/logical_explain.hpp\""," #include \"duckdb/common/tree_renderer.hpp\"","@@ -14,10 +16,19 @@ BoundStatement Binder::Bind(ExplainStatement &stmt) {"," \t\tcase StatementType::UPDATE_STATEMENT:"," \t\tcase StatementType::DELETE_STATEMENT:"," \t\tcase StatementType::MERGE_INTO_STATEMENT:","+\t\tcase StatementType::COPY_STATEMENT:"," \t\t\tbreak;","+\t\tcase StatementType::CREATE_STATEMENT: {","+\t\t\tauto &info = *stmt.stmt->Cast<CreateStatement>().info;","+\t\t\tif (info.type == CatalogType::TABLE_ENTRY && info.Cast<CreateTableInfo>().query) {","+\t\t\t\tbreak;","+\t\t\t}","+\t\t\tthrow NotImplementedException(\"EXPLAIN (SQL) supports SELECT, VALUES, WITH, INSERT, UPDATE, DELETE, \"","+\t\t\t                              \"MERGE INTO, CREATE TABLE ... AS and COPY ... TO statements only\");","+\t\t}"," \t\tdefault:","-\t\t\tthrow NotImplementedException(","-\t\t\t    \"EXPLAIN (SQL) supports SELECT, VALUES, WITH, INSERT, UPDATE, DELETE and MERGE INTO statements only\");","+\t\t\tthrow NotImplementedException(\"EXPLAIN (SQL) supports SELECT, VALUES, WITH, INSERT, UPDATE, DELETE, \"","+\t\t\t                              \"MERGE INTO, CREATE TABLE ... AS and COPY ... TO statements only\");"," \t\t}"," \t}"," "],"additions":13,"deletions":2,"truncated":false},{"path":"src/planner/operator/logical_explain.cpp","lines":["@@ -22,6 +22,8 @@ unique_ptr<LogicalOperator> LogicalExplain::CreateSQLResult(ClientContext &conte"," \tcase LogicalOperatorType::LOGICAL_UPDATE:"," \tcase LogicalOperatorType::LOGICAL_DELETE:"," \tcase LogicalOperatorType::LOGICAL_MERGE_INTO:","+\tcase LogicalOperatorType::LOGICAL_CREATE_TABLE:","+\tcase LogicalOperatorType::LOGICAL_COPY_TO_FILE:"," \t\t// a data-modifying statement reports a change count; that is not a projection of the generated SQL"," \t\tbreak;"," \tdefault:"],"additions":2,"deletions":0,"truncated":false},{"path":"src/planner/sql_export/CMakeLists.txt","lines":["@@ -14,6 +14,7 @@ add_library_unity(","   sql_export_relations.cpp","   sql_export_scope.cpp","   sql_export_sources.cpp","+  sql_export_statements.cpp","   sql_export_values.cpp","   sql_export_window.cpp","   table_function_sql_export.cpp)"],"additions":1,"deletions":0,"truncated":false},{"path":"src/planner/sql_export/README.md","lines":["@@ -22,9 +22,9 @@ Optimization can also fold observations made while planning into the generated S"," "," ## Supported statements and errors"," ","-SQL mode accepts supported SELECT, VALUES, and WITH queries, and INSERT, UPDATE, DELETE, and MERGE INTO statements. It does not combine with ANALYZE or FORMAT, and it does not support DDL, CALL, or EXPLAIN EXECUTE. Existing restrictions on SQL PREPARE also apply. Some logical operators and expressions cannot yet be exported; their errors describe the unsupported query or source. The C++ export result retains structured issue codes, phases, and plan locations. Unsupported export never returns the original query as a fallback.","+SQL mode accepts supported SELECT, VALUES, and WITH queries, and INSERT, UPDATE, DELETE, MERGE INTO, CREATE TABLE ... AS, and COPY ... TO statements. It does not combine with ANALYZE or FORMAT, and it does not support other DDL, CALL, or EXPLAIN EXECUTE. Existing restrictions on SQL PREPARE also apply. Some logical operators and expressions cannot yet be exported; their errors describe the unsupported query or source. The C++ export result retains structured issue codes, phases, and plan locations. Unsupported export never returns the original query as a fallback."," ","-An exported data-modifying statement reconstructs its bound source as a query: an INSERT becomes `INSERT INTO` the table's physical columns from a generated query, and UPDATE and DELETE statements key the modified rows by the table's `rowid` column computed in a generated subquery. A MERGE INTO exports its bound source join as the USING relation, keyed back to the target by row id, with each bound action reconstructed; `ON CONFLICT` inserts export through their MERGE INTO binding. `RETURNING` lists are reconstructed against the modified table's columns, and data-modifying CTEs export as materialized CTE bodies, both as producers and with a data-modifying statement as the consumer. `WHEN NOT MATCHED BY SOURCE` actions, triggers on the modified table, and tables without a single named row-id column are rejected.","+An exported data-modifying statement reconstructs its bound source as a query: an INSERT becomes `INSERT INTO` the table's physical columns from a generated query, and UPDATE and DELETE statements key the modified rows by the table's `rowid` column computed in a generated subquery. A CREATE TABLE ... AS or COPY ... TO exports its bound source as a query carrying the created or written column names. The COPY sink options re-emit from the operator's resolved state, including PARTITION_BY, ordering, overwrite and rotation settings, while format-specific options stay as bound. A computed file path, PARTITION_PATH, and orderings that are not plain written columns are rejected. A MERGE INTO exports its bound source join as the USING relation, keyed back to the target by row id, with each bound action reconstructed; `ON CONFLICT` inserts export through their MERGE INTO binding. `RETURNING` lists are reconstructed against the modified table's columns, and data-modifying CTEs export as materialized CTE bodies, both as producers and with a data-modifying statement as the consumer. `WHEN NOT MATCHED BY SOURCE` actions, triggers on the modified table, and tables without a single named row-id column are rejected."," "," PIVOT with values discovered from data is rejected because column discovery requires executing auxiliary statements. Specify the values with an explicit IN list to export supported PIVOT queries. Unresolved parameters and explicit optimizer opt-outs may also leave unsupported plan nodes."," "],"additions":2,"deletions":2,"truncated":false},{"path":"src/planner/sql_export/logical_plan_sql_exporter.cpp","lines":["@@ -95,8 +95,8 @@ static LogicalPlanSQLExportResult EnsureSQLProjection(LogicalPlanSQLExportResult"," \treturn result;"," }"," ","-static LogicalPlanSQLExportResult ApplyOutputNames(LogicalPlanSQLExportResult result,","-                                                   const vector<Identifier> &output_names) {","+LogicalPlanSQLExportResult LogicalPlanSQLExportHelpers::ApplyOutputNames(LogicalPlanSQLExportResult result,","+                                                                         const vector<Identifier> &output_names) {"," \tif (result.HasError()) {"," \t\treturn result;"," \t}","@@ -346,7 +346,7 @@ LogicalPlanSQLExporter::Export(ClientContext &context, LogicalOperator &root,"," \tif (!options.output_names) {"," \t\treturn result;"," \t}","-\treturn ApplyOutputNames(std::move(result), *options.output_names);","+\treturn LogicalPlanSQLExportHelpers::ApplyOutputNames(std::move(result), *options.output_names);"," }"," "," LogicalPlanSQLExportResult","@@ -441,7 +441,9 @@ LogicalPlanSQLExporter::ExportWithSources(ClientContext &context, LogicalOperato"," \t\t               captured->GetIdentifierName());"," \t}"," \tauto success = LogicalPlanSQLExportResult::Success(std::move(result));","-\treturn options.output_names ? ApplyOutputNames(std::move(success), *options.output_names) : std::move(success);","+\treturn options.output_names","+\t           ? LogicalPlanSQLExportHelpers::ApplyOutputNames(std::move(success), *options.output_names)","+\t           : std::move(success);"," }"," "," } // namespace duckdb"],"additions":6,"deletions":4,"truncated":false},{"path":"src/planner/sql_export/sql_export_cte.cpp","lines":["@@ -71,6 +71,12 @@ LogicalPlanSQLExportResult LogicalMaterializedCTE::ToSQL(LogicalPlanSQLExportCon"," \t\t// a data-modifying statement cannot be wrapped in a SELECT: it carries this CTE itself,"," \t\t// in front of the definitions its export already collected"," \t\tauto relation = std::move(consumer.GetValue().relation);","+\t\tif (relation.query->type == QueryNodeType::COPY_QUERY_NODE ||","+\t\t    relation.query->type == QueryNodeType::STATEMENT_NODE) {","+\t\t\t// the generated text of these nodes cannot carry a WITH clause","+\t\t\treturn LogicalPlanSQLExportResult::Failure({LogicalPlanSQLExportHelpers::PlanUnsupportedFeature(","+\t\t\t    path, \"cte_statement_consumer\", \"The statement cannot carry the CTE definitions it consumes\")});","+\t\t}"," \t\tif (relation.fields.size() != fields.GetValue().size()) {"," \t\t\treturn LogicalPlanSQLExportResult::Failure({LogicalPlanSQLExportHelpers::PlanUnsupportedFeature("," \t\t\t    path, \"cte_dml_consumer\", \"The data-modifying CTE consumer does not forward the CTE's columns\")});"],"additions":6,"deletions":0,"truncated":false},{"path":"src/planner/sql_export/sql_export_dml.cpp","lines":["@@ -16,6 +16,7 @@"," #include \"duckdb/planner/expression_iterator.hpp\""," #include \"duckdb/planner/operator/logical_delete.hpp\""," #include \"duckdb/planner/operator/logical_insert.hpp\"","+#include \"duckdb/planner/operator/logical_copy_to_file.hpp\""," #include \"duckdb/planner/operator/logical_merge_into.hpp\""," #include \"duckdb/planner/operator/logical_projection.hpp\""," #include \"duckdb/planner/operator/logical_update.hpp\"","@@ -342,6 +343,9 @@ static optional<LogicalPlanVerificationIssue> DMLStatementIssue(const LogicalOpe"," \tcase LogicalOperatorType::LOGICAL_MERGE_INTO:"," \t\treturn_chunk = op.Cast<LogicalMergeInto>().return_chunk;"," \t\tbreak;","+\tcase LogicalOperatorType::LOGICAL_COPY_TO_FILE:","+\t\treturn_chunk = false;","+\t\tbreak;"," \tdefault:"," \t\treturn_chunk = op.Cast<LogicalDelete>().return_chunk;"," \t\tbreak;","@@ -410,6 +414,7 @@ bool SQLExportDMLHelpers::MatchDMLBody(LogicalOperator &op) {"," \tcase LogicalOperatorType::LOGICAL_UPDATE:"," \tcase LogicalOperatorType::LOGICAL_DELETE:"," \tcase LogicalOperatorType::LOGICAL_MERGE_INTO:","+\tcase LogicalOperatorType::LOGICAL_COPY_TO_FILE:"," \t\treturn true;"," \tdefault:"," \t\treturn MatchReturningRoot(op) || IsIdentityProjectionOverDML(op);","@@ -422,6 +427,8 @@ bool SQLExportDMLHelpers::IsDMLNode(const QueryNode &query) {"," \tcase QueryNodeType::UPDATE_QUERY_NODE:"," \tcase QueryNodeType::DELETE_QUERY_NODE:"," \tcase QueryNodeType::MERGE_QUERY_NODE:","+\tcase QueryNodeType::COPY_QUERY_NODE:","+\tcase QueryNodeType::STATEMENT_NODE:"," \t\treturn true;"," \tdefault:"," \t\treturn false;","@@ -459,6 +466,8 @@ LogicalPlanSQLExportResult SQLExportDMLHelpers::ExportBody(LogicalPlanSQLExportC"," \t\treturn ExportUpdateNode(op.Cast<LogicalUpdate>(), context, path);"," \tcase LogicalOperatorType::LOGICAL_MERGE_INTO:"," \t\treturn ExportMergeNode(op.Cast<LogicalMergeInto>(), context, path);","+\tcase LogicalOperatorType::LOGICAL_COPY_TO_FILE:","+\t\treturn SQLExportStatementHelpers::ExportCopyToNode(op.Cast<LogicalCopyToFile>(), context, path);"," \tdefault:"," \t\treturn ExportDeleteNode(op.Cast<LogicalDelete>(), context, path);"," \t}"],"additions":9,"deletions":0,"truncated":false},{"path":"src/planner/sql_export/sql_export_statements.cpp","lines":["@@ -0,0 +1,274 @@","+#include \"duckdb/catalog/catalog_entry/table_catalog_entry.hpp\"","+#include \"duckdb/common/filename_pattern.hpp\"","+#include \"duckdb/common/sql_identifier.hpp\"","+#include \"duckdb/parser/parsed_data/copy_info.hpp\"","+#include \"duckdb/parser/parsed_data/create_table_info.hpp\"","+#include \"duckdb/parser/query_node/copy_query_node.hpp\"","+#include \"duckdb/parser/query_node/statement_node.hpp\"","+#include \"duckdb/parser/statement/create_statement.hpp\"","+#include \"duckdb/parser/statement/select_statement.hpp\"","+#include \"duckdb/planner/expression/bound_reference_expression.hpp\"","+#include \"duckdb/planner/operator/logical_copy_to_file.hpp\"","+#include \"duckdb/planner/operator/logical_create_table.hpp\"","+#include \"duckdb/planner/sql_export/logical_plan_sql_exporter_internal.hpp\"","+","+namespace duckdb {","+","+static LogicalPlanVerificationIssue UnsupportedStatement(const LogicalPlanVerificationPath &path, string feature,","+                                                         string message) {","+\treturn LogicalPlanSQLExportHelpers::PlanUnsupportedFeature(path, std::move(feature), std::move(message));","+}","+","+static optional<LogicalPlanVerificationIssue> StatementBoundaryIssue(const LogicalPlanSQLExportContext &context,","+                                                                     const LogicalPlanVerificationPath &path) {","+\tif (context.Ancestors().size() != 1) {","+\t\treturn UnsupportedStatement(path, \"dml_subplan\",","+\t\t                            \"A data-modifying operator below the plan root cannot be exported\");","+\t}","+\treturn optional<LogicalPlanVerificationIssue>();","+}","+","+//! The filename pattern string the bound segments were parsed from, empty for the default pattern.","+static optional<string> FilenamePatternOption(const FilenamePattern &pattern) {","+\t// the legacy serialization helpers drop legacy-compatible segments, read the segments directly","+\tauto &segments = pattern.Segments();","+\tstring result;","+\tfor (auto &segment : segments) {","+\t\tswitch (segment.type) {","+\t\tcase FileNameSegmentType::LITERAL:","+\t\t\tresult += segment.data;","+\t\t\tbreak;","+\t\tcase FileNameSegmentType::OFFSET:","+\t\t\tresult += \"{i}\";","+\t\t\tbreak;","+\t\tcase FileNameSegmentType::UUID_V4:","+\t\t\tresult += \"{uuid}\";","+\t\t\tbreak;","+\t\tcase FileNameSegmentType::UUID_V7:","+\t\t\tresult += \"{uuidv7}\";","+\t\t\tbreak;","+\t\tdefault:","+\t\t\treturn optional<string>();","+\t\t}","+\t}","+\treturn result;","+}","+","+LogicalPlanSQLExportResult SQLExportStatementHelpers::ExportCopyToNode(LogicalCopyToFile &op,","+                                                                       LogicalPlanSQLExportContext &context,","+                                                                       const LogicalPlanVerificationPath &path) {","+\tD_ASSERT(op.copy_info);","+\tif (op.copy_info->is_from || op.children.size() != 1) {","+\t\treturn LogicalPlanSQLExportResult::Failure(","+\t\t    {UnsupportedStatement(path, \"copy_shape\", \"COPY without a source query cannot be exported\")});","+\t}","+\tif (op.copy_info->file_path_expression) {","+\t\treturn LogicalPlanSQLExportResult::Failure(","+\t\t    {UnsupportedStatement(path, \"copy_dynamic_path\", \"COPY with a computed file path cannot be exported\")});","+\t}","+\tif (op.partition_path_expression) {","+\t\treturn LogicalPlanSQLExportResult::Failure(","+\t\t    {UnsupportedStatement(path, \"copy_partition_path\", \"COPY with PARTITION_PATH cannot be exported\")});","+\t}","+\tauto pattern = FilenamePatternOption(op.filename_pattern);","+\tif (!pattern) {","+\t\treturn LogicalPlanSQLExportResult::Failure({UnsupportedStatement(","+\t\t    path, \"copy_filename_pattern\", \"The COPY filename pattern cannot be reconstructed as an option\")});","+\t}","+\tauto fields = LogicalPlanSQLExportHelpers::CreateFields(op, path);","+\tif (fields.HasError()) {","+\t\treturn LogicalPlanSQLExportResult::Failure(fields);","+\t}","+\tauto child = context.Export(*op.children[0], LogicalPlanSQLExportHelpers::PlanChildPath(path, 0));","+\tif (child.HasError()) {","+\t\treturn child;","+\t}","+\t// the written file schema uses the source's output names","+\tif (child.GetValue().fields.size() != op.names.size()) {","+\t\treturn LogicalPlanSQLExportResult::Failure(","+\t\t    {UnsupportedStatement(path, \"copy_shape\", \"The COPY source does not cover the written columns\")});","+\t}","+\tchild = LogicalPlanSQLExportHelpers::ApplyOutputNames(std::move(child), op.names);","+\tif (child.HasError()) {","+\t\treturn child;","+\t}","+\tauto info = make_uniq<CopyInfo>();","+\tinfo->is_from = false;","+\t// the bound format may be auto-detected or fallen back, the selected function is authoritative","+\tinfo->format = op.function.name.GetIdentifierName();","+\tinfo->is_format_auto_detected = false;","+\tinfo->file_path = op.file_path;","+\t// format-specific options stay in the bound info, sink options re-emit from the operator's resolved state","+\tfor (auto &entry : op.copy_info->options) {","+\t\tinfo->options[entry.first] = entry.second;","+\t}","+\tauto set_option = [&](const char *name, Value value) {","+\t\tinfo->options[Identifier(name)] = {std::move(value)};","+\t};","+\t// binding rejects an explicit USE_TMP_FILE next to these modes and resolves it to false","+\tconst bool use_tmp_file_implied =","+\t    op.per_thread_output || op.rotate || op.partition_output || !op.order_columns.empty();","+\tif (!use_tmp_file_implied) {","+\t\tset_option(\"use_tmp_file\", Value::BOOLEAN(op.use_tmp_file));","+\t}","+\tswitch (op.overwrite_mode) {","+\tcase CopyOverwriteMode::COPY_OVERWRITE_OR_IGNORE:","+\t\tset_option(\"overwrite_or_ignore\", Value::BOOLEAN(true));","+\t\tbreak;","+\tcase CopyOverwriteMode::COPY_OVERWRITE:","+\t\tset_option(\"overwrite\", Value::BOOLEAN(true));","+\t\tbreak;","+\tcase CopyOverwriteMode::COPY_APPEND:","+\t\tset_option(\"append\", Value::BOOLEAN(true));","+\t\tbreak;","+\tdefault:","+\t\tbreak;","+\t}","+\tif (*pattern != \"data_{i}\") {","+\t\t// everything but the default renders, including an explicitly empty pattern","+\t\tset_option(\"filename_pattern\", Value(*pattern));","+\t}","+\t// binding defaults the extension from the function, so any difference was set explicitly,","+\t// including an explicitly empty extension","+\tif (op.file_extension != op.function.extension) {","+\t\tset_option(\"file_extension\", Value(op.file_extension));","+\t}","+\tif (op.per_thread_output) {","+\t\tset_option(\"per_thread_output\", Value::BOOLEAN(true));","+\t}","+\tif (op.batch_size.IsValid()) {","+\t\t// the binder backfills an unset batch size from the function's desired batch size, which a","+\t\t// rebind re-derives from the format options, so only an overriding value needs to render","+\t\tauto rederived = op.function.desired_batch_size && op.bind_data","+\t\t                     ? op.function.desired_batch_size(context.GetClientContext(), *op.bind_data)","+\t\t                     : optional_idx();","+\t\tif (op.batch_size != rederived) {","+\t\t\t// the SQL surface names these the row group options, batch_size is not a bindable name","+\t\t\tset_option(\"row_group_size\", Value::UBIGINT(op.batch_size.GetIndex()));","+\t\t}","+\t}","+\tif (op.batch_size_bytes.IsValid()) {","+\t\tset_option(\"row_group_size_bytes\", Value::UBIGINT(op.batch_size_bytes.GetIndex()));","+\t}","+\tif (op.batches_per_file.IsValid()) {","+\t\tset_option(\"row_groups_per_file\", Value::UBIGINT(op.batches_per_file.GetIndex()));","+\t}","+\tif (op.file_size_bytes.IsValid()) {","+\t\tset_option(\"file_size_bytes\", Value::UBIGINT(op.file_size_bytes.GetIndex()));","+\t}","+\t// ordered writes set partition_output without columns, which rebinding re-derives from order_by","+\tif (op.partition_output && !op.partition_columns.empty()) {","+\t\tvector<Value> partition_names;","+\t\tfor (auto column_index : op.partition_columns) {","+\t\t\tpartition_names.emplace_back(op.names[column_inde