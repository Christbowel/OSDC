his.configurationService.onDidChangeConfiguration,","+\t\t\tevent => event.affectsConfiguration(AGENT_SESSIONS_APPEARANCE_TOOLS_ENABLED_SETTING)","+\t\t\t\t|| event.affectsConfiguration(ChatConfiguration.HtmlPreviewEnabled)","+\t\t\t\t|| event.affectsConfiguration(ChatConfiguration.NativeComponentsEnabled)","+\t\t\t\t|| event.affectsConfiguration(CHAT_AUTOMATIONS_ENABLED_SETTING)","+\t\t\t\t|| event.affectsConfiguration(DevContainerHandoffEnabledSettingId)","+\t\t\t\t|| event.affectsConfiguration(DevContainerEnvironmentsEnabledSettingId)","+\t\t\t\t|| event.affectsConfiguration(DevContainerAgentHostEnabledSettingId)","+\t\t\t\t|| event.affectsConfiguration(RemoteAgentHostsEnabledSettingId)","+\t\t\t\t|| event.affectsConfiguration(ChatAIDisabledSettingId))(() => this._onDidChange.fire()));","+\t}","+","+\tisBuiltinSkill(uri: URI): boolean {","+\t\treturn isEqualOrParent(uri, BUILTIN_SKILLS_URI);","+\t}","+","+\tgetDisabledSkills(): ResourceSet {","+\t\treturn readDisabledPromptFiles(this.storageService, DISABLED_STORAGE_KEY);","+\t}","+","+\tsetDisabledSkills(uris: ResourceSet): void {","+\t\tstoreDisabledPromptFiles(this.storageService, DISABLED_STORAGE_KEY, uris);","+\t\tthis._onDidChange.fire();","+\t}","+","+\t/**","+\t * Moves disabled built-in skills from the prompts service's storage, keeping its other entries. Runs before the","+\t * first read, so no consumer ever sees a migrated skill as enabled.","+\t */","+\tprivate migrateLegacyDisabledSkills(): void {","+\t\tconst legacy = readDisabledPromptFiles(this.storageService, LEGACY_DISABLED_SKILLS_STORAGE_KEY);","+\t\tconst remaining = [...legacy].filter(uri => !this.isBuiltinSkill(uri));","+\t\tif (remaining.length === legacy.size) {","+\t\t\treturn;","+\t\t}","+\t\tconst disabled = this.getDisabledSkills();","+\t\tfor (const uri of legacy) {","+\t\t\tif (this.isBuiltinSkill(uri)) {","+\t\t\t\tdisabled.add(uri);","+\t\t\t}","+\t\t}","+\t\t// Store here before removing there, so an interruption never loses a de