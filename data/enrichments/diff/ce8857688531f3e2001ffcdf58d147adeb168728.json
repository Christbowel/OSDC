{"id":"ce8857688531f3e2001ffcdf58d147adeb168728","axis":"silent","repo":"rails/rails","sha":"ce8857688531f3e2001ffcdf58d147adeb168728","parsed":{"files":[{"path":"actionview/CHANGELOG.md","lines":["@@ -1,3 +1,17 @@","+*   Fix `strip_tags` to encode `\"` and `'` in its output.","+","+    `strip_tags` returns an `html_safe` string, but was not encoding quotation","+    marks. The method now encodes all five HTML-significant characters (`&`,","+    `<`, `>`, `\"`, `'`), consistent with the existing `html_safe` convention.","+","+    Output used outside HTML, such as in a text template or JSON, now contains","+    `&quot;` and `&#39;` where it contained `\"` and `'`. `CGI.unescapeHTML`","+    decodes them.","+","+    [GHSA-rq8q-p985-fjq7]","+","+    *Mike Dalessio*","+"," *   Escape the matched phrase before substituting it into `highlight`'s","     `:highlighter`."," "],"additions":14,"deletions":0,"truncated":false},{"path":"actionview/lib/action_view/helpers/sanitize_helper.rb","lines":["@@ -1,5 +1,6 @@"," # frozen_string_literal: true"," ","+require \"active_support/core_ext/string/output_safety\""," require \"rails-html-sanitizer\""," "," module ActionView","@@ -34,6 +35,9 @@ module SanitizeHelper","       # Please note that sanitizing user-provided text does not guarantee that the","       # resulting markup is valid or even well-formed.","       #","+      # The output is markup, which is safe only as element content. Do not use it in an attribute","+      # value; use `strip_tags` or a tag helper such as `tag.a(title: ...)` instead.","+      #","       # #### Options","       #","       # `:tags`","@@ -158,7 +162,8 @@ def sanitize_css(style)","       # # => &gt; A quote from Smith &amp; Wesson","       # ```","       def strip_tags(html)","-        self.class.full_sanitizer.sanitize(html)&.html_safe","+        stripped = self.class.full_sanitizer.sanitize(html)","+        ERB::Util.html_escape_once(stripped) if stripped","       end"," ","       # Strips all link tags from `html` leaving just the link text."],"additions":6,"deletions":1,"truncated":false},{"path":"actionview/test/template/sanitize_helper_test.rb","lines":["@@ -336,6 +336,10 @@ def test_sanitize_css","     assert_includes(result, \"height\")","   end"," ","+  def test_strip_tags_returns_nil_for_nil","+    assert_nil(@subject.strip_tags(nil))","+  end","+","   def test_strip_tags","     input = %(<div><a href=\"http://www.example.com/\">Example</a> of a fragment</div>)","     result = @subject.strip_tags(input)","@@ -343,6 +347,36 @@ def test_strip_tags","     assert_equal(\"Example of a fragment\", result)","   end"," ","+  def test_strip_tags_encodes_ampersand","+    assert_equal(\"this &amp; that\", @subject.strip_tags(\"this & that\"))","+    assert_equal(\"this &amp; that\", @subject.strip_tags(\"this &amp; that\"))","+    assert_equal(\"this &amp; that\", @subject.strip_tags(\"this &#38; that\"))","+  end","+","+  def test_strip_tags_encodes_less_than","+    assert_equal(\"this &lt; that\", @subject.strip_tags(\"this < that\"))","+    assert_equal(\"this &lt; that\", @subject.strip_tags(\"this &lt; that\"))","+    assert_equal(\"this &lt; that\", @subject.strip_tags(\"this &#60; that\"))","+  end","+","+  def test_strip_tags_encodes_greater_than","+    assert_equal(\"this &gt; that\", @subject.strip_tags(\"this > that\"))","+    assert_equal(\"this &gt; that\", @subject.strip_tags(\"this &gt; that\"))","+    assert_equal(\"this &gt; that\", @subject.strip_tags(\"this &#62; that\"))","+  end","+","+  def test_strip_tags_encodes_double_quote","+    assert_equal(\"this &quot; that\", @subject.strip_tags(\"this \\\" that\"))","+    assert_equal(\"this &quot; that\", @subject.strip_tags(\"this &quot; that\"))","+    assert_equal(\"this &quot; that\", @subject.strip_tags(\"this &#34; that\"))","+  end","+","+  def test_strip_tags_encodes_single_quote","+    assert_equal(\"this &#39; that\", @subject.strip_tags(\"this ' that\"))","+    assert_equal(\"this &#39; that\", @subject.strip_tags(\"this &apos; that\"))","+    assert_equal(\"this &#39; that\", @subject.strip_tags(\"this &#39; that\"))","+  end","+","   def test_strip_links","     input = %(<div><a href=\"http://www.example.com/\">Example</a> of a fragment</div>)","     result = @subject.strip_links(input)",""],"additions":34,"deletions":0,"truncated":false}],"additions":54,"deletions":1,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-04T16:06:40.519743+00:00"}