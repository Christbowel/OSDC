ng(&self, span: Span) -> &str;"," ","+    /// Returns the source text of `span` as an [`Atom`].","+    ///","+    /// The parser uses this method for the raw text of literals, such as","+    /// `Str.raw`. The default implementation interns the text in the global","+    /// atom store. That store keeps the text alive after the AST is dropped,","+    /// until the embedder runs a global atom store GC. Token sources that own","+    /// a local atom store, such as [`Lexer`](crate::lexer::Lexer), should","+    /// override this method so the text is freed with the AST.","+    fn read_atom(&self, span: Span) -> Atom {","+        Atom::new(self.read_string(span))","+    }","+","     fn start_pos(&self) -> BytePos {","         BytePos(0)","     }","@@ -520,6 +532,15 @@ impl<I: Tokens> Buffer<I> {","         self.iter.read_string(token_span)","     }"," ","+    /// Returns the source text of the current token as an [`Atom`].","+    ///","+    /// See [`Tokens::read_atom`].","+    #[inline]","+    pub fn cur_atom(&self) -> Atom {","+        let token_span = self.cur_span();","+        self.iter.read_atom(token_span)","+    }","+","     /// Returns last byte position of previous token.","     #[inline]","     pub fn last_pos(&self) -> BytePos {"],"additions":21,"deletions":0,"truncated":false},{"path":"crates/swc_ecma_parser/src/parser/jsx.rs","lines":["@@ -68,7 +68,7 @@ impl<I: Tokens> Parser<I> {","         debug_assert!(cur == Token::JSXText);"," ","         let value = self.input.expect_jsx_text_token_value();","-        let raw = Atom::new(self.input.cur_string());","+        let raw = self.input.cur_atom();"," ","         self.input.scan_jsx_token();","         let span = self.input().prev_span();"],"additions":1,"deletions":1,"truncated":false},{"path":"crates/swc_ecma_parser/src/parser/mod.rs","lines":["@@ -1468,22 +1468,22 @@ impl<I: Tokens> Parser<I> {","             let value = self.input_mut().expect_number_token_value();","             self.bump();"," ","-            let raw = self.input.iter.read_string(token_span);","+            let raw = self.input.iter.read_atom(token_span);","             PropName::Num(Number {","                 span: self.span(start),","                 value,","-                raw: Some(Atom::new(raw)),","+                raw: Some(raw),","             })","         } else if cur == Token::BigInt {","             let token_span = self.input.cur_span();","             let value = self.input_mut().expect_bigint_token_value();","             self.bump();"," ","-            let raw = self.input.iter.read_string(token_span);","+            let raw = self.input.iter.read_atom(token_span);","             PropName::BigInt(BigInt {","                 span: self.span(start),","                 value,","-                raw: Some(Atom::new(raw)),","+                raw: Some(raw),","             })","         } else if self.syntax().flow()","             && cur == Token::At"],"additions":4,"deletions":4,"truncated":false},{"path":"crates/swc_ecma_parser/tests/raw_atom_store.rs","lines":["@@ -0,0 +1,127 @@","+//! Verifies that the parser interns the raw text of literals in the lexer's","+//! local atom store, not in the thread-local global atom store.","+//!","+//! The global store keeps an entry alive after the AST is dropped, until the","+//! embedder runs a global atom store GC. A long-lived process that parses many","+//! distinct literals then retains their raw text. See","+//! <https://github.com/swc-project/swc/issues/12839>.","+","+use swc_atoms::Atom;","+use swc_common::{BytePos, Span};","+use swc_ecma_ast::{BigInt, JSXText, Module, Number, Str, TplElement};","+use swc_ecma_parser::{input::Tokens, EsSyntax, Lexer, Parser, StringInput, Syntax};","+use swc_ecma_visit::{Visit, VisitWith};","+","+/// Each literal except the property values is longer than the inline atom","+/// limit, so its raw atom has a heap allocation that a pointer comparison can","+/// identify.","+const SRC: &str = r#\"","+const str = \"raw-string-literal-0123456789\";","+const num = 123456789.123456789;","+const big = 123456789012345678901234567890n;","+const tpl = `raw-template-head-0123456789${str}raw-template-tail-0123456789`;","+const tpl2 = `raw-template-no-substitution-0123456789`;","+const obj = { 9876543210.0123456: 1, 98765432109876543210n: 2, \"raw-prop-key-0123456789\": 3 };","+const el = <div>raw-jsx-text-0123456789</div>;","+\"#;","+","+/// The longest text that an atom stores inline on 64-bit targets.","+const INLINE_ATOM_MAX_LEN: usize = 7;","+","+/// Collects the raw atoms of all literals in a module.","+#[derive(Default)]","+struct RawCollector {","+    raws: Vec<Atom>,","+}","+","+impl Visit for RawCollector {","+    fn visit_str(&mut self, n: &Str) {","+        self.raws.extend(n.raw.clone());","+    }","+","+    fn visit_number(&mut self, n: &Number) {","+        self.raws.extend(n.raw.clone());","+    }","+","+    fn visit_big_int(&mut self, n: &BigInt) {","+        self.raws.extend(n.raw.clone());","+    }","+","+    fn visit_tpl_element(&mut self, n: &TplElement) {","+        self.raws.push(n.raw.clone());","+    }","+","+    fn visit_jsx_text(&mut self, n: &JSXText) {","+        self.raws.push(n.raw.clone());","+    }","+}","+","+fn lexer(src: &str) -> Lexer<'_> {","+    let input = StringInput::new(src, BytePos(1), BytePos(src.len() as u32 + 1));","+    Lexer::new(","+        Syntax::Es(EsSyntax {","+            jsx: true,","+            ..Default::default()","+        }),","+        Default::default(),","+        input,","+        None,","+    )","+}","+","+fn parse<I: Tokens>(tokens: I) -> Module {","+    let mut parser = Parser::new_from(tokens);","+    let module = parser.parse_module().expect(\"failed to parse the module\");","+    assert!(parser.take_errors().is_empty());","+    module","+}","+","+/// Asserts that no raw atom of `module` shares its allocation with the","+/// global atom of the same text.","+fn assert_raws_are_not_global(module: &Module) {","+    let mut collector = RawCollector::default();","+    module.visit_with(&mut collector);","+","+    // Short atoms are stored inline and have no allocation to compare.","+    let raws: Vec<_> = collector","+        .raws","+        .iter()","+        .filter(|raw| raw.len() > INLINE_ATOM_MAX_LEN)","+        .collect();","+","+    // 2 strings, 2 numbers, 2 BigInts, 3 template elements, and 1 JSX text.","+    assert_eq!(raws.len(), 10, \"raws: {raws:?}\");","+","+    for raw in raws {","+        let global = Atom::new(raw.as_str());","+        assert_eq!(raw, &global);","+        assert_ne!(","+            raw.as_str().as_ptr(),","+            global.as_str().as_ptr(),","+            \"raw text {raw:?} is interned in the global atom store\"","+        );","+    }","+}","+","+#[test]","+fn lexer_interns_raw_text_locally() {","+    let module = parse(lexer(SRC));","+    assert_raws_are_not_global(&module);","+}","+","+#[cfg(feature = \"unstable\")]","+#[test]","+fn capturing_interns_raw_text_locally() {","+    use swc_ecma_parser::unstable::Capturing;","+","+    let module = parse(Capturing::new(lexer(SRC)));","+    assert_raws_are_not_global(&module);","+}","+","+#[test]","+fn lexer_read_atom_returns_source_text() {","+    let lexer = lexer(SRC);","+    let start = SRC.find(\"raw-string\").unwrap() as u32 + 1;","+    let span = Span::new(BytePos(start), BytePos(start + 10));","+    assert_eq!(&*lexer.read_atom(span), \"raw-string\");","+}",""],"additions":127,"deletions":0,"truncated":false}],"additions":181,"deletions":15,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-23T19:31:04.967820+00:00"}