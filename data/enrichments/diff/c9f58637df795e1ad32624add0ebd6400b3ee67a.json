{"id":"c9f58637df795e1ad32624add0ebd6400b3ee67a","axis":"silent","repo":"codeigniter4/CodeIgniter4","sha":"c9f58637df795e1ad32624add0ebd6400b3ee67a","parsed":{"files":[{"path":"docs/changelogs/v4.7.7.md","lines":["@@ -12,6 +12,8 @@ Release Date: Unreleased"," "," ## Changes"," ","+- **Session:** Added defensive escaping of session lock arguments in `PostgreHandler`, preserving the existing locking behavior.","+"," ## Deprecations"," "," ## Bugs Fixed"],"additions":2,"deletions":0,"truncated":false},{"path":"system/Session/Handlers/Database/PostgreHandler.php","lines":["@@ -70,7 +70,9 @@ public function gc($max_lifetime): false|int","      */","     protected function lockSession(string $sessionID): bool","     {","-        $arg = \"hashtext('{$sessionID}')\" . ($this->matchIP ? \", hashtext('{$this->ipAddress}')\" : '');","+        $arg = 'hashtext(' . $this->db->escape($sessionID) . ')'","+            . ($this->matchIP ? ', hashtext(' . $this->db->escape($this->ipAddress) . ')' : '');","+","         if ($this->db->simpleQuery(\"SELECT pg_advisory_lock({$arg})\") !== false) {","             $this->lock = $arg;"," "],"additions":3,"deletions":1,"truncated":false},{"path":"tests/system/Session/Handlers/Database/PostgreHandlerMockConnection.php","lines":["@@ -0,0 +1,40 @@","+<?php","+","+declare(strict_types=1);","+","+/**","+ * This file is part of CodeIgniter 4 framework.","+ *","+ * (c) CodeIgniter Foundation <admin@codeigniter.com>","+ *","+ * For the full copyright and license information, please view","+ * the LICENSE file that was distributed with this source code.","+ */","+","+namespace CodeIgniter\\Session\\Handlers\\Database;","+","+use CodeIgniter\\Test\\Mock\\MockConnection;","+use CodeIgniter\\Test\\Mock\\MockResult;","+","+/**","+ * Mock connection that records the raw SQL passed to simpleQuery().","+ *","+ * PostgreHandler uses simpleQuery() when no bindings are needed, so the","+ * queries are not bound and must be captured as they are sent to the database.","+ *","+ * @internal","+ */","+final class PostgreHandlerMockConnection extends MockConnection","+{","+    /**","+     * @var list<string>","+     */","+    public array $executed = [];","+","+    public function simpleQuery(string $sql): MockResult","+    {","+        $this->executed[] = $sql;","+","+        return new MockResult($this->connID, $this->resultID);","+    }","+}"],"additions":40,"deletions":0,"truncated":false},{"path":"tests/system/Session/Handlers/Database/PostgreHandlerMockTest.php","lines":["@@ -0,0 +1,118 @@","+<?php","+","+declare(strict_types=1);","+","+/**","+ * This file is part of CodeIgniter 4 framework.","+ *","+ * (c) CodeIgniter Foundation <admin@codeigniter.com>","+ *","+ * For the full copyright and license information, please view","+ * the LICENSE file that was distributed with this source code.","+ */","+","+namespace CodeIgniter\\Session\\Handlers\\Database;","+","+use CodeIgniter\\Events\\Events;","+use CodeIgniter\\Test\\CIUnitTestCase;","+use CodeIgniter\\Test\\Mock\\MockConnection;","+use Config\\Session as SessionConfig;","+use PHPUnit\\Framework\\Attributes\\Group;","+","+/**","+ * @internal","+ */","+#[Group('Others')]","+final class PostgreHandlerMockTest extends CIUnitTestCase","+{","+    private const IP_ADDRESS = \"192.168.1.1' OR '1'='1\";","+    private const SESSION_ID = \"sess'id; DROP TABLE users; --\";","+","+    private function createHandler(bool $matchIP, MockConnection $mockDb): PostgreHandler","+    {","+        $config           = new SessionConfig();","+        $config->driver   = PostgreHandler::class;","+        $config->savePath = 'ci_sessions';","+        $config->matchIP  = $matchIP;","+","+        $handler = new PostgreHandler($config, self::IP_ADDRESS);","+        $this->setPrivateProperty($handler, 'db', $mockDb);","+","+        return $handler;","+    }","+","+    private function createMockDb(): PostgreHandlerMockConnection","+    {","+        return new PostgreHandlerMockConnection(['DBDriver' => 'Postgre']);","+    }","+","+    public function testLockAndReleaseSessionWithoutMatchIP(): void","+    {","+        $db      = $this->createMockDb();","+        $handler = $this->createHandler(false, $db);","+","+        $queryCount = 0;","+        $listener   = static function () use (&$queryCount): void {","+            $queryCount++;","+        };","+        Events::on('DBQuery', $listener);","+","+        $lockSession = self::getPrivateMethodInvoker($handler, 'lockSession');","+        $releaseLock = self::getPrivateMethodInvoker($handler, 'releaseLock');","+","+        $this->assertTrue($lockSession(self::SESSION_ID));","+        $this->assertSame(","+            \"hashtext('sess''id; DROP TABLE users; --')\",","+            self::getPrivateProperty($handler, 'lock'),","+        );","+","+        $this->assertTrue($releaseLock());","+        $this->assertFalse(self::getPrivateProperty($handler, 'lock'));","+","+        Events::removeListener('DBQuery', $listener);","+","+        $this->assertSame(0, $queryCount);","+        $this->assertSame([","+            \"SELECT pg_advisory_lock(hashtext('sess''id; DROP TABLE users; --'))\",","+            \"SELECT pg_advisory_unlock(hashtext('sess''id; DROP TABLE users; --'))\",","+        ], $db->executed);","+","+        $this->assertStringNotContainsString(self::SESSION_ID, $db->executed[0]);","+        $this->assertStringNotContainsString(self::SESSION_ID, $db->executed[1]);","+    }","+","+    public function testLockAndReleaseSessionWithMatchIP(): void","+    {","+        $db      = $this->createMockDb();","+        $handler = $this->createHandler(true, $db);","+","+        $queryCount = 0;","+        $listener   = static function () use (&$queryCount): void {","+            $queryCount++;","+        };","+        Events::on('DBQuery', $listener);","+","+        $lockSession = self::getPrivateMethodInvoker($handler, 'lockSession');","+        $releaseLock = self::getPrivateMethodInvoker($handler, 'releaseLock');","+","+        $this->assertTrue($lockSession(self::SESSION_ID));","+        $this->assertSame(","+            \"hashtext('sess''id; DROP TABLE users; --'), hashtext('192.168.1.1'' OR ''1''=''1')\",","+            self::getPrivateProperty($handler, 'lock'),","+        );","+","+        $this->assertTrue($releaseLock());","+        $this->assertFalse(self::getPrivateProperty($handler, 'lock'));","+","+        Events::removeListener('DBQuery', $listener);","+","+        $this->assertSame(0, $queryCount);","+        $this->assertSame([","+            \"SELECT pg_advisory_lock(hashtext('sess''id; DROP TABLE users; --'), hashtext('192.168.1.1'' OR ''1''=''1'))\",","+            \"SELECT pg_advisory_unlock(hashtext('sess''id; DROP TABLE users; --'), hashtext('192.168.1.1'' OR ''1''=''1'))\",","+        ], $db->executed);","+","+        $this->assertStringNotContainsString(self::SESSION_ID, $db->executed[0]);","+        $this->assertStringNotContainsString(self::IP_ADDRESS, $db->executed[0]);","+    }","+}",""],"additions":118,"deletions":0,"truncated":false}],"additions":163,"deletions":1,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-11-15T15:51:37.932362+00:00"}