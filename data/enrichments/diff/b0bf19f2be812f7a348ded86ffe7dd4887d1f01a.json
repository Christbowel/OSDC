ield, TypeAdapter, ValidationError"," "," "," def test_dict():","@@ -40,6 +42,42 @@ def test_dict_validate_json():","     assert ta.validate_json('{\"1\": 1, \"1\": 2}') == {1: 2}"," "," ","+@pytest.mark.parametrize(","+    'tp,field_type',","+    [","+        (dict[int, int], 'Dictionary'),","+        (OrderedDict[int, int], 'OrderedDict'),","+        (Counter[int], 'Counter'),","+        pytest.param(","+            'frozendict',","+            'Frozendict',","+            marks=pytest.mark.skipif(sys.version_info < (3, 15), reason='Requires the `frozendict` builtin type'),","+        ),","+    ],","+)","+def test_dict_max_length(tp: Any, field_type: str) -> None:","+    if tp == 'frozendict':","+        tp = frozendict[int, int]  # noqa: F821","+    ta = TypeAdapter(Annotated[tp, Field(max_length=2)])","+","+    # duplicate keys don't count towards the length:","+    assert ta.validate_json('{\"1\": 1, \"1\": 1, \"1\": 1, \"2\": 2}') == {1: 1, 2: 2}","+    assert ta.validate_python({'1': 1, '01': 1, 2: 2}) == {1: 1, 2: 2}","+","+    with pytest.raises(ValidationError) as exc_info:","+        ta.validate_json('{\"1\": 1, \"2\": 2, \"3\": 3, \"4\": \"invalid\"}')","+","+    assert exc_info.value.errors(include_url=False) == [","+        {","+            'type': 'too_long',","+            'loc': (),","+            'msg': f'{field_type} should have at most 2 items after validation, not more',","+            'input': {'1': 1, '2': 2, '3': 3, '4': 'invalid'},","+            'ctx': {'field_type': field_type, 'max_length': 2, 'actual_length': None},","+        }","+    ]","+","+"," def test_dict_validate_json_any_value():","     ta = TypeAdapter(dict[str, Any])"," ",""],"additions":40,"deletions":2,"truncated":false}],"additions":89,"deletions":12,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-28T14:42:43.130570+00:00"}