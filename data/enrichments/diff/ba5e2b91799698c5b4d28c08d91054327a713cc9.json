lueLabel: \"2024-06-15\"})","+        const groups: FilterGroup[] = [{id: \"leaf1\", kind: \"leaf\", filters: [dateFilter]}]","+","+        // When","+        saveFilter(\"Grouped date filter\", \"\", [dateFilter], groups, \"OR\")","+","+        // Then: the value inside groups[].filters is deserialized back into a Date, same as the flat list","+        const saved = savedFilters.value[0]","+        const groupValue = (saved.groups?.[0] as {filters: AppliedFilter[]}).filters[0].value","+        expect(groupValue).toBeInstanceOf(Date)","+        expect((groupValue as Date).toISOString()).toBe(isoDate.toISOString())","+    })"," })",""],"additions":74,"deletions":1,"truncated":false}],"additions":361,"deletions":27,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-07-24T10:17:34.640324+00:00"}