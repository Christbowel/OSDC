tab\"></map>',","+        ),","+      ).toEqual(","+        '<map><area href=\"https://attacker.example\" target=\"custom_tab\" rel=\"noopener\"></map>',","+      );","+      // Already protected via `noreferrer` or `noopener`","+      expect(","+        sanitizeHtml(","+          defaultDoc,","+          '<a href=\"https://angular.dev\" target=\"custom_tab\" rel=\"noreferrer\">x</a>',","+        ),","+      ).toEqual('<a href=\"https://angular.dev\" target=\"custom_tab\" rel=\"noreferrer\">x</a>');","+      expect(","+        sanitizeHtml(","+          defaultDoc,","+          '<a href=\"https://angular.dev\" target=\"custom_tab\" rel=\"noopener\">x</a>',","+        ),","+      ).toEqual('<a href=\"https://angular.dev\" target=\"custom_tab\" rel=\"noopener\">x</a>');","+      expect(","+        sanitizeHtml(","+          defaultDoc,","+          '<a href=\"https://angular.dev\" target=\"custom_tab\" rel=\"NOOPENER\">x</a>',","+        ),","+      ).toEqual('<a href=\"https://angular.dev\" target=\"custom_tab\" rel=\"NOOPENER\">x</a>');","+      expect(logMsgs).toEqual([]);","+    });","+","+    it('strips `opener` and ensures `noopener` on custom named `target` values with warning', () => {","+      expect(","+        sanitizeHtml(","+          defaultDoc,","+          '<a href=\"https://attacker.example\" target=\"custom_tab\" rel=\"opener\">x</a>',","+        ),","+      ).toEqual('<a href=\"https://attacker.example\" target=\"custom_tab\" rel=\"noopener\">x</a>');","+      expect(","+        sanitizeHtml(","+          defaultDoc,","+          '<a href=\"https://attacker.example\" target=\"custom_tab\" rel=\"opener noopener\">x</a>',","+        ),","+      ).toEqual('<a href=\"https://attacker.example\" target=\"custom_tab\" rel=\"noopener\">x</a>');","+      expect(","+        sanitizeHtml(","+          defaultDoc,","+          '<a href=\"https://attacker.example\" target=\"custom_tab\" rel=\"noreferrer opener\">x</a>',","+        ),","+      ).toEqual('<a href=