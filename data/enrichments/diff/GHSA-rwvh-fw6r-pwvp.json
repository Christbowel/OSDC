{"id":"GHSA-rwvh-fw6r-pwvp","axis":"advisories","repo":"rails/rails","sha":"27ad18ed5900dee28ba20e9c6fc718ff751fa215","parsed":{"files":[{"path":"actionpack/CHANGELOG.md","lines":["@@ -1,3 +1,10 @@","+*   Prevent `ActionController::Live` streams from blocking when a full buffer is","+    closed or aborted.","+","+    [GHSA-rwvh-fw6r-pwvp]","+","+    *Jeremy Daer*","+"," *   Set and extend the `Vary` header for rendered responses according to the","     request headers used in format negotiation."," "],"additions":7,"deletions":0,"truncated":false},{"path":"actionpack/lib/action_controller/metal/live.rb","lines":["@@ -218,7 +218,11 @@ def write(string)","           @response.delete_header \"Content-Length\"","         end"," ","-        super","+        begin","+          super","+        rescue ClosedQueueError","+          raise IOError, \"closed stream\" if connected?","+        end"," ","         unless connected?","           @buf.clear","@@ -236,14 +240,14 @@ def writeln(string)","         write string.end_with?(\"\\n\") ? string : \"#{string}\\n\"","       end"," ","-      # Write a 'close' event to the buffer; the producer/writing thread uses this to","-      # notify us that it's finished supplying content.","+      # Close the buffer; the producer/writing thread uses this to notify us that","+      # it's finished supplying content.","       #","       # See also #abort.","       def close","         synchronize do","           super","-          @buf.push nil","+          @buf.close","           @cv.broadcast","         end","       end","@@ -255,7 +259,9 @@ def close","       def abort","         synchronize do","           @aborted = true","+          @buf.close","           @buf.clear","+          @cv.broadcast","         end","       end"," "],"additions":10,"deletions":4,"truncated":false},{"path":"actionpack/test/controller/live_stream_test.rb","lines":["@@ -1,6 +1,7 @@"," # frozen_string_literal: true"," "," require \"abstract_unit\"","+require \"active_support/core_ext/object/with\""," require \"timeout\""," require \"concurrent/atomic/count_down_latch\""," require \"zeitwerk\"","@@ -725,6 +726,108 @@ def test_nil_callback","       buf = ActionController::Live::Buffer.new nil","       assert buf.call_on_error","     end","+","+    def test_abort_terminates_a_reader_blocked_on_the_buffer","+      response = ActionController::Live::Response.new","+      response.request = ActionDispatch::Request.empty","+      buf = response.stream","+","+      received = []","+      reader = Thread.new { response.each { |chunk| received << chunk } }","+","+      buf.write \"hello\"","+      Timeout.timeout(5) do","+        Thread.pass until received.any?             # reader drained the chunk...","+        Thread.pass until reader.status == \"sleep\"  # ...and is blocked on the queue","+      end","+","+      buf.abort","+","+      assert reader.join(5), \"#abort did not release a reader blocked in each_chunk\"","+      assert_equal [\"hello\"], received","+    ensure","+      reader&.kill","+    end","+","+    def test_close_then_abort_still_terminates_the_reader","+      response = ActionController::Live::Response.new","+      response.request = ActionDispatch::Request.empty","+      buf = response.stream","+","+      buf.write \"final\"","+      buf.close   # closes the queue after its final chunk","+      buf.abort   # clears that pending chunk without reopening the queue","+","+      reader = Thread.new { response.each { } }","+","+      assert reader.join(5), \"#abort after #close left the reader blocked in each_chunk\"","+    ensure","+      reader&.kill","+    end","+","+    def test_close_with_a_full_buffer_does_not_wait_for_a_reader","+      ActionController::Live::Buffer.with(queue_size: 1) do","+        response = ActionController::Live::Response.new","+        response.request = ActionDispatch::Request.empty","+        buf = response.stream","+        buf.write \"final\"","+","+        closer = Thread.new { buf.close }","+","+        assert closer.join(1), \"#close waited for a reader to drain the full buffer\"","+        chunks = []","+        response.each { |chunk| chunks << chunk }","+        assert_equal [\"final\"], chunks","+      ensure","+        closer&.kill","+      end","+    end","+","+    def test_close_and_abort_finish_when_a_single_slot_buffer_is_full","+      ActionController::Live::Buffer.with(queue_size: 1) do","+        response = ActionController::Live::Response.new","+        response.request = ActionDispatch::Request.empty","+        buf = response.stream","+        buf.write \"queued\"","+","+        start = Concurrent::CountDownLatch.new","+        closer = Thread.new { start.wait; buf.close }","+        aborter = Thread.new { start.wait; buf.abort }","+        start.count_down","+","+        assert closer.join(1), \"#close remained blocked when raced with #abort\"","+        assert aborter.join(1), \"#abort remained blocked when raced with #close\"","+","+        chunks = []","+        reader = Thread.new { response.each { |chunk| chunks << chunk } }","+        assert reader.join(1), \"the aborted buffer did not terminate its reader\"","+        assert_empty chunks","+      ensure","+        closer&.kill","+        aborter&.kill","+        reader&.kill","+      end","+    end","+","+    def test_write_after_abort_does_not_block_on_the_terminator","+      ActionController::Live::Buffer.with(queue_size: 1) do","+        response = ActionController::Live::Response.new","+        response.request = ActionDispatch::Request.empty","+        buf = response.stream","+        buf.abort","+","+        writer = Thread.new do","+          buf.write \"late\"","+        rescue => error","+          error","+        end","+","+        assert writer.join(1), \"#write blocked after the buffer was aborted\"","+        assert_instance_of ActionController::Live::ClientDisconnected, writer.value","+      ensure","+        writer&.kill","+      end","+    end","   end"," end"," ",""],"additions":103,"deletions":0,"truncated":false}],"additions":120,"deletions":4,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-13T17:02:34.844180+00:00"}