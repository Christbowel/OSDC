rs',","+    spec: 'combined_handlers.cy.ts',","+    snapshot: false,","+    async onRun (exec) {","+      const { stdout } = await exec()","+","+      expectInOrder(stdout, [","+        'before:run handler 1',","+        'before:run handler 2',","+        'before:browser:launch handler 2 received preferences from handler 1: #1b1e2e',","+        'before:spec handler 1',","+        'before:spec handler 2',","+        'after:screenshot handler 2 received path from handler 1: screenshot-replacement.png',","+        'after:spec handler 1',","+        'after:spec handler 2',","+        'after:run handler 1',","+        'after:run handler 2',","+      ])","+    },","+  })","+","+  systemTests.it('does not run later handlers when an earlier one throws', {","+    browser: 'electron',","+    project: 'plugin-combined-handlers',","+    spec: 'combined_handlers.cy.ts',","+    configFile: 'cypress.config.throws.ts',","+    snapshot: false,","+    expectedExitCode: 1,","+    async onRun (exec) {","+      const { stdout } = await exec()","+","+      expect(stdout).to.contain('before:run handler 1 failed')","+      expect(stdout).not.to.contain('before:run handler 2')","+    },","+  })","+})",""],"additions":54,"deletions":0,"truncated":false}],"additions":440,"deletions":64,"truncated":false,"file_count":16},"error":null,"fetched_at":"2026-11-03T16:47:30.490273+00:00"}