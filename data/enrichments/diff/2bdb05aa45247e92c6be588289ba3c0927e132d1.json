{"id":"2bdb05aa45247e92c6be588289ba3c0927e132d1","axis":"silent","repo":"cypress-io/cypress","sha":"2bdb05aa45247e92c6be588289ba3c0927e132d1","parsed":{"files":[{"path":"cli/CHANGELOG.md","lines":["@@ -1,5 +1,5 @@"," <!-- See ../guides/writing-the-cypress-changelog.md for details on writing the changelog. -->","-## 16.2.2","+## 16.3.0"," "," **Performance:**"," ","@@ -7,6 +7,10 @@"," - The Cypress binary no longer includes a copy of TypeScript that it never used, since Cypress loads TypeScript from your project. This makes the download smaller and takes less disk space once installed. On Linux arm64, Cypress also starts faster, because it no longer tries to load TypeScript as it launches. Fixed in [#35184](https://github.com/cypress-io/cypress/pull/35184)."," - `cypress run` now spends less time finding the browsers installed on your machine before it starts the first spec, so runs start sooner. Fixed in [#35181](https://github.com/cypress-io/cypress/pull/35181)."," ","+**Features:**","+","+- Registering the same event more than once in [`setupNodeEvents`](https://on.cypress.io/plugins-guide) now runs every handler in registration order, instead of only the last one, for [`before:run`](https://on.cypress.io/before-run-api), [`after:run`](https://on.cypress.io/after-run-api), [`before:spec`](https://on.cypress.io/before-spec-api), [`after:spec`](https://on.cypress.io/after-spec-api), [`before:browser:launch`](https://on.cypress.io/browser-launch-api), and [`after:screenshot`](https://on.cypress.io/after-screenshot-api). `before:browser:launch` and `after:screenshot` handlers each receive the result of the handler before them. If a handler throws, later handlers do not run. If you re-registered one of these events to replace a plugin's handler, both now run; to keep only yours, pass the plugin an `on` that skips that event. Addresses [#5240](https://github.com/cypress-io/cypress/issues/5240), [#19809](https://github.com/cypress-io/cypress/issues/19809) and [#27524](https://github.com/cypress-io/cypress/issues/27524).","+"," **Bugfixes:**"," "," - Fixed an issue where a spec whose bundled file includes a large inline source map could crash the browser tab, leaving `cypress run` hanging with no error until it was killed. The crash could happen while the spec first loaded, or when it loaded again after its first [`cy.visit()`](https://on.cypress.io/visit) to another origin. Specs with inline source maps now also load faster and use less memory. Fixes [#35201](https://github.com/cypress-io/cypress/issues/35201)."],"additions":5,"deletions":1,"truncated":false},{"path":"packages/server/lib/browsers/utils.ts","lines":["@@ -2,6 +2,7 @@ import _ from 'lodash'"," import type { FoundBrowser } from '@packages/types'"," import * as errors from '../errors'"," import * as plugins from '../plugins'","+import { mergeLaunchOptions } from '../plugins/merge_plugin_results'"," import * as launcher from '@packages/launcher'"," import type { Automation } from '../automation'"," import type { Browser } from './types'","@@ -219,21 +220,7 @@ function extendLaunchOptionsFromPlugins (launchOptions, pluginConfigResult, opti","     errors.throwErr('UNEXPECTED_BEFORE_BROWSER_LAUNCH_PROPERTIES', unexpectedProperties, KNOWN_LAUNCH_OPTION_PROPERTIES)","   }"," ","-  _.forEach(launchOptions, (val, key) => {","-    const pluginResultValue = pluginConfigResult[key]","-","-    if (pluginResultValue) {","-      if (_.isPlainObject(val)) {","-        launchOptions[key] = _.extend({}, launchOptions[key], pluginResultValue)","-","-        return","-      }","-","-      launchOptions[key] = pluginResultValue","-","-      return","-    }","-  })","+  Object.assign(launchOptions, mergeLaunchOptions(launchOptions, pluginConfigResult))"," ","   return launchOptions"," }"],"additions":2,"deletions":15,"truncated":false},{"path":"packages/server/lib/plugins/child/combine_handlers.ts","lines":["@@ -0,0 +1,84 @@","+import _ from 'lodash'","+import { mergeLaunchOptions, mergeScreenshotDetails } from '../merge_plugin_results'","+import type { PluginEventHandler, RegisteredPluginHandler, TaskEventHandler } from './types'","+","+type CombineHandlers = (first: RegisteredPluginHandler, second: RegisteredPluginHandler) => RegisteredPluginHandler","+","+// The rule for applying one handler's result to the value it was given. It","+// returns undefined when the server would ignore that result.","+type MergeResult = (value: any, result: any) => Record<string, any> | undefined","+","+function assertFunctionHandler (handler: RegisteredPluginHandler): asserts handler is PluginEventHandler {","+  if (!_.isFunction(handler)) {","+    throw new Error('Unexpected: validateEvent should only allow function handlers for this event')","+  }","+}","+","+function assertTaskHandler (handler: RegisteredPluginHandler): asserts handler is TaskEventHandler {","+  if (_.isFunction(handler)) {","+    throw new Error('Unexpected: validateEvent should only allow an object handler for task')","+  }","+}","+","+const mergeTasks: CombineHandlers = (first, second) => {","+  assertTaskHandler(first)","+  assertTaskHandler(second)","+","+  const duplicates = _.intersection(_.keys(first), _.keys(second))","+","+  if (duplicates.length) {","+    require('@packages/errors').warning('DUPLICATE_TASK_KEY', duplicates)","+  }","+","+  return _.extend(first, second)","+}","+","+// For events whose handlers' return values the server ignores","+const runInSequence: CombineHandlers = (first, second) => {","+  assertFunctionHandler(first)","+  assertFunctionHandler(second)","+","+  return async (...args) => {","+    await first(...args)","+    await second(...args)","+  }","+}","+","+// Each handler gets its own copy, so like a single handler, only what it","+// returns is applied. When no handler returns anything the server uses, the","+// combined handler returns undefined so the server keeps its own value.","+const chainResults = (valueIndex: number, merge: MergeResult): CombineHandlers => {","+  return (first, second) => {","+    assertFunctionHandler(first)","+    assertFunctionHandler(second)","+","+    const invoke = (handler: PluginEventHandler, args: any[], value: any) => {","+      return handler(...Object.assign([...args], { [valueIndex]: _.cloneDeep(value) }))","+    }","+","+    return async (...args) => {","+      const value = args[valueIndex]","+      const firstValue = merge(value, await invoke(first, args, value))","+      const secondValue = merge(firstValue ?? value, await invoke(second, args, firstValue ?? value))","+","+      return secondValue ?? firstValue","+    }","+  }","+}","+","+const mergeLaunchOptionsResult: MergeResult = (launchOptions, result) => {","+  return result ? mergeLaunchOptions(launchOptions, result) : undefined","+}","+","+// Events not listed here keep only their last registered handler, since each","+// should have exactly one (such as file:preprocessor)","+export const combineHandlersByEvent: Record<string, CombineHandlers> = {","+  'task': mergeTasks,","+  'before:run': runInSequence,","+  'after:run': runInSequence,","+  'before:spec': runInSequence,","+  'after:spec': runInSequence,","+  'after:browser:launch': runInSequence,","+  'before:browser:launch': chainResults(1, mergeLaunchOptionsResult),","+  'after:screenshot': chainResults(0, mergeScreenshotDetails),","+}"],"additions":84,"deletions":0,"truncated":false},{"path":"packages/server/lib/plugins/child/run_plugins.ts","lines":["@@ -8,6 +8,7 @@ import { wrap as wrapPreprocessor } from './preprocessor'"," import { wrap as wrapDevServer } from './dev-server'"," import { typescript as resolveTypescript } from '../../util/resolve'"," import { wrapBefore as wrapBeforeBrowserLaunch } from './browser_launch'","+import { combineHandlersByEvent } from './combine_handlers'"," import { nonNodeRequires, serializeError, wrapChildPromise } from '../util'"," import { validateEvent } from './validate_event'"," import { processCallback as processCrossOriginCallback } from './cross_origin'","@@ -76,20 +77,18 @@ export class RunPlugins {","         return","       }"," ","-      if (event === 'task') {","-        const existingEventId = this.registeredEventsByName[event]","+      const combineHandlers = combineHandlersByEvent[event]","+      const existingEventId = this.registeredEventsByName[event]"," ","-        if (existingEventId !== undefined) {","-          handler = this.taskMerge(","-            this.registeredEventsById[existingEventId].handler as TaskEventHandler,","-            handler as TaskEventHandler,","-          )","+      if (combineHandlers && existingEventId !== undefined) {","+        this.registeredEventsById[existingEventId] = {","+          event,","+          handler: combineHandlers(this.registeredEventsById[existingEventId].handler, handler),","+        }"," ","-          this.registeredEventsById[existingEventId] = { event, handler }","-          debug('extend task events with id', existingEventId)","+        debug('combine %s handlers with id', event, existingEventId)"," ","-          return","-        }","+        return","       }"," ","       const eventId = this.eventIdCount++","@@ -203,16 +202,6 @@ export class RunPlugins {","     wrapChildPromise(this.ipc, invoke, ids)","   }"," ","-  taskMerge (target: TaskEventHandler, events: TaskEventHandler) {","-    const duplicates = _.intersection(_.keys(target), _.keys(events))","-","-    if (duplicates.length) {","-      require('@packages/errors').warning('DUPLICATE_TASK_KEY', duplicates)","-    }","-","-    return _.extend(target, events)","-  }","-","   taskExecute (ids: PluginInvokeIds, args: any[]) {","     const task = args[0]","     let arg = args[1]"],"additions":10,"deletions":21,"truncated":false},{"path":"packages/server/lib/plugins/child/types.ts","lines":["@@ -8,7 +8,7 @@ export interface PluginInvokeIds {","   invocationId: string"," }"," ","-type PluginEventHandler = (...args: any[]) => any","+export type PluginEventHandler = (...args: any[]) => any"," "," export type TaskEventHandler = Record<string, PluginEventHandler>"," "],"additions":1,"deletions":1,"truncated":false},{"path":"packages/server/lib/plugins/merge_plugin_results.ts","lines":["@@ -0,0 +1,30 @@","+import _ from 'lodash'","+","+// Shared by the server and the plugins child process, so handlers chained in","+// the child see the same values the server applies. Keep its imports to","+// lodash: the child runs under the user's Node, which can be older than the","+// Node that server modules are written for.","+","+// Object options such as `env` are extended so a handler can add one key","+// without restating the rest, and an empty value keeps the current option","+export const mergeLaunchOptions = (launchOptions: Record<string, any>, result: Record<string, any>) => {","+  const merged = { ...launchOptions }","+","+  _.forEach(result, (value, key) => {","+    if (!value) {","+      return","+    }","+","+    merged[key] = _.isPlainObject(launchOptions[key]) ? { ...launchOptions[key], ...value } : value","+  })","+","+  return merged","+}","+","+export const mergeScreenshotDetails = <T extends Record<string, any>>(details: T, updates: unknown): T | undefined => {","+  if (!_.isPlainObject(updates)) {","+    return undefined","+  }","+","+  return { ...details, ..._.pick(updates, 'size', 'dimensions', 'path') }","+}"],"additions":30,"deletions":0,"truncated":false},{"path":"packages/server/lib/screenshots.ts","lines":["@@ -7,6 +7,7 @@ import Jimp from 'jimp'"," import sizeOf from 'image-size'"," import colorString from 'color-string'"," import * as plugins from './plugins'","+import { mergeScreenshotDetails } from './plugins/merge_plugin_results'"," import { fs, getPath } from './util/fs'"," import type { Data, ScreenshotsFolder } from './util/fs'"," ","@@ -458,11 +459,7 @@ const screenshots = {"," ","     return plugins.execute('after:screenshot', details)","     .then((updates) => {","-      if (!_.isPlainObject(updates)) {","-        return details","-      }","-","-      return _.extend(details, _.pick(updates, 'size', 'dimensions', 'path'))","+      return mergeScreenshotDetails(details, updates) ?? details","     })","   },"," "],"additions":2,"deletions":5,"truncated":false},{"path":"packages/server/test/unit/plugins/child/run_plugins.spec.ts","lines":["@@ -143,6 +143,158 @@ describe('lib/plugins/child/run_plugins', () => {","         expect(requires).toBeInstanceOf(Array)","       })"," ","+      it.each(['before:run', 'after:run', 'before:spec', 'after:spec', 'after:browser:launch'])('combines every handler registered for %s into one registration', async (event) => {","+        const calls: string[] = []","+        const first = vi.fn(async (arg) => {","+          await Promise.resolve()","+          calls.push(`first:${arg}`)","+        })","+        const second = vi.fn((arg) => {","+          calls.push(`second:${arg}`)","+        })","+","+        await runPlugins.runSetupNodeEvents(config, (on) => {","+          on(event, first)","+          on(event, second)","+        })","+","+        const registrations = sentPayload('setupTestingType:reply').registrations.filter((registration) => registration.event === event)","+","+        expect(registrations).toHaveLength(1)","+","+        await runPlugins.invoke(registrations[0].eventId, ['details'])","+","+        expect(calls).toStrictEqual(['first:details', 'second:details'])","+      })","+","+      describe('combined before:browser:launch handlers', () => {","+        const browser = { name: 'chrome' }","+","+        const invokeBeforeBrowserLaunch = async (...handlers) => {","+          await runPlugins.runSetupNodeEvents(config, (on) => {","+            handlers.forEach((handler) => on('before:browser:launch', handler))","+          })","+","+          const registrations = sentPayload('setupTestingType:reply').registrations.filter((registration) => registration.event === 'before:browser:launch')","+","+          expect(registrations).toHaveLength(1)","+","+          return runPlugins.invoke(registrations[0].eventId, [browser, browserUtils.getDefaultLaunchOptions({ env: { BASE: 'base' } })])","+        }","+","+        it('passes each handler the launch options returned by the handlers before it', async () => {","+          const second = vi.fn((browser, launchOptions) => {","+            launchOptions.args.push('--second')","+","+            return launchOptions","+          })","+","+          const result = await invokeBeforeBrowserLaunch(","+            (browser, launchOptions) => {","+              launchOptions.args.push('--first')","+","+              return launchOptions","+            },","+            second,","+          )","+","+          expect(second).toHaveBeenCalledWith(browser, expect.objectContaining({ args: ['--first', '--second'] }))","+          expect(result.args).toStrictEqual(['--first', '--second'])","+        })","+","+        it('keeps the launch options a handler leaves out of a partial result', async () => {","+          const second = vi.fn(() => undefined)","+","+          const result = await invokeBeforeBrowserLaunch(","+            () => ({ env: { FIRST: 'first' } }),","+            second,","+          )","+","+          expect(second).toHaveBeenCalledWith(browser, expect.objectContaining({ args: [], env: { BASE: 'base', FIRST: 'first' } }))","+          expect(result).toMatchObject({ args: [], env: { BASE: 'base', FIRST: 'first' } })","+        })","+","+        it('does not apply launch options a handler changes without returning them', async () => {","+          const result = await invokeBeforeBrowserLaunch(","+            (browser, launchOptions) => {","+              launchOptions.args.push('--not-returned')","+            },","+            (browser, launchOptions) => {","+              return { env: { ...launchOptions.env, SECOND: 'second' } }","+            },","+          )","+","+          expect(result.args).toStrictEqual([])","+          expect(result.env).toStrictEqual({ BASE: 'base', SECOND: 'second' })","+        })","+","+        it('returns undefined when no handler returns launch options', async () => {","+          const result = await invokeBeforeBrowserLaunch(() => undefined, () => undefined, () => undefined)","+","+          expect(result).toBeUndefined()","+        })","+      })","+","+      describe('combined after:screenshot handlers', () => {","+        const details = { path: '/screenshots/original.png', size: 100, dimensions: { width: 10, height: 10 }, name: 'shot' }","+","+        const invokeAfterScreenshot = async (...handlers) => {","+          await runPlugins.runSetupNodeEvents(config, (on) => {","+            handlers.forEach((handler) => on('after:screenshot', handler))","+          })","+","+          const registrations = sentPayload('setupTestingType:reply').registrations.filter((registration) => registration.event === 'after:screenshot')","+","+          expect(registrations).toHaveLength(1)","+","+          return runPlugins.invoke(registrations[0].eventId, [details])","+        }","+","+        it('passes each handler the details as updated by the handlers before it', async () => {","+          const second = vi.fn((updated) => ({ path: updated.path.replace('.png', '-copy.png') }))","+","+          const result = await invokeAfterScreenshot(","+            () => ({ path: '/screenshots/renamed.png', size: 200 }),","+            second,","+          )","+","+          expect(second).toHaveBeenCalledWith({ ...details, path: '/screenshots/renamed.png', size: 200 })","+          expect(result).toStrictEqual({ ...details, path: '/screenshots/renamed-copy.png', size: 200 })","+        })","+","+        it('passes the next handler only the properties the server would apply', async () => {","+          const second = vi.fn(() => undefined)","+","+          const result = await invokeAfterScreenshot(","+            () => ({ size: 300, name: 'ignored' }),","+            second,","+          )","+","+          expect(second).toHaveBeenCalledWith({ ...details, size: 300 })","+          expect(result).toStrictEqual({ ...details, size: 300 })","+        })","+","+        it('returns undefined when no handler returns updated details', async () => {","+          const result = await invokeAfterScreenshot(() => undefined, () => 'not an object')","+","+          expect(result).toBeUndefined()","+        })","+      })","+","+      it('does not run later handlers when an earlier combined handler rejects', async () => {","+        const second = vi.fn()","+","+        await runPlugins.runSetupNodeEvents(config, (on) => {","+          on('before:run', () => Promise.reject(new Error('first failed')))","+          on('before:run', second)","+        })","+","+        const { eventId } = sentPayload('setupTestingType:reply').registrations.find((registration) => registration.event === 'before:run')","+","+        await expect(runPlugins.invoke(eventId, [])).rejects.toThrow('first failed')","+        expect(second).not.toHaveBeenCalled()","+      })","+","       it('sends error if setupNodeEvents function rejects the promise', async () => {","         const err = new Error('foo')","         const setupNodeEventsFn = vi.fn().mockRejectedValue(err)"],"additions":152,"deletions":0,"truncated":false},{"path":"system-tests/projects/plugin-after-screenshot/cypress/e2e/after_screenshot.cy.js","lines":["@@ -1,30 +1,36 @@","-it('cy.screenshot() - replacement', () => {","-  cy.screenshot('replace-me', { capture: 'runner' }, {","-    onAfterScreenshot (details) {","-      expect(details.path).to.include('screenshot-replacement.png')","-      expect(details.size).to.equal(1047)","+const screenshotDetails = (name) => {","+  let details"," ","-      expect(details.dimensions).to.eql({ width: 1, height: 1 })","+  return cy.screenshot(name, {","+    capture: 'runner',","+    onAfterScreenshot ($el, afterScreenshotDetails) {","+      details = afterScreenshotDetails","     },",