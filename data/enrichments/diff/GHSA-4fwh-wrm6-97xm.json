{"id":"GHSA-4fwh-wrm6-97xm","axis":"advisories","repo":"klever-io/klever-go","sha":"b8af922e749ec1fa7451b2c6e7c9f634d8603be2","parsed":{"files":[{"path":"common/facade/nodeFacade.go","lines":["@@ -361,6 +361,30 @@ func (nf *nodeFacade) WSConnectionAPIKey() string {"," \treturn nf.config.WSConnectionAPIKey"," }"," ","+// WSMaxConnections returns the node-wide cap on simultaneous live /subscribe","+// WebSocket connections (0 = unlimited).","+func (nf *nodeFacade) WSMaxConnections() uint32 {","+\treturn nf.wsAntifloodConfig.WebSocketConnections","+}","+","+// WSMaxConnectionsPerIP returns the per-source-IP cap on simultaneous live","+// /subscribe WebSocket connections (0 = unlimited).","+func (nf *nodeFacade) WSMaxConnectionsPerIP() uint32 {","+\treturn nf.wsAntifloodConfig.WebSocketConnectionsPerIP","+}","+","+// WSMaxAddressesPerSubscribe returns the per-call address cap for a /subscribe","+// request (0 = built-in default).","+func (nf *nodeFacade) WSMaxAddressesPerSubscribe() uint32 {","+\treturn nf.wsAntifloodConfig.WebSocketMaxAddressesPerSubscribe","+}","+","+// WSMaxAddressesPerClient returns the per-connection total address cap for","+// /subscribe (0 = built-in default).","+func (nf *nodeFacade) WSMaxAddressesPerClient() uint32 {","+\treturn nf.wsAntifloodConfig.WebSocketMaxAddressesPerClient","+}","+"," /***********","  *  Block","  ***********/"],"additions":24,"deletions":0,"truncated":false},{"path":"common/facade/nodeFacade_test.go","lines":["@@ -41,6 +41,24 @@ func createMockArgNodeFacade() facade.ArgNodeFacade {"," \t}"," }"," ","+func TestNodeFacade_WSLimitGetters(t *testing.T) {","+\tt.Parallel()","+","+\targs := createMockArgNodeFacade()","+\targs.WsAntifloodConfig.WebSocketConnections = 1234","+\targs.WsAntifloodConfig.WebSocketConnectionsPerIP = 56","+\targs.WsAntifloodConfig.WebSocketMaxAddressesPerSubscribe = 78","+\targs.WsAntifloodConfig.WebSocketMaxAddressesPerClient = 9012","+","+\tnf, err := facade.NewNodeFacade(args)","+\trequire.NoError(t, err)","+","+\trequire.Equal(t, uint32(1234), nf.WSMaxConnections())","+\trequire.Equal(t, uint32(56), nf.WSMaxConnectionsPerIP())","+\trequire.Equal(t, uint32(78), nf.WSMaxAddressesPerSubscribe())","+\trequire.Equal(t, uint32(9012), nf.WSMaxAddressesPerClient())","+}","+"," func TestNewNodeFacade(t *testing.T) {"," \tt.Parallel()"," "],"additions":18,"deletions":0,"truncated":false},{"path":"config/antiflood.go","lines":["@@ -42,6 +42,20 @@ type WebServerAntifloodConfig struct {"," \tSameSourceRequests           uint32                      `yaml:\"sameSourceRequests\"`"," \tSameSourceResetIntervalInSec uint32                      `yaml:\"sameSourceResetIntervalInSec\"`"," \tEndpointsThrottlers          []EndpointsThrottlersConfig `yaml:\"endpointsThrottlers\"`","+\t// WebSocketConnections caps simultaneous live /subscribe WebSocket connections","+\t// node-wide; the gin throttlers above do not bound live WS connections. 0 = unlimited.","+\tWebSocketConnections uint32 `yaml:\"webSocketConnections\"`","+\t// WebSocketConnectionsPerIP caps simultaneous live /subscribe connections from a","+\t// single source IP. Behind a reverse proxy all clients share the proxy IP, so size","+\t// this accordingly or set 0 to disable the per-IP cap. 0 = unlimited.","+\tWebSocketConnectionsPerIP uint32 `yaml:\"webSocketConnectionsPerIP\"`","+\t// WebSocketMaxAddressesPerSubscribe caps addresses accepted in one /subscribe call.","+\t// The inbound frame read limit is derived from this so a maximal subscribe always","+\t// fits. 0 = built-in default.","+\tWebSocketMaxAddressesPerSubscribe uint32 `yaml:\"webSocketMaxAddressesPerSubscribe\"`","+\t// WebSocketMaxAddressesPerClient caps the total addresses one connection may watch","+\t// across all of its subscribe calls. 0 = built-in default.","+\tWebSocketMaxAddressesPerClient uint32 `yaml:\"webSocketMaxAddressesPerClient\"`"," }"," "," // TopicMaxMessagesConfig will hold the maximum number of messages/sec per topic value"],"additions":14,"deletions":0,"truncated":false},{"path":"config/node/api.yaml","lines":["@@ -15,6 +15,10 @@ apiPackages:","         open: true","   subscribe:","     routes:","+      # /subscribe is a public WebSocket event feed. `open: true` keeps it enabled for","+      # development; set `secured: true` (in addition) to require Basic Auth on the","+      # handshake for public/mainnet deployments. Connection and message limits are","+      # enforced in code and tuned via webServer.* in config.yaml.","       - name: /subscribe","         open: true","   asset:"],"additions":4,"deletions":0,"truncated":false},{"path":"config/node/config.yaml","lines":["@@ -185,6 +185,20 @@ antiflood:","     sameSourceRequests: 10000","     # SameSourceResetIntervalInSec time frame between counter reset, in seconds","     sameSourceResetIntervalInSec: 1","+    # WebSocketConnections caps simultaneous live /subscribe WebSocket connections node-wide.","+    # The throttlers above release their slot at the HTTP->WS upgrade and so do not bound live","+    # WS connections. 0 = unlimited.","+    webSocketConnections: 4096","+    # WebSocketConnectionsPerIP caps simultaneous live /subscribe connections from a single","+    # source IP. Behind a reverse proxy every client shares the proxy IP, so raise this (or set","+    # 0 to disable) for proxied/public deployments. 0 = unlimited.","+    webSocketConnectionsPerIP: 1024","+    # WebSocketMaxAddressesPerSubscribe caps addresses accepted in one /subscribe call. The","+    # inbound frame read limit is derived from this so a maximal subscribe always fits. 0 = default.","+    webSocketMaxAddressesPerSubscribe: 10000","+    # WebSocketMaxAddressesPerClient caps the total addresses one connection may watch across all","+    # of its subscribe calls. 0 = default.","+    webSocketMaxAddressesPerClient: 50000","     # EndpointsThrottlers represents a map for maximum simultaneous go routines for an endpoint","     endpointsThrottlers:","       - endpoint: /transaction/:hash"],"additions":14,"deletions":0,"truncated":false},{"path":"network/api/api.go","lines":["@@ -46,6 +46,9 @@ var log = logger.GetOrCreate(\"api\")"," const ("," \tlogPackage = \"log\""," \tlogRoute   = \"/log\"","+","+\tsubscribePackage = \"subscribe\"","+\tsubscribeRoute   = \"/subscribe\""," )"," "," type validatorInput struct {","@@ -138,10 +141,29 @@ func RegisterRoutes(ctx context.Context, ws *gin.Engine, routesConfig config.API"," \t\tregisterLoggerWsRoute(ws, marshalizerForLogs, routesConfig)"," \t}"," ","-\tif routesConfig.IsRouteEnabled(\"subscribe\", \"/subscribe\") {","+\t// secured only attaches the auth handler; the route is registered on open. Warn on","+\t// the secured-but-not-open footgun so it does not read as \"auth-protected\" when it","+\t// is actually absent.","+\tif routesConfig.IsRouteSecured(subscribePackage, subscribeRoute) && !routesConfig.IsRouteEnabled(subscribePackage, subscribeRoute) {","+\t\tlog.Warn(\"subscribe route has secured:true but open:false; /subscribe will not be registered. Set open:true to enable it (secured then requires Basic Auth).\")","+\t}","+","+\tif routesConfig.IsRouteEnabled(subscribePackage, subscribeRoute) {"," \t\tvar postConnUrl, postConnApiKey string","+\t\tvar subscribeOpts wsocket.SubscribeOptions","+\t\tvar hubLimits clientSocket.Limits"," \t\tif ok {"," \t\t\tpostConnUrl, postConnApiKey = apiHandler.WSConnectionURL(), apiHandler.WSConnectionAPIKey()","+\t\t\tsubscribeOpts.MaxConnections = apiHandler.WSMaxConnections()","+\t\t\tsubscribeOpts.MaxConnectionsPerIP = apiHandler.WSMaxConnectionsPerIP()","+\t\t\thubLimits.MaxAddressesPerSubscribe = wsocket.ClampUint32ToInt(apiHandler.WSMaxAddressesPerSubscribe())","+\t\t\thubLimits.MaxAddressesPerClient = wsocket.ClampUint32ToInt(apiHandler.WSMaxAddressesPerClient())","+\t\t}","+\t\t// Honour `secured: true` for /subscribe. The route is registered directly on the","+\t\t// engine (not via the RouterWrapper), so the auth handler must be applied here or","+\t\t// the flag is silently ignored (GHSA-4fwh-wrm6-97xm).","+\t\tif routesConfig.IsRouteSecured(subscribePackage, subscribeRoute) {","+\t\t\tsubscribeOpts.AuthHandlers = []gin.HandlerFunc{authHandler}"," \t\t}"," "," \t\tvar wsFacade clientSocket.WSFacade","@@ -150,8 +172,8 @@ func RegisterRoutes(ctx context.Context, ws *gin.Engine, routesConfig config.API"," \t\t}"," "," \t\tindexer.UseEventQueue = true","-\t\thub := clientSocket.NewHub(postConnUrl, postConnApiKey, wsFacade)","-\t\twsocket.SubscribeTopics(ws, hub)","+\t\thub := clientSocket.NewHub(postConnUrl, postConnApiKey, wsFacade, hubLimits)","+\t\twsocket.SubscribeTopics(ws, hub, subscribeOpts)"," \t\tgo hub.StartServer(ctx)"," \t}"," }"],"additions":25,"deletions":3,"truncated":false},{"path":"network/api/api_test.go","lines":["@@ -0,0 +1,64 @@","+package api","+","+import (","+\t\"context\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"testing\"","+","+\t\"github.com/gin-gonic/gin\"","+\t\"github.com/klever-io/klever-go/config\"","+\t\"github.com/klever-io/klever-go/network/api/mock\"","+\t\"github.com/stretchr/testify/assert\"","+)","+","+func init() {","+\tgin.SetMode(gin.TestMode)","+}","+","+func subscribeRoutesConfig(open, secured bool) config.APIRoutesConfig {","+\treturn config.APIRoutesConfig{","+\t\tAPIPackages: map[string]config.APIPackageConfig{","+\t\t\t\"subscribe\": {Routes: []config.RouteConfig{{Name: \"/subscribe\", Open: open, Secured: secured}}},","+\t\t},","+\t\tCredentials: []config.Credential{{Username: \"u\", Password: \"p\"}},","+\t\tHasher:      config.TypeConfig{Type: \"sha256\"},","+\t}","+}","+","+// subscribeStatus registers the routes for cfg and returns the HTTP status of a plain","+// (non-WebSocket) GET /subscribe, which is enough to distinguish the three behaviors:","+//","+//\t404 — route not registered (open:false)","+//\t401 — auth enforced before the upgrade (secured:true) — the bug this PR fixes","+//\t400 — handler reached, no auth gate, fails the WS handshake (open, not secured)","+func subscribeStatus(t *testing.T, cfg config.APIRoutesConfig) int {","+\tt.Helper()","+\tws := gin.New()","+\tctx, cancel := context.WithCancel(context.Background())","+\tdefer cancel()","+\tRegisterRoutes(ctx, ws, cfg, &mock.Facade{})","+","+\tresp := httptest.NewRecorder()","+\tws.ServeHTTP(resp, httptest.NewRequest(http.MethodGet, \"/subscribe\", nil))","+\treturn resp.Code","+}","+","+// secured:true must enforce auth before the upgrade — an unauthenticated handshake is","+// rejected with 401. Previously secured was silently ignored (the route bypassed the","+// auth wrapper), so this guards the actual fix end-to-end through RegisterRoutes.","+func TestRegisterRoutes_SecuredRejectsUnauthenticated(t *testing.T) {","+\tassert.Equal(t, http.StatusUnauthorized, subscribeStatus(t, subscribeRoutesConfig(true, true)))","+}","+","+// open:true, secured:false — no auth gate; the plain GET reaches the handler and fails","+// the WS upgrade (400). Proves the route is live and NOT auth-gated (would be 401) and","+// is registered (would be 404).","+func TestRegisterRoutes_OpenNotSecuredReachesHandler(t *testing.T) {","+\tassert.Equal(t, http.StatusBadRequest, subscribeStatus(t, subscribeRoutesConfig(true, false)))","+}","+","+// open:false — the route is not registered at all (404), even with secured:true.","+func TestRegisterRoutes_NotOpenNotRegistered(t *testing.T) {","+\tassert.Equal(t, http.StatusNotFound, subscribeStatus(t, subscribeRoutesConfig(false, true)))","+}"],"additions":64,"deletions":0,"truncated":false},{"path":"network/api/interface.go","lines":["@@ -15,5 +15,9 @@ type MainAPIHandler interface {"," \tPprofEnabled() bool"," \tWSConnectionURL() string"," \tWSConnectionAPIKey() string","+\tWSMaxConnections() uint32","+\tWSMaxConnectionsPerIP() uint32","+\tWSMaxAddressesPerSubscribe() uint32","+\tWSMaxAddressesPerClient() uint32"," \tIsInterfaceNil() bool"," }"],"additions":4,"deletions":0,"truncated":false},{"path":"network/api/mock/facade.go","lines":["@@ -93,6 +93,26 @@ func (f *Facade) WSConnectionAPIKey() string {"," \treturn \"\""," }"," ","+// WSMaxConnections -","+func (f *Facade) WSMaxConnections() uint32 {","+\treturn 0","+}","+","+// WSMaxConnectionsPerIP -","+func (f *Facade) WSMaxConnectionsPerIP() uint32 {","+\treturn 0","+}","+","+// WSMaxAddressesPerSubscribe -","+func (f *Facade) WSMaxAddressesPerSubscribe() uint32 {","+\treturn 0","+}","+","+// WSMaxAddressesPerClient -","+func (f *Facade) WSMaxAddressesPerClient() uint32 {","+\treturn 0","+}","+"," // TpsBenchmark is the mock implementation for retreiving the TpsBenchmark"," func (f *Facade) TpsBenchmark() *statistics.TpsBenchmark {"," \tif f.TpsBenchmarkHandler != nil {"],"additions":20,"deletions":0,"truncated":false},{"path":"network/api/websocket/connlimiter.go","lines":["@@ -0,0 +1,76 @@","+package websocket","+","+import (","+\t\"math\"","+\t\"sync\"","+)","+","+// connLimiter caps the number of simultaneous live /subscribe WebSocket connections,","+// both node-wide and per source IP. The gin global throttler cannot do this: it","+// releases its slot at the HTTP->WS upgrade, so live connections are uncounted","+// (GHSA-4fwh-wrm6-97xm, GAP#3). A slot is acquired before the upgrade and released","+// exactly once when the connection is torn down.","+//","+// A zero maximum means \"unlimited\" for that dimension. Per-IP must be tunable to 0","+// because behind a reverse proxy every client shares the proxy's source IP.","+type connLimiter struct {","+\tmu        sync.Mutex","+\tglobal    int","+\tmaxGlobal int","+\tperIP     map[string]int","+\tmaxPerIP  int","+}","+","+func newConnLimiter(maxGlobal, maxPerIP uint32) *connLimiter {","+\treturn &connLimiter{","+\t\tmaxGlobal: ClampUint32ToInt(maxGlobal),","+\t\tmaxPerIP:  ClampUint32ToInt(maxPerIP),","+\t\tperIP:     make(map[string]int),","+\t}","+}","+","+// ClampUint32ToInt converts a uint32 config value to int without the negative wrap a","+// direct conversion would cause on 32-bit platforms. A wrapped-negative value would","+// silently drop the operator's configured value — disabling a connection cap, or falling","+// back to a default address cap — instead of honoring the (large) value they set.","+func ClampUint32ToInt(v uint32) int {","+\tif uint64(v) > uint64(math.MaxInt) {","+\t\treturn math.MaxInt","+\t}","+\treturn int(v)","+}","+","+// acquire reserves a connection slot for ip. It returns an idempotent release func","+// and true on success, or nil and false when a cap is reached.","+func (l *connLimiter) acquire(ip string) (func(), bool) {","+\tl.mu.Lock()","+\tdefer l.mu.Unlock()","+","+\tif l.maxGlobal > 0 && l.global >= l.maxGlobal {","+\t\treturn nil, false","+\t}","+\tif l.maxPerIP > 0 && l.perIP[ip] >= l.maxPerIP {","+\t\treturn nil, false","+\t}","+","+\tl.global++","+\tif l.maxPerIP > 0 {","+\t\tl.perIP[ip]++","+\t}","+","+\tvar once sync.Once","+\treturn func() {","+\t\tonce.Do(func() {","+\t\t\tl.mu.Lock()","+\t\t\tdefer l.mu.Unlock()","+\t\t\tl.global--","+\t\t\tif l.maxPerIP > 0 {","+\t\t\t\tif l.perIP[ip] <= 1 {","+\t\t\t\t\tdelete(l.perIP, ip)","+\t\t\t\t} else {","+\t\t\t\t\tl.perIP[ip]--","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}, true","+}"],"additions":76,"deletions":0,"truncated":false},{"path":"network/api/websocket/hardening_test.go","lines":["@@ -0,0 +1,190 @@","+package websocket_test","+","+import (","+\t\"context\"","+\t\"encoding/base64\"","+\t\"net\"","+\t\"net/http\"","+\t\"strings\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/gin-gonic/gin\"","+\t\"github.com/gorilla/websocket\"","+\twsocket \"github.com/klever-io/klever-go/network/api/websocket\"","+\tsocket \"github.com/klever-io/klever-go/websocket\"","+\t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func startTestServerOpts(t *testing.T, hub *socket.SocketHub, opts wsocket.SubscribeOptions) (string, func()) {","+\tt.Helper()","+\tgin.SetMode(gin.TestMode)","+\tws := gin.New()","+\twsocket.SubscribeTopics(ws, hub, opts)","+","+\tlistener, err := net.Listen(\"tcp\", \"127.0.0.1:0\")","+\trequire.NoError(t, err)","+","+\tsrv := &http.Server{Handler: ws, ReadHeaderTimeout: time.Second}","+\tgo func() { _ = srv.Serve(listener) }()","+","+\treturn listener.Addr().String(), func() {","+\t\tctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)","+\t\tdefer cancel()","+\t\t_ = srv.Shutdown(ctx)","+\t}","+}","+","+// TestSubscribe_ReadLimit_RejectsOversizedFrame confirms GAP#2 is closed: a single","+// frame larger than MaxMessageSize is rejected with WebSocket close 1009 instead of","+// being buffered whole.","+func TestSubscribe_ReadLimit_RejectsOversizedFrame(t *testing.T) {","+\thub := socket.NewHub(\"\", \"\", nil)","+\taddr, cleanup := startTestServerOpts(t, hub, wsocket.SubscribeOptions{})","+\tdefer cleanup()","+","+\tconn, _, err := websocket.DefaultDialer.Dial(\"ws://\"+addr+\"/subscribe\", nil)","+\trequire.NoError(t, err)","+\tdefer conn.Close()","+","+\t// A valid-JSON subscribe frame whose address string pushes the message past the","+\t// read limit, so the decoder keeps reading until SetReadLimit fires (a non-JSON","+\t// blob would fail to parse on the first byte, before the limit triggers).","+\toversized := []byte(`{\"subscribed_types\":[\"accounts\"],\"addresses\":[\"` +","+\t\tstrings.Repeat(\"A\", int(hub.MaxMessageSize())) + `\"]}`)","+","+\t// Write from a goroutine and ignore its error: the server stops reading and hard-","+\t// closes at the limit, which can reset the client mid-write. The security property","+\t// is that the frame is rejected, not buffered whole.","+\tgo func() { _ = conn.WriteMessage(websocket.TextMessage, oversized) }()","+","+\tconn.SetReadDeadline(time.Now().Add(3 * time.Second))","+\t_, _, err = conn.ReadMessage()","+\trequire.Error(t, err, \"oversized frame must terminate the connection, not be accepted\")","+\tif ce, ok := err.(*websocket.CloseError); ok {","+\t\tassert.Equal(t, websocket.CloseMessageTooBig, ce.Code, \"clean close must be 1009 (message too big)\")","+\t}","+}","+","+func TestSubscribe_RejectsTooManyAddresses(t *testing.T) {","+\thub := socket.NewHub(\"\", \"\", nil, socket.Limits{MaxAddressesPerSubscribe: 2})","+\taddr, cleanup := startTestServerOpts(t, hub, wsocket.SubscribeOptions{})","+\tdefer cleanup()","+","+\tconn, _, err := websocket.DefaultDialer.Dial(\"ws://\"+addr+\"/subscribe\", nil)","+\trequire.NoError(t, err)","+\tdefer conn.Close()","+","+\trequire.NoError(t, conn.WriteJSON(map[string]interface{}{","+\t\t\"subscribed_types\": []string{\"accounts\"},","+\t\t\"addresses\":        []string{\"a\", \"b\", \"c\"}, // > per-subscribe cap of 2","+\t}))","+","+\tconn.SetReadDeadline(time.Now().Add(2 * time.Second))","+\tvar resp map[string]string","+\trequire.NoError(t, conn.ReadJSON(&resp))","+\tassert.Contains(t, resp[\"error\"], \"too many addresses\")","+}","+","+func TestSubscribe_GlobalConnectionCap(t *testing.T) {","+\thub := socket.NewHub(\"\", \"\", nil)","+\taddr, cleanup := startTestServerOpts(t, hub, wsocket.SubscribeOptions{MaxConnections: 2})","+\tdefer cleanup()","+","+\tvar conns []*websocket.Conn","+\tdefer func() {","+\t\tfor _, c := range conns {","+\t\t\t_ = c.Close()","+\t\t}","+\t}()","+","+\tfor i := 0; i < 2; i++ {","+\t\tc, _, err := websocket.DefaultDialer.Dial(\"ws://\"+addr+\"/subscribe\", nil)","+\t\trequire.NoErrorf(t, err, \"connection %d within the cap should be accepted\", i)","+\t\tconns = append(conns, c)","+\t}","+","+\t_, resp, err := websocket.DefaultDialer.Dial(\"ws://\"+addr+\"/subscribe\", nil)","+\trequire.Error(t, err, \"connection beyond the global cap must be rejected\")","+\trequire.NotNil(t, resp)","+\tassert.Equal(t, http.StatusServiceUnavailable, resp.StatusCode)","+}","+","+func TestSubscribe_PerIPConnectionCap(t *testing.T) {","+\thub := socket.NewHub(\"\", \"\", nil)","+\taddr, cleanup := startTestServerOpts(t, hub, wsocket.SubscribeOptions{MaxConnectionsPerIP: 2})","+\tdefer cleanup()","+","+\tvar conns []*websocket.Conn","+\tdefer func() {","+\t\tfor _, c := range conns {","+\t\t\t_ = c.Close()","+\t\t}","+\t}()","+","+\tfor i := 0; i < 2; i++ {","+\t\tc, _, err := websocket.DefaultDialer.Dial(\"ws://\"+addr+\"/subscribe\", nil)","+\t\trequire.NoError(t, err)","+\t\tconns = append(conns, c)","+\t}","+","+\t_, resp, err := websocket.DefaultDialer.Dial(\"ws://\"+addr+\"/subscribe\", nil)","+\trequire.Error(t, err, \"connection beyond the per-IP cap must be rejected\")","+\trequire.NotNil(t, resp)","+\tassert.Equal(t, http.StatusServiceUnavailable, resp.StatusCode)","+}","+","+func TestSubscribe_ConnectionCap_ReleasedOnClose(t *testing.T) {","+\thub := socket.NewHub(\"\", \"\", nil)","+\taddr, cleanup := startTestServerOpts(t, hub, wsocket.SubscribeOptions{MaxConnections: 1})","+\tdefer cleanup()","+","+\tc1, _, err := websocket.DefaultDialer.Dial(\"ws://\"+addr+\"/subscribe\", nil)","+\trequire.NoError(t, err)","+","+\t// Cap reached.","+\t_, resp, err := websocket.DefaultDialer.Dial(\"ws://\"+addr+\"/subscribe\", nil)","+\trequire.Error(t, err)","+\trequire.Equal(t, http.StatusServiceUnavailable, resp.StatusCode)","+","+\t// Close the first connection; the slot must free up.","+\t_ = c1.Close()","+\trequire.Eventually(t, func() bool {","+\t\tc, _, derr := websocket.DefaultDialer.Dial(\"ws://\"+addr+\"/subscribe\", nil)","+\t\tif derr != nil {","+\t\t\treturn false","+\t\t}","+\t\t_ = c.Close()","+\t\treturn true","+\t}, 3*time.Second, 50*time.Millisecond, \"slot must be released after the connection closes\")","+}","+","+// TestSubscribe_Secured confirms the AuthHandlers wiring runs before the WebSocket","+// upgrade, so `secured: true` is honoured instead of silently ignored.","+func TestSubscribe_Secured(t *testing.T) {","+\tauth := func(c *gin.Context) {","+\t\tuser, pass, ok := c.Request.BasicAuth()","+\t\tif !ok || user != \"u\" || pass != \"p\" {","+\t\t\tc.AbortWithStatus(http.StatusUnauthorized)","+\t\t\treturn","+\t\t}","+\t\tc.Next()","+\t}","+","+\thub := socket.NewHub(\"\", \"\", nil)","+\taddr, cleanup := startTestServerOpts(t, hub, wsocket.SubscribeOptions{AuthHandlers: []gin.HandlerFunc{auth}})","+\tdefer cleanup()","+","+\t_, resp, err := websocket.DefaultDialer.Dial(\"ws://\"+addr+\"/subscribe\", nil)","+\trequire.Error(t, err, \"handshake without auth must be rejected\")","+\trequire.NotNil(t, resp)","+\tassert.Equal(t, http.StatusUnauthorized, resp.StatusCode)","+","+\thdr := http.Header{}","+\thdr.Set(\"Authorization\", \"Basic \"+base64.StdEncoding.EncodeToString([]byte(\"u:p\")))","+\tconn, resp2, err := websocket.DefaultDialer.Dial(\"ws://\"+addr+\"/subscribe\", hdr)","+\trequire.NoError(t, err, \"handshake with valid auth must be accepted\")","+\trequire.Equal(t, http.StatusSwitchingProtocols, resp2.StatusCode)","+\t_ = conn.Close()","+}"],"additions":190,"deletions":0,"truncated":false},{"path":"network/api/websocket/routes.go","lines":["@@ -2,6 +2,7 @@ package websocket"," "," import ("," \t\"fmt\"","+\t\"net\""," \t\"net/http\""," \t\"time\""," ","@@ -20,6 +21,8 @@ const ("," )"," "," var upgrader = gorilla.Upgrader{","+\t// Origin isn't enforced here by design: the node runs headless behind an operator proxy","+\t// that owns origin/CORS policy, and /subscribe carries no ambient credentials (KLC-2450)."," \tCheckOrigin: func(r *http.Request) bool {"," \t\treturn true"," \t},","@@ -30,23 +33,68 @@ type subscribeRequest struct {"," \tTypes     []string `json:\"subscribed_types\"`"," }"," ","-func SubscribeTopics(ws *gin.Engine, hub *websocket.SocketHub) {","-\tws.GET(\"/subscribe\", func(c *gin.Context) {","-\t\thandleSubscribe(c, hub)","+// SubscribeOptions configures the hardening applied to the /subscribe route.","+type SubscribeOptions struct {","+\t// MaxConnections caps simultaneous live connections node-wide (0 = unlimited).","+\tMaxConnections uint32","+\t// MaxConnectionsPerIP caps simultaneous live connections per source IP (0 = unlimited).","+\