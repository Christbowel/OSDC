{"id":"6b2deb0f2f5cbba29948aa925997b53f669cf347","axis":"silent","repo":"strapi/strapi","sha":"6b2deb0f2f5cbba29948aa925997b53f669cf347","parsed":{"files":[{"path":"packages/core/upload/admin/src/components/AssetPickerDialog/AssetPickerDialog.tsx","lines":["@@ -0,0 +1,506 @@","+import {","+  createContext,","+  useCallback,","+  useContext,","+  useMemo,","+  useRef,","+  useState,","+  type ReactNode,","+} from 'react';","+","+import { Page, usePersistentState } from '@strapi/admin/strapi-admin';","+import { Badge, Box, Button, Flex, Loader, Modal, Tabs, Typography } from '@strapi/design-system';","+import { useIntl } from 'react-intl';","+import { styled } from 'styled-components';","+","+import { useMediaLibraryPermissions } from '../../hooks/useMediaLibraryPermissions';","+import { AssetsGrid } from '../../pages/Assets/components/AssetsGrid';","+import { AssetsSearchInput } from '../../pages/Assets/components/AssetsSearchInput';","+import { AssetsView } from '../../pages/Assets/components/AssetsView';","+import { FilterBadges } from '../../pages/Assets/components/FilterBadges';","+import { FilterMenu } from '../../pages/Assets/components/FilterMenu';","+import { SortMenu } from '../../pages/Assets/components/SortMenu';","+import { ViewToggle } from '../../pages/Assets/components/ViewToggle';","+import { localStorageKeys, viewOptions } from '../../pages/Assets/constants';","+import { useAssetSelection } from '../../pages/Assets/hooks/useAssetSelection';","+import { useAssetsList } from '../../pages/Assets/hooks/useAssetsList';","+import { ListQueryStateProvider } from '../../pages/Assets/hooks/useListQueryParams';","+import { ListSettingsProvider } from '../../pages/Assets/hooks/useListSettings';","+import { assetKey } from '../../pages/Assets/utils/selection';","+import { type MediaAllowedTypes } from '../../utils/isAllowedAssetType';","+import { buildItemLocations } from '../../utils/itemLocations';","+import { getTranslationKey } from '../../utils/translations';","+","+import { FolderBreadcrumbs } from './FolderBreadcrumbs';","+import { isSameSelection } from './pickerSelection';","+import { PickerSelectionProvider, usePickerSelection } from './PickerSelectionProvider';","+import { SortableSelection } from './SortableSelection';","+","+import type { File } from '../../../../shared/contracts/files';","+","+// Fixed height (design: 720 × 680) so the modal doesn't grow and shrink as the","+// list loads, filters empty it, or tabs switch.","+const StyledModalContent = styled(Modal.Content)`","+  max-width: 72rem;","+  height: min(68rem, 90vh);","+`;","+","+const TabsRoot = styled(Tabs.Root)`","+  display: flex;","+  flex: 1;","+  flex-direction: column;","+  min-height: 0;","+`;","+","+// Full-width divider under the tabs. Inset so it paints beneath the triggers,","+// letting the active tab's own underline sit on top of it.","+const TabsList = styled(Tabs.List)`","+  box-shadow: inset 0 -1px 0 0 ${({ theme }) => theme.colors.neutral150};","+`;","+","+// Radix keeps the inactive panel mounted with `hidden`; `display: flex` would","+// override it and the empty panel would take half the height.","+const TabPanel = styled(Tabs.Content)`","+  display: flex;","+  flex: 1;","+  flex-direction: column;","+  min-height: 0;","+","+  &[hidden] {","+    display: none;","+  }","+`;","+","+// The DS body is a scroll area sized `height: 100%`, which does not resolve","+// inside the tab panel's flex column; take the remaining space instead.","+//","+// Its side padding also moves from the scroll area onto the viewport inside","+// it: the viewport clips at its padding edge, so anything reaching past the","+// content edge (the breadcrumbs pull their first crumb's highlight 8px left,","+// card focus rings) stays visible instead of being cut off.","+//","+// No top padding: it would scroll away with the content, leaving the list","+// flush against whatever sits above. The gap belongs to that fixed element.","+const ScrollingBody = styled(Modal.Body)`","+  flex: 1;","+  min-height: 0;","+  height: auto;","+  padding-inline: 0;","+","+  && > [data-radix-scroll-area-viewport] {","+    margin: 0;","+    padding-inline: ${({ theme }) => theme.spaces[7]};","+    padding-block-start: 0;","+  }","+","+  /* The DS body pads every direct child div, meant for the viewport. The","+     scrollbar is one too, and 2px of inline padding on each side of a 4px","+     track leaves the thumb no width at all. Restore the DS scrollbar's own","+     spacing. */","+  && > [data-orientation] {","+    padding: 0;","+    margin: ${({ theme }) => theme.spaces[1]};","+  }","+`;","+","+// The DS footer is `flex: 1`, which assumes a content-sized modal. With a fixed","+// height it would absorb all the free space.","+const Footer = styled(Modal.Footer)`","+  flex: 0 0 auto;","+`;","+","+/* -------------------------------------------------------------------------------------------------","+ * Shared","+ * -----------------------------------------------------------------------------------------------*/","+","+type AssetsList = ReturnType<typeof useAssetsList>;","+","+// Both tabs share these; the Selected tab only drops the section headings.","+const PICKER_LIST_SETTINGS = {","+  showItemActions: false,","+  // Three tiles per row in the 672px content width.","+  gridMinTileWidth: '200px',","+} as const;","+","+/** In the picker a plain click on an asset picks it (or un-picks it). */","+const useToggleAsset = () => {","+  const { toggle } = useAssetSelection();","+","+  return useCallback((assetId: number) => toggle(assetKey(assetId)), [toggle]);","+};","+","+/* -------------------------------------------------------------------------------------------------","+ * BrowseTab","+ * -----------------------------------------------------------------------------------------------*/","+","+interface BrowseTabProps {","+  list: AssetsList;","+}","+","+const BrowseTab = ({ list }: BrowseTabProps) => {","+  const {","+    currentFolderId,","+    navigateToFolderId,","+    searchQuery,","+    isSearching,","+    clearSearch,","+    listSort,","+    listFilters,","+    assets,","+    subscribers,","+    pagination,","+    isLoadingAssets,","+    isFetchingMore,","+    hasNextPage,","+    fetchNextPage,","+    assetsError,","+    folders,","+    isLoadingFolders,","+  } = list;","+  const toggleAsset = useToggleAsset();","+  // Shares the Media Library page's key: a user who prefers the table there","+  // gets it here too.","+  const [view, setView] = usePersistentState(localStorageKeys.view, viewOptions.GRID);","+  const isGridView = view === viewOptions.GRID;","+","+  const itemLocations = useMemo(() => buildItemLocations(assets, folders), [assets, folders]);","+","+  return (","+    <>","+      <Box paddingLeft={7} paddingRight={7} paddingTop={6} paddingBottom={6}>","+        <Flex justifyContent=\"space-between\" gap={2} wrap=\"wrap\">","+          <Flex gap={2}>","+            <FilterMenu listFilters={listFilters} />","+            <AssetsSearchInput collapsible />","+          </Flex>","+          <Flex gap={2}>","+            <SortMenu sort={listSort} showFoldersGroup={!isGridView} />","+            <ViewToggle view={view} onChange={setView} iconsOnly />","+          </Flex>","+        </Flex>","+        <FilterBadges listFilters={listFilters} />","+        {/* In the fixed header with the toolbar, so the way back up stays in","+            reach however far the list is scrolled. Search results are global,","+            so a folder trail would be misleading there. */}","+        {currentFolderId !== null && !isSearching && (","+          <Box paddingTop={2}>","+            <FolderBreadcrumbs","+              currentFolderId={currentFolderId}","+              onSelectFolder={navigateToFolderId}","+            />","+          </Box>","+        )}","+      </Box>","+      <ScrollingBody>","+        {/* Renders nothing — keeps every loaded page's query subscribed. */}","+        {subscribers}","+        <AssetsView","+          view={view}","+          folders={folders}","+          isLoadingFolders={isLoadingFolders}","+          assets={assets}","+          assetsTotal={pagination?.total}","+          isLoadingAssets={isLoadingAssets}","+          isFetchingMore={isFetchingMore}","+          hasNextPage={hasNextPage}","+          fetchNextPage={fetchNextPage}","+          error={assetsError}","+          locations={itemLocations}","+          searchQuery={searchQuery}","+          assetsSort={listSort.assetsSort}","+          foldersPosition={listSort.foldersPosition}","+          hasActiveFilters={listFilters.filters.length > 0}","+          onClearFilters={listFilters.clearFilters}","+          onAssetItemClick={toggleAsset}","+          // Uploading from the picker is out of scope; the empty state hides its CTA.","+          onAddAssets={() => {}}","+          canAddAssets={false}","+          onClearSearch={clearSearch}","+        />","+      </ScrollingBody>","+    </>","+  );","+};","+","+/* -------------------------------------------------------------------------------------------------","+ * SelectedTab","+ * -----------------------------------------------------------------------------------------------*/","+","+// Always a grid, whatever view Browse uses: the selection is short, and its","+// order (which reordering changes) reads best as tiles.","+interface SelectedTabProps {","+  onReorderingChange: (reordering: boolean) => void;","+}","+","+const SelectedTab = ({ onReorderingChange }: SelectedTabProps) => {","+  const { formatMessage } = useIntl();","+  const { selection } = usePickerSelection();","+  const toggleAsset = useToggleAsset();","+","+  return (","+    <ScrollingBody>","+      {/* No toolbar above this tab, so the gap under the tabs lives here. */}","+      <Box paddingTop={6}>","+        {selection.length === 0 ? (","+          <Typography textColor=\"neutral600\">","+            {formatMessage({","+              id: getTranslationKey('asset-picker.selected.empty'),","+              defaultMessage: 'No asset selected yet.',","+            })}","+          </Typography>","+        ) : (","+          <ListSettingsProvider {...PICKER_LIST_SETTINGS}>","+            {/* The order here is the order the field will hold. */}","+            <SortableSelection onReorderingChange={onReorderingChange}>","+              <AssetsGrid assets={selection} onAssetItemClick={toggleAsset} />","+            </SortableSelection>","+          </ListSettingsProvider>","+        )}","+      </Box>","+    </ScrollingBody>","+  );","+};","+","+/* -------------------------------------------------------------------------------------------------","+ * PickerContent","+ * -----------------------------------------------------------------------------------------------*/","+","+type PickerTab = 'browse' | 'selected';","+","+interface PickerContentProps {","+  title: string;","+  initialSelection: File[];","+  onClose: () => void;","+  onConfirm: (files: File[]) => void;","+  onReorderingChange: (reordering: boolean) => void;","+}","+","+const PickerContent = ({","+  title,","+  initialSelection,","+  onClose,","+  onConfirm,","+  onReorderingChange,","+}: PickerContentProps) => {","+  const { formatMessage } = useIntl();","+  const { selection } = usePickerSelection();","+  // Always Browse, even when the field already holds assets: the picker is","+  // opened to add some. What it holds is one tab away, and on the field itself.","+  const [activeTab, setActiveTab] = useState<PickerTab>('browse');","+  const list = useAssetsListContext();","+","+  return (","+    <>","+      <Modal.Header>","+        <Modal.Title>{title}</Modal.Title>","+      </Modal.Header>","+      <TabsRoot","+        variant=\"simple\"","+        value={activeTab}","+        onValueChange={(value) => setActiveTab(value as PickerTab)}","+      >","+        <Box paddingLeft={7} paddingRight={7} paddingTop={2}>","+          <TabsList","+            aria-label={formatMessage({","+              id: getTranslationKey('asset-picker.tabs.label'),","+              defaultMessage: 'Asset picker tabs',","+            })}","+          >","+            <Tabs.Trigger value=\"browse\">","+              {formatMessage({","+                id: getTranslationKey('asset-picker.tabs.browse'),","+                defaultMessage: 'Browse assets',","+              })}","+            </Tabs.Trigger>","+            <Tabs.Trigger value=\"selected\">","+              {formatMessage({","+                id: getTranslationKey('asset-picker.tabs.selected'),","+                defaultMessage: 'Selected assets',","+              })}","+              <Badge marginLeft={2}>{selection.length}</Badge>","+            </Tabs.Trigger>","+          </TabsList>","+        </Box>","+        {/* Radix makes a panel a Tab stop, meant for panels with nothing focusable","+            inside. These hold controls, so focus goes straight to them. */}","+        <TabPanel value=\"browse\" tabIndex={-1}>","+          <BrowseTab list={list} />","+        </TabPanel>","+        <TabPanel value=\"selected\" tabIndex={selection.length > 0 ? -1 : undefined}>","+          <SelectedTab onReorderingChange={onReorderingChange} />","+        </TabPanel>","+      </TabsRoot>","+      <Footer>","+        <Button variant=\"tertiary\" onClick={onClose}>","+          {formatMessage({ id: 'app.components.Button.cancel', defaultMessage: 'Cancel' })}","+        </Button>","+        <Button","+          disabled={isSameSelection(selection, initialSelection)}","+          onClick={() => onConfirm(selection)}","+        >","+          {formatMessage({","+            id: getTranslationKey('asset-picker.confirm'),","+            defaultMessage: 'Confirm',","+          })}","+        </Button>","+      </Footer>","+    </>","+  );","+};","+","+/* -------------------------------------------------------------------------------------------------","+ * AssetPickerDialog","+ * -----------------------------------------------------------------------------------------------*/","+","+// The list is read above the selection provider (which resolves picked keys","+// against the loaded assets) and below it (the Browse tab renders it). One","+// instance, shared, so tab switches keep the pages already loaded.","+const AssetsListContext = createContext<AssetsList | null>(null);","+","+const useAssetsListContext = () => {","+  const context = useContext(AssetsListContext);","+","+  if (!context) {","+    throw new Error('useAssetsListContext must be used within the asset picker');","+  }","+","+  return context;","+};","+","+interface PickerSelectionRootProps {","+  children: ReactNode;","+  initialSelection: File[];","+  multiple: boolean;","+  allowedTypes?: MediaAllowedTypes | null;","+}","+","+const PickerSelectionRoot = ({","+  children,","+  initialSelection,","+  multiple,","+  allowedTypes,","+}: PickerSelectionRootProps) => {","+  const list = useAssetsList();","+","+  return (","+    <AssetsListContext.Provider value={list}>","+      <PickerSelectionProvider","+        initialSelection={initialSelection}","+        multiple={multiple}","+        allowedTypes={allowedTypes}","+        knownFiles={list.assets}","+      >","+        {children}","+      </PickerSelectionProvider>","+    </AssetsListContext.Provider>","+  );","+};","+","+export interface AssetPickerDialogProps {","+  open: boolean;","+  onClose: () => void;","+  title: string;","+  /** What the field holds now; the picker starts with it selected. */","+  initialSelection?: File[];","+  multiple?: boolean;","+  allowedTypes?: MediaAllowedTypes | null;","+  /** The confirmed selection, in order. Always an array, even for a single field. */","+  onConfirm: (files: File[]) => void;","+}","+","+const NO_FILES: File[] = [];","+","+interface ReadAccessGateProps {","+  children: ReactNode;","+  title: string;","+  onClose: () => void;","+}","+","+/**","+ * Picking only needs read access to the library. Without it the picker says so","+ * and mounts nothing that would fetch assets or folders.","+ */","+const ReadAccessGate = ({ children, title, onClose }: ReadAccessGateProps) => {","+  const { formatMessage } = useIntl();","+  const { canRead, isLoading } = useMediaLibraryPermissions();","+","+  if (canRead) {","+    return children;","+  }","+","+  return (","+    <>","+      <Modal.Header>","+        <Modal.Title>{title}</Modal.Title>","+      </Modal.Header>","+      <Flex flex={1} justifyContent=\"center\" alignItems=\"center\">","+        {isLoading ? (","+          <Loader>{formatMessage({ id: 'app.loading', defaultMessage: 'Loading...' })}</Loader>","+        ) : (","+          <Page.NoPermissions />","+        )}","+      </Flex>","+      <Footer>","+        <Button variant=\"tertiary\" onClick={onClose}>","+          {formatMessage({ id: 'app.components.Button.cancel', defaultMessage: 'Cancel' })}","+        </Button>","+      </Footer>","+    </>","+  );","+};","+","+/**","+ * Content Manager asset picker, built on the current Media Library list. Its","+ * folder, search, filter and sort state lives in memory, so browsing never","+ * touches the URL of the entry it is opened from.","+ */","+export const AssetPickerDialog = ({","+  open,","+  onClose,","+  title,","+  initialSelection = NO_FILES,","+  multiple = false,","+  allowedTypes,","+  onConfirm,","+}: AssetPickerDialogProps) => {","+  // A ref, not state: nothing renders from it, only the Escape handler reads it.","+  const isReorderingRef = useRef(false);","+  const setReordering = useCallback((reordering: boolean) => {","+    isReorderingRef.current = reordering;","+  }, []);","+","+  return (","+    <Modal.Root open={open} onOpenChange={(isOpen) => !isOpen && onClose()}>","+      <StyledModalContent","+        // Radix handles Escape on the document in the capture phase, before","+        // dnd-kit's sensor sees it. During a drag, Escape cancels the drag instead.","+        onEscapeKeyDown={(event) => {","+          if (isReorderingRef.current) {","+            event.preventDefault();","+          }","+        }}","+      >","+        <ReadAccessGate title={title} onClose={onClose}>","+          {/* Inside the content so every opening starts from fresh list and selection state. */}","+          <ListQueryStateProvider>","+            <ListSettingsProvider {...PICKER_LIST_SETTINGS} showSectionHeadings showGridSelectAll>","+              <PickerSelectionRoot","+                initialSelection={initialSelection}","+                multiple={multiple}","+                allowedTypes={allowedTypes}","+              >","+                <PickerContent","+                  title={title}","+                  initialSelection={initialSelection}","+                  onClose={onClose}","+                  onConfirm={onConfirm}","+                  onReorderingChange={setReordering}","+                />","+              </PickerSelectionRoot>","+            </ListSettingsProvider>","+          </ListQueryStateProvider>","+        </ReadAccessGate>","+      </StyledModalContent>","+    </Modal.Root>","+  );","+};"],"additions":506,"deletions":0,"truncated":false},{"path":"packages/core/upload/admin/src/components/AssetPickerDialog/FolderBreadcrumbs.tsx","lines":["@@ -0,0 +1,96 @@","+import { Breadcrumbs, Crumb, CrumbSimpleMenu, MenuItem } from '@strapi/design-system';","+import { useIntl } from 'react-intl';","+import { styled } from 'styled-components';","+","+import { useGetFolderStructureQuery } from '../../services/folders';","+import { findFolderPath } from '../../utils/findFolderPath';","+import { getTranslationKey } from '../../utils/translations';","+","+// Past this many folders, the ones between the first and the parent collapse","+// into a menu, so a deep tree doesn't wrap the trail over several lines.","+const MAX_VISIBLE_FOLDERS = 3;","+","+// `CrumbLink`'s look on a real button. `CrumbLink` only renders an anchor, and","+// one without an `href` is neither announced as a button nor reachable by Tab.","+const CrumbButton = styled.button`","+  border: none;","+  background: none;","+  cursor: pointer;","+  border-radius: ${({ theme }) => theme.borderRadius};","+  color: ${({ theme }) => theme.colors.neutral600};","+  font-size: ${({ theme }) => theme.fontSizes[1]};","+  line-height: ${({ theme }) => theme.lineHeights[4]};","+  padding: ${({ theme }) => `${theme.spaces[1]} ${theme.spaces[2]}`};","+","+  &:hover,","+  &:focus-visible {","+    background-color: ${({ theme }) => theme.colors.neutral200};","+    color: ${({ theme }) => theme.colors.neutral700};","+  }","+`;","+","+interface FolderBreadcrumbsProps {","+  currentFolderId: number;","+  onSelectFolder: (folderId: number | null) => void;","+}","+","+/**","+ * Home › … › parent › current. Every crumb but the current folder navigates,","+ * so a user deep in the tree can climb back without a sidebar.","+ */","+export const FolderBreadcrumbs = ({ currentFolderId, onSelectFolder }: FolderBreadcrumbsProps) => {","+  const { formatMessage } = useIntl();","+  const { data: folderStructure = [] } = useGetFolderStructureQuery();","+","+  const path = findFolderPath(folderStructure, currentFolderId);","+  const current = path?.at(-1);","+","+  // The tree has not loaded yet, or no longer holds the folder (deleted","+  // elsewhere — `useAssetsList` sends the list back to the root on its own).","+  if (!path || !current) {","+    return null;","+  }","+","+  const ancestors = path.slice(0, -1);","+  const isCollapsed = path.length > MAX_VISIBLE_FOLDERS;","+  const leading = isCollapsed ? ancestors.slice(0, 1) : ancestors;","+  const hidden = isCollapsed ? ancestors.slice(1, -1) : [];","+  const trailing = isCollapsed ? ancestors.slice(-1) : [];","+","+  const renderLink = (folder: (typeof path)[number]) => (","+    <CrumbButton key={folder.id} type=\"button\" onClick={() => onSelectFolder(folder.id ?? null)}>","+      {folder.name}","+    </CrumbButton>","+  );","+","+  return (","+    <Breadcrumbs","+      label={formatMessage({","+        id: getTranslationKey('asset-picker.breadcrumbs.label'),","+        defaultMessage: 'Folder navigation',","+      })}","+    >","+      <CrumbButton type=\"button\" onClick={() => onSelectFolder(null)}>","+        {formatMessage({ id: getTranslationKey('plugin.home'), defaultMessage: 'Home' })}","+      </CrumbButton>","+      {leading.map(renderLink)}","+      {hidden.length > 0 && (","+        <CrumbSimpleMenu","+          aria-label={formatMessage({","+            id: getTranslationKey('asset-picker.breadcrumbs.more'),","+            defaultMessage: 'Show more folders',","+          })}","+          label=\"…\"","+        >","+          {hidden.map((folder) => (","+            <MenuItem key={folder.id} onSelect={() => onSelectFolder(folder.id ?? null)}>","+              {folder.name}","+            </MenuItem>","+          ))}","+        </CrumbSimpleMenu>","+      )}","+      {trailing.map(renderLink)}","+      <Crumb isCurrent>{current.name}</Crumb>","+    </Breadcrumbs>","+  );","+};"],"additions":96,"deletions":0,"truncated":false},{"path":"packages/core/upload/admin/src/components/AssetPickerDialog/PickerSelectionProvider.tsx","lines":["@@ -0,0 +1,244 @@","+import { createContext, useCallback, useContext, useMemo, useState, type ReactNode } from 'react';","+","+import {","+  AssetSelectionContext,","+  type AssetSelection,","+  type Selectability,","+} from '../../pages/Assets/hooks/useAssetSelection';","+import { assetKey, type ItemKey } from '../../pages/Assets/utils/selection';","+import { isAllowedAssetType, type MediaAllowedTypes } from '../../utils/isAllowedAssetType';","+","+import {","+  addFiles,","+  hasFile,","+  moveFile,","+  removeFile,","+  removeFiles,","+  toggleFile,","+  type PickerSelection,","+} from './pickerSelection';","+","+import type { File } from '../../../../shared/contracts/files';","+","+interface PickerSelectionContextValue {","+  selection: PickerSelection;","+  moveFile: (activeId: number, overId: number) => void;","+}","+","+const PickerSelectionContext = createContext<PickerSelectionContextValue | null>(null);","+","+export const usePickerSelection = () => {","+  const context = useContext(PickerSelectionContext);","+","+  if (!context) {","+    throw new Error('usePickerSelection must be used within a PickerSelectionProvider');","+  }","+","+  return context;","+};","+","+const parseAssetId = (key: ItemKey): number | null => {","+  const [kind, id] = key.split(':');","+","+  return kind === 'asset' ? Number(id) : null;","+};","+","+const NO_FOLDERS = new Set<number>();","+","+interface PickerSelectionProviderProps {","+  children: ReactNode;","+  initialSelection: File[];","+  multiple: boolean;","+  allowedTypes?: MediaAllowedTypes | null;","+  /**","+   * The assets on screen. Views select by key, but the selection keeps whole","+   * files, so a newly picked key is resolved against these.","+   */","+  knownFiles: File[];","+}","+","+/**","+ * The Content Manager picker's selection, behind the same `AssetSelection`","+ * interface the Media Library views read: only assets are selectable, assets","+ * outside `allowedTypes` are shown but cannot be picked, and the selection","+ * survives folder changes, search, filters and sort.","+ */","+export const PickerSelectionProvider = ({","+  children,","+  initialSelection,","+  multiple,","+  allowedTypes,","+  knownFiles,","+}: PickerSelectionProviderProps) => {","+  const [selection, setSelection] = useState<PickerSelection>(initialSelection);","+","+  const filesById = useMemo(() => {","+    const map = new Map<number, File>();","+    [...knownFiles, ...selection].forEach((file) => map.set(file.id, file));","+    return map;","+  }, [knownFiles, selection]);","+","+  const selectedIds = useMemo(() => new Set(selection.map((file) => file.id)), [selection]);","+","+  const resolveSelectableFile = useCallback(","+    (key: ItemKey): File | null => {","+      const id = parseAssetId(key);","+      const file = id === null ? undefined : filesById.get(id);","+","+      return file && isAllowedAssetType(allowedTypes, file.mime) ? file : null;","+    },","+    [allowedTypes, filesById]","+  );","+","+  const getSelectability = useCallback(","+    (key: ItemKey): Selectability => {","+      const id = parseAssetId(key);","+","+      if (id === null) {","+        return 'hidden';","+      }","+","+      // `allowedTypes` only stops adding an asset. One the field already holds,","+      // for example from before the schema was narrowed, must stay removable.","+      if (selectedIds.has(id)) {","+        return 'enabled';","+      }","+","+      const file = filesById.get(id);","+","+      return file && !isAllowedAssetType(allowedTypes, file.mime) ? 'disabled' : 'enabled';","+    },","+    [allowedTypes, filesById, selectedIds]","+  );","+","+  const toggle = useCallback(","+    (key: ItemKey) => {","+      const id = parseAssetId(key);","+","+      if (id !== null && selectedIds.has(id)) {","+        setSelection((prev) => removeFile(prev, id));","+        return;","+      }","+","+      const file = resolveSelectableFile(key);","+","+      if (file) {","+        setSelection((prev) => toggleFile(prev, file, { multiple }));","+      }","+    },","+    [multiple, resolveSelectableFile, selectedIds]","+  );","+","+  // Select-all over the assets on screen that can be picked, appended in their","+  // on-screen order. Only a multiple-value field offers it.","+  const selectAll = useCallback(","+    (orderedKeys: ItemKey[]) => {","+      if (!multiple) {","+        return;","+      }","+","+      const files = orderedKeys","+        .map((key) => resolveSelectableFile(key))","+        .filter((file): file is File => file !== null);","+","+      setSelection((prev) => addFiles(prev, files));","+    },","+    [multiple, resolveSelectableFile]","+  );","+","+  const selectOnly = useCallback(","+    (key: ItemKey) => {","+      const fil