{"id":"7ab1200901aab254f8775de0cd1e02345814e691","axis":"silent","repo":"matomo-org/matomo","sha":"7ab1200901aab254f8775de0cd1e02345814e691","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -115,6 +115,14 @@ The Product Changelog at **[matomo.org/changelog](https://matomo.org/changelog)*"," * Passing help by writing a `<div class=\"inlineHelp\">` into the `EnrichedHeadline` slot is no longer supported; use the `inline-help` attribute instead."," * The conditional fallback definitions for functions and constants that every supported PHP version provides natively (`mysqli_set_charset()`, `file_get_contents()`, `utf8_encode()`, `utf8_decode()`, `fnmatch()`, the `Error` class, `PHP_INT_SIZE` and `PHP_INT_MAX`) have been removed from `libs/upgradephp/upgrade.php`, as has the `gzopen()` alias for builds whose zlib exposes only `gzopen64()`; `Piwik\\Unzip` falls back to `PclZip` on such a build."," ","+## Matomo 5.14.3","+","+### New config.ini.php settings","+* `[General] disabled_notifications[]` lists the IDs of notifications to hide. For now only","+  `PhpSecurityAdvisory_2026_10_21` can be hidden: the warning shown to signed-in users when the PHP version is affected by","+  the critical PHP security vulnerabilities announced on 2026-10-21, for example when your Linux distribution has backported","+  the fix without changing the PHP version number.","+"," ## Matomo 5.14.2"," "," ### Breaking Changes"],"additions":8,"deletions":0,"truncated":false},{"path":"config/global.ini.php","lines":["@@ -702,6 +702,10 @@"," ; the superusers should see the notification."," show_update_notification_to_superusers_only = 0"," ","+; notifications to hide, by ID. Only some notifications can be hidden, e.g. the warning about the PHP security","+; advisory of 2026-10-21, when your Linux distribution has backported the fix without changing the PHP version number:","+;disabled_notifications[] = PhpSecurityAdvisory_2026_10_21","+"," ; Set to 1 if you're using https on your Matomo server and Matomo can't detect it,"," ; e.g., a reverse proxy using https-to-http, or a web server that doesn't"," ; set the HTTPS environment variable."],"additions":4,"deletions":0,"truncated":false},{"path":"core/Notification/Manager.php","lines":["@@ -9,6 +9,7 @@"," "," namespace Piwik\\Notification;"," ","+use Piwik\\Config\\GeneralConfig;"," use Piwik\\Notification;"," use Piwik\\Session;"," use Piwik\\Session\\SessionNamespace;","@@ -63,6 +64,21 @@ public static function cancel($id): void","         self::removeNotification($id);","     }"," ","+    /**","+     * Whether an admin has hidden a notification via `[General] disabled_notifications[]`.","+     * Only notifications that check this before calling {@link notify()} can be hidden.","+     *","+     * @param string $id The notification ID, see {@link notify()}.","+     * @internal","+     */","+    public static function isDisabled(string $id): bool","+    {","+        // a missing or invalid setting hides nothing","+        $disabledIds = GeneralConfig::getArrayConfigValue('disabled_notifications', []);","+","+        return in_array($id, $disabledIds, true);","+    }","+","     /**","      * Removes all temporary notifications.","      *"],"additions":16,"deletions":0,"truncated":false},{"path":"core/Plugin/Controller.php","lines":["@@ -82,18 +82,20 @@ abstract class Controller","      * First upstream release of each PHP branch that fixes the critical vulnerabilities announced on 2026-10-21.","      * Older branches get no upstream fix, newer branches were never affected.","      */","-    private const PHP_CRITICAL_VULNERABILITY_FIXED_RELEASES = [","+    private const PHP_SECURITY_ADVISORY_2026_10_21_FIXED_RELEASES = [","         '8.2' => 35,","         '8.3' => 36,","         '8.4' => 27,","         '8.5' => 12,","     ];"," ","-    private const PHP_CRITICAL_VULNERABILITY_ADVISORY_URL = 'https://www.php.net/archive/2026.php#2026-10-21-5';","+    private const PHP_SECURITY_ADVISORY_2026_10_21_ADVISORY_URL = 'https://www.php.net/archive/2026.php#2026-10-21-5';"," ","-    private const PHP_CRITICAL_VULNERABILITY_ANNOUNCEMENT_URL = 'https://matomo.org/blog/2026/10/critical-php-security-vulnerabilities-important-update-for-matomo-users/';","+    private const PHP_SECURITY_ADVISORY_2026_10_21_ANNOUNCEMENT_URL = 'https://matomo.org/blog/2026/10/critical-php-security-vulnerabilities-important-update-for-matomo-users/';"," ","-    private const PHP_CRITICAL_VULNERABILITY_NOTIFICATION_ID = 'PHPCriticalSecurityVulnerabilityCheck';","+    private const PHP_SECURITY_ADVISORY_2026_10_21_NOTIFICATION_ID = 'PhpSecurityAdvisory_2026_10_21';","+","+    private const LEGACY_PHP_SECURITY_ADVISORY_2026_10_21_NOTIFICATION_ID = 'PHPCriticalSecurityVulnerabilityCheck';"," ","     /**","      * The plugin name, eg. `'Referrers'`.","@@ -715,7 +717,7 @@ protected function setGeneralVariablesViewAs($view, $viewType)"," ","         $notifications = $view->notifications;","         if (empty($notifications)) {","-            self::notifyWhenPhpVersionHasCriticalVulnerability();","+            self::notifyWhenPhpIsAffectedBySecurityAdvisory20261021();"," ","             $view->notifications = NotificationManager::getAllNotificationsToDisplay();","             NotificationManager::cancelAllNonPersistent();","@@ -723,9 +725,10 @@ protected function setGeneralVariablesViewAs($view, $viewType)","     }"," ","     /**","-     * @internal temporary warning, will be removed again","+     * @internal temporary warning, will be removed again, together with the legacy notification ID.","+     *           Admins can hide it with [General] disabled_notifications[] = PhpSecurityAdvisory_2026_10_21","      */","-    protected static function notifyWhenPhpVersionHasCriticalVulnerability(): void","+    protected static function notifyWhenPhpIsAffectedBySecurityAdvisory20261021(): void","     {","         if (defined('PIWIK_TEST_MODE')) { // to avoid changing every UI test","             return;","@@ -736,17 +739,23 @@ protected static function notifyWhenPhpVersionHasCriticalVulnerability(): void","             return;","         }"," ","-        if (!self::isPhpVersionAffectedByCriticalVulnerability(PHP_MAJOR_VERSION, PHP_MINOR_VERSION, PHP_RELEASE_VERSION)) {","-            // persistent notifications stay in the session, so drop it once PHP has been fixed","-            NotificationManager::cancel(self::PHP_CRITICAL_VULNERABILITY_NOTIFICATION_ID);","+        // sessions may still hold the warning under the ID it had before it was renamed","+        NotificationManager::cancel(self::LEGACY_PHP_SECURITY_ADVISORY_2026_10_21_NOTIFICATION_ID);","+","+        if (","+            NotificationManager::isDisabled(self::PHP_SECURITY_ADVISORY_2026_10_21_NOTIFICATION_ID)","+            || !self::isPhpAffectedBySecurityAdvisory20261021(PHP_MAJOR_VERSION, PHP_MINOR_VERSION, PHP_RELEASE_VERSION)","+        ) {","+            // persistent notifications stay in the session, so drop it once PHP has been fixed or the warning is turned off","+            NotificationManager::cancel(self::PHP_SECURITY_ADVISORY_2026_10_21_NOTIFICATION_ID);","             return;","         }"," ","         $message = Piwik::translate('General_PhpCriticalSecurityUpdateRequired', [","             PHP_MAJOR_VERSION . '.' . PHP_MINOR_VERSION . '.' . PHP_RELEASE_VERSION,","-            Url::getExternalLinkTag(self::PHP_CRITICAL_VULNERABILITY_ANNOUNCEMENT_URL),","+            Url::getExternalLinkTag(self::PHP_SECURITY_ADVISORY_2026_10_21_ANNOUNCEMENT_URL),","             '</a>',","-            '<a href=\"' . self::PHP_CRITICAL_VULNERABILITY_ADVISORY_URL . '\" target=\"_blank\" rel=\"noreferrer noopener\">',","+            Url::getExternalLinkTag(self::PHP_SECURITY_ADVISORY_2026_10_21_ADVISORY_URL),","             '</a>',","         ]);"," ","@@ -758,15 +767,15 @@ protected static function notifyWhenPhpVersionHasCriticalVulnerability(): void","         // persistent, so the reporting UI doesn't clear it when it renders a report like it does with transient ones","         $notification->type = Notification::TYPE_PERSISTENT;","         $notification->flags = Notification::FLAG_NO_CLEAR;","-        NotificationManager::notify(self::PHP_CRITICAL_VULNERABILITY_NOTIFICATION_ID, $notification);","+        NotificationManager::notify(self::PHP_SECURITY_ADVISORY_2026_10_21_NOTIFICATION_ID, $notification);","     }"," ","-    private static function isPhpVersionAffectedByCriticalVulnerability(int $major, int $minor, int $release): bool","+    private static function isPhpAffectedBySecurityAdvisory20261021(int $major, int $minor, int $release): bool","     {","         $branch = $major . '.' . $minor;"," ","-        if (isset(self::PHP_CRITICAL_VULNERABILITY_FIXED_RELEASES[$branch])) {","-            return $release < self::PHP_CRITICAL_VULNERABILITY_FIXED_RELEASES[$branch];","+        if (isset(self::PHP_SECURITY_ADVISORY_2026_10_21_FIXED_RELEASES[$branch])) {","+            return $release < self::PHP_SECURITY_ADVISORY_2026_10_21_FIXED_RELEASES[$branch];","         }"," ","         return version_compare($branch, '8.2', '<');"],"additions":25,"deletions":16,"truncated":false},{"path":"core/Plugin/ControllerAdmin.php","lines":["@@ -490,7 +490,7 @@ public static function setBasicVariablesAdminView(View $view)"," ","         self::notifyAnyInvalidLicense();","         self::notifyAnyInvalidPlugin();","-        self::notifyWhenPhpVersionHasCriticalVulnerability();","+        self::notifyWhenPhpIsAffectedBySecurityAdvisory20261021();","         self::notifyWhenPhpVersionIsEOL();","         self::notifyWhenPhpVersionIsNotCompatibleWithNextMajorPiwik();","         self::notifyWhenDatabaseVersionIsNotCompatibleWithNextMajorPiwik();"],"additions":1,"deletions":1,"truncated":false},{"path":"tests/PHPUnit/Unit/Notification/ManagerTest.php","lines":["@@ -10,16 +10,23 @@"," namespace Piwik\\Tests\\Unit\\Notification;"," "," use PHPUnit\\Framework\\TestCase;","+use Piwik\\Config;"," use Piwik\\Notification;"," use Piwik\\Notification\\Manager;"," use Piwik\\Session\\SessionNamespace;"," "," class ManagerTest extends TestCase"," {","+    /**","+     * @var array<string, mixed>","+     */","+    private $originalGeneralConfig;","+","     protected function setUp(): void","     {","         parent::setUp();"," ","+        $this->originalGeneralConfig = Config::getInstance()->General;","         Manager::cancelAllNotifications();","     }"," ","@@ -27,9 +34,35 @@ protected function tearDown(): void","     {","         parent::tearDown();"," ","+        Config::getInstance()->General = $this->originalGeneralConfig;","         Manager::cancelAllNotifications();","     }"," ","+    /**","+     * @dataProvider getDisabledNotificationsConfigValues","+     * @param mixed $configValue null removes the setting","+     */","+    public function testIsDisabled($configValue, bool $expected): void","+    {","+        $general = Config::getInstance()->General;","+        unset($general['disabled_notifications']);","+        if ($configValue !== null) {","+            $general['disabled_notifications'] = $configValue;","+        }","+        Config::getInstance()->General = $general;","+","+        $this->assertSame($expected, Manager::isDisabled('testid'));","+    }","+","+    public function getDisabledNotificationsConfigValues(): iterable","+    {","+        yield 'listed' => [['otherid', 'testid'], true];","+        yield 'not listed' => [['otherid'], false];","+        yield 'missing setting' => [null, false];","+        // written without [], so the INI reader gives a string, not a list","+        yield 'not a list' => ['testid', false];","+    }","+","     public function testNotifyAddsNotificationToNotificationArray()","     {","         $notification = new Notification('abcdefg');"],"additions":33,"deletions":0,"truncated":false},{"path":"tests/PHPUnit/Unit/Plugin/ControllerTest.php","lines":["@@ -19,17 +19,17 @@"," class ControllerTest extends TestCase"," {","     /**","-     * @dataProvider getPhpVersionsForCriticalVulnerability","+     * @dataProvider getPhpVersionsForSecurityAdvisory20261021","      */","-    public function testIsPhpVersionAffectedByCriticalVulnerability(int $major, int $minor, int $release, bool $expected): void","+    public function testIsPhpAffectedBySecurityAdvisory20261021(int $major, int $minor, int $release, bool $expected): void","     {","-        $method = new ReflectionMethod(Controller::class, 'isPhpVersionAffectedByCriticalVulnerability');","+        $method = new ReflectionMethod(Controller::class, 'isPhpAffectedBySecurityAdvisory20261021');","         $method->setAccessible(true);"," ","         $this->assertSame($expected, $method->invoke(null, $major, $minor, $release));","     }"," ","-    public function getPhpVersionsForCriticalVulnerability(): iterable","+    public function getPhpVersionsForSecurityAdvisory20261021(): iterable","     {","         yield 'PHP 7.2 has no upstream fix' => [7, 2, 5, true];","         yield 'PHP 7.4 has no upstream fix' => [7, 4, 33, true];",""],"additions":4,"deletions":4,"truncated":false}],"additions":91,"deletions":21,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-28T14:43:19.286987+00:00"}