hes:","       - develop","       - release/*","+      - 'v[0-9]+'","   pull_request_target:","     branches:","       - develop","       - release/*","+      - 'v[0-9]+'"," permissions:","   contents: read"," jobs:"],"additions":2,"deletions":0,"truncated":false},{"path":"__snapshots__/prepare-release-artifacts-spec.js","lines":["@@ -6,3 +6,12 @@ $ node ./scripts/prepare-release-artifacts.js --dry-run --sha 57d0a85108fad6f77b"," 🏗 Dry run, not executing: ./scripts/create-stable-npm-package.sh https://cdn.cypress.io/beta/npm/1.2.3/linux-x64/develop-57d0a85108fad6f77b39db88b8a7d8a3bfdb51a2/cypress.tgz"," "," `","+","+exports['prepare-release-artifacts looks up the npm package under --branch 1'] = `","+$ node ./scripts/prepare-release-artifacts.js --dry-run --sha 57d0a85108fad6f77b39db88b8a7d8a3bfdb51a2 --version 1.2.3 --branch v15","+🏗 Running \\`move-binaries\\`...","+🏗 Dry run, not executing: node ./scripts/binary.js move-binaries --sha 57d0a85108fad6f77b39db88b8a7d8a3bfdb51a2 --version 1.2.3","+🏗 Running \\`create-stable-npm-package\\`...","+🏗 Dry run, not executing: ./scripts/create-stable-npm-package.sh https://cdn.cypress.io/beta/npm/1.2.3/linux-x64/v15-57d0a85108fad6f77b39db88b8a7d8a3bfdb51a2/cypress.tgz","+","+`"],"additions":9,"deletions":0,"truncated":false},{"path":"guides/next-version.md","lines":["@@ -8,6 +8,7 @@ The `get-next-version.js` script follows these steps:"," "," 1. If the environment variable `NEXT_VERSION` exists, print `NEXT_VERSION` and exit."," 2. Otherwise, analyze the commits to the current branch since the last release, using semantic commit messages. Print out the calculated version.","+    * The last release is the newest published version in the major of the nearest `vX.Y.Z` tag on the branch. On `develop` that is npm's `latest`. On a previous-major branch such as `v15`, it is the newest `15.x` release.","     * Only commits that touch files in `packages/*` or `cli/*` are considered.","         * This is done so that commits to the `npm/` packages do not necessarily bump the CLI and binary versions.","     * This project uses the [`angular` commit message style](https://gist.github.com/brianclements/841ea7bffdb01346392c/8e1f9b44d3fc7a4f2b448581071f9805f759c912)."],"additions":1,"deletions":0,"truncated":false},{"path":"guides/release-process.md","lines":["@@ -207,5 +207,29 @@ _Note: It is advisable to notify the team that the `develop` branch is locked do"," "," Take a break, you deserve it! 👉😎👉"," ","+## Releasing a previous major","+","+A previous major is maintained on a `vN` branch. The [next version](./next-version.md) is worked out from the newest published version of that major, found through the nearest `vN.*` tag on the branch, so a `v15` build produces `15.Y.Z` without setting `NEXT_VERSION`. Follow the steps above, with these differences:","+","+- **Step 6**: pass the branch the build ran on, because the pre-release npm package is stored under it:","+","+    ```shell","+    yarn prepare-release-artifacts --sha <commit sha> --version <new target version> --branch v15","+    ```","+","+- **Step 8**: publish under a `latest-vN` tag rather than `dev`, so `dev` and `latest` keep pointing at the current major:","+","+    ```shell","+    npm publish /tmp/cypress-prod.tgz --tag latest-v15","+    ```","+","+- **Step 12**: skip it. `cypress-docker-images` only builds the current version, and changing `factory/.env` would move the `cypress/included:latest` tag back to the previous major.","+- **Step 13**: skip it. Never run `npm dist-tag add` without a tag name for a previous-major version, since that moves `latest`.","+- **Step 14**: run `binary-release` as usual. It leaves `desktop.json` on the current major when the released version is older, and only checks that the version is downloadable.","+- **Step 16**: skip it.","+- **Step 17**: tag the commit on `v15` instead of `develop` (`git fetch origin v15` and check `origin/v15`).","+","+The `@cypress/`-namespaced npm packages are only released from `develop`. A fix to one of them reaches previous-major users through a `develop` release, as long as that package's `cypress` peer range still includes the previous major.","+"," [release-automations]: https://github.com/cypress-io/release-automations"," [cypress-example-kitchensink]: https://github.com/cypress-io/cypress-example-kitchensink"],"additions":24,"deletions":0,"truncated":false},{"path":"scripts/binary/index.js","lines":["@@ -12,6 +12,7 @@ const la = require('lazy-ass')"," const check = require('check-more-types')"," const debug = require('debug')('cypress:binary')"," const rp = require('@cypress/request-promise')","+const semver = require('semver')"," "," const zip = require('./zip')"," const ask = require('./ask')","@@ -28,6 +29,8 @@ const smoke = require('./smoke')"," const { needsSandbox } = require('../../cli/lib/tasks/verify')"," const execa = require('execa')"," ","+const MANIFEST_URL = 'https://download.cypress.io/desktop.json'","+"," const log = function (msg) {","   const time = new Date()","   const timeStamp = time.toLocaleTimeString()","@@ -124,19 +127,30 @@ const deploy = {","     const options = this.parseOptions(process.argv)"," ","     const release = ({ version, commit }) => {","-      return upload.s3Manifest(version)","-      .then(() => {","-        if (commit) {","-          return commitVersion(version)","+      return this.getManifest()","+      .then((manifest) => {","+        const updatesManifest = !semver.lt(version, manifest.version)","+","+        if (!updatesManifest) {","+          console.log(`Leaving the manifest at ${chalk.yellow(manifest.version)}, since ${chalk.yellow(version)} is older.`)","         }","-      }).then(() => {","-        return success('Release Complete')","-      }).catch((err) => {","-        fail('Release Failed')","-        throw err","-      })","-      .then(() => {","-        return this.checkManifest({ version })","+","+        return Promise.resolve(updatesManifest && upload.s3Manifest(version))","+        .then(() => {","+          if (commit) {","+            return commitVersion(version)","+          }","+        }).then(() => {","+          return success('Release Complete')","+        }).catch((err) => {","+          fail('Release Failed')","+          throw err","+        })","+        .then(() => {","+          if (updatesManifest) {","+            return this.checkManifest({ version })","+          }","+        })","       })","       .then(() => {","         return this.checkDownloads({ version })","@@ -147,21 +161,14 @@ const deploy = {","     .then(release)","   },"," ","-  checkManifest ({ version }) {","-    const checkManifest = () => {","-      const url = `https://download.cypress.io/desktop.json`","-","-      process.stdout.write(`Checking for ${chalk.yellow(version)} in the manifest at ${chalk.cyan(url)} ... `)","-","-      return rp.get(url)","-      .then((res) => {","-        const manifest = JSON.parse(res)","+  getManifest () {","+    return rp.get(MANIFEST_URL).then(JSON.parse)","+  },"," ","-        return manifest","-      })","-    }","+  checkManifest ({ version }) {","+    process.stdout.write(`Checking for ${chalk.yellow(version)} in the manifest at ${chalk.cyan(MANIFEST_URL)} ... `)"," ","-    return checkManifest().then((manifest) => {","+    return this.getManifest().then((manifest) => {","       const versionMatches = manifest.version === version"," ","       process.stdout.write(`${versionMatches ? '✅' : '❌'}\\n`)"],"additions":32,"deletions":25,"truncated":false},{"path":"scripts/get-next-version.js","lines":["@@ -14,7 +14,7 @@ const bump = promisify(bumpCb)"," const paths = ['packages', 'cli']"," "," const getNextVersionForPath = async (path) => {","-  const { version: releasedVersion } = await getCurrentReleaseData(false)","+  const { version: releasedVersion, isPreviousMajor } = await getCurrentReleaseData(false)"," ","   let commits","   const whatBump = (foundCommits) => {","@@ -62,6 +62,10 @@ const getNextVersionForPath = async (path) => {","     nextVersion = checkedInBinaryVersion","   }"," ","+  if (isPreviousMajor && semver.major(nextVersion) > semver.major(releasedVersion)) {","+    throw new Error(`The next version ${nextVersion} is outside the ${semver.major(releasedVersion)}.x line this branch releases.`)","+  }","+","   return {","     nextVersion,","     commits,"],"additions":5,"deletions":1,"truncated":false},{"path":"scripts/prepare-release-artifacts.js","lines":["@@ -11,6 +11,12 @@ if (!/^\\d+\\.\\d+\\.\\d+$/.test(args.version)) {","   throw new Error('A valid semantic version (X.Y.Z) must be passed in `--version`.')"," }"," ","+const branch = args.branch || 'develop'","+","+if (!/^[\\w./-]+$/.test(branch)) {","+  throw new Error('A valid branch name must be passed in `--branch`.')","+}","+"," const log = (...args) => console.log('🏗', ...args)"," "," const exec = args['dry-run'] ?","@@ -20,7 +26,7 @@ const exec = args['dry-run'] ?"," log('Running `move-binaries`...')"," exec(`node ./scripts/binary.js move-binaries --sha ${args.sha} --version ${args.version}`, { stdio: 'inherit' })"," ","-const prereleaseNpmUrl = `https://cdn.cypress.io/beta/npm/${args.version}/linux-x64/develop-${args.sha}/cypress.tgz`","+const prereleaseNpmUrl = `https://cdn.cypress.io/beta/npm/${args.version}/linux-x64/${branch}-${args.sha}/cypress.tgz`"," "," log('Running `create-stable-npm-package`...')"," exec(`./scripts/create-stable-npm-package.sh ${prereleaseNpmUrl}`, { stdio: 'inherit' })"],"additions":7,"deletions":1,"truncated":false},{"path":"scripts/semantic-commits/get-current-release-data.js","lines":["@@ -1,19 +1,72 @@"," const childProcess = require('child_process')","+const semver = require('semver')","+","+const getYarnInfo = (pkg) => {","+  const stdout = childProcess.execSync(`yarn info ${pkg} --json`)","+","+  return JSON.parse(stdout).data","+}","+","+/**","+ * The major of the nearest release tag reachable from HEAD, which tells a","+ * previous-major maintenance branch (e.g. v15) apart from develop.","+ */","+const getBranchMajor = () => {","+  try {","+    const tag = childProcess.execSync(`git describe --tags --abbrev=0 --match 'v[0-9]*'`, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim()","+","+    return semver.major(semver.coerce(tag))","+  } catch (err) {","+    return undefined","+  }","+}","+","+const isAncestorOfHead = (sha) => {","+  if (!/^[0-9a-f]{40}$/.test(sha)) return false","+","+  try {","+    childProcess.execSync(`git merge-base --is-ancestor ${sha} HEAD`, { stdio: 'ignore' })","+","+    return true","+  } catch (err) {","+    return false","+  }","+}"," "," /**","- * Get the version, commit date and git sha of the latest tag published on npm.","+ * Get the version, commit date and git sha of the latest version published on","+ * npm for the major line this branch is on.","  */"," const getCurrentReleaseData = (verbose = true) => {","   verbose && console.log('Get Current Release Information\\n')"," ","-  const stdout = childProcess.execSync('yarn info cypress --json')","-  const { data: npmInfo } = JSON.parse(stdout)","+  const npmInfo = getYarnInfo('cypress')","+  const latestVersion = npmInfo['dist-tags'].latest","+","+  let version = latestVersion","+  let buildInfo = npmInfo.buildInfo","+  let isPreviousMajor = false","+","+  // checked before tags so an untagged current-major release still counts as this branch's line","+  const branchMajor = isAncestorOfHead(buildInfo.commitSha) ? undefined : getBranchMajor()","+","+  if (branchMajor !== undefined && branchMajor < semver.major(latestVersion)) {","+    isPreviousMajor = true","+    version = semver.maxSatisfying(npmInfo.versions, `${branchMajor}.x`)","+","+    if (!version) {","+      throw new Error(`No published cypress version found for major ${branchMajor}.`)","+    }","+","+    buildInfo = getYarnInfo(`cypress@${version}`).buildInfo","+  }"," ","   const latestReleaseInfo = {","-    version: npmInfo['dist-tags'].latest,","+    version,","+    isPreviousMajor,","     distTags: npmInfo['dist-tags'],","-    commitDate: npmInfo.buildInfo.commitDate,","-    buildSha: npmInfo.buildInfo.commitSha,","+    commitDate: buildInfo.commitDate,","+    buildSha: buildInfo.commitSha,","   }"," ","   verbose && console.log({ latestReleaseInfo })"],"additions":59,"deletions":6,"truncated":false},{"path":"scripts/semantic-commits/validate-binary-changelog.js","lines":["@@ -14,7 +14,7 @@ const changelog = async () => {","   if (process.env.CIRCLECI) {","     console.log({ checkedInBinaryVersion })"," ","-    if (process.env.CIRCLE_BRANCH !== 'develop' && process.env.CIRCLE_BRANCH !== 'add-skip-changelog-validation' && !/^release\\/\\d+\\.\\d+\\.\\d+$/.test(process.env.CIRCLE_BRANCH) && !hasVersionBump) {","+    if (process.env.CIRCLE_BRANCH !== 'develop' && process.env.CIRCLE_BRANCH !== 'add-skip-changelog-validation' && !/^release\\/\\d+\\.\\d+\\.\\d+$/.test(process.env.CIRCLE_BRANCH) && !/^v\\d+$/.test(process.env.CIRCLE_BRANCH) && !hasVersionBump) {","       console.log('Only verify the entire changelog for develop, a release branch or any branch that bumped to the Cypress version in the package.json.')"," ","       return"],"additions":1,"deletions":1,"truncated":false},{"path":"scripts/unit/get-next-version-spec.js","lines":["@@ -142,6 +142,33 @@ describe('get-next-version', () => {","     })","   })"," ","+  context('on a previous-major branch', () => {","+    beforeEach(() => {","+      getCurrentReleaseDataStub.resolves({ version: releasedVersion, isPreviousMajor: true })","+    })","+","+    it('allows a patch bump', async () => {","+      bumpStub.callsFake(async (opts, cb) => cb(undefined, { releaseType: 'patch' }))","+","+      const { nextVersion } = await getNextVersionForPath('packages')","+","+      expect(nextVersion).to.eq('12.2.1')","+    })","+","+    it('throws on a major bump', async () => {","+      bumpStub.callsFake(async (opts, cb) => cb(undefined, { releaseType: 'major' }))","+","+ 