rver restarted with","+    /// an empty cache before every iteration of that command. `servers` holds","+    /// one entry per pnpr target, in [`Self::benchmarked_ids`] order.","+    fn run_hyperfine_restarting_pnpr_servers(","+        &self,","+        cleanup_command: &str,","+        servers: &mut [PnprResolverServer],","+    ) {","+        let listener = PnprRestartListener::bind();","+        let mut pnpr_targets = 0;","+        let prepare_commands: Vec<String> = self","+            .benchmarked_ids()","+            .map(|id| {","+                if !id.is_pnpr() {","+                    return cleanup_command.to_string();","+                }","+                let restart = listener.prepare_command(pnpr_targets);","+                pnpr_targets += 1;","+                format!(\"{restart} && {cleanup_command}\")","+            })","+            .collect();","+        listener.serve_during(","+            |server| {","+                let Some(resolver) = servers.get_mut(server) else { return false };","+                self.restart_pnpr_server_with_empty_cache(resolver);","+                true","+            },","+            || self.run_hyperfine(&prepare_commands),","+        );","+    }","+","+    /// `prepare_commands` holds either one step for every command or one step","+    /// per command, in [`Self::benchmarked_ids`] order.","+    fn run_hyperfine(&self, prepare_commands: &[String]) {","+        let mut command = Command::new(\"hyperfine\").with_current_dir(self.root());","+        for prepare in prepare_commands {","+            command = command.with_arg(\"--prepare\").with_arg(prepare);","+        }"," ","         self.options.hyperfine_options.append_to(&mut command);"," ","@@ -463,9 +522,17 @@ impl WorkEnv {","     /// from. Each round traces every target once, so drift across rounds","     /// reaches both revisions alike. A `pnpr@*` target's server was started","     /// before the trace, so its counts cover the client only.","-    fn count_syscalls(&self, cleanup_command: &str) {","+    /// `cold_servers` holds the pnpr servers to restart with an empty cache","+    /// before their target's trace, as in [`Self::run_timed_iterations`].","+    fn count_syscalls(&self, cleanup_command: &str, cold_servers: &mut [PnprResolverServer]) {","         for round in 0..SYSCALL_COUNT_ROUNDS {","+            let mut cold_servers = cold_servers.iter_mut();","             for id in self.benchmarked_ids() {","+                if id.is_pnpr()","+                    && let Some(server) = cold_servers.next()","+                {","+                    self.restart_pnpr_server_with_empty_cache(server);","+                }","                 Command::new(\"bash\")","                     .with_current_dir(self.root())","                     .with_arg(\"-c\")","@@ -573,3 +640,15 @@ impl WorkEnv {"," "," #[cfg(test)]"," mod tests;","+","+/// The pnpr servers a scenario restarts with an empty cache before every","+/// install it measures, in [`WorkEnv::benchmarked_ids`] order.","+fn resolution_cold_servers(","+    scenario: BenchmarkScenario,","+    pnpr_servers: &mut [PnprResolverServer],","+) -> &mut [PnprResolverServer] {","+    match scenario.cold_pnpr_cache() {","+        Some(ColdPnprCache::Resolution) => pnpr_servers,","+        Some(ColdPnprCache::Tarballs) | None => &mut [],","+    }","+}"],"additions":92,"deletions":13,"truncated":false},{"path":"pnpm/tasks/integrated-benchmark/src/work_env/diagnostics.rs","lines":["@@ -10,8 +10,8 @@ use super::{","     WorkEnv,","     check_peer_heavy_speedup,","     collect_pnpr_direct_ratios,","-    dir_contains_file,","     non_trivial_cold_batch,","+    pnpr_cache_dir,","     read_benchmark_diagnostics,","     read_hyperfine_report,","     read_phase_events,","@@ -30,20 +30,23 @@ use std::{"," "," impl WorkEnv {","     /// Fail the run if a `pnpr@<rev>` target never actually went through its","-    /// pnpr server. A resolve populates the server's on-disk store/cache","-    /// under `pnpr-storage`, so an empty `pnpr-storage` after the","-    /// benchmark means the client resolved *directly* instead, the silent","-    /// failure mode where a misnamed `PNPM_CONFIG_PNPR_SERVER` made every","-    /// `pnpr@<rev>` row a duplicate of its `pacquet@<rev>` row. Better to","-    /// abort than to publish meaningless pnpr-vs-direct numbers.","+    /// pnpr server. pnpr creates `resolver-cache` in its cache directory on","+    /// the first resolve request and writes nothing else there before one,","+    /// so a missing `resolver-cache` after the benchmark means the client","+    /// resolved *directly* instead, the silent failure mode where a misnamed","+    /// `PNPM_CONFIG_PNPR_SERVER` made every `pnpr@<rev>` row a duplicate of","+    /// its `pacquet@<rev>` row. The rest of `pnpr-storage` (the layout file","+    /// and the database) is written at startup, so it proves nothing. Better","+    /// to abort than to publish meaningless pnpr-vs-direct numbers.","     pub(super) fn verify_pnpr_targets_were_routed(&self) {","         for id in self.target_ids().filter(|id| id.is_pnpr()) {","-            let storage = self.bench_dir(id).join(\"pnpr-storage\");","+            let resolver_cache =","+                pnpr_cache_dir(&self.bench_dir(id).join(\"pnpr-storage\")).join(\"resolver-cache\");","             assert!(","-                dir_contains_file(&storage),","-                \"pnpr server storage at {storage:?} is empty after the benchmark, `{id}` never \\","-                 routed through pnpr (it resolved directly), so its rows would silently duplicate \\","-                 the `pacquet@<rev>` install. Check that `.pnpr-env` exports \\","+                resolver_cache.is_dir(),","+                \"pnpr server has no resolver cache at {resolver_cache:?} after the benchmark, \\","+                 `{id}` never routed through pnpr (it resolved directly), so its rows would \\","+                 silently duplicate the `pacquet@<rev>` install. Check that `.pnpr-env` exports \\","                  `PNPM_CONFIG_PNPR_SERVER` and that the client reads it.\",","             );","         }"],"additions":15,"deletions":12,"truncated":false},{"path":"pnpm/tasks/integrated-benchmark/src/work_env/pnpr_restart.rs","lines":["@@ -0,0 +1,132 @@","+//! Restarting a benchmark's pnpr servers with an empty cache between the","+//! installs it measures.","+","+use super::{","+    PnprResolverServer,","+    WorkEnv,","+    remove_dir_all_with_retry,","+    servers::PnprServerLogs,","+    wait_for_pnpr_ready,","+};","+use std::{","+    io::{","+        BufRead,","+        BufReader,","+        Write,","+    },","+    net::{","+        TcpListener,","+        TcpStream,","+    },","+    sync::atomic::{","+        AtomicBool,","+        Ordering,","+    },","+    thread,","+    time::Duration,","+};","+","+impl WorkEnv {","+    /// Restart a pnpr resolver server with an empty cache. Killing the process","+    /// is what drops the in-memory resolution cache: emptying the cache","+    /// directory under a live server leaves it warm.","+    pub(super) fn restart_pnpr_server_with_empty_cache(&self, resolver: &mut PnprResolverServer) {","+        let PnprResolverServer { server, paths } = resolver;","+        server.process.kill().expect(\"stop the pnpr server before restarting it\");","+        server.process.wait().expect(\"wait for the stopped pnpr server to exit\");","+        remove_dir_all_with_retry(&paths.cache()).expect(\"empty the pnpr cache before restart\");","+        server.process = self.spawn_pnpr_server_process(paths, PnprServerLogs::Append);","+        wait_for_pnpr_ready(paths.port);","+    }","+}","+","+/// The loopback socket through which hyperfine's `--prepare` asks the","+/// benchmark to restart one of its pnpr servers. The restart runs in this","+/// process, so every server stays a [`super::PnprServer`] guard that dies with the run.","+pub(super) struct PnprRestartListener {","+    listener: TcpListener,","+    stopped: AtomicBool,","+}","+impl PnprRestartListener {","+    const ACK: &'static str = \"restarted\";","+    const REQUEST_TIMEOUT: Duration = Duration::from_secs(10);","+","+    pub(super) fn bind() -> Self {","+        let listener = TcpListener::bind((\"127.0.0.1\", 0)).expect(\"bind the pnpr restart listener\");","+        PnprRestartListener { listener, stopped: AtomicBool::new(false) }","+    }","+","+    /// A `--prepare` step that asks for `server` to be restarted. It blocks","+    /// until the restart has finished and fails when no acknowledgement","+    /// arrives, so an iteration never runs against a server that was not","+    /// restarted.","+    pub(super) fn prepare_command(&self, server: usize) -> String {","+        let port = self.port();","+        format!(","+            r#\"bash -c 'exec 3<>/dev/tcp/127.0.0.1/{port} && echo {server} >&3 && read -r reply <&3 && [ \"$reply\" = {ack} ]'\"#,","+            ack = Self::ACK,","+        )","+    }","+","+    pub(super) fn port(&self) -> u16 {","+        self.listener","+            .local_addr()","+            .expect(\"pnpr restart listener address\")","+            .port()","+    }","+","+    /// Serve restart requests on a scoped thread while `run` executes.","+    /// `restart` receives the server index its [`Self::prepare_command`] named","+    /// and returns whether that index names one of the servers.","+    pub(super) fn serve_during(","+        &self,","+        restart: impl FnMut(usize) -> bool + Send,","+        run: impl FnOnce(),","+    ) {","+        thread::scope(|scope| {","+            scope.spawn(|| self.serve(restart));","+            let _stop = StopOnDrop(self);","+            run();","+        });","+    }","+","+    fn serve(&self, mut restart: impl FnMut(usize) -> bool) {","+        for stream in self.listener.incoming() {","+            if self.stopped.load(Ordering::Acquire) {","+                return;","+            }","+            let mut stream = stream.expect(\"accept a pnpr restart request\");","+            // Another local process may connect without naming a server. It","+            // gets no acknowledgement, and the listener moves on.","+            let Some(server) = Self::read_request(&stream) else { continue };","+            if !restart(server) {","+                continue;","+            }","+            writeln!(stream, \"{}\", Self::ACK).expect(\"acknowledge the pnpr restart\");","+        }","+    }","+","+    fn read_request(stream: &TcpStream) -> Option<usize> {","+        stream","+            .set_read_timeout(Some(Self::REQUEST_TIMEOUT))","+            .expect(\"bound the pnpr restart request read\");","+        let mut request = String::new();","+        BufReader::new(stream).read_line(&mut request).ok()?;","+        request.trim().parse().ok()","+    }","+","+    fn stop(&self) {","+        self.stopped.store(true, Ordering::Release);","+        let addr = self.listener.local_addr().expect(\"pnpr restart listener address\");","+        // Wakes the blocking accept in `serve`. Fails harmlessly once it has returned.","+        let _ = TcpStream::connect(addr);","+    }","+}","+/// Stops the listener even while a panic unwinds out of `run`, so the scope","+/// in [`PnprRestartListener::serve_during`] can join its serving thread.","+struct StopOnDrop<'a>(&'a PnprRestartListener);","+impl Drop for StopOnDrop<'_> {","+    fn drop(&mut self) {","+        self.0.stop();","+    }","+}"],"additions":132,"deletions":0,"truncated":false},{"path":"pnpm/tasks/integrated-benchmark/src/work_env/revision_mock.rs","lines":["@@ -49,14 +49,16 @@ pub(super) fn spawn_revision_mock(command: Command, bench_dir: &Path, cold: bool"," "," /// The command that serves one benchmark's pnpr server. A server whose"," /// registries live in the database gets [`pnpr_benchmark_public_url`].","-pub(super) fn pnpr_server_command(paths: &PnprServerPaths<'_>) -> Command {","-    let command = Command::new(paths.binary)","+pu