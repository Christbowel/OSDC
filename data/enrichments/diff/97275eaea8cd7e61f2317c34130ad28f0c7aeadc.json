d-linker.fresh-install.hot-cache.hot-store' \\","             'ISOLATED_FRESH_INSTALL_COLD_CACHE_HOT_STORE:isolated-linker.fresh-install.cold-cache.hot-store' \\","+            'ISOLATED_FRESH_INSTALL_COLD_CACHE_HOT_STORE_COLD_PNPR_RESOLVE:isolated-linker.fresh-install.cold-cache.hot-store.cold-pnpr-resolve' \\","             'ISOLATED_FRESH_RESOLVE_HOT_CACHE_OFFLINE:isolated-linker.fresh-resolve.hot-cache.offline' \\","             'ISOLATED_FRESH_RESTORE_COLD_CACHE_COLD_STORE_COLD_PNPR:isolated-linker.fresh-restore.cold-cache.cold-store.cold-pnpr' \\","             'GVS_FRESH_RESTORE_HOT_CACHE_HOT_STORE:gvs-linker.fresh-restore.hot-cache.hot-store'"],"additions":28,"deletions":0,"truncated":false},{"path":"pnpm/tasks/integrated-benchmark/src/cli_args.rs","lines":["@@ -242,6 +242,13 @@ pub enum BenchmarkScenario {","     /// server.","     #[value(name = \"isolated-linker.fresh-install.cold-cache.hot-store\")]","     IsolatedFreshInstallColdCacheHotStore,","+    /// The cold-cache + hot-store fresh install, with every pnpr server","+    /// restarted with an empty cache before each iteration, so pnpr resolves","+    /// from cold packuments instead of answering from its resolution cache:","+    /// the first request after a deploy, or for a tree the server has never","+    /// resolved.","+    #[value(name = \"isolated-linker.fresh-install.cold-cache.hot-store.cold-pnpr-resolve\")]","+    IsolatedFreshInstallColdCacheHotStoreColdPnprResolve,","     /// Frozen lockfile, cold cache + cold store. The typical CI shape.","     #[value(name = \"isolated-linker.fresh-restore.cold-cache.cold-store\")]","     IsolatedFreshRestoreColdCacheColdStore,","@@ -319,6 +326,18 @@ pub enum BenchmarkScenario {","     CargoRepeatInstallHotCacheHotStore,"," }"," ","+/// A pnpr-side cache a scenario empties before every iteration.","+#[derive(Debug, Clone, Copy, PartialEq, Eq)]","+pub enum ColdPnprCache {","+    /// The per-revision tarball-serving mock empties its cache and refetches","+    /// every tarball from the warm origin.","+    Tarballs,","+    /// Every pnpr server restarts with an empty cache. The restart also","+    /// drops the in-memory resolution cache that emptying the directory alone","+    /// keeps.","+    Resolution,","+}","+"," /// Per-iteration cleanup applied by hyperfine's `--prepare`."," pub struct Cleanup {","     /// Paths in the bench dir to `rm -rf` before each iteration.","@@ -351,6 +370,7 @@ impl BenchmarkScenario {","             BenchmarkScenario::IsolatedFreshInstallColdCacheColdStore","             | BenchmarkScenario::IsolatedFreshInstallHotCacheHotStore","             | BenchmarkScenario::IsolatedFreshInstallColdCacheHotStore","+            | BenchmarkScenario::IsolatedFreshInstallColdCacheHotStoreColdPnprResolve","             | BenchmarkScenario::IsolatedRepeatInstallHotCacheHotStore","             | BenchmarkScenario::IsolatedRepeatInstallColdCacheHotStore => &[\"install\"],","             BenchmarkScenario::IsolatedFreshRestoreColdCacheColdStore","@@ -406,7 +426,8 @@ impl BenchmarkScenario {","         match self {","             BenchmarkScenario::IsolatedFreshInstallColdCacheColdStore","             | BenchmarkScenario::IsolatedFreshInstallHotCacheHotStore","-            | BenchmarkScenario::IsolatedFreshInstallColdCacheHotStore => false,","+            | BenchmarkScenario::IsolatedFreshInstallColdCacheHotStore","+            | BenchmarkScenario::IsolatedFreshInstallColdCacheHotStoreColdPnprResolve => false,","             BenchmarkScenario::IsolatedFreshRestoreColdCacheColdStore","             | BenchmarkScenario::IsolatedFreshRestoreColdCacheColdStoreColdPnpr","             | BenchmarkScenario::IsolatedFreshRestoreHotCacheHotStore","@@ -497,7 +518,8 @@ impl BenchmarkScenario {","             // Cold cache (wipe `cache-dir` → re-resolve from scratch) but","             // hot store (keep `store-dir` → no tarball download). Resolution","             // is the only variable cost, so it can't hide behind downloads.","-            Self::IsolatedFreshInstallColdCacheHotStore => Cleanup::new(","+            Self::IsolatedFreshInstallColdCacheHotStore","+            | Self::IsolatedFreshInstallColdCacheHotStoreColdPnprResolve => Cleanup::new(","                 &[\"node_modules\", \"pnpm-lock.yaml\", \"cache-dir\"],","                 &[SAVED_PACKAGE_JSON],","             ),","@@ -551,10 +573,17 @@ impl BenchmarkScenario {","         )","     }"," ","-    /// Whether this scenario gives the serving mock a cold cache (see the","-    /// `…cold-store.cold-pnpr` variant); selects the cold-mock spawn.","-    pub fn cold_pnpr_cache(self) -> bool {","-        matches!(self, BenchmarkScenario::IsolatedFreshRestoreColdCacheColdStoreColdPnpr)","+    /// Which pnpr-side cache this scenario empties before every iteration.","+    pub fn cold_pnpr_cache(self) -> Option<ColdPnprCache> {","+        match self {","+            BenchmarkScenario::IsolatedFreshRestoreColdCacheColdStoreColdPnpr => {","+                Some(ColdPnprCache::Tarballs)","+            }","+            BenchmarkScenario::IsolatedFreshInstallColdCacheHotStoreColdPnprResolve => {","+                Some(ColdPnprCache::Resolution)","+            }","+            _ => None,","+        }","     }"," ","     /// Whether to use the generated shared-subgraph fixture that guards"],"additions":35,"deletions":6,"truncated":false},{"path":"pnpm/tasks/integrated-benchmark/src/work_env.rs","lines":["@@ -6,8 +6,8 @@ mod scripts;"," use scripts::{","     build_cleanup_command,","     create_install_script,","-    dir_contains_file,","     may_create_lockfile,","+    remove_dir_all_with_retry,","     sync_bench_repo,","     wipe_bench_dir,"," };","@@ -33,6 +33,7 @@ mod revision_auth;"," mod revision_mock;"," mod server_config;"," use server_config::{","+    PnprResolverServer,","     PnprServer,","     PnprServerPaths,","     RevisionMockRegistry,","@@ -40,6 +41,7 @@ use server_config::{","     cold_revision_mock_command,","     distinct_public_route_registries,","     mint_pnpr_token,","+    pnpr_cache_dir,","     serves_npm_under_base_path,","     wait_for_pnpr_ready,","     write_pnpr_benchmark_config,","@@ -64,12 +66,16 @@ use measurements::{"," mod diagnostics;"," "," mod mock_home;","+mod pnpr_restart;","+use pnpr_restart::PnprRestartListener;"," mod servers;"," "," mod build;"," "," use crate::{","     cli_args::{","+        BenchmarkScenario,","+        ColdPnprCache,","         RegistryMode,","         TargetKind,","         TargetSpec,","@@ -382,9 +388,10 @@ impl WorkEnv {","         // review on <https://github.com/pnpm/pacquet/pull/296>).","         // `pnpr-storage` is the per-target pnpr server's","         // store + cache (only present for `pnpr@<rev>` targets), wiping it","-        // upfront (but never per-iteration) makes the hyperfine warmup the","-        // run that primes the server, so timed runs measure a warm","-        // long-running server even while the client is cold. `cold-mock-storage`","+        // upfront makes the hyperfine warmup the run that primes the server,","+        // so timed runs measure a warm long-running server even while the","+        // client is cold. Only `ColdPnprCache::Resolution` empties the","+        // server's cache per iteration, by restarting it. `cold-mock-storage`","         // (only the cold-pnpr scenario) is wiped before the mock starts; timed","         // iterations clear only its cache so its database stays open.","         for dir in self","@@ -401,7 +408,7 @@ impl WorkEnv {"," ","         // Spawned before the GVS pre-warm below so a pnpr target","         // would have its server up if a scenario ever combines the two.","-        let _pnpr_servers = self.start_pnpr_servers(pnpr_server_registry);","+        let mut pnpr_servers = self.start_pnpr_servers(pnpr_server_registry);"," ","         if scenario.enables_gvs() || scenario.prewarms_node_modules() {","             self.prewarm_install_state();","@@ -417,7 +424,7 @@ 