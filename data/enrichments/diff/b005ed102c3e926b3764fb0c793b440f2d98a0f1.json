","+    /// `NO_COLOR` counts when set to any non-empty value (https://no-color.org).","+    fn infer_from(","+        force_color: Option<&str>,","+        no_color: bool,","+        is_terminal: bool,","+        supports_ansi: bool,","+    ) -> Self {","+        match force_color {","+            Some(\"false\" | \"0\") => Self::disabled_by_user(),","+            Some(\"true\" | \"1\" | \"2\" | \"3\") => Self::new(!supports_ansi),","+            _ if no_color => Self::disabled_by_user(),","+            _ => Self::new(!(supports_ansi && is_terminal)),","+        }","     }"," ","     /// Apply the UI color mode to the given styled object","@@ -198,7 +244,7 @@ impl ColorConfig {","     pub fn apply<D>(&self, obj: StyledObject<D>) -> StyledObject<D> {","         // Setting this to false will skip emitting any ansi codes associated","         // with the style when the object is displayed.","-        obj.force_styling(!self.should_strip_ansi)","+        obj.force_styling(!self.should_strip_ansi())","     }"," ","     // Ported from Go code. Converts an index to a color along the rainbow","@@ -212,7 +258,7 @@ impl ColorConfig {","     }"," ","     pub fn rainbow<'a>(&self, text: &'a str) -> Cow<'a, str> {","-        if self.should_strip_ansi {","+        if self.should_strip_ansi() {","             return Cow::Borrowed(text);","         }"," ","@@ -271,4 +317,45 @@ mod test {","             \"\\u{1b}[2mgray\\u{1b}[0m\"","         );","     }","+","+    #[test]","+    fn test_infer_color_precedence() {","+        let off_by_user = |c: ColorConfig| c.should_strip_ansi() && c.color_disabled_by_user();","+        let off_inferred = |c: ColorConfig| c.should_strip_ansi() && !c.color_disabled_by_user();","+        let on = |c: ColorConfig| !c.should_strip_ansi();","+","+        assert!(off_by_user(ColorConfig::infer_from(None, true, true, true)));","+        assert!(off_by_user(ColorConfig::infer_from(","+            Some(\"0\"),","+            false,","+            true,","+            true","+        )));","+        assert!(off_by_user(ColorConfig::infer_from(","+            Some(\"0\"),","+            true,","+            true,","+            true","+        )));","+        // FORCE_COLOR turning color on wins over NO_COLOR, on any console.","+        assert!(on(ColorConfig::infer_from(Some(\"3\"), true, false, true)));","+        assert!(off_inferred(ColorConfig::infer_from(","+            Some(\"3\"),","+            true,","+            true,","+            false","+        )));","+        // NO_COLOR is a user request even where ANSI isn't supported.","+        assert!(off_by_user(ColorConfig::infer_from(","+            None, true, true, false","+        )));","+        // A non-TTY or a console without ANSI support isn't a user request.","+        assert!(off_inferred(ColorConfig::infer_from(","+            None, false, false, true","+        )));","+        assert!(off_inferred(ColorConfig::infer_from(","+            None, false, true, false","+        )));","+        assert!(on(ColorConfig::infer_from(None, false, true, true)));","+    }"," }"],"additions":104,"deletions":17,"truncated":false},{"path":"crates/turborepo-ui/src/tui/app.rs","lines":["@@ -1610,7 +1610,7 @@ pub fn terminal_big_enough() -> Result<bool, Error> {"," /// hotkey is always catchable."," #[tracing::instrument(skip(terminal_sink))]"," fn enable_input(color_config: ColorConfig, terminal_sink: &TerminalSink) -> io::Result<()> {","-    if color_config.should_strip_ansi {","+    if color_config.should_strip_ansi() {","         crossterm::style::force_color_output(false);","     }","     crossterm::terminal::enable_raw_mode()?;"],"additions":1,"deletions":1,"truncated":false},{"path":"crates/turborepo/tests/run_logging.rs","lines":["@@ -2,7 +2,9 @@"," "," mod common;"," ","-use common::{run_turbo, run_turbo_with_env, setup};","+use common::{","+    git, git_commit_staged_if_changed, run_turbo, run_turbo_with_env, setup, turbo_command,","+};"," "," #[test]"," fn test_github_actions_grouped_logging_smoke() {","@@ -62,3 +64,60 @@ fn test_log_prefix_modes() {","     assert!(stdout.contains(\"FULL TURBO\"));","     assert!(!stdout.contains(\"app-a:build:\"));"," }","+","+// --- https://github.com/vercel/turborepo/issues/15033 ---","+","+#[test]","+fn test_no_color_strips_task_output_live_and_replayed() {","+    let tempdir = tempfile::tempdir().unwrap();","+    let dir = tempdir.path();","+    setup::setup_integration_test(dir, \"run_logging\", \"npm@10.5.0\", false).unwrap();","+    let paint = \"node -e \\\"process.stdout.write('color=' + (process.env.FORCE_COLOR ? \\","+                 '\\\\x1b[31mred\\\\x1b[39m' : 'plain') + '\\\\n')\\\"\";","+    std::fs::write(","+        dir.join(\"app-a/package.json\"),","+        serde_json::json!({ \"name\": \"app-a\", \"scripts\": { \"paint\": paint } }).to_string(),","+    )","+    .unwrap();","+    std::fs::write(dir.join(\"turbo.json\"), r#\"{ \"tasks\": { \"paint\": {} } }\"#).unwrap();","+    git(dir, &[\"add\", \".\"]);","+    git_commit_staged_if_changed(dir, \"add paint task\");","+","+    let paint_line = |extra_args: &[&str], env: &[(&str, &str)]| {","+        let mut cmd = turbo_command(dir);","+        cmd.env_remove(\"FORCE_COLOR\").env_remove(\"NO_COLOR\");","+        cmd.args([\"run\", \"paint\", \"--filter=app-a\", \"--ui=stream\"]);","+        cmd.args(extra_args).envs(env.iter().copied());","+        let output = cmd.output().unwrap();","+        assert!(output.status.success(), \"{output:?}\");","+        let stdout = String::from_utf8_lossy(&output.stdout).into_owned();","+        let line = stdout","+            .lines()","+            .find(|line| line.contains(\"color=\") && !line.contains(\"node -e\"))","+            .unwrap_or_else(|| panic!(\"no color= line in {stdout}\"))","+            .to_owned();","+        (stdout.contains(\"cache hit, replaying logs\"), line)","+    };","+","+    let (hit, line) = paint_line(&[], &[(\"FORCE_COLOR\", \"3\")]);","+    assert!(!hit);","+    assert!(line.ends_with(\"color=\\x1b[31mred\\x1b[39m\"), \"{line:?}\");","+","+    let (hit, line) = paint_line(&[\"--no-color\"], &[]);","+    assert!(hit);","+    assert_eq!(line, \"app-a:paint: color=red\");","+","+    let (hit, line) = paint_line(&[], &[(\"NO_COLOR\", \"1\")]);","+    assert!(hit);","+    assert_eq!(line, \"app-a:paint: color=red\");","+","+    // Without a request for no color, the replay keeps the recorded codes.","+    let (hit, line) = paint_line(&[], &[]);","+    assert!(hit);","+    assert!(line.ends_with(\"color=\\x1b[31mred\\x1b[39m\"), \"{line:?}\");","+","+    // Live output is stripped too, even when the task emits color.","+    let (hit, line) = paint_line(&[\"--no-color\", \"--force\"], &[(\"FORCE_COLOR\", \"3\")]);","+    assert!(!hit);","+    assert_eq!(line, \"app-a:paint: color=red\");","+}",""],"additions":60,"deletions":1,"truncated":false}],"additions":430,"deletions":38,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-18T16:49:41.743447+00:00"}