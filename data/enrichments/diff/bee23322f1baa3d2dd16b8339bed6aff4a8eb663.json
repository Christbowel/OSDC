am = false;","+    if (q->ne[3] > 1 && k->ne[3] == 1) {","+        const bool q_ok = (q->nb[3] == (size_t) q->ne[2] * q->nb[2]);","+        const bool dst_ok = (dst->ne[3] == q->ne[3] && dst->ne[2] == 1 && dst->ne[1] == q->ne[2] &&","+                             dst->nb[3] == (size_t) dst->ne[1] * dst->nb[1]);","+        const bool w_ok = (w->ne[3] == q->ne[3] && w->ne[2] == 1 && w->ne[1] == q->ne[2] &&","+                           w->nb[3] == (size_t) w->ne[1] * w->nb[1]) ||","+                          (w->ne[3] == 1 && w->ne[1] == q->ne[2] * q->ne[3]);","+        const bool m_ok = (m->ne[3] == q->ne[3] && m->ne[2] == 1 && m->ne[1] == q->ne[2] &&","+                           m->nb[3] == (size_t) m->ne[1] * m->nb[1]) ||","+                          (m->ne[3] == 1 && m->ne[1] == q->ne[2] * q->ne[3]);","+        can_collapse_stream = q_ok && dst_ok && w_ok && m_ok;","+    }","+","+    return can_collapse_k || can_collapse_stream;","+}","+","+static void htp_lightning_indexer_collapse_tensors(","+    const struct ggml_tensor * q,","+    const struct ggml_tensor * k,","+    const struct ggml_tensor * w,","+    const struct ggml_tensor * m,","+    const struct ggml_tensor * dst,","+    struct ggml_tensor * q_c,","+    struct ggml_tensor * k_c,","+    struct ggml_tensor * w_c,","+    struct ggml_tensor * m_c,","+    struct ggml_tensor * dst_c","+) {","+    *q_c   = *q;","+    *k_c   = *k;","+    *w_c   = *w;","+    *m_c   = *m;","+    *dst_c = *dst;","+","+    if (k->ne[1] > 1 && k->ne[2] == 1) {","+        k_c->ne[2] = k->ne[1];","+        k_c->ne[1] = 1;","+        k_c->nb[1] = k->nb[1];","+        k_c->nb[2] = k->nb[1];","+        k_c->nb[3] = k->nb[2];","+    }","+","+    if (q->ne[3] > 1 && k->ne[3] == 1) {","+        const int64_t n_tokens_collapsed = (int64_t) q->ne[2] * q->ne[3];","+","+        q_c->ne[2] = n_tokens_collapsed;","+        q_c->ne[3] = 1;","+        q_c->nb[3] = (size_t) q_c->ne[2] * q_c->nb[2];","+","+        if (w->ne[3] == q->ne[3]) {","+            w_c->ne[1] = n_tokens_collapsed;","+            w_c->ne[3] = 1;","+            w_c->nb[2] = (size_t) w_c->ne[1] * w_c->nb[1];","+            w_c->nb[3] = w_c->nb[2];","+        }","+","+        dst_c->ne[1] = n_tokens_collapsed;","+        dst_c->ne[3] = 1;","+        dst_c->nb[2] = (size_t) dst_c->ne[1] * dst_c->nb[1];","+        dst_c->nb[3] = dst_c->nb[2];","+","+        if (m->ne[3] == q->ne[3] && m->ne[1] == q->ne[2]) {","+            m_c->ne[1] = n_tokens_collapsed;","+            m_c->ne[3] = 1;","+            m_c->nb[2] = (size_t) m_c->ne[1] * m_c->nb[1];","+            m_c->nb[3] = m_c->nb[2];","+        }","+    }","+}","+","+static bool htp_kparams_solve_lightning_indexer_impl(","+    const struct ggml_hexagon_session * sess,","+    const struct ggml_tensor * q,","+    const struct ggml_tensor * k,","+    const struct ggml_tensor * w,","+    const struct ggml_tensor * m,","+    const struct ggml_tensor * op,","+    struct htp_lid_kernel_params * kparams","+) {","+    if (opt_li_select < 1) {","+        return false;","+    }","+","+    if (k->type != GGML_TYPE_F32 && k->type != GGML_TYPE_F16 && k->type != GGML_TYPE_Q8_0 && k->type != GGML_TYPE_Q4_0) {","+        return false;","+    }","+","+    if (q->ne[0] % 32 != 0 ||","+        !ggml_is_contiguous_rows(q) || !ggml_is_contiguous_rows(k) ||","+        !ggml_is_contiguous_rows(w) || !ggml_is_contiguous_rows(m) ||","+        !ggml_is_contiguous_rows(op)) {","+        return false;","+    }","+","+    const uint32_t n_kv_blocks = (k->ne[2] + HTP_LID_KV_BLOCK - 1) / HTP_LID_KV_BLOCK;","+    if (n_kv_blocks == 0 || q->ne[2] == 0) {","+        return false;","+    }","+","+    const uint32_t D          = q->ne[0];","+    const uint32_t n_head     = q->ne[1];","+    const uint32_t n_tokens   = q->ne[2];","+    const size_t   k_row_size = ggml_row_size(k->type, D);","+","+    kparams->k_row_size = (uint32_t) k_row_size;","+    kparams->div_n_head = init_fastdiv_values(n_head);","+    kparams->div_m_ne3  = init_fastdiv_values((uint32_t) m->ne[3]);","+","+    if (opt_li_select >= 2 && htp_session_n_hmx(sess) > 0 && D % HMX_FP16_TILE_N_COLS == 0) {","+        const uint32_t n_threads = htp_session_n_threads(sess);","+        const uint32_t n_stream  = q->ne[3];","+        const uint32_t n_dot     = D / HMX_FP16_TILE_N_COLS;","+","+        auto vtcm_usage = [&](uint32_t n_tok, uint32_t kv_block, uint32_t n_qsets) {","+            return htp_lid_hmx_compute_vtcm_usage(D, n_head, n_tok, kv_block, n_qsets, n_threads, k_row_size);","+        };","+","+        uint32_t n_tok = (std::min)(n_tokens, (uint32_t) HTP_LID_HMX_TOKENS_MAX);","+        while (n_tok > 32 && vtcm_usage(n_tok, 64, 1) > htp_session_vtcm_size(sess)) {","+            n_tok /= 2;","+        }","+","+        uint32_t n_qsets = n_tok == n_tokens ? (std::min)(n_stream, (uint32_t) HTP_LID_HMX_MAX_QSETS) : 1;","+        while (n_qsets > 1 && vtcm_usage(n_tok, 64, n_qsets) > htp_session_vtcm_size(sess)) {","+            n_qsets /= 2;","+        }","+","+        uint32_t n_qbuf = 1;","+        if (n_qsets == 1 && n_head >= 16 && n_stream * ((n_tokens + n_tok - 1) / n_tok) > 1) {","+            uint32_t nt2 = n_tok;","+            while (nt2 > 32 && vtcm_usage(nt2, 64, 2) > htp_session_vtcm_size(sess)) {","+                nt2 /= 2;","+            }","+            const size_t q_bytes = (size_t) nt2 * n_head * D * sizeof(float);","+            const size_t k_bytes = (size_t) k->ne[2] * ggml_row_size(k->type, D);","+            if (vtcm_usage(nt2, 64, 2) <= htp_session_vtcm_size(sess) && q_bytes >= k_bytes) {","+                n_tok  = nt2;","+                n_qbuf = 2;","+            }","+        }","+","+        const uint32_t n_ch   = (n_tok * n_head + 31) / 32;","+        const uint32_t kv_seg = hex_round_up(k->ne[2], 64);","+        const uint32_t n_rows = n_qsets * kv_seg;","+        const uint32_t bc_max = n_rows <= 512 ? n_rows : (std::max)(256u, n_rows / 4);","+        uint32_t kv_block = 64;","+        while (kv_block < HTP_LID_HMX_KV_BLOCK_MAX && kv_block < bc_max && (kv_block / 32) * n_ch * (n_dot + 1) < 256 &&","+               vtcm_usage(n_tok, kv_block * 2, n_qsets * n_qbuf) <= htp_session_vtcm_size(sess)) {","+            kv_block *= 2;","+        }","+","+        const size_t vtcm_size = vtcm_usage(n_tok, kv_block, n_qsets * n_qbuf);","+        if (vtcm_size <= htp_session_vtcm_size(sess)) {","+            const uint32_t n_tt = (n_tokens + n_tok - 1) / n_tok;","+            kparams->kernel_type       = HTP_LID_KERNEL_HMX;","+            kparams->n_threads         = n_threads;","+            kparams->n_tokens_tile     = n_tok;","+            kparams->n_kv_blocks       = (n_rows + kv_block - 1) / kv_block;","+            kparams->blocks_per_thread = 0;","+            kparams->kv_block          = kv_block;","+            kparams->n_qsets           = n_qsets;","+            kparams->n_qbuf            = n_qbuf;","+            kparams->kv_seg            = kv_seg;","+            kparams->n_tt              = n_tt;","+            kparams->vtcm_size         = (uint32_t) vtcm_size;","+            kparams->div_kv_seg        = init_fastdiv_values(kv_seg);","+            kparams->div_n_tt          = init_fastdiv_values(n_tt);","+            kparams->div_n_ch          = init_fastdiv_values(n_ch);","+            return true;","+        }","+    }","+","+    const uint32_t n_threads = (std::min)(htp_session_n_threads(sess), n_kv_blocks);","+    uint32_t n_tok = (std::min)((uint32_t) q->ne[2], (uint32_t) HTP_LID_TOKENS_MAX);","+    while (n_tok > 1 && htp_lid_compute_vtcm_usage(D, n_head, n_tok, n_threads, k_row_size) > htp_session_vtcm_size(sess)) {","+        n_tok /= 2;","+    }","+","+    const size_t vtcm_size = htp_lid_compute_vtcm_usage(D, n_head, n_tok, n_threads, k_row_size);","+    if (vtcm_size > htp_session_vtcm_size(sess)) {","+        return false;","+    }","+","+    kparams->kernel_type       = HTP_LID_KERNEL_HVX;","+    kparams->n_threads         = n_threads;","+    kparams->n_tokens_tile     = n_tok;","+    kparams->n_kv_blocks       = n_kv_blocks;","+    kparams->blocks_per_thread = (n_kv_blocks + n_threads - 1) / n_threads;","+    kparams->kv_block          = HTP_LID_KV_BLOCK;","+    kparams->n_qsets           = 1;","+    kparams->n_qbuf            = 1;","+    kparams->kv_seg            = 0;","+    kparams->n_tt              = 0;","+    kparams->vtcm_size         = (uint32_t) vtcm_size;","+","+    return true;","+}","+","+static bool htp_kparams_solve_lightning_indexer(","+    const struct ggml_hexagon_session * sess,","+    const struct ggml_tensor * op,","+    struct htp_lid_kernel_params * kparams","+) {","+    if (htp_lightning_indexer_can_collapse(op->src[0], op->src[1], op->src[2], op->src[3], op)) {","+        struct ggml_tensor q_c, k_c, w_c, m_c, d_c;","+        htp_lightning_indexer_collapse_tensors(op->src[0], op->src[1], op->src[2], op->src[3], op,","+                                               &q_c, &k_c, &w_c, &m_c, &d_c);","+        return htp_kparams_solve_lightning_indexer_impl(sess, &q_c, &k_c, &w_c, &m_c, &d_c, kparams);","+    }","+    return htp_kparams_solve_lightning_indexer_impl(sess, op->src[0], op->src[1], op->src[2], op->src[3], op, kparams);","+}"," template <auto SolveFn>"," static inline bool htp_kparams_invoke(","     const struct ggml_hexagon_session * sess,","@@ -4861,6 +5089,28 @@ void htp_opnode_collapse(const struct ggml_hexagon_session * sess, htp_opnode &","         }","         return;","     }","+","+    if (node.opcode == HTP_OP_LIGHTNING_INDEXER) {","+        if (node.inputs.size() < 4 || !node.inputs[0] || !node.inputs[1] || !node.inputs[2] || !node.inputs[3] || node.outputs.empty() || !node.outputs[0]) {","+            return;","+        }","+        const struct ggml_tensor * q   = node.inputs[0];","+        const struct ggml_tensor * k   = node.inputs[1];","+        const struct ggml_tensor * w   = node.inputs[2];","+        const struct ggml_tensor * m   = node.inputs[3];","+        const struct ggml_tensor * dst = node.outputs[0];","+","+        if (htp_lightning_indexer_can_collapse(q, k, w, m, dst)) {","+            struct ggml_tensor q_c, k_c, w_c, m_c, d_c;","+            htp_lightning_indexer_collapse_tensors(q, k, w, m, dst, &q_c, &k_c, &w_c, &m_c, &d_c);","+            node.inputs[0]  = node.add_dummy(q_c);","+            node.inputs[1]  = node.add_dummy(k_c);","+            node.inputs[2]  = node.add_dummy(w_c);","+            node.inputs[3]  = node.add_dummy(m_c);","+            node.outputs[0] = node.add_dummy(d_c);","+        }","+        return;","+    }"," }"," "," bool htp_kparams_solve(","@@ -4901,6 +5151,11 @@ bool htp_kparams_solve(","         const ggml_tensor * src3 = node.inputs.size() > 3 ? node.inputs[3] : nullptr;","         return htp_kparams_solve_dsv4_hc_post_impl(sess, src0, src1, src2, src3, dst, node.kparams<htp_dsv4_hc_post_kernel_params>());","     }","+    if (node.opcode == HTP_OP_LIGHTNING_INDEXER) {","+        const ggml_tensor * src2 = node.inputs.size() > 2 ? node.inputs[2] : nullptr;","+        const ggml_tensor * src3 = node.inputs.size() > 3 ? node.inputs[3] : nullptr;","+        return htp_kparams_solve_lightning_indexer_impl(sess, src0, src1, src2, src3, dst, node.kparams<htp_lid_kernel_params>());","+    }"," ","     return htp_kparams_solve(sess, node.node, node.kernel_params);"," }","@@ -5005,6 +5260,9 @@ bool htp_kparams_solve(","         case HTP_OP_ROLL:","             return htp_kparams_invoke<htp_kparams_solve_roll>(sess, op, kparams);"," ","+        case HTP_OP_LIGHTNING_INDEXER:","+            return htp_kparams_invoke<htp_kparams_solve_lightning_indexer>(sess, op, kparams);","+","         case HTP_OP_DIAG:","             return htp_kparams_invoke<htp_kparams_solve_diag>(sess, op, kparams);"," "],"additions":258,"deletions":0,"truncated":false},{"path":"ggml/src/ggml-hexagon/htp-kparams.h","lines":["@@ -18,6 +18,7 @@"," #include \"htp/get-rows-ops.h\""," #include \"htp/glu-o