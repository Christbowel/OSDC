 * spad_k;","+    uint8_t * spad_kt;","+    uint8_t * spad_m;","+    uint8_t * spad_o;","+};","+","+static inline void lid_prep_step_info(uint32_t k, uint32_t K, uint32_t t_first, uint32_t i0, uint32_t i1, uint32_t n_head,","+                                      uint32_t * out_t, uint32_t * out_ha, uint32_t * out_hb) {","+    const uint32_t t  = t_first + k;","+    const uint32_t ha = (k == 0) ? (i0 - t * n_head) : 0;","+    const uint32_t hb = (k == K - 1) ? (i1 - t * n_head) : n_head;","+    *out_t  = t;","+    *out_ha = ha;","+    *out_hb = hb;","+}","+","+static inline void lid_prep_push_step(dma_queue * dma_q, const struct htp_lid_context * lctx,","+                                      const struct htp_tensor * q, const struct htp_tensor * w,","+                                      uint8_t * qs, uint8_t * ws, uint32_t qs_row_size, uint32_t w_row_size,","+                                      uint32_t D, uint32_t n_head, uint32_t t, uint32_t ha, uint32_t hb) {","+    const uint32_t it = lctx->t0 + t;","+    dma_queue_push(dma_q, dma_make_data(qs, q->data + it * q->nb[2] + lctx->is * q->nb[3] + ha * q->nb[1]),","+                   qs_row_size, q->nb[1], D * sizeof(float), hb - ha);","+    dma_queue_push(dma_q, dma_make_data(ws, w->data + it * w->nb[1] + lctx->is * w->nb[3]),","+                   w_row_size, w_row_size, n_head * sizeof(float), 1);","+}","+","+// Splat every Q element (f16) and every head weight (f32) into a full vector.","+// Work is split over (token, head) pairs.","+static void lid_prep_thread(unsigned int nth, unsigned int ith, void * data) {","+    struct htp_lid_context *       lctx = (struct htp_lid_context *) data;","+    const struct htp_ops_context * octx = lctx->octx;","+    const struct htp_tensor *      q    = octx->src[0];","+    const struct htp_tensor *      w    = octx->src[2];","+","+    const struct htp_lid_vtcm_layout * L = &lctx->L;","+","+    const uint32_t D      = q->ne[0];","+    const uint32_t n_head = q->ne[1];","+","+    // nth is min(n_threads, n_items): the same chunk as a split over n_threads","+    const uint32_t n_items = lctx->nt * n_head;","+    const uint32_t chunk   = fastdiv(n_items + octx->n_threads - 1, &octx->n_threads_div);","+    const uint32_t i0      = ith * chunk;","+    const uint32_t i1      = MIN(i0 + chunk, n_items);","+","+    if (i0 >= i1) {","+        return;","+    }","+","+    struct htp_thread_trace * tr    = &octx->ctx->trace[ith];","+    dma_queue *               dma_q = octx->ctx->dma[ith];","+","+    const uint32_t w_row_size = hex_round_up(n_head * sizeof(float), 128);","+    const size_t   qs_size    = n_head * L->size_qs_row;","+    const size_t   slot_size  = qs_size + w_row_size;","+","+    uint8_t * qs[2];","+    uint8_t * ws[2];","+    qs[0] = lctx->spad_qs + ith * L->size_qs;","+    ws[0] = qs[0] + qs_size;","+    qs[1] = qs[0] + slot_size;","+    ws[1] = qs[1] + qs_size;","+    uint8_t * qh = qs[0] + 2 * slot_size;","+","+    const uint32_t t_first = fastdiv(i0, &lctx->kp->div_n_head);","+    const uint32_t t_last  = fastdiv(i1 - 1, &lctx->kp->div_n_head);","+    const uint32_t n_steps = t_last - t_first + 1;","+","+    // Prologue: prime both slots","+    uint32_t t, ha, hb;","+    lid_prep_step_info(0, n_steps, t_first, i0, i1, n_head, &t, &ha, &hb);","+    lid_prep_push_step(dma_q, lctx, q, w, qs[0], ws[0], L->size_qs_row, w_row_size, D, n_head, t, ha, hb);","+","+    if (n_steps > 1) {","+        lid_prep_step_info(1, n_steps, t_first, i0, i1, n_head, &t, &ha, &hb);","+        lid_prep_push_step(dma_q, lctx, q, w, qs[1], ws[1], L->size_qs_row, w_row_size, D, n_head, t, ha, hb);","+    }","+","+    // Loop: pop(slot) -> compute(slot) -> push(slot, k + 2)","+    for (uint32_t k = 0; k < n_steps; ++k) {","+        const uint32_t slot = k & 1;","+","+        dma_queue_pop(dma_q);","+        dma_queue_pop(dma_q);","+","+        lid_prep_step_info(k, n_steps, t_first, i0, i1, n_head, &t, &ha, &hb);","+        const uint32_t it = lctx->t0 + t;","+","+        htp_trace_event_start(tr, HTP_TRACE_EVT_HVX_A_PREP, (uint16_t) it);","+","+        HVX_Vector * restrict q_sp = (HVX_Vector *) lctx->spad_q + (t * n_head + ha) * D;","+        for (uint32_t h = ha; h < hb; ++h) {","+            hvx_copy_f16_f32_aa(qh, qs[slot] + (h - ha) * L->size_qs_row, D);","+","+            const HVX_Vector * restrict qv = (const HVX_Vector *) qh;","+            for (uint32_t d0 = 0; d0 < D; d0 += VLEN_FP16) {","+                const HVX_Vector v  = qv[d0 / VLEN_FP16];","+                const uint32_t   nd = MIN(VLEN_FP16, D - d0);","+                for (uint32_t j = 0; j < nd; ++j) {","+                    *q_sp++ = hvx_vec_repl_f16(Q6_V_vror_VR(v, j * SIZEOF_FP16));","+                }","+            }","+        }","+","+        const HVX_Vector * restrict wv    = (const HVX_Vector *) ws[slot];","+        HVX_Vector *       restrict w_dst = (HVX_Vector *) (lctx->spad_w + t * n_head * VLEN);","+        for (uint32_t h = ha; h < hb; ++h) {","+            w_dst[h] = hvx_vec_repl4(Q6_V_vror_VR(wv[h / VLEN_FP32], (h % VLEN_FP32) * SIZEOF_FP32));","+        }","+","+        htp_trace_event_stop(tr, HTP_TRACE_EVT_HVX_A_PREP, (uint16_t) it);","+","+        if (k + 2 < n_steps) {","+            uint32_t next_t, next_ha, next_hb;","+            lid_prep_step_info(k + 2, n_steps, t_first, i0, i1, n_head, &next_t, &next_ha, &next_hb);","+            lid_prep_push_step(dma_q, lctx, q, w, qs[slot], ws[slot], L->size_qs_row, w_row_size, D, n_head, next_t, next_ha, next_hb);","+        }","+    }","+}","+","+#if __HVX_ARCH__ < 79","+#define LID_MUL_F16(a, b) Q6_Vhf_equals_Wqf32(Q6_Wqf32_vmpy_VhfVhf(a, b))","+#else","+#define LID_MUL_F16(a, b) Q6_Vhf_vmpy_VhfVhf(a, b)","+#endif","+","+// Q8_0 row to f16 in place, 4 blocks (128 values) per step.","+// Go backwards: the f16 output of a group is wider than its input and covers the input of the next group.","+static inline void lid_dequant_row_q8_0(uint8_t * restrict row, uint32_t D) {","+    const int32_t nb = D / QK8_0;","+","+    const HVX_VectorPred q32 = Q6_Q_vsetq_R(32);","+    const HVX_VectorPred q64 = Q6_Q_vsetq_R(64);","+    const HVX_VectorPred q96 = Q6_Q_vsetq_R(96);","+","+    for (int32_t g = (nb - 1) / 4; g >= 0; --g) {","+        const uint8_t *  src = row + g * 4 * sizeof(block_q8_0);","+        const HVX_Vector v0  = *(const HVX_UVector *) src;","+        const HVX_Vector v1  = *(const HVX_UVector *) (src + VLEN);","+","+        HVX_Vector qs = Q6_V_vmux_QVV(q96, Q6_V_valign_VVR(v1, v0, 6), Q6_V_valign_VVR(v1, v0, 8));","+        qs            = Q6_V_vmux_QVV(q64, Q6_V_valign_VVR(v1, v0, 4), qs);","+        qs            = Q6_V_vmux_QVV(q32, Q6_V_valign_VVR(v1, v0, 2), qs);","+","+        const HVX_Vector s01 = Q6_V_vmux_QVV(q64, hvx_vec_repl_f16(v0), hvx_vec_repl_f16(Q6_V_valign_VVR(v1, v0, 34)));","+        const HVX_Vector s23 = Q6_V_vmux_QVV(q64, hvx_vec_repl_f16(Q6_V_valign_VVR(v1, v0, 68)), hvx_vec_repl_f16(Q6_V_valign_VVR(v1, v0, 102)));","+","+        const HVX_VectorPair qh = Q6_Wh_vunpack_Vb(qs);","+","+        HVX_Vector * dst = (HVX_Vector *) (row + g * 2 * VLEN);","+        dst[0] = Q6_Vhf_equals_Wqf32(Q6_Wqf32_vmpy_VhfVhf(Q6_Vhf_equals_Vh(Q6_V_lo_W(qh)), s01));","+        if (g * 4 + 2 < nb) {","+            dst[1] = Q6_Vhf_equals_Wqf32(Q6_Wqf32_vmpy_VhfVhf(Q6_Vhf_equals_Vh(Q6_V_hi_W(qh)), s23));","+        }","+    }","+}","+","+// Q4_0 blocks i, i + 1 (v loaded at block i) to signed quants: block i in bytes 0..31, block i + 1 in bytes 32..63.","+// qs[j] holds value j (low nibble) and j + 16 (high nibble). lo16 selects bytes 0..15 and 32..47.","+static inline HVX_Vector lid_q4_0_pair_quants(HVX_Vector v, HVX_VectorPred q32, HVX_VectorPred lo16) {","+    const HVX_Vector qs = Q6_V_vmux_QVV(q32, Q6_V_vror_VR(v, sizeof(ggml_half)),","+                                        Q6_V_vror_VR(v, VLEN - 32 + sizeof(block_q4_0) + sizeof(ggml_half)));","+    const HVX_Vector lo = Q6_Vb_vsub_VbVb(Q6_V_vand_VV(qs, Q6_Vb_vsplat_R(0x0F)), Q6_Vb_vsplat_R(8));","+    const HVX_Vector hi = Q6_Vb_vsub_VbVb(Q6_Vub_vlsr_VubR(qs, 4), Q6_Vb_vsplat_R(8));","+    return Q6_V_vmux_QVV(lo16, lo, Q6_V_vlalign_VVR(hi, Q6_V_vzero(), 16));","+}","+","+// Q4_0 row to f16 in place, 2 blocks (64 values) per step. Backwards, as for Q8_0.","+static inline void lid_dequant_row_q4_0(uint8_t * restrict row, uint32_t D) {","+    const int32_t nb = D / QK4_0;","+","+    const HVX_VectorPred q32  = Q6_Q_vsetq_R(32);","+    const HVX_VectorPred q64  = Q6_Q_vsetq_R(64);","+    const HVX_VectorPred lo16 = Q6_Q_or_QQ(Q6_Q_vsetq_R(16), Q6_Q_and_QQn(Q6_Q_vsetq_R(48), q32));","+","+    for (int32_t p = (nb - 1) / 2; p >= 0; --p) {","+        const HVX_Vector v  = *(const HVX_UVector *) (row + p * 2 * sizeof(block_q4_0));","+        const HVX_Vector q  = lid_q4_0_pair_quants(v, q32, lo16);","+        const HVX_Vector d1 = 2 * p + 1 < nb ? hvx_vec_repl_f16(Q6_V_vror_VR(v, sizeof(block_q4_0))) : Q6_V_vzero();","+        const HVX_Vector d  = Q6_V_vmux_QVV(q64, hvx_vec_repl_f16(v), d1);","+","+        ((HVX_Vector *) row)[p] = LID_MUL_F16(Q6_Vhf_equals_Vh(Q6_V_lo_W(Q6_Wh_vunpack_Vb(q))), d);","+    }","+}","+","+// Quantized kv block to f16 rows in place. Not inlined: the dequant constants would stay live across the compute loop.","+static __attribute__((noinline)) void lid_dequant_block(uint8_t * restrict k_buf, size_t row_stride, uint32_t nkv, uint32_t D, bool q4) {","+    if (q4) {","+        for (uint32_t r = 0; r < nkv; ++r) {","+            lid_dequant_row_q4_0(k_buf + r * row_stride, D);","+        }","+    } else {","+        for (uint32_t r = 0; r < nkv; ++r) {","+            lid_dequant_row_q8_0(k_buf + r * row_stride, D);","+        }","+    }","+}","+","+static inline void lid_convert_row_f32_to_f16(uint8_t * row, uint32_t D) {","+    const HVX_Vector zero = Q6_V_vzero();","+    const HVX_Vector * src = (const HVX_Vector *) row;","+    HVX_Vector * dst = (HVX_Vector *) row;","+","+    for (uint32_t d = 0; d < D; d += 64) {","+        dst[d / 64] = hvx_vec_f32_to_f16(src[d / 32], d + 32 < D ? src[d / 32 + 1] : zero);","+    }","+}","+","+// Q8_0 gather transpose limits: tmp (two 64x64 scratch tiles) holds D / 2 pairs, gather offsets are 16 bit","+static inline bool lid_q8_0_gather_ok(size_t row_size, uint32_t D) {","+    return D <= 4 * HTP_LID_KV_BLOCK && (HTP_LID_KV_BLOCK - 1) * row_size + (D / QK8_0) * sizeof(block_q8_0) <= 32767;","+}","+","+// Transpose a raw Q8_0 kv block: one halfword gather reads q[d], q[d + 1] of all 64 rows, then split, widen to f16 and scale.","+// Lanes of missing rows hold stale data; they are not stored.","+static inline void lid_transpose_q8_0_gather(HVX_Vector * restrict kt,","+                                             HVX_Vector * restrict tmp,","+                                             HVX_Vector * restrict sc,","+                                             const uint8_t * restrict k_buf,","+                                             size_t row_size,","+                                             HVX_Vector offsets,","+                                             uint32_t D) {","+    const uint32_t mu = HTP_LID_KV_BLOCK * row_size;","+    for (uint32_t b = 0; b < D / QK8_0; ++b) {","+        Q6_vgather_ARMVh(sc + b, (size_t) (k_buf + b * sizeof(block_q8_0)), mu, offsets);","+    }","+    for (uint32_t d = 0; d < D; d += 2) {","+        const uint32_t off = (d / QK8_0) * sizeof(block_q8_0) + sizeof(ggml_half) + d % QK8_0;","+        Q6_vgather_ARMVh(tmp + d / 2, (size_t) (k_buf + off), mu, offsets);","+    }","+    hvx_gather_sync(sc);","+    hvx_gather_sync(tmp);","+","+    for (uint32_t d = 0; d < D; d += 2) {"],"additions":280,"deletions":0,"truncated":false}],"additions":553,"deletions":0,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-11-04T16:06:59.317775+00:00"}