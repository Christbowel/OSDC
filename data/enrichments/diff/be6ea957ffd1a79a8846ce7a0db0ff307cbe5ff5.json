{"id":"be6ea957ffd1a79a8846ce7a0db0ff307cbe5ff5","axis":"silent","repo":"kubevela/kubevela","sha":"be6ea957ffd1a79a8846ce7a0db0ff307cbe5ff5","parsed":{"files":[{"path":"pkg/definition/defkit/app_policy.go","lines":["@@ -0,0 +1,231 @@","+/*","+Copyright 2025 The KubeVela Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package defkit","+","+import (","+\t\"fmt\"","+\t\"sort\"","+\t\"strconv\"","+\t\"strings\"","+","+\t\"cuelang.org/go/cue/ast\"","+","+\t\"github.com/oam-dev/kubevela/apis/core.oam.dev/v1beta1\"","+)","+","+// ApplicationScoped makes the policy transform the Application before it is","+// rendered, through the template's Output, instead of producing resources.","+func (p *PolicyDefinition) ApplicationScoped() *PolicyDefinition {","+\tp.scope = v1beta1.ApplicationScope","+\treturn p","+}","+","+// Global applies the policy to every Application in the namespace it is","+// installed in, or to every Application when installed in vela-system, without","+// being listed in spec.policies. A global policy is always Application-scoped.","+func (p *PolicyDefinition) Global() *PolicyDefinition {","+\tp.scope = v1beta1.ApplicationScope","+\tp.global = true","+\treturn p","+}","+","+// Priority orders the policy among the Application-scoped policies that apply","+// to an Application: lower runs first, and ties run in name order.","+func (p *PolicyDefinition) Priority(priority int32) *PolicyDefinition {","+\tp.priority = &priority","+\treturn p","+}","+","+// IsApplicationScoped reports whether the policy transforms the Application.","+func (p *PolicyDefinition) IsApplicationScoped() bool {","+\treturn p.scope == v1beta1.ApplicationScope","+}","+","+// IsGlobal reports whether the policy applies without being listed.","+func (p *PolicyDefinition) IsGlobal() bool { return p.global }","+","+// GetPriority returns the priority, or nil when unset.","+func (p *PolicyDefinition) GetPriority() *int32 { return p.priority }","+","+// validateDefinition refuses settings the controller only honours on an","+// Application-scoped policy.","+func (p *PolicyDefinition) validateDefinition() error {","+\tif p.IsApplicationScoped() {","+\t\treturn nil","+\t}","+\tvar used []string","+\tif p.priority != nil {","+\t\tused = append(used, \"Priority\")","+\t}","+\tif p.policyTemplate != nil {","+\t\tpt := NewPolicyTemplate()","+\t\tp.policyTemplate(pt)","+\t\tif pt.output != nil {","+\t\t\tused = append(used, \"Output\")","+\t\t}","+\t\tif pt.enabled != nil {","+\t\t\tused = append(used, \"Enabled\")","+\t\t}","+\t}","+\tif len(used) == 0 {","+\t\treturn nil","+\t}","+\treturn fmt.Errorf(\"%s only apply to an Application-scoped policy; call ApplicationScoped()\", strings.Join(used, \", \"))","+}","+","+// writeAppScopeAttributes writes scope, global and priority as attributes.","+func writeAppScopeAttributes(sb *strings.Builder, p *PolicyDefinition, indent string) {","+\tif p.scope != \"\" {","+\t\tsb.WriteString(fmt.Sprintf(\"%sscope: %q\\n\", indent, p.scope))","+\t}","+\tif p.global {","+\t\tsb.WriteString(fmt.Sprintf(\"%sglobal: true\\n\", indent))","+\t}","+\tif p.priority != nil {","+\t\tsb.WriteString(fmt.Sprintf(\"%spriority: %d\\n\", indent, *p.priority))","+\t}","+}","+","+// --- Template ---","+","+// Enabled turns the policy on only when the condition holds. It is written as","+// config.enabled: the PolicyDefinition webhook accepts only a literal for a","+// root-level enabled.","+func (pt *PolicyTemplate) Enabled(cond Condition) *PolicyTemplate {","+\tpt.enabled = cond","+\treturn pt","+}","+","+// Output returns the builder for what the policy changes on the Application.","+func (pt *PolicyTemplate) Output() *PolicyOutput {","+\tif pt.output == nil {","+\t\tpt.output = &PolicyOutput{res: &Resource{}}","+\t}","+\treturn pt.output","+}","+","+// PolicyOutput builds an Application-scoped policy's output. It offers only the","+// fields the controller accepts there.","+type PolicyOutput struct {","+\tres *Resource","+}","+","+// Components replaces the Application's components. An empty list leaves them","+// as they are: the controller applies output.components only when it has entries.","+func (o *PolicyOutput) Components(v Value) *PolicyOutput {","+\to.res.Set(\"components\", v)","+\treturn o","+}","+","+// Workflow replaces the Application's workflow.","+func (o *PolicyOutput) Workflow(v Value) *PolicyOutput {","+\to.res.Set(\"workflow\", v)","+\treturn o","+}","+","+// Policies replaces the Application's policies. As with Components, an empty","+// list leaves them as they are.","+func (o *PolicyOutput) Policies(v Value) *PolicyOutput {","+\to.res.Set(\"policies\", v)","+\treturn o","+}","+","+// Label sets a label on the Application.","+func (o *PolicyOutput) Label(key string, v Value) *PolicyOutput {","+\to.res.Set(\"labels[\"+key+\"]\", v)","+\treturn o","+}","+","+// Annotation sets an annotation on the Application.","+func (o *PolicyOutput) Annotation(key string, v Value) *PolicyOutput {","+\to.res.Set(\"annotations[\"+key+\"]\", v)","+\treturn o","+}","+","+// Ctx sets a dotted path under ctx, which components and traits read as","+// context.custom.<path>.","+func (o *PolicyOutput) Ctx(path string, v Value) *PolicyOutput {","+\to.res.Set(\"ctx.\"+path, v)","+\treturn o","+}","+","+// writePolicyOutput writes the output block from its field operations.","+func (g *PolicyCUEGenerator) writePolicyOutput(sb *strings.Builder, gen *CUEGenerator, o *PolicyOutput) {","+\tsb.WriteString(fmt.Sprintf(\"%soutput: {\\n\", g.indent))","+\tgen.writeFieldTree(sb, gen.buildFieldTree(o.res.Ops()), 2)","+\tsb.WriteString(fmt.Sprintf(\"%s}\\n\", g.indent))","+}","+","+// --- Components transform ---","+","+// AppComponentsTransform rewrites every component of the Application, for use","+// with PolicyOutput.Components.","+type AppComponentsTransform struct {","+\ttraits []appendedTrait","+}","+","+type appendedTrait struct {","+\ttyp        string","+\tproperties map[string]Value","+}","+","+func (t *AppComponentsTransform) value() {}","+func (t *AppComponentsTransform) expr()  {}","+","+// AppComponents starts a transform of context.appComponents that keeps each","+// component as written.","+func AppComponents() *AppComponentsTransform {","+\treturn &AppComponentsTransform{}","+}","+","+// AddTrait appends a trait to every component, after the traits it already has.","+func (t *AppComponentsTransform) AddTrait(traitType string, properties map[string]Value) *AppComponentsTransform {","+\tt.traits = append(t.traits, appendedTrait{typ: traitType, properties: properties})","+\treturn t","+}","+","+// RenderCUE implements CUERenderer.","+func (t *AppComponentsTransform) RenderCUE(rv func(Value) string) string {","+\tif len(t.traits) == 0 {","+\t\treturn \"context.appComponents\"","+\t}","+\ttraits := []string{\"for t in *c.traits | [] {t}\"}","+\tfor _, tr := range t.traits {","+\t\tkeys := make([]string, 0, len(tr.properties))","+\t\tfor k := range tr.properties {","+\t\t\tkeys = append(keys, k)","+\t\t}","+\t\tsort.Strings(keys)","+\t\tprops := make([]string, 0, len(keys))","+\t\tfor _, k := range keys {","+\t\t\tprops = append(props, fmt.Sprintf(\"%s: %s\", propertyLabel(k), rv(tr.properties[k])))","+\t\t}","+\t\ttraits = append(traits, fmt.Sprintf(\"{type: %q, properties: {%s}}\", tr.typ, strings.Join(props, \", \")))","+\t}","+\treturn fmt.Sprintf(`[for c in context.appComponents {{for k, v in c if k != \"traits\" {(k): v}}, traits: [%s]}]`,","+\t\tstrings.Join(traits, \", \"))","+}","+","+// propertyLabel writes a trait property key as a CUE label. Any key that is not","+// a plain identifier is quoted, since \"#\" and \"_\" would make a definition or a","+// hidden field of it.","+func propertyLabel(k string) string {","+\tif ast.IsValidIdent(k) && !strings.HasPrefix(k, \"#\") && !strings.HasPrefix(k, \"_\") {","+\t\treturn k","+\t}","+\treturn strconv.Quote(k)","+}"],"additions":231,"deletions":0,"truncated":false},{"path":"pkg/definition/defkit/app_policy_test.go","lines":["@@ -0,0 +1,164 @@","+/*","+Copyright 2025 The KubeVela Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package defkit_test","+","+import (","+\t\"encoding/json\"","+\t\"strings\"","+","+\t\"cuelang.org/go/cue\"","+\t\"cuelang.org/go/cue/cuecontext\"","+\t. \"github.com/onsi/ginkgo/v2\"","+\t. \"github.com/onsi/gomega\"","+","+\t\"github.com/oam-dev/kubevela/apis/core.oam.dev/v1beta1\"","+\t\"github.com/oam-dev/kubevela/pkg/definition/defkit\"","+)","+","+// policySpec parses generated CUE the way apply-module does, strictly into the","+// typed PolicyDefinitionSpec.","+func policySpec(cueStr string) v1beta1.PolicyDefinitionSpec {","+\tbs, err := json.Marshal(fromCUE(cueStr))","+\tExpectWithOffset(1, err).NotTo(HaveOccurred())","+\tvar spec v1beta1.PolicyDefinitionSpec","+\tExpectWithOffset(1, json.Unmarshal(bs, &spec)).To(Succeed())","+\treturn spec","+}","+","+// defkitTemplateOnly returns the body of the definition's template block, which","+// the controller compiles together with the context and parameter.","+func defkitTemplateOnly(cueStr string) string {","+\tstart := strings.Index(cueStr, \"\\ntemplate: {\\n\")","+\tExpectWithOffset(2, start).To(BeNumerically(\">=\", 0), cueStr)","+\tbody := cueStr[start+len(\"\\ntemplate: {\\n\"):]","+\treturn body[:strings.LastIndex(body, \"}\")]","+}","+","+// evalTemplate fills the policy template with a context and parameter, as the","+// controller does, and returns the evaluated template.","+func evalTemplate(cueStr, contextJSON, parameterJSON string) cue.Value {","+\tdef := defkitTemplateOnly(cueStr)","+\tctx := cuecontext.New()","+\tv := ctx.CompileString(def + \"\\ncontext: \" + contextJSON + \"\\nparameter: \" + parameterJSON)","+\tExpectWithOffset(1, v.Err()).NotTo(HaveOccurred(), def)","+\tExpectWithOffset(1, v.Validate(cue.Concrete(true))).To(Succeed(), def)","+\treturn v","+}","+","+var _ = Describe(\"Application-scoped policies\", func() {","+\tsidecar := func() *defkit.PolicyDefinition {","+\t\tvela := defkit.VelaCtx()","+\t\treturn defkit.NewPolicy(\"sidecar-injector\").","+\t\t\tApplicationScoped().","+\t\t\tParams(defkit.String(\"image\").Default(\"fluent-bit:3.0\")).","+\t\t\tTemplate(func(tpl *defkit.PolicyTemplate) {","+\t\t\t\ttpl.Enabled(defkit.Not(defkit.PathExists(`context.appAnnotations[\"logging.io/opt-out\"]`)))","+\t\t\t\ttpl.Output().","+\t\t\t\t\tComponents(defkit.AppComponents().AddTrait(\"sidecar\", map[string]defkit.Value{","+\t\t\t\t\t\t\"name\":  defkit.Lit(\"logger\"),","+\t\t\t\t\t\t\"image\": defkit.ParamRef(\"image\"),","+\t\t\t\t\t})).","+\t\t\t\t\tAnnotation(\"logging.io/injected-by\", vela.PolicyName()).","+\t\t\t\t\tCtx(\"logging.sidecar\", defkit.ParamRef(\"image\"))","+\t\t\t})","+\t}","+","+\tIt(\"writes scope, global and priority where the spec reads them\", func() {","+\t\tspec := policySpec(defkit.NewPolicy(\"p\").Global().Priority(100).","+\t\t\tTemplate(func(tpl *defkit.PolicyTemplate) {","+\t\t\t\ttpl.Output().Label(\"compliance.io/managed-by\", defkit.Lit(\"kubevela\"))","+\t\t\t}).ToCue())","+\t\tExpect(spec.Scope).To(Equal(v1beta1.ApplicationScope))","+\t\tExpect(spec.Global).To(BeTrue())","+\t\tExpect(spec.Priority).To(Equal(int32(100)))","+\t})","+","+\tIt(\"leaves a policy without them output-scoped\", func() {","+\t\tspec := policySpec(defkit.NewPolicy(\"p\").","+\t\t\tTemplate(func(tpl *defkit.PolicyTemplate) { tpl.Set(\"x\", defkit.Lit(1)) }).ToCue())","+\t\tExpect(spec.Scope).To(BeEmpty())","+\t\tExpect(spec.Global).To(BeFalse())","+\t\tExpect(spec.Priority).To(BeZero())","+\t})","+","+\tIt(\"renders a template the controller can evaluate\", func() {","+\t\tv := evalTemplate(sidecar().ToCue(), `{","+\t\t\tpolicyName: \"logging\"","+\t\t\tappAnnotations: {}","+\t\t\tappComponents: [","+\t\t\t\t{name: \"a\", type: \"webservice\", properties: {port: 80}},","+\t\t\t\t{name: \"b\", type: \"webservice\", properties: {}, traits: [{type: \"scaler\", properties: replicas: 2}]},","+\t\t\t]","+\t\t}`, `{image: \"fluent-bit:3.1\"}`)","+","+\t\t// config.enabled is the documented form; admission refuses an expression at the root.","+\t\tExpect(v.LookupPath(cue.ParsePath(\"enabled\")).Exists()).To(BeFalse())","+\t\tExpect(v.LookupPath(cue.ParsePath(\"config.enabled\")).Bool()).To(BeTrue())","+\t\tvar out struct {","+\t\t\tComponents  []map[string]any          `json:\"components\"`","+\t\t\tAnnotations map[string]string         `json:\"annotations\"`","+\t\t\tCtx         map[string]map[string]any `json:\"ctx\"`","+\t\t}","+\t\tExpect(v.LookupPath(cue.ParsePath(\"output\")).Decode(&out)).To(Succeed())","+\t\tsidecarTrait := map[string]any{\"type\": \"sidecar\", \"properties\": map[string]any{\"name\": \"logger\", \"image\": \"fluent-bit:3.1\"}}","+\t\tExpect(out.Components).To(Equal([]map[string]any{","+\t\t\t{\"name\": \"a\", \"type\": \"webservice\", \"properties\": map[string]any{\"port\": int64(80)}, \"traits\": []any{sidecarTrait}},","+\t\t\t{\"name\": \"b\", \"type\": \"webservice\", \"properties\": map[string]any{}, \"traits\": []any{","+\t\t\t\tmap[string]any{\"type\": \"scaler\", \"properties\": map[string]any{\"replicas\": int64(2)}},","+\t\t\t\tsidecarTrait,","+\t\t\t}},","+\t\t}))","+\t\tExpect(out.Annotations).To(Equal(map[string]string{\"logging.io/injected-by\": \"logging\"}))","+\t\tExpect(out.Ctx).To(Equal(map[string]map[string]any{\"logging\": {\"sidecar\": \"fluent-bit:3.1\"}}))","+\t})","+","+\tIt(\"quotes trait property keys that are not CUE identifiers\", func() {","+\t\tp := defkit.NewPolicy(\"p\").ApplicationScoped().Template(func(tpl *defkit.PolicyTemplate) {","+\t\t\ttpl.Output().Components(defkit.AppComponents().AddTrait(\"t\", map[string]defkit.Value{","+\t\t\t\t\"1port\": defkit.Lit(1), \"foo:bar\": defkit.Lit(2), \"#def\": defkit.Lit(3), \"_hidden\": defkit.Lit(4), \"plain\": defkit.Lit(5),","+\t\t\t}))","+\t\t})","+\t\tv := evalTemplate(p.ToCue(), `{appComponents: [{name: \"a\", type: \"webservice\"}]}`, `{}`)","+\t\tvar props map[string]any","+\t\tExpect(v.LookupPath(cue.ParsePath(\"output.components[0].traits[0].properties\")).Decode(&props)).To(Succeed())","+\t\tExpect(props).To(Equal(map[string]any{","+\t\t\t\"1port\": int64(1), \"foo:bar\": int64(2), \"#def\": int64(3), \"_hidden\": int64(4), \"plain\": int64(5),","+\t\t}))","+\t})","+","+\tIt(\"disables itself when the Application opts out\", func() {","+\t\tv := evalTemplate(sidecar().ToCue(), `{","+\t\t\tpolicyName: \"logging\"","+\t\t\tappAnnotations: \"logging.io/opt-out\": \"true\"","+\t\t\tappComponents: []","+\t\t}`, `{image: \"x\"}`)","+\t\tExpect(v.LookupPath(cue.ParsePath(\"config.enabled\")).Bool()).To(BeFalse())","+\t})","+","+\tDescribeTable(\"Register refuses what only an Application-scoped policy may set\",","+\t\tfunc(def defkit.Definition, want string) {","+\t\t\tExpect(func() { defkit.Register(def) }).To(PanicWith(ContainSubstring(want)))","+\t\t},","+\t\tEntry(\"priority\", defkit.NewPolicy(\"p\").Priority(1), \"Application-scoped\"),","+\t\tEntry(\"output\", defkit.NewPolicy(\"p\").Template(func(tpl *defkit.PolicyTemplate) {","+\t\t\ttpl.Output().Label(\"a\", defkit.Lit(\"b\"))","+\t\t}), \"Application-scoped\"),","+\t\tEntry(\"enabled\", defkit.NewPolicy(\"p\").Template(func(tpl *defkit.PolicyTemplate) {","+\t\t\ttpl.Enabled(defkit.Eq(defkit.Lit(1), defkit.Lit(1)))","+\t\t}), \"Application-scoped\"),","+\t)","+})"],"additions":164,"deletions":0,"truncated":false},{"path":"pkg/definition/defkit/base.go","lines":["@@ -17,6 +17,7 @@ limitations under the License."," package defkit"," "," import (","+\t\"github.com/oam-dev/kubevela/apis/core.oam.dev/common\""," \t\"github.com/oam-dev/kubevela/pkg/definition/defkit/placement\""," )"," ","@@ -54,6 +55,8 @@ type baseDefinition struct {"," \t// Placement constraints for cluster-aware definition deployment"," \trunOn    []placement.Condition"," \tnotRunOn []placement.Condition","+\t// Namespaces allowed to use the definition, and its per-namespace quota","+\trestrictions *common.DefinitionRestrictions"," }"," "," // --- Builder methods (used by embedding types) ---"],"additions":3,"deletions":0,"truncated":false},{"path":"pkg/definition/defkit/component.go","lines":["@@ -17,6 +17,7 @@ limitations under the License."," package defkit"," "," import (","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\""," \t\"sigs.k8s.io/yaml\""," "," \t\"github.com/oam-dev/kubevela/apis/core.oam.dev/common\"","@@ -156,6 +157,33 @@ func (c *ComponentDefinition) Version(v string) *ComponentDefinition {"," \treturn c"," }"," ","+// RestrictNamespaces limits the definition to namespaces matching any of the","+// names or path.Match globs. With RestrictNamespaceSelector, matching either is enough.","+func (c *ComponentDefinition) RestrictNamespaces(namespaces ...string) *ComponentDefinition {","+\tc.addRestrictNamespaces(namespaces...)","+\treturn c","+}","+","+// RestrictNamespaceSelector limits the definition to namespaces matching the","+// selector. With RestrictNamespaces, matching either is enough.","+func (c *ComponentDefinition) RestrictNamespaceSelector(selector *metav1.LabelSelector) *ComponentDefinition {","+\tc.setRestrictNamespaceSelector(selector)","+\treturn c","+}","+","+// Quota caps how many times each namespace may use this ComponentDefinition, counted","+// across its Applications and separately from any TraitDefinition quota. The","+// first entry matching a namespace applies.","+//","+//\tQuota(","+//\t    defkit.QuotaFor(\"tenant-dev-*\").Limit(3),","+//\t    defkit.DefaultQuota().Warn(5),","+//\t)","+func (c *ComponentDefinition) Quota(entries ...*NamespaceQuota) *ComponentDefinition {","+\tc.addQuota(entries...)","+\treturn c","+}","+"," // DefName implements Definition.DefName - returns the definition name."," func (c *ComponentDefinition) DefName() string { return c.name }"," ","@@ -351,6 +379,8 @@ func (c *ComponentDefinition) ToYAML() ([]byte, error) {"," \t\tcr[\"spec\"].(map[string]any)[\"version\"] = c.GetVersion()"," \t}"," ","+\tsetRestrictionsSpec(cr[\"spec\"].(map[string]any), c.GetRestrictions())","+"," \treturn yaml.Marshal(cr)"," }"," "],"additions":30,"deletions":0,"truncated":false},{"path":"pkg/definition/defkit/context.go","lines":["@@ -16,6 +16,8 @@ limitations under the License."," "," package defkit"," ","+import \"fmt\"","+"," // ContextRef represents a reference to a context value."," // Context values are runtime values provided by KubeVela."," type ContextRef struct {","@@ -170,6 +172,73 @@ func (c *VelaContext) Outputs(name string) *ContextRef {"," \treturn &ContextRef{path: \"context.outputs.\" + name}"," }"," ","+// AppComponents returns the Application's components, as an Application-scoped","+// policy sees them.","+func (c *VelaContext) AppComponents() *ContextRef {","+\treturn &ContextRef{path: \"context.appComponents\"}","+}","+","+// AppWorkflow returns the Application's workflow, as an Application-scoped policy sees it.","+func (c *VelaContext) AppWorkflow() *ContextRef {","+\treturn &ContextRef{path: \"context.appWorkflow\"}","+}","+","+// AppPolicies returns the Application's policies, as an Application-scoped policy sees them.","+func (c *VelaContext) AppPolicies() *ContextRef {","+\treturn &ContextRef{path: \"context.appPolicies\"}","+}","+","+// AppLabels returns the Application's labels, without KubeVela's internal ones.","+func (c *VelaContext) AppLabels() *ContextRef {","+\treturn &ContextRef{path: \"context.appLabels\"}","+}","+","+// AppAnnotations returns the Application's annotations, without KubeVela's internal ones.","+func (c *VelaContext) AppAnnotations() *ContextRef {","+\treturn &ContextRef{path: \"context.appAnnotations\"}","+}","+","+// AppAnnotation returns one of the Application's annotations.","+func (c *VelaContext) AppAnnotation(key string) *ContextRef {","+\treturn &ContextRef{path: fmt.Sprintf(\"context.appAnnotations[%q]\", key)}","+}","+","+// AppLabel returns one of the Application's labels.","+func (c *VelaContext) AppLabel(key string) *ContextRef {","+\treturn &ContextRef{path: fmt.Sprintf(\"context.appLabels[%q]\", key)}","+}","+","+// PolicyName returns the name the Application gives the policy.","+func (c *VelaContext) PolicyName() *ContextRef {","+\treturn &ContextRef{path: \"context.policyName\"}","+}","+","+// PolicyType returns the policy's definition name.","+func (c *VelaContext) PolicyType() *ContextRef {","+\treturn &ContextRef{path: \"context.policyType\"}","+}","+","+// PolicyRevision returns the revision number of the policy's definition.","+func (c *VelaContext) PolicyRevision() *ContextRef {","+\treturn &ContextRef{path: \"context.policyRevision\"}","+}","+","+// PolicyRevisionName returns the name of the policy definition's revision.","+func (c *VelaContext) PolicyRevisionName() *ContextRef {","+\treturn &ContextRef{path: \"context.policyRevisionName\"}","+}","+","+// PolicyRevisionHash returns the hash of the policy definition's revisio