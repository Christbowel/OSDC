rgs,","     UpdateArgs, VersionArgs, ViewArgs, WhoamiArgs, WhyArgs, WithArgs,","@@ -268,8 +268,8 @@ pub enum CliCommand {","     // Registered rather than left to the external-subcommand fallback so","     // it names npm instead of failing as a missing package script.","     Edit(NotImplementedArgs),","-    /// Not implemented in pnpm. Use the npm CLI directly.","-    Profile(NotImplementedArgs),","+    /// Change settings on your registry profile.","+    Profile(ProfileArgs),","     /// Manage authentication tokens on the registry.","     Token(TokenArgs),","     /// Not implemented in pnpm. Use the npm CLI directly."],"additions":4,"deletions":4,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch/configuration.rs","lines":["@@ -141,6 +141,7 @@ fn talks_only_to_the_registry(command: &CliCommand) -> bool {","             | CliCommand::Logout(_)","             | CliCommand::Owner(_)","             | CliCommand::Ping(_)","+            | CliCommand::Profile(_)","             | CliCommand::Repo(_)","             | CliCommand::Search(_)","             | CliCommand::Star(_)"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/dispatch/routing.rs","lines":["@@ -79,6 +79,7 @@ fn route_registry<'a>(command: CliCommand, ctx: &RunCtx<'a>) -> miette::Result<C","         CliCommand::Repo(args) => dispatch_query::repo(ctx, args),","         CliCommand::Login(args) => dispatch_query::login(ctx, args),","         CliCommand::Logout(args) => dispatch_query::logout(ctx, args),","+        CliCommand::Profile(args) => dispatch_query::profile(ctx, args),","         command => route_project(command, ctx),","     }"," }","@@ -96,7 +97,6 @@ fn route_project<'a>(command: CliCommand, ctx: &RunCtx<'a>) -> miette::Result<Co","         CliCommand::Restart(args) => dispatch_script::restart(ctx, args),","         CliCommand::Pkg(args) => dispatch_script::pkg(ctx, args),","         CliCommand::Edit(_) => dispatch_query::not_implemented(\"edit\"),","