q)]","+pub struct CliLayer {","+    /// Every `--config.<key>=<value>` token, as given and in argv order.","+    /// [`Config::current`] reads it as the top `.npmrc` layer, and it is","+    /// forwarded to a child pnpm the command spawns.","+    pub npmrc_tokens: Vec<(String, String)>,","+","+    /// The default registry: `--registry`, else the last","+    /// `--config.registry`. Unscoped credentials of","+    /// [`Self::npmrc_tokens`] pin to it.","+    pub registry: Option<String>,","+","+    /// The `--config.@<scope>:registry` routes, keyed by `@<scope>`.","+    pub scoped_registries: BTreeMap<String, String>,","+","+    /// The values of settings the CLI has no handling of its own for,","+    /// keyed by kebab-case name. [`Config::current`] applies them above","+    /// `PNPM_CONFIG_*` and before the derivations that read the final","+    /// settings, such as the lockfile-dir anchoring and the global virtual","+    /// store.","+    pub setting_values: BTreeMap<String, String>,","+}","+","+impl Config {","+    /// Point the default registry at `registry`, in the named-registry map","+    /// and the package-manager bootstrap too, and record it as set on the","+    /// command line. The URL is normalized to a trailing slash first, so a","+    /// normalized override applies idempotently.","+    pub fn apply_registry_override(&mut self, registry: &str) {","+        let registry = normalize_registry_url(registry).into_owned();","+        self.registry.clone_from(&registry);","+        self.registries_by_scope.insert(\"default\".to_string(), registry.clone());","+        self.package_manager_bootstrap.registry.clone_from(&registry);","+        self.package_manager_bootstrap.registries.insert(\"default\".to_string(), registry);","+        self.cli_settings.insert(\"registry\".to_string());","+    }","+","+    /// Apply the [`CliLayer`] registry routes over every other source.","+    /// Callers that change registries after the load, such as the","+    /// `updateConfig` hooks, call it again to keep the command line on top.","+    pub fn apply_cli_registries(&mut self) {","+        if let Some(registry) = self.cli.registry.clone() {","+            self.apply_registry_override(&registry);","+        }","+        for (scope, registry) in &self.cli.scoped_registries {","+            self.registries_by_scope.insert(scope.clone(), registry.clone());","+            self.package_manager_bootstrap.registries.insert(scope.clone(), registry.clone());","+        }","+    }","+}"],"additions":57,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/env_overlay.rs","lines":["@@ -5,7 +5,7 @@"," //! for every key in the schema and applies it to the config *after*"," //! `pnpm-workspace.yaml`."," //! The command line's `--config.<key>=<value>` values read through the same","-//! field list; see [`crate::Config::cli_setting_values`].","+//! field list; see [`crate::CliLayer::setting_values`]."," //!"," //! Pacquet does NOT read `npm_config_*` / `NPM_CONFIG_*` env vars (with"," //! the exception of `NPM_CONFIG_WORKSPACE_DIR`, a fallback of the"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/lib.rs","lines":["@@ -30,6 +30,7 @@ pub use crate::{"," };"," pub use boot_config::BootConfig;"," pub use cas::{CAS_LOADER_FILENAME, CAS_MANIFEST_FILENAME};","+pub use cli_layer::CliLayer;"," pub use loading::ConfigLoadFailure;"," pub use network_policy::NetworkPolicy;"," pub use node_linker::{NodeLinkerOptions, NodeLinkerSetting};","@@ -67,6 +68,7 @@ mod api;"," mod boot_config;"," mod cas;"," mod ci_detection;","+mod cli_layer;"," mod defaults;"," mod env_overlay;"," mod global_bin_check;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/loading.rs","lines":["@@ -19,7 +19,8 @@ impl Config {","     /// Config sources (low → high precedence): `SmartDefault`, the supported","     /// `.npmrc` subset (cwd, falling back to home), global `config.yaml`,","     /// project `pnpm-workspac