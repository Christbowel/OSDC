il.HashMap;","+import java.util.HashSet;","+import java.util.LinkedHashMap;","+import java.util.LinkedHashSet;","+import java.util.List;","+import java.util.Map;","+import java.util.Optional;","+import java.util.Set;","+","+import static java.util.stream.Collectors.joining;","+import static java.util.stream.Collectors.toUnmodifiableMap;","+","+/**","+ * Tracks which views lead to each index pattern.","+ *","+ * @param chainsByPattern index pattern read by a view, mapped to the view chains leading to it","+ */","+public record IndexViewOrigins(Map<String, Set<List<String>>> chainsByPattern) {","+","+    public static final IndexViewOrigins EMPTY = new IndexViewOrigins(Map.of());","+","+    public IndexViewOrigins {","+        chainsByPattern = chainsByPattern.entrySet().stream().collect(toUnmodifiableMap(Map.Entry::getKey, e -> Set.copyOf(e.getValue())));","+    }","+","+    /**","+     * Error message suffix naming the views that lead to {@code indexExpression}, if there are any.","+     */","+    public Optional<String> describe(String indexExpression) {","+        Set<String> indices = new LinkedHashSet<>();","+        for (String pattern : Strings.splitStringByCommaToArray(indexExpression)) {","+            if (isExclusion(pattern) == false) {","+                indices.add(pattern);","+            }","+        }","+        Map<String, String> descriptions = new LinkedHashMap<>();","+        for (String index : indices) {","+            Set<List<String>> chains = chainsByPattern.get(index);","+            if (chains != null) {","+                descriptions.put(index, describeChains(chains));","+            }","+        }","+        if (descriptions.isEmpty()) {","+            return Optional.empty();","+        }","+        Set<String> distinct = new HashSet<>(descriptions.values());","+        if (descriptions.size() == indices.size() && distinct.size() == 1) {","+            return Optional.of(distinct.iterator().next());","+        }","+        return Optional.of(","+            descriptions.entrySet().stream().map(e -> \"[\" + e.getKey() + \"] \" + e.getValue()).collect(joining(\"; \", \"(\", \")\"))","+        );","+    }","+","+    private static boolean isExclusion(String pattern) {","+        return pattern.startsWith(\"-\") || pattern.contains(\":-\");","+    }","+","+    private static String describeChains(Set<List<String>> chains) {","+        List<String> rendered = chains.stream().map(chain -> \"[\" + String.join(\" -> \", chain) + \"]\").sorted().toList();","+        return (rendered.size() == 1 ? \"referenced by view \" : \"referenced by views \") + String.join(\", \", rendered);","+    }","+","+    /**","+     * Collects view chains while views are resolved.","+     */","+    static final class Builder {","+","+        private final Map<String, Set<List<String>>> chainsByPattern = new HashMap<>();","+","+        /**","+         * Records that {@code indexPattern} is read through {@code viewChain}, outermost view first.","+         */","+        void record(String indexPattern, Collection<String> viewChain) {","+            if (viewChain.isEmpty()) {","+                return;","+            }","+            List<String> chain = List.copyOf(viewChain);","+            for (String pattern : Strings.splitStringByCommaToArray(indexPattern)) {","+                chainsByPattern.computeIfAbsent(pattern, k -> new HashSet<>()).add(chain);","+            }","+        }","+","+        IndexViewOrigins build() {","+            return new IndexViewOrigins(chainsByPattern);","+        }","+    }","+}"],"additions":100,"deletions":0,"truncated":false},{"path":"x-pack/plugin/esql/src/main/java/org/elasticsearch/xpack/esql/view/ViewResolver.java","lines":["@@ -171,12 +171,18 @@ protected boolean viewsFeatureEnabled() {","     }"," ","     /**","-     * Result of view resolution containing the rewritten plan, the view queries, and whether any {@code InSubquery} expression was","-     * rewritten into a {@code SemiJoin}/{@c