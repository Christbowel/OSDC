lsa.Workflows.Core/3.9.0\": {\"type\": \"package\"}},","             }","         self.names = {path: Path(path).stem for path in self.documents}","+        inventory = patch(\"current_import_impact.current_apps_projects\", return_value=[self.root / path for path in self.apps])","+        self.inventory = inventory.start()","+        self.addCleanup(inventory.stop)","         self.solution = set(self.names)"," ","     def partition(self):","@@ -235,6 +233,18 @@ def test_registered_consumers_are_explicitly_separate_from_source_graph(self):","         self.assertEqual(set(documents), set(assets()))","         reject_unmapped_elsa_packages(documents)"," ","+    def test_new_current_registered_consumer_is_accounted_for(self):","+        path = \"apps/src/NewHost/NewHost.csproj\"","+        self.apps.add(path)","+        self.names[path] = \"NewHost\"","+        self.documents[path] = copy.deepcopy(self.documents[next(iter(self.apps - {path}))])","+        self.solution.add(path)","+        self.inventory.return_value = [self.root / project for project in self.apps]","+        names, documents, independent = self.partition()","+        self.assertIn(path, independent)","+        self.assertNotIn(path, names)","+        reject_unmapped_elsa_packages(documents)","+","     def test_missing_or_unregistered_apps_solution_member_is_rejected(self):","         original = self.solution.copy()","         for mutate in (","@@ -244,7 +254,7 @@ def test_missing_or_unregistered_apps_solution_member_is_rejected(self):","             with self.subTest(mutate=mutate):","                 self.solution = original.copy()","                 mutate()","-                with self.assertRaisesRegex(ValueError, \"exactly the nine registered\"):","+                with self.assertRaisesRegex(ValueError, \"current tracked/filter/solution\"):","                     self.partition()"," ","     def test_project_references_cannot_cross_the_consumer_boundary(self):"],"additions":19,"deletions":9,"trunc