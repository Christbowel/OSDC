{"id":"aeafd12f2a7b51a6af780f1344b083599d88fec1","axis":"silent","repo":"mongodb/mongo","sha":"aeafd12f2a7b51a6af780f1344b083599d88fec1","parsed":{"files":[{"path":"jstests/aggregation/expressions/null_chars_string_input.js","lines":["@@ -414,6 +414,7 @@ const skips = new Set([","     \"$_internalChangeStreamAddPreImage\",","     \"$_internalChangeStreamCheckInvalidate\",","     \"$_internalChangeStreamCheckResumability\",","+    \"$_internalChangeStreamConvertErrors\",","     \"$_internalChangeStreamHandleTopologyChange\",","     \"$_internalChangeStreamInjectControlEvents\",","     \"$_internalChangeStreamOplogMatch\","],"additions":1,"deletions":0,"truncated":false},{"path":"jstests/aggregation/parsing/internal_stage_user_rejection.js","lines":["@@ -96,6 +96,7 @@ const kInternalClientTypeStages = new Set([","     \"$_internalChangeStreamAddPreImage\",","     \"$_internalChangeStreamCheckInvalidate\",","     \"$_internalChangeStreamCheckResumability\",","+    \"$_internalChangeStreamConvertErrors\",","     \"$_internalChangeStreamHandleTopologyChange\",","     \"$_internalChangeStreamInjectControlEvents\",","     \"$_internalChangeStreamOplogMatch\","],"additions":1,"deletions":0,"truncated":false},{"path":"jstests/auth/lib/commands_lib.js","lines":["@@ -9266,6 +9266,25 @@ export const authCommandsLib = {","                 },","             ],","         },","+        {","+            testname: \"aggregate_$_internalChangeStreamConvertErrors\",","+            command: {","+                aggregate: 1,","+                pipeline: [{$_internalChangeStreamConvertErrors: {}}],","+                cursor: {},","+            },","+            testcases: [","+                {","+                    runOnDb: firstDbName,","+                    roles: {__system: 1},","+                    privileges: [","+                        {resource: {db: firstDbName, collection: \"\"}, actions: [\"find\"]},","+                        {resource: {cluster: true}, actions: [\"internal\"]},","+                    ],","+                    expectFail: true,","+                },","+            ],","+        },","         {","             testname: \"aggregate_$_internalChangeStreamInjectControlEvents\",","             command: {"],"additions":19,"deletions":0,"truncated":false},{"path":"jstests/core/timeseries/query/agg_stage_coverage.js","lines":["@@ -453,6 +453,7 @@ const skippedStages = [","     \"$_internalChangeStreamCheckInvalidate\",","     \"$_internalChangeStreamCheckResumability\",","     \"$_internalChangeStreamCheckTopologyChange\",","+    \"$_internalChangeStreamConvertErrors\",","     \"$_internalChangeStreamHandleTopologyChange\",","     \"$_internalChangeStreamInjectControlEvents\",","     \"$_internalChangeStreamOplogMatch\","],"additions":1,"deletions":0,"truncated":false},{"path":"src/mongo/db/exec/agg/change_stream_convert_errors_stage.cpp","lines":["@@ -0,0 +1,102 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/exec/agg/change_stream_convert_errors_stage.h\"","+","+#include \"mongo/db/exec/agg/document_source_to_stage_registry.h\"","+#include \"mongo/db/pipeline/change_stream_helpers.h\"","+#include \"mongo/db/pipeline/document_source_change_stream_convert_errors.h\"","+#include \"mongo/util/assert_util.h\"","+","+#include <string_view>","+#include <utility>","+","+namespace mongo {","+","+boost::intrusive_ptr<exec::agg::Stage> documentSourceChangeStreamConvertErrorsToStageFn(","+    const boost::intrusive_ptr<DocumentSource>& documentSource) {","+    auto* convertErrorsDS =","+        dynamic_cast<DocumentSourceChangeStreamConvertErrors*>(documentSource.get());","+","+    tassert(13731901, \"expected 'DocumentSourceChangeStreamConvertErrors' type\", convertErrorsDS);","+","+    return make_intrusive<exec::agg::ChangeStreamConvertErrorsStage>(convertErrorsDS->kStageName,","+                                                                     convertErrorsDS->getExpCtx());","+}","+","+namespace exec::agg {","+","+REGISTER_AGG_STAGE_MAPPING(_internalChangeStreamConvertErrors,","+                           DocumentSourceChangeStreamConvertErrors::id,","+                           documentSourceChangeStreamConvertErrorsToStageFn)","+","+GetNextResult ChangeStreamConvertErrorsStage::doGetNext() {","+    // Gather the document to return: a normal change event, or an error event converted from a","+    // recoverable failure raised by the stages below.","+    boost::optional<Document> event;","+    try {","+        auto nextResult = pSource->getNext();","+        while (nextResult.isPaused()) {","+            nextResult = pSource->getNext();","+        }","+","+        // The event in flight has been delivered; drop its identity so a later failure is never","+        // attributed to it. Drop the error-source slot too: a rethrow that escaped the conversion","+        // point must not mislabel a later failure.","+        pExpCtx->clearActiveChangeStreamEvent();","+        pExpCtx->clearActiveChangeStreamErrorSource();","+","+        if (!nextResult.isAdvanced()) {","+            return nextResult;","+        }","+        event = nextResult.releaseDocument();","+    } catch (const ExceptionFor<ErrorCodes::ChangeStreamErrorEventBypass>&) {","+        // An operationType:\"error\" event was thrown past the user stages that could not be pushed","+        // to the shards; return it directly, preserving its sort-key metadata.","+        auto stashed = pExpCtx->releasePendingChangeStreamRouterErrorEvent();","+        tassert(13731902,","+                \"change stream error event bypass without a stashed event\",","+                stashed.has_value());","+        event = std::move(*stashed);","+        // The resumed error event that the bypass carried has been delivered; drop the recorded","+        // identity and error source so a later failure is never attributed to it.","+        pExpCtx->clearActiveChangeStreamEvent();","+        pExpCtx->clearActiveChangeStreamErrorSource();","+    } catch (const DBException& ex) {","+        // A resume gap detected below the user stages: materialize it here, above them. Only the","+        // gap signal itself releases it: the gap must not mask an unrelated failure that raced in","+        // ahead of it.","+        if (ex.code() == ErrorCodes::ChangeStreamHistoryLost) {","+            if (auto gap = pExpCtx->releasePendingChangeStreamResumeGap()) {","+                event = std::move(*gap);","+                // The gap has been delivered; drop the recorded identity and error source so a","+                // later failure is never attributed to it.","+                pExpCtx->clearActiveChangeStreamEvent();","+                pExpCtx->clearActiveChangeStreamErrorSource();","+            }","+        }","+        // A recoverable failure from below: build the error event here, above the user stages,","+        // labelled by the source the producer set. 'tryBuildErrorEvent' is pure, so this stage","+        // owns releasing the recorded identity/source slots once they've been consumed.","+        if (!event.has_value()) {","+            if (auto errorEvent = change_stream::tryBuildErrorEvent(ex, pExpCtx)) {","+                event = std::move(*errorEvent);","+                // The identity was consumed to build the error event; clear it and the source slot.","+                pExpCtx->clearActiveChangeStreamEvent();","+                pExpCtx->clearActiveChangeStreamErrorSource();","+            } else {","+                throw;","+            }","+        }","+    }","+","+    // Reaching here implies 'event' was produced by one of the branches above: a delivered event,","+    // a released bypass or gap event, or a converted error event. Every path that could leave it","+    // empty returned or rethrew.","+    tassert(13731903, \"expected an event after the conversion branches\", event.has_value());","+","+    return GetNextResult{std::move(*event)};","+}","+","+}  // namespace exec::agg","+}  // namespace mongo"],"additions":102,"deletions":0,"truncated":false},{"path":"src/mongo/db/exec/agg/change_stream_convert_errors_stage.h","lines":["@@ -0,0 +1,40 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#pragma once","+","+#include \"mongo/db/exec/agg/stage.h\"","+#include \"mongo/db/pipeline/expression_context.h\"","+#include \"mongo/util/modules.h\"","+","+#include <string_view>","+","+#include <boost/smart_ptr/intrusive_ptr.hpp>","+","+namespace mongo::exec::agg {","+","+/**","+ * The topmost stage of an opted-in ('showErrorsAsEvents: true') change stream pipeline. It owns","+ * the conversion of recoverable failures raised by the stages below it into","+ * 'operationType: \"error\"' events, built from the identity recorded on the ExpressionContext (by","+ * the transform stage, or by a stage that held the event back and re-recorded it on release). It","+ * also materializes a resume gap stashed below the user stages, and releases an error event that a","+ * resume stage threw past the router user stages.","+ *","+ * Installed above every user stage on each node that executes a change stream pipeline, so an","+ * error event is always built above the stages that must not observe it. It is injected","+ * post-optimization, so the optimizer never sees it; it is a DocumentSource (rather than an","+ * exec-only stage) so it shows up in explain on data-bearing nodes (the router's merge-side","+ * explain does not build the cursor, so the router instance does not appear there).","+ */","+class ChangeStreamConvertErrorsStage final : public Stage {","+public:","+    ChangeStreamConvertErrorsStage(std::string_view stageName,","+                                   const boost::intrusive_ptr<ExpressionContext>& pExpCtx)","+        : Stage(stageName, pExpCtx) {}","+","+private:","+    GetNextResult doGetNext() final;","+};","+","+}  // namespace mongo::exec::agg"],"additions":40,"deletions":0,"truncated":false},{"path":"src/mongo/db/exec/agg/change_stream_transform_stage.cpp","lines":["@@ -46,6 +46,16 @@ ChangeStreamTransformStage::ChangeStreamTransformStage("," }"," "," GetNextResult ChangeStreamTransformStage::doGetNext() {","+    // We are about to produce a NEW event. Any identity recorded for the previous event (which has","+    // already been delivered to, or dropped by, the stages above) must not be allowed to survive","+    // into the production of this one: if producing it fails, the stale identity from the prior","+    // event would be used by the top-level conversion stage to mislabel the failure. Clear it","+    // before pulling the next input so it is only ever set for the event currently being produced.","+    if (_showErrorsAsEvents) {","+        pExpCtx->clearActiveChangeStreamEvent();","+        pExpCtx->clearActiveChangeStreamErrorSource();","+    }","+","     auto input = pSource->getNext();","     if (!input.isAdvanced()) {","         return input;"],"additions":10,"deletions":0,"truncated":false},{"path":"src/mongo/db/pipeline/BUILD.bazel","lines":["@@ -1124,6 +1124,7 @@ mongo_cc_library(","         \"document_source_change_stream_add_pre_image.cpp\",","         \"document_source_change_stream_check_invalidate.cpp\",","         \"document_source_change_stream_check_resumability.cpp\",","+        \"document_source_change_stream_convert_errors.cpp\",","         \"document_source_change_stream_end_of_transaction.cpp\",","         \"document_source_change_stream_ensure_resume_token_present.cpp\",","         \"document_source_change_stream_handle_topology_change.cpp\",","@@ -1138,6 +1139,7 @@ mongo_cc_library(","         \"//src/mongo/db/exec/agg:change_stream_add_pre_image_stage.cpp\",","         \"//src/mongo/db/exec/agg:change_stream_check_invalidate_stage.cpp\",","         \"//src/mongo/db/exec/agg:change_stream_check_resumability_stage.cpp\",","+        \"//src/mongo/db/exec/agg:change_stream_convert_errors_stage.cpp\",","         \"//src/mongo/db/exec/agg:change_stream_end_of_transaction_stage.cpp\",","         \"//src/mongo/db/exec/agg:change_stream_ensure_resume_token_present_stage.cpp\",","         \"//src/mongo/db/exec/agg:change_stream_handle_topology_change_stage.cpp\",","@@ -1638,6 +1640,7 @@ mongo_cc_unit_test(","     name = \"db_pipeline_test\",","     srcs = [","         \"aggregation_request_test.cpp\",","+        \"change_stream_convert_errors_stage_test.cpp\",","         \"data_to_shards_allocation_query_service_test.cpp\",","         \"dependencies_test.cpp\",","         \"dispatch_shard_pipeline_test.cpp\",","@@ -1679,6 +1682,7 @@ mongo_cc_unit_test(","     deps = [","         \":aggregation_context_fixture\",","         \":aggregation_request_helper\",","+        \":change_stream_pipeline\",","         \":docs_needed_bounds_visitor\",","         \":document_source_internal_apply_oplog_update\",","         \":document_source_mock\","],"additions":4,"deletions":0,"truncated":false},{"path":"src/mongo/db/pipeline/change_stream_convert_errors_stage_test.cpp","lines":["@@ -0,0 +1,233 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/exec/agg/change_stream_convert_errors_stage.h\"","+","+#include \"mongo/bson/bsonobj.h\"","+#include \"mongo/bson/bsonobjbuilder.h\"","+#include \"mongo/db/exec/agg/mock_stage.h\"","+#include \"mongo/db/exec/agg/stage.h\"","+#include \"mongo/db/exec/document_value/document.h\"","+#include \"mongo/db/pipeline/document_source_change_stream_convert_errors.h\"","+#include \"mongo/db/pipeline/document_source_change_stream_gen.h\"","+#include \"mongo/db/pipeline/document_source_mock.h\"","+#include \"mongo/db/pipeline/expression_context.h\"","+#include \"mongo/db/pipeline/expression_context_for_test.h\"","+#include \"mongo/db/pipeline/pipeline.h\"","+#include \"mongo/db/query/explain_options.h\"","+#include \"mongo/db/query/query_shape/serialization_options.h\"","+#include \"mongo/unittest/unittest.h\"","+#include \"mongo/util/assert_util.h\"","+","+#include <string_view>","+","+#include <boost/smart_ptr/intrusive_ptr.hpp>","+","+namespace mongo {","+namespace {","+","+using namespace std::literals::string_view_literals;","+","+// An event identity as the transform records it: the resume token is both '_id' and the","+// single-element sort key.","+Document recordedIdentity(Value token) {","+    MutableDocument md(Document{{\"_id\"sv, token}});","+    md.metadata().setSortKey(token, true /* isSingleElementKey */);","+    return md.freeze();","+}","+","+/**","+ * A stage that always fails with the given error code, modelling a failure raised by a stage below","+ * the top-level conversion stage.","+ */","+class ThrowingStage final : public exec::agg::Stage {","+public:","+    ThrowingStage(const boost::intrusive_ptr<ExpressionContext>& expCtx, ErrorCodes::Error code)","+        : Stage(\"$throwing\", expCtx), _code(code) {}","+","+    exec::agg::GetNextResult doGetNext() final {","+        uasserted(_code, \"stage failure\");","+        MONGO_UNREACHABLE;","+    }","+","+private:","+    ErrorCodes::Error _code;","+};","+","+class ChangeStreamConvertErrorsStageTest : public unittest::Test {","+protected:","+    boost::intrusive_ptr<exec::agg::ChangeStreamConvertErrorsStage> makeConverter() {","+        return make_intrusive<exec::agg::ChangeStreamConvertErrorsStage>(","+            \"$_internalChangeStreamConvertErrors\", _expCtx);","+    }","+","+    void enableErrorEvents() {","+        DocumentSourceChangeStreamSpec spec;","+        spec.setShowErrorsAsEvents(true);","+        _expCtx->setChangeStreamSpec(spec);","+    }","+","+    boost::intrusive_ptr<ExpressionContext> _expCtx = make_intrusive<ExpressionContextForTest>();","+};","+","+TEST_F(ChangeStreamConvertErrorsStageTest, ConvertsEligibleFailureWithRecordedIdentity) {","+    enableErrorEvents();","+    // The identity the transform would have recorded for the event in flight.","+    _expCtx->setActiveChangeStreamEvent(recordedIdentity(Value(Document{{\"_id\"sv, 42}})));","+","+    auto throwing = make_intrusive<ThrowingStage>(_expCtx, ErrorCodes::TypeMismatch);","+    auto converter = makeConverter();","+    exec::agg::MockStage::setSource_forTest(converter, throwing.get());","+","+    auto result = converter->getNext();","+    ASSERT_TRUE(result.isAdvanced());","+    const auto& doc = result.getDocument();","+    ASSERT_EQ(doc[\"operationType\"].getString(), \"error\");","+    ASSERT_EQ(doc[\"error\"][\"code\"].getInt(), static_cast<int>(ErrorCodes::TypeMismatch));","+    ASSERT_EQ(doc[\"error\"][\"source\"].getString(), \"user-pipeline\");","+    // The identity is cleared after delivery, so a later failure is not blamed on this event.","+    ASSERT_FALSE(_expCtx->getActiveChangeStreamEvent());","+}","+","+TEST_F(ChangeStreamConvertErrorsStageTest, RethrowsEligibleFailureWithoutIdentity) {","+    enableErrorEvents();","+    // No identity recorded: the failure cannot be attributed, so it must propagate (fail closed).","+","+    auto throwing = make_intrusive<ThrowingStage>(_expCtx, ErrorCodes::TypeMismatch);","+    auto converter = makeConverter();","+    exec::agg::MockStage::setSource_forTest(converter, throwing.get());","+","+    ASSERT_THROWS_CODE(converter->getNext(), AssertionException, ErrorCodes::TypeMismatch);","+}","+","+TEST_F(ChangeStreamConvertErrorsStageTest, MaterializesPendingResumeGap) {","+    enableErrorEvents();","+    _expCtx->setPendingChangeStreamResumeGap(Document{{\"gap\"sv, true}});","+","+    auto throwing = make_intrusive<ThrowingStage>(_expCtx, ErrorCodes::ChangeStreamHistoryLost);","+    auto converter = makeConverter();","+    exec::agg::MockStage::setSource_forTest(converter, throwing.get());","+","+    auto result = converter->getNext();","+    ASSERT_TRUE(result.isAdvanced());","+    ASSERT_TRUE(result.getDocument()[\"gap\"].getBool());","+}","+","+TEST_F(ChangeStreamConvertErrorsStageTest, ReleasesPendingRouterErrorEventOnBypass) {","+    enableErrorEvents();","+    _expCtx->setPendingChangeStreamRouterErrorEvent(Document{{\"bypass\"sv, true}});","+","+    auto throwing =","+        make_intrusive<ThrowingStage>(_expCtx, ErrorCodes::ChangeStreamErrorEventBypass);","+    auto converter = makeConverter();","+    exec::agg::MockStage::setSource_forTest(converter, throwing.get());","+","+    auto result = converter->getNext();","+    ASSERT_TRUE(result.isAdvanced());","+    ASSERT_TRUE(result.getDocument()[\"bypass\"].getBool());","+}","+","+// The bypass delivers an operationType:\"error\" event, which means the recorded identity and error","+// source for the in-flight event have been consumed. They must be cleared so a later failure is","+// never attributed to this (already-delivered) event.","+TEST_F(ChangeStreamConvertErrorsStageTest, BypassClearsRecordedIdentity) {","+    enableErrorEvents();","+    _expCtx->setActiveChangeStreamEvent(Document{{\"_id\"sv, 42}});","+    _expCtx->setActiveChangeStreamErrorSource(ChangeStreamErrorSource::kUserPipeline);","+    _expCtx->setPendingChangeStreamRouterErrorEvent(Document{{\"bypass\"sv, true}});","+","+    auto throwing =","+        make_intrusive<ThrowingStage>(_expCtx, ErrorCodes::ChangeStreamErrorEventBypass);","+    auto converter = makeConverter();","+    exec::agg::MockStage::setSource_forTest(converter, throwing.get());","+","+    auto result = converter->getNext();","+    ASSERT_TRUE(result.isAdvanced());","+    ASSERT_TRUE(result.getDocument()[\"bypass\"].getBool());","+    ASSERT_FALSE(_expCtx->getActiveChangeStreamEvent());","+    ASSERT_FALSE(_expCtx->getActiveChangeStreamErrorSource());","+}","+","+// Same invariant for the resume-gap path: once the gap event is delivered, the recorded identity","+// and error source must not survive to mislabel a later failure.","+TEST_F(ChangeStreamConvertErrorsStageTest, ResumeGapClearsRecordedIdentity) {","+    enableErrorEvents();","+    _expCtx->setActiveChangeStreamEvent(Document{{\"_id\"sv, 42}});","+    _expCtx->setActiveChangeStreamErrorSource(ChangeStreamErrorSource::kUserPipeline);","+    _expCtx->setPendingChangeStreamResumeGap(Document{{\"gap\"sv, true}});","+","+    auto throwing = make_intrusive<ThrowingStage>(_expCtx, ErrorCodes::ChangeStreamHistoryLost);","+    auto converter = makeConverter();","+    exec::agg::MockStage::setSource_forTest(converter, throwing.get());","+","+    auto result = converter->getNext();","+    ASSERT_TRUE(result.isAdvanced());","+    ASSERT_TRUE(result.getDocument()[\"gap\"].getBool());","+    ASSERT_FALSE(_expCtx->getActiveChangeStreamEvent());","+    ASSERT_FALSE(_expCtx->getActiveChangeStreamErrorSource());","+}","+","+TEST_F(ChangeStreamConvertErrorsStageTest, DoesNotConvertNonConvertibleError) {","+    enableErrorEvents();","+    _expCtx->setActiveChangeStreamEvent(recordedIdentity(Value(Document{{\"_id\"sv, 42}})));","+","+    // An interruption is never converted, even with a recorded identity.","+    auto throwing = make_intrusive<ThrowingStage>(_expCtx, ErrorCodes::Interrupted);","+    auto converter = makeConverter();","+    exec::agg::MockStage::setSource_forTest(converter, throwing.get());","+","+    ASSERT_THROWS_CODE(converter->getNext(), AssertionException, ErrorCodes::Interrupted);","+}","+","+TEST_F(ChangeStreamConvertErrorsStageTest, DoesNotConvertTransientLookupFailure) {","+    enableErrorEvents();","+    // A lookup (pre-image, post-image or updateLookup) failed transiently on the event in flight:","+    // the identity and the internal-pipeline source are set, as the lookup stage leaves them.","+    _expCtx->setActiveChangeStreamEvent(recordedIdentity(Value(Document{{\"_id\"sv, 42}})));","+    _expCtx->setActiveChangeStreamErrorSource(ChangeStreamErrorSource::kInternalPipeline);","+","+    // The failure propagates so that a resume delivers the event, rather than being converted into","+    // an error event that skips it.","+    auto throwing = make_intrusive<ThrowingStage>(_expCtx, ErrorCodes::WriteConflict);","+    auto converter = makeConverter();","+    exec::agg::MockStage::setSource_forTest(converter, throwing.get());","+","+    ASSERT_THROWS_CODE(converter->getNext(), DBException, ErrorCodes::WriteConflict);","+}","+","+TEST(ChangeStreamConvertErrorsDocumentSourceTest, SerializesForExplain) {","+    auto expCtx = make_intrusive<ExpressionContextForTest>();","+    auto ds = DocumentSourceChangeStreamConvertErrors::create(expCtx);","+","+    auto value = ds->doSerialize(","+        query_shape::SerializationOptions{.verbosity = ExplainOptions::Verbosity::kQueryPlanner});","+","+    ASSERT_BSONOBJ_EQ_AUTO(  // NOLINT","+        R\"({\"$changeStream\": {\"stage\": \"$_internalChangeStreamConvertErrors\"}})\",","+        value.getDocument().toBson());","+}","+","+TEST(ChangeStreamConvertErrorsDocumentSourceTest, SerializesForWire) {","+    auto expCtx = make_intrusive<ExpressionContextForTest>();","+    auto ds = DocumentSourceChangeStreamConvertErrors::create(expCtx);","+","+    ASSERT_BSONOBJ_EQ(ds->doSerialize().getDocument().toBson(),","+                      BSON(\"$_internalChangeStreamConvertErrors\" << BSONObj()));","+}","+","+// The stage must be the final stage of the pipeline: an error event is built there, above every","+// user stage, and must never be observed by a user stage below it.","+TEST(ChangeStreamConvertErrorsConstraintTest, MustBeFinalStage) {","+    auto expCtx = make_intrusive<ExpressionContextForTest>();","+    auto converter = DocumentSourceChangeStreamConvertErrors::create(expCtx);","+    auto mock = DocumentSourceMock::createForTest({Document{}}, expCtx);","+","+    // The stage is the final source: valid.","+    ASSERT_DOES_NOT_THROW(Pipeline::create({mock, converter}, expCtx));","+","+    // The stage placed below another stage: invalid.","+    ASSERT_THROWS_CODE(Pipeline::create({converter, mock}, expCtx), AssertionException, 40601);","+}","+","+}  // namespace","+}  // namespace mongo"],"additions":233,"deletions":0,"truncated":false},{"path":"src/mongo/db/pipeline/document_source_change_stream_convert_errors.cpp","lines":["@@ -0,0 +1,88 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/pipeline/document_source_change_stream_convert_errors.h\"","+","+#include \"mongo/bson/bsonobjbuilder.h\"","+#include \"mongo/bson/bsontypes.h\"","+#include \"mongo/db/pipeline/document_source_change_stream.h\"","+#include \"mongo/util/assert_util.h\"","+#include \"mongo/util/str.h\"","+","+#include <string_view>","+","+#include <boost/smart_ptr/intrusive_ptr.hpp>","+","+namespace mongo {","+using namespace std::literals::string_view_literals;","+","+REGISTER_INTERNAL_LITE_PARSED_DOCUMENT_SOURCE(_internalChangeStreamConvertErrors,","+                                              ChangeStreamConvertErrorsLiteParsed::parse);","+","+REGISTER_DOCUMENT_SOURCE_WITH_STAGE_PARAMS_DEFAULT(_internalChangeStreamConvertErrors,","+                                                   DocumentSourceChangeStreamConvertErrors,","+                                                   ChangeStreamConvertErrorsStageParams);","+","+ALLOCATE_DOCUMENT_SOURCE_ID(_internalChangeStreamConvertErrors,","+                            DocumentSourceChangeStreamConvertErrors::id)","+","+boost::intrusive_ptr<DocumentSourceChangeStreamConvertErrors>","+DocumentSourceChangeStreamConvertErrors::create(","+    const boost::intrusive_ptr<ExpressionContext>& expCtx) {","+    return new DocumentSourceChangeStreamConvertErrors(expCtx);","+}","+","+boost::intrusive_ptr<DocumentSourceChangeStreamConvertErrors>","+DocumentSourceChangeStreamConvertErrors::createFromBson(","+    BSONElement spec, const boost::intrusive_ptr<ExpressionContext>& expCtx) {","+    uassert(13731904,","+            str::stream() << \"the '\" << kStageName << \"' spec must be an empty object\",","+            spec.type() == BSONType::object && spec.Obj().isEmpty());","+    return new DocumentSourceChangeStreamConvertErrors(expCtx);","+}","+","+std::string_view DocumentSourceChangeStreamConvertErrors::getSourceName() const {","+    return kStageName;","+}","+","+StageConstraints DocumentSourceChangeStreamConvertErrors::constraints(PipelineSplitState) const {","+    StageConstraints constraints{StreamType::kStreaming,","+                                 // Must be the final stage (the top of the pipeline, above every","+                                 // user stage): an error event is built there and must never be","+                                 // observed by a user stage below it.","+                                 PositionRequirement::kLast,","+                                 // Runs on whichever node executes the pipeline: the router, or the","+                                 // data-bearing node (standalone, replica set, or shard). Injected","+                                 // post-optimization, so this only matters when a serialized shard","+                                 // pipeline is re-parsed and re-optimized on the shard.","+                                 HostTypeRequirement::kReceivingHostOnly,","+                                 DiskUseRequirement::kNoDiskUse,","+                                 FacetRequirement::kNotAllowed,","+                                 TransactionRequirement::kNotAllowed,","+                                 LookupRequirement::kNotAllowed,","+                                 UnionRequirement::kNotAllowed,","+                                 ChangeStreamRequirement::kChangeStreamStage};","+    // It must stay above every user stage and must not be swapped past by them: an error event is","+    // built above the user stages and must never be observed by them.","+    constraints.canSwapWithMatch = false;","+    constraints.canSwapWithSingleDocTransformOrRedact = false;","+    constraints.consumesLogicalCollectionData = false;","+    constraints.outputDependsOnSingleInput = true;","+    constraints.canAppearOnlyOnceInPipeline = true;","+    return constraints;","+}","+","+Value DocumentSourceChangeStreamConvertErrors::doSerialize(","+    const query_shape::SerializationOptions& opts) const {","+    BSONObjBuilder builder;","+    if (opts.isSerializingForExplain()) {","+        BSONObjBuilder sub(builder.subobjStart(DocumentSourceChangeStream::kStageName));","+        sub.append(\"stage\"sv, kStageName);","+        sub.done();","+    } else {","+        builder.append(kStageName, BSONObj());","+    }","+    return Value(builder.obj());","+}","+","+}  // namespace mongo"],"additions":88,"deletions":0,"truncated":false},{"path":"src/mongo/db/pipeline/document_source_change_stream_convert_errors.h","lines":["@@ -0,0 +1,82 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#pragma once","+","+#include \"mongo/bson/bsonelement.h\"","+#include \"mongo/db/exec/document_value/value.h\"","+#include \"mongo/db/pipeline/document_source.h\"","+#include \"mongo/db/pipeline/document_source_change_stream.h\"","+#include \"mongo/db/pipeline/expression_context.h\"","+#include \"mongo/db/pipeline/stage_constraints.h\"","+#include \"mongo/db/pipeline/stage_params.h\"","+#include \"mongo/db/pipeline/variables.h\"","+#include \"mongo/db/query/compiler/dependency_analysis/dependencies.h\"","+#include \"mongo/db/query/query_shape/serialization_options.h\"","+#include \"mongo/util/modules.h\"","+","+#include <set>","+#include <string_view>","+","+#include <boost/optional/optional.hpp>","+#include <boost/smart_ptr/intrusive_ptr.hpp>","+","+namespace mongo {","+using namespace std::literals::string_view_literals;","+","+DECLARE_STAGE_PARAMS_DERIVED_DEFAULT(ChangeStreamConvertErrors);","+using ChangeStreamConvertErrorsLiteParsed =","+    DocumentSourceChangeStreamLiteParsedInternal<ChangeStreamConvertErrorsStageParams>;","+","+/**","+ * The topmost stage of an opted-in ('showErrorsAsEvents: true') change stream pipeline. It converts","+ * recoverable failures raised by the stages below it into 'operationType: \"error\"' events, built","+ * from the identity recorded on the ExpressionContext; materializes a resume gap stashed below the","+ * user stages; and releases an error event thrown past the router user stages.","+ *","+ * It is injected post-optimization and above every user stage, so the optimizer never sees it and","+ * no user stage ever observes an error event. It is a DocumentSource rather than an exec-only","+ * stage so that it is visible in explain.","+ */","+class DocumentSourceChangeStreamConvertErrors : public DocumentSourceInternalChangeStreamStage {","+public:","+    static constexpr std::string_view kStageName = \"$_internalChangeStreamConvertErrors\"sv;","+","+    std::string_view getSourceName() const override;","+","+    StageConstraints constraints(PipelineSplitState pipeState) const override;","+","+    boost::optional<DistributedPlanLogic> distributedPlanLogic(","+        const DistributedPlanContext* ctx) final {","+        return boost::none;","+    }","+","+    DepsTracker::State getDependencies(DepsTracker* deps) const override {","+        deps->setNeedsMetadata(DocumentMetadataFields::MetaType::kSortKey);","+        return DepsTracker::State::SEE_NEXT;","+    }","+","+    Value doSerialize(const query_shape::SerializationOptions& opts =","+                          query_shape::SerializationOptions{}) const override;","+","+    void addVariableRefs(std::set<Variables::Id>* refs) const final {}","+","+    static boost::intrusive_ptr<DocumentSourceChangeStreamConvertErrors> createFromBson(","+        BSONElement spec, const boost::intrusive_ptr<ExpressionContext>& expCtx);"],"additions":65,"deletions":0,"truncated":false}],"additions":564,"deletions":0,"truncated":true,"file_count":11},"error":null,"fetched_at":"2026-11-18T16:52:28.081914+00:00"}