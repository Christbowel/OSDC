@@ -17,6 +17,12 @@ INSTALL bogus FROM 'http://127.0.0.1:1/allowed';"," ----"," <REGEX>:.*(Permission Error: Cannot read a CA certificate bundle|Failed to download extension).*"," ","+# an encoded dot in a filename does not imply traversal","+statement error","+INSTALL 'http://127.0.0.1:1/allowed/file%2eext.duckdb_extension';","+----","+<REGEX>:.*(Permission Error: Cannot read a CA certificate bundle|Failed to download extension).*","+"," # a repository outside of allowed_directories is rejected before any request is made"," statement error"," INSTALL bogus FROM 'http://example.com';","@@ -40,6 +46,12 @@ INSTALL bogus FROM 'http://127.0.0.1:1/allowed/..';"," ----"," Permission Error: Cannot download extension"," ","+# encoded separators must not hide parent segments","+statement error","+INSTALL 'http://127.0.0.1:1/allowed/sub%2f..%2f..%2fbogus.duckdb_extension';","+----","+Permission Error: Cannot download extension","+"," # the default repository can be changed, but its downloads are still checked"," statement ok"," SET custom_extension_repository='http://example.com/repository';"],"additions":12,"deletions":0,"truncated":false},{"path":"test/sql/secrets/http_secret_scope_authority.test","lines":["@@ -0,0 +1,90 @@","+# name: test/sql/secrets/http_secret_scope_authority.test","+# description: HTTP secret scopes must not match a different URL authority","+# group: [secrets]","+","+require noforcestorage","+","+statement ok","+SET secret_directory='{TEST_DIR}/http_secret_scope_authority';","+","+statement ok","+CREATE SECRET port_scope (TYPE http, SCOPE 'http://127.0.0.1:18081');","+","+statement ok","+CREATE SECRET host_scope (TYPE http, SCOPE 'https://trusted.example');","+","+statement ok","+CREATE SECRET file_scope (TYPE http, SCOPE 'https://trusted.example/data/file.csv');","+","+# An authority-only scope matches the authority itself and paths under it.","+foreach url http://127.0.0.1:18081 http://127.0.0.1:18081/file.csv","+","+query T","+SELECT name FROM which_secret('{url}', 'http');","+----","+port_scope","+","+endloop","+","+# An @ in the path does not change the destination host.","+foreach url https://trusted.example https://trusted.example/file.csv https://trusted.example/path@other.example/file.csv","+","+query T","+SELECT name FROM which_secret('{url}', 'http');","+----","+host_scope","+","+endloop","+","+# File scopes must still work, and take precedence over the host scope.","+foreach url https://trusted.example/data/file.csv https://trusted.example/data/file.csv?token=x","+","+query T","+SELECT name FROM which_secret('{url}', 'http');","+----","+file_scope","+","+endloop","+","+# HTTP secrets can also be scoped to object-store URIs.","+statement ok","+CREATE SECRET bucket_scope (TYPE http, SCOPE 's3://trusted-bucket');","+","+statement ok","+CREATE SECRET key_prefix_scope (TYPE http, SCOPE 's3://trusted-bucket/data/file');","+","+query T","+SELECT name FROM which_secret('s3://trusted-bucket/other.csv', 'http');","+----","+bucket_scope","+","+# A key-prefix scope still matches a longer object key.","+query T","+SELECT name FROM which_secret('s3://trusted-bucket/data/file.parquet', 'http');","+----","+key_prefix_scope","+","+# A bucket scope must not match a neighboring bucket.","+query I","+SELECT count(*) FROM which_secret('s3://trusted-bucket-other/file.csv', 'http');","+----","+0","+","+# A matching textual prefix must not select credentials for a different host.","+foreach url http://127.0.0.1:18081@127.0.0.1:18082/steal https://trusted.example@other.example/steal https://trusted.example.other.example/steal","+","+query I","+SELECT count(*) FROM which_secret('{url}', 'http');","+----","+0","+","+endloop","+","+# A scheme-only scope still matches any host using that scheme.","+statement ok","+CREATE SECRET scheme_scope (TYPE http, SCOPE 'https://');","+","+query T","+SELECT name FROM which_secret('https://unrelated.example/file.csv', 'http');","+----","+scheme_scope"],"additions":90,"deletions":0,"truncated":false},{"path":"test/sql/settings/allowed_remote_paths.test","lines":["@@ -0,0 +1,95 @@","+# name: test/sql/settings/allowed_remote_paths.test","+# description: Reject parent traversal in restricted remote paths without decoding filenames as UTF-8","+# group: [settings]","+","+require skip_reload","+","+statement ok","+SET autoload_known_extensions=false;","+","+statement ok","+SET autoinstall_known_extensions=false;","+","+statement ok","+SET allowed_directories=['{TEST_DIR}', 'http://127.0.0.1:1/allowed/', 'https://127.0.0.1:1/allowed/', 'az://cont-public/allowed/', 's3://bucket.name/allowed/', 'custom://bucket.name/allowed/'];","+","+statement ok","+COPY (SELECT 42 AS i) TO '{TEST_DIR}/%2e%2e' (FORMAT CSV);","+","+statement ok","+SET allowed_paths=['http://127.0.0.1:1/explicit/%2e%2e/private'];","+","+# Keep the test offline even when remote extensions are linked into the runner.","+statement ok","+SET disabled_filesystems='HTTPFileSystem,S3FileSystem,AzureBlobStorageFileSystem';","+","+# With unrestricted access, traversal validation must not intercept the request.","+statement error","+SELECT * FROM glob('http://127.0.0.1:1/allowed/%2e%2e/private');","+----","+<REGEX>:.*(requires the extension|has been disabled by configuration).*","+","+statement ok","+SET enable_external_access=false;","+","+# Local filenames are not URL-decoded, and a local dot segment is still valid.","+query I","+SELECT i FROM read_csv('{TEST_DIR}/./%2e%2e');","+----","+42","+","+# Ordinary names and single dots pass validation and reach filesystem dispatch.","+# Escaped bytes need not be UTF-8, and nested escapes are not decoded recursively.","+foreach path file.csv backup..csv ... ./file.csv %2e file%2ecsv %2e%2ecsv file%FF.csv %FF%2e%2e %252e%252e/private one%2ftwo.csv one%5ctwo.csv file% file%2 file%GG","+","+statement error","+SELECT * FROM glob('http://127.0.0.1:1/allowed/{path}');","+----","+<REGEX>:.*(requires the extension|has been disabled by configuration).*","+","+endloop","+","+# Traversal-like text inside an HTTP query or fragment is not part of the path.","+foreach path file.csv?next=/../other file.csv#/../other","+","+statement error","+SELECT * FROM glob('http://127.0.0.1:1/allowed/{path}');","+----","+<REGEX>:.*(requires the extension|has been disabled by configuration).*","+","+endloop","+","+foreach path .. ../private .%2e/private %2e./private %2e%2e/private %2E%2E/private %2E%2e/private sub%2f..%2f..%2fprivate sub%2F..%2F..%2Fprivate sub%5c..%5c..%5cprivate sub%5C..%5C..%5Cprivate sub\\..\\..\\private %FF/%2e%2e/private","+","+statement error","+SELECT * FROM glob('http://127.0.0.1:1/allowed/{path}');","+----","+Permission Error: Cannot access file","+","+endloop","+","+# The same guard applies to HTTPS, object stores, and unrecognized remote schemes.","+foreach prefix https://127.0.0.1:1 az://cont-public s3://bucket.name custom://bucket.name","+","+statement error","+SELECT * FROM glob('{prefix}/allowed/.%2e/private');","+----","+Permission Error: Cannot access file","+","+endloop","+","+# Exact allowlist entries must not bypass traversal validation.","+statement error","+SELECT * FROM glob('http://127.0.0.1:1/explicit/%2e%2e/private');","+----","+Permission Error: Cannot access file","+","+# The HTTP path ends at the first query or fragment marker, not the last one.","+foreach path ..?x=?y %2e%2e#fragment?x=1","+","+statement error","+SELECT * FROM glob('http://127.0.0.1:1/allowed/{path}');","+----","+Permission Error: Cannot access file","+","+endloop",""],"additions":95,"deletions":0,"truncated":false}],"additions":260,"deletions":12,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-12T17:15:07.082657+00:00"}