s, FetchedTarball, IngestTarballToStore};","+use serde_json::Value;","+use std::{","+    collections::HashMap,","+    path::{Path, PathBuf},","+    sync::Arc,","+};","+","+/// What the native callbacks of one fetch run against.","+pub(super) struct NativeCallbacks<'a> {","+    pub(super) download: &'a IngestTarballToStore<'a>,","+    pub(super) lockfile_dir: &'a Path,","+    pub(super) include_only_package_files: bool,","+}","+","+/// What the native callbacks of one fetch produced. A hook may only return","+/// files listed here.","+#[derive(Default)]","+pub(super) struct Verified {","+    pub(super) archives: Vec<Arc<FetchedTarball>>,","+    pub(super) directories: Vec<WalkedDirectory>,","+}","+","+/// A directory the `fetchers.directory` callback walked, with the install","+/// pass's options.","+pub(crate) struct WalkedDirectory {","+    pub(crate) directory: String,","+    pub(crate) files_map: HashMap<String, PathBuf>,","+    pub(crate) manifest: Option<Value>,","+    /// See [`crate::SlotImportSource::source_exists`].","+    pub(crate) exists: bool,","+}","+","+impl WalkedDirectory {","+    pub(crate) fn resolution(&self) -> LockfileResolution {","+        LockfileResolution::Directory(DirectoryResolution { directory: self.directory.clone() })","+    }","+}","+","+/// Run the hook's fetch to completion, servicing the native-fetch","+/// callbacks it makes along the way. What those callbacks produced comes","+/// back with the response so the caller can match the files the hook","+/// claims against archives pacquet itself hashed or directories it walked.","+pub(super) async fn drive_fetcher<Reporter: self::Reporter>(","+    fetcher: &dyn CustomFetcher,","+    native: &NativeCallbacks<'_>,","+    selected_resolution: Value,","+    opts: Value,","+) -> Result<(Value, Verified), InstallPackageBySnapshotError> {","+    let package_id = native.download.package.id;","+    let (callbacks, mut requests) = tokio::sync::mpsc::unbounded_channel();","+    let fetch = fetcher.fetch_with_callbacks(package_id, selected_resolution, opts, callbacks);","+    tokio::pin!(fetch);","+    let mut verified = Verified::default();","+    let result = loop {","+        tokio::select! {","+            result = &mut fetch => break result.map_err(|error| failure(package_id, error))?,","+            Some(callback) = requests.recv() => {","+                let result = run_callback::<Reporter>(native, &callback, &mut verified)","+                    .await.map_err(|error| serde_json::json!(error));","+                let _ = callback.response.send(result);","+            }","+        }","+    };","+    Ok((result, verified))","+}","+","+fn callback_error(message: impl Into<String>, code: &str) -> FetchErrorDetails {","+    FetchErrorDetails { message: message.into(), code: Some(code.to_owned()), status: None }","+}","+","+async fn run_callback<Reporter: self::Reporter>(","+    native: &NativeCallbacks<'_>,","+    callback: &FetcherCallback,","+    verified: &mut Verified,","+) -> Result<Value, FetchErrorDetails> {","+    let download = native.download;","+    let expects_local_archive = match callback.method {","+        FetcherMethod::CafsInfo => {","+            return Ok(serde_json::json!({ \"storeDir\": download.store.dir.root() }));","+        }","+        FetcherMethod::TempDir => return temp_dir(download).await,","+        FetcherMethod::Directory => {","+            return walk_callback_directory(native, callback, &mut verified.directories);","+        }","+        FetcherMethod::LocalTarball => true,","+        FetcherMethod::RemoteTarball => false,","+    };","+    for option in [\"ignoreFilePattern\", \"appendManifest\"] {","+        if callback.options","+            .get(option)","+            .is_some_and(|value| !value.is_null())","+        {","+            return Err(callback_error(","+                format!(\"native custom-fetcher callbacks do not support {option}\"),","+                \"ERR_PNPM_UNSUPPORTED_FETCHER_OPTION\",","+            ));","+        }","+    }","+    let location = callback_location(callback, download, expects_local_archive)?;","+    let tarball =","+        fetch_location::<Reporter>(download, location, callback_lockfile_dir(native, callback))","+            .await","+            .map_err(|error| error.fetch_error_details())?;","+    let result = serde_json::json!({","+        \"filesMap\": tarball.files_map,","+        \"integrity\": tarball.integrity.to_string(),","+        \"manifest\": tarball.manifest,","+        \"requiresBuild\": tarball.requires_build,","+    });","+    verified.archives.push(tarball);","+    Ok(result)","+}","+","+fn callback_lockfile_dir<'a>(","+    native: &NativeCallbacks<'a>,","+    callback: &'a FetcherCallback,","+) -> &'a Path {","+    callback.options","+        .get(\"lockfileDir\")","+        .and_then(Value::as_str)","+        .map_or(native.lockfile_dir, Path::new)","+}","+","+/// `fetchers.directory`. A directory has no archive digest, so when the","+/// lockfile pins one the call itself rejects, which lets the hook catch it.","+fn walk_callback_directory(","+    native: &NativeCallbacks<'_>,","+    callback: &FetcherCallback,","+    walked: &mut Vec<WalkedDirectory>,","+) -> Result<Value, FetchErrorDetails> {","+    if native.download.package.integrity.is_some() {","+        return Err(callback_error(","+            r#\"Cannot verify the locked archive integrity after delegating to resolution type \"directory\".\"#,","+            \"ERR_PNPM_TARBALL_INTEGRITY\",","+        ));","+    }","+    // Like the TypeScript directory fetcher, read `directory` alone: a hook","+    // often spreads its own resolution, which carries other fields.","+    let Some(relative) = callback.resolution.get(\"directory\").and_then(Value::as_str) else {","+        return Err(callback_error(","+            \"native directory callback received a resolution without a directory\","],"additions":152,"deletions":0,"truncated":false}],"additions":441,"deletio