{"id":"506f33d66621de586c603a356410e7415ad6517a","axis":"silent","repo":"pnpm/pnpm","sha":"506f33d66621de586c603a356410e7415ad6517a","parsed":{"files":[{"path":".changeset/custom-fetcher-directory.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+A custom fetcher in the pnpmfile can now call `fetchers.directory` to fetch a package from a local directory. The call rejects with `ERR_PNPM_TARBALL_INTEGRITY` if the lockfile pins an archive integrity for the package. Previously, calling `fetchers.directory` failed with a `TypeError`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/custom_fetchers/directory.rs","lines":["@@ -1,8 +1,12 @@","-use super::{pacquet_at, write_manifest};","+use super::{","+    configure_fetcher_project, fetcher_pnpmfile, mock_fetcher_package, pacquet_at, write_manifest,","+};"," use assert_cmd::prelude::*;"," use command_extra::CommandExtra;"," use pnpm_testing_utils::{","-    bin::CommandTempCwd, diagnostics::assert_diagnostic_contains, fixtures::minimal_tarball,","+    bin::CommandTempCwd,","+    diagnostics::assert_diagnostic_contains,","+    fixtures::{minimal_tarball, sha512_integrity},"," };"," use std::{","     fs,","@@ -19,6 +23,107 @@ fn hoisted_reinstall_refreshes_a_tarball_resolution_delegated_to_a_directory() {","     assert_delegated_directory_is_refreshed(\"{ tarball: 'file:delegated.tgz' }\");"," }"," ","+#[test]","+fn hoisted_reinstall_refreshes_a_directory_fetched_by_the_builtin_directory_fetcher() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    let source = set_up_directory_fetcher(&workspace, DIRECTORY_FETCHER_FETCH);","+    assert_directory_is_refreshed(&workspace, &source);","+    drop(root);","+}","+","+/// The TypeScript directory fetcher reads only `resolution.directory`.","+#[test]","+fn builtin_directory_fetcher_reads_only_the_directory_field() {","+    for resolution in [","+        \"{ directory: 'source' }\",","+        \"{ ...resolution, type: 'directory', directory: 'source', path: 'unused' }\",","+    ] {","+        let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+        set_up_directory_fetcher(","+            &workspace,","+            &format!(","+                \"async fetch (cafs, resolution, opts, fetchers) {{","+      return fetchers.directory(cafs, {resolution}, opts);","+    }}\",","+            ),","+        );","+        pacquet_at(&workspace)","+            .with_arg(\"install\")","+            .assert()","+            .success();","+        let installed = workspace.join(\"node_modules/@pnpm.e2e/dep-of-pkg-with-1-dep/index.js\");","+        assert_eq!(fs::read_to_string(installed).unwrap(), \"first\", \"{resolution}\");","+        drop(root);","+    }","+}","+","+#[test]","+fn builtin_directory_fetcher_result_must_be_returned_unchanged() {","+    for change in [","+        \"result.filesMap.set('injected.js', result.filesMap.get('package.json'));\",","+        \"result.filesMap.delete('index.js');\",","+    ] {","+        let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+        set_up_directory_fetcher(","+            &workspace,","+            &format!(","+                \"async fetch (cafs, resolution, opts, fetchers) {{","+      const result = await fetchers.directory(cafs, {{ type: 'directory', directory: 'source' }}, opts);","+      {change}","+      return result;","+    }}\",","+            ),","+        );","+        let output = pacquet_at(&workspace)","+            .with_arg(\"install\")","+            .assert()","+            .failure();","+        let stderr = String::from_utf8_lossy(&output.get_output().stderr);","+        assert_diagnostic_contains(&stderr, \"not listed by the native directory fetcher\");","+        assert!(","+            !workspace.join(\"node_modules/@pnpm.e2e/dep-of-pkg-with-1-dep/package.json\").exists(),","+            \"{change}: a modified directory listing must not be imported\",","+        );","+        drop(root);","+    }","+}","+","+/// The TypeScript picker rejects the `directory` fetcher outright when the","+/// lockfile pins an archive integrity, so the hook sees the rejection.","+#[test]","+fn builtin_directory_fetcher_rejects_a_locked_archive_integrity() {","+    let CommandTempCwd { root: _root, workspace, .. } = CommandTempCwd::init();","+    let mut registry = mockito::Server::new();","+    let tarball = minimal_tarball(\"fetcher-pkg\", \"1.0.0\");","+    let (metadata, original) =","+        mock_fetcher_package(&mut registry, Some(&sha512_integrity(&tarball)));","+    configure_fetcher_project(&workspace, &registry.url(), Some(\"configured.cjs\"));","+    fs::create_dir(workspace.join(\"source\")).expect(\"create source\");","+    fs::write(workspace.join(\"source/package.json\"), r#\"{\"name\":\"fetcher-pkg\",\"version\":\"1.0.0\"}\"#)","+        .expect(\"write source manifest\");","+    fs::write(","+        workspace.join(\"configured.cjs\"),","+        fetcher_pnpmfile(","+            r\"await assert.rejects(","+      fetchers.directory(cafs, { type: 'directory', directory: 'source' }, opts),","+      { code: 'ERR_PNPM_TARBALL_INTEGRITY', message: /locked archive integrity/ },","+    );","+    throw new Error('the directory fetcher rejected');\",","+        ),","+    )","+    .expect(\"write directory fetcher\");","+","+    let output = pacquet_at(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .failure();","+    let stderr = String::from_utf8_lossy(&output.get_output().stderr);","+    assert_diagnostic_contains(&stderr, \"the directory fetcher rejected\");","+    assert!(!workspace.join(\"node_modules/fetcher-pkg/package.json\").exists());","+    metadata.assert();","+    original.assert();","+}","+"," #[test]"," fn hoisted_reinstall_without_custom_fetchers_keeps_the_fast_path() {","     let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","@@ -93,10 +198,37 @@ fn configure_hoisted_tarball(workspace: &Path) {","     .expect(\"write package tarball\");"," }"," ","+const DIRECTORY_FETCHER_FETCH: &str = r\"async fetch (cafs, resolution, opts, fetchers) {","+      const result = await fetchers.directory(cafs, { type: 'directory', directory: 'source' }, opts);","+      if (result.local !== true || !result.filesMap.has('index.js') || result.manifest.version !== '1.0.0') {","+        throw new Error('unexpected directory fetch result: ' + JSON.stringify(result));","+      }","+      return result;","+    }\";","+"," fn assert_delegated_directory_is_refreshed(resolution: &str) {","     let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","     let source = set_up_delegated_directory(&workspace, resolution);","-    pacquet_at(&workspace)","+    assert_directory_is_refreshed(&workspace, &source);","+    drop(root);","+}","+","+fn set_up_delegated_directory(workspace: &Path, resolution: &str) -> PathBuf {","+    set_up_custom_resolution(","+        workspace,","+        resolution,","+        r\"fetch () {","+      return { delegate: { type: 'directory', directory: path.join(__dirname, 'source') } };","+    }\",","+    )","+}","+","+fn set_up_directory_fetcher(workspace: &Path, fetch: &str) -> PathBuf {","+    set_up_custom_resolution(workspace, \"{ type: 'custom:directory' }\", fetch)","+}","+","+fn assert_directory_is_refreshed(workspace: &Path, source: &Path) {","+    pacquet_at(workspace)","         .with_arg(\"install\")","         .assert()","         .success();","@@ -105,7 +237,7 @@ fn assert_delegated_directory_is_refreshed(resolution: &str) {"," ","     fs::write(source.join(\"index.js\"), \"second\").expect(\"edit source file\");","     fs::write(source.join(\"new.js\"), \"new\").expect(\"add source file\");","-    pacquet_at(&workspace)","+    pacquet_at(workspace)","         .with_args([\"install\", \"--frozen-lockfile\"])","         .assert()","         .success();","@@ -113,17 +245,17 @@ fn assert_delegated_directory_is_refreshed(resolution: &str) {","     assert_eq!(fs::read_to_string(installed.join(\"new.js\")).unwrap(), \"new\");"," ","     fs::write(source.join(\"index.js\"), \"third\").expect(\"edit source file again\");","-    pacquet_at(&workspace)","+    pacquet_at(workspace)","         .with_arg(\"install\")","         .assert()","         .success();","     assert_eq!(fs::read_to_string(installed.join(\"index.js\")).unwrap(), \"third\");","-    drop(root);"," }"," "," /// Writes a hoisted project whose pnpmfile resolves the dependency to","-/// `resolution` and fetches it from the returned `source` directory.","-fn set_up_delegated_directory(workspace: &Path, resolution: &str) -> PathBuf {","+/// `resolution` and fetches it with `fetch`, a fetcher method that reads the","+/// returned `source` directory.","+fn set_up_custom_resolution(workspace: &Path, resolution: &str, fetch: &str) -> PathBuf {","     write_manifest(workspace, \"1.0.0\");","     fs::write(","         workspace.join(\"pnpm-workspace.yaml\"),","@@ -155,9 +287,7 @@ module.exports = {{","   }}],","   fetchers: [{{","     canFetch (pkgId) {{ return pkgId === '@pnpm.e2e/dep-of-pkg-with-1-dep@1.0.0'; }},","-    fetch () {{","-      return {{ delegate: {{ type: 'directory', directory: path.join(__dirname, 'source') }} }};","-    }},","+    {fetch},","   }}],"," }};"," \",","@@ -167,3 +297,56 @@ module.exports = {{"," ","     source"," }","+","+/// A resolver that reports no manifest leaves the dependencies to the","+/// `package.json` the directory fetcher read, as the TypeScript CLI does.","+#[test]","+fn builtin_directory_fetcher_supplies_the_manifest_to_a_fresh_resolution() {","+    let CommandTempCwd { root, workspace, .. } = CommandTempCwd::init();","+    write_manifest(&workspace, \"1.0.0\");","+    for (name, manifest) in [","+        (","+            \"parent\",","+            r#\"{\"name\":\"@pnpm.e2e/dep-of-pkg-with-1-dep\",\"version\":\"1.0.0\",\"dependencies\":{\"child\":\"1.0.0\"}}\"#,","+        ),","+        (\"child\", r#\"{\"name\":\"child\",\"version\":\"1.0.0\"}\"#),","+    ] {","+        fs::create_dir(workspace.join(name)).expect(\"create source\");","+        fs::write(workspace.join(name).join(\"package.json\"), manifest).expect(\"write manifest\");","+    }","+    fs::write(","+        workspace.join(\".pnpmfile.cjs\"),","+        r\"const sources = { '@pnpm.e2e/dep-of-pkg-with-1-dep': 'parent', child: 'child' };","+module.exports = {","+  resolvers: [{","+    canResolve (wanted) { return wanted.alias in sources; },","+    resolve (wanted) {","+      return {","+        id: `${wanted.alias}@1.0.0`,","+        resolution: { type: 'custom:directory', source: sources[wanted.alias] },","+      };","+    },","+  }],","+  fetchers: [{","+    canFetch (pkgId, resolution) { return resolution.type === 'custom:directory'; },","+    fetch (cafs, resolution, opts, fetchers) {","+      return fetchers.directory(cafs, { type: 'directory', directory: resolution.source }, opts);","+    },","+  }],","+};","+\",","+    )","+    .expect(\"write pnpmfile\");","+","+    pacquet_at(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let lockfile = fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).expect(\"read lockfile\");","+    assert!(lockfile.contains(\"child: child@1.0.0\"), \"the parent's dependency is locked\");","+    assert!(lockfile.contains(\"source: parent\"), \"the custom resolution is recorded as resolved\");","+    assert!(!lockfile.contains(&*workspace.to_string_lossy()), \"no absolute path is recorded\");","+    assert!(workspace.join(\"node_modules/.pnpm/node_modules/child/package.json\").exists());","+    drop(root);","+}"],"additions":194,"deletions":11,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/custom_fetcher.rs","lines":["@@ -1,14 +1,15 @@","+mod callbacks;"," mod metadata;"," "," use crate::{","     InstallPackageBySnapshotError, install_package_by_snapshot::local_file_tarb