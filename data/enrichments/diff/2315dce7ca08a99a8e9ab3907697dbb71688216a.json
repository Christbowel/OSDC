{"id":"2315dce7ca08a99a8e9ab3907697dbb71688216a","axis":"silent","repo":"pnpm/pnpm","sha":"2315dce7ca08a99a8e9ab3907697dbb71688216a","parsed":{"files":[{"path":".changeset/repeat-install-records-extend-node-path.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/workspace.state\": patch","+\"pacquet\": patch","+\"pnpm\": patch","+---","+","+A repeat `pnpm install` now rewrites the bin shims after `extendNodePath` changes. Before, it reported \"Already up to date\" and the shims kept the `NODE_PATH` of the previous setting."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/modules_dir.rs","lines":["@@ -517,3 +517,51 @@ fn the_hoisted_linker_installs_into_a_custom_modules_dir() {"," ","     drop((root, mock_instance));"," }","+","+/// Changing `extendNodePath` changes neither the lockfile nor","+/// `.modules.yaml`, so only the recorded setting tells the repeat install","+/// that the shims are stale.","+#[test]","+fn repeat_install_rewrites_registry_bins_when_extend_node_path_changes() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    append_workspace_yaml_key(&workspace, \"modulesDir\", \"vendor\");","+    append_workspace_yaml_key(&workspace, \"extendNodePath\", \"false\");","+    write_manifest(","+        &workspace,","+        &serde_json::json!({ \"dependencies\": { \"@pnpm.e2e/hello-world-js-bin\": \"1.0.0\" } }),","+    );","+    let install = |env_value: Option<&str>| {","+        let mut command = pacquet_in(&workspace).with_arg(\"install\");","+        if let Some(value) = env_value {","+            command = command.with_env(\"PNPM_CONFIG_EXTEND_NODE_PATH\", value);","+        }","+        command.assert().success();","+    };","+","+    install(None);","+    assert!(!registry_bin_sets_node_path(&workspace));","+","+    set_extend_node_path(&workspace, \"false\", \"true\");","+    pnpm_testing_utils::fs::bump_mtime(&workspace.join(\"pnpm-workspace.yaml\"));","+    install(None);","+    assert!(registry_bin_sets_node_path(&workspace));","+","+    install(Some(\"false\"));","+    assert!(!registry_bin_sets_node_path(&workspace));","+","+    install(Some(\"true\"));","+    assert!(registry_bin_sets_node_path(&workspace));","+","+    drop((root, mock_instance));","+}","+","+fn registry_bin_sets_node_path(project_dir: &Path) -> bool {","+    let shim = if cfg!(windows) {","+        \"vendor/.bin/hello-world-js-bin.cmd\"","+    } else {","+        \"vendor/.bin/hello-world-js-bin\"","+    };","+    fs::read_to_string(project_dir.join(shim)).expect(\"read the shim\").contains(\"NODE_PATH=\")","+}"],"additions":48,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/prepare_modules_state/up_to_date.rs","lines":["@@ -72,14 +72,18 @@ pub(super) fn frozen_tree_up_to_date<'a>(","         return None;","     }","     let modules = context.modules_manifest?;","-    // A `supportedArchitectures` change alters the skip set without","-    // touching the lockfile or `.modules.yaml`, so the unchanged-layout","-    // premise doesn't hold and the platform packages must be re-evaluated.","+    // A `supportedArchitectures` change alters the skip set, and an","+    // `extendNodePath` change the bin shims, without touching the lockfile or","+    // `.modules.yaml`, so the unchanged-layout premise doesn't hold.","     if !modules_consistent_with(modules, config, context.tree.node_linker, context.tree.included)","         || !crate::optimistic_repeat_install::recorded_supported_architectures_match(","             context.recorded.state,","             context.repeat.supported_architectures,","         )","+        || !crate::optimistic_repeat_install::recorded_extend_node_path_matches(","+            context.recorded.state,","+            config.extend_node_path,","+        )","         || !build_state_unchanged(context, current, modules)","     {","         return None;"],"additions":7,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install.rs","lines":["@@ -35,8 +35,9 @@ pub(crate) use modules_dirs::{hoisted_project_modules_dir, project_id};"," pub(crate) use relocation::recorded_elsewhere;"," pub(crate) use settings::{","     ResolvedImporters, catalogs_cache_matches, current_settings_with_catalogs, first_setting_drift,","-    recorded_default_registry, recorded_registry_prefixes, recorded_registry_routes_after_install,","-    recorded_supported_architectures_match, records_registry_keys_of,","+    recorded_default_registry, recorded_extend_node_path_matches, recorded_registry_prefixes,","+    recorded_registry_routes_after_install, recorded_supported_architectures_match,","+    records_registry_keys_of,"," };"," pub(crate) use timestamps::{","     file_mtime, file_mtime_from_metadata, filesystem_now_ms_in_modules,"],"additions":3,"deletions":2,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/settings.rs","lines":["@@ -1,5 +1,6 @@"," //! Comparing the settings a previous install recorded against the current ones."," ","+pub(crate) use install_policy::recorded_extend_node_path_matches;"," pub(crate) use registry_prefixes::{","     ResolvedImporters, recorded_default_registry, recorded_registry_prefixes,","     recorded_registry_routes, recorded_registry_routes_after_install, records_registry_keys_of,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/settings/install_policy.rs","lines":["@@ -1,7 +1,18 @@","-use super::{Config, SettingsComparison, WorkspaceStateSettings};","+use super::{Config, SettingsComparison, WorkspaceState, WorkspaceStateSettings};"," ","-/// The settings that decide which builds, runtimes, and lockfile verification","-/// an install runs. An unrecorded value reads as the default.","+/// Whether the `extendNodePath` the last install recorded matches `live`.","+/// The frozen path's up-to-date early return reads it: the lockfile and","+/// `.modules.yaml` stay the same when it changes, and the bin shims it shapes","+/// do not.","+pub(crate) fn recorded_extend_node_path_matches(","+    recorded: Option<&WorkspaceState>,","+    live: bool,","+) -> bool {","+    recorded.and_then(|state| state.settings.extend_node_path).unwrap_or(true) == live","+}","+","+/// The settings that decide which builds, runtimes, bin shims, and lockfile","+/// verification an install runs. An unrecorded value reads as the default."," /// `dangerouslyAllowAllBuilds` is always recorded, as pnpm v11 records it."," pub(super) fn install_policy_settings(","     config: &Config,","@@ -9,6 +20,7 @@ pub(super) fn install_policy_settings("," ) -> WorkspaceStateSettings {","     WorkspaceStateSettings {","         dangerously_allow_all_builds: Some(config.dangerously_allow_all_builds),","+        extend_node_path: (!config.extend_node_path).then_some(false),","         runtime: config.skip_runtimes.then_some(false),","         trust_lockfile: config.trust_lockfile.then_some(true),","         ..rest","@@ -26,6 +38,11 @@ impl SettingsComparison<'_> {","                 \"dangerouslyAllowAllBuilds\",","                 differs(recorded.dangerously_allow_all_builds, live.dangerously_allow_all_builds),","             ),","+            (","+                \"extendNodePath\",","+                recorded.extend_node_path.unwrap_or(true)","+                    != live.extend_node_path.unwrap_or(true),","+            ),","             (\"runtime\", recorded.runtime.unwrap_or(true) != live.runtime.unwrap_or(true)),","             (\"trustLockfile\", differs(recorded.trust_lockfile, live.trust_lockfile)),","         ]"],"additions":20,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/tests/settings_classification.rs","lines":["@@ -106,7 +106,7 @@ const CLASSIFICATION: &[(&str, Reach)] = &[","     (\"engine_strict\", NotAnInput(\"whether an incompatible package fails the install\")),","     (\"exclude_links_from_lockfile\", Recorded { key: \"excludeLinksFromLockfile\", change: |config| config.exclude_links_from_lockfile = !config.exclude_links_from_lockfile }),","     (\"explicit_settings\", Through(\"the settings it names, each classified under its own field\")),","-    (\"extend_node_path\", Unseen(\"neither the fast path nor the frozen-tree check sees it, only an install into an empty modules directory rewrites the bins\")),","+    (\"extend_node_path\", Recorded { key: \"extendNodePath\", change: |config| config.extend_node_path = !config.extend_node_path }),","     (\"external_dependencies\", Unseen(\"neither the fast path nor the frozen-tree check sees it, only an install into an empty modules directory applies it\")),","     (\"extra_bin_paths\", NotAnInput(SCRIPTS)),","     (\"extra_env\", NotAnInput(SCRIPTS)),"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/workspace-state/src/lib.rs","lines":["@@ -251,6 +251,10 @@ pub struct WorkspaceStateSettings {","     pub enable_global_virtual_store: Option<bool>,","     #[serde(default, skip_serializing_if = \"Option::is_none\")]","     pub exclude_links_from_lockfile: Option<bool>,","+    /// `extendNodePath`, recorded only while it is off. It decides the","+    /// `NODE_PATH` the bin shims set.","+    #[serde(default, skip_serializing_if = \"Option::is_none\")]","+    pub extend_node_path: Option<bool>,","     /// The directory a configured `globalVirtualStoreDir` resolves to,","     /// recorded only when set, for the reason given on [`Self::store_dir`].","     /// pnpm v11 has no such setting."],"additions":4,"deletions":0,"truncated":false},{"path":"pnpm11/deps/status/test/checkDepsStatus.test.ts","lines":["@@ -400,6 +400,7 @@ describe('checkDepsStatus - settings change detection', () => {"," ","   it.each([","     ['dangerouslyAllowAllBuilds', undefined, true],","+    ['extendNodePath', false, undefined],","     ['runtime', false, undefined],","     ['trustLockfile', true, undefined],","     ['virtualStoreDirMaxLength', 120, 10],","@@ -434,6 +435,7 @@ describe('checkDepsStatus - settings change detection', () => {"," ","   it.each([","     ['dangerouslyAllowAllBuilds', false],","+    ['extendNodePath', true],","     ['runtime', true],","     ['trustLockfile', false],","     ['virtualStoreDirMaxLength', process.platform === 'win32' ? 60 : 120],"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm11/workspace/state/src/types.ts","lines":["@@ -104,6 +104,8 @@ export const WORKSPACE_STATE_SETTING_KEYS = [","   'dedupePeers',","   'dev',","   'excludeLinksFromLockfile',","+  // It decides the `NODE_PATH` the bin shims set.","+  'extendNodePath',","   'hoistPattern',","   'hoistWorkspacePackages',","   'ignoredOptionalDependencies',","@@ -149,7 +151,7 @@ export const WORKSPACE_STATE_SETTING_KEYS = ["," ] as const satisfies ReadonlyArray<keyof Config>"," "," /** Settings a state may leave out. Unset reads as the default. */","-type OptionalSettingKey = 'dangerouslyAllowAllBuilds' | 'runtime' | 'virtualStoreDirMaxLength'","+type OptionalSettingKey = 'dangerouslyAllowAllBuilds' | 'extendNodePath' | 'runtime' | 'virtualStoreDirMaxLength'"," "," export type WorkspaceStateSettings = Pick<Config, Exclude<typeof WORKSPACE_STATE_SETTING_KEYS[number], OptionalSettingKey>> &"," Partial<Pick<Config, OptionalSettingKey>> & {"],"additions":3,"deletions":1,"truncated":false},{"path":"pnpm11/workspace/state/src/validation.ts","lines":["@@ -450,6 +450,7 @@ const SETTING_UNSET_EQUIVALENTS: Partial<Record<keyof WorkspaceStateSettings, un","   allowBuilds: {},","   dangerouslyAllowAllBuilds: false,","   enableGlobalVirtualStore: false,","+  extendNodePath: true,","   runtime: true,","   trustLockfile: false,","   // The default of `virtualStoreDirMaxLength`.",""],"additions":1,"deletions":0,"truncated":false}],"additions":97,"deletions":10,"truncat