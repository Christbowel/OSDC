this.#writeStream?.destroy()","     this.#writeStream = undefined","     this.#downstreamController = new CacheController(controller)","+    // The redirect handler threads the list of visited URLs through the","+    // handler-chain context. Keep a reference to it (it is mutated as redirects","+    // are followed) so onResponseStart can tell which request actually produced","+    // the response. Unlike the request options object, this reference is not","+    // broken by an interceptor that copies the options between the cache and","+    // the redirect.","+    this.#history = context?.history","     this.#handler.onRequestStart?.(this.#downstreamController, context)","   }"," ","@@ -267,6 +296,35 @@ class CacheHandler {","       return downstreamOnHeaders()","     }"," ","+    // A cross-origin redirect can change the origin that actually produced the","+    // final response. Keying that response on the original (trusted) origin","+    // would let a redirect target control an entry for a URL the application","+    // trusts. The final request is the last URL in the redirect history; only","+    // cache when its origin still matches the cache key origin.","+    if (this.#history && this.#history.length > 0) {","+      const finalUrl = this.#history[this.#history.length - 1]","+      if (!sameOrigin(finalUrl.origin, this.#cacheKey.origin)) {","+        return downstreamOnHeaders()","+      }","+    }","+","+    // A redirect hop that is not forwarded can still carry a restrictive","+    // storage policy (for example `no-store`, or `private` for a shared cache).","+    // Honor it, otherwise a redirect that must not be stored could be laundered","+    // into a cacheable final response under the original key.","+    const redirectCacheControl = this.#history?.[kRedirectCacheControl]","+    if (redirectCacheControl) {","+      for (const hopCacheControl of redirectCacheControl) {","+        const hopDirectives = hopCacheControl ? parseCacheControlHeader(hopCache