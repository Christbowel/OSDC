tingController.aborted) {","+          waitingHandler.done = true","+          return true","+        }"," ","-      if (this.#responseStarted) {","-        handler.onResponseStart?.(","-          waitingController,","-          this.#statusCode,","-          this.#headers,","-          this.#statusMessage","-        )","+        if (this.#responseStarted) {","+          handler.onResponseStart?.(","+            waitingController,","+            this.#statusCode,","+            this.#headers,","+            this.#statusMessage","+          )","+        }","+      } else {","+        // The primary request has not started yet. Defer onRequestStart until","+        // its context is known, so the waiting handler observes the same","+        // redirect history as the primary (a cache handler relies on it to","+        // reject cross-origin redirect responses).","+        waitingHandler.pendingStart = true","       }","     } catch {","       // Ignore errors from waiting handlers","@@ -146,6 +171,24 @@ class DeduplicationHandler {","    */","   onRequestStart (controller, context) {","     this.#controller = controller","+    if (!this.#requestStarted) {","+      this.#requestStarted = true","+      this.#context = context","+      // Deliver the now-known context to handlers that joined before the","+      // primary request started.","+      for (const waitingHandler of this.#waitingHandlers) {","+        if (waitingHandler.pendingStart && !waitingHandler.done && !waitingHandler.controller.aborted) {","+          waitingHandler.pendingStart = false","+          try {","+            waitingHandler.handler.onRequestStart?.(waitingHandler.controller, context)","+          } catch {","+            // Ignore errors from waiting handlers","+            waitingHandler.done = true","+          }","+        }","+      }","+      this.#pruneDoneWaitingHandlers()","+    }","     this.#primaryHandler.onRequestStart?.(controller, context)","   }"," ","@@ -330,7 +373,8 @@ class DeduplicationHandler {","       bufferedChunks: [],","       bufferedBytes: 0,","       pendingTrailers: null,","-      done: false","+      done: false,","+      pendingStart: false","     }"," ","     const state = {"],"additions":57,"deletions":13,"truncated":false},{"path":"lib/handler/redirect-handler.js","lines":["@@ -3,7 +3,7 @@"," const util = require('../core/util')"," const assert = require('node:assert')"," const { InvalidArgumentError, MaxRedirectsError } = require('../core/errors')","-const { kRequestOrigin } = require('../core/symbols')","+const { kRequestOrigin, kRedirectCacheControl } = require('../core/symbols')"," "," const redirectableStatusCodes = [300, 301, 302, 303, 307, 308]"," ","@@ -38,6 +38,15 @@ class RedirectHandler {","     this.maxRedirections = maxRedirections","     this.handler = handler","     this.history = []","+    // `cache-control` of each intermediate (suppressed) redirect hop. An outer","+    // cache uses it to preserve a hop's storage policy (e.g. `no-store`) that","+    // would otherwise be lost because the hop's response is not forwarded. It","+    // travels as a non-enumerable property of the history array so it reaches","+    // the cache without becoming part of the public request/response context.","+    Object.defineProperty(this.history, kRedirectCacheControl, {","+      value: [],","+      enumerable: false","+    })","   }"," ","   onRequestStart (controller, context) {","@@ -114,6 +123,11 @@ class RedirectHandler {","       return","     }"," ","+    // This hop's response is suppressed (only its Location is used). Record its","+    // cache-control so an outer cache can honor a restrictive policy that would","+    // otherwise be lost when the final response is stored.","+    this.history[kRedirectCacheControl].push(headers['cache-control'])","+","     const baseUrl = requestOrigin","       ? new URL(this.opts.path, requestOrigin)","       : undefined"],"additions":15,"deletions":1,"truncated":false},{"path":"test/interceptors/cache-redirect-origin.js","lines":["@@ -0,0 +1,432 @@","+'use strict'","+","+const { test } = require('node:test')","+const assert = require('node:assert/strict')","+const { createServer } = require('node:http')","+const { once } = require('node:events')","+const { join } = require('node:path')","+const { tmpdir } = require('node:os')","+const { rm } = require('node:fs/promises')","+const {","+  Agent,","+  Pool,","+  cacheStores,","+  interceptors","+} = require('../../')","+const { runtimeFeatures } = require('../../lib/util/runtime-features.js')","+","+/**","+ * Reproduces GHSA-4W7W-5XRC-9H26: when a shared cache is placed outside the","+ * redirect interceptor (`compose(redirect(), cache())`), the cache keys the","+ * response on the original (trusted) origin before the redirect handler","+ * changes the origin. The cross-origin response is then stored under the","+ * trusted key, so a later request to the trusted URL receives attacker bytes","+ * even though it never hit either origin.","+ *","+ * The fix verifies, before storing, that the effective request origin matches","+ * the cache key origin. See lib/handler/cache-handler.js.","+ */","+","+async function listen (server) {","+  return new Promise(resolve => server.listen(0, '127.0.0.1', resolve))","+}","+","+async function closeServer (server) {","+  server.close()","+  await once(server, 'close')","+}","+","+async function withOrigins (run) {","+  const state = {","+    redirectEnabled: true,","+    trustedHits: 0,","+    attackerHits: 0","+  }","+","+  const attacker = createServer((_req, res) => {","+    state.attackerHits++","+    res.writeHead(200, {","+      'cache-control': 'public, max-age=86400',","+      'content-type': 'text/plain'","+    })","+    res.end('attacker-controlled-content')","+  })","+","+  const trusted = createServer((req, res) => {","+    state.trustedHits++","+    if (state.redirectEnabled && req.url === '/resource') {","+      res.writeHead(302, {","+        location: `http://127.0.0.1:${attacker.address().port}/payload`","+      })","+      res.end()","+      return","+    }","+    res.writeHead(200, {","+      'cache-control': 'no-store',","+      'content-type': 'text/plain'","+    })","+    res.end('legitimate-content')","+  })","+","+  await Promise.all([listen(trusted), listen(attacker)])","+","+  const trustedOrigin = `http://127.0.0.1:${trusted.address().port}`","+  try {","+    return await run({ state, trustedOrigin })","+  } finally {","+    await Promise.all([closeServer(trusted), closeServer(attacker)])","+  }","+}","+","+async function requestAgent (agent, origin, user) {","+  const response = await agent.request({","+    origin,","+    path: '/resource',","+    method: 'GET',","+    headers: { cookie: `session=${user}` }","+  })","+  return response.body.text()","+}","+","+test('cache does not store a cross-origin redirect response under the original origin key (memory)', async () => {","+  await withOrigins(async ({ state, trustedOrigin }) => {","+    const agent = new Agent().compose(","+      interceptors.redirect({ maxRedirections: 2 }),","+      interceptors.cache({","+        store: new cacheStores.MemoryCacheStore(),","+        type: 'shared'","+      })","+    )","+","+    const mallory = await requestAgent(agent, trustedOrigin, 'mallory')","+    state.redirectEnabled = false","+    const hitsBeforeAlice = [state.trustedHits, state.attackerHits]","+    const alice = await requestAgent(agent, trustedOrigin, 'alice')","+    const hitsAfterAlice = [state.trustedHits, state.attackerHits]","+","+    try {","+      assert.equal(mallory, 'attacker-controlled-content')","+      // Alice must receive the legitimate origin's response, not the poisoned","+      // attacker bytes. A cache hit on a poisoned entry would serve","+      // 'attacker-controlled-content' without contacting the trusted origin.","+      assert.equal(alice, 'legitimate-content')","+      // The trusted origin must have actually been contacted for Alice's","+      // request, proving the poisoned entry was not served.","+      assert.notDeepEqual(hitsAfterAlice, hitsBeforeAlice)","+    } finally {","+      await agent.close()","+    }","+  })","+})","+","+test('cache does not store a cross-origin redirect response under the original origin key (sqlite persistence)', { skip: runtimeFeatures.has('sqlite') === false }, async () => {","+  const database = join(tmpdir(), `undici-cache-redirect-origin-${process.pid}.sqlite`)","+  try {","+    await withOrigins(async ({ state, trustedOrigin }) => {","+      const firstStore = new cacheStores.SqliteCacheStore({ location: database })","+      const firstAgent = new Agent().compose(","+        interceptors.redirect({ maxRedirections: 2 }),","+        interceptors.cache({ store: firstStore, type: 'shared' })","+      )","+      const mallory = await requestAgent(firstAgent, trustedOrigin, 'mallory')","+      await firstAgent.close()","+      firstStore.close()","+","+      state.redirectEnabled = false","+      const hitsBeforeAlice = [state.trustedHits, state.attackerHits]","+      const reopenedStore = new cacheStores.SqliteCacheStore({ location: database })","+      const secondAgent = new Agent().compose(","+        interceptors.redirect({ maxRedirections: 2 }),","+        interceptors.cache({ store: reopenedStore, type: 'shared' })","+      )","+      const alice = await requestAgent(secondAgent, trustedOrigin, 'alice')","+      const hitsAfterAlice = [state.trustedHits, state.attackerHits]","+      await secondAgent.close()","+      reopenedStore.close()","+","+      assert.equal(mallory, 'attacker-controlled-content')","+      assert.equal(alice, 'legitimate-content')","+      assert.notDeepEqual(hitsAfterAlice, hitsBeforeAlice)","+    })","+  } finally {","+    await rm(database, { force: true })","+  }","+})","+","+test('reverse interceptor order (cache outside redirect) still works', async () => {","+  await withOrigins(async ({ state, trustedOrigin }) => {","+    const agent = new Agent().compose(","+      interceptors.cache({","+        store: new cacheStores.MemoryCacheStore(),","+        type: 'shared'","+      }),","+      interceptors.redirect({ maxRedirections: 2 })","+    )","+","+    const mallory = await requestAgent(agent, trustedOrigin, 'mallory')","+    state.redirectEnabled = false","+    const alice = await requestAgent(agent, trustedOrigin, 'alice')","+","+    try {","+      assert.equal(mallory, 'attacker-controlled-content')","+      assert.equal(alice, 'legitimate-content')","+      assert.equal(state.trustedHits, 2)","+      assert.equal(state.attackerHits, 1)","+    } finally {","+      await agent.close()","+    }","+  })","+})","+","+test('same-origin redirect responses are still cached by the cache interceptor', async () => {","+  const state = { redirectEnabled: true, targetHits: 0 }","+  const server = createServer((req, res) => {","+    if (state.redirectEnabled && req.url === '/resource') {","+      res.writeHead(302, { location: '/target' })","+      res.end()","+      return","+    }","+    state.targetHits++","+    res.writeHead(200, {","+      'cache-control': 'public, max-age=86400',","+      'content-type': 'text/plain'","+    })","+    res.end('same-origin-content')","+  })","+  await listen(server)","+  const origin = `http://127.0.0.1:${server.address().port}`","+","+  const agent = new Agent().compose(","+    interceptors.redirect({ maxRedirections: 2 }),","+    interceptors.cache({","+      store: new cacheStores.MemoryCacheStore(),","+      type: 'shared'","+    })","+  )","+","+  try {","+    const first = await agent.request({ origin, path: '/resource', method: 'GET' })","+      .then(response => response.body.text())","+    // Disable the redirect then request the original URL again: the response","+    // should be served from the cache, proving a same-origin redirect was not","+    // incorrectly rejected by the cross-origin origin check.","+    state.redirectEnabled = false","+    const hitsBefore = state.targetHits","+    const second = await agent.request({ origin, path: '/resource', method: 'GET' })","+      .then(response => response.body.text())","+","+    assert.equal(first, 'same-origin-content')","+    assert.equal(second, 'same-origin-content')","+    // Second request must be a cache hit (the /target origin was not re-hit).","+    assert.equal(state.targetHits, hitsBefore)","+  } finally {","+    await agent.close()","+    await closeServer(server)","+  }","+})","+","+test('origin-bound Pool cannot be poisoned by a cross-origin redirect', async () => {","+  await withOrigins(async ({ state, trustedOrigin }) => {","+    const pool = new Pool(trustedOrigin).compose(","+      interceptors.redirect({ maxRedirections: 2 }),","+      interceptors.cache({","+        store: new cacheStores.MemoryCacheStore(),","+        type: 'shared'","+      })","+    )","+","+    const first = await pool.request({ path: '/resource', method: 'GET' })","+      .then(response => response.body.text())","+    state.redirectEnabled = false","+    const second = await pool.request({ path: '/resource', method: 'GET' })","+      .then(response => response.body.text())","+","+    try {","+      assert.equal(first, 'legitimate-content')","+      assert.equal(second, 'legitimate-content')","+      // An origin-bound dispatcher must not be able to reach the attacker origin.","+      assert.equal(state.attackerHits, 0)","+    } finally {","+      await pool.close()","+    }","+  })","+})","+","+// A redirect response must only be reused for a request that could itself","+// reach it. Matching the cache-key origin is not sufficient: when the original","+// hop is `private, no-store` and redirects to a different resource on the same","+// origin, the final body must not be stored under the original request's key,","+// otherwise a later caller that is not entitled to the redirect (here an","+// unauthenticated one) is served the private body from the shared cache.","+test('cache does not store a same-origin redirect response under the original path key', async () => {","+  const state = { authEnabled: true, objectHits: 0 }","+","+  const server = createServer((req, res) => {","+    if (req.url === '/account') {","+      if (state.authEnabled && req.headers.authorization) {","+        res.writeHead(302, {","+          'cache-control': 'private, no-store',","+          location: '/signed-object?token=alice'","+        })","+        res.end()","+        return","+      }","+      res.writeHead(403, { 'cache-control': 'no-store' })","+      res.end('denied')","+      return","+    }","+","+    if (req.url.startsWith('/signed-object')) {","+      state.objectHits++","+      res.writeHead(200, {","+        'cache-control': 'public, max-age=86400',","+        'content-type': 'text/plain'","+      })","+      res.end('alice-private-object')","+      return","+    }","+","+    res.writeHead(404)","+    res.end('not found')","+  })","+","+  await listen(server)","+  const origin = `http://127.0.0.1:${server.address().port}`","+","+  const agent = new Agent().compose(","+    interceptors.redirect({ maxRedirections: 2 }),","+    interceptors.cache({","+      store: new cacheStores.MemoryCacheStore(),","+      type: 'shared'","+    })","+  )","+","+  try {","+    const authed = await agent.request({","+      origin,","+      path: '/account',","+      method: 'GET',","+      headers: { authorization: 'Bearer alice' }","+    }).then(response => response.body.text())","+    assert.equal(authed, 'alice-private-object')","+","+    state.authEnabled = false","+    const anon = await agent.request({","+      origin,","+      path: '/account',","+      method: 'GET'","+    }).then(response => response.body.text())","+","+    // The unauthenticated caller must not receive the private object from the","+    // cache. With the request no longer authenticated the account endpoint","+    // denies it; a poisoned cache entry would instead return the private body.","+    assert.notEqual(anon, 'alice-private-object')","+    assert.equal(anon, 'denied')","+  } finally {","+    await agent.close()","+    await closeServer(server)","+  }","+})","+","+// The guard against caching a cross-origin redirect response must hold for any","+// composition, not only `compose(redirect(), cache())`. The cache must learn","+// the final origin without depending on a shared mutable options object, since","+// an interceptor between the cache and the redirect (here `deduplicate`) may","+// hand the redirect a copy, so composing one must not reopen cross-origin","+// cache poisoning.","+test('cache does not store a cross-origin redirect response when a copying interceptor sits between cache and redirect', async () => {","+  await withOrigins(async ({ state, trustedOrigin }) => {","+    const agent = new Agent().compose(","+      interceptors.redirect({ maxRedirections: 2 }),","+      interceptors.deduplicate(),","+      interceptors.cache({","+        store: new cacheStores.MemoryCacheStore(),","+        type: 'shared'","+      })","+    )","+","+    const mallory = await requestAgent(agent, trustedOrigin, 'mallory')","+    state.redirectEnabled = false","+    const hitsBeforeAlice = [state.trustedHits, state.attackerHits]","+    const alice = await requestAgent(agent, trustedOrigin, 'alice')","+    const hitsAfterAlice = [state.trustedHits, state.attackerHits]","+","+    try {","+      assert.equal(mallory, 'attacker-controlled-content')","+      // Alice must receive the legitimate origin's response, not the poisoned","+      // attacker bytes, and the trusted origin must be contacted again.","+      assert.equal(alice, 'legitimate-content')","+      assert.notDeepEqual(hitsAfterAlice, hitsBeforeAlice)","+    } finally {","+      await agent.close()","+    }","+  })","+})","+","+// Deduplicated requests that join an in-flight request before it starts receive","+// the response through a separate replay path. That path must still carry the","+// redirect history, otherwise a joined request caches a cross-origin redirect","+// response under the original key while the primary request correctly rejects","+// it.","+test('cache does not store a cross-origin redirect response for a deduplicated concurrent request', async () => {","+  const state = { redirectEnabled: true, attackerHits: 0 }","+","+  const attacker = createServer((_req, res) => {","+    state.attackerHits++","+    res.writeHead(200, {","+      'cache-control': 'public, max-age=86400',","+      'content-type': 'text/plain'","+    })","+    res.end('attacker-controlled-content')","+  })","+","+  const trusted = createServer((req, res) => {","+    if (state.redirectEnabled && req.url === '/resource') {","+      // Delay the redirect so both concurrent requests are in-flight together","+      // and the second is deduplicated onto the first.","+      setTimeout(() => {","+        res.writeHead(302, {","+          location: `http://127.0.0.1:${attacker.address().port}/payload`","+        })","+        res.end()","+      }, 50)","+      return","+    }","+    res.writeHead(200, {","+      'cache-control': 'no-store',","+      'content-type': 'text/plain'","+    })","+    res.end('legitimate-content')","+  })","+","+  await Promise.all([listen(trusted), listen(attacker)])","+  const trustedOrigin = `http://127.0.0.1:${trusted.address().port}`","+","+  const agent = new Agent().compose(","+    interceptors.redirect({ maxRedirections: 2 }),","+    interceptors.deduplicate(),","+    interceptors.cache({","+      store: new cacheStores.MemoryCacheStore(),","+      type: 'shared'","+    })","+  )","+","+  try {","+    const request = () => agent","+      .request({ origin: trustedOrigin, path: '/resource', method: 'GET' })","+      .then(response => response.body.text())","+","+    const [first, second] = await Promise.all([request(), request()])","+    state.redirectEnabled = false","+    const third = await request()","+","+    assert.equal(first, 'attacker-controlled-content')","+    assert.equal(second, 'attacker-controlled-content')","+    // The entry must not have been poisoned by either the primary or the","+    // deduplicated request, so a later caller reaches the trusted origin.","+    assert.equal(third, 'legitimate-content')","+  } finally {","+    await agent.close()","+    await Promise.all([closeServer(trusted), closeServer(attacker)])","+  }","+})"],"additions":432,"deletions":0,"truncated":false},{"path":"test/interceptors/deduplicate-terminal.js","lines":["@@ -43,6 +43,7 @@ for (const errorCallbackThrows of [false, true]) {","         events.push(['other end', receivedTrailers])","       }","     })","+    handler.onRequestStart(controller, null)"," ","     if (errorCallbackThrows) {","       t.assert.throws(() => handler.onResponseEnd(controller, trailers), err => err === callbackError)","@@ -96,6 +97,7 @@ test('a paused waiting handler receives completion errors without being aborted'","     }","   })"," ","+  handler.onRequestStart({}, null)","   handler.onResponseData({}, Buffer.from('body'))","   handler.onResponseEnd({}, trailers)","   t.assert.deepStrictEqual(events, [['cleanup'], ['primary end']])","@@ -127,6 +129,7 @@ test('a paused waiting handler defers completion even without buffered data', t","     }","   })"," ","+  handler.onRequestStart({}, null)","   handler.onResponseEnd({}, trailers)","   t.assert.deepStrictEqual(events, ['cleanup'])"," ",""],"additions":3,"deletions":0,"truncated":false}],"additions":566,"deletions":14,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-28T14:41:51.086735+00:00"}