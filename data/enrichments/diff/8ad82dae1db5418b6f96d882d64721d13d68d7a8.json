k.parametrize(\"use_async\", [False, True])"," def test_policy_receives_extended_stats_without_losing_inputs(model_state, use_async):","+    \"\"\"Custom inputs survive direct calls and async subprocess planning.\"\"\"","+    worker_pid = os.getpid()","+","     @dataclass","     class Stats(EplbStats):","         metadata: tuple[int, ...] = ()"," ","     class Policy(DefaultEplbPolicy):","         def rebalance_experts(self, stats, old_global_expert_indices=None):","-            assert stats is published_stats","+            assert (os.getpid() != worker_pid) is use_async","             assert isinstance(stats, Stats)","             assert stats.metadata == (3, 7)","             assert stats.global_expert_load_window.device.type == \"cpu\"","@@ -273,7 +297,8 @@ def rebalance_experts(self, stats, old_global_expert_indices=None):","     state = _State(Policy())","     if use_async:","         model_state.eplb_stats = published_stats","-        result = run_rebalance_experts(model_state, state, current, None)","+        with closing(EplbPolicyProcess(state.policy)) as state.policy_process:","+            result = run_rebalance_experts(model_state, state, current, None)","     else:","         result = state.policy.rebalance_experts(published_stats, current)","     default_state = EplbState(ParallelConfig(), torch.device(\"cpu\"))","@@ -328,3 +353,231 @@ def test_sync_commit_updates_maps_before_device_work(model_state):","     torch.testing.assert_close(","         model_state.logical_to_physical_map[0, :, 0], torch.tensor([1, 0, 3, 2])","     )","+","+","+class _GatedPolicy(DefaultEplbPolicy):","+    def __init__(self, endpoint, fail):","+        self.endpoint = endpoint","+        self.fail = fail","+","+    def rebalance_experts(self, stats, old_global_expert_indices=None):","+        if self.endpoint is not None:","+            with socket.create_connection(self.endpoint, timeout=20) as connection:","+                connection.sendall(b\"r\")","+                ass