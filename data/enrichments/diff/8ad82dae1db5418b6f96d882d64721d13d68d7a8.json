p.clone()","+        weights = model.model.weight.detach().clone()","+        completed = threading.Event()","+        errors = []","+","+        def transfer():","+            try:","+                _transfer_cycle(state, None, False)","+            except Exception as error:","+                errors.append(error)","+            finally:","+                completed.set()","+","+        try:","+            with closing(EplbPolicyProcess(policy)) as state.policy_process:","+                torch.distributed.barrier(group=get_eplb_group().cpu_group)","+                worker = threading.Thread(target=transfer, daemon=True)","+                worker.start()","+                if rank == 0:","+                    deadline = time.monotonic() + 20","+                    while not entered_collective.is_set():","+                        frame = sys._current_frames().get(worker.ident)","+                        while frame is not None:","+                            if frame.f_code.co_name == \"all_reduce\":","+                                entered_collective.set()","+                                break","+                            frame = frame.f_back","+                        if entered_collective.is_set():","+                            break","+                        assert not completed.wait(0.001)","+                        assert time.monotonic() < deadline","+                else:","+                    with listener.accept()[0] as connection:","+                        assert connection.recv(1) == b\"r\"","+                        assert entered_collective.wait(20)","+                        if reason == \"reset\":"],"additions":122,"deletions":8,"truncated":false}],"additions":448,"deletions":18,"truncated":true,"file_count":5},"error":null,"fetched_at":"2026-11-27T19:03:29.685995+00:00"}