_or_hostile_project_workspace_config_in_cwd() {","+    let CommandTempCwd { pacquet, root, workspace, .. } = CommandTempCwd::init();","+    fs::write(workspace.join(\"pnpm-workspace.yaml\"), \"packages: [\\n\")","+        .expect(\"write malformed pnpm-workspace.yaml\");","+    fs::write(workspace.join(\"package.json\"), r#\"{ \"packageManager\": \"pnpm@0.0.0\" }\"#)","+        .expect(\"write package.json\");","+    let pnpm_home = root.path().join(\"pnpm-home\");","+    let global_bin = pnpm_home.join(\"bin\");","+    let existing_path = std::env::var(\"PATH\").unwrap_or_default();","+    let path = format!(\"{}:{existing_path}\", global_bin.display());","+","+    let output = pacquet","+        .with_env(\"PNPM_HOME\", &pnpm_home)","+        .with_env(\"HOME\", root.path())","+        .with_env(\"XDG_CONFIG_HOME\", root.path().join(\"xdg-config\"))","+        .with_env(\"PNPM_CONFIG_GLOBAL_BIN_DIR\", \"\")","+        .with_env(\"pnpm_config_global_bin_dir\", \"\")","+        .with_env(\"COREPACK_ROOT\", \"/fake/corepack\")","+        .with_env(\"PATH\", path)","+        .with_args([\"bin\", \"-g\"])","+        .output()","+        .expect(\"run pacquet bin -g\");","+    dbg!(&output);","+    assert!(output.status.success(), \"pacquet bin -g should succeed despite broken CWD yaml\");","+    assert_eq!(String::from_utf8_lossy(&output.stdout), format!(\"{}\\n\", global_bin.display()));","+","+    drop(root);","+}","+"," /// Regression test for"," /// [pnpm/pnpm#14622](https://github.com/pnpm/pnpm/issues/14622): the path"," /// printed under the subdirectory does not exist, so tools spawning"],"additions":31,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/global.rs","lines":["@@ -1935,6 +1935,272 @@ fn global_update_requires_approval_for_the_immature_version() {"],"additions":0,"deletions":0,"truncated":false}],"additions":330,"deletions":122,"truncated":true,"file_count":18},"error":null,"fetched_at":"2026-11-20T17:58:04.873195+00:00"}