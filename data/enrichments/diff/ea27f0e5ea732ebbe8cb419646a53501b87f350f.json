  .into_diagnostic()","+    }","+","+    async fn render_global_tree(","+        &self,","+        config: &Config,","+        global_pkg_dir: &Path,","+        selects_tool: bool,","+    ) -> miette::Result<Option<String>> {","+        let Some((install_dir, params)) =","+            pick_global_install_dir(global_pkg_dir, &self.packages, selects_tool)?","+        else {","+            return Ok(None);","+        };","+        let group_config = global_install_dir_config(config, &install_dir);","+        self.render_projects(","+            &group_config,","+            std::slice::from_ref(&install_dir),","+            params,","+            &install_dir,","+            true,","+        )","+        .await","+        .map(Some)","+    }","+}","+","+fn pick_global_install_dir<'a>(","+    global_pkg_dir: &Path,","+    params: &'a [String],","+    selects_tool: bool,","+) -> miette::Result<Option<(PathBuf, &'a [String])>> {","+    let all_install_dirs = find_global_install_dirs(global_pkg_dir, &[]).into_diagnostic()?;","+    if let [install_dir] = all_install_dirs.as_slice() {","+        // Single global install: keep params so the search can cover the whole","+        // tree, matching regular `pnpm ls`.","+        return Ok(Some((install_dir.clone(), params)));","+    }","+    let matching_install_dirs = find_global_install_dirs(global_pkg_dir, params).into_diagnostic()?;","+    // Params that select only a tool, such as `rust`, are served by the flat listing.","+    if matching_install_dirs.len() > 1","+        || (matching_install_dirs.is_empty() && !all_install_dirs.is_empty() && !selects_tool)","+    {","+        return Err(miette::miette!(","+            code = \"ERR_PNPM_GLOBAL_LS_DEPTH_NOT_SUPPORTED\",","+            \"Cannot list a merged dependency tree across multiple global packages. \\","+                 Each global package is installed in an isolated directory with its own lockfile, \\","+                 so transitive dependencies cannot be coherently merged. \\","+                 Filter to a single global package by its top-level name, or omit --depth.\"","+        ));","+    }","+    // Params served their purpose of narrowing to a single install group;","+    // passing them on would activate search semantics, which prune the matched","+    // package's children.","+    Ok(matching_install_dirs","+        .into_iter()","+        .next()","+        .map(|dir| (dir, &[][..])))","+}","+","+fn global_report_as(report_as: ReportAs) -> ListReportAs {","+    match report_as {","+        ReportAs::Tree => ListReportAs::Tree,","+        ReportAs::Json => ListReportAs::Json,","+        ReportAs::Parseable => ListReportAs::Parseable,","+    }","+}","+","+/// `config` re-anchored on one isolated global package install directory so","+/// tree and dependents inspection read `<install_dir>/node_modules` rather","+/// than the pnpm home's or caller project's `modules_dir`.","+pub(in crate::cli_args) fn global_install_dir_config(","+    config: &Config,","+    install_dir: &Path,","+) -> Config {","+    let mut group_config = config.clone();","+    group_config.modules_dir = install_dir.join(\"node_modules\");","+    group_config.install_state_dir = group_config.modules_dir.join(\".pnpm\");","+    group_config.workspace_dir = None;","+    group_config","+}"],"additions":122,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/pre_command.rs","lines":["@@ -139,7 +139,11 @@ fn pre_command_plan_with_state(","     }","     let config =","         load_pre_command_config(invocation, config_overrides, &dir, ConfigLoad::PIN_DECISION)?;","-    let roots = PinRoots::of(&config, &dir);","+    let roots = if invocation.global {","+        PinRoots { manifest: dir.clone(), env: dir.clone() }","+    } else {","+        PinRoots::of(&config, &dir)","+    };","     let manifest = read_root_manifest(&roots.manifest);","     let wanted_pm = manifest.as_ref().and_then(wanted_package_manager);","     let locked_env = read_p