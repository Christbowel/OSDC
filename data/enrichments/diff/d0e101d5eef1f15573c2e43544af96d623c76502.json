s and property names","+     * @param escapeSlash Whether forward slash ({@code \"/\"}) is to be escaped","+     *","+     * @return 128-entry {@code int[]} that contains escape definitions","+     *","+     * @since 3.4","+     */","+    public static int[] get7BitOutputEscapes(CharacterEscapes esc, int quoteChar,","+            boolean escapeSlash)","+    {","+        if (esc == null) {","+            return get7BitOutputEscapes(quoteChar, escapeSlash);","+        }","+        final int[] source = esc.getEscapeCodesForAscii();","+        final RequiredEscapes cached = esc._requiredEscapes;","+        if ((cached != null) && cached.matches(source, quoteChar, escapeSlash)) {","+            return cached.result();","+        }","+        final int[] result = _withRequiredEscapes(source, quoteChar, escapeSlash);","+        // Only worth caching if a copy was needed","+        if (result != source) {","+            esc._requiredEscapes = new RequiredEscapes(source, quoteChar, escapeSlash, result);","+        }","+        return result;","+    }","+","+    // Helper method for ensuring that given escape table escapes the quote","+    // character (and forward slash, if requested): returns modified copy if","+    // changes are needed, otherwise passed-in table as-is.","+    private static int[] _withRequiredEscapes(int[] escapes, int quoteChar, boolean escapeSlash)","+    {","+        final boolean addQuote = (quoteChar < escapes.length) && (escapes[quoteChar] == 0);","+        final boolean addSlash = escapeSlash && ('/' < escapes.length) && (escapes['/'] == 0);","+        if (addQuote || addSlash) {","+            escapes = Arrays.copyOf(escapes, escapes.length);","+            if (addQuote) {","+                // Use \"natural\" escape for apostrophe (and double-quote) if possible","+                escapes[quoteChar] = (quoteChar == '\\'' || quoteChar == '\"') ? quoteChar","+                        : CharacterEscapes.ESCAPE_STANDARD;","+            }","+            if (addSlash) {","+                escapes['/'] = '/';","+            }","+        }","+        return escapes;","+    }","+","     public static int charToHex(int ch)","     {","         // 08-Nov-2019, tatu: As per [core#540] and [core#578], callers may pass","@@ -315,6 +371,18 @@ public static byte[] copyHexBytes(boolean uppercase) {","         return (uppercase) ? HB.clone() : HBlower.clone();","     }"," ","+    /**","+     * Immutable holder for an escape table derived from a custom","+     * {@link CharacterEscapes} table, cached on that instance.","+     *","+     * @since 3.4","+     */","+    record RequiredEscapes(int[] source, int quoteChar, boolean escapeSlash, int[] result) {","+        boolean matches(int[] src, int qc, boolean slash) {","+            return (src == source) && (qc == quoteChar) && (slash == escapeSlash);","+        }","+    }","+","     /**","      * Helper used for lazy initialization of alternative escape (quoting)","      * table, used for escaping content that uses non-standard quote","@@ -334,25 +402,8 @@ public int[] altEscapesFor(int quoteChar, boolean escapeSlash)","                     ? _altEscapesWithSlash[quoteChar]","                     : _altEscapesNoSlash[quoteChar];","             if (esc == null) {","-                esc = escapeSlash","-                        ? sOutputEscapes128WithSlash","-                        : sOutputEscapes128NoSlash;","-                esc = Arrays.copyOf(esc, esc.length);","-                // Only add escape setting if character does not already have it","-                if (esc[quoteChar] == 0) {","-                    // And try to use \"natural\" escape for apos","-                    int quoteStyle;","-                    switch (quoteChar) {","-                    case '\\'':","-                    case '\"':","-                        quoteStyle = quoteChar;","-                        break;","-                    default:","-                        quoteStyle = CharacterEscapes.E