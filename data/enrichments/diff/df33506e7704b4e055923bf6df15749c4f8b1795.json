{"id":"df33506e7704b4e055923bf6df15749c4f8b1795","axis":"silent","repo":"pnpm/pnpm","sha":"df33506e7704b4e055923bf6df15749c4f8b1795","parsed":{"files":[{"path":".changeset/drop-stale-optional-peer-pins.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+Fixed repeated installs changing peer providers after a dependency update."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/frozen-catalog-peer-children.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+Frozen installs with v13 lockfiles now accept valid peer dependencies of injected workspace packages that use catalogs."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/watch-before-script-exec.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+Scripts now stop when pnpm's process group is killed while they are starting. A script could previously start before its process group was registered for cleanup."],"additions":5,"deletions":0,"truncated":false},{"path":".github/workflows/peer-resolution-oracles.yml","lines":["@@ -0,0 +1,58 @@","+name: Peer Resolution Oracles","+","+permissions:","+  contents: read","+","+on:","+  workflow_dispatch:","+  schedule:","+    - cron: '30 4 * * *'","+","+concurrency:","+  group: ${{ github.workflow }}-${{ github.ref }}","+  cancel-in-progress: true","+","+jobs:","+  peer-resolution:","+    if: github.repository == 'pnpm/pnpm'","+    runs-on: blacksmith-8vcpu-ubuntu-2404","+    timeout-minutes: 30","+    env:","+      CARGO_PROFILE_DEV_DEBUG: line-tables-only","+      CARGO_PROFILE_TEST_DEBUG: line-tables-only","+      PROPTEST_CASES: '1024'","+      PROPTEST_MAX_SHRINK_ITERS: '256'","+      PROPTEST_RNG_SEED: ${{ github.run_id }}","+    steps:","+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1","+        with:","+          persist-credentials: false","+","+      - name: Install Rust toolchain","+        uses: $/.github/actions/rustup","+","+      - name: Install dependencies","+        uses: $/.github/actions/install-crates","+","+      - name: Install Node.js","+        run: pnpm runtime set node 22 --global","+","+      - name: Install test tools","+        uses: taiki-e/install-action@cfdb7ed4ccc7c7dce37759eae89dc5674b469b39 # v2.90.3","+        with:","+          tool: just,cargo-nextest","+","+      - name: Test generated peer workspaces","+        shell: bash","+        run: |","+          echo \"PROPTEST_CASES=$PROPTEST_CASES PROPTEST_RNG_SEED=$PROPTEST_RNG_SEED PROPTEST_MAX_SHRINK_ITERS=$PROPTEST_MAX_SHRINK_ITERS\" | tee peer-oracles.log","+          pnpm test:rust -p pnpm-package-manager -E 'test(peer_proptest::)' 2>&1 | tee -a peer-oracles.log","+","+      - name: Save seed and counterexamples","+        if: always()","+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2","+        with:","+          name: peer-resolution-oracles","+          path: peer-oracles.log","+          if-no-files-found: ignore","+          retention-days: 14"],"additions":58,"deletions":0,"truncated":false},{"path":"pnpm/CONTRIBUTING.md","lines":["@@ -181,6 +181,22 @@ guarded by `pnpm_testing_utils::allow_known_failure!`), and the"," verification step of temporarily breaking the implementation to confirm a"," ported test actually fails for the right reason before committing."," ","+### Generated peer-resolution oracles","+","+The [Peer Resolution Oracles workflow](../.github/workflows/peer-resolution-oracles.yml)","+runs larger generated-workspace suites daily. Its run ID is the random seed;","+the `peer-resolution-oracles` artifact retains that seed and failure output.","+Reproduce a run with the values from its log:","+","+```sh","+PROPTEST_CASES=1024 PROPTEST_RNG_SEED=143 PROPTEST_MAX_SHRINK_ITERS=256 pnpm test:rust -p pnpm-package-manager -E 'test(peer_proptest::)'","+```","+","+Keep a minimized failure as a fixed regression test when fixing its cause.","+The moving-provider property checks frozen acceptance and stability of the","+installed dependency graph after dependency changes. It keeps published manifests unchanged and allows","+valid locked peer choices to differ from fresh resolution.","+"," ## Benchmarking"," "," First, start a local registry server, such as [verdaccio](https://verdaccio.org/):"],"additions":16,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/peer_convergence.rs","lines":["@@ -25,6 +25,7 @@"," "," mod fast_update;"," mod harness;","+mod moving_providers;"," "," use harness::{Harness, Move, Project, project};"," "],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/peer_convergence/moving_providers.rs","lines":["@@ -0,0 +1,176 @@","+use crate::_utils::{ManifestDeps, WorkspaceFixture, assert_success, read_v11_bundle_path};","+use pnpm_lockfile::Lockfile;","+use pnpm_testing_utils::registry::TestRegistry;","+use serde_json::{Value, json};","+use std::{ffi::OsStr, fs, path::Path};","+","+#[test]","+fn changing_a_consumer_keeps_optional_peer_pins_on_cycles() {","+    for suffix_length in [20, 1000] {","+        for format in [\"v9\", \"v13\"] {","+            check_provider_pin(None, format, suffix_length);","+        }","+        if let Some(bundle) = read_v11_bundle_path() {","+            check_provider_pin(Some(&bundle), \"v9\", suffix_length);","+        }","+    }","+}","+","+fn check_provider_pin(bundle: Option<&OsStr>, format: &str, suffix_length: usize) {","+    let registry_dir = tempfile::tempdir().unwrap();","+    let mut fixture = WorkspaceFixture::new();","+    fixture.registry.mock_instance = cycle_registry(registry_dir.path());","+    fixture.append_workspace_yaml(&format!(","+        \"autoInstallPeers: true\\nresolvePeersFromWorkspaceRoot: false\\ndedupePeerDependents: true\\npeersSuffixMaxLength: {suffix_length}\\nlockfile:\\n  format: {format}\\n\",","+    ));","+    fixture.write_root_manifest(","+        \"root\",","+        ManifestDeps { prod: &[(\"cycle-provider\", \"1.0.0\")], ..Default::default() },","+    );","+    fixture.project(","+        \"a\",","+        \"app\",","+        ManifestDeps { prod: &[(\"cycle-consumer\", \"1.0.0\")], ..Default::default() },","+    );","+    fixture.project(","+        \"b\",","+        \"other\",","+        ManifestDeps { prod: &[(\"cycle-provider\", \"2.0.0\")], ..Default::default() },","+    );","+    let install = || install_lockfile(&fixture, bundle);","+    install();","+    fixture.project(","+        \"a\",","+        \"app\",","+        ManifestDeps { prod: &[(\"cycle-consumer\", \"2.0.0\")], ..Default::default() },","+    );","+    install();","+    let changed = Lockfile::load_wanted_from_dir(&fixture.workspace).unwrap().unwrap();","+    assert_updated_consumer_provider(&changed);","+    install();","+    let reinstalled = Lockfile::load_wanted_from_dir(&fixture.workspace).unwrap().unwrap();","+    assert_eq!(changed, reinstalled, \"{bundle:?}, {format}, {suffix_length}\");","+}","+","+fn assert_updated_consumer_provider(lockfile: &Lockfile) {","+    let consumer_name = \"cycle-consumer\".parse().unwrap();","+    let bridge_name = \"cycle-bridge\".parse().unwrap();","+    let provider_name = \"cycle-provider\".parse().unwrap();","+    let consumer = lockfile.importers[\"packages/a\"].dependencies.as_ref().unwrap()[&consumer_name]","+        .version","+        .resolved_key(&consumer_name)","+        .unwrap();","+    let snapshots = lockfile.snapshots.as_ref().unwrap();","+    let bridge = snapshots[&consumer].dependencies.as_ref().unwrap()[&bridge_name]","+        .resolve(&bridge_name)","+        .unwrap();","+    let provider = snapshots[&bridge].optional_dependencies.as_ref().unwrap()[&provider_name]","+        .resolve(&provider_name)","+        .unwrap();","+    assert_eq!(provider.without_peer().to_string(), \"cycle-provider@2.0.0\");","+}","+","+fn cycle_registry(root: &Path) -> TestRegistry {","+    let manifests = [","+        (\"cycle-consumer\", \"1.0.0\", json!({ \"cycle-provider\": \"^1.0.0\" }), json!({})),","+        (\"cycle-consumer\", \"2.0.0\", json!({ \"cycle-bridge\": \"*\" }), json!({})),","+        (","+            \"cycle-bridge\",","+            \"2.0.0\",","+            json!({ \"cycle-provider\": \"*\" }),","+            json!({ \"cycle-provider\": { \"optional\": true } }),","+        ),","+        (\"cycle-provider\", \"1.0.0\", json!({ \"cycle-bridge\": \"^2.0.0\" }), json!({})),","+        (\"cycle-provider\", \"2.0.0\", json!({}), json!({})),","+    ]","+    .map(|(name, version, peers, optional)| {","+        json!({","+            \"name\": name,","+            \"version\": version,","+            \"peerDependencies\": peers,","+            \"peerDependenciesMeta\": optional,","+        })","+    });","+    registry_from_manifests(root, manifests)","+}","+","+fn registry_from_manifests(","+    root: &Path,","+    manifests: impl IntoIterator<Item = Value>,","+) -> TestRegistry {","+    let packages = root.join(\"packages\");","+    for manifest in manifests {","+        let directory = packages","+            .join(manifest[\"name\"].as_str().unwrap())","+            .join(manifest[\"version\"].as_str().unwrap());","+        fs::create_dir_all(&directory).unwrap();","+        fs::write(directory.join(\"package.json\"), manifest.to_string()).unwrap();","+    }","+    let storage = root.join(\"storage\");","+    pnpr_fixtures::build_storage_at(&packages, &storage);","+    TestRegistry::start_static_with_storage(&storage)","+}","+","+fn install_lockfile(fixture: &WorkspaceFixture, bundle: Option<&OsStr>) {","+    let args = [\"install\", \"--lockfile-only\", \"--no-prefer-frozen-lockfile\"];","+    let output = match bundle {","+        Some(bundle) => fixture.v11_command_at(bundle, &fixture.workspace, args),","+        None => fixture.command_at(&fixture.workspace, args),","+    };","+    assert_success(&output);","+}","+","+#[test]","+fn changing_a_root_provider_keeps_nested_peer_edges() {","+    for format in [\"v9\", \"v13\"] {","+        check_required_cycle(None, format);","+    }","+    if let Some(bundle) = read_v11_bundle_path() {","+        check_required_cycle(Some(&bundle), \"v9\");","+    }","+}","+","+fn check_required_cycle(bundle: Option<&OsStr>, format: &str) {","+    let registry_dir = tempfile::tempdir().unwrap();","+    let mut fixture = WorkspaceFixture::new();","+    fixture.registry.mock_instance = registry_from_manifests(","+        registry_dir.path(),","+        [","+            json!({ \"name\": \"cycle-source\", \"version\": \"1.0.0\", \"dependencies\": { \"cycle-middle\": \"1.0.0\" } }),","+            json!({ \"name\": \"cycle-source\", \"version\": \"2.0.0\" }),","+            json!({ \"name\": \"cycle-middle\", \"version\": \"1.0.0\", \"dependencies\": { \"cycle-leaf\": \"2.0.0\" }, \"peerDependencies\": { \"cycle-leaf\": \"^2.0.0\" } }),","+            json!({ \"name\": \"cycle-middle\", \"version\": \"2.0.0\", \"dependencies\": { \"cycle-source\": \"1.0.0\" }, \"peerDependencies\": { \"cycle-source\": \"^1.0.0\" } }),","+            json!({ \"name\": \"cycle-leaf\", \"version\": \"2.0.0\", \"dependencies\": { \"cycle-middle\": \"2.0.0\", \"cycle-source\": \"2.0.0\" } }),","+        ],","+    );","+    fixture.append_workspace_yaml(&format!(\"autoInstallPeers: false\\nresolvePeersFromWorkspaceRoot: false\\ndedupeInjectedDeps: false\\npeersSuffixMaxLength: 20\\nlockfile:\\n  format: {format}\\n\"));","+    fixture.project(","+        \"shared\",","+        \"shared\",","+        ManifestDeps { prod: &[(\"cycle-middle\", \"1.0.0\")], ..Default::default() },","+    );","+    let root_manifest = |version| json!({ \"name\": \"root\", \"version\": \"1.0.0\", \"dependencies\": { \"cycle-source\": version, \"shared\": \"workspace:*\" }, \"dependenciesMeta\": { \"shared\": { \"injected\": true } } });","+    fs::write(fixture.workspace.join(\"package.json\"), root_manifest(\"2.0.0\").to_string()).unwrap();","+    install_lockfile(&fixture, bundle);","+    fs::write(fixture.workspace.join(\"package.json\"), root_manifest(\"1.0.0\").to_string()).unwrap();","+    install_lockfile(&fixture, bundle);","+    let changed = Lockfile::load_wanted_from_dir(&fixture.workspace).unwrap().unwrap();","+    install_lockfile(&fixture, bundle);","+    let reinstalled = Lockfile::load_wanted_from_dir(&fixture.workspace).unwrap().unwrap();","+    assert_eq!(nested_provider(&changed), nested_provider(&reinstalled), \"{bundle:?}, {format}\");","+}","+","+fn nested_provider(lockfile: &Lockfile) -> String {","+    let shared = \"shared\".parse().unwrap();","+    let mut key = lockfile.importers[\".\"].dependencies.as_ref().unwrap()[&shared]","+        .version","+        .resolved_key(&shared)","+        .unwrap();","+    for name in [\"cycle-middle\", \"cycle-leaf\", \"cycle-middle\", \"cycle-source\"] {","+        let name = name.parse().unwrap();","+        key = lockfile.snapshots.as_ref().unwrap()[&key].dependencies.as_ref().unwrap()[&name]","+            .resolve(&name)","+            .unwrap();","+    }","+    key.without_peer().to_string()","+}"],"additions":176,"deletions":0,"truncated":false},{"path":"pnpm/crates/executor/src/process_tracker.rs","lines":["@@ -228,17 +228,15 @@ pub fn spawn_child<'tracker>(","     // must a relayed signal address that group rather than the child.","     let own_process_group = cfg!(unix) && separate_process_group;","     #[cfg(unix)]","-    if own_process_group {","-        group_watchdog::start()?;","-    }","+    let (child, watched) =","+        if own_process_group { group_watchdog::spawn(command)? } else { (command.spawn()?, false) };","+    #[cfg(not(unix))]","     let child = command.spawn()?;","     crate::job_control::assign_child(&child);","     // A task a bail may cancel gets a job of its own, so the cancellation","     // reaches everything the task started.","     #[cfg(windows)]","     let job = process_tracker.and_then(|_| crate::job_control::TaskJob::contain(&child));","-    #[cfg(unix)]","-    let (child, watched) = watch_process_group(child, own_process_group)?;","     let relay = crate::interrupt::relay_to_child(child.id(), own_process_group);","     let registration = process_tracker.map(|tracker| {","         tracker.register(RunningExecution::Process {","@@ -258,27 +256,6 @@ pub fn spawn_child<'tracker>(","     })"," }"," ","-/// Have the watchdog watch `child`'s group when the child leads one.","-/// Returns whether the group is watched.","-///","-/// A child left unwatched would be the very orphan the watchdog exists to","-/// prevent, so if the watch cannot be set up the child's group is killed","-/// before the failure is returned.","-#[cfg(unix)]","-fn watch_process_group(mut child: Child, own_process_group: bool) -> io::Result<(Child, bool)> {","-    if !own_process_group {","-        return Ok((child, false));","-    }","-    match group_watchdog::watch(child.id()) {","-        Ok(watched) => Ok((child, watched)),","-        Err(error) => {","-            terminate_process(child.id(), true, Stop::Forced);","-            let _ = child.wait();","-            Err(error)","-        }","-    }","-}","-"," #[cfg(unix)]"," fn spawns_without_terminal() -> bool {","     !crate::interrupt::has_controlling_terminal()"],"additions":3,"deletions":26,"truncated":false},{"path":"pnpm/crates/executor/src/process_tracker/group_watchdog.rs","lines":["@@ -6,8 +6,8 @@"," //! and leaves the script running, holding the caller's pipes open"," //! ([pnpm/pnpm#15555](https://github.com/pnpm/pnpm/issues/15555)). The"," //! signal cannot be relayed, so a `sh` in a group of its own stands watch","-//! instead: it reads a pipe only pnpm writes to, on which pnpm names each","-//! group it creates and each group it is done with. End of input means","+//! instead: each group leader registers itself through a pipe before `exec`,","+//! and pnpm releases the group when it is done with it. End of input means"," //! pnpm died, and the watchdog kills every group still named, as the"," //! signal would have had the children stayed in pnpm's group."," //!","@@ -56,20 +56,9 @@ for group in $groups; do kill -9 -\"$group\"; done\"#;"," /// The watch pnpm keeps over the process groups it creates."," static WATCH: Mutex<GroupWatch> = Mutex::new(GroupWatch::new());"," ","-/// Start the watchdog unless one is running, replacing one that exited. A child runs from the moment","-/// it is spawned, so starting the watchdog before the first group's leader","-/// keeps [`watch`] down to one write, rather than leaving that group","-/// unwatched for as long as a `sh` takes to spawn. Returns `false` when there","-/// is no `sh` to watch with.","-pub(super) fn start() -> io::Result<bool> {","-    lock().start()","-}","-","-/// Watch the process group led by `leader` until [`release`] is called for","-/// it, killing the group should pnpm die first. Returns `false` when there","-/// is no `sh` to watch with, which leaves the group on its own.","-pub(super) fn watch(leader: u32) -> io::Result<bool> {","-    lock().watch(leader)","+/// Register the child's group before its executable can run.","+pub(super) fn spawn(command: &mut Command) -> io::Result<(Child, bool)> {","+    lock().spawn(command)"," }"," "," /// Stop watching the process group led by `leader`, so pnpm's own exit","@@ -97,7 +86,7 @@ impl GroupWatch {","         Self { watchdog: None, leaders: Vec::new(), shell_missing: false }","     }"," ","-    /// See [`start`].","+    /// Start or replace the watchdog.","     pub(super) fn start(&mut self) -> io::Result<bool> {","         if self.shell_missing {","             return Ok(false);","@@ -110,7 +99,20 @@ impl GroupWatch {","         self.start_watchdog()","     }"," ","-    /// See [`watch`].","+    pub(super) fn spawn(&mut self, command: &mut Command) -> io::Result<(Child, bool)> {","+        if !self.start()? {","+            return command","+                .spawn()","+                .map(|child| (child, false));","+        }","+        let watchdog = self.watchdog.as_mut().expect(\"started watchdog\");","+        let child = spawn::registered(command, watchdog)?;","+        self.leaders.push(child.id());","+        Ok((child, true))","+    }","+","+    /// Watch an already running group.","+    #[cfg(test)]","     pub(super) fn watch(&mut self, leader: u32) -> io::Result<bool> {","         if self.shell_missing {","             return Ok(false);","@@ -224,3 +226,5 @@ impl GroupWatchdog {","         self.lifeline.write_all(line.as_bytes())","     }"," }","+","+mod spawn;"],"additions":22,"deletions":18,"truncated":false},{"path":"pnpm/crates/executor/src/process_tracker/group_watchdog/spawn.rs","lines":["@@ -0,0 +1,87 @@","+use super::{Command, GroupWatchdog};","+use std::{","+    io::{self, Read},","+    os::fd::{AsRawFd, RawFd},","+    process::Child,","+    sync::{","+        Arc,","+        atomic::{AtomicBool, Ordering},","+    },","+};","+","+pub(super) fn registered(command: &mut Command, watchdog: &mut GroupWatchdog) -> io::Result<Child> {","+    let (mut reader, writer) = {","+        // macOS sets CLOEXEC after creating a pipe; exclude concurrent forks.","+        let _spawning = pnpm_process::watchdog_spawning();","+        io::pipe()?","+    };","+    let active = Arc::new(AtomicBool::new(true));","+    let hook_active = Arc::clone(&active);","+    let lifeline = watchdog.lifeline.as_raw_fd();","+    let receipt = writer.as_raw_fd();","+    // SAFETY: the hook uses only atomic loads, stack arithmetic and async-signal-safe","+    // getpid/write calls. Both descriptors stay open until spawn returns. The hook","+    // is disabled before they close, including when the Command is reused.","+    unsafe {","+        command.pre_exec(move || {","+            if hook_active.load(Ordering::SeqCst) {","+                register(lifeline, receipt)?;","+            }","+            Ok(())","+        });","+    }","+    let spawned = command.spawn();","+    active.store(false, Ordering::SeqCst);","+    drop(writer);","+    if spawned.is_err() {","+        let mut bytes = [0; size_of::<u32>()];","+        match reader.read_exact(&mut bytes) {","+            Ok(()) => watchdog.release(u32::from_ne_bytes(bytes))?,","+            Err(error) if error.kind() == io::ErrorKind::UnexpectedEof => {}","+            Err(error) => return Err(error),","+        }","+    }","+    spawned","+}","+","+fn register(lifeline: RawFd, receipt: RawFd) -> io::Result<()> {","+    // SAFETY: getpid has no preconditions and is async-signal-safe.","+    let leader = unsafe { libc::getpid() } as u32;","+    write(receipt, &leader.to_ne_bytes())?;","+    let mut line = [0; 12];","+    line[11] = b'\\n';","+    let mut offset = 11;","+    let mut digits = leader;","+    loop {","+        offset -= 1;","+        line[offset] = b'0' + (digits % 10) as u8;","+        digits /= 10;","+        if digits == 0 {","+            break;","+        }","+    }","+    offset -= 1;","+    line[offset] = b'+';","+    write(lifeline, &line[offset..])","+}","+","+fn write(descriptor: RawFd, bytes: &[u8]) -> io::Result<()> {","+    loop {","+        // SAFETY: the descriptor is open and bytes stays valid for the write.","+        // The message fits PIPE_BUF, so a successful pipe write is atomic.","+        let written = unsafe { libc::write(descriptor, bytes.as_ptr().cast(), bytes.len()) };","+        if written == bytes.len() as isize {","+            return Ok(());","+        }","+        if written >= 0 {","+            return Err(io::Error::from(io::ErrorKind::WriteZero));","+        }","+        let error = io::Error::last_os_error();","+        if error.kind() != io::ErrorKind::Interrupted {","+            return Err(error);","+        }","+    }","+}","+","+#[cfg(test)]","+mod tests;"],"additions":87,"deletions":0,"truncated":false},{"path":"pnpm/crates/executor/src/process_tracker/group_watchdog/spawn/tests.rs","lines":["@@ -0,0 +1,66 @@","+use super::{Command, GroupWatchdog, registered};","+use std::{io::Read, process::Stdio};","+","+#[test]","+fn failed_exec_releases_the_group_registered_before_exec() {","+    let mut watchdog = recording_watchdog();","+    let mut command = Command::new(\"/nonexistent-pnpm-test-executable\");","+    command.process_group(0);","+    let error = registered(&mut command, &mut watchdog).expect_err(\"exec should fail\");","+    assert_eq!(error.kind(), std::io::ErrorKind::NotFound);","+    let lines = recorded(watchdog);","+    let [added, removed] = lines.lines().collect::<Vec<_>>()[..] else {","+        panic!(\"expected registration and release: {lines:?}\");","+    };","+    assert!(added.starts_with('+'));","+    assert_eq!(removed, format!(\"-{}\", &added[1..]));","+}","+","+#[test]","+fn reusing_a_command_registers_each_child_once() {","+    let mut watchdog = recording_watchdog();","+    let mut command = Command::new(\"true\");","+    command.process_group(0);","+    let mut leaders = Vec::new();","+    for _ in 0..3 {","+        let mut child = registered(&mut command, &mut watchdog).expect(\"spawn child\");","+        leaders.push(format!(\"+{}\", child.id()));","+        assert!(","+            child","+                .wait()","+                .expect(\"wait for child\")","+                .success(),","+        );","+    }","+    assert!(","+        command","+            .status()","+            .expect(\"spawn without registration\")","+            .success(),","+    );","+    let lines = recorded(watchdog);","+    assert_eq!(lines.lines().collect::<Vec<_>>(), leaders);","+}","+","+fn recording_watchdog() -> GroupWatchdog {","+    let mut process = Command::new(\"cat\")","+        .stdin(Stdio::piped())","+        .stdout(Stdio::piped())","+        .spawn()","+        .expect(\"spawn recorder\");","+    let lifeline = process.stdin.take().unwrap();","+    GroupWatchdog { process, lifeline }","+}","+","+fn recorded(watchdog: GroupWatchdog) -> String {","+    let GroupWatchdog { mut process, lifeline } = watchdog;","+    drop(lifeline);","+    let mut output = String::new();","+    process.stdout","+        .take()","+        .unwrap()","+        .read_to_string(&mut output)","+        .unwrap();","+    assert!(process.wait().unwrap().success());","+    output","+}"],"additions":66,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/dependencies_graph_to_lockfile/tests/peer_proptest.rs","lines":["@@ -7,8 +7,10 @@"," mod counterexamples;"," mod fast_update;"," mod fixture;","+mod graph;"," mod hashed_cycles;"," mod model;","+mod moving_providers;"," "," use std::{collections::BTreeMap, sync::Arc};"," "],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/dependencies_graph_to_lockfile/tests/peer_proptest/counterexamples.rs","lines":["@@ -320,6 +320,14 @@ fn incremental_install_preserves_a_valid_optional_peer_pin() {","         fresh.peers.direct_dependencies_by_importer[\"packages/a\"][\"p0\"].as_str(),","         \"p0@2.0.0(p1@2.0.0)\",","     );","+    let installed_lockfile = super::lockfile_with_settings(&installed, &workspace, settings);","+    let reinstalled =","+        super::resolve_with(&workspace, &order, settings, Reuse::Install(&installed_lockfile))","+            .unwrap();","+    assert_eq!(","+        installed_lockfile,","+        super::lockfile_with_settings(&reinstalled, &workspace, settings),","+    );"," }"," "," #[test]"],"additions":8,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/dependencies_graph_to_lockfile/tests/peer_proptest/fast_update.rs","lines":["@@ -1,6 +1,4 @@","-mod graph;","-","-use super::{Reuse, config, fixture::Fixture, in_order, model, resolve_with};","+use super::{Reuse, config, fixture::Fixture, graph, in_order, model, resolve_with};"," "," use pnpm_lockfile::{Lockfile, LockfileFormat};"," use proptest::prelude::*;"],"additions":1,"deletions":3,"truncated":false},{"path":"pnpm/crates/package-manager/src/