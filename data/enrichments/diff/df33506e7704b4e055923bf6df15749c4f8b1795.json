.packages.len();","+        let edges = &mut workspace.importers[importer];","+        edges.retain(|edge| edge.target != target);","+        edges.push(model::Edge { target, major });","+        let installed = resolve_with(&workspace, &order, settings, Reuse::Install(&lockfile))","+            .expect(\"changed workspace resolves\");","+        lockfile = lockfile_with_settings(&installed, &workspace, settings);","+        if !settings.injected || settings.format == pnpm_lockfile::LockfileFormat::V13 {","+            let freshness =","+                fixture::Fixture::new(&workspace, settings).frozen_check(&lockfile, settings);","+            let expected = Ok(());","+            prop_assert_eq!(freshness, expected);","+        }","+        let reinstalled = resolve_with(&workspace, &order, settings, Reuse::Install(&lockfile))","+            .expect(\"reinstall changed workspace\");","+        let rewritten = lockfile_with_settings(&reinstalled, &workspace, settings);","+        let mut installed_graph = lockfile.clone();","+        let mut reinstalled_graph = rewritten.clone();","+        crate::prune_unreachable_packages(&mut installed_graph);","+        crate::prune_unreachable_packages(&mut reinstalled_graph);","+        graph::assert_equivalent(&installed_graph, &reinstalled_graph);","+        lockfile = rewritten;","+    }","+","+    Ok(())","+}","+","+#[test]","+fn changed_optional_provider_is_stable() {","+    use model::{","+        Edge, PackageVersion, Peer,","+        PeerRange::{Any, Major},","+        Settings, Workspace,","+    };","+    let workspace = Workspace {","+        packages: vec![","+            vec![","+                PackageVersion {","+                    dependencies: vec![],","+                    peers: vec![Peer {","+                        target: 2,","+                        range: Major(1),","+                        optional: false,","+                        also_dependency: false,","+                    }],","+                },","+                PackageVersion {","+                    dependencies: vec![],","+                    peers: vec![Peer {","+                        target: 1,","+                        range: Any,","+                        optional: false,","+                        also_dependency: false,","+                    }],","+                },","+            ],","+            vec![","+                PackageVersion { dependencies: vec![], peers: vec![] },","+                PackageVersion {","+                    dependencies: vec![],","+                    peers: vec![Peer {","+                        target: 2,","+                        range: Any,","+                        optional: true,","+                        also_dependency: false,","+                    }],","+                },","+            ],","+            vec![","+                PackageVersion {","+                    dependencies: vec![],","+                    peers: vec![Peer {","+                        target: 1,","+                        range: Major(2),","+                        optional: false,","+                        also_dependency: false,","+                    }],","+                },","+                PackageVersion { dependencies: vec![], peers: vec![] },","+            ],","+        ],","+        importers: vec![","+            vec![Edge { target: 2, major: 1 }],","+            vec![Edge { target: 0, major: 1 }],","+            vec![Edge { target: 2, major: 2 }],","+        ],","+    };","+    for format in [pnpm_lockfile::LockfileFormat::V9, pnpm_lockfile::LockfileFormat::V13] {","+        for peers_suffix_max_length in [20, 1000] {","+            let settings = Settings { peers_suffix_max_length, format, ..Default::default() };"],"additions":130,"deletions":0,"truncated":false}],"additions":585,"deletions":47,"truncated":true,"file_count":16},"error":null,"fetched_at":"2026-11-12T17:12:39.042628+00:00"}