ter_with_token_auth,","@@ -150,6 +156,79 @@ def test_authentication_mode_endpoint_is_public(setup_cluster_with_token_auth):","     assert response.json() == {\"authentication_mode\": \"token\"}"," "," ","+def _metrics_endpoints():","+    \"\"\"Return the node, autoscaler and dashboard metrics URLs once all three are up.\"\"\"","+    node = ray.nodes()[0]","+    urls = {\"node\": f\"http://{node['NodeManagerAddress']}:{node['MetricsExportPort']}\"}","+    for name, key in (","+        (\"autoscaler\", \"AutoscalerMetricsAddress\"),","+        (\"dashboard\", \"DashboardMetricsAddress\"),","+    ):","+        wait_for_condition(lambda: _internal_kv_get(key) is not None)","+        urls[name] = f\"http://{_internal_kv_get(key).decode()}\"","+    for url in urls.values():","+        wait_for_condition(lambda: _metrics_reachable(url))","+    return urls","+","+","+def _metrics_reachable(url):","+    try:","+        requests.get(f\"{url}/metrics\", timeout=5)","+        return True","+    except requests.RequestException:","+        return False","+","+","+@pytest.fixture(params=[\"v1\", \"v2\"])","+def autoscaler_version(request, monkeypatch):","+    \"\"\"Run before the cluster fixture so the monitor starts in the chosen version.\"\"\"","+    monkeypatch.setenv(","+        \"RAY_enable_autoscaler_v2\", \"1\" if request.param == \"v2\" else \"0\"","+    )","+    yield request.param","+    # The head built in this process caches the version for later tests.","+    reset_autoscaler_v2_enabled_cache()","+","+","+def test_metrics_endpoints_require_token(","+    autoscaler_version, setup_cluster_with_token_auth","+):","+    assert is_autoscaler_v2(fetch_from_server=True) == (autoscaler_version == \"v2\")","+    token = setup_cluster_with_token_auth[\"token\"]","+    accepted_forms = [","+        {\"headers\": {\"Authorization\": f\"Bearer {token}\"}},","+        {\"headers\": {\"X-Ray-Authorization\": f\"Bearer {token}\"}},","+        {\"cookies\": {\"ray-authentication-token\": token}},","+    ]","+","+    for name, url in _metrics_endpoints().items():","+        missing = requests.get(f\"{url}/metrics\", timeout=5)","+        assert missing.status_code == 401, name","+        assert missing.headers[\"WWW-Authenticate\"] == \"Bearer\", name"],"additions":55,"deletions":0,"truncated":false}],"additions":599,"deletions":13,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-10-22T13:45:50.645424+00:00"}