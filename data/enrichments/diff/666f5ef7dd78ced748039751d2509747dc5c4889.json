 the same token sources as the dashboard. A missing token gets 401","+    with ``WWW-Authenticate: Bearer``, a wrong one 403.","+    \"\"\"","+","+    def token_auth_app(environ, start_response):","+        if not auth_utils.is_token_auth_enabled():","+            return app(environ, start_response)","+","+        auth_header = environ.get(\"HTTP_AUTHORIZATION\") or environ.get(","+            \"HTTP_X_RAY_AUTHORIZATION\"","+        )","+        if not auth_header:","+            try:","+                cookie = SimpleCookie(environ.get(\"HTTP_COOKIE\", \"\")).get(","+                    authentication_constants.AUTHENTICATION_TOKEN_COOKIE_NAME","+                )","+            except CookieError:","+                cookie = None","+            if cookie and cookie.value:","+                auth_header = (","+                    authentication_constants.AUTHORIZATION_BEARER_PREFIX + cookie.value","+                )","+","+        if not auth_header:","+            start_response(","+                \"401 Unauthorized\",","+                [(\"Content-Type\", \"text/plain\"), (\"WWW-Authenticate\", \"Bearer\")],","+            )","+            return [b\"Unauthorized: Missing authentication token\"]","+","+        if not auth_utils.validate_request_token(auth_header):","+            start_response(\"403 Forbidden\", [(\"Content-Type\", \"text/plain\")])","+            return [b\"Forbidden: Invalid authentication token\"]","+","+        return app(environ, start_response)","+","+    return token_auth_app","+","+","+# prometheus_client.exposition.ThreadingWSGIServer doesn't exist in the","+# declared minimum prometheus_client 0.7.1.","+class _ThreadingWSGIServer(ThreadingMixIn, WSGIServer):","+    daemon_threads = True","+","+","+class _SilentHandler(WSGIRequestHandler):","+    def log_message(self, format, *args):","+        pass","+","+","+def start_metrics_http_server(port: int, registry, addr: str = \"0.0.0.0\") -> None:","+    \"\"\"Serve ``registry`` on ``addr:port`` from a daemon thread, like","+    ``prometheus_client.start_http_server``, but requiring the token when token","+    auth is on.\"\"\"","+    from prometheus_client import make_wsgi_app","+","+    family, _, _, _, sockaddr = socket.getaddrinfo(","+        addr, port, type=socket.SOCK_STREAM, flags=socket.AI_PASSIVE","+    )[0]","+    server_class = type(","+        \"_MetricsWSGIServer\", (_ThreadingWSGIServer,), {\"address_family\": family}","+    )","+    httpd = make_server(","+        sockaddr[0],","+        port,","+        get_token_auth_wsgi_app(make_wsgi_app(registry)),","+        server_class,","+        _SilentHandler,","+    )","+    threading.Thread(target=httpd.serve_forever, daemon=True).start()","+","+"," def get_auth_headers_if_auth_enabled(user_headers: Dict[str, str]) -> Dict[str, str]:"," ","     if not auth_utils.is_token_auth_enabled():"],"additions":80,"deletions":0,"truncated":false},{"path":"python/ray/_private/prometheus_exporter.py","lines":["@@ -21,6 +21,10 @@","     UnknownMetricFamily,"," )"," ","+from ray._private.authentication.http_token_authentication import (","+    get_token_auth_wsgi_app,","+)","+"," logger = logging.getLogger(__name__)"," "," ","@@ -326,7 +330,9 @@ def emit(self, view_data):  # pragma: NO COVER","     def serve_http(self):","         \"\"\"serve_http serves the Prometheus endpoint.\"\"\"","         address = self.options.address or \"\"","-        httpd = make_server(address, self.options.port, make_wsgi_app())","+        httpd = make_server(","+            address, self.options.port, get_token_auth_wsgi_app(make_wsgi_app())","+        )","         t = threading.Thread(target=httpd.serve_forever)","         t.daemon = True","         t.start()"],"additions":7,"deletions":1,"truncated":false},{"path":"python/ray/autoscaler/_private/monitor.py","lines":["@@ -25,6 +25,9 @@","     LOGGING_ROTATE_BYTES,"," )"," from ray._private import logging_utils","+from ray._private.authentication.http_token_authentication import (","+    start_metrics_http_server,","+)"," from ray._private.event.event_logger import get_event_logger"," from ray._private.ray_logging import setup_component_logger"," from ray._raylet import GcsClient","@@ -204,7 +207,7 @@ def __init__(","                 kwargs = (","                     {\"addr\": get_localhost_ip()} if is_localhost(head_node_ip) else {}","                 )","-                prometheus_client.start_http_server(","+                start_metrics_http_server(","                     port=AUTOSCALER_METRIC_PORT,","                     registry=self.prom_metrics.registry,","                     **kwargs,"],"additions":4,"deletions":1,"truncated":false},{"path":"python/ray/autoscaler/v2/monitor.py","lines":["@@ -25,6 +25,9 @@"," )"," from ray._common.usage.usage_lib import record_extra_usage_tag"," from ray._private import logging_utils","+from ray._private.authentication.http_token_authentication import (","+    start_metrics_http_server,","+)"," from ray._private.event.event_logger import get_event_logger"," from ray._private.ray_logging import setup_component_logger"," from ray._private.worker import SCRIPT_MODE","@@ -127,7 +130,7 @@ def __init__(","                 kwargs = (","                     {\"addr\": get_localhost_ip()} if is_localhost(head_node_ip) else {}","                 )","-                prometheus_client.start_http_server(","+                start_metrics_http_server(","                     port=AUTOSCALER_METRIC_PORT,","                     registry=prom_metrics.registry,","                     **kwargs,"],"additions":4,"deletions":1,"truncated":false},{"path":"python/ray/dashboard/head.py","lines":["@@ -13,6 +13,9 @@"," from ray._common.usage.usage_lib import TagKey, record_extra_usage_tag"," from ray._private import ray_constants"," from ray._private.async_utils import enable_monitor_loop_lag","+from ray._private.authentication.http_token_authentication import (","+    start_metrics_http_server,","+)"," from ray._private.ray_constants import env_integer"," from ray._raylet import GcsClient"," from ray.dashboard.consts import (","@@ -359,7 +362,7 @@ async def _setup_metrics(self, gcs_client):","                     )","                 )","                 kwargs = {\"addr\": get_localhost_ip()} if is_localhost(self.ip) else {}","-                prometheus_client.start_http_server(","+                start_metrics_http_server(","                     port=DASHBOARD_METRIC_PORT,","                     registry=metrics.registry,","                     **kwargs,"],"additions":4,"deletions":1,"truncated":false},{"path":"python/ray/dashboard/modules/metrics/install_and_start_prometheus.py","lines":["@@ -8,12 +8,76 @@"," "," import requests"," ","+from ray._private.authentication.authentication_token_setup import (","+    _get_default_token_path,","+    maybe_enable_token_auth_if_token_available,","+)","+from ray._private.authentication.authentication_utils import is_token_auth_enabled"," from ray.dashboard.consts import PROMETHEUS_CONFIG_INPUT_PATH"," "," FALLBACK_PROMETHEUS_VERSION = \"2.48.1\""," DOWNLOAD_BLOCK_SIZE = 8192  # 8 KB"," TEST_MODE_ENV_VAR = \"RAY_PROMETHEUS_DOWNLOAD_TEST_MODE\""," ","+# Indented to sit inside the 'ray' scrape job of PROMETHEUS_CONFIG_INPUT_PATH.","+PROMETHEUS_AUTHORIZATION_TEMPLATE = \"\"\"  authorization:","+    type: Bearer","+    {credentials_key}: '{credentials_value}'","+\"\"\"","+","+","+def get_prometheus_authorization_config() -> str:","+    \"\"\"Get the authorization block for the 'ray' scrape job.","+","+    RAY_AUTH_TOKEN takes precedence and goes inline as `credentials`, so the","+    config holding it must be written owner-only. Otherwise Prometheus reads","+    the token from RAY_AUTH_TOKEN_PATH if set, else from ~/.ray/auth_token.","+    The Kubernetes service-account token the loader can also use isn't","+    followed: KubeRay clusters scrape with their own Prometheus.","+","+    Returns:","+        The YAML block to append to PROMETHEUS_CONFIG_INPUT_PATH, or \"\" when token","+        auth is off.","+","+    Raises:","+        ValueError: Token auth is on, RAY_AUTH_TOKEN isn't set, and the token","+            file is missing, unreadable, empty or holds more than one line.","+    \"\"\"","+    if not is_token_auth_enabled():","+        return \"\"","+    env_token = os.environ.get(\"RAY_AUTH_TOKEN\", \"\").strip()","+    if env_token:","+        return PROMETHEUS_AUTHORIZATION_TEMPLATE.format(","+            credentials_key=\"credentials\",","+            # A YAML single-quoted scalar escapes ' as ''.","+            credentials_value=env_token.replace(\"'\", \"''\"),","+        )","+    token_path = os.path.abspath(","+        os.environ.get(\"RAY_AUTH_TOKEN_PATH\") or _get_default_token_path()","+    )","+    read_error = \"\"","+    try:","+        file_token = Path(token_path).read_text().strip()","+    except (OSError, UnicodeDecodeError) as e:","+        file_token, read_error = \"\", f\" ({e})\"","+    if not file_token:","+        raise ValueError(","+            \"Token authentication is enabled, but no token was found for \"","+            f\"Prometheus: {token_path} is missing, unreadable or empty\"","+            f\"{read_error}. Set RAY_AUTH_TOKEN, or put the token in a file and \"","+            \"set RAY_AUTH_TOKEN_PATH to its path.\"","+        )","+    if \"\\n\" in file_token:","+        # Ray uses the first non-blank line, but Prometheus sends the whole file.","+        raise ValueError(","+            f\"{token_path} must hold only the token, on one line, for Prometheus \"","+            \"to send it. Remove the other lines, or set RAY_AUTH_TOKEN.\"","+        )","+    return PROMETHEUS_AUTHORIZATION_TEMPLATE.format(","+        credentials_key=\"credentials_file\",","+        credentials_value=token_path.replace(\"'\", \"''\"),","+    )","+"," "," def get_system_info():","     os_type = platform.system().lower()","@@ -70,7 +134,31 @@ def install_prometheus(file_path):","         return False"," "," ","-def start_prometheus(prometheus_dir):","+def write_prometheus_config(prometheus_dir: str, authorization_config: str) -> Path:","+    \"\"\"Write Ray's Prometheus config plus the authorization block, owner-only.","+","+    The block can hold the token inline, so the file is created fresh with mode","+    0600, never through a link someone else planted at the path.","+","+    Args:","+        prometheus_dir: The extracted Prometheus folder to write the config into.","+        authorization_config: The block from get_prometheus_authorization_config.","+","+    Returns:","+        The path of the written config.","+    \"\"\"","+    config_file = Path(prometheus_dir) / \"ray_prometheus.yml\"","+    config_file.unlink(missing_ok=True)","+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL","+    if hasattr(os, \"O_NOFOLLOW\"):","+        flags |= os.O_NOFOLLOW","+    fd = os.open(config_file, flags, 0o600)","+    with os.fdopen(fd, \"w\") as f:","+        f.write(Path(PROMETHEUS_CONFIG_INPUT_PATH).read_text() + authorization_config)","+    return config_file","+","+","+def start_prometheus(prometheus_dir, authorization_config=\"\"):"," ","     # The function assumes the Ray cluster to be monitored by Prometheus uses the","     # default configuration with \"/tmp/ray\" as the default root temporary directory.","@@ -84,6 +172,9 @@ def start_prometheus(prometheus_dir):","     if not config_file.exists():","         raise FileNotFoundError(f\"Prometheus config file not found: {config_file}\")"," ","+    if authorization_config:","+        config_file = write_prometheus_config(prometheus_dir, authorization_config)","+","     prometheus_cmd = [","         f\"{prometheus_dir}/prometheus\",","         \"--config.file\",","@@ -177,6 +268,24 @@ def main():","     )","     logging.warning(\"This script is not intended for production use.\")"," ","+    # Same auth decision as `ray start`, so local clusters with token auth on by","+    # default are scraped with the token.","+    auth_mode_unset = \"RAY_AUTH_MODE\" not in os.environ","+    if (","+        not maybe_enable_token_auth_if_token_available(warn_if_disabled=False)","+        and auth_mode_unset","+    ):","+        logging.warning(","+            \"No auth token found in RAY_AUTH_TOKEN, RAY_AUTH_TOKEN_PATH or \"","+            \"~/.ray/auth_token, so the Prometheus config has no authorization \"","+            \"block. If the cluster runs token auth, every Ray target returns 401.\"","+        )","+    try:","+        authorization_config = get_prometheus_authorization_config()","+    except ValueError as e:","+        logging.error(e)","+        sys.exit(1)","+","     downloaded, file_name = download_prometheus()","     if not downloaded:","         logging.error(\"Failed to download Prometheus.\")","@@ -191,10 +300,15 @@ def main():","     # TODO: Add a check to see if Prometheus is already running"," ","     assert file_name.endswith(\".tar.gz\")","-    process = start_prometheus(","-        # remove the .tar.gz extension","-        prometheus_dir=file_name.rstrip(\".tar.gz\")","-    )","+    try:","+        process = start_prometheus(","+            # remove the .tar.gz extension","+            prometheus_dir=file_name.rstrip(\".tar.gz\"),","+            authorization_config=authorization_config,","+        )","+    except OSError as e:","+        logging.error(f\"Failed to prepare the Prometheus config: {e}\")","+        sys.exit(1)","     if process:","         print_shutdown_message(process.pid)"," "],"additions":119,"deletions":5,"truncated":false},{"path":"python/ray/dashboard/modules/tests/test_metrics_integration.py","lines":["@@ -1,16 +1,233 @@","+import json","+import os","+import secrets"," import subprocess"," import sys"," import time","+from types import SimpleNamespace"," "," import pytest","+import requests","+import yaml"," from click.testing import CliRunner"," ","+import ray","+from ray._common.test_utils import wait_for_condition","+from ray._private.authentication_test_utils import reset_auth_token_state","+from ray.cluster_utils import Cluster"," from ray.dashboard.consts import PROMETHEUS_CONFIG_INPUT_PATH","-from ray.dashboard.modules.metrics import install_and_start_prometheus","+from ray.dashboard.modules.metrics import install_and_start_prometheus, metrics_head","+from ray.dashboard.modules.metrics.install_and_start_prometheus import (","+    get_prometheus_authorization_config,","+)"," from ray.dashboard.modules.metrics.templates import PROMETHEUS_YML_TEMPLATE"," from ray.scripts.scripts import metrics_group"," "," ","+@pytest.fixture","+def auth_env(monkeypatch, tmp_path):","+    \"\"\"Isolate HOME and the auth env vars; yields the default token path.\"\"\"","+    monkeypatch.setenv(\"HOME\", str(tmp_path))","+    for var in (\"RAY_AUTH_MODE\", \"RAY_AUTH_TOKEN\", \"RAY_AUTH_TOKEN_PATH\"):","+        monkeypatch.delenv(var, raising=False)","+    yield tmp_path / \".ray\" / \"auth_token\"","+    monkeypatch.undo()","+    reset_auth_token_state()","+","+","+def _enable_token_auth(monkeypatch):","+    monkeypatch.setenv(\"RAY_AUTH_MODE\", \"token\")","+    reset_auth_token_state()","+","+","+def test_prometheus_authorization_config_empty_when_auth_disabled(","+    auth_env, monkeypatch","+):","+    monkeypatch.setenv(\"RAY_AUTH_MODE\", \"disabled\")","+    reset_auth_token_state()","+    assert get_prometheus_authorization_config() == \"\"","+","+","+def test_prometheus_authorization_config_uses_token_path_env(","+    auth_env, monkeypatch, tmp_path","+):","+    token_file = tmp_path / \"my_token\"","+    token_file.write_text(\"a\" * 64)","+    auth_env.parent.mkdir(parents=True)","+    auth_env.write_text(\"b\" * 64)","+    monkeypatch.setenv(\"RAY_AUTH_TOKEN_PATH\", str(token_file))","+    _enable_token_auth(monkeypatch)","+","+    assert get_prometheus_authorization_config() == (","+        \"  authorization:\\n\"","+        \"    type: Bearer\\n\"","+        f\"    credentials_file: '{token_file}'\\n\"","+    )","+","+","+def test_prometheus_authorization_config_uses_default_token_file(auth_env, monkeypatch):","+    auth_env.parent.mkdir(parents=True)","+    auth_env.write_text(\"b\" * 64)","+    _enable_token_auth(monkeypatch)","+","+    assert f\"credentials_file: '{auth_env}'\" in get_prometheus_authorization_config()","+","+","+def test_prometheus_authorization_config_inlines_env_token(auth_env, monkeypatch):","+    # RAY_AUTH_TOKEN wins over a token file that holds a different token.","+    auth_env.parent.mkdir(parents=True)","+    auth_env.write_text(\"b\" * 64)","+    monkeypatch.setenv(\"RAY_AUTH_TOKEN\", \"a\" * 64)","+    _enable_token_auth(monkeypatch)","+","+    assert get_prometheus_authorization_config() == (","+        \"  authorization:\\n\" \"    type: Bearer\\n\" f\"    credentials: '{'a' * 64}'\\n\"","+    )","+","+","+@pytest.mark.skipif(","+    sys.platform == \"win32\" or os.geteuid() == 0,","+    reason=\"chmod can't make a file unreadable here\",","+)","+def test_prometheus_authorization_config_rejects_unreadable_file(auth_env, monkeypatch):","+    auth_env.parent.mkdir(parents=True)","+    auth_env.write_text(\"a\" * 64)","+    auth_env.chmod(0)","+    _enable_token_auth(monkeypatch)","+","+    with pytest.raises(ValueError, match=\"RAY_AUTH_TOKEN_PATH\"):","+        get_prometheus_authorization_config()","+","+","+@pytest.mark.parametrize(\"file_content\", [None, \"\\n\"], ids=[\"missing\", \"empty\"])","+def test_prometheus_authorization_config_rejects_missing_or_empty_file(","+    auth_env, monkeypatch, file_content","+):","+    if file_content is not None:","+        auth_env.parent.mkdir(parents=True)","+        auth_env.write_text(file_content)","+    _enable_token_auth(monkeypatch)","+","+    with pytest.raises(ValueError, match=\"RAY_AUTH_TOKEN_PATH\"):","+        get_prometheus_authorization_config()","+","+","+def test_prometheus_authorization_config_accepts_blank_lines_around_token(","+    auth_env, monkeypatch","+):","+    # Ray uses the first non-blank line, and Prometheus trims the file.","+    auth_env.parent.mkdir(parents=True)","+    auth_env.write_text(\"\\n  \\n\" + \"a\" * 64 + \"\\n\\n\")","+    _enable_token_auth(monkeypatch)","+","+    assert f\"credentials_file: '{auth_env}'\" in get_prometheus_authorization_config()","+","+","+def test_prometheus_authorization_config_rejects_multiline_file(auth_env, monkeypatch):","+    # Ray uses the first non-blank line, but Prometheus sends the whole file.","+    auth_env.parent.mkdir(parents=True)","+    auth_env.write_text(\"\\n\" + \"a\" * 64 + \"\\n# note\\n\")","+    _enable_token_auth(monkeypatch)","+","+    with pytest.raises(ValueError, match=\"only the token\"):","+        get_prometheus_authorization_config()","+","+","+@pytest.mark.parametrize(\"token_source\", [\"env\", \"file\"])","+def test_prometheus_authorization_config_survives_quotes(","+    auth_env, monkeypatch, tmp_path, token_source","+):","+    if token_source == \"env\":","+        monkeypatch.setenv(\"RAY_AUTH_TOKEN\", \"it's\")","+        expected = {\"type\": \"Bearer\", \"credentials\": \"it's\"}","+    else:","+        token_file = tmp_path / \"it's token\"","+        token_file.write_text(\"a\" * 64)","+        monkeypatch.setenv(\"RAY_AUTH_TOKEN_PATH\", str(token_file))","+        expected = {\"type\": \"Bearer\", \"credentials_file\": str(token_file)}","+    _enable_token_auth(monkeypatch)","+","+    config = install_and_start_prometheus.write_prometheus_config(","+        tmp_path, get_prometheus_authorization_config()","+    )","+","+    (ray_job,) = yaml.safe_load(config.read_text())[\"scrape_configs\"]","+    assert ray_job[\"job_name\"] == \"ray\"","+    assert ray_job[\"authorization\"] == expected","+","+","+def test_launch_prometheus_exits_before_download_without_token(auth_env, monkeypatch):","+    _enable_token_auth(monkeypatch)","+","+    def fail_download(*args, **kwargs):","+        raise AssertionError(\"downloaded Prometheus without a token\")","+","+    monkeypatch.setattr(","+        install_and_start_prometheus, \"download_prometheus\", fail_download","+    )","+","+    with pytest.raises(SystemExit) as exit_info:","+        install_and_start_prometheus.main()","+    assert exit_info.value.code == 1","+","+","+@pytest.mark.parametrize(\"auth_mode\", [None, \"disabled\"])","+def test_launch_prometheus_warns_when_no_token_found(","+    auth_env, monkeypatch, caplog, auth_mode","+):","+    if auth_mode:","+        monkeypatch.setenv(\"RAY_AUTH_MODE\", auth_mode)","+    reset_auth_token_state()","+    monkeypatch.setattr(","+        install_and_start_prometheus, \"download_prometheus\", lambda: (False, \"\")","+    )","+","+    with pytest.raises(SystemExit):","+        install_and_start_prometheus.main()","+","+    # An explicit opt-out is intended, so only the unset mode warns.","+    assert (\"401\" in caplog.text) == (auth_mode is None)","+","+","+def test_launch_prometheus_exits_cleanly_when_config_write_fails(","+    auth_env, monkeypatch, tmp_path, caplog","+):","+    monkeypatch.setenv(\"RAY_AUTH_TOKEN\", \"a\" * 64)","+    _enable_token_auth(monkeypatch)","+    prometheus_dir = tmp_path / \"prom\"","+    # A directory where the config goes makes the write fail with an OSError.","+    (prometheus_dir / \"ray_prometheus.yml\").mkdir(parents=True)","+    monkeypatch.setattr(","+        install_and_start_prometheus,","+        \"download_prometheus\",","+        lambda: (True, f\"{prometheus_dir}.tar.gz\"),","+    )","+    monkeypatch.setattr(","+        install_and_start_prometheus, \"install_prometheus\", lambda _: True","+    )","+","+    with pytest.raises(SystemExit) as exit_info:","+        install_and_start_prometheus.main()","+    assert exit_info.value.code == 1","+    assert \"ray_prometheus.yml\" in caplog.text","+","+","+def test_write_prometheus_config_is_owner_only_and_replaces_old_file(tmp_path):","+    victim = tmp_path / \"victim\"","+    victim.write_text(\"untouched\")","+    (tmp_path / \"ray_prometheus.yml\").symlink_to(victim)","+","+    config = install_and_start_prometheus.write_prometheus_config(","+        tmp_path, \"  authorization:\\n    type: Bearer\\n    credentials: 'x'\\n\"","+    )","+","+    assert config == tmp_path / \"ray_prometheus.yml\"","+    assert not config.is_symlink()","+    assert config.stat().st_mode & 0o777 == 0o600","+    assert config.read_text().endswith(\"    credentials: 'x'\\n\")","+    assert victim.read_text() == \"untouched\"","+","+"," @pytest.mark.parametrize(","     \"os_type,architecture\",","     [","@@ -33,7 +250,7 @@ def test_download_prometheus(os_type, architecture, monkeypatch):","     assert downloaded"," "," ","-def test_e2e(capsys):","+def test_e2e(auth_env, capsys):","     install_and_start_prometheus.main()","     captured = capsys.readouterr()","     assert \"Prometheus is running\" in captured.out","@@ -43,7 +260,7 @@ def test_e2e(capsys):","     subprocess.run([\"kill\", str(pid)])"," "," ","-def test_shutdown_prometheus():","+def test_shutdown_prometheus(auth_env):","     install_and_start_prometheus.main()","     runner = CliRunner()","     # Sleep for a few seconds to make sure Prometheus is running","@@ -66,5 +283,100 @@ def test_prometheus_config_content():","         assert f.read() == template_content"," "," ","+def _write_dashboard_prometheus_config(tmp_path):","+    head = SimpleNamespace(_metrics_root=str(tmp_path), session_dir=str(tmp_path))","+    metrics_head.MetricsHead._create_default_prometheus_configs(head)","+    return (tmp_path / \"prometheus\" / \"prometheus.yml\").read_text()","+","+","+def test_dashboard_prometheus_config_has_no_authorization_block(auth_env, monkeypatch):","+    auth_env.parent.mkdir(parents=True)","+    auth_env.write_text(\"b\" * 64)","+    monkeypatch.setenv(\"RAY_AUTH_TOKEN\", \"b\" * 64)","+    _enable_token_auth(monkeypatch)","+","+    warnings = []","+    monkeypatch.setattr(metrics_head.logger, \"warning\", warnings.append)","+","+    config = _write_dashboard_prometheus_config(auth_env.parent.parent)","+","+    assert \"authorization\" not in config","+    assert warnings == []","+","+","+DISCOVERY_FILE_PATH = \"/tmp/ray/prom_metrics_service_discovery.json\"","+","+","+@pytest.mark.parametrize(\"token_source\", [\"file\", \"env\"])","+def test_launch_prometheus_scrapes_token_auth_cluster(","+    auth_env, monkeypatch, capsys, token_source","+):","+    token = secrets.token_hex(32)","+    if token_source == \"file\":","+        token_file = auth_env.parent.parent / \"token_file\"","+        # Blank lines around the token: Ray takes the first non-blank line and","+        # Prometheus trims the file, so both must still agree on the token.","+        token_file.write_text(f\"\\n{token}\\n\\n\")","+        monkeypatch.setenv(\"RAY_AUTH_TOKEN_PATH\", str(token_file))","+    else:","+        monkeypatch.setenv(\"RAY_AUTH_TOKEN\", token)","+    _enable_token_auth(monkeypatch)","+","+    cluster = Cluster()","+    prometheus_pid = None","+    try:","+        cluster.add_node()","+        cluster.add_node()","+        ray.init(address=cluster.address)","+","+        # launch-prometheus reads targets through the /tmp/ray symlink, so Prometheus","+        # misses later rewrites of the session file until its 5-minute refresh; start","+        # it only once the file lists two nodes, the autoscaler and the dashboard head.","+        def discovery_file_lists_all_targets():","+            with open(DISCOVERY_FILE_PATH) as f:","+                return len(json.load(f)[0][\"targets\"]) == 4","+","+        wait_for_condition(discovery_file_lists_all_targets, timeout=60)","+        written_configs = []","+        write_prometheus_config = install_and_start_prometheus.write_prometheus_config","+","+        def record_written_config(*args):","+            written_configs.append(write_prometheus_config(*args))","+            return written_configs[-1]","+","+        monkeypatch.setattr(","+           