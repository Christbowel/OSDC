Bits(mb_strlen($algorithm, '8bit')) . $algorithm,","+            self::toInt32Bits(mb_strlen($apu, '8bit')) . $apu,","+            self::toInt32Bits(mb_strlen($apv, '8bit')) . $apv,","+            self::toInt32Bits($encryption_key_size),","+            '',","+        ]);"," ","-        $input = implode('', $encryption_segments);","-        $hash = hash('sha256', $input, true);","+        $key_length = intdiv($encryption_key_size, 8);","+        $derived_key = '';","+        for ($round = 1; mb_strlen($derived_key, '8bit') < $key_length; ++$round) {","+            $derived_key .= hash('sha256', self::toInt32Bits($round) . $Z . $other_info, true);","+        }"," ","-        return mb_substr($hash, 0, $encryption_key_size / 8, '8bit');","+        return mb_substr($derived_key, 0, $key_length, '8bit');","     }"," ","     /**"],"additions":18,"deletions":12,"truncated":false},{"path":"src/Library/Encryption/JWEBuilder.php","lines":["@@ -458,6 +458,10 @@ private function checkKey(KeyEncryptionAlgorithm $keyEncryptionAlgorithm, JWK $r","         }","     }"," ","+    /**","+     * A key obtained by key agreement must have the size the content encryption algorithm needs: the content","+     * encryption algorithms pad a short key with zero bytes instead of rejecting it.","+     */","     private function determineCEK(array &$additionalHeader): string","     {","         if ($this->contentEncryptionAlgorithm === null) {","@@ -487,7 +491,7 @@ private function determineCEK(array &$additionalHeader): string","                     $this->sharedProtectedHeader","                 );"," ","-                return $algorithm->getAgreementKey(","+                $cek = $algorithm->getAgreementKey(","                     $this->contentEncryptionAlgorithm->getCEKSize(),","                     $this->contentEncryptionAlgorithm->name(),","                     $recipientKey,","@@ -495,6 +499,11 @@ private function determineCEK(array &$additionalHeader): string","                     $co