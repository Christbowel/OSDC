56CBCHS512(),","+        ]), null);","+","+        static::assertFalse($decrypter->decryptUsingKey($jwe, new JWK(self::RECIPIENT_KEY), 0));","+    }","+","+    private static function keyAgreementReturning(string $key): KeyAgreement","+    {","+        return new class($key) implements KeyAgreement {","+            public function __construct(","+                private readonly string $key","+            ) {","+            }","+","+            public function name(): string","+            {","+                return 'ECDH-ES';","+            }","+","+            public function allowedKeyTypes(): array","+            {","+                return ['EC'];","+            }","+","+            public function getKeyManagementMode(): string","+            {","+                return self::MODE_AGREEMENT;","+            }","+","+            public function getAgreementKey(","+                int $encryptionKeyLength,","+                string $algorithm,","+                JWK $recipientKey,","+                ?JWK $senderKey,","+                array $completeHeader = [],","+                array &$additionalHeaderValues = []","+            ): string {","+                return $this->key;","+            }","+        };","+    }","+}",""],"additions":238,"deletions":0,"truncated":false}],"additions":271,"deletions":14,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-10-31T14:36:46.183704+00:00"}