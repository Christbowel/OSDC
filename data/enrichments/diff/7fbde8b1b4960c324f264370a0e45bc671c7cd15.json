{"id":"7fbde8b1b4960c324f264370a0e45bc671c7cd15","axis":"silent","repo":"pnpm/pnpm","sha":"7fbde8b1b4960c324f264370a0e45bc671c7cd15","parsed":{"files":[{"path":".changeset/warn-ignored-import-package-hook.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+pnpm now warns when a pnpmfile defines the `importPackage` hook. pnpm does not run this hook. Use the `packageImportMethod` setting to choose how packages are written to `node_modules`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/config_deps/hooks.rs","lines":["@@ -8,6 +8,8 @@ use super::{","     install_config_deps, is_known_setting_key, resolve_configured_state_dir,"," };"," use miette::WrapErr;","+use pnpm_hooks::IgnoredHook;","+use pnpm_network::redact_and_sanitize;"," "," /// The pnpmfile paths that contribute hooks for `root_dir`, in"," /// application order (see [`finder::find_pnpmfiles`]). Every hook applies","@@ -121,7 +123,7 @@ pub async fn run_update_config_hooks<Reporter: self::Reporter>("," ","     let prefix = root_dir.to_string_lossy().into_owned();","     let mut current = input.clone();","-    let mut has_filter_log = false;","+    let mut ignored_hooks = Vec::new();","     for (pnpmfile, hook) in pnpmfiles.iter().zip(&hooks) {","         let ctx = HookContext { log: hook_logger::<Reporter>(pnpmfile, &prefix), dir: None };","         current = hook","@@ -129,16 +131,9 @@ pub async fn run_update_config_hooks<Reporter: self::Reporter>(","             .await","             .map_err(|err| miette::miette!(\"{err}\"))","             .wrap_err_with(|| format!(\"running updateConfig hook from {}\", pnpmfile.display()))?;","-        has_filter_log |= hook.has_filter_log().await;","-    }","-    if has_filter_log {","-        Reporter::emit(&LogEvent::Pnpm(PnpmLog {","-            level: LogLevel::Warn,","-            message: \"The pnpmfile filterLog hook is deprecated and is not supported by pnpm v12. Remove it from the pnpmfile.\"","-                