anted access, you can revoke it in Security settings.')","+\t\t} else if (status === 403) {","+\t\t\tunavailable.value = true","+\t\t\tdeclineError.value = t('core', 'This request is no longer valid. Start a new connection from the app.')","+\t\t} else {","+\t\t\tdeclineError.value = t('core', 'Could not decline this request. Please try again.')","+\t\t}","+\t} finally {","+\t\tdeclining.value = false","+\t}","+}","+","+/**","+ * Confirm the password when required before granting access.","+ *","+ * @param event - The form submission","+ */","+async function onSubmit(event: SubmitEvent) {","+\tevent.preventDefault()","+\tif (submitting.value || declining.value || unavailable.value) {","+\t\treturn","+\t}","+\tsubmitting.value = true","+\ttry {","+\t\tif (grant && isPasswordConfirmationRequired(PwdConfirmationMode.Lax)) {","+\t\t\tawait confirmPassword()","+\t\t}","+\t\t(event.target as HTMLFormElement).submit()","+\t} catch {","+\t\tsubmitting.value = false","+\t}","+}","+</script>","+","+<template>","+\t<NcGuestContent class=\"picker-window\" :class=\"$style.panel\">","+\t\t<template v-if=\"declined\">","+\t\t\t<h2 ref=\"declinedHeading\" :class=\"$style.heading\" tabindex=\"-1\">","+\t\t\t\t{{ t('core', 'Request declined') }}","+\t\t\t</h2>","+\t\t\t<p>{{ t('core', 'This request was cancelled without granting access. You can close this window.') }}</p>","+\t\t</template>","+\t\t<template v-else>","+\t\t\t<header :class=\"$style.header\">","+\t\t\t\t<h2 :class=\"$style.heading\">","+\t\t\t\t\t{{ auth ? t('core', 'Sign in to connect an app') : t('core', 'Allow account access?') }}","+\t\t\t\t</h2>","+\t\t\t</header>","+","+\t\t\t<p v-if=\"auth && !useAppTokenLogin\">","+\t\t\t\t{{ t('core', 'An app is requesting access to your account. Sign in to review the app details and choose whether to grant access.') }}","+\t\t\t</p>","+\t\t\t<section","+\t\t\t\tv-if=\"grant || useAppTokenLogin\"","+\t\t\t\t:class=\"$style.reviewDetails\"","+\t\t\t\t:aria-label=\"t('core', 'App access details')\">","+\t\t\t\t<div","+\t\t\t\t\tv-if=\"grant && context.userId\"","+\t\t\t\t\t:class=\"$style.account\"","+\t\t\t\t\trole=\"group\"","+\t\t\t\t\t:aria-label=\"t('core', 'Account to connect')\">","+\t\t\t\t\t<NcAvatar","+\t\t\t\t\t\t:user=\"context.userId\"","+\t\t\t\t\t\t:displayName=\"context.userDisplayName || context.userId\"","+\t\t\t\t\t\t:size=\"48\"","+\t\t\t\t\t\thideStatus","+\t\t\t\t\t\tdisableMenu","+\t\t\t\t\t\tdisableTooltip","+\t\t\t\t\t\taria-hidden=\"true\" />","+\t\t\t\t\t<div :class=\"$style.accountDetails\">","+\t\t\t\t\t\t<strong><bdi>{{ context.userDisplayName || context.userId }}</bdi></strong>","+\t\t\t\t\t\t<span v-if=\"context.userDisplayName && context.userDisplayName !== context.userId\">","+\t\t\t\t\t\t\t<bdi>{{ context.userId }}</bdi>","+\t\t\t\t\t\t</span>","+\t\t\t\t\t\t<span :class=\"$style.server\"><bdi>{{ context.serverUrl }}</bdi></span>","+\t\t\t\t\t</div>","+\t\t\t\t</div>","+\t\t\t\t<p v-else-if=\"useAppTokenLogin\" :class=\"$style.server\">","+\t\t\t\t\t<bdi>{{ context.serverUrl }}</bdi>","+\t\t\t\t</p>","+\t\t\t\t<p :class=\"$style.access\">"],"additions":135,"deletions":0,"truncated":false}],"additions":690,"deletions":17,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-20T17:59:30.249416+00:00"}