lement.prototype, 'submit').mockImplementation(function(this: HTMLFormElement) {","+\t\t\tcredentials = new FormData(this)","+\t\t})","+","+\t\tawait wrapper.get('form').trigger('submit')","+","+\t\texpect(credentials?.get('user')).toBe('user')","+\t\texpect(credentials?.get('password')).toBe('existing-password')","+\t\texpect(confirmPassword).not.toHaveBeenCalled()","+\t})","+})","+","+describe('Declining a login flow v2 request', () => {","+\tit.each(['auth', 'grant'] as const)('cancels from the %s page before showing confirmation', async (state) => {","+\t\tpage = state","+\t\tconst wrapper = mount(LoginFlowV2, { global, attachTo: document.body })","+\t\tawait button(wrapper, 'Decline').trigger('click')","+\t\tawait flushPromises()","+","+\t\texpect(axios.post).toHaveBeenCalledWith(context.declineUrl, { stateToken: 'state-token' })","+\t\texpect(wrapper.find('form').exists()).toBe(false)","+\t\texpect(document.activeElement).toBe(wrapper.get('h2').element)","+\t})","+","+\tit('blocks approval and repeated decline while cancellation is pending', async () => {","+\t\tpage = 'grant'","+\t\tvi.mocked(axios.post).mockReturnValue(new Promise(() => {}))","+\t\tconst submit = vi.spyOn(HTMLFormElement.prototype, 'submit').mockImplementation(() => {})","+\t\tconst wrapper = mount(LoginFlowV2, { global })","+","+\t\tawait button(wrapper, 'Decline').trigger('click')","+\t\texpect(button(wrapper, 'Grant access').attributes('disabled')).toBeDefined()","+\t\tawait wrapper.get('form').trigger('submit')","+\t\texpect(submit).not.toHaveBeenCalled()","+\t\texpect(axios.post).toHaveBeenCalledOnce()","+\t})","+","+\tit('retains the request and offers a retry when cancellation fails', async () => {","+\t\tvi.mocked(axios.post).mockRejectedValueOnce(new Error('Offline'))","+\t\tconst wrapper = mount(LoginFlowV2, { global })","+","+\t\tawait button(wrapper, 'Decline').trigger('click')","+\t\tawait flushPromises()","+","+\t\texpect(wrapper.find('[role=\"alert\"]').exists()).toBe(true)","+\t\texpect(wrapper.find('form').exists()).toBe(true)","+\t\tawait button(wrapper, 'Retry decline').trigger('click')","+\t\tawait flushPromises()","+\t\texpect(wrapper.find('form').exists()).toBe(false)","+\t\texpect(wrapper.find('[role=\"alert\"]').exists()).toBe(false)","+\t})","+","+\tit.each([403, 409, 410])('does not claim cancellation succeeded for HTTP %s', async (status) => {","+\t\tvi.mocked(axios.post).mockRejectedValue({ isAxiosError: true, response: { status } })","+\t\tconst wrapper = mount(LoginFlowV2, { global })","+","+\t\tawait button(wrapper, 'Decline').trigger('click')","+\t\tawait flushPromises()","+","+\t\texpect(wrapper.find('[role=\"alert\"]').exists()).toBe(true)","+\t\texpect(wrapper.find('form').exists()).toBe(false)","+\t\texpect(button(wrapper, 'Security settings').attributes('href')).toBe(context.securitySettingsUrl)","+\t})","+})"],"additions":297,"deletions":0,"truncated":false},{"path":"core/src/types/loginFlowV2.ts","lines":["@@ -0,0 +1,29 @@","+/**","+ * SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors","+ * SPDX-License-Identifier: AGPL-3.0-or-later","+ */","+","+export interface LoginFlowV2Context {","+\tuserAgent: string","+\tserverUrl: string","+\tuserId: string | null","+\tuserDisplayName: string | null","+\tdeclineUrl: string","+\tsecuritySettingsUrl: string","+\tclientIp: string | null","+\tbrowserIp: string","+\tcreatedAt: number","+}","+","+export interface LoginFlowV2Auth {","+\tstateToken: string","+\tloginRedirectUrl: string","+\tappTokenUrl: string","+\tdirect: boolean","+}","+","+export interface LoginFlowV2Grant {","+\tstateToken: string","+\tactionUrl: string","+\tdirect: boolean","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"core/src/views/LoginFlowDone.vue","lines":["@@ -4,17 +4,40 @@"," -->"," "," <script setup lang=\"ts\">","+import { loadState } from '@nextcloud/initial-state'"," import { t } from '@nextcloud/l10n'"," import NcNoteCard from '@nextcloud/vue/components/NcNote