d: subscription.customer,","-    });","-","-    if (member) {","-      if (invoice.paid && invoice.amount_paid !== 0) {","-        await eventRepository.registerPayment({","-          member_id: member.id,","-          currency: invoice.currency,","-          amount: invoice.amount_paid,","-        });","-      }","-    } else {","-      // Subscription has more than one plan - meaning it is not one created by us - ignore.","-      if (!subscription.plan) {","-        return;","-      }","-      // Subscription is for a different product - ignore.","-      const product = await productRepository.get({","-        stripe_product_id: subscription.plan.product,","-      });","-      if (!product) {","-        return;","-      }","-      // Could not find the member, which we need in order to insert an payment event.","-      throw new errors.NotFoundError({","-        code: FAILURE_CODES.noMemberForCustomer,","-        message: `No member found for customer ${subscription.customer}`,","-      });","-    }","-  }","-};"],"additions":0,"deletions":70,"truncated":false},{"path":"ghost/core/server/services/stripe/services/webhook/invoice.ts","lines":["@@ -0,0 +1,63 @@","+import errors from '@tryghost/errors';","+import type { StripeSubscription } from '../../stripe-api-responses';","+import type { WebhookOutcome } from '../../tracking';","+import { FAILURE_CODES } from '../../webhook/failures';","+import type { Invoice } from '../../webhook/webhook-event';","+","+export interface InvoiceDeps {","+  api: { getSubscription(id: string): Promise<StripeSubscription> };","+  memberRepository: { get(filter: { customer_id: string }): Promise<{ id: string } | null> };","+  eventRepository: {","+    registerPayment(payment: {","+      member_id: string;","+      currency: string;","+      amount: number;","+    }): Promise<unknown>;","+  };","+  productRepository: { get(filter: { stripe_product_id: string }): Promise<unknown> };","+}","+","+/**","+ * Handles an `invoice.payment_succeeded` webhook event, which Stripe sends when a customer's","+ * payment succeeds, by recording the payment for a subscription's invoice on the activity of the","+ * member whose Stripe customer paid it. A $0 invoice, such as the start of a trial, records no","+ * payment. A one-off invoice, such as a donation's, is recorded by its checkout instead, which","+ * carries the donation's message.","+ */","+export async function recordInvoicePayment(","+  deps: InvoiceDeps,","+  { subscriptionId, amountPaid, currency }: Invoice,","+): Promise<WebhookOutcome> {","+  if (!subscriptionId) {","+    return { result: 'handled' };","+  }","+  const { api, memberRepository, eventRepository, productRepository } = deps;","+  const subscription = await api.getSubscription(subscriptionId);","+","+  const member = await memberRepository.get({ customer_id: subscription.customer });","+  if (member) {","+    if (amountPaid !== 0) {","+      await eventRepository.registerPayment({","+        member_id: member.id,","+        currency,","+        amount: amountPaid,","+      });","+    }","+    return { result: 'handled' };","+  }","+","+  // A subscription with more than one price wasn't created by Ghost.","+  if (!subscription.plan) {","+    return { result: 'handled' };","+  }","+  // A subscription to another product isn't one of the site's tiers.","+  const product = await productRepository.get({ stripe_product_id: subscription.plan.product });","+  if (!product) {","+    return { result: 'handled' };","+  }","+  // Ghost records the payment against a member, and no member has this customer.","+  throw new errors.NotFoundError({","+    code: FAILURE_CODES.noMemberForCustomer,","+    message: `No member found for customer ${subscription.customer}`,","+  });","+}"],"additions":63,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/stripe/services/webhook/link-subscription.ts","lines":["@@ -0,0 +1,50 @@","+import errors from '@tryghost/errors';","+import { isUniqueViolation } from '../../../../lib/db-errors';","+","+/** Where a paid member came from, as the member repository saves it with their subscription. */","+export interface MemberAttribution {","+  id: string | null;","+  url: string | null;","+  type: string | null;","+  referrerSource: string | null;","+  referrerMedium: string | null;","+  referrerUrl: string | null;","+}","+","+/**","+ * A Stripe subscription to link to a member, as the member repository's `linkSubscription` takes","+ * it: the member's id, and the subscription with its Stripe customer, which the repository fetches","+ * from Stripe again to save. A checkout also passes the offer the buyer took and where they came","+ * from.","+ */","+export interface SubscriptionLink {","+  id: string;","+  subscription: { id: string; customer: string };","+  offerId?: string | undefined;","+  attribution?: MemberAttribution;","+}","+","+/** The part of the member repository that links a Stripe subscription to a member. */","+export interface SubscriptionLinks {","+  linkSubscription(link: SubscriptionLink): Promise<unknown>;","+}","+","+/**","+ * Links a subscription to a member. Two deliveries of events for the same subscription, such as","+ * its `created` and `updated` events or Stripe retrying an event Ghost is still handling, can both","+ * try to insert it, so the one that finds it saved already fails with a conflict, which Stripe","+ * retries.","+ */","+export async function linkOrConflict(","+  members: SubscriptionLinks,","+  link: SubscriptionLink,","+): Promise<void> {","+  try {","+    await members.linkSubscription(link);","+  } catch (err) {","+    if (!isUniqueViolation(err)) {","+      throw err;","+    }","+    throw new errors.ConflictError({ err: err instanceof Error ? err : undefined });","+  }","+}"],"additions":50,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/stripe/services/webhook/refund.ts","lines":["@@ -0,0 +1,29 @@","+import logging from '@tryghost/logging';","+import type { WebhookOutcome } from '../../tracking';","+import type { Refund } from '../../webhook/webhook-event';","+","+export interface RefundDeps {","+  giftService: { handlePaymentRefund(data: { paymentIntentId: string }): Promise<boolean> };","+}","+","+/**","+ * Handles a `charge.refunded` webhook event, which Stripe sends when a charge is refunded, by","+ * marking the gift bought with the refunded payment as refunded. Gifts are the only purchases Ghost","+ * acts on a refund of, so a charge without a payment intent, or one that isn't for a gift, such as","+ * a subscription renewal or a donation, is left alone.","+ */","+export async function recordRefund(","+  deps: RefundDeps,","+  { paymentIntentId }: Refund,","+): Promise<WebhookOutcome> {","+  if (!paymentIntentId) {","+    logging.info('charge.refunded: no payment_intent on charge, skipping');","+    return { result: 'handled' };","+  }","+","+  const refunded = await deps.giftService.handlePaymentRefund({ paymentIntentId });","+  if (!refunded) {","+    logging.info(`charge.refunded: no gift found for payment_intent ${paymentIntentId}, skipping`);","+  }","+  return { result: 'handled' };","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/stripe/services/webhook/subscription-event-service.js","lines":["@@ -1,61 +0,0 @@","-const errors = require('@tryghost/errors');","-const { FAILURE_CODES } = require('../../webhook/failures');","-","-/**","- * Handles `customer.subscription.*` webhook events","- *","- * The `customer.subscription.*` events are triggered when a customer's subscription status changes.","- *","- * This service is responsible for handling these events and updating the subscription status in Ghost,","- * although it mostly delegates the responsibility to the `MemberRepository`.","- */","-module.exports = class SubscriptionEventService {","-  /**","-   * @param {object} deps","-   * @param {import('../../../members/members-api/repositories/member-reposit