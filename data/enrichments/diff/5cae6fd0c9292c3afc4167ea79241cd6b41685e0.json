ccess_log(config.access_log.clone())","             .with_profiler(config.profiler.clone()),","     );"," ","@@ -437,19 +439,29 @@ async fn serve_connections<L>(","     timeouts: ConnectionTimeouts,"," ) -> Result<()>"," where","-    L: axum::serve::Listener,","+    L: axum::serve::Listener<Addr = ListenerAddr>,"," {","     let graceful = GracefulShutdown::new();","     let mut shutdown = std::pin::pin!(shutdown);","     loop {","-        let (io, _addr) = tokio::select! {","+        let (io, addr) = tokio::select! {","             conn = listener.accept() => conn,","             () = &mut shutdown => break,","         };"," ","-        let service = TowerToHyperService::new(","-            app.clone().map_request(|req: Request<Incoming>| req.map(Body::new)),","-        );","+        // Expose the TCP peer to handlers, as `ConnectInfo` does for `axum::serve`.","+        let peer = match addr {","+            ListenerAddr::Tcp(addr) => Some(ConnectInfo(addr)),","+            ListenerAddr::Unix(_) => None,","+        };","+        let service =","+            TowerToHyperService::new(app.clone().map_request(move |req: Request<Incoming>| {","+                let mut req = req.map(Body::new);","+                if let Some(peer) = peer {","+                    req.extensions_mut().insert(peer);","+                }","+                req","+            }));","         let mut builder = http1::Builder::new();","         builder.timer(TokioTimer::new()).header_read_timeout(timeouts.header_read);","         if !timeouts.keep_alive_enabled {"],"additions":21,"deletions":9,"truncated":false},{"path":"rust/src/server/src/middleware/access_log.rs","lines":["@@ -0,0 +1,57 @@","+// SPDX-License-Identifier: Apache-2.0","+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+//! Per-response HTTP access log.","+","+use std::net::SocketAddr;","+use std::sync::Arc;","+use std::time::Instant;","+","+use axum::extract::{ConnectInfo, Request, State};","+use axum::middleware::Next;","+use axum::response::Response;","+use tracing::info;","+","+use crate::state::AppState;","+","+/// Log one INFO event per response, unless the request path is excluded: the","+/// client address, method, request target with its query string, HTTP","+/// version, status, and the latency until the response head is ready.","+///","+/// A streaming response is logged when its stream starts, so its latency","+/// does not cover the body.","+pub async fn log_access(","+    State(state): State<Arc<AppState>>,","+    request: Request,","+    next: Next,","+) -> Response {","+    let path = request.uri().path();","+    if (state.access_log.excluded_paths.iter()).any(|excluded| excluded == path) {","+        return next.run(request).await;","+    }","+","+    // Absent for Unix-domain sockets.","+    let client = request","+        .extensions()","+        .get::<ConnectInfo<SocketAddr>>()","+        .map(|ConnectInfo(addr)| *addr);","+    let method = request.method().clone();","+    let uri = request","+        .uri()","+        .path_and_query()","+        .map_or_else(|| path.to_owned(), |target| target.as_str().to_owned());","+    let version = request.version();","+","+    let start = Instant::now();","+    let response = next.run(request).await;","+    info!(","+        client = client.map(display),","+        %method,","+        uri,","+        ?version,","+        status = response.status().as_u16(),","+        latency = ?start.elapsed(),","+        \"HTTP response\"","+    );","+    response","+}"],"additions":57,"deletions":0,"truncated":false},{"path":"rust/src/server/src/middleware/mod.rs","lines":["@@ -1,6 +1,7 @@"," // SPDX-License-Identifier: Apache-2.0"," // SPDX-FileCopyrightText: Copyright contributors to the vLLM project"," ","+mod access_log;"," mod auth;"," mod cors;"," mod load;","@@ -8,6 +9,7 @@ mod metrics;"," mod offload;"," mod request_id;"," ","+pub use access_log::log_access;"," pub use auth::authenticate_api_key;"," pub use cors::{cors_layer, strip_cors_on_no_origin};"," pub use load::track_server_load;"],"additions":2,"deletions":0,"truncated":false},{"path":"rust/src/server/src/routes.rs","lines":["@@ -267,6 +267,7 @@ fn build_router_with_options("," ","     let enable_request_id_headers = state.api_server_options.enable_request_id_headers;","     let enable_api_key_auth = state.has_api_keys();","+    let enable_access_log = state.access_log.enabled;","     let mut router = router","         .with_state(state.clone())","         .layer(match state.api_server_options.request_body_limit_bytes {","@@ -293,6 +294,12 @@ fn build_router_with_options(","     // requests are visible, while metrics/load only see authenticated traffic.","     router = router.layer(TraceLayer::new_for_http());"," ","+    // Log every response, including rejected and unrouted ones, like Python's","+    // uvicorn access log.","+    if enable_access_log {","+        router = router.layer(from_fn_with_state(state.clone(), middleware::log_access));","+    }","+","     if enable_request_id_headers {","         router = router.layer(from_fn(middleware::set_request_id_header));","     }"],"additions":7,"deletions":0,"truncated":false},{"path":"rust/src/server/src/routes/tests.rs","lines":["@@ -64,7 +64,7 @@ use super::{","     strip_root_path, with_root_path,"," };"," use crate::config::{","-    ApiServerOptions, CorsConfig, DEFAULT_REQUEST_BODY_LIMIT_BYTES, LoraModulePath,","+    AccessLogConfig, ApiServerOptions, CorsConfig, DEFAULT_REQUEST_BODY_LIMIT_BYTES, LoraModulePath,"," };"," use crate::lora::LoadLoraError;"," use crate::render::RenderState;","@@ -10032,6 +10032,127 @@ async fn profile_routes_are_hidden_when_profiling_is_disabled() {","     engine_task.abort_and_join().await;"," }"," ","+/// Captures the access-log events as `LEVEL field=value ...`, with the","+/// nondeterministic `latency` shown only as present.","+#[derive(Clone, Default)]","+struct AccessLogCapture(Arc<std::sync::Mutex<Vec<String>>>);","+","+impl<S: tracing::Subscriber> tracing_subscriber::Layer<S> for AccessLogCapture {","+    fn on_event(","+        &self,","+        event: &tracing::Event<'_>,","+        _ctx: tracing_subscriber::layer::Context<'_, S>,","+    ) {","+        if event.metadata().target() != \"vllm_server::middleware::access_log\" {","+            return;","+        }","+        let mut line = event.metadata().level().to_string();","+        event.record(","+            &mut |field: &tracing::field::Field, value: &dyn fmt::Debug| match field.name() {","+                \"latency\" => line.push_str(\" latency=<elapsed>\"),","+                name => line.push_str(&format!(\" {name}={value:?}\")),","+            },","+        );","+        self.0.lock().expect(\"access log lock\").push(line);","+    }","+}","+","+/// Send each request to an app with an API key and `access_log`, and return","+/// the access-log lines. The middleware runs on the test's own task, so a","+/// thread-local subscriber sees its events.","+async fn access_log_lines(","+    access_log: AccessLogConfig,","+    requests: Vec<Request<Body>>,","+) -> Vec<String> {","+    use tracing_subscriber::layer::SubscriberExt as _;","+","+    let (chat, engine_task) = test_chat_with_engine_handle().await;","+    let app = build_router(Arc::new(","+        AppState::new(vec![\"test-model\".to_string()], chat)","+            .with_api_keys(vec![\"secret\".to_string()])","+            .with_access_log(access_log),","+    ));","+    let capture = AccessLogCapture::default();","+    let _guard =","+        tracing::subscriber::set_default(tracing_subscriber::registry().with(capture.clone()));","+","+    for request in requests {","+        let response = app.clone().oneshot(request).await.expect(\"call app\");","+        to_bytes(response.into_body(), usize::MAX).await.expect(\"read body\");","+    }","+","+    engine_task.abort_and_join().await;","+    capture.0.lock().expect(\"access log lock\").clone()","+}","+","+/// One INFO event per response, like Python's uvicorn access log, with the","+/// client address (absent without one), request target including the query","+/// string, status and latency, including rejected and unrouted requests;","+/// excluded paths match without the query string.","+#[tokio::test]","+#[serial]","+async fn access_log_records_each_response() {","+    let get = |uri: &str, authorized: bool| {","+        let mut request = Request::builder().method(\"GET\").uri(uri);","+        if authorized {","+            request = request.header(\"authorization\", \"Bearer secret\");","+        }","+        request.body(Body::empty()).expect(\"build request\")","+    };","+    let mut with_client = get(\"/v1/models?limit=1\", true);","+    with_client","+        .extensions_mut()","+        .insert(axum::extract::ConnectInfo(std::net::SocketAddr::from((","+            [127, 0, 0, 1],","+            52344,","+        ))));","+    let access_log = AccessLogConfig {","+        enabled: true,","+        excluded_paths: vec![\"/version\".to_string()],","+    };","+","+    let lines = access_log_lines(","+        access_log,","+        vec![","+            with_client,","+            get(\"/v1/models\", false),","+            get(\"/missing\", true),","+            get(\"/version?verbose=1\", false),","+        ],","+    )","+    .await;","+","+    expect_test::expect![[r#\"","+        [","+            \"INFO message=HTTP response client=127.0.0.1:52344 method=GET uri=\\\"/v1/models?limit=1\\\" version=HTTP/1.1 status=200 latency=<elapsed>\",","+            \"INFO message=HTTP response method=GET uri=\\\"/v1/models\\\" version=HTTP/1.1 status=401 latency=<elapsed>\",","+            \"INFO message=HTTP response method=GET uri=\\\"/missing\\\" version=HTTP/1.1 status=404 latency=<elapsed>\",","+        ]","+    \"#]].assert_debug_eq(&lines);","+}","+","+/// `--disable-access-log` removes the access log.","+#[tokio::test]","+#[serial]","+async fn access_log_disabled_logs_nothing() {","+    let lines = access_log_lines(","+        AccessLogConfig {","+            enabled: false,","+            excluded_paths: Vec::new(),","+        },","+        vec![","+            Request::builder()","+                .method(\"GET\")","+                .uri(\"/version\")","+                .body(Body::empty())","+                .expect(\"build request\"),","+        ],","+    )","+    .await;","+","+    assert_eq!(lines, Vec::<String>::new());","+}","+"," /// Captures the events `--enable-log-outputs` logs, one `LEVEL field=value ...`"," /// line per event."," #[derive(Clone, Default)]"],"additions":122,"deletions":1,"truncated":false},{"path":"rust/src/server/src/state.rs","lines":["@@ -13,7 +13,7 @@ use vllm_chat::ChatLlm;"," use vllm_engine_core_client::EngineCoreClient;"," use vllm_engine_core_client::runtime::BackgroundShutdownRuntime;"," ","-use crate::config::{ApiServerOptions, CorsConfig, LoraModulePath};","+use crate::config::{AccessLogConfig, ApiServerOptions, CorsConfig, LoraModulePath};"," use crate::lora::{","     LoadLoraError, LoadedLora, LoraDisabledError, LoraManager, LoraModelResolution, UnloadLoraError,"," };","@@ -39,6 +39,8 @@ pub struct AppState {","     pub api_server_options: ApiServerOptions,","     /// CORS settings applied to every HTTP response.","     pub cors: CorsConfig,","+    /// HTTP access log settings.","+    pub access_log: AccessLogConfig,","     /// Runtime server information returned by `/server_info`, when available.","     server_info: Option<ServerInfoSnapshot>,","     /// SHA-256 hashes of API keys accepted as bearer tokens for guarded routes.","@@ -75,6 +77,7 @@ impl AppState {","             chat,","             api_server_options: ApiServerOptions::default(),","             cors: CorsConfig::default(),","+            access_log: AccessLogConfig::default(),","             server_info: None,","             api_key_hashes: Vec::new(),","             server_load: AtomicU64::new(0),","@@ -97,6 +100,12 @@ impl AppStat