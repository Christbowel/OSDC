g\\Events\\TagDeletedEvent;","+use OCP\\SystemTag\\Events\\TagUpdatedEvent;","+use OCP\\SystemTag\\ISystemTag;","+use OCP\\SystemTag\\ISystemTagManager;","+use OCP\\SystemTag\\TagAssignedEvent;","+use OCP\\SystemTag\\TagNotFoundException;","+use OCP\\SystemTag\\TagUnassignedEvent;"," use Override;"," "," /**","- * @template-implements IEventListener<TagCreatedEvent>","+ * @template-implements IEventListener<TagCreatedEvent|TagUpdatedEvent|TagDeletedEvent|TagAssignedEvent|TagUnassignedEvent>","  */"," class TagEventListener extends Action implements IEventListener {","+\tprivate const MAX_LOGGED_OBJECT_IDS = 10;","+","+\tpublic function __construct(","+\t\tIAuditLogger $logger,","+\t\tprivate ISystemTagManager $tagManager,","+\t) {","+\t\tparent::__construct($logger);","+\t}","+"," \t#[Override]"," \tpublic function handle(Event $event): void {","-\t\tif (!$event instanceof TagCreatedEvent) {","-\t\t\treturn;","+\t\tif ($event instanceof TagCreatedEvent) {","+\t\t\t$this->tagCreated($event);","+\t\t} elseif ($event instanceof TagUpdatedEvent) {","+\t\t\t$this->tagUpdated($event);","+\t\t} elseif ($event instanceof TagDeletedEvent) {","+\t\t\t$this->tagDeleted($event);","+\t\t} elseif ($event instanceof TagAssignedEvent) {","+\t\t\t$this->tagAssigned($event);","+\t\t} elseif ($event instanceof TagUnassignedEvent) {","+\t\t\t$this->tagUnassigned($event);"," \t\t}","+\t}"," ","+\tprivate function tagCreated(TagCreatedEvent $event): void {"," \t\t$tag = $event->getTag();"," "," \t\t$this->log(Operation::SystemTagCreated, 'System tag \"%s\" (%s, %s) created',"," \t\t\t["," \t\t\t\t'name' => $tag->getName(),","-\t\t\t\t'visibility' => $tag->isUserVisible() ? 'visible' : 'invisible',","-\t\t\t\t'assignable' => $tag->isUserAssignable() ? 'user assignable' : 'system only',","+\t\t\t\t'visibility' => $this->formatVisibility($tag),","+\t\t\t\t'assignable' => $this->formatAssignable($tag),"," \t\t\t],"," \t\t\t['name', 'visibility', 'assignable']"," \t\t);"," \t}","+","+\tprivate function tagUpdated(TagUpdatedEvent $event): void {","+\t\t$tag = $event->getTag();","+","+\t\t$this->log(Operation::SystemTagUpdated, 'System tag %s (\"%s\") was updated to \"%s\" (%s, %s)',","+\t\t\t[","+\t\t\t\t'tagId' => $tag->getId(),","+\t\t\t\t'previousName' => $event->getTagBefore()->getName(),","+\t\t\t\t'name' => $tag->getName(),","+\t\t\t\t'visibility' => $this->formatVisibility($tag),","+\t\t\t\t'assignable' => $this->formatAssignable($tag),","+\t\t\t],","+\t\t\t['tagId', 'previousName', 'name', 'visibility', 'assignable']","+\t\t);","+\t}","+","+\tprivate function tagDeleted(TagDeletedEvent $event): void {","+\t\t$tag = $event->getTag();","+","+\t\t$this->log(Operation::SystemTagDeleted, 'System tag %s (\"%s\") was deleted',","+\t\t\t[","+\t\t\t\t'tagId' => $tag->getId(),","+\t\t\t\t'name' => $tag->getName(),","+\t\t\t],","+\t\t\t['tagId', 'name']","+\t\t);","+\t}","+","+\tprivate function tagAssigned(TagAssignedEvent $event): void {","+\t\t$this->logAssignment(Operation::SystemTagAssigned, 'Restricted system tags \"%s\" were assigned to %s %s objects \"%s\"', $event->getTags(), $event->getObjectType(), $event->getObjectIds());","+\t}","+","+\tprivate function tagUnassigned(TagUnassignedEvent $event): void {","+\t\t$this->logAssignment(Operation::SystemTagUnassigned, 'Restricted system tags \"%s\" were unassigned from %s %s objects \"%s\"', $event->getTags(), $event->getObjectType(), $event->getObjectIds());","+\t}","+","+\t/**","+\t * Only restricted and invisible tags are logged, as those are the ones access","+\t * control and retention rules rely on. Object IDs are capped to keep bulk","+\t * assignments to a single short entry.","+\t *","+\t * @param list<int|string> $tagIds","+\t * @param list<string> $objectIds","+\t */","+\tprivate function logAssignment(Operation $operation, string $text, array $tagIds, string $objectType, array $objectIds): void {","+\t\t$restrictedTagIds = $this->getRestrictedTagIds($tagIds);","+\t\tif ($restrictedTagIds === [] || $objectIds === []) {","+\t\t\treturn;","+\t\t}","+","+\t\t$loggedObjectIds = implode(', ', array_slice($objectIds, 0, self::MAX_LOGGED_OBJECT_IDS));","+\t\tif (count($objectIds) > self::MAX_LOGGED_OBJECT_IDS) {","+\t\t\t$loggedObjectIds .= ', ...';","+\t\t}","+","+\t\t$this->log($operation, $text,","+\t\t\t[","+\t\t\t\t'tagIds' => implode(', ', $restrictedTagIds),","+\t\t\t\t'objectCount' => count($objectIds),","+\t\t\t\t'objectType' => $objectType,","+\t\t\t\t'objectIds' => $loggedObjectIds,","+\t\t\t],","+\t\t\t['tagIds', 'objectCount', 'objectType', 'objectIds']","+\t\t);","+\t}","+","+\t/**","+\t * @param list<int|string> $tagIds","+\t * @return list<string>","+\t */","+\tprivate function getRestrictedTagIds(array $tagIds): array {","+\t\t$restrictedTagIds = [];","+\t\tforeach ($tagIds as $tagId) {","+\t\t\ttry {","+\t\t\t\t$tag = current($this->tagManager->getTagsByIds([$tagId]));","+\t\t\t} catch (TagNotFoundException|\\InvalidArgumentException) {","+\t\t\t\tcontinue;","+\t\t\t}","+\t\t\tif ($tag !== false && (!$tag->isUserVisible() || !$tag->isUserAssignable())) {","+\t\t\t\t$restrictedTagIds[] = (string)$tagId;","+\t\t\t}","+\t\t}","+\t\treturn $restrictedTagIds;","+\t}","+","+\tprivate function formatVisibility(ISystemTag $tag): string {","+\t\treturn $tag->isUserVisible() ? 'visible' : 'invisible';","+\t}","+","+\tprivate function formatAssignable(ISystemTag $tag): string {","+\t\treturn $tag->isUserAssignable() ? 'user assignable' : 'system only';","+\t}"," }"],"additions":124,"deletions":5,"truncated":false},{"path":"apps/admin_audit/lib/Operation.php","lines":["@@ -100,4 +100,11 @@ enum Operation: string {"," \tcase SubAdminRemoved = 'groups.subadmin.removed';"," \tcase TwoFactorProviderEnabled = 'auth.twofactor_provider.enabled';"," \tcase TwoFactorProviderDisabled = 'auth.twofactor_provider.disabled';","+","+\t// System tags","+\tcase SystemTagUpdated = 'systemtags.tag.updated';","+\tcase SystemTagDeleted = 'systemtags.tag.deleted';","+\tcase 