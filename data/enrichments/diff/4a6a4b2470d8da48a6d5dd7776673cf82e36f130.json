{"id":"4a6a4b2470d8da48a6d5dd7776673cf82e36f130","axis":"silent","repo":"matomo-org/matomo","sha":"4a6a4b2470d8da48a6d5dd7776673cf82e36f130","parsed":{"files":[{"path":"CHANGELOG.md","lines":["@@ -109,6 +109,7 @@ The Product Changelog at **[matomo.org/changelog](https://matomo.org/changelog)*","   * A bulk tracking request whose body is not valid JSON, or whose `requests` is missing or not an array, is rejected with `400` instead of being answered with a success response that tracked nothing.","   * The tracking endpoint answers `503` instead of `200` while Matomo is not installed yet.","   * An array passed for a numeric tracking parameter, such as `revenue[]=1`, now falls back to the parameter's default like any other wrongly typed value, instead of failing the request with `500`.","+* A tracking request whose custom timestamp `cdt` (after applying `cdo`) is more than one day in the future or more than 20 years in the past, or cannot be parsed, is now rejected with `400`, and counted as invalid in a bulk request. Previously such a request was tracked with the current time instead, or failed with `500` for values outside the integer range. A `cdt` up to one day in the future is still tracked with the current time, so a client clock running fast does not lose hits."," "," ### Internal Changes"," * `./console vue:build` no longer emits the unminified `plugins/<Plugin>/vue/dist/<Plugin>.umd.js` bundle. Only the minified `<Plugin>.umd.min.js` was ever loaded by Matomo, and development mode uses the `<Plugin>.development.umd.js` produced by `./console vue:build --watch`. Plugin authors can delete the committed `vue/dist/<Plugin>.umd.js` file from their repository and add `/vue/dist/*.umd.js` to their `.gitignore`. Nothing else needs to change; the file is simply no longer regenerated."],"additions":1,"deletions":0,"truncated":false},{"path":"core/Tracker/Request.php","lines":["@@ -67,6 +67,8 @@ class Request"," ","     public const UNKNOWN_RESOLUTION = 'unknown';"," ","+    private const CUSTOM_TIMESTAMP_MAX_SECONDS_IN_FUTURE = 86400;","+","     private $customTimestampDoesNotRequireTokenauthWhenNewerThan;"," ","     /**","@@ -578,14 +580,26 @@ protected function getCustomTimestamp()"," ","         if (!is_numeric($cdt)) {","             $cdt = strtotime($cdt, $this->timestamp);","+","+            if ($cdt === false) {","+                throw new InvalidRequestParameterException(\"Custom timestamp 'cdt' could not be parsed\");","+            }","         }"," ","         if (!empty($cdo)) {","             $cdt = $cdt - abs($cdo);","         }"," ","+        if (","+            $cdt > $this->timestamp + self::CUSTOM_TIMESTAMP_MAX_SECONDS_IN_FUTURE","+            || $cdt <= $this->timestamp - 20 * 365 * 86400","+        ) {","+            throw new InvalidRequestParameterException('Custom timestamp is more than a day in the future or more than 20 years in the past');","+        }","+","         if (!$this->isTimestampValid($cdt, $this->timestamp)) {","-            Common::printDebug(sprintf(\"Datetime %s is not valid\", date(\"Y-m-d H:i:m\", $cdt)));","+            // slightly in the future, e.g. a client clock running fast","+            Common::printDebug('Custom timestamp is in the future, using the current time');","             return false;","         }"," "],"additions":15,"deletions":1,"truncated":false},{"path":"plugins/CoreConsole/tests/System/ArchiveCronTest.php","lines":["@@ -481,7 +481,7 @@ public function testArchivePhpCronWithTimeLimit()","         Rules::setBrowserTriggerArchiving(false);"," ","         // track a visit so archiving will go through","-        $tracker = Fixture::getTracker(1, '2005-09-04');","+        $tracker = Fixture::getTracker(1, '2012-09-04');","         $tracker->setUrl('http://example.com/test/url2');","         Fixture::checkResponse($tracker->doTrackPageView('jkl'));"," "],"additions":1,"deletions":1,"truncated":false},{"path":"tests/PHPUnit/Integration/Tracker/RequestTest.php","lines":["@@ -12,6 +12,7 @@"," use Matomo\\Network\\IPUtils;"," use Piwik\\Config;"," use Piwik\\Container\\StaticContainer;","+use Piwik\\Exception\\InvalidRequestParameterException;"," use Piwik\\Piwik;"," use Piwik\\Plugins\\UsersManager\\Model;"," use Piwik\\Plugins\\UsersManager\\UsersManager;","@@ -286,6 +287,52 @@ public function testCdtShouldReturnTheCustomTimestampIfTimestampIsInFuture()","         $this->assertSame($this->time, $request->getCurrentTimestamp());","     }"," ","+    public function testCdtShouldReturnTheCurrentTimestampIfTimestampIsLessThanADayInFuture()","+    {","+        $request = $this->buildRequest(array('cdt' => '' . ($this->time + 86400)));","+        $request->setCurrentTimestamp($this->time);","+        $this->assertSame($this->time, $request->getCurrentTimestamp());","+    }","+","+    /**","+     * @dataProvider getCustomTimestampsOutOfRange","+     */","+    public function testCdtShouldRejectTimestampsOutOfRange($cdt)","+    {","+        $this->expectException(InvalidRequestParameterException::class);","+        $this->expectExceptionMessage('Custom timestamp is more than a day in the future or more than 20 years in the past');","+","+        // an int is an offset to the current time","+        if (is_int($cdt)) {","+            $cdt = '' . ($this->time + $cdt);","+        }","+","+        $request = $this->buildRequest(array('cdt' => $cdt));","+        $request->setCurrentTimestamp($this->time);","+        $request->setIsAuthenticated();","+        $request->getCurrentTimestamp();","+    }","+","+    public function getCustomTimestampsOutOfRange(): iterable","+    {","+        yield 'more than a day in future' => [86401];","+        yield 'more than 20 years old' => [-20 * 365 * 86400];","+        yield 'beyond the integer range' => ['99999999999999999999'];","+        yield 'negative beyond the integer range' => ['-99999999999999999999'];","+        yield 'infinite' => ['1e400'];","+        yield 'date string far in future' => ['+2 days'];","+    }","+","+    public function testCdtShouldRejectTimestampsThatCannotBeParsed()","+    {","+        $this->expectException(InvalidRequestParameterException::class);","+        $this->expectExceptionMessage(\"Custom timestamp 'cdt' could not be parsed\");","+","+        $request = $this->buildRequest(array('cdt' => 'not a date'));","+        $request->setCurrentTimestamp($this->time);","+        $request->getCurrentTimestamp();","+    }","+","     public function testCdtShouldReturnTheCustomTimestampShouldUseStrToTimeIfItIsNotATime()","     {","         $request = $this->buildRequest(array('cdt' => '10 years ago'));"],"additions":47,"deletions":0,"truncated":false},{"path":"tests/PHPUnit/System/TrackerResponseTest.php","lines":["@@ -119,6 +119,25 @@ public function testResponseShouldSend400ResponseCodeIfCustomActionIsNotHandledB","         $this->assertEquals(400, $response['status']);","     }"," ","+    /**","+     * @dataProvider getCustomTimestampsOutOfRange","+     */","+    public function testResponseShouldSend400ResponseCodeIfCustomTimestampIsOutOfRange($cdt)","+    {","+        $url = $this->tracker->getUrlTrackPageView('Test');","+        $url .= '&token_auth=' . Fixture::getTokenAuth();","+        $url .= '&cdt=' . urlencode($cdt);","+","+        $response = $this->sendHttpRequest($url);","+        $this->assertEquals(400, $response['status']);","+    }","+","+    public function getCustomTimestampsOutOfRange(): iterable","+    {","+        yield 'more than a day in future' => ['' . (time() + 2 * 86400)];","+        yield 'beyond the integer range' => ['99999999999999999999'];","+    }","+","     public function testResponseShouldSend400ResponseCodeIfIdGoalIsInvalid()","     {","         $url = $this->tracker->getUrlTrackPageView('Test');"],"additions":19,"deletions":0,"truncated":false},{"path":"tests/PHPUnit/Unit/Tracker/RequestTest.php","lines":["@@ -46,11 +46,14 @@ public function testGetCurrentTimestampShouldReturnTheSetTimestampIfNoCustomValu","         $this->assertSame($this->time, $this->request->getCurrentTimestamp());","     }"," ","-    public function testGetCurrentTimestampShouldReturnTheCurrentTimestampIfTimestampIsInvalid()","+    public function testGetCurrentTimestampShouldRejectATimestampMoreThan20YearsOld()","     {","+        $this->expectException(InvalidRequestParameterException::class);","+        $this->expectExceptionMessage('Custom timestamp is more than a day in the future or more than 20 years in the past');","+","         $request = $this->buildRequest(array('cdt' => '' . 5));","         $request->setIsAuthenticated();","-        $this->assertSame($this->time, $request->getCurrentTimestamp());","+        $request->getCurrentTimestamp();","     }"," ","     public function testGetCurrentTimestampShouldReturnTheCurrentTimestampIfRelativeOffsetIsUsed()",""],"additions":5,"deletions":2,"truncated":false}],"additions":88,"deletions":4,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-10-30T15:56:46.859201+00:00"}