,"," }"," ","-#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]","-async fn embedded_replica_follows_a_primary_on_the_newer_sync_protocol() {","-    let directory = tempfile::tempdir().unwrap();","-    let primary_path = directory.path().join(\"primary.db\");","-    let db = Builder::new_local(&primary_path).build().await.unwrap();","-    let backend = LibsqlAuth::from_database(db, MaxUsers::Unlimited, 4).await.unwrap();","-    backend.add_or_login(\"alice\", \"secret\").await.unwrap();","-    let token = backend.issue(\"alice\").await.unwrap();","-    let conn = backend.pool.connect().unwrap();","+/// A primary at `path`, served on a loopback port.","+async fn serve_primary(path: PathBuf) -> (Arc<Primary>, SocketAddr, tokio::task::JoinHandle<()>) {","+    let db = Builder::new_local(&path).build().await.unwrap();","+    let conn = db.connect().unwrap();","+    // A primary keeps a WAL for the frames it serves; a plain local database","+    // runs with a rollback journal.","+    let mut journal_mode = conn","+        .query(\"PRAGMA journal_mode = WAL\", ())","+        .await","+        .unwrap();","+    while journal_mode","+        .next()","+        .await","+        .unwrap()","+        .is_some()","+    {}","     let primary = Arc::new(Primary {","-        backend,","+        _db: db,","         conn,","-        path: primary_path,","+        path,","         exports: AtomicUsize::new(0),","         pipelines: AtomicUsize::new(0),","+        generation: AtomicUsize::new(1),","+        salt: std::sync::Mutex::new(None),","     });","     let app = Router::new()","         .route(\"/info\", get(info))","         .route(\"/export/{generation}\", get(export))","-        .route(\"/sync/{generation}/{start}/{end}\", get(end_of_generation))","+        .route(\"/sync/{generation}/{start}/{end}\", get(sync))","         .route(\"/v3/pipeline\", post(pipeline))","         .with_state(Arc::clone(&primary));","     let listener = tokio::net::TcpListener::bind(\