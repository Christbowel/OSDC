{"id":"07ada89ed170c48e61cbec8e88045b0682d2b702","axis":"silent","repo":"symfony/symfony","sha":"07ada89ed170c48e61cbec8e88045b0682d2b702","parsed":{"files":[{"path":"UPGRADE-8.2.md","lines":["@@ -185,6 +185,7 @@ FrameworkBundle","  * Deprecate `DependencyInjection\\Compiler\\JsonPathPass`, use the one from the JsonPath component instead","  * Deprecate `Controller\\TemplateController`, use the one from TwigBundle instead. Its service now exists when TwigBundle is registered instead of whenever routing is, and the old service id keeps working as a deprecated alias","  * The secrets vault no longer loads env vars when its directory is in the project but does not exist when the container is built (`config/secrets/` by default). The env var of `framework.secret` is then not derived from `SYMFONY_DECRYPTION_SECRET` anymore when it is empty or not defined: define it, or create the vault. In non-debug environments, clear the cache after creating the first vault","+ * The env vars of the `framework.test` option are now read while the container is compiled. With `test: '%env(bool:FOO)%'`, the test services are not loaded anymore when `FOO` is false. They used to be loaded whatever the value of `FOO`. The container also fails to compile when `FOO` is not defined"," "," HttpClient"," ----------"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/CHANGELOG.md","lines":["@@ -4,6 +4,7 @@ CHANGELOG"," 8.2"," ---"," ","+ * Resolve the env vars of the `framework.test` option while the container is compiled","  * Default `framework.session.storage_factory_id` to `session.storage.factory.mock_file` when `framework.test` is `true`","  * Add `KernelBrowser::sendWebhook()` to post a webhook signed as its `webhook.routing` entry expects","  * Add `WebhookAssertionsTrait` to `KernelTestCase` to assert on the webhooks sent with the `webhook.transport` service"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/DependencyInjection/Configuration.php","lines":["@@ -83,7 +83,7 @@ public function getConfigTreeBuilder(): TreeBuilder","                     ->defaultNull()","                     ->setDeprecated('symfony/framework-bundle', '8.2', 'Setting the \"%path%.%node%\" configuration option is deprecated, use the \"SYMFONY_IDE\" env var instead.')","                 ->end()","-                ->booleanNode('test')->end()","+                ->booleanNode('test')->resolvesAtCompileTime()->end()","                 ->scalarNode('default_locale')->defaultValue('en')->end()","                 ->booleanNode('set_locale_from_accept_language')","                     ->info('Whether to use the Accept-Language HTTP header to set the Request locale (only when the \"_locale\" request attribute is not passed).')"],"additions":1,"deletions":1,"truncated":false},{"path":"src/Symfony/Bundle/FrameworkBundle/Tests/DependencyInjection/FrameworkExtensionTestCase.php","lines":["@@ -344,6 +344,28 @@ public function testUriSignerSecrets()","         $this->assertSame(['n3w', 's3cr3t'], $container->getDefinition('uri_signer')->getArgument(0));","     }"," ","+    #[TestWith(['true', true])]","+    #[TestWith(['false', false])]","+    public function testTheEnvVarOfTheTestOptionIsResolvedWhenTheContainerIsCompiled(string $env, bool $enabled)","+    {","+        $_ENV['FRAMEWORK_TEST'] = $env;","+","+        try {","+            $container = $this->createContainerFromClosure(static function ($container) {","+                $container->loadFromExtension('framework', [","+                    'secret' => 's3cr3t',","+                    'session' => true,","+                    'test' => '%env(bool:FRAMEWORK_TEST)%',","+                ]);","+            });","+        } finally {","+            unset($_ENV['FRAMEWORK_TEST']);","+        }","+","+        $this->assertSame($enabled, $container->hasDefinition('test.service_container'));","+        $this->assertSame($enabled ? 'session.storage.factory.mock_file' : 'session.storage.factory.native', (string) $container->getAlias('session.storage.factory'));","+    }","+","     #[Group('legacy')]","     #[IgnoreDeprecations]","     public function testHincludeGlobalTemplateParameterIsDeprecated()"],"additions":22,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/SecurityBundle/DependencyInjection/SecurityExtension.php","lines":["@@ -31,6 +31,7 @@"," use Symfony\\Component\\DependencyInjection\\Compiler\\ServiceLocatorTagPass;"," use Symfony\\Component\\DependencyInjection\\ContainerBuilder;"," use Symfony\\Component\\DependencyInjection\\Definition;","+use Symfony\\Component\\DependencyInjection\\Exception\\ExceptionInterface;"," use Symfony\\Component\\DependencyInjection\\Extension\\Extension;"," use Symfony\\Component\\DependencyInjection\\Extension\\PrependExtensionInterface;"," use Symfony\\Component\\DependencyInjection\\Loader\\PhpFileLoader;","@@ -95,15 +96,22 @@ public function prepend(ContainerBuilder $container): void","         }"," ","         $this->frameworkTest = false;","+        $test = false;"," ","         if ($container->hasExtension('framework')) {","             foreach ($container->getExtensionConfig('framework') as $config) {","                 if (\\array_key_exists('test', $config)) {","                     // \"test: ~\" enables the option, like \"test: true\"","-                    $this->frameworkTest = true === $container->getParameterBag()->resolveValue($config['test'] ?? true);","+                    $test = $config['test'] ?? true;","                 }","             }","         }","+","+        try {","+            $this->frameworkTest = true === $container->resolveEnvPlaceholders($test, true);","+        } catch (ExceptionInterface) {","+            // FrameworkBundle reports the error with the name of the option","+        }","     }"," ","     public function load(array $configs, ContainerBuilder $container): void"],"additions":9,"deletions":1,"truncated":false},{"pat