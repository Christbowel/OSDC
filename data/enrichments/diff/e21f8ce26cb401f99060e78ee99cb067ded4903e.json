/transform_result.hpp","lines":["@@ -2,17 +2,60 @@"," "," #include \"duckdb/common/common.hpp\""," ","+#include <cstring>","+"," namespace duckdb {"," ","+//! A per-type name, used to identify transform results without RTTI.","+//! The address of a static member cannot be used for this: a loadable extension links its own copy of","+//! DuckDB, so the same instantiation exists at a different address in each image. Comparing the name","+//! keeps a transform result created in one image castable in the other.","+template <class T>","+const char *TransformResultTypeName() {","+#ifdef _MSC_VER","+\treturn __FUNCSIG__;","+#else","+\treturn __PRETTY_FUNCTION__;","+#endif","+}","+"," struct TransformResultValue {"," \tvirtual ~TransformResultValue() = default;","+","+\t//! Identifies the concrete TypedTransformResult<T> without relying on RTTI","+\tvirtual const char *TypeTag() const = 0;"," };"," "," template <class T>"," struct TypedTransformResult : public TransformResultValue {"," \texplicit TypedTransformResult(T value_p) : value(std::move(value_p)) {"," \t}","+","+\tconst char *TypeTag() const override {","+\t\treturn TransformResultTypeName<T>();","+\t}","+"," \tT value;"," };"," ","+//! Casts to TypedTransformResult<T> if the result holds exactly that type, and returns nullptr otherwise","+template <class T>","+TypedTransformResult<T> *TryCastTransformResult(TransformResultValue *result) {","+\tif (!result) {","+\t\treturn nullptr;","+\t}","+\tauto tag = result->TypeTag();","+\tauto expected = TransformResultTypeName<T>();","+\t// the pointers are equal whenever both sides come from the same image, which is the common case","+\tif (tag != expected && std::strcmp(tag, expected) != 0) {","+\t\treturn nullptr;","+\t}","+\treturn static_cast<TypedTransformResult<T> *>(result);","+}","+","+template <class T>","+TypedTransformResult<T> *TryCastTransformResult(TransformResultValue &result) {","+\treturn TryCastTransformResult<T>(&result);","+}","+"," } // namespace duckdb"