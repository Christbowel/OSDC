e expression,","+     * so that they can be checked before the job is routed.","+     */","+    public Optional<List<String>> literalTags() {","+        try {","+            return Property.asStaticList(tags, String.class)","+                .filter(list -> list.stream().noneMatch(tag -> tag != null && PebbleUtil.containsOpeningBlockDelimiter(tag)));","+        } catch (IllegalVariableEvaluationException e) {","+            return Optional.empty();","+        }","+    }","+","+    @AssertTrue(message = \"fallback can only be set when tags is non-empty\")","+    @JsonIgnore","+    public boolean isFallbackOnlyWithTags() {","+        return fallback == null || hasTags();","+    }","+","+    @AssertTrue(message = \"match can only be set when tags is non-empty\")","+    @JsonIgnore","+    public boolean isMatchOnlyWithTags() {","+        return match == null || hasTags();","+    }","+","+    private boolean hasTags() {","+        if (tags == null) {","+            return false;","+        }","+        try {","+            return Property.asStaticList(tags, String.class).map(list -> !list.isEmpty()).orElse(true);","+        } catch (IllegalVariableEvaluationException e) {","+            return true;","+        }","+    }","+}"],"additions":116,"deletions":0,"truncated":false},{"path":"core/src/main/java/io/kestra/core/models/tasks/GenericTask.java","lines":["@@ -22,7 +22,7 @@ public class GenericTask implements TaskInterface {","     private String version;","     private String id;","     private String type;","-    private WorkerSelector workerSelector;","+    private FlowWorkerSelector workerSelector;"," ","     @JsonIgnore","     @Builder.Default"],"additions":1,"deletions":1,"truncated":false},{"path":"core/src/main/java/io/kestra/core/models/tasks/Task.java","lines":["@@ -74,7 +74,7 @@ abstract public class Task implements TaskInterface {","     @Valid","     @PluginProperty(hidden = true, group = \"execution\")","     @Schema(description = \"Routing requirements (