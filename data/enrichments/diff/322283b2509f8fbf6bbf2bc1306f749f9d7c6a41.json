        self.num_intervals = 0"," ","-        def elapsed(self, reset=True):","-            \"\"\"Calculate the elapsed time.\"\"\"","-            started_ = self.started_","-            # If the timing in progress, end it first.","+        def _elapsed(self, reset, total):","+            # A timer still running here was not stopped by its caller, so end its interval.","             if self.started_:","                 self.stop()","             # Get the elapsed time.","-            elapsed_ = self._get_elapsed_msec()","+            self._read_latest()","+            if total:","+                elapsed_ = self.total_elapsed_msec","+            else:","+                elapsed_ = self.latest_elapsed_msec","             # Reset the elapsed time","             if reset:","                 self.reset()","-            # If timing was in progress, set it back.","-            if started_:","-                self.start()","             return elapsed_"," ","+        def elapsed(self, reset=True):","+            \"\"\"Elapsed time in ms of the latest start/stop interval.\"\"\"","+            return self._elapsed(reset, total=False)","+","+        def elapsed_total(self, reset=True):","+            \"\"\"Total elapsed time in ms of all intervals since the last reset.\"\"\"","+            return self._elapsed(reset, total=True)","+","         def mean(self):","+            \"\"\"Mean elapsed time in ms of all intervals since the last reset.\"\"\"","             self.elapsed(reset=False)","-            return trim_mean(self.elapsed_records, 0.1)","+            if self.num_intervals == 0:","+                return 0.0","+            return self.total_elapsed_msec / self.num_intervals"," ","     def __init__(self):","         self.timers = {}","@@ -144,7 +148,7 @@ def log(self, names, normalizer=1.0, reset=True, memory_breakdown=False, ranks=N","         string = \"time (ms)\"","         for name in names:","             if name in self.timers:","-                elapsed_time =