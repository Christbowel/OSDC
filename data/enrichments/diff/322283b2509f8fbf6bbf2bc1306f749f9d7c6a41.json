_logging import CommsLogger","+from unit.common import DistributedTest"," "," "," def test_stop_profiling_comms_disables_prof_all():","@@ -25,6 +28,27 @@ def test_stop_profiling_comms_disables_prof_all():","     assert comms_logger.prof_all is False"," "," ","+@pytest.mark.parametrize('enabled', [False, True, None])","+def test_configure_from_config_follows_the_enabled_field(monkeypatch, enabled):","+    # The section's own \"enabled\" field decides, not whether the section is present.","+    # None leaves \"enabled\" out of the section, which means the documented default of False.","+    from deepspeed.comm import comm","+    from deepspeed.comm.config import DeepSpeedCommsConfig","+","+    monkeypatch.setattr(comm, 'comms_logger', CommsLogger())","+    section = {'prof_all': False, 'prof_ops': ['all_reduce']}","+    if enabled is not None:","+        section['enabled'] = enabled","+    comms_config = DeepSpeedCommsConfig({'comms_logger': section})","+    comm.configure(deepspeed_config=SimpleNamespace(comms_config=comms_config))","+","+    expected_enabled = enabled is True","+    assert comm.comms_logger.enabled is expected_enabled","+    if expected_enabled:","+        assert comm.comms_logger.prof_all is False","+        assert comm.comms_logger.prof_ops == ['all_reduce']","+","+"," def test_get_operation_summary_does_not_reorder_the_stored_records():","     # comms_dict stores parallel lists per message size: [count, latencies, algbws,","     # busbws], where index i is the i-th recorded op. trim_mean used to sort in","@@ -169,6 +193,34 @@ def test_collective_profiling(monkeypatch, op_name, positional, debug, profile_m","         assert all(call.args == (record_name, ) for call in timers.call_args_list)"," "," ","+class TestCommsLoggerLatency(DistributedTest):","+    world_size = 2","+","+    def test_logged_latencies_fit_in_the_loop(self):","+        # Each call is timed on its own and the calls run one after another, so the logged","+        # latencies can add up to at most the wall-clock time of the loop.","+        import deepspeed.comm as dist","+        from deepspeed.comm import comm","+","+        num_calls = 200","+        tensor = torch.ones(1024, device=get_accelerator().current_device_name())","+        dist.configure(enabled=True, prof_all=True, verbose=False, debug=False)","+        try:","+            get_accelerator().synchronize()","+            loop_start = time.time()","+            for _ in range(num_calls):","+                dist.all_reduce(tensor)","+            loop_msec = (time.time() - loop_start) * 1000.0","+            msg_size = tensor.numel() * tensor.element_size()","+            latencies = comm.comms_logger.comms_dict['all_reduce'][msg_size][1]","+        finally:","+            dist.configure(enabled=False)","+            comm.comms_logger.reset_data()","+","+        assert len(latencies) == num_calls","+        assert sum(latencies) <= loop_msec","+","+"," def test_timed_op_disabled_does_not_access_profiling_state(monkeypatch):","     from deepspeed.comm import comm"," "],"additions":52,"deletions":0,"truncated":false},{"path":"tests/unit/utils/test_timer.py","lines":["@@ -0,0 +1,70 @@","+# Copyright (c) DeepSpeed Team.","+# SPDX-License-Identifier: Apache-2.0","+","+# DeepSpeed Team","+","+import pytest","+import torch","+","+from deepspeed.accelerator import get_accelerator","+from deepspeed.utils.timer import SynchronizedWallClockTimer","+","+# Allowed difference in ms between the timer and the reference events recorded right inside it.","+TOLERANCE_MS = 0.05","+","+","+@pytest.fixture","+def run_matmuls():","+    accelerator = get_accelerator()","+    if accelerator.use_host_timers():","+        pytest.skip(\"this accelerator times with host timers, not device events\")","+    x = torch.randn(2048, 2048, device=accelerator.device_name())","+    y = torch.empty_like(x)","+","+    def run(num_matmuls):","+        for _ in range(num_matmuls):","+            torch.mm(x, x, out=y)","+","+    return run","+","+","+def time_intervals(timer, run_matmuls, matmuls_per_interval):","+    # Each interval is also measured by its own reference events, recorded just inside the timer's","+    # events. The reference durations are the expected values.","+    reference_events = []","+    for num_matmuls in matmuls_per_interval:","+        # Queue work first so the timer's and the reference's start events complete together on the","+        # device, however long the host takes between recording them.","+        run_matmuls(10)","+        reference_start = get_accelerator().Event(enable_timing=True)","+        reference_stop = get_accelerator().Event(enable_timing=True)","+        timer.start()","+        reference_start.record()","+        run_matmuls(num_matmuls)","+        reference_stop.record()","+        timer.stop()","+        reference_events.append((reference_start, reference_stop))","+    get_accelerator().synchronize()","+    return [start.elapsed_time(stop) for start, stop in reference_events]","+","+","+def test_elapsed_is_latest_interval_and_elapsed_total_is_sum(run_matmuls):","+    timer = SynchronizedWallClockTimer()('op')","+    expected = time_intervals(timer, run_matmuls, [5, 20, 10])","+","+    assert timer.elapsed(reset=False) == pytest.approx(expected[-1], abs=TOLERANCE_MS)","+    assert timer.elapsed_total(reset=False) == pytest.approx(sum(expected), abs=TOLERANCE_MS)","+    assert timer.mean() == pytest.approx(sum(expected) / len(expected), abs=TOLERANCE_MS)","+    # A read without reset must not consume anything: the engine reads its timers twice per step.","+    assert timer.elapsed_total(reset=False) == pytest.approx(sum(expected), abs=TOLERANCE_MS)","+","+","+def test_reset_starts_a_new_total(run_matmuls):","+    timer = SynchronizedWallClockTimer()('op')","+    expected = time_intervals(timer, run_matmuls, [5, 20])","+    assert timer.elapsed_total(reset=True) == pytest.approx(sum(expected), abs=TOLERANCE_MS)","+","+    expected = time_intervals(timer, run_matmuls, [10])","+    assert timer.elapsed(reset=False) == pytest.approx(expected[0], abs=TOLERANCE_MS)","+    assert timer.elapsed_total(reset=False) == pytest.approx(expected[0], abs=TOLERANCE_MS)","+    assert timer.mean() == pytest.approx(expected[0], abs=TOLERANCE_MS)",""],"additions":70,"deletions":0,"truncated":false}],"additions":192,"deletions":76,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-10-28T14:43:51.635540+00:00"}