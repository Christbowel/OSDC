{"id":"5fb5fba3a25b5fa4a1604f3faece364ace2a5d64","axis":"silent","repo":"pnpm/pnpm","sha":"5fb5fba3a25b5fa4a1604f3faece364ace2a5d64","parsed":{"files":[{"path":".changeset/pnpr-hosted-tar-storage.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/pnpr\": minor","+---","+","+A hosted registry that declares `tarballs: tar` now stores each published version as one tar compressed with zstd at level 19, and no `.tgz`. A client that accepts zstd gets those bytes, so even its first download is at level 19. Any other client gets the tar decoded, gzip-encoded if it asks for gzip.","+","+pnpr now refuses to start when a router without `tarballs: tar` lists such a registry as a source. Versions that an earlier pnpr published to such a registry are no longer served. Publish them again."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/registry_graph.rs","lines":["@@ -129,6 +129,7 @@ pub(super) fn build_registries(","     let defaults = addressed_defaults(defaults, &registries);","     let registries = registries.with_defaults(defaults);","     registries.validate().map_err(|err| registry_err(&err))?;","+    check_hosted_tar_sources(&registries, &builder.hosted, &builder.tar_registries)?;","     Ok(ResolvedRegistryGraph {","         hosted: builder.hosted,","         registries,","@@ -211,6 +212,32 @@ impl RegistryGraphBuilder {","     }"," }"," ","+/// A hosted registry that declares `tarballs: tar` stores its versions as","+/// tars, with no `.tgz`, so a router that serves `.tgz` files cannot list it.","+fn check_hosted_tar_sources(","+    registries: &Registries,","+    hosted: &IndexMap<String, HostedConfig>,","+    tar_registries: &BTreeSet<String>,","+) -> Result<(), RegistryError> {","+    let tgz_routers = registries","+        .names()","+        .filter(|name| registries.is_router(name) && !tar_registries.contains(*name));","+    for router in tgz_routers {","+        let tar_source = registries","+            .sources(router, Ecosystem::Npm)","+            .into_iter()","+            .find(|source| hosted.contains_key(*source) && tar_registries.contains(*source));","+        if let Some(source) = tar_source {","+            return Err(RegistryError::InvalidConfig {","+                reason: format!(","+                    \"router {router:?} serves `.tgz` files but lists {source:?}, which declares `tarballs: tar` and stores no `.tgz`; declare `tarballs: tar` on {router:?} or remove {source:?} from its sources\",","+                ),","+            });","+        }","+    }","+    Ok(())","+}","+"," /// Whether `file` declares `tarballs: tar`, which only an npm registry may."," fn declares_tar_tarballs(name: &str, file: &RegistryFile) -> Result<bool, RegistryError> {","     let (tarballs, ecosystem) = match file {"],"additions":27,"deletions":0,"truncated":false},{"path":"pnpr/crates/config/src/tests/registry_graph.rs","lines":["@@ -499,6 +499,32 @@ registries:","     assert!(!config.routing.tar_registries.contains(\"npmjs\"));"," }"," ","+#[test]","+fn a_tgz_router_cannot_list_a_hosted_tar_registry() {","+    let yaml = \"","+registries:","+  local:","+    type: hosted","+    tarballs: tar","+    packages:","+      '@acme/*':","+        publish: $authenticated","+  main:","+    type: router","+    sources: [local]","+\";","+    let error = Config::from_yaml_str(yaml, Path::new(\"/x\"), listen(), None).unwrap_err();","+    assert!(","+        error.to_string().contains(r#\"router \"main\" serves `.tgz` files but lists \"local\"\"#),","+        \"{error}\",","+    );","+","+    let tar_router = format!(\"{yaml}    tarballs: tar\\n\");","+    let config = Config::from_yaml_str(&tar_router, Path::new(\"/x\"), listen(), None).unwrap();","+    assert!(config.routing.tar_registries.contains(\"local\"));","+    assert!(config.routing.tar_registries.contains(\"main\"));","+}","+"," #[test]"," fn tarballs_is_refused_outside_npm() {","     let yaml = \""],"additions":26,"deletions":0,"truncated":false},{"path"