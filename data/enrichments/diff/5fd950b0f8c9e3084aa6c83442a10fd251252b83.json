","+","+func NewWITLRUCache(config WITLRUCacheConfig) *WITLRUCache {","+\tc := &WITLRUCache{}","+\tc.LRUCache = NewLRUCache(LRUCacheConfig[WITSVID, WITWorkloadUpdate]{","+\t\tLog:              config.Log,","+\t\tTrustDomain:      config.TrustDomain,","+\t\tBundle:           config.Bundle,","+\t\tMetrics:          config.Metrics,","+\t\tSvidCacheMaxSize: config.SvidCacheMaxSize,","+\t\tClk:              config.Clk,","+\t\tSVIDType:         agentmetrics.SVIDTypeWIT,","+\t\tBuildUpdate:      buildWITWorkloadUpdate,","+\t})","+\treturn c","+}","+","+func (c *WITLRUCache) UpdateWITSVIDs(svids map[string]*WITSVID) {","+\tc.LRUCache.UpdateSVIDs(svids)","+}","+","+func buildWITWorkloadUpdate(cache *LRUCache[WITSVID, WITWorkloadUpdate], set selectorSet) *WITWorkloadUpdate {","+\trecords, recordsDone := cache.getRecordsForSelectors(set)","+\tdefer recordsDone()","+","+\tidentities := make([]WITIdentity, 0, len(records))","+\tfor record := range records {","+\t\tif svid, ok := cache.svids[record.entry.EntryId]; ok {","+\t\t\tidentities = append(identities, WITIdentity{","+\t\t\t\tEntry:      record.entry,","+\t\t\t\tToken:      svid.Token,","+\t\t\t\tPrivateKey: svid.PrivateKey,","+\t\t\t})","+\t\t}","+\t}","+\tsortIdentities(identities)","+","+\tentries := make([]*common.RegistrationEntry, 0, len(identities))","+\tfor _, identity := range identities {","+\t\tentries = append(entries, identity.Entry)","+\t}","+","+\treturn &WITWorkloadUpdate{","+\t\tBundle:           cache.bundles[cache.trustDomain],","+\t\tFederatedBundles: cache.GatherFederatedBundles(entries),","+\t\tIdentities:       identities,","+\t}","+}"],"additions":109,"deletions":0,"truncated":false},{"path":"pkg/agent/manager/cache/x509_lru_cache.go","lines":["@@ -37,6 +37,10 @@ type X509Identity struct {"," \tPrivateKey crypto.Signer"," }"," ","+func (i X509Identity) entryID() string {","+\treturn i.Entry.EntryId","+}","+"," // X509WorkloadUpdate is used to convey X509 workload information to cache subscribers.","