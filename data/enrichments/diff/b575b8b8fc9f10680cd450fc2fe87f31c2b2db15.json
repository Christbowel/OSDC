vesInRedisWithTtl() {","+        String client = UUID.randomUUID().toString();","+        get(\"/api/hello\", client).then().statusCode(200);","+","+        String key = apiKey(client);","+        Response tat = redis.execute(\"GET\", key);","+        assertThat(tat).isNotNull();","+        assertThat(Long.parseLong(tat.toString())).isPositive();","+        assertThat(redis.execute(\"PTTL\", key).toLong()).isPositive();","+    }","+","+    @Test","+    void stateSurvivesWithoutLocalMemory() {","+        String client = UUID.randomUUID().toString();","+        redis.execute(\"SET\", apiKey(client), Long.toString(redisNowMicros() + API_TAU_US), \"PX\", \"60000\");","+","+        get(\"/api/hello\", client).then().statusCode(429);","+    }","+","+    /**","+     * A TAT 30 days ahead, written by a clock that jumped or under a larger policy, costs the key one emission interval","+     * (20 s for 3 per minute), not 30 days, and the cap is stored.","+     */","+    @Test","+    void debtAboveTheBurstToleranceIsCapped() {","+        String client = UUID.randomUUID().toString();","+        long thirtyDays = 30L * 24 * 3600 * 1_000_000;","+        redis.execute(\"SET\", apiKey(client), Long.toString(redisNowMicros() + thirtyDays), \"PX\","],"additions":78,"deletions":0,"truncated":false}],"additions":687,"deletions":1,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-11-19T17:59:25.162858+00:00"}