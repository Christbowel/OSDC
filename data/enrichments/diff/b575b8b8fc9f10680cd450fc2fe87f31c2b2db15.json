pendency.nonSuperfluous>","+            quarkus-http-rate-limit-redis-deployment","+        </enforcer.requiresMinimalDeploymentDependency.nonSuperfluous>","+    </properties>","+","+    <dependencies>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-http-rate-limit</artifactId>","+        </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-redis-client</artifactId>","+        </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-rest</artifactId>","+        </dependency>","+","+        <!-- test dependencies -->","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-junit</artifactId>","+            <scope>test</scope>","+        </dependency>","+        <dependency>","+            <groupId>io.rest-assured</groupId>","+            <artifactId>rest-assured</artifactId>","+            <scope>test</scope>","+        </dependency>","+        <dependency>","+            <groupId>org.assertj</groupId>","+            <artifactId>assertj-core</artifactId>","+            <scope>test</scope>","+        </dependency>","+        <!-- starts the Redis Cluster of RedisClusterRateLimitTest -->","+        <dependency>","+            <groupId>org.testcontainers</groupId>","+            <artifactId>testcontainers</artifactId>","+            <scope>test</scope>","+        </dependency>","+","+        <!-- Minimal test dependencies to *-deployment artifacts for consistent build order -->","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-http-rate-limit-deployment</artifactId>","+            <version>${project.version}</version>","+            <type>pom</type>","+            <scope>test</scope>","+            <exclusions>","+                <exclusion>","+                    <groupId>*</groupId>","+                    <artifactId>*</artifactId>","+                </exclusion>","+            </exclusions>","+        </dependency>","+        <!-- the conditional dependency quarkus-http-rate-limit-redis, see the enforcer property above -->","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-http-rate-limit-redis-deployment</artifactId>","+            <version>${project.version}</version>","+            <type>pom</type>","+            <scope>test</scope>","+            <exclusions>","+                <exclusion>","+                    <groupId>*</groupId>","+                    <artifactId>*</artifactId>","+                </exclusion>","+            </exclusions>","+        </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-redis-client-deployment</artifactId>","+            <version>${project.version}</version>","+            <type>pom</type>","+            <scope>test</scope>","+            <exclusions>","+                <exclusion>","+                    <groupId>*</groupId>","+                    <artifactId>*</artifactId>","+                </exclusion>","+            </exclusions>","+        </dependency>","+        <dependency>","+            <groupId>io.quarkus</groupId>","+            <artifactId>quarkus-rest-deployment</artifactId>","+            <version>${project.version}</version>","+            <type>pom</type>","+            <scope>test</scope>","+            <exclusions>","+                <exclusion>","+                    <groupId>*</groupId>","+                    <artifactId>*</artifactId>","+                </exclusion>","+            </exclusions>","+        </dependency>","+    </dependencies>","+","+    <build>","+        <plugins>","+            <plugin>","+                <artifactId>maven-surefire-plugin</artifactId>","+                <configuration>","+                    <skip>true</skip>","+                </configuration>","+            </plugin>","+            <plugin>","+                <artifactId>maven-failsafe-plugin</artifactId>","+                <configuration>","+                    <skip>true</skip>","+                </configuration>","+            </plugin>","+            <plugin>","+                <groupId>io.quarkus</groupId>","+                <artifactId>quarkus-maven-plugin</artifactId>","+                <executions>","+                    <execution>","+                        <goals>","+                            <goal>build</goal>","+                        </goals>","+                    </execution>","+                </executions>","+            </plugin>","+        </plugins>","+    </build>","+","+    <profiles>","+        <!-- Note: the Redis containers are started via Dev Services, the cluster by RedisClusterResource -->","+        <profile>","+            <id>test-redis</id>","+            <activation>","+                <property>","+                    <name>test-containers</name>","+                </property>","+            </activation>","+            <build>","+                <plugins>","+                    <plugin>","+                        <artifactId>maven-surefire-plugin</artifactId>","+                        <configuration>","+                            <skip>false</skip>","+                        </configuration>","+                    </plugin>","+                    <plugin>","+                        <artifactId>maven-failsafe-plugin</artifactId>","+                        <configuration>","+                            <skip>false</skip>","+                        </configuration>","+                    </plugin>","+                </plugins>","+            </build>","+        </profile>","+    </profiles>","+","+</project>"],"additions":172,"deletions":0,"truncated":false},{"path":"integration-tests/http-rate-limit-redis/src/main/java/io/quarkus/it/ratelimit/RateLimitedResource.java","lines":["@@ -0,0 +1,32 @@","+package io.quarkus.it.ratelimit;","+","+import jakarta.ws.rs.GET;","+import jakarta.ws.rs.Path;","+","+@Path(\"/\")","+public class RateLimitedResource {","+","+    @GET","+    @Path(\"/api/hello\")","+    public String api() {","+        return \"hello\";","+    }","+","+    @GET","+    @Path(\"/lease/hello\")","+    public String lease() {","+        return \"hello\";","+    }","+","+    @GET","+    @Path(\"/subscription/hello\")","+    public String subscription() {","+        return \"hello\";","+    }","+","+    @GET","+    @Path(\"/subscription-lease/hello\")","+    public String subscriptionLease() {","+        return \"hello\";","+    }","+}"],"additions":32,"deletions":0,"truncated":false},{"path":"integration-tests/http-rate-limit-redis/src/main/java/io/quarkus/it/ratelimit/SubscriptionLimits.java","lines":["@@ -0,0 +1,31 @@","+package io.quarkus.it.ratelimit;","+","+import jakarta.inject.Inject;","+import jakarta.inject.Singleton;","+","+import io.quarkus.http.ratelimit.RateLimit;","+import io.quarkus.http.ratelimit.RateLimitContext;","+import io.quarkus.http.ratelimit.RateLimitResolver;","+import io.quarkus.http.ratelimit.RateLimits;","+import io.smallrye.common.annotation.Identifier;","+import io.smallrye.mutiny.Uni;","+","+/**","+ * Synthetic subscription data for the JVM/native tests. Real applications should use authenticated identity or","+ * trusted subscription data, rather than trusting a client-provided tier.","+ */","+@Singleton","+@Identifier(\"subscription\")","+public class SubscriptionLimits implements RateLimitResolver {","+    @Inject","+    RateLimits limits;","+","+    @Override","+    public Uni<RateLimit> resolve(RateLimitContext context) {","+        String client = context.routingContext().request().getHeader(\"X-Client\");","+        if (client != null && client.startsWith(\"unavailable-\")) {","+            return Uni.createFrom().failure(new IllegalStateException(\"subscription unavailable\"));","+        }","+        return Uni.createFrom().item(limits.get(client != null && client.startsWith(\"paid-\") ? \"paid\" : \"free\"));","+    }","+}"],"additions":31,"deletions":0,"truncated":false},{"path":"integration-tests/http-rate-limit-redis/src/main/resources/application.properties","lines":["@@ -0,0 +1,58 @@","+quarkus.application.name=http-rate-limit-redis","+","+# one Dev Services Redis for the default client, another for the 'limits' client of RedisNamedClientTest","+quarkus.redis.limits.devservices.enabled=true","+","+quarkus.http.rate-limit.rules.api.paths=/api/*","+quarkus.http.rate-limit.rules.api.phase=pre-authentication","+quarkus.http.rate-limit.rules.api.request-key=header:X-Client","+quarkus.http.rate-limit.rules.api.permits=3","+quarkus.http.rate-limit.rules.api.window=1m","+quarkus.http.rate-limit.rules.api.store=redis","+","+# lease mode: T = 10s, so the lease time (lease-size x T = 20s) outlives every test and no chunk expires","+quarkus.http.rate-limit.rules.lease.paths=/lease/*","+quarkus.http.rate-limit.rules.lease.phase=pre-authentication","+quarkus.http.rate-limit.rules.lease.request-key=header:X-Client","+quarkus.http.rate-limit.rules.lease.permits=6","+quarkus.http.rate-limit.rules.lease.window=1m","+quarkus.http.rate-limit.rules.lease.store=redis","+quarkus.http.rate-limit.rules.lease.lease-size=2","+","+quarkus.http.rate-limit.store-timeout=500ms","+# a store failure answers 503 instead of falling back to local limiting, so the tests see every Redis failure","+quarkus.http.rate-limit.store-failure-mode=closed","+","+# Named subscriptions use a resolver without an inline default limit, with both direct Redis calls and leases.","+quarkus.http.rate-limit.limits.free.permits=2","+quarkus.http.rate-limit.limits.free.window=1h","+quarkus.http.rate-limit.limits.paid.permits=4","+quarkus.http.rate-limit.limits.paid.window=1h","+quarkus.http.rate-limit.rules.subscription.paths=/subscription/*","+quarkus.http.rate-limit.rules.subscription.phase=pre-authentication","+quarkus.http.rate-limit.rules.subscription.request-key=header:X-Client","+quarkus.http.rate-limit.rules.subscription.limit-resolver=subscription","+quarkus.http.rate-limit.rules.subscription.store=redis","+quarkus.http.rate-limit.rules.subscription-lease.paths=/subscription-lease/*","+quarkus.http.rate-limit.rules.subscription-lease.phase=pre-authentication","+quarkus.http.rate-limit.rules.subscription-lease.request-key=header:X-Client","+quarkus.http.rate-limit.rules.subscription-lease.limit-resolver=subscription","+quarkus.http.rate-limit.rules.subscription-lease.store=redis","+quarkus.http.rate-limit.rules.subscription-lease.lease-size=2","+","+# Failure paths are also exercised against the native executable.","+quarkus.http.rate-limit.rules.unavailable-key.paths=/unavailable-key/*","+quarkus.http.rate-limit.rules.unavailable-key.phase=pre-authentication","+quarkus.http.rate-limit.rules.unavailable-key.request-key=custom:unavailable","+quarkus.http.rate-limit.rules.unavailable-key.limit=free","+quarkus.http.rate-limit.rules.unavailable-store.paths=/unavailable-store/*","+quarkus.http.rate-limit.rules.unavailable-store.phase=pre-authentication","+quarkus.http.rate-limit.rules.unavailable-store.request-key=header:X-Client","+quarkus.http.rate-limit.rules.unavailable-store.limit=free","+quarkus.http.rate-limit.rules.unavailable-store.store=unavailable","+quarkus.http.rate-limit.rules.unavailable-lease.paths=/unavailable-lease/*","+quarkus.http.rate-limit.rules.unavailable-lease.phase=pre-authentication","+quarkus.http.rate-limit.rules.unavailable-lease.request-key=header:X-Client","+quarkus.http.rate-limit.rules.unavailable-lease.limit=free","+quarkus.http.rate-limit.rules.unavailable-lease.store=unavailable","+quarkus.http.rate-limit.rules.unavailable-lease.lease-size=1"],"additions":58,"deletions":0,"truncated":false},{"path":"integration-tests/http-rate-limit-redis/src/test/java/io/quarkus/it/ratelimit/RedisClusterRateLimitTest.java","lines":["@@ -0,0 +1,58 @@","+package io.quarkus.it.ratelimit;","+","+import static io.quarkus.it.ratelimit.RedisRateLimitHttpTest.get;","+import static org.assertj.core.api.Assertions.assertThat;","+","+import java.util.ArrayList;","+import java.util.List;","+import java.util.UUID;","+","+import jakarta.inject.Inject;","+","+import org.junit.jupiter.api.Test;","+","+import io.quarkus.http.ratelimit.runtime.internal.keys.RateLimitKeys;","+import io.quarkus.redis.datasource.RedisDataSource;","+import io.quarkus.test.common.WithTestResource;","+import io.quarkus.test.junit.QuarkusTest;","+import io.vertx.redis.client.Response;","+","+/**","+ * The default client in cluster mode: every key is decided by the shard that owns it, and the script is cached there","+ * through EVAL (a fresh cluster answers the first EVALSHA on each shard with NOSCRIPT).","+ */","+@QuarkusTest","+@WithTestResource(RedisClusterResource.class)","+public class RedisClusterRateLimitTest {","+","+    private static final String PREFIX = \"quarkus:http-rate-limit:http-rate-limit-redis:api/pre-authentication:header:\";","+","+    @Inject","+    RedisDataSource redis;","+","+    @Test","+    void keysOnEveryShardAreLimited() {","+        List<long[]> shards = new ArrayList<>();","+        for (Response range : redis.execute(\"CLUSTER\", \"SLOTS\")) {","+            shards.add(new long[] { range.get(0).toLong(), range.get(1).toLong() });","+        }","+        assertThat(shards).hasSize(RedisClusterResource.PORTS.length);","+        for (long[] shard : shards) {","+            String client = clientOn(shard);","+            for (int i = 0; i < 3; i++) {","+                get(\"/api/hello\", client).then().statusCode(200);","+            }","+            get(\"/api/hello\", client).then().statusCode(429);","+        }","+    }","+","+    private String clientOn(long[] slots) {","+        while (true) {","+            String client = UUID.randomUUID().toString();","+            long slot = redis.execute(\"CLUSTER\", \"KEYSLOT\", PREFIX + RateLimitKeys.sha256(client)).toLong();","+            if (slot >= slots[0] && slot <= slots[1]) {","+                return client;","+            }","+        }","+    }","+}"],"additions":58,"deletions":0,"truncated":false},{"path":"integration-tests/http-rate-limit-redis/src/test/java/io/quarkus/it/ratelimit/RedisClusterResource.java","lines":["@@ -0,0 +1,57 @@","+package io.quarkus.it.ratelimit;","+","+import java.time.Duration;","+import java.util.Map;","+","+import org.testcontainers.containers.GenericContainer;","+import org.testcontainers.containers.wait.strategy.Wait;","+import org.testcontainers.utility.DockerImageName;","+","+import io.quarkus.test.common.QuarkusTestResourceLifecycleManager;","+","+/**","+ * A three-shard Redis Cluster without replicas in one container on the host network, so that the addresses the nodes","+ * announce ({@code 127.0.0.1:<port>}) are the ones the client reaches.","+ */","+public class RedisClusterResource implements QuarkusTestResourceLifecycleManager {","+","+    static final int[] PORTS = { 7379, 7380, 7381 };","+","+    private GenericContainer<?> cluster;","+","+    @Override","+    public Map<String, String> start() {","+        StringBuilder script = new StringBuilder();","+        StringBuilder nodes = new StringBuilder();","+        for (int port : PORTS) {","+            script.append(\"redis-server --port \").append(port).append(\" --cluster-enabled yes --cluster-config-file nodes-\")","+                    .append(port).append(\".conf --save '' --appendonly no --daemonize yes && \");","+            nodes.append(\" 127.0.0.1:\").append(port);","+        }","+        for (int port : PORTS) {","+            script.append(\"until redis-cli -p \").append(port).append(\" ping; do sleep 0.1; done && \");","+        }","+        script.append(\"redis-cli --cluster create\").append(nodes).append(\" --cluster-replicas 0 --cluster-yes && \");","+        for (int port : PORTS) {","+            script.append(\"until redis-cli -p \").append(port)","+                    .append(\" cluster info | grep -q cluster_state:ok; do sleep 0.1; done && \");","+        }","+        script.append(\"echo CLUSTER READY && tail -f /dev/null\");","+        // the image of the Redis Dev Services default (redis.image in build-parent/pom.xml); host networking, so that","+        // the nodes announce addresses the client can reach, requires a Linux host","+        cluster = new GenericContainer<>(DockerImageName.parse(\"docker.io/library/redis:8\"))","+                .withNetworkMode(\"host\")","+                .withCommand(\"sh\", \"-c\", script.toString())","+                .waitingFor(Wait.forLogMessage(\".*CLUSTER READY.*\", 1).withStartupTimeout(Duration.ofMinutes(1)));","+        cluster.start();","+        return Map.of(\"quarkus.redis.hosts\", \"redis://127.0.0.1:\" + PORTS[0],","+                \"quarkus.redis.client-type\", \"cluster\");","+    }","+","+    @Override","+    public void stop() {","+        if (cluster != null) {","+            cluster.stop();","+        }","+    }","+}"],"additions":57,"deletions":0,"truncated":false},{"path":"integration-tests/http-rate-limit-redis/src/test/java/io/quarkus/it/ratelimit/RedisLeaseHttpTest.java","lines":["@@ -0,0 +1,29 @@","+package io.quarkus.it.ratelimit;","+","+import static io.quarkus.it.ratelimit.RedisRateLimitHttpTest.get;","+import static org.assertj.core.api.Assertions.assertThat;","+","+import java.util.UUID;","+","+import org.junit.jupiter.api.Test;","+","+import io.quarkus.test.junit.QuarkusTest;","+import io.restassured.response.Response;","+","+/**","+ * Lease mode over Redis, black-box HTTP assertions only: {@link RedisLeaseIT} runs them against the native executable.","+ */","+@QuarkusTest","+public class RedisLeaseHttpTest {","+","+    @Test","+    void seventhRequestIsRejected() {","+        String client = \"lease-\" + UUID.randomUUID();","+        for (int i = 0; i < 6; i++) {","+            get(\"/lease/hello\", client).then().statusCode(200);","+        }","+        Response rejected = get(\"/lease/hello\", client);","+        assertThat(rejected.statusCode()).isEqualTo(429);","+        assertThat(Long.parseLong(rejected.header(\"Retry-After\"))).isBetween(1L, 10L);","+    }","+}"],"additions":29,"deletions":0,"truncated":false},{"path":"integration-tests/http-rate-limit-redis/src/test/java/io/quarkus/it/ratelimit/RedisLeaseIT.java","lines":["@@ -0,0 +1,7 @@","+package io.quarkus.it.ratelimit;","+","+import io.quarkus.test.junit.QuarkusIntegrationTest;","+","+@QuarkusIntegrationTest","+public class RedisLeaseIT extends RedisLeaseHttpTest {","+}"],"additions":7,"deletions":0,"truncated":false},{"path":"integration-tests/http-rate-limit-redis/src/test/java/io/quarkus/it/ratelimit/RedisNamedClientTest.java","lines":["@@ -0,0 +1,51 @@","+package io.quarkus.it.ratelimit;","+","+import static io.quarkus.it.ratelimit.RedisRateLimitHttpTest.get;","+import static org.assertj.core.api.Assertions.assertThat;","+","+import java.util.Map;","+import java.util.UUID;","+","+import jakarta.inject.Inject;","+","+import org.junit.jupiter.api.Test;","+","+import io.quarkus.redis.client.RedisClientName;","+import io.quarkus.redis.datasource.RedisDataSource;","+import io.quarkus.test.junit.QuarkusTest;","+import io.quarkus.test.junit.QuarkusTestProfile;","+import io.quarkus.test.junit.TestProfile;","+","+/**","+ * {@code quarkus.http.rate-limit.redis.client-name} selects the Redis client of the {@code redis} store. JVM only: it","+ * injects the data sources.","+ */","+@QuarkusTest","+@TestProfile(RedisNamedClientTest.NamedClient.class)","+public class RedisNamedClientTest {","+","+    @Inject","+    RedisDataSource redis;","+","+    @Inject","+    @RedisClientName(\"limits\")","+    RedisDataSource limits;","+","+    @Test","+    void storeUsesTheNamedClient() {","+        String client = UUID.randomUUID().toString();","+        get(\"/api/hello\", client).then().statusCode(200);","+","+        String key = RedisRateLimitInspectionTest.apiKey(client);","+        assertThat(limits.execute(\"EXISTS\", key).toLong()).isEqualTo(1);","+        assertThat(redis.execute(\"EXISTS\", key).toLong()).isZero();","+    }","+","+    public static class NamedClient implements QuarkusTestProfile {","+","+        @Override","+        public Map<String, String> getConfigOverrides() {","+            return Map.of(\"quarkus.http.rate-limit.redis.client-name\", \"limits\");","+        }","+    }","+}"],"additions":51,"deletions":0,"truncated":false},{"path":"integration-tests/http-rate-limit-redis/src/test/java/io/quarkus/it/ratelimit/RedisRateLimitHttpTest.java","lines":["@@ -0,0 +1,106 @@","+package io.quarkus.it.ratelimit;","+","+import static io.restassured.RestAssured.given;","+import static org.assertj.core.api.Assertions.assertThat;","+import static org.hamcrest.Matchers.emptyOrNullString;","+","+import java.util.ArrayList;","+import java.util.List;","+import java.util.UUID;","+import java.util.concurrent.Callable;","+import java.util.concurrent.ExecutorService;","+import java.util.concurrent.Executors;","+import java.util.concurrent.Future;","+","+import org.junit.jupiter.api.Test;","+","+import io.quarkus.test.junit.QuarkusTest;","+import io.restassured.response.Response;","+","+/**","+ * Black-box HTTP assertions only: {@link RedisRateLimitIT} runs them against the native executable.","+ */","+@QuarkusTest","+public class RedisRateLimitHttpTest {","+","+    @Test","+    void fourthRequestIsRejected() {","+        String client = \"c1-\" + UUID.randomUUID();","+        for (int i = 0; i < 3; i++) {","+            get(\"/api/hello\", client).then().statusCode(200);","+        }","+        Response rejected = get(\"/api/hello\", client);","+        assertThat(rejected.statusCode()).isEqualTo(429);","+        assertThat(Long.parseLong(rejected.header(\"Retry-After\"))).isBetween(1L, 20L);","+    }","+","+    @Test","+    void concurrentConsumersShareOneBucket() throws Exception {","+        // a cold first call (pool setup, NOSCRIPT then EVAL) can exceed the store timeout and fail closed with a 503:","+        // warm up on a throwaway key, whatever its status, before the burst","+        get(\"/api/hello\", \"warm-up-\" + UUID.randomUUID());","+        String client = \"c2-\" + UUID.randomUUID();","+        ExecutorService executor = Executors.newFixedThreadPool(20);","+        try {","+            List<Callable<Integer>> calls = new ArrayList<>();","+            for (int i = 0; i < 20; i++) {","+                calls.add(() -> get(\"/api/hello\", client).statusCode());","+            }","+            List<Integer> statuses = new ArrayList<>();","+            for (Future<Integer> future : executor.invokeAll(calls)) {","+                statuses.add(future.get());","+            }","+            assertThat(statuses).filteredOn(s -> s == 200).hasSize(3);","+            assertThat(statuses).filteredOn(s -> s == 429).hasSize(17);","+        } finally {","+            executor.shutdownNow();","+        }","+    }","+","+    @Test","+    void otherClientIsIndependent() {","+        String exhausted = \"c3-\" + UUID.randomUUID();","+        for (int i = 0; i < 3; i++) {","+            get(\"/api/hello\", exhausted).then().statusCode(200);","+        }","+        get(\"/api/hello\", exhausted).then().statusCode(429);","+        get(\"/api/hello\", \"c4-\" + UUID.randomUUID()).then().statusCode(200);","+    }","+","+    @Test","+    void namedSubscriptionsKeepSeparateCountersWithAndWithoutLeases() {","+        for (String path : List.of(\"/subscription/hello\", \"/subscription-lease/hello\")) {","+            get(path, \"warm-up-\" + UUID.randomUUID());","+            assertSubscription(path, \"free-\" + UUID.randomUUID(), 2);","+            assertSubscription(path, \"paid-\" + UUID.randomUUID(), 4);","+            assertSubscription(path, \"paid-\" + UUID.randomUUID(), 4);","+        }","+    }","+","+    @Test","+    void unavailableResolversAndStoresUseProblemResponses() {","+        for (String path : List.of(\"/subscription/hello\", \"/subscription-lease/hello\", \"/unavailable-key/x\",","+                \"/unavailable-store/x\", \"/unavailable-lease/x\")) {","+            Response response = given().accept(\"application/problem+json\")","+                    .header(\"X-Client\", \"unavailable-\" + UUID.randomUUID()).get(path);","+            assertThat(response.statusCode()).as(path).isEqualTo(503);","+            assertThat(response.contentType()).isEqualTo(\"application/problem+json\");","+            assertThat(response.jsonPath().getInt(\"status\")).isEqualTo(503);","+            assertThat(response.jsonPath().getString(\"title\")).isEqualTo(\"Service Unavailable\");","+            assertThat(Long.parseLong(response.header(\"Retry-After\"))).isPositive();","+            given().header(\"X-Client\", \"unavailable-\" + UUID.randomUUID()).head(path).then().statusCode(503)","+                    .body(emptyOrNullString());","+        }","+    }","+","+    private static void assertSubscription(String path, String client, int permits) {","+        for (int i = 0; i < permits; i++) {","+            get(path, client).then().statusCode(200);","+        }","+        get(path, client).then().statusCode(429);","+    }","+","+    static Response get(String path, String client) {","+        return given().header(\"X-Client\", client).get(path);","+    }","+}"],"additions":106,"deletions":0,"truncated":false},{"path":"integration-tests/http-rate-limit-redis/src/test/java/io/quarkus/it/ratelimit/RedisRateLimitIT.java","lines":["@@ -0,0 +1,7 @@","+package io.quarkus.it.ratelimit;","+","+import io.quarkus.test.junit.QuarkusIntegrationTest;","+","+@QuarkusIntegrationTest","+public class RedisRateLimitIT extends RedisRateLimitHttpTest {","+}"],"additions":7,"deletions":0,"truncated":false},{"path":"integration-tests/http-rate-limit-redis/src/test/java/io/quarkus/it/ratelimit/RedisRateLimitInspectionTest.java","lines":["@@ -0,0 +1