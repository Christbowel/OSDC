      (\"0\", \"0\", \"\"),","+        (\"1\", \"0\", \"\"),","+        (\"1\", \"1\", \"\"),","+        (\"1\", \"1\", \"HierarchicalGroupingSetsToUnion\"),","+    ] {","+        let ctx = fixture.new_query_ctx().await?;","+        for (name, value) in [","+            (\"grouping_sets_to_union\", union),","+            (\"enable_cascading_grouping_sets\", cascade),","+            (\"optimizer_skip_list\", skip),","+        ] {","+            ctx.get_settings()","+                .set_setting(name.to_string(), value.to_string())?;","+        }","+        let sql = \"WITH c AS (","+            SELECT a, b, sum(v) AS s","+            FROM (VALUES (1, 2, 3), (1, 3, 4)) t(a, b, v)","+            GROUP BY ROLLUP(a, b)","+        )","+        SELECT a, sum(s), grouping(a) FROM c GROUP BY ROLLUP(a)\";","+        let (plan, _) = Planner::new(ctx.clone()).plan_sql(sql).await?;","+        let Plan::Query {","+            s_expr,","+            metadata,","+            bind_context,","+            ..","+        } = plan","+        else {","+            unreachable!(\"expected a query plan\");","+        };","+        let plan = PhysicalPlanBuilder::new(metadata, ctx, false)","+            .build_query(s_expr.planned()?, bind_context.column_set())","+            .await?;","+        let mut producer_schemas = HashMap::new();","+        collect_producer_schemas(&plan, &mut producer_schemas)?;","+        assert_consistent_outputs(&plan, &producer_schemas)?;","+    }","+    Ok(())","+}","+","+fn collect_producer_schemas(","+    plan: &PhysicalPlan,","+    schemas: &mut HashMap<String, DataSchemaRef>,","+) -> Result<()> {","+    if let Some(producer) = plan.as_any().downcast_ref::<MaterializedCTE>() {","+        schemas.insert(producer.cte_name.clone(), producer.input.output_schema()?);","+    }","+    for child in plan.children() {","+        collect_producer_schemas(child, schemas)?;","+    }","+    Ok(())","+}","+","+fn assert_consistent_outputs(","+    plan: &PhysicalPlan,","+    producer_schemas: &HashMap<String, DataSchemaRef>,","+) -> Result<()> {","+    if plan.as_any().is::<EvalScalar>() {","+        let schema = plan.output_schema()?;","+        let mut names = HashSet::new();","+        for field in schema.fields() {","+            assert!(","+                names.insert(field.name()),","+                \"EvalScalar must replace an existing symbol, not project it twice: {schema:?}\"","+            );","+        }","+    }","+    if let Some(consumer) = plan.as_any().downcast_ref::<MaterializeCTERef>() {","+        // Grouping-set consumers use identity column mappings. Their schema must","+        // reflect the producer's nullable projections, not the base-table metadata.","+        let producer = &producer_schemas[&consumer.cte_name];","+        for field in consumer.cte_schema.fields() {","+            assert_eq!(","+                field.data_type(),","+                producer.field_with_name(field.name())?.data_type(),","+                \"CTE consumer type differs from its producer: {}\",","+                consumer.cte_name","+            );","+        }","+    }","+    for child in plan.children() {","+        assert_consistent_outputs(child, producer_schemas)?;","+    }","+    Ok(())","+}"],"additions":118,"deletions":0,"truncated":false},{"path":"src/query/service/tests/it/sql/exec/mod.rs","lines":["@@ -265,6 +265,7 @@ pub async fn test_snapshot_consistency() -> anyhow::Result<()> {"," mod alter_modify_column;"," mod correlated_subquery_regression;"," mod get_table_bind_test;","+mod grouping_sets;"," mod insert;"," mod multi_table_insert;"," mod range_join;"],"additions":1,"deletions":0,"truncated":false},{"path":"src/query/sql/src/planner/optimizer/optimizers/rule/agg_rules/grouping_sets_common.rs","lines":["@@ -21,6 +21,22 @@ use crate::plans::BoundColumnRef;"," use crate::plans::EvalScalar;"," use crate::plans::ScalarItem;"," ","+/// Bit `i` identifies an absent grouping key in group-item order, not an input","+/// column position. Set only absent bits so all 32 bits of `_grouping_id` fit","+/// without constructing an overflowing `(1 << 32) - 1` mask.","+pub(super) fn grouping_id(","+    group_items: &[ScalarItem],","+    grouping_id_index: Symbol,","+    set: &[Symbol],","+) -> u32 {","+    group_items","+        .iter()","+        .filter(|item| !is_grouping_id_item(item, grouping_id_index))","+        .enumerate()","+        .filter(|(_, item)| !set.contains(&item.index))","+        .fold(0, |id, (i, _)| id | (1 << i))","+}","+"," pub(super) fn ensure_group_items_are_projected(","     eval_scalar: &mut EvalScalar,","     agg: &Aggregate,"],"additions":16,"deletions":0,"truncated":false},{"path":"src/query/sql/src/planner/optimizer/optimizers/rule/agg_rules/rule_grouping_sets_to_union.rs","lines":["@@ -22,6 +22,7 @@ use databend_common_expression::Scalar;"," use databend_common_expression::types::NumberScalar;"," "," use super::grouping_sets_common::ensure_group_items_are_projected;","+use super::grouping_sets_common::grouping_id;"," use super::grouping_sets_common::union_output_indexes;"," use crate::ScalarExpr;"," use crate::Symbol;","@@ -162,34 +163,9 @@ impl Rule for RuleGroupingSetsToUnion {","                     stat_info: None,","                 });"," ","-                let mask = (1 << grouping_sets.dup_group_items.len()) - 1;","-                let group_bys = agg","-                    .group_items","-                    .iter()","-                    .filter(|item| !is_grouping_id_item(item, grouping_sets.grouping_id_index))","-                    .map(|i| {","-                        agg_input_columns","-                            .iter()","-                            .position(|t| *t == i.index)","-                            .unwrap()","-                    })","-                    .collect::<Vec<_>>();","-","                 for set in &grouping_sets.sets {","-                    let mut id = 0;","-","-                    // For element in `group_bys`,