{"id":"d58c5b6def80e8abd57cbf6fa19ed51f504b9ad1","axis":"silent","repo":"nltk/nltk","sha":"d58c5b6def80e8abd57cbf6fa19ed51f504b9ad1","parsed":{"files":[{"path":"nltk/downloader.py","lines":["@@ -765,6 +765,23 @@ def _shared_install(download_dir):","     return not (target == home or target.startswith(home + os.sep))"," "," ","+def _canonical_dir(path):","+    \"\"\"*path* with its existing prefix resolved (symlinks and, on Windows, 8.3","+    aliases such as RUNNER~1) and any missing tail kept as written. The names","+    the downloader derives under it (the install lock, the .tmp file) are","+    removed through pathsec, whose syntax guard refuses an 8.3 alias, so they","+    are derived from the canonical form; only the existing prefix is resolved","+    because realpath of a missing path is unstable on Windows.\"\"\"","+    head = os.path.abspath(path)","+    tail = []","+    while not os.path.lexists(head):","+        parent, name = os.path.split(head)","+        if parent == head:","+            break","+        head, tail = parent, [name] + tail","+    return os.path.join(os.path.realpath(head), *tail)","+","+"," def _make_install_dirs(download_dir, subdir):","     \"\"\"Create *download_dir* and *subdir* under it, each missing level without","     a group or world write bit whatever the umask, and return the first of","@@ -1098,6 +1115,7 @@ def _download_list(self, items, download_dir, force, _expanding=(), extract=None","             progress += 100 * delta"," ","     def _download_package(self, info, download_dir, force, extract=None):","+        download_dir = _canonical_dir(download_dir)","         if extract is None:","             extract = _shared_install(download_dir)","         yield StartPackageMessage(info)"],"additions":18,"deletions":0,"truncated":false},{"path":"nltk/pathsec.py","lines":["@@ -2572,13 +2572,11 @@ def _checked_path_text(value, context):","     two-faced path object (``.path`` naming one file, ``__fspath__`` another)","     is refused as :func:`validate_path` refuses it, and a non-path or bytes","     value is handled as :func:`_as_path_text` handles it. ``__fspath__`` is","-    read exactly once.","-","-    The helpers then refuse exactly what :func:`open` refuses (containment","-    by :func:`validate_path`, links and special files by inode), and no more:","-    the tool-path syntax guard is not applied, since a name NLTK derived","-    itself (a lock or scratch file under a Windows temp dir, whose path","-    carries an 8.3 component) must stay removable by the code that made it.","+    read exactly once. The helpers then apply the tool-path syntax guard and","+    :func:`validate_path`, so a caller must hand them a canonical name: one","+    NLTK derived under a Windows temp dir can carry an 8.3 alias (RUNNER~1),","+    which the guard refuses, so the deriving code resolves its directory","+    first (see ``nltk.downloader._canonical_dir``).","     \"\"\"","     if not isinstance(value, (str, bytes)) and hasattr(value, \"__fspath__\"):","         return _as_path_text(","@@ -2620,6 +2618,7 @@ def validate_private_dir(directory, context=\"pathsec.validate_private_dir\"):","     (CWE-367). POSIX only; the per-user profile stands in on Windows.","     \"\"\"","     text = _checked_path_text(directory, context)","+    _reject_bad_name_syntax(text, context, error=PermissionError)","     validate_path(text, context=context)","     if os.name != \"posix\":","         return os.path.realpath(text)","@@ -2673,6 +2672,7 @@ def unlink(path, context=\"pathsec.unlink\"):","     \"\"\"Remove the name *path* inside an allowed root without following it: a","     link is removed as a link, a directory is refused, a missing name is fine.\"\"\"","     text = _checked_path_text(path, context)","+    _reject_bad_name_syntax(text, context, error=PermissionError)","     validate_path(os.path.dirname(os.path.abspath(text)) or os.curdir, context=context)","     try:","         st = os.lstat(text)","@@ -2693,7 +2693,9 @@ def replace(src, dst, context=\"pathsec.replace\"):","     must be a single-linked regular file, and *dst* is checked by inode after.","     \"\"\"","     s_text = _checked_path_text(src, context)","+    _reject_bad_name_syntax(s_text, context, error=PermissionError)","     d_text = _checked_path_text(dst, context)","+    _reject_bad_name_syntax(d_text, context, error=PermissionError)","     validate_path(s_text, context=context)","     validate_path(","         os.path.dirname(os.path.abspath(d_text)) or os.curdir, context=context","@@ -2728,6 +2730,7 @@ def remove_tree(path, context=\"pathsec.remove_tree\", ignore_errors=False):","     swallowed, the security refusals above never are.","     \"\"\"","     text = _checked_path_text(path, context)","+    _reject_bad_name_syntax(text, context, error=PermissionError)","     validate_path(text, context=context)","     st = os.lstat(text)","     if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):","@@ -2762,6 +2765,7 @@ def ensure_private_dir(path, mode=0o700, context=\"pathsec.ensure_private_dir\"):","     output a caller names, where :func:`make_private_dir` (an unpredictable","     name) does not apply. Returns the resolved path.\"\"\"","     text = _checked_path_text(path, context)","+    _reject_bad_name_syntax(text, context, error=PermissionError)","     validate_path(text, context=context)","     if not os.path.isdir(text):","         try:"],"additions":11,"deletions":7,"truncated":false},{"path":"nltk/test/unit/test_pathsec_routing.py","lines":["@@ -356,22 +356,95 @@ def test_tool_wrappers_remove_scratch_through_pathsec(module, function):"," # =========================================================================== #"," "," ","-def test_helpers_accept_every_name_pathsec_open_accepts(pathsec_sandbox):","-    \"\"\"A name NLTK derived itself can carry a leading dash or a tilde, and on","-    a Windows runner an 8.3 component (RUNNER~1); the tool-path syntax guard","-    refuses those, pathsec.open does not, and the contained operations must","-    side with open, or the downloader could create a lock it cannot remove.\"\"\"","+def test_helpers_refuse_what_the_tool_path_guard_refuses(pathsec_sandbox):","+    \"\"\"The contained operations apply the same syntax guard as the tool-path","+    checks: a name ending in a dot (which Windows silently strips, so it is","+    checked as one name and opened as another) is refused by every one of","+    them on every platform, so the guard is not relaxed for NLTK's own","+    operations.\"\"\"","     root, outside = pathsec_sandbox","-    odd = root / \"x~1\" / \"-dash\"","-    odd.mkdir(parents=True)","-    target = odd / \"~tilde.txt\"","-    with pathsec.open(str(target), \"w\", context=\"test\") as handle:","-        handle.write(\"x\")","-    pathsec.ensure_private_dir(str(odd), context=\"test\")","-    pathsec.replace(str(target), str(odd / \"-moved.txt\"), context=\"test\")","-    pathsec.unlink(str(odd / \"-moved.txt\"), context=\"test\")","-    pathsec.remove_tree(str(root / \"x~1\"), context=\"test\")","-    assert not (root / \"x~1\").exists()","+    inside = root / \"dir\"","+    inside.mkdir()","+    (inside / \"f.txt\").write_text(\"x\")","+    stripped = str(root / \"name.\")","+    for call in (","+        lambda: pathsec.unlink(stripped, context=\"test\"),","+        lambda: pathsec.remove_tree(stripped, context=\"test\"),","+        lambda: pathsec.ensure_private_dir(stripped, context=\"test\"),","+        lambda: pathsec.validate_private_dir(stripped, context=\"test\"),","+        lambda: pathsec.replace(str(inside / \"f.txt\"), stripped, context=\"test\"),","+        lambda: pathsec.replace(stripped, str(inside / \"g.txt\"), context=\"test\"),","+    ):","+        with pytest.raises(PermissionError, match=\"ends with a dot or space\"):","+            call()","+    assert (inside / \"f.txt\").read_text() == \"x\" and not os.path.lexists(stripped)","+","+","+def test_downloader_derives_its_names_from_the_canonical_download_dir(tmp_path):","+    \"\"\"The install lock and .tmp names are derived from the resolved download","+    dir (a symlink here, an 8.3 alias such as RUNNER~1 on a Windows runner),","+    so the syntax guard in pathsec.unlink accepts what the downloader made.\"\"\"","+    import hashlib","+    import unittest.mock","+","+    from nltk.downloader import Downloader, _canonical_dir","+","+    real = tmp_path / \"real\"","+    real.mkdir()","+    alias = tmp_path / \"alias\"","+    os.symlink(str(real), str(alias))","+    assert _canonical_dir(str(alias)) == os.path.realpath(str(real))","+    missing = str(alias / \"not\" / \"yet\")","+    assert _canonical_dir(missing) == os.path.join(","+        os.path.realpath(str(real)), \"not\", \"yet\"","+    )","+","+    class DummyInfo:","+        id = \"dummy\"","+        url = \"https://example.com/dummy.txt\"","+        size = 1","+        filename = os.path.join(\"corpora\", \"dummy.txt\")","+        subdir = \"corpora\"","+        unzip = False","+        sha256_checksum = hashlib.sha256(b\"x\").hexdigest()","+        checksum = hashlib.md5(b\"x\").hexdigest()","+","+    canonical = os.path.realpath(str(real))","+    with unittest.mock.patch(","+        \"nltk.downloader.urlopen\"","+    ) as urlopen_mock, unittest.mock.patch(","+        \"nltk.downloader.pathsec_open\"","+    ) as pathsec_open_mock, unittest.mock.patch(","+        \"nltk.downloader.sha256_hexdigest\", return_value=DummyInfo.sha256_checksum","+    ), unittest.mock.patch(","+        \"nltk.downloader.md5_hexdigest\", return_value=DummyInfo.checksum","+    ), unittest.mock.patch(","+        \"nltk.downloader.os.path.getsize\", return_value=1","+    ), unittest.mock.patch(","+        \"nltk.downloader.pathsec.replace\"","+    ) as replace_mock, unittest.mock.patch.object(","+        Downloader, \"status\", return_value=Downloader.NOT_INSTALLED","+    ):","+        infile = unittest.mock.Mock()","+        infile.read.side_effect = [b\"x\", b\"\"]","+        urlopen_mock.return_value = infile","+        outfile = unittest.mock.Mock()","+        pathsec_open_mock.return_value.__enter__.return_value = outfile","+        pathsec_open_mock.return_value.__exit__.return_value = False","+        list(","+            Downloader(download_dir=str(alias))._download_package(","+                DummyInfo(), str(alias), force=True","+            )","+        )","+    tmp_file = os.path.join(canonical, \"corpora\", \"dummy.txt.tmp\")","+    final_file = os.path.join(canonical, \"corpora\", \"dummy.txt\")","+    pathsec_open_mock.assert_called_once_with(","+        tmp_file, \"wb\", context=\"Downloader._download_package\", required_root=canonical","+    )","+    replace_mock.assert_called_once_with(","+        tmp_file, final_file, context=\"Downloader._download_package\"","+    )","+    assert not os.path.lexists(os.path.join(canonical, \"corpora\", \"dummy.txt.lock\"))"," "," "," def test_downloader_reports_a_stale_lock_it_cannot_remove(tmp_path, monkeypatch):",""],"additions":88,"deletions":15,"truncated":false}],"additions":117,"deletions":22,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-10-13T15:28:07.173119+00:00"}