tion: &envoyroute.RouteAction_MaxStreamDuration{","+\t\t\t\t\t\t\tMaxStreamDuration:    route.Notimeout,","+\t\t\t\t\t\t\tGrpcTimeoutHeaderMax: route.Notimeout,","+\t\t\t\t\t\t},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t\tDecorator: &envoyroute.Decorator{","+\t\t\t\t\tOperation: \"operation\",","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t\t{","+\t\t\tname:     \"grpc protocol ignores mesh wide inbound retry policy\",","+\t\t\tprotocol: protocol.GRPC,","+\t\t\tmesh: &meshconfig.MeshConfig{","+\t\t\t\tDefaultInboundHttpRetryPolicy: &networking.HTTPRetry{Attempts: 5},","+\t\t\t},","+\t\t\texpected: &envoyroute.Route{","+\t\t\t\tName:  \"default\",","+\t\t\t\tMatch: route.TranslateRouteMatch(config.Config{}, nil),","+\t\t\t\tAction: &envoyroute.Route_Route{","+\t\t\t\t\tRoute: &envoyroute.RouteAction{","+\t\t\t\t\t\tClusterSpecifier: &envoyroute.RouteAction_Cluster{Cluster: \"cluster\"},","+\t\t\t\t\t\tTimeout:          route.Notimeout,","+\t\t\t\t\t\tMaxStreamDuration: &envoyroute.RouteAction_MaxStreamDuration{","+\t\t\t\t\t\t\tMaxStreamDuration:    route.Notimeout,","+\t\t\t\t\t\t\tGrpcTimeoutHeaderMax: route.Notimeout,","+\t\t\t\t\t\t},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t\tDecorator: &envoyroute.Decorator{","+\t\t\t\t\tOperation: \"operation\",","+\t\t\t\t},","+\t\t\t},","+\t\t},"," \t}"," \tfor _, tc := range testCases {"," \t\tt.Run(tc.name, func(t *testing.T) {","-\t\t\tinroute := route.BuildDefaultHTTPInboundRoute(&model.Proxy{IstioVersion: &model.IstioVersion{Major: 1, Minor: 24, Patch: -1}},","-\t\t\t\t\"cluster\", \"operation\", tc.protocol)","+\t\t\tinroute := route.BuildDefaultHTTPInboundRoute(\"cluster\", \"operation\", tc.protocol, tc.mesh)"," \t\t\tif !reflect.DeepEqual(tc.expected, inroute) {"," \t\t\t\tt.Errorf(\"error in inbound routes. Got: %v, Want: %v\", inroute, tc.expected)"," \t\t\t}"],"additions":89,"deletions":2,"truncated":false},{"path":"pkg/config/validation/agent/validation.go","lines":["@@ -18,6 +18,7 @@ import ("," \t\"errors\""," \t\"fmt\""," \t\"net\"","+\tnethttp \"net/http\""," \t\"net/netip\""," \t\"regexp\""," \t\"strconv\"","@@ -935,6 +936,97 @@ func validatePercent(val int32) error {"," \treturn nil"," }"," ","+// envoy supported retry on header values","+var supportedRetryOnPolicies = sets.New(","+\t// 'x-envoy-retry-on' supported policies:","+\t// https://www.envoyproxy.io/docs/envoy/latest/configuration/http/http_filters/router_filter.html#x-envoy-retry-on","+\t\"5xx\",","+\t\"gateway-error\",","+\t\"reset\",","+\t\"reset-before-request\",","+\t\"connect-failure\",","+\t\"retriable-4xx\",","+\t\"refused-stream\",","+\t\"retriable-status-codes\",","+\t\"retriable-headers\",","+\t\"envoy-ratelimited\",","+\t\"http3-post-connect-failure\",","+","+\t// 'x-envoy-retry-grpc-on' supported policies:","+\t// https://www.envoyproxy.io/docs/envoy/latest/configuration/http/http_filters/router_filter#x-envoy-retry-grpc-on","+\t\"cancelled\",","+\t\"deadline-exceeded\",","+\t\"internal\",","+\t\"resource-exhausted\",","+\t\"unavailable\",","+)","+","+// ValidateHTTPRetry checks that an HTTP retry policy is well-formed. It is shared by the","+// VirtualService retry policy and the mesh-wide default retry policies, which reuse the same type.","+func ValidateHTTPRetry(retries *networking.HTTPRetry) (errs error) {","+\tif retries == nil {","+\t\treturn errs","+\t}","+","+\tif retries.Attempts < 0 {","+\t\terrs = multierror.Append(errs, errors.New(\"attempts cannot be negative\"))","+\t}","+","+\tif retries.Attempts == 0 && (retries.PerTryTimeout != nil || retries.RetryOn != \"\" || retries.RetryRemoteLocalities != nil) {","+\t\terrs = AppendErrors(errs, errors.New(\"http retry policy configured when attempts are set to 0 (disabled)\"))","+\t}","+","+\tif retries.PerTryTimeout != nil {","+\t\terrs = AppendErrors(errs, ValidateDuration(retries.PerTryTimeout))","+\t}","+\tif retries.RetryOn != \"\" {","+\t\tretryOnPolicies := strings.Split(retries.RetryOn, \",\")","+\t\tfor _, policy := range retryOnPolicies {","+\t\t\t// Try converting it to an integer to see if it's a valid HTTP status code.","+\t\t\ti, _ := strconv.Atoi(policy)","+","+\t\t\tif nethttp.StatusText(i) == \"\" && !supportedRetryOnPolicies.Contains(policy) {","+\t\t\t\terrs = AppendErrors(errs, fmt.Errorf(\"%q is not a valid retryOn policy\", policy))","+\t\t\t}","+\t\t}","+\t}","+\tif retries.Backoff != nil {","+\t\terrs = AppendErrors(errs, ValidateDuration(retries.Backoff))","+\t}","+","+\treturn errs","+}","+","+// validateMeshConfigDefaultInboundHTTPRetryPolicy validates the mesh-wide default retry policy","+// applied to inbound routes on sidecars. Only `attempts`, `retryOn` and `backoff` are honored","+// there: an inbound route always targets the single local application cluster, so the per-try","+// timeout and host selection settings are meaningless and silently ignored.","+func validateMeshConfigDefaultInboundHTTPRetryPolicy(retry *networking.HTTPRetry) (v Validation) {","+\tif retry == nil {","+\t\treturn v","+\t}","+\tv = AppendValidation(v, multierror.Prefix(ValidateHTTPRetry(retry), \"invalid default inbound http retry policy:\"))","+","+\t// `attempts: 0` disables the policy mesh-wide, so configuring anything else alongside it is","+\t// contradictory. ValidateHTTPRetry already covers the other fields, but not backoff, which","+\t// does apply to inbound routes.","+\tif retry.Attempts == 0 && retry.Backoff != nil {","+\t\tv = AppendValidation(v, errors.New(\"invalid default inbound http retry policy: \"+","+\t\t\t\"backoff configured when attempts are set to 0 (disabled)\"))","+\t}","+","+\tif retry.PerTryTimeout != nil {","+\t\tv = AppendWarningf(v, \"perTryTimeout is ignored by the default inbound http retry policy\")","+\t}","+\tif retry.RetryRemoteLocalities != nil {","+\t\tv = AppendWarningf(v, \"retryRemoteLocalities is ignored by the default inbound http retry policy\")","+\t}","+\tif retry.RetryIgnorePreviousHosts != nil {","+\t\tv = AppendWarningf(v, \"retryIgnorePreviousHosts is ig