te handler that copies such a body onto","+ * another object (`Object.assign()`, a deep merge) would change that","+ * object's prototype. multer has no hook to refuse a field name before it","+ * appends it, so the body is checked once multer is done, and the files","+ * multer stored for the request are removed first.","+ */","+export async function rejectPrototypePoisoning(","+  storage: any,","+  req: any,","+): Promise<void> {","+  const body = req?.body;","+  // multer gives a multipart request a body without a prototype, and leaves","+  // any other body (checked by its own parser) alone.","+  if (","+    typeof body !== 'object' ||","+    body === null ||","+    Object.getPrototypeOf(body) ||","+    !hasPrototypeKey(body)","+  ) {","+    return;","+  }","+  await removeStoredFiles(storage, req);","+  throw new BadRequestException(multerExceptions.INVALID_FIELD_NAME);","+}","+","+/**","+ * Whether the store holds a `__proto__` key, or a `constructor` one whose","+ * value has a `prototype` key, at any depth: the two shapes that set a","+ * prototype when the body is copied onto another object, as","+ * `Object.assign()` copies an own `__proto__` key through the setter of","+ * `Object.prototype`. The same shapes fail for platform-node, which scans","+ * with `secure-json-parse`.","+ */","+function hasPrototypeKey(store: object): boolean {","+  // Not recursive, as `fieldNestingDepth` may be lifted.","+  const pending: object[] = [store];","+  while (pending.length > 0) {","+    const container = pending.pop()! as any;","+    if (Object.prototype.hasOwnProperty.call(container, '__proto__')) {","+      return true;","+    }","+    if (","+      Object.prototype.hasOwnProperty.call(container, 'constructor') &&","+      typeof container.constructor === 'object' &&","+      container.constructor !== null &&","+      Object.prototype.hasOwnProperty.call(container.constructor, 'prototype')","+    ) {","+      return true;","+    }","+    // The values rather than the indexes up to `length`, so that the work","+    // depends on the number of values: `fieldArrayIndexLimit` may be lifted.","+    for (const value of Object.values(container)) {","+      if (typeof value === 'object' && value !== null) {","+        pending.push(value as object);","+      }","+    }","+  }","+  return false;","+}","+","+function removeStoredFiles(storage: any, req: any): Promise<void> {","+  return Promise.all(","+    storedFiles(req).map(","+      file =>","+        new Promise<void>(resolve => {","+          try {","+            storage._removeFile(req, file, () => resolve());","+          } catch {","+            // The request fails anyway.","+            resolve();","+          }","+        }),","+    ),","+  ).then(() => undefined);","+}","+"," function onResponseFinished(res: any, callback: () => void): () => void {","   // A stand-in for a response (e.g. in a unit test) is not watched.","   if (typeof res?.on !== 'function') {"],"additions":80,"deletions":0,"truncated":false},{"path":"packages/platform-express/test/multer/interceptors/no-files.interceptor.spec.ts","lines":["@@ -1,4 +1,5 @@","-import { CallHandler } from '@nestjs/common';","+import { BadRequestException, CallHandler } from '@nestjs/common';","+import multer from 'multer';"," import { ExecutionContextHost } from '@nestjs/core/helpers/execution-context-host.js';"," import { of } from 'rxjs';"," import { NoFilesInterceptor } from '../../../multer/interceptors/no-files.interceptor.js';","@@ -27,6 +28,21 @@ describe('NoFilesInterceptor', () => {"," ","       expect(noneSpy).toHaveBeenCalled();","     });","+    it('should reject a body with a __proto__ key', async () => {","+      const target = new (NoFilesInterceptor())();","+      (target as any).multer = {","+        none: () => (req, _res, next) => {","+          req.body = Object.create(null);","+          req.body.__proto__ = { isAdmin: 'true' };","+          next();","+        },","+        storage: multer.memoryStorage(),","+      };","+      const req: any = {};","+      await expect(","+        target.intercept(new ExecutionContextHost([req, {}]), handler),","+      ).rejects.toBeInstanceOf(BadRequestException);","+    });","     it('should transform exception', async () => {","       const target = new (NoFilesInterceptor())();","       const err = {};"],"additions":17,"deletions":1,"truncated":false},{"path":"packages/platform-express/test/multer/multer/multer.utils.spec.ts","lines":["@@ -14,6 +14,7 @@ import {","   applyDefaultLimits,","   closeArrayGaps,","   mergeMulterOptions,","+  rejectPrototypePoisoning,","   removeFilesOnPipeRejection,","   runMulter,","   transformException,","@@ -500,6 +501,83 @@ describe('runMulter', () => {","   });"," });"," ","+describe('rejectPrototypePoisoning', () => {","+  /** Parses a body with the given text fields and one file, with multer. */","+  const parse = async (","+    fieldNames: string[],","+    storage = multer.memoryStorage(),","+  ) => {","+    const boundary = 'nestjs';","+    const body =","+      fieldNames","+        .map(","+          name =>","+            `--${boundary}\\r\\n` +","+            `Content-Disposition: form-data; name=\"${name}\"\\r\\n\\r\\n` +","+            `x\\r\\n`,","+        )","+        .join('') +","+      `--${boundary}\\r\\n` +","+      `Content-Disposition: form-data; name=\"f\"; filename=\"a.txt\"\\r\\n` +","+      `Content-Type: text/plain\\r\\n\\r\\n` +","+      `data\\r\\n` +","+      `--${boundary}--\\r\\n`;","+    const req: any = Object.assign(Readable.from([Buffer.from(body)]), {","+      headers: {","+        'content-type': `multipart/form-data; boundary=${boundary}`,","+        'content-length': String(Buffer.byteLength(body)),","+      },","+    });","+    const instance = multer(applyDefaultLimits({ storage }));","+    await runMulter(instance.single('f'), req, {});","+    await rejectPrototypePoisoning(instance.storage, req);","+    return req;","+  };","+","+  it('should fail a body 