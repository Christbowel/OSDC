template %q: %w\", sqlSecureValueLeaseInactive.Name(), err)","+\t}","+","+\tres, err := s.db.ExecContext(ctx, q, req.GetArgs()...)","+\tif err != nil {","+\t\treturn 0, fmt.Errorf(\"leasing inactive secure values: %w\", err)","+\t}","+","+\taffected, err := res.RowsAffected()","+\tif err != nil {","+\t\treturn 0, fmt.Errorf(\"getting rows affected: %w\", err)","+\t}","+","+\treturn affected, nil","+}","+","+func (s *secureValueMetadataStorage) listLeaseCandidates(ctx context.Context, maxBatchSize uint16, now int64) ([]string, error) {","+\treq := listLeaseInactiveCandidates{"," \t\tSQLTemplate:  sqltemplate.New(s.dialect),","-\t\tLeaseToken:   leaseToken,"," \t\tMaxBatchSize: maxBatchSize,"," \t\tMinAge:       int64((10 * time.Minute).Seconds()),","-\t\tLeaseTTL:     int64((5 * time.Minute).Seconds()),","-\t\tNow:          s.clock.Now().UTC().Unix(),","+\t\tNow:          now,"," \t}"," ","-\tq, err := sqltemplate.Execute(sqlSecureValueLeaseInactive, req)","+\tq, err := sqltemplate.Execute(sqlSecureValueLeaseInactiveCandidates, req)"," \tif err != nil {","-\t\treturn fmt.Errorf(\"execute template %q: %w\", sqlSecureValueLeaseInactive.Name(), err)","+\t\treturn nil, fmt.Errorf(\"execute template %q: %w\", sqlSecureValueLeaseInactiveCandidates.Name(), err)"," \t}"," ","-\tif _, err := s.db.ExecContext(ctx, q, req.GetArgs()...); err != nil {","-\t\treturn fmt.Errorf(\"leasing inactive secure values: %w\", err)","+\trows, err := s.db.QueryContext(ctx, q, req.GetArgs()...)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"listing lease candidates: %w\", err)"," \t}","+\tdefer func() { _ = rows.Close() }()"," ","-\treturn nil","+\tcandidates := make([]string, 0, maxBatchSize)","+\tfor rows.Next() {","+\t\tvar guid string","+\t\tif err := rows.Scan(&guid); err != nil {","+\t\t\treturn nil, fmt.Errorf(\"reading lease candidate row: %w\", err)","+\t\t}","+\t\tcandidates = append(candidates, guid)","+\t}","+\tif err := rows.Err(); err != nil {","+\t\treturn nil, fmt.Errorf(