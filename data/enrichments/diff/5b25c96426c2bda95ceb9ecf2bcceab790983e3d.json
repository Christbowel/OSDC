","+","+\tt.Run(\"does not steal a lease acquired after candidate selection\", func(t *testing.T) {","+\t\tt.Parallel()","+","+\t\tsut := testutils.Setup(t)","+","+\t\t// Start with an eligible candidate, so an empty result cannot be explained","+\t\t// by the value being active or still within the GC grace period.","+\t\tuids := leasedUIDs(createInactiveSecureValues(t, sut, 1))","+","+\t\t// After SELECT has chosen the candidate, let another request lease it before","+\t\t// this request's UPDATE. This makes the selected candidate stale deterministically.","+\t\tvar leasedSv []secretv1beta1.SecureValue","+\t\tdb := &beforeExecDatabase{Database: sut.Database, beforeExec: func(ctx context.Context) {","+\t\t\tvar err error","+\t\t\tleasedSv, err = sut.SecureValueMetadataStorage.LeaseInactiveSecureValues(ctx, 1)","+\t\t\trequire.NoError(t, err)","+\t\t}}","+\t\tstorage, err := metadata.ProvideSecureValueMetadataStorage(sut.Clock, db, noop.NewTracerProvider().Tracer(\"test\"), nil)","+\t\trequire.NoError(t, err)","+","+\t\t// The UPDATE must recheck the lease and leave the other request's claim intact.","+\t\tvalues, err := storage.LeaseInactiveSecureValues(t.Context(), 1)","+\t\trequire.NoError(t, err)","+\t\trequire.Empty(t, values)","+","+\t\t// Confirm that the competing request actually acquired the expected candidate.","+\t\trequire.Equal(t, uids, leasedUIDs(leasedSv))","+\t})","+","+\tt.Run(\"does not lease a value activated after candidate selection\", func(t *testing.T) {","+\t\tt.Parallel()","+","+\t\tsut := testutils.Setup(t)","+","+\t\t// Deletion marks this version inactive; advancing past the grace period makes","+\t\t// it eligible for SELECT before the hook changes its state.","+\t\tsv := createInactiveSecureValues(t, sut, 1)[0]","+","+\t\t// Reactivate the selected candidate before UPDATE. The claim must use the","+\t\t// current active flag rather than trust the state observed by SELECT.","+\t\tdb := &beforeExecDatabase{Database: sut.Database, beforeExec: func(ctx context.Context) {","+\t\t\trequire.NoError(t, sut.SecureValueMetadataStorage.SetVersionToActive(ctx, xkube.Namespace(sv.Namespace), sv.Name, sv.Status.Version))","+\t\t}}","+\t\tstorage, err := metadata.ProvideSecureValueMetadataStorage(sut.Clock, db, noop.NewTracerProvider().Tracer(\"test\"), nil)","+\t\trequire.NoError(t, err)","+","+\t\t// The UPDATE must reject the now-active candidate, keeping it out of GC.","+\t\tvalues, err := storage.LeaseInactiveSecureValues(t.Context(), 1)","+\t\trequire.NoError(t, err)","+\t\trequire.Empty(t, values)","+","+\t\t// Read returns only active versions. Finding this UID confirms the rejected","+\t\t// candidate still exists as an active secret.","+\t\tactiveValue, err := sut.SecureValueMetadataStorage.Read(t.Context(), xkube.Namespace(sv.Namespace), sv.Name, contracts.ReadOpts{})","+\t\trequire.NoError(t, err)","+\t\trequire.Equal(t, sv.UID, activeValue.UID)","+\t})","+}","+","+// Lease acquisition calls QueryContext to select candidates, then ExecContext to claim them.","+// Running the callback before ExecContext changes the selected row before the claim,","+// reproducing a stale candidate list without relying on goroutine scheduling.","+type beforeExecDatabase struct {","+\tcontracts.Database","+\tbeforeExec func(ctx context.Context)","+}","+","+func (db *beforeExecDatabase) ExecContext(ctx context.Context, query string, args ...any) (sql.Result, error) {","+\tif db.beforeExec != nil {","+\t\tbeforeExec := db.beforeExec","+\t\t// Consume the hook first so a nested ExecContext cannot invoke it again.","+\t\tdb.beforeExec = nil","+\t\tbeforeExec(ctx)","+\t}","+\treturn db.Database.ExecContext(ctx, query, args...)","+}","+","+func createInactiveSecureValues(t *testing.T, sut testutils.Sut, n int) []secretv1beta1.SecureValue {","+\tt.Helper()","+","+\tvalues := make([]secretv1beta1.SecureValue, 0, n)","+\tfor i := range n {","+\t\tsv, err := sut.CreateSv(t.Context(), func(cfg *testutils.CreateSvConfig) {","+\t\t\tcfg.Sv.Name = fmt.Sprintf(\"sv-%d\", i)","+\t\t})","+\t\trequire.NoError(t, err)","+\t\t_, err = sut.DeleteSv(t.Context(), sv.Namespace, sv.Name)","+\t\trequire.NoError(t, err)","+\t\tvalues = append(values, *sv)","+\t\tsut.Clock.AdvanceBy(time.Second)","+\t}","+\tsut.Clock.AdvanceBy(15 * time.Minute)","+","+\treturn values","+}","+","+func leasedUIDs(svs []secretv1beta1.SecureValue) []string {","+\tuids := make([]string, 0, len(svs))","+\tfor _, sv := range svs {","+\t\tuids = append(uids, string(sv.UID))","+\t}","+\treturn uids"," }"," "," func TestPropertySecureValueMetadataStorage(t *testing.T) {"],"additions":140,"deletions":0,"truncated":false},{"path":"pkg/storage/secret/metadata/testdata/mysql--secure_value_lease_inactive-lease_inactive.sql","lines":["old mode 100755","new mode 100644","@@ -4,17 +4,8 @@ SET","   `lease_token` = 'token',","   `lease_created` = 10,","   `lease_duration` = (30 * POWER(2, `gc_attempts`))","-WHERE `guid` IN (","-  SELECT `guid` FROM (","-    SELECT","-      `guid`,","-      ROW_NUMBER() OVER (ORDER BY `created` ASC) AS rn","-    FROM `secret_secure_value`","-    WHERE","-      `active` = FALSE AND","-      10 - `updated` > 300 AND","-      10 - `lease_created` > `lease_duration`","-  ) AS sub ","-  WHERE rn <= 10","-)","+WHERE","+  `guid` IN ('1', '2') AND","+  `active` = FALSE AND","+  10 - `lease_created` > `lease_duration`"," ;"],"additions":4,"deletions":13,"truncated":false},{"path":"pkg/storage/secret/metadata/testdata/mysql--secure_value_lease_inactive_candidates-lease_inactive_candidates.sql","lines":["@@ -0,0 +1,11 @@","+SELECT","+  `guid`","+FROM","+  `secret_secure_value`","+WHERE","+  `active` = FALSE AND","+  10 - `updated` > 300 AND","+  10 - `lease_created` > `lease_duration`","+ORDER BY `created` ASC, `guid` ASC","+LIMIT 10","+;"],"additions":11,"deletions":0,"truncated":false},{"path":"pkg/storage/secret/metadata/testdata/postgres--secure_value_lease_inactive-lease_inactive.sql","lines":["old mode 100755","new m