ta.validation.Constraint;","+import jakarta.validation.Payload;","+","+@Retention(RetentionPolicy.RUNTIME)","+@Constraint(validatedBy = AssetInputValidator.class)","+public @interface AssetInputValidation {","+    String message() default \"invalid asset input\";","+","+    Class<?>[] groups() default {};","+","+    Class<? extends Payload>[] payload() default {};","+}"],"additions":19,"deletions":0,"truncated":false},{"path":"core/src/main/java/io/kestra/core/validations/validator/ArrayInputValidator.java","lines":["@@ -25,6 +25,7 @@ public boolean isValid(@Nullable ArrayInput value, @NonNull AnnotationValue<Arra","                 || value.getItemType() == Type.MULTISELECT","                 || value.getItemType() == Type.SELECT","                 || value.getItemType() == Type.TABLE","+                || value.getItemType() == Type.ASSET","         ) {","             context.disableDefaultConstraintViolation();","             context.buildConstraintViolationWithTemplate(\"`itemType` cannot be \" + value.getItemType())"],"additions":1,"deletions":0,"truncated":false},{"path":"core/src/main/java/io/kestra/core/validations/validator/AssetInputValidator.java","lines":["@@ -0,0 +1,35 @@","+package io.kestra.core.validations.validator;","+","+import java.util.Optional;","+","+import io.kestra.core.models.flows.input.AssetInput;","+import io.kestra.core.utils.PebbleUtil;","+import io.kestra.core.utils.RegexUtils;","+import io.kestra.core.validations.AssetInputValidation;","+import io.micronaut.core.annotation.AnnotationValue;","+import io.micronaut.core.annotation.NonNull;","+import io.micronaut.core.annotation.Nullable;","+import io.micronaut.validation.validator.constraints.ConstraintValidator;","+import io.micronaut.validation.validator.constraints.ConstraintValidatorContext;","+import jakarta.inject.Singleton;","+","+@Singleton","+public class AssetInputValidator implements ConstraintValidator<AssetInputValidation, AssetInput> {","+    @Override","+    public boolean isValid(@Nullable AssetInput value, @NonNull AnnotationValue<AssetInputValidation> annotationMetadata, @NonNull ConstraintValidatorContext context) {","+        if (value == null || value.getAssetId() == null || PebbleUtil.containsOpeningBlockDelimiter(value.getAssetId())) {","+            return true;","+        }","+","+        Optional<String> violation = RegexUtils.isSafeUserRegex(value.getAssetId())","+            ? RegexUtils.syntaxError(value.getAssetId()).map(\"`assetId` is not a valid regular expression: %s\"::formatted)","+            : Optional.of(\"`assetId` is too long or prone to catastrophic backtracking\");","+        if (violation.isEmpty()) {","+            return true;","+        }","+","+        context.disableDefaultConstraintViolation();","+        context.buildConstraintViolationWithTemplate(violation.get()).addConstraintViolation();","+        return false;","+    }","+}"],"additions":35,"deletions":0,"truncated":false},{"path":"core/src/main/java/io/kestra/core/validations/validator/MultiselectInputValidator.java","lines":["@@ -25,6 +25,7 @@ public boolean isValid(@Nullable MultiselectInput value, @NonNull AnnotationValu","                 || value.getItemType() == Type.MULTISELECT","                 || value.getItemType() == Type.SELECT","                 || value.getItemType() == Type.TABLE","+                || value.getItemType() == Type.ASSET","         ) {","             context.disableDefaultConstraintViolation();","             context.buildConstraintViolationWithTemplate(\"`itemType` cannot be \" + value.getItemType())"],"additions":1,"deletions":0,"truncated":false},{"path":"core/src/test/java/io/kestra/core/docs/JsonSchemaGeneratorTest.java","lines":["@@ -280,6 +280,7 @@ void flowSchemaExcludesEeOnlyInputTypes() throws URISyntaxException {","             // discriminator","             assertThat(schema, not(containsString(\"ReusableInputsInput\")));","             assertThat(schema, not(containsString(\"TableInput\")));","+            assertThat(schema, not(containsString(\"AssetInput\")));","             // sanity: ordinary input types are still present","             assertThat(schema, containsString(\"EMAIL\"));","         });"],"additions":1,"deletions":0,"truncated":false},{"path":"core/src/test/java/io/kestra/core/models/flows/input/AssetInputTest.java","lines":["@@ -0,0 +1,75 @@","+package io.kestra.core.models.flows.input;","+","+import java.util.List;","+import java.util.Map;","+","+import org.junit.jupiter.api.Test;","+","+import io.kestra.core.models.flows.Type;","+","+import jakarta.validation.ConstraintViolationException;","+","+import static org.assertj.core.api.Assertions.assertThat;","+import static org.assertj.core.api.Assertions.assertThatThrownBy;","+","+class AssetInputTest {","+    @Test","+    void shouldRejectAListWhenTheAssetInputIsSingle() {","+        AssetInput input = AssetInput.builder().id(\"vm\").type(Type.ASSET).build();","+","+        input.validate(Map.of(\"id\", \"web-01\"));","+        assertThatThrownBy(() -> input.validate(List.of(Map.of(\"id\", \"web-01\"))))","+            .isInstanceOf(ConstraintViolationException.class)","+            .hasMessageContaining(\"it must be a single asset\");","+    }","+","+    @Test","+    void shouldRejectASingleAssetWhenTheAssetInputIsMultiple() {","+        AssetInput input = AssetInput.builder().id(\"vms\").type(Type.ASSET).multiple(true).build();","+","+        input.validate(List.of(Map.of(\"id\", \"web-01\")));","+        assertThatThrownBy(() -> input.validate(Map.of(\"id\", \"web-01\")))","+            .isInstanceOf(ConstraintViolationException.class)","+            .hasMessageContaining(\"it must be a list of assets\");","+    }","+","+    @Test","+    void shouldRejectAnEmptyListWhenTheMultipleAssetInputIsRequired() {","+        AssetInput required = AssetInput.builder().id(\"vms\").type(Type.ASSET).multiple(true).build();","+        AssetInput optional = AssetInput.builder().id(\"vms\").type(Type.ASSET).multiple(true).required(false).build();","+","+        optional.validate(List.of());","+        assertThatThrownBy(() -> required.validate(List.of()))","+            .isInstanceOf(ConstraintViolationException.class)","+            .hasMessageContaining(\"it must contain at least one asset\");","+    }","+","+    @Test","+    void shouldKeepEveryOtherPropertyWhenRenderingTheFilters() {","+        AssetInput input = AssetInput.builder()","+            .id(\"vm\")","+            .type(Type.ASSET)","+            .displayName(\"Virtual machine\")","+            .assetType(\"io.kestra.plugin.ee.assets.VM\")","+            .assetId(\"{{ prefix }}\")","+            .namespace(\"infra\")","+            .status(\"{{ status }}\")","+            .metadata(Map.of(\"region\", \"{{ region }}\", \"replicas\", 3))","+            .multiple(true)","+            .build();","+","+        AssetInput rendered = (AssetInput) input.render(expression -> switch (expression) {","+            case \"{{ prefix }}\" -> \"^web\";","+            case \"{{ status }}\" -> \"retired\";","+            default -> \"eu-west-1\";","+        });","+","+        assertThat(rendered.getAssetId()).isEqualTo(\"^web\");","+        assertThat(rendered.getMetadata()).isEqualTo(Map.of(\"region\", \"eu-west-1\", \"replicas\", 3));","+        assertThat(rendered.getAssetType()).isEqualTo(\"io.kestra.plugin.ee.assets.VM\");","+        assertThat(rendered.getNamespace()).isEqualTo(\"infra\");","+        assertThat(rendered.getDisplayName()).isEqualTo(\"Virtual machine\");","+        assertThat(rendered.getMultiple()).isTrue();","+        assertThat(rendered.getStatus()).isEqualTo(\"retired\");","+    }","+}"],"additions":75,"deletions":0,"truncated":false},{"path":"core/src/test/java/io/kestra/core/runners/DisabledAssetInputResolverTest.java","lines":["@@ -0,0 +1,20 @@","+package io.kestra.core.runners;","+","+import org.junit.jupiter.api.Test;","+","+import io.kestra.core.models.executions.Execution;","+import io.kestra.core.models.flows.Type;","+import io.kestra.core.models.flows.input.AssetInput;","+","+import static org.assertj.core.api.Assertions.assertThatThrownBy;","+","+class DisabledAssetInputResolverTest {","+    @Test","+    void shouldFailWhenResolvingAnAssetOnOpenSource() {","+        AssetInput input = AssetInput.builder().id(\"vm\").type(Type.ASSET).build();","+","+        assertThatThrownBy(() -> new DisabledAssetInputResolver().resolve(Execution.builder().build(), input, \"web-01\"))","+            .isInstanceOf(IllegalArgumentException.class)","+            .hasMessageContaining(\"Enterprise Edition\");","+    }","+}"],"additions":20,"deletions":0,"truncated":false},{"path":"core/src/test/java/io/kestra/core/runners/FlowInputOutputAssetTest.java","lines":["@@ -0,0 +1,120 @@","+package io.kestra.core.runners;","+","+import java.util.ArrayList;","+import java.util.List;","+import java.util.Map;","+","+import org.junit.jupiter.api.BeforeEach;","+import org.junit.jupiter.api.Test;","+","+import io.kestra.core.models.executions.Execution;","+import io.kestra.core.models.flows.DependsOn;","+import io.kestra.core.models.flows.Type;","+import io.kestra.core.models.flows.input.AssetInput;","+import io.kestra.core.models.flows.input.InputAndValue;","+import io.kestra.core.models.flows.input.StringInput;","+import io.kestra.core.models.property.Property;","+import io.kestra.core.utils.IdUtils;","+import io.micronaut.test.annotation.MockBean;","+import io.micronaut.test.extensions.junit5.annotation.MicronautTest;","+import jakarta.inject.Inject;","+","+import static org.assertj.core.api.Assertions.assertThat;","+","+@MicronautTest","+class FlowInputOutputAssetTest {","+    private static final Execution EXECUTION = Execution.builder()","+        .id(IdUtils.create())","+        .flowId(IdUtils.create())","+        .flowRevision(1)","+        .namespace(\"io.kestra.test\")","+        .build();","+","+    private static final List<AssetInput> RESOLVED_FOR = new ArrayList<>();","+","+    @Inject","+    FlowInputOutput flowInputOutput;","+","+    @MockBean(AssetInputResolver.class)","+    AssetInputResolver assetInputResolver() {","+        return (execution, input, value) ->","+        {","+            RESOLVED_FOR.add(input);","+            return value;","+        };","+    }","+","+    @BeforeEach","+    void reset() {","+        RESOLVED_FOR.clear();","+    }","+","+    @Test","+    void shouldResolveTheSubmittedAssetIdThroughTheResolver() {","+        AssetInput input = AssetInput.builder().id(\"vm\").type(Type.ASSET).assetType(\"io.kestra.plugin.ee.assets.VM\").build();","+","+        List<InputAndValue> values = flowInputOutput.resolveInputs(List.of(input), null, EXECUTION, Map.of(\"vm\", \"web-01\"));","+","+        assertThat(values.getFirst().exceptions()).isNullOrEmpty();","+        assertThat(values.getFirst().value()).isEqualTo(\"web-01\");","+        assertThat(RESOLVED_FOR).extracting(AssetInput::getAssetType).containsExactly(\"io.kestra.plugin.ee.assets.VM\");","+    }","+","+    @Test","+    void shouldResolveTheDefaultAssetIdWhenNoValueIsSubmitted() {","+        AssetInput input = AssetInput.builder().id(\"vm\").type(Type.ASSET).defaults(Property.ofValue(\"web-01\")).build();","+","+        List<InputAndValue> values = flowInputOutput.resolveInputs(List.of(input), null, EXECUTION, Map.of());","+","+        assertThat(values.getFirst().value()).isEqualTo(\"web-01\");","+    }","+","+    @Test","+    void shouldResolveAListOfAssetIdsWhenTheInputIsMultiple() {","+        AssetInput input = AssetInput.builder().id(\"vms\").type(Type.ASSET).multiple(true).build();","+","+        List<InputAndValue> values = flowInputOutput.resolveInputs(List.of(input), null, EXECUTION, Map.of(\"vms\", List.of(\"web-01\", \"web-02\")));","+","+        assertThat(values.getFirst().exceptions()).isNullOrEmpty();","+        assertThat(values.getFirst().value()).isEqualTo(List.of(\"web-01\", \"web-02\"));","+    }","+","+    @Test","+    void shouldResolveEveryDefaultAssetIdWhenTheInputIsMultiple() {","+        AssetInput input = AssetInput.builder().id(\"vms\").type(Type.ASSET).multiple(true).defaults(Property.ofValue(List.of(\"web-01\", \"web-02\"))).build();","+","+        List<InputAndValue> values = flowInputOutput.resolveInputs(List.of(input), null, EXECUTION, Map.of());","+","+        assertThat(values.getFirst().value()).isEqualTo(List.of(\"web-01\", \"web-02\"));","+    }","+","+    @Test","+    void shouldRejectAListGivenToASingleAssetInput() {","+        AssetInput input = AssetInput.builder().id(\"vm\").type(Type.ASSET).build();","+","+        List<InputAndValue> values = flowInputOutput.resolveInputs(List.of(input), null, EXECUTION, Map.of(\"vm\", List.of(\"web-01\", \"web-02\")));","+","+        assertThat(values.getFirst().exceptions()).isNotEmpty();","+        assertThat(values.getFirst().exceptions().iterator().next().getMessage()).contains(\"it must be a single asset\");","+    }","+","+    @Test","+    void shouldRenderTheFiltersWithTheInputsTheyDependOn() {","+        StringInput deployment = StringInput.builder().id(\"deployment\").type(Type.STRING).build();","+        AssetInput vm = AssetInput.builder()","+            .id(\"vm\")","+            .type(Type.ASSET)","+            .namespace(\"{{ inputs.deployment }}.compute\")","+            .metadata(Map.of(\"deployment\", \"{{ inputs.deployment }}\", \"replicas\", 3))","+            .dependsOn(new DependsOn(List.of(\"deployment\"), null))","+            .build();","+","+        List<InputAndValue> values = flowInputOutput.resolveInputs(List.of(deployment, vm), null, EXECUTION, Map.of(\"deployment\", \"prod\", \"vm\", \"web-01\"));","+","+        assertThat(values.get(1).exceptions()).isNullOrEmpty();","+        AssetInput rendered = RESOLVED_FOR.getFirst();","+        assertThat(rendered.getNamespace()).isEqualTo(\"prod.compute\");","+        assertThat(rendered.getMetadata()).isEqualTo(Map.of(\"deployment\", \"prod\", \"replicas\", 3))