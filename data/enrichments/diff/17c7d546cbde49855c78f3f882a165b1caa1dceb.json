r;","+","+@SuperBuilder","+@Getter","+@NoArgsConstructor","+@EeOnly","+@AssetInputValidation","+public class AssetInput extends Input<Object> implements RenderableInput {","+    @Schema(","+        title = \"The type of the assets that can be selected.\",","+        description = \"A registered asset type such as `io.kestra.plugin.ee.assets.VM`, or any custom type name.\"","+    )","+    private String assetType;","+","+    @Schema(","+        title = \"A regular expression the asset id must match.\",","+        description = \"Matches anywhere in the id, e.g. `^web` keeps `web-01` and `web-02`.\"","+    )","+    private String assetId;","+","+    @Schema(","+        title = \"The namespace of the assets that can be selected.\",","+        description = \"Child namespaces are included: `company.team` also matches `company.team.backend`.\"","+    )","+    private String namespace;","+","+    @Schema(","+        title = \"The status the asset must have.\",","+        description = \"An asset with no status counts as `active`, as on the Assets page.\"","+    )","+    private String status;","+","+    @Schema(","+        title = \"The metadata the asset must have.\",","+        description = \"Each key must be equal to the given value, as in the `assets()` function.\"","+    )","+    private Map<String, Object> metadata;","+","+    @Schema(","+        title = \"Whether several assets can be selected.\",","+        description = \"The value is then a list of asset ids.\"","+    )","+    @NotNull","+    @Builder.Default","+    private Boolean multiple = false;","+","+    /** The filters are always rendered, since a submitted id is checked against them. */","+    @JsonIgnore","+    @Override","+    public Boolean getAllowCustomValue() {","+        return false;","+    }","+","+    @Override","+    public void validate(Object input) throws ConstraintViolationException {","+        boolean isList = input instanceof List<?>;","+        if (isList != Boolean.TRUE.equals(multiple)) {","+            throw ManualConstraintViolation.toConstraintViolationException(","+                Boolean.TRUE.equals(multiple) ? \"it must be a list of assets\" : \"it must be a single asset\",","+                this,","+                AssetInput.class,","+                getId(),","+                input","+            );","+        }","+        if (isList && ((List<?>) input).isEmpty() && !Boolean.FALSE.equals(getRequired())) {","+            throw ManualConstraintViolation.toConstraintViolationException(","+                \"it must contain at least one asset\",","+                this,","+                AssetInput.class,","+                getId(),","+                input","+            );","+        }","+    }","+","+    @Override","+    public Input<?> render(Function<String, Object> renderer) {","+        return AssetInput.builder()","+            .id(getId())","+            .type(getType())","+            .description(getDescription())","+            .dependsOn(getDependsOn())","+            .required(getRequired())","+            .defaults(getDefaults())","+            .prefill(getPrefill())","+            .displayName(getDisplayName())","+            .multiple(multiple)","+            .assetType(renderString(assetType, renderer))","+            .assetId(renderString(assetId, renderer))","+            .namespace(renderString(namespace, renderer))","+            .status(renderString(status, renderer))","+            .metadata(renderMetadata(renderer))","+            .build();","+    }","+","+    private Map<String, Object> renderMetadata(Function<String, Object> renderer) {","+        if (metadata == null) {","+            return null;","+        }","+        Map<String, Object> rendered = new LinkedHashMap<>();","+        metadata.forEach((key, value) -> rendered.put(key, value instanceof String s ? renderString(s, renderer) : value));","+        return rendered;","+    }","+","+    private static String renderString(String value, Function<String, Object> renderer) {","+        if (value == null || !PebbleUtil.containsOpeningBlockDelimiter(value)) {","+            return value;","+        }","+        Object rendered = renderer.apply(value);","+        return rendered == null ? null : rendered.toString();","+    }","+}"],"additions":134,"deletions":0,"truncated":false},{"path":"core/src/main/java/io/kestra/core/runners/AssetInputResolver.java","lines":["@@ -0,0 +1,17 @@","+package io.kestra.core.runners;","+","+import io.kestra.core.models.executions.Execution;","+import io.kestra.core.models.flows.input.AssetInput;","+","+/**","+ * Checks the value of an {@code ASSET} input (an asset id, or a list of ids) against the asset store and the input's filters.","+ * <p>","+ * This is an Enterprise Edition concern: the open-source default ({@code DisabledAssetInputResolver}) errors.","+ */","+public interface AssetInputResolver {","+    /**","+     * @param input the declaring input, whose filters the assets must match","+     * @return the asset id, or the list of ids when the input accepts {@code multiple} assets","+     */","+    Object resolve(Execution execution, AssetInput input, Object value);","+}"],"additions":17,"deletions":0,"truncated":false},{"path":"core/src/main/java/io/kestra/core/runners/DisabledAssetInputResolver.java","lines":["@@ -0,0 +1,17 @@","+package io.kestra.core.runners;","+","+import io.kestra.core.models.executions.Execution;","+import io.kestra.core.models.flows.input.AssetInput;","+","+import jakarta.inject.Singleton;","+","+/**","+ * Open-source default: assets are an Enterprise Edition feature, so resolving an {@code ASSET} value fails.","+ */","+@Singleton","+public class DisabledAssetInputResolver implements AssetInputResolver {","+    @Override","+    public Object resolve(Execution execution, AssetInput input, Object value) {","+        throw new IllegalArgumentException(\"The ASSET type requires Kestra Enterprise Edition.\");","+    }","+}"],"additions":17,"deletions":0,"trun