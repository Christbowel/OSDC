{"id":"08d5424a3392cbad7e51f70d4c317ac8c84ac84f","axis":"silent","repo":"pnpm/pnpm","sha":"08d5424a3392cbad7e51f70d4c317ac8c84ac84f","parsed":{"files":[{"path":".changeset/optional-peer-also-a-dependency-dropped.md","lines":["@@ -0,0 +1,6 @@","+---","+\"@pnpm/installing.deps-resolver\": patch","+\"pnpm\": patch","+---","+","+pnpm no longer drops a dependency that a package also declares as an optional peer dependency, for example `ajv` of `ajv-formats`. Since 11.28.0, in some dependency graphs the package got the dependency neither as a dependency nor as a peer, and failed to import it [#16901](https://github.com/pnpm/pnpm/issues/16901)."],"additions":6,"deletions":0,"truncated":false},{"path":".changeset/optional-peer-also-a-dependency-shallowest-path.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+pnpm now decides whether a package's dependency that it also declares as an optional peer is linked as a dependency or as a peer from the shallowest path that reaches the package. The lockfile entry of such a package can change on the next install [#16901](https://github.com/pnpm/pnpm/issues/16901)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/install/peers.rs","lines":["@@ -946,6 +946,64 @@ fn optional_peer_also_in_deps_is_installed_without_auto_install_peers() {","     assert_optional_peer_also_in_deps_is_installed(false);"," }"," ","+/// `@pnpm.e2e/has-optional-peer-also-in-deps` is first reached through","+/// `…-grandparent > …-parent`, where `@pnpm.e2e/bravo-dep` is not in scope.","+/// Hoisting the optional peers of","+/// `@pnpm.e2e/peers-of-has-optional-peer-also-in-deps-parent` reaches it","+/// again, shallower, with `@pnpm.e2e/bravo-dep` in scope, and that","+/// occurrence decides that `@pnpm.e2e/bravo-dep` is supplied as a peer.","+/// Covers <https://github.com/pnpm/pnpm/issues/16901>.","+#[test]","+fn optional_peer_also_in_deps_is_kept_when_a_hoisted_parent_owns_its_children() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({ \"dependencies\": {","+            \"@pnpm.e2e/has-optional-peer-also-in-deps-grandparent\": \"1.0.0\",","+            \"@pnpm.e2e/peers-of-has-optional-peer-also-in-deps-parent\": \"1.0.0\",","+        } })","+        .to_string(),","+    )","+    .expect(\"write package.json\");","+    pacquet","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let lockfile = read_lockfile(&workspace.join(\"pnpm-lock.yaml\"));","+    let snapshots: Vec<_> = lockfile.snapshots","+        .iter()","+        .flatten()","+        .filter(|(key, _)| key.to_string().starts_with(\"@pnpm.e2e/has-optional-peer-also-in-deps@\"))","+        .map(|(key, snapshot)| {","+            let optional_dependencies: Vec<String> = snapshot","+                .optional_dependencies","+                .iter()","+                .flatten()","+                .map(|(alias, reference)| format!(\"{alias} {reference}\"))","+                .collect();","+            (key.to_string(), optional_dependencies)","+        })","+        .collect();","+    assert_eq!(","+        snapshots,","+        [(","+            \"@pnpm.e2e/has-optional-peer-also-in-deps@1.0.0(@pnpm.e2e/bravo-dep@1.0.0)\".to_string(),","+            vec![\"@pnpm.e2e/bravo-dep 1.0.0\".to_string()],","+        )],","+    );","+","+    drop((root, mock_instance));","+}","+"," /// Older pnpm versions resolved the optional peer of"," /// `@pnpm.e2e/has-optional-peer-range-also-in-deps` to its parent's"," /// `npm:` alias of `@pnpm.e2e/foo@1.2.0`. Changing overrides re-resolves"],"additions":58,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/parent_pkg_aliases.rs","lines":["@@ -67,27 +67,37 @@ pub(crate) fn peer_shadowed_dependencies(","     parent_pkg_aliases: &ParentPkgAliases,","     auto_install_peers: bool,"," ) -> HashSet<String> {","-    let Some(manifest) = manifest else { return HashSet::default() };","-    let object = |key| manifest.get(key).and_then(Value::as_object);","-    let (Some(peers), Some(deps)) = (object(\"peerDependencies\"), object(\"dependencies\")) else {","-        return HashSet::default();","-    };","-    let peers_meta = object(\"peerDependenciesMeta\");","-    let is_optional_peer = |name: &str| {","-        peers_meta","-            .and_then(|meta| meta.get(name))","-            .and_then(|entry| entry.get(\"optional\"))","-            .and_then(Value::as_bool)","-            == Some(true)","-    };","-    deps.keys()","-        .filter(|name| peers.contains_key(*name))","-        .filter(|name| {","-            (auto_install_peers && !is_optional_peer(name)) || parent_pkg_aliases.contains(name)","+    dependencies_named_as_peers(manifest)","+        .filter(|(name, is_optional_peer)| {","+            (auto_install_peers && !is_optional_peer) || parent_pkg_aliases.contains(name)","         })","-        .cloned()","+        .map(|(name, _)| name.clone())","         .collect()"," }"," ","+/// The `dependencies` entries of `manifest` that its own","+/// `peerDependencies` also name, each with whether that peer is","+/// optional. These are the only names","+/// [`peer_shadowed_dependencies`] can drop.","+pub(crate) fn dependencies_named_as_peers(","+    manifest: Option<&Value>,","+) -> impl Iterator<Item = (&String, bool)> {","+    let object = |key| manifest?.get(key).and_then(Value::as_object);","+    let peers = object(\"peerDependencies\");","+    let peers_meta = object(\"peerDependenciesMeta\");","+    let deps = if peers.is_some() { object(\"dependencies\") } else { None };","+    deps.into_iter()","+        .flat_map(|deps| deps.keys())","+        .filter(move |name| peers.is_some_and(|peers| peers.contains_key(*name)))","+        .map(move |name| {","+            let is_optional_peer = peers_meta","+                .and_then(|meta| meta.get(name))","+                .and_then(|entry| entry.get(\"optional\"))","+                .and_then(Value::as_bool)","+                == Some(true);","+            (name, is_optional_peer)","+        })","+}","+"," #[cfg(test)]"," mod tests;"],"additions":28,"deletions":18,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/reuse/snapshot_children.rs","lines":["@@ -155,6 +155,7 @@ pub(super) fn record_reused_children(","             peer_shadowed: Arc::clone(&claim.peer_shadowed),","             prior_key: Some(context.key.clone()),","             update_active: !matches!(ctx.update_reuse_scope(), UpdateReuseScope::All),","+            children_scope: Arc::clone(context.ancestry.parent_pkg_aliases),","         },","     );","     (recording.children(realized), recording)"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/resolving-deps-resolver/src/resolve_dependency_tree/walk.rs","lines":["@@ -68,7 +68,9 @@ use std::{borrow::Cow, collections::BTreeMap, path::Path, sync::Arc};"," use crate::{","     lockfile_reuse::{current_pkg_from_lockfile, prior_child_key},","     node_id::NodeId,","-    parent_pkg_aliases::{ParentPkgAliases, peer_shadowed_dependencies},","+    parent_pkg_aliases::{","+        ParentPkgAliases, dependencies_named_as_peers, peer_shadowed_dependencies,","+    },","     resolved_tree::{","         AncestorPkgIds, DirectDep, ResolvedPackage, ResolvedPackageInput, TreeChildren,","     },","@@ -98,7 +100,7 @@ use super::{","         SharedWorkspaceWantedKey, WantedKey, WorkspaceFinalWantedKey, children_warmup_claimed,","         claim_children_owner, claim_children_warmup, insert_tree_node, is_current_children_owner,","         make_non_owner_nodes_lazy, record_children, recorded_children_match,","-        register_peer_dep_n