ptEvaluateAsync(scriptText, redisKeys, args));","+","+            if (entry.Job.ParentKey is { } parentKey && entry.Job.Parent is IReadOnlyDictionary<string, object?> parent)","+            {","+                parents[parentKey] = (","+                    (string)parent[\"queueKey\"]!,","+                    (string)parent[\"id\"]!);","+            }","+        }","+","+        // A parent that ended up without pending dependencies (e.g. all of its","+        // children already existed and were completed) is released here. The","+        // script is a no-op for any other parent.","+        var releaseScript = LuaScripts.Get(\"releaseParentIfNoPendingDependencies\").Content;","+        foreach (var (parentKey, parent) in parents)","+        {","+            tasks.Add(tran.ScriptEvaluateAsync(","+                releaseScript,","+                new RedisKey[] { parentKey, $\"{parentKey}:dependencies\" },","+                new RedisValue[] { parent.QueueKey, parent.Id, NowMs() }));","         }"," ","         var committed = await tran.ExecuteAsync().ConfigureAwait(false);","@@ -277,6 +301,12 @@ public async Task<IReadOnlyList<string>> AddFlowAsync(IReadOnlyList<FlowJobEntry","             entries[i].Job.Id = ids[i];","         }"," ","+        // Drain the trailing parent-release replies so none is left unobserved.","+        for (var i = entries.Count; i < tasks.Count; i++)","+        {","+            await tasks[i].ConfigureAwait(false);","+        }","+","         return ids;","     }"," ","@@ -342,6 +372,9 @@ private static RedisValue[] AddJobArgsWithKeys(","             job.Parent,","             job.RepeatJobKey,","             deduplicationKey,","+            // Flow inserts never release the parent from \"waiting-children\"","+            // mid-transaction: later siblings have not been attached to it yet.","+            1,","         });"," ","         var list = new List<RedisValue> { packedArgs, job.DataJson(), job.PackedOpts() };"],"additions":33,"del