{"id":"ae2f9f32a0fd52f79f2302965e4ce9ed68c9cef5","axis":"silent","repo":"TYPO3/typo3","sha":"ae2f9f32a0fd52f79f2302965e4ce9ed68c9cef5","parsed":{"files":[{"path":"Build/Sources/TypeScript/form/backend/form-engine/edit-form-control.ts","lines":["@@ -0,0 +1,60 @@","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+import DocumentService from '@typo3/core/document-service';","+import { topWindow } from '@typo3/core/utility/top-window';","+","+/**","+ * Opens the form selected in the form content element in the form editor.","+ *","+ * The link points to the form rendered with the record. Selecting another","+ * form saves and reloads the record, so the button is disabled until then.","+ * Navigating the content frame lets FormEngine, or the contextual edit","+ * sheet, ask about unsaved changes first.","+ */","+class EditFormControl {","+  private controlElement: HTMLAnchorElement = null;","+  private assignedFormField: HTMLSelectElement = null;","+","+  constructor(controlElementId: string) {","+    DocumentService.ready().then((): void => {","+      this.controlElement = document.querySelector<HTMLAnchorElement>(controlElementId);","+      this.assignedFormField = document.querySelector<HTMLSelectElement>(","+        'select[data-formengine-input-name=\"' + this.controlElement.dataset.element + '\"]',","+      );","+      this.assignedFormField?.addEventListener('change', this.updateState);","+      this.controlElement.addEventListener('click', this.openFormEditor);","+      this.updateState();","+    });","+  }","+","+  private isSelectionRendered(): boolean {","+    return this.assignedFormField?.value === this.controlElement.dataset.persistenceIdentifier;","+  }","+","+  private readonly updateState = (): void => {","+    const disabled = !this.isSelectionRendered();","+    this.controlElement.classList.toggle('disabled', disabled);","+    this.controlElement.setAttribute('aria-disabled', disabled ? 'true' : 'false');","+  };","+","+  private readonly openFormEditor = (e: Event): void => {","+    e.preventDefault();","+    if (!this.isSelectionRendered()) {","+      return;","+    }","+    topWindow.TYPO3?.Backend?.ContentContainer?.setUrl(this.controlElement.href);","+  };","+}","+","+export default EditFormControl;"],"additions":60,"deletions":0,"truncated":false},{"path":"typo3/sysext/core/Documentation/Changelog/15.0/Feature-111457-EditTheSelectedFormFromTheFormContentElement.rst","lines":["@@ -0,0 +1,45 @@","+..  include:: /Includes.rst.txt","+","+..  _feature-111457-1794680900:","+","+=======================================================================","+Feature: #111457 - Edit the selected form from the form content element","+=======================================================================","+","+See :issue:`111457`","+","+Description","+===========","+","+The form content element only allowed editors to select a form definition.","+Changing that form meant leaving the record, opening the form module and","+finding the form again.","+","+A new button \"Edit in form editor\" below the form definition selector opens","+the selected form in the form editor. Closing the form editor returns to the","+content element: to the record when it was edited in full, and to the page","+module when it was edited in the contextual edit sheet. Unsaved changes of the","+record are confirmed before the form editor opens.","+","+The button is shown for existing content elements to backend users who may","+edit the selected form in the form editor. That requires access to the form","+editor module, write access to the storage of the form and, for forms stored","+in extension paths, `persistenceManager.allowSaveToExtensionPaths`. Selecting","+another form saves and reloads the record, and the button opens the new form","+afterwards.","+","+Below the button, these backend users additionally see:","+","+*   how many content elements use the form, if it is used more than once,","+    since a change in the form editor affects all of them,","+*   in a workspace, that forms are not versioned and changes in the form","+    editor are live immediately.","+","+Impact","+======","+","+Editors can change the form a content element uses directly from the content","+element. Backend users without access to the form editor see the form content","+element unchanged.","+","+..  index:: Backend, FlexForm, ext:form"],"additions":45,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Classes/FormEngine/FieldWizard/EditFormInFormEditor.php","lines":["@@ -0,0 +1,133 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Form\\FormEngine\\FieldWizard;","+","+use Psr\\Http\\Message\\ServerRequestInterface;","+use TYPO3\\CMS\\Backend\\Form\\AbstractNode;","+use TYPO3\\CMS\\Core\\Authentication\\BackendUserAuthentication;","+use TYPO3\\CMS\\Core\\Imaging\\IconFactory;","+use TYPO3\\CMS\\Core\\Imaging\\IconSize;","+use TYPO3\\CMS\\Core\\Localization\\LanguageService;","+use TYPO3\\CMS\\Core\\Page\\JavaScriptModuleInstruction;","+use TYPO3\\CMS\\Core\\Utility\\GeneralUtility;","+use TYPO3\\CMS\\Core\\Utility\\StringUtility;","+use TYPO3\\CMS\\Form\\Service\\DatabaseService;","+use TYPO3\\CMS\\Form\\Service\\FormEditorLinkProvider;","+","+/**","+ * Renders a labelled button below the form selection of the form content","+ * element, which opens the selected form in the form editor. Beside it,","+ * editors learn that a change affects every content element using the","+ * form, and that forms are not versioned in workspaces.","+ *","+ * @internal","+ */","+final class EditFormInFormEditor extends AbstractNode","+{","+    public function __construct(","+        private readonly FormEditorLinkProvider $formEditorLinkProvider,","+        private readonly IconFactory $iconFactory,","+        private readonly DatabaseService $databaseService,","+    ) {}","+","+    public function render(): array","+    {","+        $resultArray = $this->initializeResultArray();","+        if (($this->data['command'] ?? '') !== 'edit') {","+            return $resultArray;","+        }","+        $parameterArray = $this->data['parameterArray'];","+        $persistenceIdentifier = (string)(((array)($parameterArray['itemFormElValue'] ?? []))[0] ?? '');","+        $editUri = $this->formEditorLinkProvider->getEditUri($persistenceIdentifier, $this->getReturnUrl());","+        if ($editUri === null) {","+            return $resultArray;","+        }","+        $id = StringUtility::getUniqueId('t3js-formengine-fieldwizard-');","+        $attributes = [","+            'id' => $id,","+            'href' => (string)$editUri,","+            'class' => 'btn btn-default btn-sm',","+            'data-element' => $parameterArray['itemFormElName'],","+            'data-persistence-identifier' => $persistenceIdentifier,","+        ];","+        $languageService = $this->getLanguageService();","+        $html = [];","+        $html[] = '<div class=\"mt-2\">';","+        $html[] = '<a ' . GeneralUtility::implodeAttributes($attributes, true) . '>'","+            . $this->iconFactory->getIcon('actions-open', IconSize::SMALL)->render()","+            . ' ' . htmlspecialchars($languageService->sL('form.database:tt_content.pi_flexform.formframework.editInFormEditor'))","+            . '</a>';","+        foreach ($this->getNotices($persistenceIdentifier) as $notice) {","+            $html[] = '<div class=\"mt-2\"><span class=\"badge badge-info text-wrap text-start lh-sm\">' . htmlspecialchars($notice) . '</span></div>';","+        }","+        $html[] = '</div>';","+        $resultArray['html'] = implode(LF, $html);","+        $resultArray['javaScriptModules'][] = JavaScriptModuleInstruction::create(","+            '@typo3/form/backend/form-engine/edit-form-control.js'","+        )->instance('#' . $id);","+        return $resultArray;","+    }","+","+    /**","+     * @return list<string>","+     */","+    private function getNotices(string $persistenceIdentifier): array","+    {","+        $languageService = $this->getLanguageService();","+        $notices = [];","+        $usages = [];","+        foreach ($this->databaseService->getReferencesByPersistenceIdentifier($persistenceIdentifier) as $reference) {","+            $usages[$reference['tablename'] . ':' . $reference['recuid']] = true;","+        }","+        if (count($usages) > 1) {","+            $notices[] = sprintf($languageService->sL('form.database:tt_content.pi_flexform.formframework.usage'), count($usages));","+        }","+        if ($this->getBackendUser()->workspace !== 0) {","+            $notices[] = $languageService->sL('form.database:tt_content.pi_flexform.formframework.workspaceNotice');","+        }","+        return $notices;","+    }","+","+    /**","+     * FormEngine hands over the URL of the current editing view as returnUrl.","+     * The contextual edit sheet of the page module cannot be reopened on its","+     * own, so the form editor returns to where the sheet returns to.","+     */","+    private function getReturnUrl(): string","+    {","+        $currentEditingUrl = (string)($this->data['returnUrl'] ?? '');","+        $request = $this->data['request'] ?? null;","+        if (!$request instanceof ServerRequestInterface","+            || $request->getAttribute('route')?->getOption('_identifier') !== 'record_edit_contextual'","+        ) {","+            return $currentEditingUrl;","+        }","+        parse_str((string)parse_url($currentEditingUrl, PHP_URL_QUERY), $query);","+        return is_string($query['returnUrl'] ?? null) ? $query['returnUrl'] : '';","+    }","+","+    private function getBackendUser(): BackendUserAuthentication","+    {","+        return $GLOBALS['BE_USER'];","+    }","+","+    private function getLanguageService(): LanguageService","+    {","+        return $GLOBALS['LANG'];","+    }","+}"],"additions":133,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Configuration/FlexForms/FormFramework.xml","lines":["@@ -18,6 +18,11 @@","                                 </numIndex>","                             </items>","                             <softref>formPersistenceIdentifier</softref>","+                            <fieldWizard>","+                                <formEditorEditForm>","+                                    <renderType>formEditorEditForm</renderType>","+                                </formEditorEditForm>","+                            </fieldWizard>","                         </config>","                     </settings.persistenceIdentifier>","                 </el>"],"additions":5,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Resources/Private/Language/Database.xlf","lines":["@@ -27,6 +27,15 @@","       <trans-unit id=\"tt_content.pi_flexform.formframework.overrideFinishers.empty\">","         <source>There are no finishers or finisher options in the current form definition.</source>","       </trans-unit>","+      <trans-unit id=\"tt_content.pi_flexform.formframework.editInFormEditor\">","+        <source>Edit in form editor</source>","+      </trans-unit>","+      <trans-unit id=\"tt_content.pi_flexform.formframework.usage\">","+        <source>This form is used by %d content elements. Changes affect all of them.</source>","+      </trans-unit>","+      <trans-unit id=\"tt_content.pi_flexform.formframework.workspaceNotice\">","+        <source>Forms are not versioned. Changes in the form editor are live immediately.</source>","+      </trans-unit>","       <trans-unit id=\"tt_content.preview.noPersistenceIdentifier\">","         <source>No form selected.</source>","       </trans-unit>"],"additions":9,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Resources/Public/JavaScript/backend/form-engine/edit-form-control.js","lines":["@@ -0,0 +1,13 @@","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+import n from\"@typo3/core/document-service.js\";import{topWindow as i}from\"@typo3/core/utility/top-window.js\";class o{constructor(t){this.controlElement=null,this.assignedFormField=null,this.updateState=()=>{const e=!this.isSelectionRendered();this.controlElement.classList.toggle(\"disabled\",e),this.controlElement.setAttribute(\"aria-disabled\",e?\"true\":\"false\")},this.openFormEditor=e=>{e.preventDefault(),this.isSelectionRendered()&&i.TYPO3?.Backend?.ContentContainer?.setUrl(this.controlElement.href)},n.ready().then(()=>{this.controlElement=document.querySelector(t),this.assignedFormField=document.querySelector('select[data-formengine-input-name=\"'+this.controlElement.dataset.element+'\"]'),this.assignedFormField?.addEventListener(\"change\",this.updateState),this.controlElement.addEventListener(\"click\",this.openFormEditor),this.updateState()})}isSelectionRendered(){return this.assignedFormField?.value===this.controlElement.dataset.persistenceIdentifier}}export{o as default};"],"additions":13,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Tests/Functional/Fixtures/FormEditorLinkProvider/form_definition_single_use.csv","lines":["@@ -0,0 +1,6 @@","+form_definition,,,,,,","+,uid,pid,identifier,label,configuration,deleted","+,4,0,single-use-form,\"Single Use Form\",\"{\"\"identifier\"\":\"\"single-use-form\"\",\"\"type\"\":\"\"Form\"\",\"\"label\"\":\"\"Single Use Form\"\",\"\"prototypeName\"\":\"\"standard\"\",\"\"renderingOptions\"\":[],\"\"finishers\"\":[],\"\"renderables\"\":[{\"\"identifier\"\":\"\"page-1\"\",\"\"type\"\":\"\"Page\"\",\"\"label\"\":\"\"Page 1\"\",\"\"renderables\"\":[]}],\"\"variants\"\":[]}\",0","+sys_refindex,,,,,,,","+,hash,tablename,recuid,field,softref_key,ref_uid,ref_string","+,a0000000000000000000000000000005,tt_content,14,pi_flexform,formPersistenceIdentifier,0,4"],"additions":6,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Tests/Functional/Fixtures/FormEditorLinkProvider/sys_refindex.csv","lines":["@@ -0,0 +1,6 @@","+sys_refindex,,,,,,,","+,hash,tablename,recuid,field,softref_key,ref_uid,ref_string","+,a0000000000000000000000000000001,tt_content,10,pi_flexform,formPersistenceIdentifier,0,1","+,a0000000000000000000000000000002,tt_content,11,pi_flexform,formPersistenceIdentifier,0,1","+,a0000000000000000000000000000003,tt_content,12,pi_flexform,formPersistenceIdentifier,0,1","+,a0000000000000000000000000000004,tt_content,13,pi_flexform,formPersistenceIdentifier,0,3"],"additions":6,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/Tests/Functional/FormEngine/EditFormInFormEditorTest.php","lines":["@@ -0,0 +1,167 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Form\\Tests\\Functional\\FormEngine;","+","+use PHPUnit\\Framework\\Attributes\\Test;","+use TYPO3\\CMS\\Backend\\Form\\NodeFactory;","+use TYPO3\\CMS\\Backend\\Routing\\Router;","+use TYPO3\\CMS\\Core\\Core\\SystemEnvironmentBuilder;","+use TYPO3\\CMS\\Core\\Http\\NormalizedParams;","+use TYPO3\\CMS\\Core\\Http\\ServerRequest;","+use TYPO3\\CMS\\Core\\Http\\Uri;","+use TYPO3\\CMS\\Core\\Localization\\LanguageServiceFactory;","+use TYPO3\\TestingFramework\\Core\\Functional\\FunctionalTestCase;","+","+final class EditFormInFormEditorTest extends FunctionalTestCase","+{","+    private const RECORD_EDIT_URL = '/typo3/record/edit?edit%5Btt_content%5D%5B10%5D=edit&returnUrl=%2Ftypo3%2Fmodule%2Fweb%2Flayout%3Fid%3D1';","+    private const CONTEXTUAL_EDIT_URL = '/typo3/record/edit/contextual?edit%5Btt_content%5D%5B10%5D=edit&returnUrl=%2Ftypo3%2Fmodule%2Fweb%2Flayout%3Fid%3D1%23element-tt_content-10';","+","+    protected array $coreExtensionsToLoad = ['form'];","+","+    protected function setUp(): void","+    {","+        parent::setUp();","+        $this->importCSVDataSet(__DIR__ . '/../Fixtures/FormEditorLinkProvider/be_users.csv');","+        $this->importCSVDataSet(__DIR__ . '/../Fixtures/FormEditorLinkProvider/form_definition.csv');","+        $this->importCSVDataSet(__DIR__ . '/../Fixtures/FormEditorLinkProvider/sys_refindex.csv');","+    }","+","+    #[Test]","+    public function buttonLinksToTheSelectedFormAndReturnsToTheRecord(): void","+    {","+        $result = $this->renderButton(2, '1', 'record_edit', self::RECORD_EDIT_URL);","+","+        $link = $this->getLink($result['html']);","+        self::assertSame('Edit in form editor', trim($link->textContent));","+        self::assertStringContainsString('btn', $link->getAttribute('class'));","+        self::assertSame('data[tt_content][10][pi_flexform][data][sDEF][lDEF][settings.persistenceIdentifier][vDEF]', $link->getAttribute('data-element'));","+        self::assertSame('1', $link->getAttribute('data-persistence-identifier'));","+        $query = $this->getQueryOfHref($link->getAttribute('href'));","+        self::assertSame('1', $query['formPersistenceIdentifier'] ?? null);","+        self::assertSame(rawurldecode(self::RECORD_EDIT_URL), rawurldecode($query['returnUrl'] ?? ''));","+        self::assertSame(","+            '@typo3/form/backend/form-engine/edit-form-control.js',","+            $result['javaScriptModules'][0]->getName()","+        );","+    }","+","+    #[Test]","+    public function buttonReturnsToThePageModuleFromTheContextualEditSheet(): void","+    {","+        $result = $this->renderButton(2, '1', 'record_edit_contextual', self::CONTEXTUAL_EDIT_URL);","+","+        $query = $this->getQueryOfHref($this->getLink($result['html'])->getAttribute('href'));","+        self::assertSame('/typo3/module/web/layout?id=1#element-tt_content-10', $query['returnUrl'] ?? null);","+    }","+","+    #[Test]","+    public function buttonIsNotRenderedWithoutAccessToTheFormEditor(): void","+    {","+        self::assertSame('', $this->renderButton(3, '1', 'record_edit', self::RECORD_EDIT_URL)['html']);","+    }","+","+    #[Test]","+    public function buttonIsNotRenderedIfNoFormIsSelected(): void","+    {","+        self::assertSame('', $this->renderButton(2, '', 'record_edit', self::RECORD_EDIT_URL)['html']);","+    }","+","+    #[Test]","+    public function buttonIsNotRenderedForANewRecord(): void","+    {","+        self::assertSame('', $this->renderButton(2, '1', 'record_edit', self::RECORD_EDIT_URL, 'new')['html']);","+    }","+","+    #[Test]","+    public function buttonNamesHowManyContentElementsUseTheForm(): void","+    {","+        $html = $this->renderButton(2, '1', 'record_edit', self::RECORD_EDIT_URL)['html'];","+","+        self::assertStringContainsString('This form is used by 3 content elements. Changes affect all of them.', $html);","+        self::assertStringNotContainsString('not versioned', $html);","+    }","+","+    #[Test]","+    public function buttonOmitsTheUsageForAFormUsedOnce(): void","+    {","+        $this->importCSVDataSet(__DIR__ . '/../Fixtures/FormEditorLinkProvider/form_definition_single_use.csv');","+","+        $html = $this->renderButton(2, '4', 'record_edit', self::RECORD_EDIT_URL)['html'];","+","+        self::assertStringContainsString('Edit in form editor', $html);","+        self::assertStringNotContainsString('This form is used by', $html);","+    }","+","+    #[Test]","+    public function buttonTellsThatFormsAreNotVersionedInAWorkspace(): void","+    {","+        $html = $this->renderButton(2, '1', 'record_edit', self::RECORD_EDIT_URL, 'edit', 1)['html'];","+","+        self::assertStringContainsString('Forms are not versioned. Changes in the form editor are live immediately.', $html);","+    }","+","+    private function renderButton(","+        int $backendUserUid,","+        string $selectedValue,","+        string $routeIdentifier,","+        string $currentEditingUrl,","+        string $command = 'edit',","+        int $workspace = 0,","+    ): array {","+        $backendUser = $this->setUpBackendUser($backendUserUid);","+        $backendUser->workspace = $workspace;","+        $GLOBALS['LANG'] = $this->get(LanguageServiceFactory::class)->createFromUserPreferences($backendUser);","+        $route = clone $this->get(Router::class)->getRoute($routeIdentifier);","+        $route->setOption('_identifier', $routeIdentifier);","+        $request = new ServerRequest('https://typo3-testing.local' . $currentEditingUrl)","+            ->withAttribute('applicationType', SystemEnvironmentBuilder::REQUESTTYPE_BE)","+            ->withAttribute('route', $route);","+        $request = $request->withAttribute('normalizedParams', NormalizedParams::createFromRequest($request));","+        $GLOBALS['TYPO3_REQUEST'] = $request;","+","+        return $this->get(NodeFactory::class)->create([","+            'renderType' => 'formEditorEditForm',","+            'request' => $request,","+            'tableName' => 'tt_content',","+            'command' => $command,","+            'returnUrl' => $currentEditingUrl,","+            'renderData' => ['fieldWizardOptions' => []],","+            'parameterArray' => [","+                'itemFormElName' => 'data[tt_content][10][pi_flexform][data][sDEF][lDEF][settings.persistenceIdentifier][vDEF]',","+                'itemFormElValue' => $selectedValue === '' ? [] : [$selectedValue],","+                'fieldConf' => ['config' => ['type' => 'select', 'renderType' => 'selectSingle']],","+            ],","+        ])->render();","+    }","+","+    private function getLink(string $html): \\DOMElement","+    {","+        $document = new \\DOMDocument();","+        $document->loadHTML('<!DOCTYPE html><html><body>' . $html . '</body></html>', LIBXML_NOERROR);","+        $link = $document->getElementsByTagName('a')->item(0);","+        self::assertInstanceOf(\\DOMElement::class, $link);","+        return $link;","+    }","+","+    private function getQueryOfHref(string $href): array","+    {","+        parse_str(new Uri($href)->getQuery(), $query);","+        return $query;","+    }","+}"],"additions":167,"deletions":0,"truncated":false},{"path":"typo3/sysext/form/ext_localconf.php","lines":["@@ -6,6 +6,7 @@"," use TYPO3\\CMS\\Extbase\\Utility\\ExtensionUtility;"," use TYPO3\\CMS\\Form\\Controller\\FormFrontendController;"," use TYPO3\\CMS\\Form\\Evaluation\\EmailOrFormElementIdentifier;","+use TYPO3\\CMS\\Form\\FormEngine\\FieldWizard\\EditFormInFormEditor;"," use TYPO3\\CMS\\Form\\Hooks\\FormDefinitionDataHandlerHook;"," use TYPO3\\CMS\\Form\\Hooks\\ImportExportHook;"," ","@@ -33,5 +34,12 @@"," // Add validation call for input which contains email or form element identifier"," $GLOBALS['TYPO3_CONF_VARS']['SC_OPTIONS']['tce']['formevals'][EmailOrFormElementIdentifier::class] = '';"," ","+// Button below the form selection of the form content element","+$GLOBALS['TYPO3_CONF_VARS']['SYS']['formEngine']['nodeRegistry'][1794680500] = [","+    'nodeName' => 'formEditorEditForm',","+    'priority' => 40,","+    'class' => EditFormInFormEditor::class,","+];","+"," // Register FE plugin"," ExtensionUtility::configurePlugin('Form', 'Formframework', [FormFrontendController::class => ['render', 'perform']], [FormFrontendController::class => ['perform']]);",""],"additions":8,"deletions":0,"truncated":false}],"additions":452,"deletions":0,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-19T17:59:55.834511+00:00"}