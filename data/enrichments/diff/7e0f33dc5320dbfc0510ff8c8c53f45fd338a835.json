reateOptions{DryRun: dryRunAll})","+\t\trequire.NoError(t, err)","+\t\trule := out.(*v1beta1.AlertRule)","+\t\trequire.Equal(t, \"dry-create\", rule.Name)","+\t\trequire.Equal(t, \"dry\", rule.Spec.Title)","+\t\trequire.NotEmpty(t, rule.UID)","+\t\trequire.Equal(t, \"1\", rule.ResourceVersion)","+\t\trequire.Empty(t, f.writes())","+\t\trequire.Empty(t, f.ruleStore.Rules[1])","+\t})","+","+\tt.Run(\"create still runs the rule service validation\", func(t *testing.T) {","+\t\tf := newDryRunFixture(t, false)","+\t\tf.validator.err = fmt.Errorf(\"%w: missing annotations.summary\", ngmodels.ErrAlertRuleFailedValidation)","+\t\t_, err := f.storage.Create(f.ctx, newDryRunRule(\"dry-invalid\", \"dry\"), nil, &metav1.CreateOptions{DryRun: dryRunAll})","+\t\trequire.True(t, apierrors.IsBadRequest(err), \"expected bad request, got %v\", err)","+\t\trequire.Empty(t, f.writes())","+\t})","+","+\tt.Run(\"create still checks the quota\", func(t *testing.T) {","+\t\tf := newDryRunFixture(t, true)","+\t\t_, err := f.storage.Create(f.ctx, newDryRunRule(\"dry-quota\", \"dry\"), nil, &metav1.CreateOptions{DryRun: dryRunAll})","+\t\trequire.True(t, apierrors.IsForbidden(err), \"expected forbidden, got %v\", err)","+\t\trequire.Empty(t, f.writes())","+\t})","+","+\tt.Run(\"create of an existing name conflicts\", func(t *testing.T) {","+\t\tf := newDryRunFixture(t, false)","+\t\tf.seed(t, \"dry-duplicate\")","+\t\t_, err := f.storage.Create(f.ctx, newDryRunRule(\"dry-duplicate\", \"other\"), nil, &metav1.CreateOptions{DryRun: dryRunAll})","+\t\trequire.ErrorIs(t, err, ngmodels.ErrAlertRuleConflictBase)","+\t\trequire.Empty(t, f.writes())","+\t})","+","+\tt.Run(\"create and update still run the store's write checks\", func(t *testing.T) {","+\t\tf := newDryRunFixture(t, false)","+\t\tstored := f.seed(t, \"dry-store-checks\")","+\t\tstoreErr := fmt.Errorf(\"%w: rule group name too long\", ngmodels.ErrAlertRuleFailedValidation)","+\t\tf.ruleStore.Hook = func(cmd any) error {","+\t\t\tif q, o