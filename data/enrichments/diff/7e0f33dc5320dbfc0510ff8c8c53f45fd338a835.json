a/grafana/pkg/services/ngalert/tests/fakes\"","+\t\"github.com/grafana/grafana/pkg/services/user\"","+)","+","+var dryRunAll = []string{metav1.DryRunAll}","+","+// switchableValidator rejects every mutation while err is set.","+type switchableValidator struct{ err error }","+","+func (v *switchableValidator) ValidateRuleMutations(context.Context, []*ngmodels.AlertRule, utils.ManagerProperties) error {","+\treturn v.err","+}","+","+type recordingStatusWriter struct{ calls int }","+","+func (w *recordingStatusWriter) SaveAlertRuleStatus(context.Context, int64, string, []byte) error {","+\tw.calls++","+\treturn nil","+}","+","+type dryRunFixture struct {","+\tstorage   *legacyStorage","+\truleStore *fakes.RuleStore","+\tvalidator *switchableValidator","+\tctx       context.Context","+}","+","+func newDryRunFixture(t *testing.T, quotaReached bool) *dryRunFixture {","+\tt.Helper()","+\truleStore := fakes.NewRuleStore(t)","+\tquotas := legacy.MockQuotaChecker{}","+\tif quotaReached {","+\t\tquotas.EXPECT().LimitExceeded()","+\t} else {","+\t\tquotas.EXPECT().LimitOK()","+\t}","+\tfolderService := foldertest.NewFakeService()","+\tfolderService.ExpectedFolder = &folder.Folder{UID: \"test-folder-uid\", Title: \"Test Folder\"}","+\tvalidator := &switchableValidator{}","+\tsvc := legacy.NewLegacyRuleService(","+\t\truleStore, fakes.NewFakeProvisioningStore(), folderService, &quotas, ruleStore,","+\t\t60, log.NewNopLogger(), nil, fakeRuleAccessControl{}, validator,","+\t)","+\tctx := genericapirequest.WithNamespace(context.Background(), \"default\")","+\tctx = identity.WithRequester(ctx, &user.SignedInUser{OrgID: 1, UserUID: \"test-user\"})","+\treturn &dryRunFixture{","+\t\tstorage:   &legacyStorage{service: *svc, namespacer: nsMapperForTest()},","+\t\truleStore: ruleStore,","+\t\tvalidator: validator,","+\t\tctx:       ctx,","+\t}","+}","+","+// seed stores a rule for the update and delete cases and forgets the writes it took.","+func (f *dryRunFixture) seed(t *testing.T, nam