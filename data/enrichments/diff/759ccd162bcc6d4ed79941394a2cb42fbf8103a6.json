{"id":"759ccd162bcc6d4ed79941394a2cb42fbf8103a6","axis":"silent","repo":"openvinotoolkit/openvino","sha":"759ccd162bcc6d4ed79941394a2cb42fbf8103a6","parsed":{"files":[{"path":"src/plugins/intel_npu/src/al/include/intel_npu/config/options.hpp","lines":["@@ -233,6 +233,47 @@ struct LOG_LEVEL final : OptionBase<LOG_LEVEL, ov::log::Level> {","     }"," };"," ","+// The option is intentionally left without a default value: an unset option means it inherits LOG_LEVEL, which","+// cannot be expressed from defaultValue() alone (it has no visibility of other options). resolve() implements","+// that fallback.","+struct COMPILE_LOG_LEVEL final : OptionBase<COMPILE_LOG_LEVEL, ov::log::Level> {","+    static std::string_view key() {","+        return ov::intel_npu::compile_log_level.name();","+    }","+","+    static constexpr std::string_view getTypeName() {","+        return \"ov::log::Level\";","+    }","+","+    static std::string_view envVar() {","+        return \"OV_NPU_COMPILE_LOG_LEVEL\";","+    }","+","+    // RunTime despite its name: this is a plugin-side knob, never serialized to the compiler under its own key.","+    // serializeConfig() resolves it and forwards the result to the compiler under the compiler-understood","+    // LOG_LEVEL key instead.","+    static OptionMode mode() {","+        return OptionMode::RunTime;","+    }","+","+    static bool isPublic() {","+        return false;","+    }","+","+    /**","+     * @brief Returns the effective compile log level.","+     * @param config The configuration to resolve the compile log level against.","+     * @return The explicitly-set COMPILE_LOG_LEVEL when present (via property or OV_NPU_COMPILE_LOG_LEVEL env","+     * var), otherwise the plugin LOG_LEVEL it inherits from.","+     */","+    static ov::log::Level resolve(const Config& config) {","+        if (config.has<COMPILE_LOG_LEVEL>()) {","+            return config.get<COMPILE_LOG_LEVEL>();","+        }","+        return config.get<LOG_LEVEL>();","+    }","+};","+"," struct PLATFORM final : OptionBase<PLATFORM, std::string> {","     static std::string_view key() {","         return ov::intel_npu::platform.name();"],"additions":41,"deletions":0,"truncated":false},{"path":"src/plugins/intel_npu/src/al/include/intel_npu/npu_private_properties.hpp","lines":["@@ -293,6 +293,18 @@ static constexpr ov::Property<int64_t> stepping{\"NPU_STEPPING\"};","  */"," static constexpr ov::Property<std::string> compilation_mode{\"NPU_COMPILATION_MODE\"};"," ","+/**","+ * @brief [Only for NPU Plugin]","+ * Type: ov::log::Level","+ * Controls the verbosity of the NPU compiler's own logging for a single compile() call, independently of","+ * ov::log::level (which controls the plugin-side logging). This lets a user raise plugin logging without also","+ * enabling the compiler's much more verbose internal logging, and vice versa. Like other compile-time properties,","+ * it can also be set persistently via ov::Core::set_property() / plugin set_property(), in which case it affects","+ * every subsequent compile_model() call until changed again.","+ * @note If this property is not set, the compile log level inherits the value of ov::log::level.","+ */","+static constexpr ov::Property<ov::log::Level> compile_log_level{\"NPU_COMPILE_LOG_LEVEL\"};","+"," /**","  * @brief [Only for NPU Plugin]","  * Type: integer, default is -1"],"additions":12,"deletions":0,"truncated":false},{"path":"src/plugins/intel_npu/src/common/include/intel_npu/common/compiler_adapter_factory.hpp","lines":["@@ -6,7 +6,6 @@"," "," #include <atomic>"," #include <memory>","-#include <optional>"," #include <string_view>"," "," #include \"intel_npu/common/icompiler_adapter.hpp\""],"additions":0,"deletions":1,"truncated":false},{"path":"src/plugins/intel_npu/src/compiler_adapter/src/model_serializer.cpp","lines":["@@ -698,11 +698,25 @@ std::string serializeIOInfo(const std::shared_ptr<const ov::Model>& model, const","            outputsPrecisionSS.str() + VALUES_SEPARATOR.d