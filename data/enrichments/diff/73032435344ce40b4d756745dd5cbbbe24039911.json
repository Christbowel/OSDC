{"id":"73032435344ce40b4d756745dd5cbbbe24039911","axis":"silent","repo":"strapi/strapi","sha":"73032435344ce40b4d756745dd5cbbbe24039911","parsed":{"files":[{"path":"packages/core/admin/admin/src/index.ts","lines":["@@ -1,3 +1,6 @@","+// Must stay first: it patches yup's `.email()` before any module builds a schema.","+import './utils/yupEmail';","+"," /**","  * DO NOT REMOVE. This export is what's used to render the admin panel at all.","  * Without it === no admin panel."],"additions":3,"deletions":0,"truncated":false},{"path":"packages/core/admin/admin/src/utils/tests/yupEmail.test.ts","lines":["@@ -0,0 +1,117 @@","+import { readFileSync } from 'node:fs';","+import path from 'node:path';","+import vm from 'node:vm';","+import * as yup from 'yup';","+","+import { EMAIL_REGEX, email } from '../yupEmail';","+","+// The server's pattern, read as text. Importing `@strapi/utils` would also run its own `.email()`","+// override on the same yup, and these tests could then pass without the admin's.","+const readServerRegex = () => {","+  const source = readFileSync(","+    path.join(__dirname, '../../../../../utils/src/email-regex.ts'),","+    'utf8'","+  );","+  const literal = source","+    .split('\\n')","+    .map((line) => line.trim())","+    .find((line) => line.startsWith('/^'));","+","+  if (!literal) {","+    throw new Error('EMAIL_REGEX literal not found in @strapi/utils');","+  }","+","+  const lastSlash = literal.lastIndexOf('/');","+","+  return {","+    source: literal.slice(1, lastSlash),","+    flags: literal.slice(lastSlash + 1).replace(/;$/, ''),","+  };","+};","+","+const isValidEmail = (value: string) => yup.string().email().isValidSync(value);","+","+// Runs `fn` with a hard time limit and returns how long it took. A backtracking regex is","+// synchronous and Jest can't interrupt it, so a regression would hang the job instead of failing.","+// The vm timeout stops it mid-match and throws.","+const timedWithLimit = (limitMs: number, fn: () => void) => {","+  const start = process.hrtime.bigint();","+  vm.runInNewContext('fn()', { fn }, { timeout: limitMs });","+  return Number(process.hrtime.bigint() - start) / 1e6;","+};","+","+describe('yup string().email() in the admin', () => {","+  // The override only covers schemas built after it runs, and some admin modules build theirs at","+  // import time. In the browser nothing else patches yup, so the admin entry must import it first.","+  test('is the first import of the admin entry', () => {","+    const entry = readFileSync(path.join(__dirname, '../../index.ts'), 'utf8');","+    const firstStatement = entry","+      .split('\\n')","+      .map((line) => line.trim())","+      .find(","+        (line) => line && !line.startsWith('//') && !line.startsWith('/*') && !line.startsWith('*')","+      );","+","+    expect(firstStatement).toBe(\"import './utils/yupEmail';\");","+  });","+","+  test('replaces yup string().email()', () => {","+    expect(yup.StringSchema.prototype.email).toBe(email);","+  });","+","+  test('uses the same regex as the server', () => {","+    const server = readServerRegex();","+","+    expect(EMAIL_REGEX).toBeInstanceOf(RegExp);","+    expect(EMAIL_REGEX.source).toBe(server.source);","+    expect(EMAIL_REGEX.flags).toBe(server.flags);","+  });","+","+  test.each([","+    ['a domain made of many short labels', `a@${'a.'.repeat(24)}!`],","+    ['an unterminated quoted local part', `\"${'x'.repeat(28)}`],","+  ])('rejects %s without backtracking', (_, value) => {","+    let result = true;","+    const duration = timedWithLimit(1000, () => {","+      result = isValidEmail(value);","+    });","+","+    expect(result).toBe(false);","+    expect(duration).toBeLessThan(100);","+  });","+","+  test.each(['user@example.com', 'first.last@sub.example.co.uk', '\"john doe\"@example.com'])(","+    'accepts %s',","+    (value) => {","+      expect(isValidEmail(value)).toBe(true);","+    }","+  );","+","+  test('rejects a domain with consecutive dots, which the stock yup regex let through', () => {","+    expect(isValidEmail('user@sub..example.com')).toBe(false);","+  });","+","+  test('prefers an explicit message', () => {","+    expect(() => yup.string().email('custom message').validateSync('nope')).toThrow(","+      'custom message'","+    );","+  });","+","+  describe('with a custom locale', () => {","+    // eslint-disable-next-line no-template-curly-in-string","+    const defaultMessage = '${path} must be a valid email';","+","+    afterEach(() => {","+      yup.setLocale({ string: { email: defaultMessage } });","+    });","+","+    test('uses the locale message when none is passed', () => {","+      // eslint-disable-next-line no-template-curly-in-string","+      yup.setLocale({ string: { email: '${path} is not an email address' } });","+","+      expect(() => yup.string().email().validateSync('nope')).toThrow(","+        'this is not an email address'","+      );","+    });","+  });","+});"],"additions":117,"deletions":0,"truncated":false},{"path":"packages/core/admin/admin/src/utils/yupEmail.ts","lines":["@@ -0,0 +1,35 @@","+import * as yup from 'yup';","+","+/**","+ * The browser bundle uses stock yup 0.32.9, whose email regex backtracks exponentially on some","+ * short inputs and can freeze the tab: a stored draft email is validated again when another admin","+ * opens Bulk Publish or a release. This is the server's linear pattern from `@strapi/utils`","+ * (`EMAIL_REGEX`); a test checks the two stay identical.","+ */","+export const EMAIL_REGEX =","+  // eslint-disable-next-line no-useless-escape, no-control-regex","+  /^((([a-z]|\\d|[!#\\$%&'\\*\\+\\-\\/=\\?\\^_`{\\|}~]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])+(\\.([a-z]|\\d|[!#\\$%&'\\*\\+\\-\\/=\\?\\^_`{\\|}~]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])+)*)|((\\x22)((((\\x20|\\x09)*(\\x0d\\x0a))?(\\x20|\\x09)+)?(([\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f\\x21\\x23-\\x5b\\x5d-\\x7e\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(\\\\([\\x01-\\x09\\x0b\\x0c\\x0d-\\x7f]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF]))))*(((\\x20|\\x09)*(\\x0d\\x0a))?(\\x20|\\x09)+)?(\\x22)))@((([a-z]|\\d|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(([a-z]|\\d|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])([a-z]|\\d|-|_|~|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])*([a-z]|\\d|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])))\\.)+(([a-z]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(([a-z]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])([a-z]|\\d|-|_|~|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])*([a-z]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])))$/i;","+","+// Stock yup reads the default message from its locale each time `.email()` is called, so","+// `yup.setLocale({ string: { email } })` takes effect. Building a schema with yup's own method and","+// reading the message it stored keeps that behaviour, without running any input through the old","+// regex.","+const yupEmail = yup.StringSchema.prototype.email;","+","+const defaultEmailMessage = () => {","+  const { tests } = yupEmail.call(yup.string());","+  return tests[tests.length - 1].OPTIONS.message;","+};","+","+export function email(","+  this: yup.StringSchema,","+  message: Parameters<yup.StringSchema['email']>[0] = defaultEmailMessage()","+) {","+  return this.matches(EMAIL_REGEX, { name: 'email', message, excludeEmptyString: true });","+}","+","+/**","+ * Applied when the admin entry loads, before any plugin builds a schema, so every `.email()` in","+ * the admin panel uses the linear pattern.","+ */","+yup.addMethod(yup.string, 'email', email);"],"additions":35,"deletions":0,"truncated":false},{"path":"packages/core/content-manager/admin/src/utils/tests/validationEmail.test.ts","lines":["@@ -0,0 +1,42 @@","+import vm from 'node:vm';","+","+import { createYupSchema } from '../validation';","+","+// Runs `fn` with a hard time limit and returns how long it took. A backtracking regex is","+// synchronous and Jest can't interrupt it, so a regression would hang the job instead of failing.","+// The vm timeout stops it mid-match and throws.","+const timedWithLimit = (limitMs: number, fn: () => void) => {","+  const start = process.hrtime.bigint();","+  vm.runInNewContext('fn()', { fn }, { timeout: limitMs });","+  return Number(process.hrtime.bigint() - start) / 1e6;","+};","+","+describe('createYupSchema email attribute', () => {","+  const attributes = { email: { type: 'email' } } as const;","+","+  // Drafts skip the server's email format check, so a stored draft can hold any string. Bulk","+  // Publish and the release screens validate stored entries as soon as they open.","+  // The linear `.email()` is applied globally: in the browser by the admin entry, here by","+  // `@strapi/utils`, which this package's test setup loads. This guards the schema path; the","+  // admin's own tests guard the browser wiring.","+  test.each([","+    ['a domain made of many short labels', `a@${'a.'.repeat(24)}!`],","+    ['an unterminated quoted local part', `\"${'x'.repeat(28)}`],","+  ])('rejects a stored email with %s without freezing', (_, email) => {","+    const schema = createYupSchema(attributes, {}, { status: 'published' });","+","+    let valid = true;","+    const duration = timedWithLimit(1000, () => {","+      valid = schema.isValidSync({ email });","+    });","+","+    expect(valid).toBe(false);","+    expect(duration).toBeLessThan(100);","+  });","+","+  test('accepts a normal stored email', () => {","+    const schema = createYupSchema(attributes, {}, { status: 'published' });","+","+    expect(schema.isValidSync({ email: 'user@example.com' })).toBe(true);","+  });","+});"],"additions":42,"deletions":0,"truncated":false},{"path":"packages/core/utils/src/__tests__/yup-email.test.ts","lines":["@@ -0,0 +1,112 @@","+import vm from 'node:vm';","+import { yup } from '..';","+","+const isValidEmail = (value: string) => yup.string().email().isValidSync(value);","+","+// Runs `fn` with a hard time limit and returns how long it took. A backtracking regex is","+// synchronous and Jest can't interrupt it, so a regression would hang the job instead of failing.","+// The vm timeout stops it mid-match and throws.","+const timedWithLimit = (limitMs: number, fn: () => void) => {","+  const start = process.hrtime.bigint();","+  vm.runInNewContext('fn()', { fn }, { timeout: limitMs });","+  return Number(process.hrtime.bigint() - start) / 1e6;","+};","+","+describe('yup string().email()', () => {","+  test.each([","+    ['a domain made of many short labels', `a@${'a.'.repeat(24)}!`],","+    ['an unterminated quoted local part', `\"${'x'.repeat(28)}`],","+  ])('rejects %s without backtracking', (_, value) => {","+    let result = true;","+    const duration = timedWithLimit(1000, () => {","+      result = isValidEmail(value);","+    });","+","+    expect(result).toBe(false);","+    expect(duration).toBeLessThan(100);","+  });","+","+  test('stays fast on very long input', () => {","+    const duration = timedWithLimit(2000, () => {","+      isValidEmail(`a@${'a.'.repeat(50_000)}!`);","+      isValidEmail(`\"${'x'.repeat(100_000)}`);","+    });","+","+    expect(duration).toBeLessThan(500);","+  });","+","+  test.each([","+    'user@example.com',","+    'first.last@sub.example.co.uk',","+    'user+tag@example.com',","+    'USER@EXAMPLE.COM',","+    'a@b.co',","+    'user@my-domain.example',","+    'user@my_host.example.com',","+    'user@xn--bcher-kva.example',","+    'ünïcödé@exämple.com',","+    '\"john doe\"@example.com',","+    '\"john\\\\\"doe\"@example.com',","+    'user@1example.com',","+  ])('accepts %s', (value) => {","+    expect(isValidEmail(value)).toBe(true);","+  });","+","+  test.each([","+    'plainaddress',","+    '@example.com',","+    'user@',","+    'user@example',","+    'user@-example.com',","+    '.user@example.com',","+    'user.@example.com',","+    'us er@example.com',","+    'user@example.com.',","+  ])('rejects %s', (value) => {","+    expect(isValidEmail(value)).toBe(false);","+  });","+","+  test.each([","+    ['consecutive dots', 'user@sub..example.com'],","+    ['a label starting with a hyphen', 'user@sub.-example.com'],","+    ['a label ending with a hyphen', 'user@sub.example-.com'],","+    ['a top-level label starting with a digit', 'user@mail.example.1com'],","+  ])('rejects a domain with %s, which the stock yup regex let through', (_, value) => {","+    expect(isValidEmail(value)).toBe(false);","+  });","+","+  test('accepts an empty string so optional fields still validate', () => {","+    expect(isValidEmail('')).toBe(true);","+  });","+","+  test('keeps the default error message', () => {","+    expect(() => yup.string().email().validateSync('nope')).toThrow('this must be a valid email');","+  });","+","+  describe('with a custom locale', () => {","+    // eslint-disable-next-line no-template-curly-in-string","+    const defaultMessage = '${path} must be a valid email';","+","+    afterEach(() => {","+      yup.setLocale({ string: { email: defaultMessage } });","+    });","+","+    test('uses the locale message when none is passed', () => {","+      // eslint-disable-next-line no-template-curly-in-string","+      yup.setLocale({ string: { email: '${path} is not an email address' } });","+","+      expect(() => yup.string().email().validateSync('nope')).toThrow(","+        'this is not an email address'","+      );","+    });","+","+    test('prefers an explicit message over the locale', () => {","+      // eslint-disable-next-line no-template-curly-in-string","+      yup.setLocale({ string: { email: '${path} is not an email address' } });","+","+      expect(() => yup.string().email('custom message').validateSync('nope')).toThrow(","+        'custom message'","+      );","+    });","+  });","+});"],"additions":112,"deletions":0,"truncated":false},{"path":"packages/core/utils/src/email-regex.ts","lines":["@@ -0,0 +1,13 @@","+// yup 0.32.9's email regex backtracks exponentially on some short inputs, so one request can block","+// the event loop. This is the same pattern with two changes:","+// - `.` is no longer allowed inside a domain label, only between labels. Labels are still split on","+//   `.`, so the only addresses this now rejects have an empty label, a label that starts or ends","+//   with `-`, `_` or `~`, or a top-level label that starts with a digit.","+// - the quoted local part matches its characters with one class instead of overlapping","+//   alternatives, which the `i` flag made ambiguous for letters. It accepts exactly the same input.","+//","+// The admin keeps a copy of this pattern for the browser (`admin/src/utils/yupEmail.ts` in","+// `@strapi/admin`); a test there checks the two stay identical.","+export const EMAIL_REGEX =","+  // eslint-disable-next-line no-useless-escape, no-control-regex","+  /^((([a-z]|\\d|[!#\\$%&'\\*\\+\\-\\/=\\?\\^_`{\\|}~]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])+(\\.([a-z]|\\d|[!#\\$%&'\\*\\+\\-\\/=\\?\\^_`{\\|}~]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])+)*)|((\\x22)((((\\x20|\\x09)*(\\x0d\\x0a))?(\\x20|\\x09)+)?(([\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f\\x21\\x23-\\x5b\\x5d-\\x7e\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(\\\\([\\x01-\\x09\\x0b\\x0c\\x0d-\\x7f]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF]))))*(((\\x20|\\x09)*(\\x0d\\x0a))?(\\x20|\\x09)+)?(\\x22)))@((([a-z]|\\d|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(([a-z]|\\d|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])([a-z]|\\d|-|_|~|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])*([a-z]|\\d|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])))\\.)+(([a-z]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])|(([a-z]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])([a-z]|\\d|-|_|~|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])*([a-z]|[\\u00A0-\\uD7FF\\uF900-\\uFDCF\\uFDF0-\\uFFEF])))$/i;"],"additions":13,"deletions":0,"truncated":false},{"path":"packages/core/utils/src/index.ts","lines":["@@ -28,6 +28,7 @@ export * as file from './file';"," export * as async from './async';"," export * as policy from './policy';"," export * as yup from './yup';","+export { EMAIL_REGEX } from './email-regex';"," export * as errors from './errors';"," export * as contentTypes from './content-types';"," export * as relations from './relations';"],"additions":1,"deletions":0,"truncated":false},{"path":"packages/core/utils/src/yup.ts","lines":["@@ -4,6 +4,7 @@ import * as yup from 'yup';"," import _, { isNumber, get } from 'lodash';"," import { strings } from './primitives';"," import { printValue } from './print-value';","+import { EMAIL_REGEX } from './email-regex';"," "," export * from 'yup';"," ","@@ -90,6 +91,25 @@ yup.addMethod(","   }"," );"," ","+// Stock yup reads the default message from its locale each time `.email()` is called, so","+// `yup.setLocale({ string: { email } })` takes effect. Building a schema with yup's own method and","+// reading the message it stored keeps that behaviour, without running any input through the old","+// regex.","+const yupEmail = yup.StringSchema.prototype.email;","+","+const defaultEmailMessage = () => {","+  const { tests } = yupEmail.call(yup.string());","+  return tests[tests.length - 1].OPTIONS.message;","+};","+","+yup.addMethod(","+  yup.string,","+  'email',","+  function email(message: Parameters<yup.StringSchema['email']>[0] = defaultEmailMessage()) {","+    return this.matches(EMAIL_REGEX, { name: 'email', message, excludeEmptyString: true });","+  }","+);","+"," export class StrapiIDSchema extends yup.MixedSchema {","   constructor() {","     super({ type: 'strapiID' });",""],"additions":20,"deletions":0,"truncated":false}],"additions":343,"deletions":0,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-03T16:47:50.615844+00:00"}