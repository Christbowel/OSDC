erval","+<envoy_v3_api_field_config.bootstrap.v3.Bootstrap.runtime_stats_eviction_interval>` to read the stats","+eviction interval from a runtime key, allowing it to be changed without restarting Envoy."],"additions":3,"deletions":0,"truncated":false},{"path":"envoy/server/configuration.h","lines":["@@ -93,6 +93,12 @@ class StatsConfig {","    * @return uint32_t a multiple of the flush interval to perform stats eviction, or 0 if disabled.","    */","   virtual uint32_t evictOnFlush() const PURE;","+","+  /**","+   * @return const std::string& the runtime key to read the stats eviction interval (in","+   * milliseconds) from, or empty if the interval is not runtime configurable.","+   */","+  virtual const std::string& evictionIntervalRuntimeKey() const PURE;"," };"," "," /**"],"additions":6,"deletions":0,"truncated":false},{"path":"source/server/configuration_impl.cc","lines":["@@ -83,7 +83,8 @@ bool FilterChainUtility::buildQuicFilterChain("," "," StatsConfigImpl::StatsConfigImpl(const envoy::config::bootstrap::v3::Bootstrap& bootstrap,","                                  absl::Status& status)","-    : deferred_stat_options_(bootstrap.deferred_stat_options()) {","+    : deferred_stat_options_(bootstrap.deferred_stat_options()),","+      eviction_interval_runtime_key_(bootstrap.runtime_stats_eviction_interval().runtime_key()) {","   status = absl::OkStatus();","   if (bootstrap.has_stats_flush_interval() &&","       bootstrap.stats_flush_case() !=","@@ -100,7 +101,10 @@ StatsConfigImpl::StatsConfigImpl(const envoy::config::bootstrap::v3::Bootstrap&","     flush_on_admin_ = bootstrap.stats_flush_on_admin();","   }"," ","-  const auto evict_interval_ms = PROTOBUF_GET_MS_OR_DEFAULT(bootstrap, stats_eviction_interval, 0);","+  const uint64_t evict_interval_ms =","+      bootstrap.has_runtime_stats_eviction_interval()","+          ? bootstrap.runtime_stats_eviction_interval().default_value()","+          : PROTOBUF_GET_MS_OR_DEFAULT(bootstrap, stats_eviction_interval, 0);","   if (evict_interval_ms % flush_interval_.count() != 0) {","     status = absl::InvalidArgumentError(","         \"stats_eviction_interval must be a multiple of stats_flush_interval\");"],"additions":6,"deletions":2,"truncated":false},{"path":"source/server/configuration_impl.h","lines":["@@ -57,6 +57,9 @@ class StatsConfigImpl : public StatsConfig {","   std::chrono::milliseconds flushInterval() const override { return flush_interval_; }","   bool flushOnAdmin() const override { return flush_on_admin_; }","   uint32_t evictOnFlush() const override { return evict_on_flush_; }","+  const std::string& evictionIntervalRuntimeKey() const override {","+    return eviction_interval_runtime_key_;","+  }"," ","   void addSink(Stats::SinkPtr sink) { sinks_.emplace_back(std::move(sink)); }","   bool enableDeferredCreationStats() const override {","@@ -69,6 +72,7 @@ class StatsConfigImpl : public StatsConfig {","   bool flush_on_admin_{false};","   const envoy::config::bootstrap::v3::Bootstrap::DeferredStatOptions deferred_stat_options_;","   uint32_t evict_on_flush_{0};","+  const std::string eviction_interval_runtime_key_;"," };"," "," /**"],"additions":4,"deletions":0,"truncated":false},{"path":"source/server/server.cc","lines":["@@ -305,7 +305,21 @@ void InstanceBase::flushStatsInternal() {","   ASSERT(config_.clusterManager() != nullptr);","   InstanceUtil::flushMetricsToSinks(stats_config.sinks(), stats_store_, *config_.clusterManager(),","                                     time_source_);","-  if (const auto evict_on_flush = stats_config.evictOnFlush(); evict_on_flush > 0) {","+  uint32_t evict_on_flush = stats_config.evictOnFlush();","+  if (const auto& runtime_key = stats_config.evictionIntervalRuntimeKey();","+      !runtime_key.empty() && runtime_ != nullptr) {","+    const uint64_t flush_ms = stats_config.flushInterval().count();","+    const uint64_t evict_ms =","+        runtime_->snapshot().getInteger(runtime_key, evict_on_flush * flush_ms);","+    if (flush_ms != 0 && evict_ms % flush_ms == 0 && evict_ms / flush_ms <= UINT32_MAX) {","+      evict_on_flush = evict_ms / flush_ms;","+    } else {","+      ENVOY_LOG(debug,","+                \"ignoring invalid stats eviction interval {}ms from runtime key {}, using default\",","+                evict_ms, runtime_key);","+    }","+  }","+  if (evict_on_flush > 0) {","     stats_eviction_counter_ = (stats_eviction_counter_ + 1) % evict_on_flush;","     if (stats_eviction_counter_ == 0) {","       stats_store_.evictUnused();"],"additions":15,"deletions":1,"truncated":false},{"path":"test/mocks/server/server_factory_context.h","lines":["@@ -51,6 +51,7 @@ class MockStatsConfig : public virtual StatsConfig {","   MOCK_METHOD(const Stats::SinkPredicates*, sinkPredicates, (), (const));","   MOCK_METHOD(bool, enableDeferredCreationStats, (), (const));","   MOCK_METHOD(uint32_t, evictOnFlush, (), (const));","+  MOCK_METHOD(const std::string&, evictionIntervalRuntimeKey, (), (const));"," };"," "," class MockServerFactoryContext : public virtual ServerFactoryContext {"],"additions":1,"deletions":0,"truncated":false},{"path":"test/server/configuration_impl_test.cc","lines":["@@ -239,6 +239,41 @@ TEST_F(ConfigurationImplTest, Eviction) {","   EXPECT_EQ(3, config.statsConfig().evictOnFlush());"," }"," ","+TEST_F(ConfigurationImplTest, EvictionRuntimeKey) {","+  std::string json = R\"EOF(","+  {","+    \"stats_flush_interval\": \"0.500s\",","+    \"runtime_stats_eviction_interval\": {","+      \"default_value\": 1500,","+      \"runtime_key\": \"stats.eviction_interval_ms\"","+    }","+  }","+  )EOF\";","+","+  auto bootstrap = Upstream::parseBootstrapFromV3Json(json);","+  MainImpl config;","+  EXPECT_OK(config.initialize(bootstrap, server_, cluster_manager_factory_));","+  EXPECT_EQ(3, config.statsConfig().evictOnFlush());","+  EXPECT_EQ(\"stats.eviction_interval_ms\", config.statsConfig().evictionIntervalRuntimeKey());","+}","+","+TEST_F(ConfigurationImplTest, EvictionRuntimeKeyDefaultNotMultiple) {","+  std::string json = R\"EOF(","+  {","+    \"stats_flush_interval\": \"0.500s\",","+    \"runtime_stats_eviction_interval\": {","+      \"default_value\": 750,","+      \"runtime_key\": \"stats.eviction_interval_ms\"","+    }","+  }","+  )EOF\";","+","+  auto bootstrap = Upstream::parseBootstrapFromV3Json(json);","+  MainImpl config;","+  EXPECT_THAT(config.initialize(bootstrap, server_, cluster_manager_factory_).message(),","+              testing::HasSubstr(\"must be a multiple\"));","+}","+"," TEST_F(ConfigurationImplTest, EvictionNotMultiple) {","   std::string json = R\"EOF(","   {"],"additions":35,"deletions":0,"truncated":false},{"path":"test/server/server_test.cc","lines":["@@ -1043,6 +1043,56 @@ TEST_P(ServerInstanceImplTest, EvictStats) {","   server_thread->join();"," }"," ","+TEST_P(ServerInstanceImplTest, EvictStatsRuntimeKey) {","+  CustomStatsSinkFactory factory;","+  Registry::InjectFactory<Server::Configuration::StatsSinkFactory> registered(factory);","+  auto server_thread =","+      startTestServer(\"test/server/test_data/server/stats_evict_runtime_bootstrap.yaml\", true);","+  EXPECT_EQ(2, server_->statsConfig().evictOnFlush());","+  EXPECT_EQ(\"stats.eviction_interval_ms\", server_->statsConfig().evictionIntervalRuntimeKey());","+","+  auto counter = TestUtility::findCounter(stats_store_, \"stats.flushed\");","+","+  // Runtime sets a 10s interval with a 5s flush: evict every second flush.","+  time_system_.advanceTimeWait(std::chrono::seconds(6));","+  EXPECT_EQ(1L, counter->value());","+  EXPECT_EQ(0, stats_store_.evictionCount());","+","+  time_system_.advanceTimeWait(std::chrono::seconds(6));","+  EXPECT_EQ(2L, counter->value());","+  EXPECT_EQ(1, stats_store_.evictionCount());","+","+  // A value that is not a multiple of the flush interval falls back to the 10s default.","+  {","+    absl::Notification updated;","+    server_->dispatcher().post([&] {","+      EXPECT_OK(server_->runtime().mergeValues({{\"stats.eviction_interval_ms\", \"7500\"}}));","+      updated.Notify();","+    });","+    updated.WaitForNotification();","+  }","+  time_system_.advanceTimeWait(std::chrono::seconds(6));","+  time_system_.advanceTimeWait(std::chrono::seconds(6));","+  EXPECT_EQ(4L, counter->value());","+  EXPECT_EQ(2, stats_store_.evictionCount());","+","+  // A 5s interval evicts on every flush. Stop at 28s to avoid racing the flush at 30s.","+  {","+    absl::Notification updated;","+    server_->dispatcher().post([&] {","+      EXPECT_OK(server_->runtime().mergeValues({{\"stats.eviction_interval_ms\", \"5000\"}}));","+      updated.Notify();","+    });","+    updated.WaitForNotification();","+  }","+  time_system_.advanceTimeWait(std::chrono::seconds(4));","+  EXPECT_EQ(5L, counter->value());","+  EXPECT_EQ(3, stats_store_.evictionCount());","+","+  server_->dispatcher().post([&] { server_->shutdown(); });","+  server_thread->join();","+}","+"," TEST_P(ServerInstanceImplTest, ConcurrentFlushes) {","   CustomStatsSinkFactory factory;","   Registry::InjectFactory<Server::Configuration::StatsSinkFactory> registered(factory);"],"additions":50,"deletions":0,"truncated":false},{"path":"test/server/test_data/server/stats_evict_runtime_bootstrap.yaml","lines":["@@ -0,0 +1,21 @@","+node:","+  id: bootstrap_id","+  cluster: bootstrap_cluster","+  locality:","+    zone: bootstrap_zone","+    sub_zone: bootstrap_sub_zone","+stats_sinks:","+- name: envoy.custom_stats_sink","+  typed_config:","+    \"@type\": type.googleapis.com/google.protobuf.Struct","+runtime_stats_eviction_interval:","+  default_value: 10000","+  runtime_key: stats.eviction_interval_ms","+layered_runtime:","+  layers:","+  - name: static_layer","+    static_layer:","+      stats:","+        eviction_interval_ms: 10000","+  - name: admin","+    admin_layer: {}",""],"additions":21,"deletions":0,"truncated":false}],"additions":152,"deletions":4,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-10-24T12:59:19.644160+00:00"}