: `GPUTextLayer`","+","+Inputs are borrowed. Paths use storage buffers; polygon fills currently use vertex attributes. Text rendering depends on the supplied luma.gl text strategy.","+","+Each subpath also exports `GPUVectorLayerPickingInfo` for the picking provenance exposed by these layers.","+These layers previously lived in `@deck.gl-community/gpu-layers`; update imports to the subpaths above."],"additions":13,"deletions":0,"truncated":false},{"path":"modules/proposed-layers/package.json","lines":["@@ -0,0 +1,46 @@","+{","+  \"name\": \"@deck.gl/proposed-layers\",","+  \"version\": \"10.0.0-alpha.3\",","+  \"private\": true,","+  \"description\": \"WebGPU layer counterparts for GPU-resident data\",","+  \"license\": \"MIT\",","+  \"repository\": {","+    \"type\": \"git\",","+    \"url\": \"https://github.com/visgl/deck.gl.git\"","+  },","+  \"type\": \"module\",","+  \"exports\": {","+    \"./path-layer\": {","+      \"types\": \"./dist/path-layer/path-layer.d.ts\",","+      \"import\": \"./dist/path-layer/path-layer.js\",","+      \"require\": \"./dist/path-layer/path-layer.cjs\"","+    },","+    \"./polygon-layer\": {","+      \"types\": \"./dist/polygon-layer/polygon-layer.d.ts\",","+      \"import\": \"./dist/polygon-layer/polygon-layer.js\",","+      \"require\": \"./dist/polygon-layer/polygon-layer.cjs\"","+    },","+    \"./solid-polygon-layer\": {","+      \"types\": \"./dist/solid-polygon-layer/solid-polygon-layer.d.ts\",","+      \"import\": \"./dist/solid-polygon-layer/solid-polygon-layer.js\",","+      \"require\": \"./dist/solid-polygon-layer/solid-polygon-layer.cjs\"","+    },","+    \"./text-layer\": {","+      \"types\": \"./dist/text-layer/text-layer.d.ts\",","+      \"import\": \"./dist/text-layer/text-layer.js\",","+      \"require\": \"./dist/text-layer/text-layer.cjs\"","+    }","+  },","+  \"files\": [","+    \"src\",","+    \"dist\",","+    \"README.md\"","+  ],","+  \"sideEffects\": false,","+  \"dependencies\": {","+    \"@deck.gl/core\