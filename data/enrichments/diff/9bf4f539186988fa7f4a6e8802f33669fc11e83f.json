{"id":"9bf4f539186988fa7f4a6e8802f33669fc11e83f","axis":"silent","repo":"TryGhost/Ghost","sha":"9bf4f539186988fa7f4a6e8802f33669fc11e83f","parsed":{"files":[{"path":".dependency-cruiser.cjs","lines":["@@ -30,6 +30,7 @@ const serviceDependencyAllowlist = [","   '(^|/)node_modules/zod/|^zod$', // Schema construction and validation.","   '(^|/)node_modules/bson-objectid/|^bson-objectid$', // ObjectId generation and conversion.","   '^@tryghost/app-contracts/manifest$|^packages/app-contracts/(src|build)/manifest/index\\\\.(ts|js)$', // Shared manifest schemas and validation.","+  '^@tryghost/adapter-base-upgrade$|^packages/adapters/upgrade-base/(src|build)/index\\\\.(ts|js)$', // Upgrade adapter contract schemas and error class.","   '^(node:)?crypto$', // Cryptographic algorithms and key generation.","   '^(node:)?util$', // Node utilities, including promisify.","   '^ghost/core/kernel/clock\\\\.ts$', // Shared clock helpers and legacy date compatibility."],"additions":1,"deletions":0,"truncated":false},{"path":".oxlintrc.json","lines":["@@ -206,7 +206,8 @@","         \"ghost/core/server/services/internal-keys/index.ts\",","         \"ghost/core/server/services/posts-public/index.ts\",","         \"ghost/core/server/services/signing-keys/index.ts\",","-        \"ghost/core/server/services/slack-ping/index.ts\"","+        \"ghost/core/server/services/slack-ping/index.ts\",","+        \"ghost/core/server/services/upgrades/index.ts\"","       ],","       \"rules\": {","         \"ghost/service-root-shape\": ["],"additions":2,"deletions":1,"truncated":false},{"path":"ghost/core/boot.js","lines":["@@ -366,6 +366,7 @@ async function initServices({ ghostServer, config, prometheusClient, jobsService","   const tiers = require('./server/services/tiers');","   const permissions = require('./server/services/permissions');","   const indexnow = require('./server/services/indexnow-ping').default;","+  const upgrades = require('./server/services/upgrades').default;","   const slack = require('./server/services/slack-ping').default;","   const webhooks = require('./server/services/webhooks');","   const postScheduling = require('./server/services/post-scheduling').default;","@@ -436,6 +437,7 @@ async function initServices({ ghostServer, config, prometheusClient, jobsService","     membersEvents.init(),","     permissions.init(),","     indexnow.init(),","+    upgrades.init(),","     slack.init(),","     audienceFeedback.init(),","     emailService.init({ ghostServer, jobsService }),"],"additions":2,"deletions":0,"truncated":false},{"path":"ghost/core/server/api/endpoints/index.js","lines":["@@ -176,6 +176,10 @@ module.exports = {","     return apiFramework.pipeline(require('./tags'), localUtils);","   },"," ","+  get upgrades() {","+    return apiFramework.pipeline(require('./upgrades'), localUtils);","+  },","+","   get users() {","     return apiFramework.pipeline(require('./users'), localUtils);","   },"],"additions":4,"deletions":0,"truncated":false},{"path":"ghost/core/server/api/endpoints/upgrades.ts","lines":["@@ -0,0 +1,111 @@","+import type { Controller, Frame } from '@tryghost/api-framework';","+import errors from '@tryghost/errors';","+import snakecaseKeys from 'snakecase-keys';","+import { z } from 'zod';","+import {","+  upgradeComponentSchema,","+  upgradeJobIdSchema,","+  upgradeVersionSchema,","+} from '@tryghost/adapter-base-upgrade';","+import upgrades from '../../services/upgrades';","+","+// Unknown keys are rejected, not stripped: a dropped execution control would otherwise go unnoticed.","+const UpgradeRequestBody = z","+  .object({","+    upgrades: z.tuple([","+      z","+        .object({","+          component: upgradeComponentSchema,","+          to_version: upgradeVersionSchema,","+          idempotency_key: z.uuid({ version: 'v4' }).lowercase(),","+        })","+        .strict(),","+    ]),","+  })","+  .strict();","+","+const JobOptions = z.object({ id: upgradeJobIdSchema });","+","+type UpgradeFrame = Frame<{","+  data: Record<string, unknown>;","+  options: { id?: unknown; context: { user?: string | null } };","+}>;","+","+function parseRequest(frame: UpgradeFrame) {","+  const parsed = UpgradeRequestBody.safeParse(frame.data);","+  if (!parsed.success) {","+    throw new errors.ValidationError({","+      message: 'Expected one update with component, to_version and idempotency_key.',","+      help: 'Generate a lowercase UUID v4 idempotency_key once and reuse it when retrying.',","+    });","+  }","+  return parsed.data.upgrades[0];","+}","+","+function parseJobId(frame: UpgradeFrame) {","+  const parsed = JobOptions.safeParse(frame.options);","+  if (!parsed.success) {","+    throw new errors.ValidationError({ message: 'Expected a job id from this host.' });","+  }","+  return parsed.data.id;","+}","+","+// The adapter contract is camelCase; the Admin API is snake_case.","+const toApi = <T extends Record<string, unknown>>(resource: T) =>","+  snakecaseKeys(resource, { deep: true });","+","+const noCacheInvalidation = { cacheInvalidate: false };","+","+const controller = {","+  docName: 'upgrades',","+","+  browse: {","+    headers: noCacheInvalidation,","+    permissions: true,","+    async query() {","+      return toApi(await upgrades.service.getStatus());","+    },","+  },","+","+  add: {","+    headers: { ...noCacheInvalidation, location: false },","+    statusCode: 202,","+    // A validation function replaces the framework's defaults, which expect resource bodies.","+    validation(frame) {","+      parseRequest(frame);","+    },","+    permissions: true,","+    async query(frame) {","+      const input = parseRequest(frame);","+      const user = frame.options.context.user;","+      if (!user) {","+        throw new errors.NoPermissionError({ message: 'Only staff users can request updates.' });","+      }","+","+      const job = await upgrades.service.createRequest(","+        {","+          component: input.component,","+          toVersion: input.to_version,","+          idempotencyKey: input.idempotency_key,","+        },","+        user,","+      );","+      return toApi(job);","+    },","+  },","+","+  read: {","+    headers: noCacheInvalidation,","+    options: ['id'],","+    // The framework's id validator only accepts ObjectIds; jobs use UUIDs.","+    validation(frame) {","+      parseJobId(frame);","+    },","+    permissions: true,","+    async query(frame) {","+      return toApi(await upgrades.service.getJob(parseJobId(frame)));","+    },","+  },","+} satisfies Controller<{ browse: UpgradeFrame; add: UpgradeFrame; read: UpgradeFrame }>;","+","+module.exports = controller;"],"additions":111,"deletions":0,"truncated":false},{"path":"ghost/core/server/data/migrations/versions/6.72/2026-10-15-15-11-28-add-upgrade-permissions.js","lines":["@@ -0,0 +1,32 @@","+const { combineTransactionalMigrations, addPermissionWithRoles } = require('../../utils');","+","+const RESOURCE = 'upgrade';","+","+// Only Administrators (and the Owner, who needs no grant) can request host-managed","+// updates. Integrations get none.","+module.exports = combineTransactionalMigrations(","+  addPermissionWithRoles(","+    {","+      name: 'Browse upgrades',","+      action: 'browse',","+      object: RESOURCE,","+    },","+    ['Administrator'],","+  ),","+  addPermissionWithRoles(","+    {","+      name: 'Read upgrades',","+      action: 'read',","+      object: RESOURCE,","+    },","+    ['Administrator'],","+  ),","+  addPermissionWithRoles(","+    {","+      name: 'Add upgrades',","+      action: 'add',","+      object: RESOURCE,","+    },","+    ['Administrator'],","+  ),","+);"],"additions":32,"deletions":0,"truncated":false},{"path":"ghost/core/server/data/schema/fixtures/fixtures.json","lines":["@@ -849,6 +849,21 @@","           \"name\": \"Delete app installations\",","           \"action_type\": \"destroy\",","           \"object_type\": \"app_installation\"","+        },","+        {","+          \"name\": \"Browse upgrades\",","+          \"action_type\": \"browse\",","+          \"object_type\": \"upgrade\"","+        },","+        {","+          \"name\": \"Read upgrades\",","+          \"action_type\": \"read\",","+          \"object_type\": \"upgrade\"","+        },","+        {","+          \"name\": \"Add upgrades\",","+          \"action_type\": \"add\",","+          \"object_type\": \"upgrade\"","         }","       ]","     },","@@ -1014,7 +1029,8 @@","           \"gift_link\": \"all\",","           \"app_installation\": \"all\",","           \"automation\": [\"browse\", \"read\", \"edit\", \"add\"],","-          \"identity\": \"read\"","+          \"identity\": \"read\",","+          \"upgrade\": [\"browse\", \"read\", \"add\"]","         },","         \"DB Backup Integration\": {","           \"db\": \"all\","],"additions":17,"deletions":1,"truncated":false},{"path":"ghost/core/server/services/permissions/permissions-data.ts","lines":["@@ -54,6 +54,7 @@ export const permissions = {","   gift: ['flushReminders', 'flushDeliveries'],","   gift_link: ['manage', 'removeAll'],","   app_installation: ['browse', 'read', 'add', 'destroy'],","+  upgrade: ['browse', 'read', 'add'],"," } as const satisfies Record<string, readonly string[]>;"," "," export type ObjectType = keyof typeof permissions;","@@ -105,6 +106,7 @@ export const rolePermissions = {","     app_installation: 'all',","     automation: ['browse', 'read', 'edit', 'add'],","     identity: ['read'],","+    upgrade: ['browse', 'read', 'add'],","   },","   'DB Backup Integration': {","     db: 'all',"],"additions":2,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/service-inventory.yaml","lines":["@@ -15324,6 +15324,67 @@ services:","         work, including shutdown timeout and late completion. Existing tests do not prove","         transport release or cancellation, and the one-second request option is not evidence","         of an overall deadline or of dependency-level retry/socket cleanup behavior.","+  upgrades:","+    kind: directory","+    disposition: retain","+    status: auditing","+    migrated: true","+    migration:","+      complexity: straightforward","+      modelImpact: fits","+      reason: >-","+        Added on the shared initializer. The factory composes one resource-free service that","+        resolves the configured upgrade adapter per call, so boot never contacts the host.","+      reviewedAt: 1b10a390b8a23a60509e1a118da6186c3d584846","+      sources:","+        - core/server/services/upgrades/index.ts","+        - core/server/services/upgrades/upgrade-service.ts","+        - core/server/api/endpoints/upgrades.ts","+        - core/boot.js","+    entryPoints:","+      - upgrades/index.ts","+    notes: >-","+      Composition-only boundary between the Admin API and a host-owned upgrade adapter.","+      Ghost validates adapter output and maps adapter rejections; it never executes updates.","+    contracts:","+      exports:","+        summary: >-","+          The TypeScript default export is a defineService root with async init and a guarded","+          service getter. The implementation exports UpgradeService for direct construction.","+        sources:","+          - core/server/services/upgrades/index.ts","+          - core/server/services/upgrades/upgrade-service.ts","+        tests:","+          - test/unit/server/services/upgrades/index.test.ts","+          - test/unit/server/services/upgrades/upgrade-service.test.ts","+      construction:","+        summary: >-","+          Boot awaits init in its required service Promise.all. The factory constructs one","+          UpgradeService from an adapter getter and a logger, without adapter or host I/O.","+        sources:","+          - core/server/services/upgrades/index.ts","+          - core/boot.js","+        tests:","+          - test/unit/server/services/upgrades/index.test.ts","+      configuration:","+        summary: >-","+          Every call asks the adapter manager for the active adapters.upgrade adapter, so","+          switching adapters applies without re-initializing. The manager caches each","+          instance with its construction-time options, so option changes apply only after","+          its cache is cleared.","+        sources:","+          - core/server/services/upgrades/index.ts","+          - core/server/services/adapter-manager/index.ts","+        tests:","+          - test/unit/server/services/adapter-manager/upgrade-wiring.test.ts","+          - test/e2e-api/admin/upgrades.test.ts","+    unverified:","+      - consumers","+      - startup","+      - lifetime","+      - resources","+      - failures","+    blockers: []","   url:","     kind: directory","     disposition: retain"],"additions":61,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/upgrades/README.md","lines":["@@ -0,0 +1,55 @@","+# Host-managed upgrades","+","+Ghost delegates updates to the configured `upgrade` adapter (see","+[`@tryghost/adapter-base-upgrade`](../../../../../packages/adapters/upgrade-base/README.md)).","+Hosts set `adapters.upgrade.active` and the adapter's options in server","+configuration. The default `NoopUpgradeAdapter` reports updates as not","+configured, so the host's configuration is the only capability gate.","+","+## Admin API","+","+Only the Owner and Administrators can use these endpoints, with a session or","+staff token. Integrations cannot.","+","+These are an internal API for Ghost Admin, not part of the public Admin API:","+they are undocumented and can change without notice.","+","+| Request                              | Result                                                         |","+| ------------------------------------ | -------------------------------------------------------------- |","+| `GET /ghost/api/admin/upgrades/`     | `{upgrades: [status]}`                                         |","+| `POST /ghost/api/admin/upgrades/`    | HTTP 202 with `{upgrades: [job]}`                              |","+| `GET /ghost/api/admin/upgrades/:id/` | `{upgrades: [job]}`, including `unknown` and `expired` lookups |","+","+The API uses snake_case keys (`one_click`, `to_version`, `poll_after_ms`, ...);","+the adapter contract is camelCase.","+","+POST accepts exactly","+`{upgrades: [{component: \"ghost\", to_version: \"6.71.0\", idempotency_key: \"<uuid v4>\"}]}`","+and rejects any other key. Generate one lowercase UUID v4 per intended update","+and reuse it when retrying after a lost response or a 429. Ghost hashes the key","+with the staff user's ID before passing it to the adapter, so users cannot see","+or replay each other's requests. Versions are opaque to Ghost: prereleases,","+nightlies and host build labels pass through unchanged.","+","+Adapter rejections map to `UPGRADE_UNSUPPORTED` (409), `UPGRADE_BUSY` (409),","+`UPGRADE_TARGET_UNAPPROVED` (422), `UPGRADE_IDEMPOTENCY_CONFLICT` (409),","+`UPGRADE_REQUEST_EXPIRED` (409) and `UPGRADE_UNAVAILABLE` (503), with any","+diagnostics in `errors[].details.diagnostics`. Unexpected adapter errors and","+invalid adapter output are logged and returned as `UPGRADE_UNAVAILABLE`.","+","+`GET /upgrades/` never fails because of the host: an adapter failure is reported","+as `{supported: true, availability: \"unavailable\"}`. Admin treats any 503 as","+Ghost itself being under maintenance, so status checks must not return one.","+","+## Rate limits","+","+Two database-backed limiters protect these routes across Ghost instances:","+","+- `spam.upgrade_api_block` limits all three routes per IP before","+  authentication: 600 requests a minute by default, enough for several staff","+  polling tabs behind one IP. Each request writes to the `brute` table.","+- `spam.upgrade_block` limits POSTs per staff user: three a minute by default,","+  across IPs. Retries with the same key count too.","+","+Both return 429 with `Retry-After`. Clients should respect `poll_after_ms` and","+stop polling jobs in a final state."],"additions":55,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/upgrades/index.ts","lines":["@@ -0,0 +1,14 @@","+import logging from '@tryghost/logging';","+import { defineService } from '../../../kernel/define-service';","+import adapterManager from '../adapter-manager';","+import { UpgradeService } from './upgrade-service';","+","+// The adapter is resolved per call, so construction never contacts the host.","+export default defineService(","+  'Upgrades',","+  () =>","+    new UpgradeService({","+      getAdapter: () => adapterManager.getAdapter('upgrade'),","+      logError: (error) => logging.error(error),","+    }),","+);"],"additions":14,"deletions":0,"truncated":false},{"path":"ghost/core/server/services/upgrades/upgrade-service.ts","lines":["@@ -0,0 +1,168 @@","+import { createHash } from 'node:crypto';","+import errors from '@tryghost/errors';","+import {","+  UpgradeAdapterError,","+  upgradeDiagnosticsSchema,","+  upgradeErrorCodeSchema,","+  upgradeJobResultSchema,","+  upgradeJobSchema,","+  upgradeStatusSchema,","+  type UpgradeBase,","+  type UpgradeErrorCode,","+} from '@tryghost/adapter-base-upgrade';","+","+export interface UpgradeRequestInput {","+  component: string;","+  toVersion: string;","+  /** Client-generated UUID v4; scoped to the staff user before it reaches the adapter. */","+  idempotencyKey: string;","+}","+","+type RejectionSpec = {","+  Error: typeof errors.MaintenanceError;","+  code: string;","+  message: string;","+  help: string;","+};","+","+const unavailable = {","+  Error: errors.MaintenanceError,","+  code: 'UPGRADE_UNAVAILABLE',","+  message: 'The update service is temporarily unavailable.',","+  help: 'Retry later. Reuse the same idempotency_key if an update request lost its response.',","+} satisfies RejectionSpec;","+","+const rejections = {","+  unsupported: {","+    Error: errors.DisabledFeatureError,","+    code: 'UPGRADE_UNSUPPORTED',","+    message: 'This host does not support updating Ghost from Admin.',","+    help: 'Ask your host to configure an upgrade adapter.',","+  },","+  unavailable,","+  busy: {","+    Error: errors.ConflictError,","+    code: 'UPGRADE_BUSY',","+    message: 'An update is already in progress.',","+    help: 'Wait for the active job to finish before requesting another update.',","+  },","+  'target-unapproved': {","+    Error: errors.ValidationError,","+    code: 'UPGRADE_TARGET_UNAPPROVED',","+    message: 'This update is not available as a one-click update.',","+    help: 'Refresh the available updates before choosing one.',","+  },","+  'idempotency-conflict': {","+    Error: errors.ConflictError,","+    code: 'UPGRADE_IDEMPOTENCY_CONFLICT',","+    message: 'This idempotency_key was already used for a different update.',","+    help: 'Use a new idempotency_key for a new update request.',","+  },","+  'request-expired': {","+    Error: errors.ConflictError,","+    code: 'UPGRADE_REQUEST_EXPIRED',","+    message: 'This update request has expired.',","+    help: 'Check the outcome of the earlier request before making a new one.',","+  },","+} satisfies Record<UpgradeErrorCode, RejectionSpec>;","+","+/** The host owns acceptance and execution; this class owns Ghost's public boundary. */","+export class UpgradeService {","+  readonly #getAdapter: () => UpgradeBase;","+  readonly #logError: (error: Error) => void;","+","+  constructor({","+    getAdapter,","+    logError,","+  }: {","+    getAdapter: () => UpgradeBase;","+    logError: (error: Error) => void;","+  }) {","+    this.#getAdapter = getAdapter;","+    this.#logError = logError;","+  }","+","+  /** Never rejects: an unreachable host is a status for Admin to show, not an API error. */","+  async getStatus() {","+    try {","+      return upgradeStatusSchema.parse(await this.#getAdapter().getStatus());","+    } catch (error) {","+      if (!(error instanceof UpgradeAdapterError && error.code === 'unavailable')) {","+        this.#logError(","+          new errors.InternalServerError({","+            message: 'The upgrade adapter failed during getStatus.',","+            err: error instanceof Error ? error : undefined,","+          }),","+        );","+      }","+      return upgradeStatusSchema.parse({ supported: true, availability: 'unavailable' });","+    }","+  }","+","+  async createRequest(input: UpgradeRequestInput, userId: string) {","+    // Two staff users must never share, or be able to guess, each other's intents.","+    const idempotencyKey = createHash('sha256')","+      .update(JSON.stringify([userId, input.idempotencyKey]))","+      .digest('hex');","+","+    try {","+      const job = upgradeJobSchema.parse(","+        await this.#getAdapter().createRequest({","+          component: input.component,","+          toVersion: input.toVersion,","+          idempotencyKey,","+        }),","+      );","+","+      if (job.component !== input.component || job.toVersion !== input.toVersion) {","+        throw new errors.IncorrectUsageError({","+          message: 'The accepted job does not match the requested update.',","+        });","+      }","+","+      return job;","+    } catch (error) {","+      return this.#fail(error, 'createRequest');","+    }","+  }","+","+  async getJob(id: string) {","+    try {","+      const job = upgradeJobResultSchema.parse(await this.#getAdapter().getJob(id));","+","+      if (job.id !== id) {","+        throw new errors.IncorrectUsageError({ message: 'Lookup returned a different job.' });","+      }","+","+      return job;","+    } catch (error) {","+      return this.#fail(error, 'getJob');","+    }","+  }","+","+  #fail(error: unknown, operation: string): never {","+    if (error instanceof UpgradeAdapterError) {","+      const code = upgradeErrorCodeSchema.safeParse(error.code);","+      const diagnostics = upgradeDiagnosticsSchema.optional().safeParse(error.diagnostics);","+","+      if (code.success && diagnostics.success) {","+        const { Error: Rejection, ...rejection } = rejections[code.data];","+        throw