      spec, _collections.lookupCollection(spec.nss), _opCtx, _technique, sbeYieldPolicy.get());"],"additions":2,"deletions":27,"truncated":false},{"path":"src/mongo/db/query/compiler/stats/BUILD.bazel","lines":["@@ -43,20 +43,21 @@ mongo_cc_library("," )"," "," mongo_cc_library(","-    name = \"scalar_field_values\",","-    srcs = [\"scalar_field_values.cpp\"],","-    hdrs = [\"scalar_field_values.h\"],","+    name = \"field_values\",","+    srcs = [\"field_values.cpp\"],","+    hdrs = [\"field_values.h\"],","     deps = [","         \"//src/mongo/db:sbe_values\",","         \"//src/mongo/db/pipeline:field_path\",","+        \"//src/mongo/db/query/bson:multikey_dotted_path_support\",","     ],"," )"," "," mongo_cc_unit_test(","-    name = \"scalar_field_values_test\",","-    srcs = [\"scalar_field_values_test.cpp\"],","-    tags = [\"mongo_unittest_third_group\"],","-    deps = [\":scalar_field_values\"],","+    name = \"field_values_test\",","+    srcs = [\"field_values_test.cpp\"],","+    tags = [\"mongo_unittest_seventh_group\"],","+    deps = [\":field_values\"],"," )"," "," mongo_cc_library("],"additions":8,"deletions":7,"truncated":false},{"path":"src/mongo/db/query/compiler/stats/field_values.cpp","lines":["@@ -0,0 +1,54 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/query/compiler/stats/field_values.h\"","+","+#include \"mongo/db/exec/sbe/values/bson.h\"","+#include \"mongo/db/index/multikey_paths.h\"","+#include \"mongo/db/query/bson/multikey_dotted_path_support.h\"","+#include \"mongo/util/assert_util.h\"","+","+#include <algorithm>","+","+namespace mongo::stats {","+","+std::pair<std::vector<FieldValueTuple>, bool> extractFieldValues(const BSONObj& doc,","+                                                                 std::span<const FieldPath> paths) {","+    constexpr size_t kMaxTuplesPerDocument = 100'000;","+","+    std::vector<FieldValueTuple> tuples(1);","+    MultikeyComponents arrayComponents;","+    for (const auto& path : paths) {","+        BSONElementSet elements;","+        multikey_dotted_path_support::extractAllElementsAlongPath(","+            doc,","+            path.fullPath(),","+            elements,","+            /*expandArrayOnTrailingField=*/true,","+            &arrayComponents);","+","+        const auto numValues = std::max<size_t>(elements.size(), 1);","+        uassert(ErrorCodes::ExceededMemoryLimit,","+                \"Field value tuple count exceeds the per-document limit of 100000\",","+                tuples.size() <= kMaxTuplesPerDocument / numValues);","+","+        std::vector<FieldValueTuple> expanded;","+        expanded.reserve(tuples.size() * numValues);","+","+        for (const auto& tuple : tuples) {","+            if (elements.empty()) {","+                expanded.push_back(tuple);","+                expanded.back().push_back(sbe::value::TagValueView::nothing());","+            }","+            for (const auto& element : elements) {","+                expanded.push_back(tuple);","+                expanded.back().push_back(sbe::bson::convertToView(element));","+            }","+        }","+","+        tuples = std::move(expanded);","+    }","+    return {std::move(tuples), !arrayComponents.empty()};","+}","+","+}  // namespace mongo::stats"],"additions":54,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/stats/field_values.h","lines":["@@ -0,0 +1,32 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#pragma once","+","+#include \"mongo/bson/bsonobj.h\"","+#include \"mongo/db/exec/sbe/values/value.h\"","+#include \"mongo/db/pipeline/field_path.h\"","+","+#include <span>","+#include <utility>","+#include <vector>","+","+#include <absl/container/inlined_vector.h>","+","+namespace mongo::stats {","+","+using FieldValueTuple = absl::InlinedVector<sbe::value::TagValueView, 3>;","+","+/**","+ * Extracts borrowed SBE views of the values at 'paths' in 'doc'; 'doc' must outlive the returned","+ * views. Arrays along a path are traversed as in a multikey index, and every distinct value found","+ * is returned, so a document can produce several tuples: the cross product of the values of each","+ * path, each tuple in path order. A path that resolves to no value contributes Nothing.","+ * The second result is true if any requested path encounters an array, including trailing and","+ * empty arrays, even when all extracted values are scalar.","+ * Throws ExceededMemoryLimit if a document would produce more than 100,000 tuples.","+ */","+std::pair<std::vector<FieldValueTuple>, bool> extractFieldValues(const BSONObj& doc,","+                                                                 std::span<const FieldPath> paths);","+","+}  // namespace mongo::stats"],"additions":32,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/stats/field_values_test.cpp","lines":["@@ -0,0 +1,93 @@","+// Copyright (c) MongoDB, Inc.","+// SPDX-License-Identifier: SSPL-1.0","+","+#include \"mongo/db/query/compiler/stats/field_values.h\"","+","+#include \"mongo/bson/bsonmisc.h\"","+#include \"mongo/bson/bsonobjbuilder.h\"","+#include \"mongo/bson/json.h\"","+#include \"mongo/unittest/unittest.h\"","+","+#include <cstdint>","+#include <string_view>","+#include <vector>","+","+namespace mongo::stats {","+namespace {","+","+using sbe::value::TagValueView;","+using sbe::value::TypeTags;","+","+std::vector<FieldPath> makePaths(std::initializer_list<std::string_view> paths) {","+    return {paths.begin(), paths.end()};","+}","+","+BSONArray makeArrayValues(int count) {","+    BSONArrayBuilder values;","+    for (int i = 0; i < count; ++i) {","+        values.append(BSON(\"x\" << i));","+    }","+    return values.arr();","+}","+","+int32_t asInt32(TagValueView value) {","+    ASSERT_EQ(value.tag, TypeTags::NumberInt32);","+    return sbe::value::bitcastTo<int32_t>(value.value);","+}","+","+// Tuples of int32 values, e.g. {{1, 3}, {1, 4}}, for asserting on the whole cross product.","+std::vector<std::vector<int32_t>> extractInt32Tuples(","+    const BSONObj& doc, std::initializer_list<std::string_view> paths) {","+    std::vector<std::vector<int32_t>> result;","+    const auto [tuples, hasNonScalar] = extractFieldValues(doc, makePaths(paths));","+    for (const auto& tuple : tuples) {","+        auto& values = result.emplace_back();","+        for (const auto& value : tuple) {","+            values.push_back(asInt32(value));","+        }","+    }","+    return result;","+}","+","+TEST(FieldValuesTest, ReturnsValuesInRequestedPathOrder) {","+    ASSERT_EQ(extractInt32Tuples(fromjson(\"{a: 1, b: 2}\"), {\"b\", \"a\"}),","+              (std::vector<std::vector<int32_t>>{{2, 1}}));","+}","+","+TEST(FieldValuesTest, RetainsNonScalarFlagFromEarlierPath) {","+    const auto doc = fromjson(\"{a: [{b: 1}], c: 9}\");","+    const auto [tuples, hasNonScalar] = extractFieldValues(doc, makePaths({\"a.b\", \"c\"}));","+    ASSERT_TRUE(hasNonScalar);","+}","+","+TEST(FieldValuesTest, ProducesCrossProductOfRequestedPaths) {","+    const auto doc = fromjson(\"{a: [{x: 1}, {x: 2}], b: [{y: 3}, {y: 4}], c: 9}\");","+    ASSERT_EQ(extractInt32Tuples(doc, {\"a.x\", \"c\", \"b.y\"}),","+              (std::vector<std::vector<int32_t>>{{1, 9, 3}, {1, 9, 4}, {2, 9, 3}, {2, 9, 4}}));","+}","+","+TEST(FieldValuesTest, AllowsCrossProductAtPerDocumentLimit) {","+    const auto doc = BSON(\"a\" << makeArrayValues(1000) << \"b\" << makeArrayValues(100));","+    const auto [tuples, hasNonScalar] = extractFieldValues(doc, makePaths({\"a.x\", \"b.x\"}));","+    ASSERT_EQ(tuples.size(), 100'000);","+}","+","+TEST(FieldValuesTest, RejectsCrossProductAbovePerDocumentLimit) {","+    const auto doc = BSON(\"a\" << makeArrayValues(1000) << \"b\" << makeArrayValues(101));","+    ASSERT_THROWS_CODE(extractFieldValues(doc, makePaths({\"a.x\", \"b.x\"})),","+                       DBException,","+                       ErrorCodes::ExceededMemoryLimit);","+}","+","+TEST(FieldValuesTest, FillsMissingPathInEveryTupleWithNothing) {","+    const auto doc = fromjson(\"{a: [{b: 1}, {b: 2}]}\");","+    const auto [tuples, hasNonScalar] = extractFieldValues(doc, makePaths({\"a.b\", \"absent\"}));","+    ASSERT_EQ(tuples.size(), 2);","+    for (const auto& tuple : tuples) {","+        ASSERT_EQ(tuple.size(), 2);","+        ASSERT_EQ(tuple[1].tag, TypeTags::Nothing);","+    }","+}","+","+}  // namespace","+}  // namespace mongo::stats"],"additions":93,"deletions":0,"truncated":false},{"path":"src/mongo/db/query/compiler/stats/scalar_field_values.cpp","lines":["@@ -1,45 +0,0 @@","-// Copyright (c) MongoDB, Inc.","-// SPDX-License-Identifier: SSPL-1.0","-","-#include \"mongo/db/query/compiler/stats/scalar_field_values.h\"","-","-#include \"mongo/db/exec/sbe/values/bson.h\"","-#include \"mongo/util/assert_util.h\"","-","-namespace mongo::stats {","-namespace {","-","-using sbe::value::TagValueView;","-using sbe::value::TypeTags;","-","-TagValueView extractScalarField(TagValueView value, const FieldPath& path) {","-    for (size_t i = 0;; ++i) {","-        uassert(13175701,","-                \"Scalar field extraction does not support array values\",","-                !sbe::value::isArray(value.tag));","-        if (i == path.getPathLength()) {","-            return value;","-        }","-        if (!sbe::value::isObject(value.tag)) {","-            return TagValueView::nothing();","-        }","-        const auto field = path.getFieldName(i);","-        value = value.tag == TypeTags::bsonObject","-            ? sbe::bson::getField(sbe::value::getRawPointerView(value.value), field)","-            : sbe::value::getObjectView(value.value)->getField(field);","-    }","-}","-","-}  // namespace","-","-absl::InlinedVector<TagValueView, 3> extractScalarFieldValues(TagValueView doc,","-                                                              std::span<const FieldPath> paths) {","-    absl::InlinedVector<TagValueView, 3> v