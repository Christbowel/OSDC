uld exist\");","+        assert!(class.injectable.is_some());","+        assert_eq!(","+            r3_symbols_specifier_of(&results, \"/core/testing/src/test_bed.ts\"),","+            None,","+        );","+    }","+","+    /// A file named `r3_symbols.ts` in a package that is not `@angular/core` means nothing: the","+    /// rewrite is gated on the compilation being core (`isCore`), not on the file name alone.","+    #[test]","+    fn r3_symbols_specifier_is_absent_outside_core() {","+        let fs = create_test_fs(&[","+            (\"/app/package.json\", r#\"{\"name\": \"my-app\"}\"#),","+            (","+                \"/app/tsconfig.json\",","+                r#\"{\"compilerOptions\": {}, \"files\": [\"src/r3_symbols.ts\", \"src/service.ts\"]}\"#,","+            ),","+            (\"/app/src/r3_symbols.ts\", CORE_R3_SYMBOLS),","+            (","+                \"/app/src/service.ts\",","+                r#\"","+import {Injectable} from '@angular/core';","+","+@Injectable({providedIn: 'root'})","+export class MyService {}","+\"#,","+            ),","+        ]);","+","+        let results = run_analyzer(fs, \"/app/tsconfig.json\", false);","+","+        assert!(find_class(&results, \"MyService\").is_some());","+        assert_eq!(","+            r3_symbols_specifier_of(&results, \"/app/src/service.ts\"),","+            None","+        );","+    }"," }"],"additions":117,"deletions":0,"truncated":false},{"path":"packages/compiler-cli/preprocessor/ng-analyze/src/types/analysis.rs","lines":["@@ -555,6 +555,9 @@ pub struct FileData {","     /// Byte offsets for implicit signal `debugName` insertions.","     pub(crate) signal_debug_names:","         Vec<crate::analyzer::signal_debug_name::SignalDebugNameInsertion>,","+    /// Whether this file is part of `@angular/core` itself (see","+    /// [`crate::analyzer::imports::detect_is_core`]). Always `false` for `.d.ts` files.","+    pub(crate) is_core: bool,"," }"," "," impl FileData {","@@ -596,9 +599,21 @@ impl Fil