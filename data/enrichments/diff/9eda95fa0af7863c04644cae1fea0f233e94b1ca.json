{"id":"9eda95fa0af7863c04644cae1fea0f233e94b1ca","axis":"silent","repo":"tauri-apps/tauri","sha":"9eda95fa0af7863c04644cae1fea0f233e94b1ca","parsed":{"files":[{"path":".changes/add-pacman-support.md","lines":["@@ -0,0 +1,11 @@","+---","+\"tauri-bundler\": minor:feat","+\"tauri-cli\": minor:feat","+\"@tauri-apps/cli\": minor:feat","+\"tauri-utils\": minor:feat","+\"@tauri-apps/api\": minor:feat","+---","+","+Add the `pacman` bundle target for Arch Linux. It produces a `.tar.gz` archive with a `PKGBUILD` and `.SRCINFO` ready to be published to the AUR; see `bundle > linux > pacman` for the package name (`<name>-bin` by default), release, dependencies, install script, changelog and source options. `bundle > licenseFile` is installed to `/usr/share/licenses/<pkgname>/`.","+","+The `pacman` target is part of `\"all\"`, so Linux builds that bundle all targets now also produce the pacman package; list the targets explicitly in `bundle > targets` to opt out."],"additions":11,"deletions":0,"truncated":false},{"path":"crates/tauri-bundler/src/bundle.rs","lines":["@@ -29,7 +29,7 @@ pub use {","   settings::{","     AppImageSettings, BundleBinary, BundleSettings, CustomSignCommandSettings, DebianSettings,","     DmgSettings, Entitlements, IosSettings, MacOsSettings, NsisSettings, PackageSettings,","-    PackageType, PlistKind, Position, RpmSettings, Settings, SettingsBuilder, Size,","+    PackageType, PacmanSettings, PlistKind, Position, RpmSettings, Settings, SettingsBuilder, Size,","     UpdaterSettings, WindowsSettings, WixLanguage, WixLanguageConfig, WixSettings,","   },"," };","@@ -45,6 +45,7 @@ fn patch_binary(binary: &PathBuf, package_type: &PackageType) -> crate::Result<(","     crate::PackageType::Deb => b\"__TAURI_BUNDLE_TYPE_VAR_DEB\",","     crate::PackageType::Rpm => b\"__TAURI_BUNDLE_TYPE_VAR_RPM\",","     crate::PackageType::AppImage => b\"__TAURI_BUNDLE_TYPE_VAR_APP\",","+    crate::PackageType::Pacman => b\"__TAURI_BUNDLE_TYPE_VAR_PAC\",","     // NSIS installers can be built in linux using cargo-xwin","     crate::PackageType::Nsis => b\"__TAURI_BUNDLE_TYPE_VAR_NSS\",","     _ => {","@@ -199,6 +200,8 @@ pub fn bundle_project(settings: &Settings) -> crate::Result<Vec<Bundle>> {","       PackageType::Rpm => linux::rpm::bundle_project(settings)?,","       #[cfg(target_os = \"linux\")]","       PackageType::AppImage => linux::appimage::bundle_project(settings)?,","+      #[cfg(target_os = \"linux\")]","+      PackageType::Pacman => linux::pacman::bundle_project(settings)?,","       _ => {","         log::warn!(\"ignoring {}\", package_type.short_name());","         continue;"],"additions":4,"deletions":1,"truncated":false},{"path":"crates/tauri-bundler/src/bundle/linux/appimage/linuxdeploy.rs","lines":["@@ -77,8 +77,11 @@ pub fn bundle_project(settings: &Settings) -> crate::Result<Vec<PathBuf>> {","   }"," ","   // generate deb_folder structure","-  let (data_dir, icons) = debian::generate_data(&settings, &package_dir)","-    .with_context(|| \"Failed to build data folders and files\")?;","+  let (data_dir, icons) =","+    debian::generate_data(&settings, &package_dir, &settings.deb().desktop_template)","+      .with_context(|| \"Failed to build data folders and files\")?;","+  debian::generate_changelog_file(&settings, &data_dir)","+    .with_context(|| \"Failed to create changelog.gz file\")?;","   fs_utils::copy_custom_files(&settings.appimage().files, &data_dir)","     .with_context(|| \"Failed to copy custom files\")?;"," "],"additions":5,"deletions":2,"truncated":false},{"path":"crates/tauri-bundler/src/bundle/linux/debian.rs","lines":["@@ -82,8 +82,10 @@ pub fn bundle_project(settings: &Settings) -> crate::Result<Vec<PathBuf>> {"," ","   log::info!(action = \"Bundling\"; \"{} ({})\", package_name, package_path.display());"," ","-  let (data_dir, _) =","-    generate_data(settings, &package_dir).context(\"Failed to build data folders and files\")?;","+  let (data_dir, _) = generate_data(settings, &package_dir, &settings.deb().desktop_template)","+    .context(\"Failed to build data folders and files\")?;","+  generate_changelog_file(settings, &data_dir)","+    .with_context(|| \"Failed to create changelog.gz file\")?;","   fs_utils::copy_custom_files(&settings.deb().files, &data_dir)","     .context(\"Failed to copy custom files\")?;"," ","@@ -119,6 +121,7 @@ pub fn bundle_project(settings: &Settings) -> crate::Result<Vec<PathBuf>> {"," pub fn generate_data(","   settings: &Settings,","   package_dir: &Path,","+  desktop_template: &Option<PathBuf>,"," ) -> crate::Result<(PathBuf, Vec<freedesktop::Icon>)> {","   // Generate data files.","   let data_dir = package_dir.join(\"data\");","@@ -139,17 +142,14 @@ pub fn generate_data("," ","   let icons = freedesktop::copy_icon_files(settings, &data_dir)","     .with_context(|| \"Failed to create icon files\")?;","-  freedesktop::generate_desktop_file(settings, &settings.deb().desktop_template, &data_dir)","+  freedesktop::generate_desktop_file(settings, desktop_template, &data_dir)","     .with_context(|| \"Failed to create desktop file\")?;","-  generate_changelog_file(settings, &data_dir)","-    .with_context(|| \"Failed to create changelog.gz file\")?;","-","   Ok((data_dir, icons))"," }"," "," /// Generate the Changelog file by compressing, to be stored at /usr/share/doc/package-name/changelog.gz. See"," /// <https://www.debian.org/doc/debian-policy/ch-docs.html#changelog-files-and-release-notes>","-fn generate_changelog_file(settings: &Settings, data_dir: &Path) -> crate::Result<()> {","+pub fn generate_changelog_file(settings: &Settings, data_dir: &Path) -> crate::Result<()> {","   if let Some(changelog_src_path) = &settings.deb().changelog {","     let mut src_file = File::open(changelog_src_path)?;","     let product_name = settings.product_name();","@@ -387,7 +387,7 @@ fn create_tar_from_dir<P: AsRef<Path>, W: Write>(src_dir: P, dest_file: W) -> cr"," /// Creates a tar archive from the given directory (placing the new file within"," /// the given directory's parent directory), compressed with the given algorithm,"," /// and returns the path to the new file.","-fn tar_and_compress_dir<P: AsRef<Path>>(","+pub(crate) fn tar_and_compress_dir<P: AsRef<Path>>(","   src_dir: P,","   compression: DebCompression,"," ) -> crate::Result<PathBuf> {"],"additions":8,"deletions":8,"truncated":false},{"path":"crates/tauri-bundler/src/bundle/linux/mod.rs","lines":["@@ -6,4 +6,5 @@"," pub mod appimage;"," pub mod debian;"," pub mod freedesktop;","+pub mod pacman;"," pub mod rpm;"],"additions":1,"deletions":0,"truncated":false},{"path":"crates/tauri-bundler/src/bundle/linux/pacman.rs","lines":["@@ -0,0 +1,590 @@","+// Copyright 2019-2024 Tauri Programme within The Commons Conservancy","+// SPDX-License-Identifier: Apache-2.0","+// SPDX-License-Identifier: MIT","+","+use tauri_utils::config::DebCompression;","+","+use super::debian::{generate_data, tar_and_compress_dir};","+use crate::{","+  Settings,","+  bundle::settings::Arch,","+  error::{Context, ErrorExt},","+  utils::fs_utils,","+};","+use heck::AsKebabCase;","+use sha2::{Digest, Sha512};","+","+use std::{","+  fs,","+  io::Write,","+  path::{Path, PathBuf},","+};","+","+/// The compression used for the archive the PKGBUILD downloads.","+/// makepkg extracts it and repackages the result with its own `PKGEXT`,","+/// so this only affects the download size.","+const COMPRESSION: DebCompression = DebCompression::Gzip { level: 6 };","+","+/// Bundles the project.","+/// Returns the paths of the generated `.tar.gz` archive, its `PKGBUILD`, `.SRCINFO`,","+/// install script and changelog.","+pub fn bundle_project(settings: &Settings) -> crate::Result<Vec<PathBuf>> {","+  // Arch Linux uses its own naming for some architectures.","+  let arch = match settings.binary_arch() {","+    Arch::X86_64 => \"x86_64\",","+    Arch::X86 => \"i686\",","+    Arch::AArch64 => \"aarch64\",","+    Arch::Armhf => \"armv7h\",","+    Arch::Armel => \"arm\",","+    Arch::Riscv64 => \"riscv64\",","+    target => {","+      return Err(crate::Error::ArchError(format!(","+        \"Unsupported architecture: {target:?}\"","+      )));","+    }","+  };","+  let package_base_name = format!(","+    \"{}_{}_{}\",","+    settings.product_name(),","+    settings.version_string(),","+    arch","+  );","+","+  let base_dir = settings.project_out_directory().join(\"bundle/pacman\");","+","+  let package_dir = base_dir.join(&package_base_name);","+  if package_dir.exists() {","+    fs::remove_dir_all(&package_dir).fs_context(","+      \"Failed to Remove old package directory\",","+      package_dir.clone(),","+    )?;","+  }","+","+  let pkgname = pkgname(settings)?;","+","+  let package_name = format!(\"{package_base_name}.tar.gz\");","+  let package_path = base_dir.join(&package_name);","+  log::info!(action = \"Bundling\"; \"{} ({})\", package_name, package_path.display());","+","+  let (data_dir, _) = generate_data(settings, &package_dir, &settings.pacman().desktop_template)","+    .context(\"Failed to build data folders and files\")?;","+  fs_utils::copy_custom_files(&settings.pacman().files, &data_dir)","+    .context(\"Failed to copy custom files\")?;","+","+  // custom licenses must be installed to /usr/share/licenses/$pkgname","+  if let Some(license_file) = settings.license_file() {","+    let file_name = license_file","+      .file_name()","+      .map(ToOwned::to_owned)","+      .unwrap_or_else(|| \"LICENSE\".into());","+    let dest = data_dir","+      .join(\"usr/share/licenses\")","+      .join(&pkgname)","+      .join(file_name);","+    fs_utils::copy_file(&license_file, &dest).context(\"Failed to copy the license file\")?;","+  }","+","+  // Tar and compress the package directory into the final archive.","+  let package_path = tar_and_compress_dir(package_dir, COMPRESSION)","+    .context(\"Failed to create the tar.gz package\")?;","+","+  let package = Package::new(settings, arch, pkgname, &package_path)?;","+","+  if settings","+    .pacman()","+    .source","+    .as_ref()","+    .is_none_or(|s| s.is_empty())","+  {","+    log::info!(","+      \"The PKGBUILD refers to the local archive. To publish it to the AUR, upload the archive and set `bundle > linux > pacman > source` to its download URL.\"","+    );","+  }","+","+  let pkgbuild_path = base_dir.join(\"PKGBUILD\");","+  write_file(&pkgbuild_path, &package.pkgbuild()).context(\"Failed to create PKGBUILD file\")?;","+  let srcinfo_path = base_dir.join(\".SRCINFO\");","+  write_file(&srcinfo_path, &package.srcinfo()).context(\"Failed to create .SRCINFO file\")?;","+","+  let mut paths = vec![package_path, pkgbuild_path, srcinfo_path];","+","+  for (src, name, description) in [","+    (","+      &settings.pacman().install,","+      &package.install,","+      \"Failed to copy the install script\",","+    ),","+    (","+      &settings.pacman().changelog,","+      &package.changelog,","+      \"Failed to copy the changelog\",","+    ),","+  ] {","+    if let (Some(src), Some(name)) = (src, name) {","+      let dest = base_dir.join(name);","+      fs::copy(src, &dest).fs_context(description, src.clone())?;","+      paths.push(dest);","+    }","+  }","+","+  Ok(paths)","+}","+","+fn write_file(path: &Path, contents: &str) -> crate::Result<()> {","+  let mut file = fs_utils::create_file(path)?;","+  file.write_all(contents.as_bytes())?;","+  file.flush()?;","+  Ok(())","+}","+","+/// The package metadata, rendered both as a PKGBUILD and as the .SRCINFO the AUR requires.","+///","+/// See <https://wiki.archlinux.org/title/PKGBUILD> and <https://wiki.archlinux.org/title/.SRCINFO>","+struct Package {","+  maintainer: String,","+  pkgname: String,","+  /// The app version, as is, available to `source` as `${_pkgver}`.","+  version: String,","+  pkgver: String,","+  pkgrel: String,","+  epoch: Option<u32>,","+  pkgdesc: String,","+  arch: String,","+  url: String,","+  /// The install script file name.","+  install: Option<String>,","+  /// The changelog file name.","+  changelog: Option<String>,","+  license: String,","+  depends: Vec<String>,","+  optdepends: Vec<String>,","+  provides: Vec<String>,","+  conflicts: Vec<String>,","+  replaces: Vec<String>,","+  source: Vec<String>,","+  sha512sums: Vec<String>,","+}","+","+impl Package {","+  fn new(","+    settings: &Settings,","+    arch: &str,","+    pkgname: String,","+    package_path: &Path,","+  ) -> crate::Result<Self> {","+    let pacman = settings.pacman();","+    let archive_name = package_path","+      .file_name()","+      .unwrap_or_default()","+      .to_string_lossy()","+      .into_owned();","+","+    let install = pacman","+      .install","+      .as_ref()","+      .map(|_| format!(\"{pkgname}.install\"));","+    let changelog = pacman","+      .changelog","+      .as_ref()","+      .map(|_| format!(\"{pkgname}.changelog\"));","+","+    let pkgrel = pacman.pkgrel.clone().unwrap_or_else(|| \"1\".into());","+    if !is_valid_pkgrel(&pkgrel) {","+      return Err(crate::Error::GenericError(format!(","+        \"invalid `bundle > linux > pacman > pkgrel` `{pkgrel}`: it must be a positive integer, optionally followed by a period and another integer, e.g. `1` or `2.1`\"","+      )));","+    }","+","+    let mut provides = pacman.provides.clone().unwrap_or_default();","+    let mut conflicts = pacman.conflicts.clone().unwrap_or_default();","+    // a prebuilt `-bin` package stands in for the package built from source","+    if let Some(name) = pkgname.strip_suffix(\"-bin\").filter(|n| !n.is_empty()) {","+      for list in [&mut provides, &mut conflicts] {","+        if !list.iter().any(|p| p == name) {","+          list.push(name.to_string());","+        }","+      }","+    }","+","+    let mut source = pacman.source.clone().unwrap_or_default();","+    match source.first_mut() {","+      // save the download under the archive name, whatever the URL's file name is","+      Some(first) if !first.contains(\"::\") => *first = format!(\"{archive_name}::{first}\"),","+      Some(_) => {}","+      None => source.push(archive_name),","+    }","+    // the first source is the generated archive; there is nothing to check","+    // the other sources against","+    let sha_hash = hex::encode(Sha512::digest(fs::read(package_path)?));","+    let sha512sums = std::iter::once(sha_hash)","+      .chain(std::iter::repeat_n(\"SKIP\".to_string(), source.len() - 1))","+      .collect();","+","+    Ok(Self {","+      // a newline would end the comment and turn the rest of the value into code","+      maintainer: pacman","+        .maintainer","+        .clone()","+        .or_else(|| settings.authors_comma_separated())","+        .unwrap_or_default()","+        .replace(['\\r', '\\n'], \" \"),","+      pkgname,","+      version: settings.version_string().to_string(),","+      pkgver: pkgver(settings.version_string()),","+      pkgrel,","+      epoch: pacman.epoch,","+      pkgdesc: settings","+        .short_description()","+        .trim()","+        .replace(['\\r', '\\n'], \" \"),","+      arch: arch.to_string(),","+      url: settings.homepage_url().unwrap_or_default().to_string(),","+      install,","+      changelog,","+      license: settings.license().unwrap_or_else(|| \"unknown\".into()),","+      depends: pacman.depends.clone().unwrap_or_default(),","+      optdepends: pacman.optdepends.clone().unwrap_or_default(),","+      provides,","+      conflicts,","+      replaces: pacman.replaces.clone().unwrap_or_default(),","+      source,","+      sha512sums,","+    })","+  }","+","+  fn pkgbuild(&self) -> String {","+    let array = |values: &[String]| {","+      values","+        .iter()","+        .map(|v| quote(v))","+        .collect::<Vec<_>>()","+        .join(\" \")","+    };","+    // `source` may refer to PKGBUILD variables such as ${pkgver}, so it is double quoted","+    let source = self","+      .source","+      .iter()","+      .map(|s| double_quote(s))","+      .collect::<Vec<_>>()","+      .join(\" \");","+","+    // architecture specific, so the PKGBUILDs of each target can be merged","+    let arch = &self.arch;","+    let install = self","+      .install","+      .as_ref()","+      .map(|install| format!(\"install={}\\n\", quote(install)))","+      .unwrap_or_default();","+    let changelog = self","+      .changelog","+      .as_ref()","+      .map(|changelog| format!(\"changelog={}\\n\", quote(changelog)))","+      .unwrap_or_default();","+","+    let mut out = String::new();","+    if !self.maintainer.is_empty() {","+      out.push_str(&format!(\"# Maintainer: {}\\n\", self.maintainer));","+    }","+    out.push_str(&format!(","+      \"pkgname={}","+_pkgver={}","+pkgver={}","+pkgrel={}","+{}pkgdesc={}","+arch=({})","+url={}","+{install}{changelog}license=({})","+depends=({})","+optdepends=({})","+provides=({})","+conflicts=({})","+replaces=({})","+# the binaries are already built, makepkg must not strip them or split their debug symbols","+options=('!strip' '!debug')","+source_{arch}=({source})","+sha512sums_{arch}=({})","+","+package() {{","+  cp -a \\\"$srcdir/data/.\\\" \\\"$pkgdir/\\\"","+}}","+\",","+      quote(&self.pkgname),","+      quote(&self.version),","+      quote(&self.pkgver),","+      quote(&self.pkgrel),","+      self","+        .epoch","+        .map(|epoch| format!(\"epoch={epoch}\\n\"))","+        .unwrap_or_default(),","+      quote(&self.pkgdesc),","+      quote(&self.arch),","+      quote(&self.url),","+      quote(&self.license),","+      array(&self.depends),","+      array(&self.optdepends),","+      array(&self.provides),","+      array(&self.conflicts),","+      array(&self.replaces),","+      array(&self.sha512sums),","+    ));","+    out","+  }","+","+  /// Renders the .SRCINFO, which is what `makepkg --printsrcinfo` prints for the PKGBUILD.","+  fn srcinfo(&self) -> String {","+    let mut out = format!(\"pkgbase = {}\\n\", self.pkgname);","+    let mut field = |key: &str, value: &str| {","+      if !value.is_empty() {","+        out.push_str(&format!(\"\\t{key} = {value}\\n\"));","+      }","+    };","+    field(\"pkgdesc\", &self.pkgdesc);","+    field(\"pkgver\", &self.pkgver);","+    field(\"pkgrel\", &self.pkgrel);","+    if let Some(epoch) = self.epoch {","+      field(\"epoch\", &epoch.to_string());","+    }","+    field(\"url\", &self.url);","+    if let Some(install) = &self.install {","+      field(\"install\", install);","+    }","+    if let Some(changelog) = &self.changelog {","+      field(\"changelog\", changelog);","+    }","+    field(\"arch\", &self.arch);","+    field(\"license\", &self.license);","+    for (key, values) in [","+      (\"depends\", &self.depends),","+      (\"optdepends\", &self.optdepends),","+      (\"provides\", &self.provides),","+      (\"conflicts\", &self.conflicts),","+      (\"replaces\", &self.replaces),","+    ] {","+      for value in values {","+        field(key, value);","+      }","+    }","+    field(\"options\", \"!strip\");","+    field(\"options\", \"!debug\");","+    // the architecture specific attributes follow the global ones","+    for source in &self.source {","+      field(&format!(\"source_{}\", self.arch), &self.expand(source));","+    }","+    for sum in &self.sha512sums {","+      field(&format!(\"sha512sums_{}\", self.arch), sum);","+    }","+    out.push_str(&format!(\"\\npkgname = {}\\n\", self.pkgname));","+    out","+  }","+","+  /// Expands the PKGBUILD variables a `source` entry may use, as makepkg does.","+  fn expand(&self, value: &str) -> String {","+    let lookup = |name: &str| match name {","+      \"_pkgver\" => Some(&self.version),","+      \"pkgname\" => Some(&self.pkgname),","+      \"pkgver\" => Some(&self.pkgver),","+      \"pkgrel\" => Some(&self.pkgrel),","+      \"CARCH\" => Some(&self.arch),","+      _ => None,","+    };","+    let is_name_char = |c: char| c.is_ascii_alphanumeric() || c == '_';","+","+    let mut out = String::with_capacity(value.len());","+    let mut rest = value;","+    while let Some(index) = rest.find('$') {","+      out.push_str(&rest[..index]);","+      rest = &rest[index + 1..];","+      // `${name}` or `$name`, where the name spans all the identifier characters","+      let (name, len) = match rest.strip_prefix('{').and_then(|r| r.split_once('}')) {","+        Some((name, _)) => (name, name.len() + 2),","+        None => {","+          let len = rest.find(|c| !is_name_char(c)).unwrap_or(rest.len());","+          (&rest[..len], len)","+        }","+      };","+      match lookup(name) {","+        Some(v) => out.push_str(v),","+        None => {","+          out.push('$');","+          out.push_str(&rest[..len]);","+        }","+      }","+      rest = &rest[len..];","+    }","+    out.push_str(rest);","+    out","+  }","+}","+","+/// Quotes a value as a literal bash string.","+fn quote(value: &str) -> String {","+  format!(\"'{}'\", value.replace('\\'', r\"'\\''\"))","+}","+","+/// Quotes a value as a bash string that still expands `$variables`.","+fn double_quote(value: &str) -> String {","+  format!(","+    \"\\\"{}\\\"\",","+    value","+      .replace('\\\\', r\"\\\\\")","+      .replace('\"', \"\\\\\\\"\")","+      .replace('`', \"\\\\`\")","+  )","+}","+","+/// The configured `pkgname`, or the one derived from the product name.","+fn pkgname(settings: &Settings) -> crate::Result<String> {","+  match &settings.pacman().pkgname {","+    Some(pkgname) if is_valid_pkgname(pkgname) => Ok(pkgname.clone()),","+    Some(pkgname) => Err(crate::Error::GenericError(format!(","+      \"invalid `bundle > linux > pacman > pkgname` `{pkgname}`: it must only contain lowercase alphanumerics and `@._+-`, and must not start with `-` or `.`\"","+    ))),","+    None => default_pkgname(settings.product_name()).ok_or_else(|| {","+      crate::Error::GenericError(format!(","+        \"cannot derive a pacman package name from the product name `{}`, set `bundle > linux > pacman > pkgname`\",","+        settings.product_name()","+      ))","+    }),","+  }","+}","+","+/// Whether the name is a valid `pkgname`.","+///","+/// See <https://wiki.archlinux.org/title/PKGBUILD#pkgname>","+fn is_valid_pkgname(name: &str) -> bool {","+  !name.is_empty()","+    && !name.starts_with(['-', '.'])","+    && name","+      .chars()","+      .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || \"@._+-\".contains(c))","+}","+","+/// Whether the value is a valid `pkgrel`: a positive integer, optionally followed by a","+/// period and another integer.","+fn is_valid_pkgrel(pkgrel: &str) -> bool {","+  let (major, minor) = pkgrel.split_once('.').unwrap_or((pkgrel, \"1\"));","+  let is_number = |s: &str| !s.is_empty() && s.chars().all(|c| c.is_ascii_digit());","+  is_number(major) && is_number(minor) && !major.starts_with('0')","+}","+","+/// The kebab-cased product name, without the characters `pkgname` does not allow,","+/// with the `-bin` suffix.","+fn default_pkgname(product_name: &str) -> Option<String> {","+  let name = AsKebabCase(product_name)","+    .to_string()","+    .chars()","+    .filter(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || \"@._+-\".contains(*c))","+    .collect::<String>();","+  let name = name.trim_start_matches(['-', '.']).trim_end_matches('-');","+  (!name.is_empty()).then(|| format!(\"{name}-bin\"))","+}","+","+/// pacman does not allow hyphens, colons, forward slashes or whitespace in `pkgver`,","+/// so they are mapped to underscores, e.g. `1.0.0-beta.1` -> `1.0.0_beta.1`.","+/// The original version is available to the PKGBUILD as `${_pkgver}`.","+fn pkgver(version: &str) -> String {","+  version.replace(","+    |c: char| c == '-' || c == ':' || c == '/' || c.is_whitespace(),","+    \"_\",","+  )","+}","+","+#[cfg(test)]","+mod tests {","+  use super::*;","+","+  #[test]","+  fn quotes_values() {","+    assert_eq!(quote(\"gtk3>=3.24\"), \"'gtk3>=3.24'\");","+    assert_eq!(quote(\"it's $(id)\"), r\"'it'\\''s $(id)'\");","+    assert_eq!(","+      double_quote(r#\"https://x/${pkgver}/\"a\"`b`\"#),","+      r#\"\"https://x/${pkgver}/\\\"a\\\"\\`b\\`\"\"#","+    );","+  }","+","+  fn package() -> Package {","+    Package {","+      maintainer: String::new(),","+      pkgname: \"my-app\".into(),","+      version: \"1.0.0-beta.1\".into(),","+      pkgver: \"1.0.0_beta.1\".into(),","+      pkgrel: \"2\".into(),","+      epoch: Some(1),","+      pkgdesc: \"My app\".into(),","+      arch: \"x86_64\".into(),","+      url: String::new(),","+      install: Some(\"my-app.install\".into()),","+      changelog: None,","+      license: \"MIT\".into(),","+      depends: vec![\"gtk3\".into(), \"webkit2gtk-4.1>=2.40\".into()],","+      optdepends: vec![\"libappindicator-gtk3: tray icon support\".into()],","+      provides: vec![],","+      conflicts: vec![],","+      replaces: vec![],","+      source: vec![\"a.tar.gz::https://x/v${_pkgver}/a_$CARCH.tar.gz\".into()],","+      sha512sums: vec![\"abc\".into()],","+    }","+  }","+","+  #[test]","+  fn renders_srcinfo() {","+    assert_eq!(","+      package().srcinfo(),","+      \"pkgbase = my-app","+\\tpkgdesc = My app","+\\tpkgver = 1.0.0_beta.1","+\\tpkgrel = 2","+\\tepoch = 1","+\\tinstall = my-app.install","+\\tarch = x86_64","+\\tlicense = MIT","+\\tdepends = gtk3","+\\tdepends = webkit2gtk-4.1>=2.40","+\\toptdepends = libappindicator-gtk3: tray icon support","+\\toptions = !strip","+\\toptions = !debug","+\\tsource_x86_64 = a.tar.gz::https://x/v1.0.0-beta.1/a_x86_64.tar.gz","+\\tsha512sums_x86_64 = abc","+","+pkgname = my-app","+\"","+    );","+  }","+","+  #[test]","+  fn derives_pkgname() {","+    assert_eq!(default_pkgname(\"My App\").as_deref(), Some(\"my-app-bin\"));","+    assert_eq!(default_pkgname(\"Café 2\").as_deref(), Some(\"caf-2-bin\"));","+    assert_eq!(default_pkgname(\"应用\"), None);","+    assert!(is_valid_pkgname(\"my-app-bin\"));","+    assert!(!is_valid_pkgname(\"My-App\"));","+    assert!(!is_valid_pkgname(\"-app\"));","+    assert!(is_valid_pkgrel(\"1\"));","+    assert!(is_valid_pkgrel(\"2.1\"));","+    assert!(!is_valid_pkgrel(\"0\"));","+    assert!(!is_valid_pkgrel(\"1-1\"));","+    assert!(!is_valid_pkgrel(\"1.\"));","+  }","+","+  #[test]","+  fn expands_variables() {","+    let package = package();","+    assert_eq!(","+      package.expand(\"$pkgname/${pkgver}/$_pkgver-$CARCH.tar.gz\"),","+      \"my-app/1.0.0_beta.1/1.0.0-beta.1-x86_64.tar.gz\"","+    );","+    assert_eq!(","+      package.expand(\"$pkgver_x/${unknown}/$ $\"),","+      \"$pkgver_x/${unknown}/$ $\"","+    );","+  }","+","+  #[test]","+  fn maps_pkgver() {","+    assert_eq!(pkgver(\"1.0.0\"), \"1.0.0\");","+    assert_eq!(pkgver(\"1.0.0-beta.1\"), \"1.0.0_beta.1\");","+    assert_eq!(pkgver(\"1.0.0-rc:1/2 3\"), \"1.0.0_rc_1_2_3\");","+    assert_eq!(pkgver(\"1.0.0+build.5\"), \"1.0.0+build.5\");","+  }","+}"],"additions":590,"deletions":0,"truncated":false},{"path":"crates/tauri-bundler/src/bundle/settings.rs","lines":["@@ -35,6 +35,8 @@ pub enum PackageType {","   Rpm,","   /// The Linux AppImage bundle (.AppImage).","   AppImage,","+  /// The Linux Pacman bundle (PKGBUILD)","+  Pacman,","   /// The macOS DMG bundle (.dmg).","   Dmg,","   /// The Updater bundle.","@@ -47,6 +49,7 @@ impl From<BundleType> for PackageType {","       BundleType::Deb => Self::Deb,","       BundleType::Rpm => Self::Rpm,","       BundleType::AppImage => Self::AppImage,","+      BundleType::Pacman => Self::Pacman,","       BundleType::Msi => Self::WindowsMsi,","       BundleType::Nsis => Self::Nsis,","       BundleType::App => Self::MacOsBundle,","@@ -57,7 +60,7 @@ impl From<BundleType> for PackageType {"," "," impl PackageType {","   /// Maps a short name to a PackageType.","-  /// Possible values are \"deb\", \"ios\", \"msi\", \"app\", \"rpm\", \"appimage\", \"dmg\", \"updater\".","+  /// Possible values are \"deb\", \"ios\", \"msi\", \"app\", \"rpm\", \"appimage\", \"pacman\", \"dmg\", \"updater\".","   pub fn from_short_name(name: &str) -> Option<PackageType> {","     // Other types we may eventually want to support