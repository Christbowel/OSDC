      elif kind == _CALL_GEN_CACHE_KEY:","+                    result.append(element.name)","+                    result.append(obj._gen_cache_key(am, bindparams))","+","+                # remaining cache functions are against","+                # Python tuples, dicts, lists, etc. so we can skip","+                # if they are empty","+                elif obj:","+                    if kind == _CACHE_IN_PLACE:","+                        result.append(element.name)","+                        result.append(obj)","+                    elif kind == _PROPAGATE_ATTRS:","+                        result.append(element.name)","+                        result.append(obj[\"compile_state_plugin\"])","+                        if ps := obj[\"plugin_subject\"]:","+                            result.append(ps._gen_cache_key(am, bindparams))","+                        else:","+                            result.append(None)","+","+                    elif kind == _ANNOTATIONS_KEY:","+                        # obj is here is the _annotations dict.  Table uses","+                        # a memoized version of it.  however in other cases,","+                        # we generate it given am as we may be from a","+                        # Join, Aliased, etc.","+                        # see #8790","+","+                        if self._gen_static_annotations_cache_key:  # type: ignore[attr-defined]  # noqa: E501","+                            result.extend(self._annotations_cache_key)  # type: ignore[attr-defined]  # noqa: E501","+                        else:","+                            result.extend(self._gen_annotations_cache_key(am))  # type: ignore[attr-defined]  # noqa: E501","+","+                    elif kind == _CLAUSEELEMENT_LIST:","+                        result.append(element.name)","+                        result.append(","+                            tuple(","+                                [","+                                    elem._gen_cache_key(am, bindpara