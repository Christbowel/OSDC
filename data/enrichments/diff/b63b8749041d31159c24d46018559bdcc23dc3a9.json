false},{"path":"src/main/java/tools/jackson/databind/ser/jdk/ObjectArraySerializer.java","lines":["@@ -272,8 +272,11 @@ public final void serialize(Object[] value, JsonGenerator g, SerializationContex","             if (((_unwrapSingle == null) &&","                     ctxt.isEnabled(SerializationFeature.WRITE_SINGLE_ELEM_ARRAYS_UNWRAPPED))","                     || (_unwrapSingle == Boolean.TRUE)) {","-                serializeContents(value, g, ctxt);","-                return;","+                // [databind#6299]: do not unwrap if the only element is filtered out","+                if (!isEmpty(ctxt, value)) {","+                    serializeContents(value, g, ctxt);","+                    return;","+                }","             }","         }","         g.writeStartArray(value, len);"],"additions":5,"deletions":2,"truncated":false},{"path":"src/main/java/tools/jackson/databind/ser/jdk/StringArraySerializer.java","lines":["@@ -227,8 +227,11 @@ public final void serialize(String[] value, JsonGenerator g, SerializationContex","             if (((_unwrapSingle == null) &&","                     ctxt.isEnabled(SerializationFeature.WRITE_SINGLE_ELEM_ARRAYS_UNWRAPPED))","                     || (_unwrapSingle == Boolean.TRUE)) {","-                serializeContents(value, g, ctxt);","-                return;","+                // [databind#6299]: do not unwrap if the only element is filtered out","+                if (!isEmpty(ctxt, value)) {","+                    serializeContents(value, g, ctxt);","+                    return;","+                }","             }","         }","         g.writeStartArray(value, len);"],"additions":5,"deletions":2,"truncated":false},{"path":"src/main/java/tools/jackson/databind/ser/jdk/StringCollectionSerializer.java","lines":["@@ -85,12 +85,12 @@ public void serialize(Collection<String> value, JsonGenerator g,","             if (((_unwrapSingle == null) &&","                     ctxt.isEnabled(SerializationFeature.WRITE_SINGLE_ELEM_ARRAYS_UNWRAPPED))","                     || (_unwrapSingle == Boolean.TRUE)) {","-                if (_needToCheckFiltering(ctxt)) {","-                    serializeFilteredContents(value, g, ctxt);","-                } else {","+                // [databind#6299]: do not unwrap if the only element is filtered out","+                // (and if not, no need to filter it again)","+                if (!isEmpty(ctxt, value)) {","                     serializeContents(value, g, ctxt);","+                    return;","                 }","-                return;","             }","         }","         g.writeStartArray(value, len);"],"additions":4,"deletions":4,"truncated":false},{"path":"src/test/java/tools/jackson/databind/ser/filter/JsonIncludeUnwrapSingle6299Test.java","lines":["@@ -0,0 +1,282 @@","+package tools.jackson.databind.ser.filter;","+","+import java.util.*;","+","+import org.junit.jupiter.api.Test;","+","+import com.fasterxml.jackson.annotation.JsonFormat;","+import com.fasterxml.jackson.annotation.JsonInclude;","+import com.fasterxml.jackson.annotation.JsonPropertyOrder;","+","+import tools.jackson.core.JsonGenerator;","+import tools.jackson.core.type.TypeReference;","+import tools.jackson.databind.ObjectMapper;","+import tools.jackson.databind.SerializationContext;","+import tools.jackson.databind.SerializationFeature;","+import tools.jackson.databind.annotation.JsonSerialize;","+import tools.jackson.databind.ser.std.StdSerializer;","+import tools.jackson.databind.testutil.DatabindTestUtil;","+","+import static org.junit.jupiter.api.Assertions.assertEquals;","+","+// [databind#6299]: with both `APPLY_JSON_INCLUDE_FOR_CONTAINERS` and","+// `WRITE_SINGLE_ELEM_ARRAYS_UNWRAPPED`, a single-element container whose only","+// element is filtered out must serialize as `[]` (not as nothing at all)","+public class JsonIncludeUnwrapSingle6299Test extends DatabindTestUtil","+{","+    enum Size { SMALL, LARGE }","+","+    static class SuppressSmallFilter {","+        @Override","+        public boolean equals(Object other) {","+            return other == Size.SMALL;","+        }","+    }","+","+    // Genuine non-Collection Iterable, to be routed through `IterableSerializer`","+    static class StringIterable implements Iterable<String> {","+        private final List<String> _values;","+        int iteratorCalls;","+","+        StringIterable(String value) { _values = List.of(value); }","+","+        @Override","+        public Iterator<String> iterator() {","+            ++iteratorCalls;","+            return _values.iterator();","+        }","+    }","+","+    static class UpperCaseSerializer extends StdSerializer<String> {","+        UpperCaseSerializer() { super(String.class); }","+","+        @Override","+        public boolean isEmpty(SerializationContext ctxt, String value) {","+            return value.isEmpty();","+        }","+","+        @Override","+        public void serialize(String value, JsonGenerator g, SerializationContext ctxt) {","+            g.writeString(value.toUpperCase());","+        }","+    }","+","+    // Unwrapping enabled per-property, not with global feature","+    @JsonPropertyOrder({ \"stringList\", \"objectList\", \"after\" })","+    static class FormatUnwrapBean {","+        @JsonFormat(with = JsonFormat.Feature.WRITE_SINGLE_ELEM_ARRAYS_UNWRAPPED)","+        @JsonInclude(content = JsonInclude.Include.NON_EMPTY)","+        public List<String> stringList;","+        @JsonFormat(with = JsonFormat.Feature.WRITE_SINGLE_ELEM_ARRAYS_UNWRAPPED)","+        @JsonInclude(content = JsonInclude.Include.NON_EMPTY)","+        public List<Object> objectList;","+        public int after = 1;","+","+        FormatUnwrapBean(String value) {","+            stringList = new ArrayList<>(List.of(value));","+            objectList = new ArrayList<>(List.of(value));","+        }","+    }","+","+    @JsonPropertyOrder({ \"stringList\", \"objectList\", \"after\" })","+    static class NonNullBean {","+        @JsonInclude(content = JsonInclude.Include.NON_NULL)","+        public List<String> stringList;","+        @JsonInclude(content = JsonInclude.Include.NON_NULL)","+        public List<Object> objectList;","+        public int after = 1;","+","+        NonNullBean(String value) {","+            stringList = new ArrayList<>(Collections.singletonList(value));","+            objectList = new ArrayList<>(Collections.singletonList(value));","+        }","+    }","+","+    // NOTE: `List<Object>`, not `List<String>`: latter ignores content inclusion","+    // when combined with `contentUsing` (separate issue)","+    @JsonPropertyOrder({ \"values\", \"after\" })","+    static class ContentUsingBean {","+        @JsonSerialize(contentUsing = UpperCaseSerializer.class)","+        @JsonInclude(content = JsonInclude.Include.NON_EMPTY)","+        public List<Object> values;","+        public int after = 1;","+","+        ContentUsingBean(String value) {","+            values = new ArrayList<>(List.of(value));","+        }","+    }","+","+    // One property per affected container serializer","+    @JsonPropertyOrder({ \"stringList\", \"stringSet\", \"objectList\", \"objectSet\", \"iterable\",","+        \"strings\", \"objects\", \"enums\",","+        \"booleans\", \"shorts\", \"ints\", \"longs\", \"floats\", \"doubles\", \"after\" })","+    static class Containers {","+        @JsonInclude(content = JsonInclude.Include.NON_EMPTY)","+        public List<String> stringList; // IndexedStringListSerializer","+        @JsonInclude(content = JsonInclude.Include.NON_EMPTY)","+        public Set<String> stringSet; // StringCollectionSerializer","+        @JsonInclude(content = JsonInclude.Include.NON_EMPTY)","+        public List<Object> objectList; // IndexedListSerializer","+        @JsonInclude(content = JsonInclude.Include.NON_EMPTY)","+        public Set<Object> objectSet; // CollectionSerializer","+        @JsonInclude(content = JsonInclude.Include.NON_EMPTY)","+        public Iterable<String> iterable; // IterableSerializer","+        @JsonInclude(content = JsonInclude.Include.NON_EMPTY)","+        public String[] strings; // StringArraySerializer","+        @JsonInclude(content = JsonInclude.Include.NON_EMPTY)","+        public Object[] objects; // ObjectArraySerializer","+        @JsonInclude(content = JsonInclude.Include.CUSTOM,","+                contentFilter = SuppressSmallFilter.class)","+        public EnumSet<Size> enums; // EnumSetSerializer","+","+        // JDKArraySerializers","+        @JsonInclude(content = JsonInclude.Include.NON_DEFAULT)","+        public boolean[] booleans;","+        @JsonInclude(content = JsonInclude.Include.NON_DEFAULT)","+        public short[] shorts;","+        @JsonInclude(content = JsonInclude.Include.NON_DEFAULT)","+        public int[] ints;","+        @JsonInclude(content = JsonInclude.Include.NON_DEFAULT)","+        public long[] longs;","+        @JsonInclude(content = JsonInclude.Include.NON_DEFAULT)","+        public float[] floats;","+        @JsonInclude(content = JsonInclude.Include.NON_DEFAULT)","+        public double[] doubles;","+","+        public int after = 1;","+","+        static Containers filtered() {","+            Containers c = new Containers();","+            c.stringList = new ArrayList<>(List.of(\"\"));","+            c.stringSet = new LinkedHashSet<>(List.of(\"\"));","+            c.objectList = new ArrayList<>(List.of(\"\"));","+            c.objectSet = new LinkedHashSet<>(List.of(\"\"));","+            c.iterable = new StringIterable(\"\");","+            c.strings = new String[] { \"\" };","+            c.objects = new Object[] { \"\" };","+            c.enums = EnumSet.of(Size.SMALL);","+            c.booleans = new boolean[] { false };","+            c.shorts = new short[] { 0 };","+            c.ints = new int[] { 0 };","+            c.longs = new long[] { 0L };","+            c.floats = new float[] { 0f };","+            c.doubles = new double[] { 0d };","+            return c;","+        }","+","+        static Containers retained() {","+            Containers c = new Containers();","+            c.stringList = new ArrayList<>(List.of(\"a\"));","+            c.stringSet = new LinkedHashSet<>(List.of(\"b\"));","+            c.objectList = new ArrayList<>(List.of(\"c\"));","+            c.objectSet = new LinkedHashSet<>(List.of(\"d\"));","+            c.iterable = new StringIterable(\"e\");","+            c.strings = new String[] { \"f\" };","+            c.objects = new Object[] { \"g\" };","+            c.enums = EnumSet.of(Size.LARGE);","+            c.booleans = new boolean[] { true };","+            c.shorts = new short[] { 1 };","+            c.ints = new int[] { 2 };","+            c.longs = new long[] { 3L };","+            c.floats = new float[] { 0.5f };","+            c.doubles = new double[] { 0.25d };","+            return c;","+        }","+    }","+","+    private final ObjectMapper MAPPER = jsonMapperBuilder()","+            .enable(SerializationFeature.APPLY_JSON_INCLUDE_FOR_CONTAINERS,","+                    SerializationFeature.WRITE_SINGLE_ELEM_ARRAYS_UNWRAPPED)","+            .build();","+","+    @Test","+    void filteredSingletonWrittenAsEmptyArray() throws Exception","+    {","+        assertEquals(\"\"\"","+                {\"stringList\":[],\"stringSet\":[],\"objectList\":[],\"objectSet\":[],\"iterable\":[],\\","+                \"strings\":[],\"objects\":[],\"enums\":[],\\","+                \"booleans\":[],\"shorts\":[],\"ints\":[],\"longs\":[],\"floats\":[],\"doubles\":[],\\","+                \"after\":1}\"\"\",","+                MAPPER.writeValueAsString(Containers.filtered()));","+    }","+","+    @Test","+    void retainedSingletonStillUnwrapped() throws Exception","+    {","+        assertEquals(\"\"\"","+                {\"stringList\":\"a\",\"stringSet\":\"b\",\"objectList\":\"c\",\"objectSet\":\"d\",\"iterable\":\"e\",\\","+                \"strings\":\"f\",\"objects\":\"g\",\"enums\":\"LARGE\",\\","+                \"booleans\":true,\"shorts\":1,\"ints\":2,\"longs\":3,\"floats\":0.5,\"doubles\":0.25,\\","+                \"after\":1}\"\"\",","+                MAPPER.writeValueAsString(Containers.retained()));","+    }","+","+    @Test","+    void rootValue() throws Exception","+    {","+        ObjectMapper mapper = jsonMapperBuilder()","+                .enable(SerializationFeature.APPLY_JSON_INCLUDE_FOR_CONTAINERS,","+                        SerializationFeature.WRITE_SINGLE_ELEM_ARRAYS_UNWRAPPED)","+                .changeDefaultPropertyInclusion(incl -> incl","+                        .withContentInclusion(JsonInclude.Include.NON_EMPTY))","+                .build();","+        TypeReference<List<String>> type = new TypeReference<>() { };","+        assertEquals(\"[]\", mapper.writerFor(type).writeValueAsString(List.of(\"\")));","+        assertEquals(\"\\\"a\\\"\", mapper.writerFor(type).writeValueAsString(List.of(\"a\")));","+        // Unwrapping is based on physical size: filtering down to one element","+        // still produces an array","+        assertEquals(\"[\\\"a\\\"]\", mapper.writerFor(type).writeValueAsString(List.of(\"a\", \"\")));","+    }","+","+    @Test","+    void perPropertyUnwrapping() throws Exception","+    {","+        ObjectMapper mapper = jsonMapperBuilder()","+                .enable(SerializationFeature.APPLY_JSON_INCLUDE_FOR_CONTAINERS)","+                .disable(SerializationFeature.WRITE_SINGLE_ELEM_ARRAYS_UNWRAPPED)","+                .build();","+        assertEquals(\"\"\"","+                {\"stringList\":[],\"objectList\":[],\"after\":1}\"\"\",","+                mapper.writeValueAsString(new FormatUnwrapBean(\"\")));","+        assertEquals(\"\"\"","+                {\"stringList\":\"a\",\"objectList\":\"a\",\"after\":1}\"\"\",","+                mapper.writeValueAsString(new FormatUnwrapBean(\"a\")));","+    }","+","+    @Test","+    void nullElementWithNonNullContent() throws Exception","+    {","+        assertEquals(\"\"\"","+                {\"stringList\":[],\"objectList\":[],\"after\":1}\"\"\",","+                MAPPER.writeValueAsString(new NonNullBean(null)));","+        assertEquals(\"\"\"","+                {\"stringList\":\"a\",\"objectList\":\"a\",\"after\":1}\"\"\",","+                MAPPER.writeValueAsString(new NonNullBean(\"a\")));","+    }","+","+    @Test","+    void customContentSerializer() throws Exception","+    {","+        assertEquals(\"\"\"","+                {\"values\":[],\"after\":1}\"\"\",","+                MAPPER.writeValueAsString(new ContentUsingBean(\"\")));","+        assertEquals(\"\"\"","+                {\"values\":\"A\",\"after\":1}\"\"\",","+                MAPPER.writeValueAsString(new ContentUsingBean(\"a\")));","+    }","+","+    // Unwrapping without content filtering must not iterate an extra time","+    @Test","+    void iterableNotIteratedExtraWithoutFiltering() throws Exception","+    {","+        ObjectMapper mapper = jsonMapperBuilder()","+                .enable(SerializationFeature.WRITE_SINGLE_ELEM_ARRAYS_UNWRAPPED)","+                .disable(SerializationFeature.APPLY_JSON_INCLUDE_FOR_CONTAINERS)","+                .build();","+        StringIterable it = new StringIterable(\"a\");","+        assertEquals(\"\\\"a\\\"\", mapper.writerFor(new TypeReference<Iterable<String>>() { })","+                .writeValueAsString(it));","+        // once for `hasSingleElement()`, once for actual serialization","+        assertEquals(2, it.iteratorCalls);","+    }","+}",""],"additions":282,"deletions":0,"truncated":false}],"additions":343,"deletions":26,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-11-16T17:23:35.764492+00:00"}