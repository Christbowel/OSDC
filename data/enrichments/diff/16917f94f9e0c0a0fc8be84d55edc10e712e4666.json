\"DUCKDB_TEST_OS_UTIL\", value));","+#endif","+\t}","+\t{","+\t\t// without external access only configuration variables are readable","+\t\tDBConfig config;","+\t\tconfig.SetOptionByName(\"enable_external_access\", Value::BOOLEAN(false));","+\t\t// the embedder declares its own configuration variables before the database exists","+\t\tconfig.options.configuration_env.insert(\"DUCKDB_TEST_OS_UTIL\");","+\t\tDuckDB db(nullptr, &config);","+\t\tauto &os_util = OSUtil::Get(*db.instance);","+\t\tstring value;","+\t\tREQUIRE_THROWS_AS(os_util.GetEnv(\"DUCKDB_TEST_OS_UTIL\", value), PermissionException);","+\t\tREQUIRE_THROWS(os_util.GetEnv(\"DUCKDB_TEST_OS_UTIL\"));","+\t\tREQUIRE(os_util.GetEnvUnrestricted(\"DUCKDB_TEST_OS_UTIL\", value));","+\t\tREQUIRE(value == \"quack\");","+\t\tREQUIRE(os_util.GetEnvUnrestricted(\"HOME\", value));","+#ifndef DUCKDB_CRASH_ON_ASSERT","+\t\tREQUIRE_THROWS(os_util.GetEnvUnrestricted(\"DUCKDB_TEST_OS_UTIL_OTHER\", value));","+#endif","+\t}","+\tunsetenv(\"DUCKDB_TEST_OS_UTIL\");","+}","+#endif"],"additions":54,"deletions":0,"truncated":false},{"path":"tools/shell/shell_extension.cpp","lines":["@@ -3,6 +3,7 @@"," #include \"duckdb/main/extension/extension_loader.hpp\""," #include \"duckdb/common/vector_operations/unary_executor.hpp\""," #include \"duckdb/main/config.hpp\"","+#include \"duckdb/main/os_util.hpp\""," #include \"duckdb/main/settings.hpp\""," #include \"duckdb/planner/planner_extension.hpp\""," #include \"duckdb/planner/logical_operator.hpp\"","@@ -25,14 +26,9 @@ namespace duckdb {"," "," static void GetEnvFunction(DataChunk &args, ExpressionState &state, Vector &result) {"," \tauto &heap = StringVector::GetStringHeap(result);","-\tUnaryExecutor::Execute<string_t, string_t>(args.data[0], result, [&](string_t input) {","-\t\tstring env_name = input.GetString();","-\t\tauto env_value = getenv(env_name.c_str());","-\t\tif (!env_value) {","-\t\t\treturn heap.AddString(string());","-\t\t}","-\t\treturn heap.AddString(env_value);","