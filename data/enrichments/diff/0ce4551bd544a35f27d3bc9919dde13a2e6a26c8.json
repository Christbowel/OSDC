<(), RegistryError> {","     if record.readonly && is_write_request(method, path) {","         return Err(RegistryError::Forbidden {","@@ -281,9 +294,7 @@ fn check_token_restrictions(","         });","     }","     if !record.cidr_whitelist.is_empty() {","-        // The peer address comes from the accepted socket (`ConnectInfo`),","-        // never a client-supplied forwarding header.","-        let allowed = peer.is_some_and(|addr| cidr_whitelist_allows(&record.cidr_whitelist, addr));","+        let allowed = client_ip.is_some_and(|ip| cidr_whitelist_allows(&record.cidr_whitelist, ip));","         if !allowed {","             return Err(RegistryError::Forbidden {","                 user: record.username.clone(),","@@ -401,72 +412,17 @@ fn is_read_only_post_path(path: &str) -> bool {","     )"," }"," ","-/// Whether `peer` falls inside any range of a token's CIDR whitelist. An","-/// IPv4-mapped IPv6 peer is normalized to its IPv4 form first, so a","-/// dual-stack listener still matches plain IPv4 ranges.","-pub(super) fn cidr_whitelist_allows(whitelist: &[String], peer: SocketAddr) -> bool {","-    let peer = canonical_ip(peer.ip());","-    whitelist.iter().any(|entry| cidr_contains(entry.trim(), peer))","+/// Whether `client_ip` falls inside any range of a token's CIDR whitelist.","+pub(super) fn cidr_whitelist_allows(whitelist: &[String], client_ip: IpAddr) -> bool {","+    whitelist.iter().any(|entry| cidr_contains(entry, client_ip))"," }"," ","-pub(super) fn canonical_ip(addr: IpAddr) -> IpAddr {","-    match addr {","-        IpAddr::V6(v6) => v6","-            .to_ipv4_mapped()","-            .map_or(IpAddr::V6(v6), IpAddr::V4),","-        v4 @ IpAddr::V4(_) => v4,","-    }","-}","-","-/// Whether `peer` is inside one `addr/prefix` (or bare `addr`) whitelist","+/// Whether `client_ip` is inside one `addr/prefix` (or bare `addr`) whitelist"," /// entry. A bare address matches only itself; a malformed entry (bad"," /// address, or a non-numeric / out-of-rang