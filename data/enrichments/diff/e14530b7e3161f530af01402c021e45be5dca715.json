{"id":"e14530b7e3161f530af01402c021e45be5dca715","axis":"silent","repo":"quarkusio/quarkus","sha":"e14530b7e3161f530af01402c021e45be5dca715","parsed":{"files":[{"path":"docs/src/main/asciidoc/tls-registry-reference.adoc","lines":["@@ -1137,7 +1137,7 @@ public void reload() {"," private final io.vertx.core.http.HttpServer server;"," "," public void onCertificateUpdate(@Observes CertificateUpdatedEvent reload) {","-    if (\"name\".equals(event.getName())) {","+    if (\"name\".equals(reload.name())) {","         server.updateSSLOptions(reload.tlsConfiguration().getServerSSLOptions());","         // Or update the SSLContext.","     }","@@ -1148,7 +1148,10 @@ public void onCertificateUpdate(@Observes CertificateUpdatedEvent reload) {"," === Periodic reloading"," "," The TLS registry includes a built-in mechanism that periodically checks the file system for changes and reloads certificates.","-The `reload-period` property specifies the interval for reloading certificates and emits a `CertificateUpdatedEvent` each time certificates are reloaded.","+The `reload-period` property specifies the interval for reloading certificates.","+A `CertificateUpdatedEvent` is emitted only when the reloaded keystore, truststore, or CRL content differs from the content previously notified, so servers and clients do not swap their SSL options when nothing changed.","+The comparison relies on `equals`, so the `KeyCertOptions` and `TrustOptions` returned by a custom `KeyStoreProvider`, `TrustStoreProvider`, `KeyStoreFactory`, or `TrustStoreFactory` must implement `equals`, otherwise the event is emitted at every period.","+If the keystore or truststore cannot be reloaded, for example because the file is being rewritten or is corrupted, the cause is logged and the current certificates are kept."," "," . To configure periodic certificate reloading:"," +"],"additions":5,"deletions":2,"truncated":false},{"path":"extensions/tls-registry/deployment/src/test/java/io/quarkus/tls/CertificateUpdatedEventWithPeriodicReloadTest.java","lines":["@@ -67,16 +67,24 @@ public class CertificateUpdatedEventWithPeriodicReloadTest {","     File certs;"," ","     @Test","-    void testPeriodicReloadFiresEvent() throws IOException {","+    void testPeriodicReloadFiresEventOnlyWhenCertificatesChange() throws IOException {","         TlsConfiguration def = registry.getDefault().orElseThrow();","-        assertThat(observer.events()).isEmpty();","+","+        // Reload periods during which nothing changed are silent","+        await().during(3, TimeUnit.SECONDS).atMost(5, TimeUnit.SECONDS)","+                .until(() -> observer.events().isEmpty());"," ","         Files.copy(new File(\"target/certs/test-periodic-event-B-keystore.p12\").toPath(),","                 new File(certs, \"/tls.p12\").toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING);","+        // A reload performed by someone else before the period must not hide the change from the observers","+        assertThat(def.reload()).isTrue();"," ","         await().atMost(10, TimeUnit.SECONDS)","                 .pollInterval(500, TimeUnit.MILLISECONDS)","-                .untilAsserted(() -> assertThat(observer.events()).isNotEmpty());","+                .untilAsserted(() -> assertThat(observer.events()).hasSize(1));","+        // Notified once per rotation, not once per period","+        await().during(3, TimeUnit.SECONDS).atMost(5, TimeUnit.SECONDS)","+                .until(() -> observer.events().size() == 1);"," ","         CertificateUpdatedEvent event = observer.events().get(0);","         assertThat(event.name()).isEqualTo(\"<default>\");"],"additions":11,"deletions":3,"truncated":false},{"path":"extensions/tls-registry/deployment/src/test/java/io/quarkus/tls/CrlReloadFailureTest.java","lines":["@@ -0,0 +1,88 @@","+package io.quarkus.tls;","+","+import static org.assertj.core.api.Assertions.assertThat;","+","+import java.io.File;","+import java.nio.file.Files;","+import java.util.UUID;","+import java.util.logging.Level;","+","+import jakarta.inject.Inject;","+","+import org.eclipse.microprofile.config.inject.ConfigProperty;","+import org.jboss.logmanager.ExtLogRecord;","+import org.jboss.shrinkwrap.api.ShrinkWrap;","+import org.jboss.shrinkwrap.api.asset.StringAsset;","+import org.jboss.shrinkwrap.api.spec.JavaArchive;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.condition.DisabledOnOs;","+import org.junit.jupiter.api.condition.OS;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.test.QuarkusExtensionTest;","+import io.quarkus.tls.runtime.VertxCertificateHolder;","+import io.smallrye.certs.Format;","+import io.smallrye.certs.junit5.Certificate;","+import io.smallrye.certs.junit5.Certificates;","+","+/**","+ * An unreadable certificate revocation list fails the reload, is logged, and keeps the current list.","+ */","+@Certificates(baseDir = \"target/certs\", certificates = {","+        @Certificate(name = \"test-crl-reload-fail\", password = \"password\", formats = Format.PKCS12, subjectAlternativeNames = \"dns:localhost\")","+})","+@DisabledOnOs(OS.WINDOWS)","+public class CrlReloadFailureTest {","+","+    private static final String configuration = \"\"\"","+            # No config","+            \"\"\";","+","+    public static final File temp = new File(\"target/test-certificates-\" + UUID.randomUUID());","+","+    @RegisterExtension","+    static final QuarkusExtensionTest config = new QuarkusExtensionTest().setArchiveProducer(","+            () -> ShrinkWrap.create(JavaArchive.class)","+                    .add(new StringAsset(configuration), \"application.properties\"))","+            .overrideRuntimeConfigKey(\"quarkus.tls.key-store.p12.path\", temp.getAbsolutePath() + \"/tls.p12\")","+            .overrideRuntimeConfigKey(\"quarkus.tls.key-store.p12.password\", \"password\")","+            .overrideRuntimeConfigKey(\"quarkus.tls.certificate-revocation-list\", temp.getAbsolutePath() + \"/crl.der\")","+            .overrideRuntimeConfigKey(\"loc\", temp.getAbsolutePath())","+            .setLogRecordPredicate(r -> r.getLoggerName().equals(VertxCertificateHolder.class.getName()))","+            .assertLogRecords(records -> assertThat(records)","+                    .filteredOn(r -> r.getLevel().intValue() >= Level.SEVERE.intValue())","+                    .singleElement().satisfies(r -> {","+                        assertThat(((ExtLogRecord) r).getFormattedMessage())","+                                .contains(\"Unable to reload the certificate revocation list\");","+                        assertThat(r.getThrown()).isNotNull();","+                    }))","+            .setBeforeAllCustomizer(() -> {","+                try {","+                    temp.mkdirs();","+                    Files.copy(new File(\"target/certs/test-crl-reload-fail-keystore.p12\").toPath(),","+                            new File(temp, \"/tls.p12\").toPath());","+                    Files.copy(new File(\"src/test/resources/revocations/revoked-cert.der\").toPath(),","+                            new File(temp, \"/crl.der\").toPath());","+                } catch (Exception e) {","+                    throw new RuntimeException(e);","+                }","+            });","+","+    @Inject","+    TlsConfigurationRegistry registry;","+","+    @ConfigProperty(name = \"loc\")","+    File certs;","+","+    @Test","+    void testUnreadableCrlKeepsCurrentList() throws Exception {","+        TlsConfiguration def = registry.getDefault().orElseThrow();","+        byte[] original = Files.readAllBytes(new File(certs, \"/crl.der\").toPath());","+","+        Files.delete(new File(certs, \"/crl.der\").toPath());","+","+        assertThat(def.reload()).isFalse();","+        assertThat(def.getServerSSLOptions().getCrlValues())","+                .singleElement().satisfies(b -> assertThat(b.getBytes()).isEqualTo(original));","+    }","+}"],"additions":88,"deletions":0,"truncated":false},{"path":"extensions/tls-registry/deployment/src/test/java/io/quarkus/tls/PeriodicReloadWithCRLChangeTest.java","lines":["@@ -0,0 +1,128 @@","+package io.quarkus.tls;","+","+import static org.assertj.core.api.Assertions.assertThat;","+import static org.awaitility.Awaitility.await;","+","+import java.io.File;","+import java.math.BigInteger;","+import java.nio.file.Files;","+import java.nio.file.StandardCopyOption;","+import java.security.KeyPairGenerator;","+import java.util.Date;","+import java.util.UUID;","+import java.util.concurrent.CopyOnWriteArrayList;","+import java.util.concurrent.TimeUnit;","+","+import jakarta.enterprise.context.ApplicationScoped;","+import jakarta.enterprise.event.Observes;","+import jakarta.inject.Inject;","+","+import org.bouncycastle.asn1.x500.X500Name;","+import org.bouncycastle.asn1.x509.CRLReason;","+import org.bouncycastle.cert.X509v2CRLBuilder;","+import org.bouncycastle.operator.jcajce.JcaContentSignerBuilder;","+import org.eclipse.microprofile.config.inject.ConfigProperty;","+import org.jboss.shrinkwrap.api.ShrinkWrap;","+import org.jboss.shrinkwrap.api.asset.StringAsset;","+import org.jboss.shrinkwrap.api.spec.JavaArchive;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.condition.DisabledOnOs;","+import org.junit.jupiter.api.condition.OS;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.test.QuarkusExtensionTest;","+import io.smallrye.certs.Format;","+import io.smallrye.certs.junit5.Certificate;","+import io.smallrye.certs.junit5.Certificates;","+","+/**","+ * A change limited to the certificate revocation list, with the key store left untouched, must be notified.","+ */","+@Certificates(baseDir = \"target/certs\", certificates = {","+        @Certificate(name = \"test-periodic-crl\", password = \"password\", formats = Format.PKCS12, subjectAlternativeNames = \"dns:localhost\")","+})","+@DisabledOnOs(OS.WINDOWS)","+public class PeriodicReloadWithCRLChangeTest {","+","+    private static final String configuration = \"\"\"","+            # No config","+            \"\"\";","+","+    public static final File temp = new File(\"target/test-certificates-\" + UUID.randomUUID());","+","+    @RegisterExtension","+    static final QuarkusExtensionTest config = new QuarkusExtensionTest().setArchiveProducer(","+            () -> ShrinkWrap.create(JavaArchive.class)","+                    .addClasses(CertificateUpdateObserver.class)","+                    .add(new StringAsset(configuration), \"application.properties\"))","+            .overrideRuntimeConfigKey(\"quarkus.tls.key-store.p12.path\", temp.getAbsolutePath() + \"/tls.p12\")","+            .overrideRuntimeConfigKey(\"quarkus.tls.key-store.p12.password\", \"password\")","+            .overrideRuntimeConfigKey(\"quarkus.tls.certificate-revocation-list\", temp.getAbsolutePath() + \"/crl.der\")","+            .overrideRuntimeConfigKey(\"quarkus.tls.reload-period\", \"1s\")","+            .overrideRuntimeConfigKey(\"loc\", temp.getAbsolutePath())","+            .setBeforeAllCustomizer(() -> {","+                try {","+                    temp.mkdirs();","+                    Files.copy(new File(\"target/certs/test-periodic-crl-keystore.p12\").toPath(),","+                            new File(temp, \"/tls.p12\").toPath());","+                    Files.copy(new File(\"src/test/resources/revocations/revoked-cert.der\").toPath(),","+                            new File(temp, \"/crl.der\").toPath());","+                } catch (Exception e) {","+                    throw new RuntimeException(e);","+                }","+            });","+","+    @Inject","+    TlsConfigurationRegistry registry;","+","+    @Inject","+    CertificateUpdateObserver observer;","+","+    @ConfigProperty(name = \"loc\")","+    File certs;","+","+    @Test","+    void testCrlOnlyChangeFiresEvent() throws Exception {","+        TlsConfiguration def = registry.getDefault().orElseThrow();","+        byte[] newCrl = generateCrl();","+","+        await().during(2, TimeUnit.SECONDS).atMost(4, TimeUnit.SECONDS)","+                .until(() -> observer.events().isEmpty());","+","+        File tmp = new File(certs, \"/crl.der.tmp\");","+        Files.write(tmp.toPath(), newCrl);","+        Files.move(tmp.toPath(), new File(certs, \"/crl.der\").toPath(), StandardCopyOption.REPLACE_EXISTING);","+","+        await().atMost(10, TimeUnit.SECONDS)","+                .untilAsserted(() -> assertThat(observer.events()).hasSize(1));","+        assertThat(def.getServerSSLOptions().getCrlValues())","+                .singleElement().satisfies(b -> assertThat(b.getBytes()).isEqualTo(newCrl));","+    }","+","+    /**","+     * The registry only reads the bytes of the list, so a throwaway issuer is enough.","+     */","+    private static byte[] generateCrl() throws Exception {","+        KeyPairGenerator generator = KeyPairGenerator.getInstance(\"RSA\");","+        generator.initialize(2048);","+        Date now = new Date();","+        X509v2CRLBuilder builder = new X509v2CRLBuilder(new X500Name(\"CN=test-periodic-crl\"), now);","+        builder.addCRLEntry(BigInteger.TWO, now, CRLReason.privilegeWithdrawn);","+        return builder.build(new JcaContentSignerBuilder(\"SHA256withRSA\").build(generator.generateKeyPair().getPrivate()))","+                .getEncoded();","+    }","+","+    @ApplicationScoped","+    public static class CertificateUpdateObserver {","+","+        private final CopyOnWriteArrayList<CertificateUpdatedEvent> receivedEvents = new CopyOnWriteArrayList<>();","+","+        public void onCertificateUpdate(@Observes CertificateUpdatedEvent event) {","+            receivedEvents.add(event);","+        }","+","+        public CopyOnWriteArrayList<CertificateUpdatedEvent> events() {","+            return receivedEvents;","+        }","+    }","+}"],"additions":128,"deletions":0,"truncated":false},{"path":"extensions/tls-registry/deployment/src/test/java/io/quarkus/tls/PeriodicReloadWithContentlessOptionsTest.java","lines":["@@ -0,0 +1,97 @@","+package io.quarkus.tls;","+","+import static org.assertj.core.api.Assertions.assertThat;","+import static org.awaitility.Awaitility.await;","+","+import java.io.FileInputStream;","+import java.security.KeyStore;","+import java.util.concurrent.CopyOnWriteArrayList;","+import java.util.concurrent.TimeUnit;","+","+import jakarta.enterprise.context.ApplicationScoped;","+import jakarta.enterprise.event.Observes;","+import jakarta.inject.Inject;","+","+import org.jboss.shrinkwrap.api.ShrinkWrap;","+import org.jboss.shrinkwrap.api.asset.StringAsset;","+import org.jboss.shrinkwrap.api.spec.JavaArchive;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.test.QuarkusExtensionTest;","+import io.smallrye.certs.Format;","+import io.smallrye.certs.junit5.Certificate;","+import io.smallrye.certs.junit5.Certificates;","+import io.smallrye.common.annotation.Identifier;","+import io.vertx.core.Vertx;","+import io.vertx.core.net.KeyStoreOptions;","+","+/**","+ * A {@link KeyStoreFactory} may return options that do not embed the store content (PKCS#11, path-based), so they","+ * stay equal across a rotation. The rotation must still be notified.","+ */","+@Certificates(baseDir = \"target/certs\", certificates = {","+        @Certificate(name = \"test-contentless-A\", password = \"password\", formats = Format.PKCS12, subjectAlternativeNames = \"dns:localhost\"),","+        @Certificate(name = \"test-contentless-B\", password = \"password\", formats = Format.PKCS12, subjectAlternativeNames = \"dns:acme.org\")","+})","+public class PeriodicReloadWithContentlessOptionsTest {","+","+    private static final String configuration = \"\"\"","+            quarkus.tls.key-store.other.type=test-contentless","+            quarkus.tls.reload-period=1s","+            \"\"\";","+","+    @RegisterExtension","+    static final QuarkusExtensionTest config = new QuarkusExtensionTest().setArchiveProducer(","+            () -> ShrinkWrap.create(JavaArchive.class)","+                    .addClasses(ContentlessKeyStoreFactory.class, CertificateUpdateObserver.class)","+                    .add(new StringAsset(configuration), \"application.properties\"));","+","+    @Inject","+    CertificateUpdateObserver observer;","+","+    @Test","+    void testRotationIsNotifiedWhenOptionsAreUnchanged() {","+        await().during(2, TimeUnit.SECONDS).atMost(4, TimeUnit.SECONDS)","+                .until(() -> observer.events().isEmpty());","+","+        ContentlessKeyStoreFactory.useCertB = true;","+","+        await().atMost(10, TimeUnit.SECONDS)","+                .untilAsserted(() -> assertThat(observer.events()).hasSize(1));","+    }","+","+    @ApplicationScoped","+    @Identifier(\"test-contentless\")","+    public static class ContentlessKeyStoreFactory implements KeyStoreFactory {","+","+        static volatile boolean useCertB = false;","+","+        @Override","+        public KeyStoreAndKeyCertOptions createKeyStore(OtherKeyStoreConfiguration config, Vertx vertx, String name) {","+            String path = \"target/certs/test-contentless-\" + (useCertB ? \"B\" : \"A\") + \"-keystore.p12\";","+            try (var fis = new FileInputStream(path)) {","+                KeyStore ks = KeyStore.getInstance(\"PKCS12\");","+                ks.load(fis, \"password\".toCharArray());","+                // Same options whatever the content, like a PKCS#11 token","+                return new KeyStoreAndKeyCertOptions(ks, new KeyStoreOptions().setType(\"PKCS12\").setPassword(\"password\"));","+            } catch (Exception e) {","+                throw new RuntimeException(e);","+            }","+        }","+    }","+","+    @ApplicationScoped","+    public static class CertificateUpdateObserver {","+","+        private final CopyOnWriteArrayList<CertificateUpdatedEvent> receivedEvents = new CopyOnWriteArrayList<>();","+","+        public void onCertificateUpdate(@Observes CertificateUpdatedEvent event) {","+            receivedEvents.add(event);","+        }","+","+        public CopyOnWriteArrayList<CertificateUpdatedEvent> events() {","+            return receivedEvents;","+        }","+    }","+}"],"additions":97,"deletions":0,"truncated":false},{"path":"extensions/tls-registry/deployment/src/test/java/io/quarkus/tls/PeriodicReloadWithFailingObserverTest.java","lines":["@@ -0,0 +1,100 @@","+package io.quarkus.tls;","+","+import static org.assertj.core.api.Assertions.assertThat;","+import static org.awaitility.Awaitility.await;","+","+import java.io.File;","+import java.nio.file.Files;","+import java.nio.file.StandardCopyOption;","+import java.util.UUID;","+import java.util.concurrent.CopyOnWriteArrayList;","+import java.util.concurrent.TimeUnit;","+","+import jakarta.enterprise.context.ApplicationScoped;","+import jakarta.enterprise.event.Observes;","+import jakarta.inject.Inject;","+","+import org.eclipse.microprofile.config.inject.ConfigProperty;","+import org.jboss.shrinkwrap.api.ShrinkWrap;","+import org.jboss.shrinkwrap.api.asset.StringAsset;","+import org.jboss.shrinkwrap.api.spec.JavaArchive;","+import org.junit.jupiter.api.Test;","+import org.junit.jupiter.api.extension.RegisterExtension;","+","+import io.quarkus.test.QuarkusExtensionTest;","+import io.smallrye.certs.Format;","+import io.smallrye.certs.junit5.Certificate;","+import io.smallrye.certs.junit5.Certificates;","+","+/**","+ * A failing observer stops the remaining ones, so the rotation must be notified again at the next period instead of","+ * being lost.","+ */","+@Certificates(baseDir = \"target/certs\", certificates = {","+        @Certificate(name = \"test-failing-observer-A\", password = \"password\", formats = Format.PKCS12, subjectAlternativeNames = \"dns:localhost\"),","+        @Certificate(name = \"test-failing-observer-B\", password = \"password\", formats = Format.PKCS12, subjectAlternativeNames = \"dns:acme.org\")","+})","+public class PeriodicReloadWithFailingObserverTest {","+","+    private static final String configuration = \"\"\"","+            # No config","+            \"\"\";","+","+    public static final File temp = new File(\"target/test-certificates-\" + UUID.randomUUID());","+","+    @RegisterExtension","+    static final QuarkusExtensionTest config = new QuarkusExtensionTest().setArchiveProducer(","+            () -> ShrinkWrap.create(JavaArchive.class)","+                    .addClasses(FailingOnceObserver.class)","+                    .add(new StringAsset(configuration), \"application.properties\"))","+            .overrideRuntimeConfigKey(\"quarkus.tls.key-store.p12.path\", temp.getAbsolutePath() + \"/tls.p12\")","+            .overrideRuntimeConfigKey(\"quarkus.tls.key-store.p12.password\", \"password\")","+            .overrideRuntimeConfigKey(\"quarkus.tls.reload-period\", \"1s\")","+            .overrideRuntimeConfigKey(\"loc\", temp.getAbsolutePath())","+            .setBeforeAllCustomizer(() -> {","+                try {","+                    temp.mkdirs();","+                    Files.copy(new File(\"target/certs/test-failing-observer-A-keystore.p12\").toPath(),","+                            new File(temp, \"/tls.p12\").toPath());","+                } catch (Exception e) {","+                    throw new RuntimeException(e);","+                }","+            });","+","+    @Inject","+    FailingOnceObserver observer;","+","+    @ConfigProperty(name = \"loc\")","+    File certs;","+","+    @Test","+    void testRotationIsNotifiedAgainAfterAFailingObserver() throws Exception {","+        File tmp = new File(certs, \"/tls.p12.tmp\");","+        Files.copy(new File(\"target/certs/test-failing-observer-B-keystore.p12\").toPath(), tmp.toPath());","+        Files.move(tmp.toPath(), new File(certs, \"/tls.p12\").toPath(), StandardCopyOption.REPLACE_EXISTING);","+","+        // The first notification fails, the next period notifies again and succeeds","+        await().atMost(10, TimeUnit.SECONDS)","+                .untilAsserted(() -> assertThat(observer.events()).hasSize(2));","+        // Once delivered, the rotation is not notified again","+        await().during(3, TimeUnit.SECONDS).atMost(5, TimeUnit.SECONDS)","+                .until(() -> observer.events().size() == 2);","+    }","+","+    @ApplicationScoped","+    public static class FailingOnceObserver {","+","+        private final CopyOnWriteArrayList<CertificateUpdatedEvent> receivedEvents = new CopyOnWriteArrayList<>();","+","+        public void onCertificateUpdate(@Observes CertificateUpdatedEvent event) {","+            receivedEvents.add(event);","+            if (receivedEvents.size() == 1) {","+                throw new IllegalStateException(\"boom\");","+            }","+        }","+","+        public CopyOnWriteArrayList<CertificateUpdatedEvent> events() {","+            return receivedEvents;","+        }","+    }","+}"],"additions":100,"deletions":0,"truncated":false},{"path":"extensions/tls-registry/deployment/src/test/java/io/quarkus/tls/ReloadFailureTest.java","lines":["@@ -9,10 +9,12 @@"," import java.security.cert.CertificateParsingException;"," import java.security.cert.X509Certificate;"," import java.util.UUID;","+import java.util.logging.Level;"," "," import jakarta.inject.Inject;"," "," import org.eclipse.microprofile.config.inject.ConfigProperty;","+import org.jboss.logmanager.ExtLogRecord;"," import org.jboss.shrinkwrap.api.ShrinkWrap;"," import org.jboss.shrinkwrap.api.asset.StringAsset;"," import org.jboss.shrinkwrap.api.spec.JavaArchive;","@@ -20,6 +22,7 @@"," import org.junit.jupiter.api.extension.RegisterExtension;"," "," import io.quarkus.test.QuarkusExtensionTest;","+import io.quarkus.tls.runtime.VertxCertificateHolder;"," import io.smallrye.certs.Format;"," import io.smallrye.certs.junit5.Certificate;"," import io.smallrye.certs.junit5.Certificates;","@@ -42,6 +45,14 @@ public class ReloadFailureTest {","             .overrideRuntimeConfigKey(\"qu