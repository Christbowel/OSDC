{"id":"be36a379fcbdb2cb165571ae8fe4ccb6d1c0821e","axis":"silent","repo":"kubevela/kubevela","sha":"be36a379fcbdb2cb165571ae8fe4ccb6d1c0821e","parsed":{"files":[{"path":"charts/vela-core/definitions/helmchart.yaml","lines":["@@ -204,6 +204,9 @@ spec:","         \tappNamespace: context.namespace","         \tname:         context.name","         \tnamespace:    context.namespace","+        \tif context.cluster != _|_ {","+        \t\tcluster: context.cluster","+        \t}","         }"," ","         // Render the Helm chart using the provider"],"additions":3,"deletions":0,"truncated":false},{"path":"pkg/appfile/dryrun/diff.go","lines":["@@ -36,6 +36,7 @@ import ("," \t\"github.com/oam-dev/kubevela/apis/core.oam.dev/v1beta1\""," \t\"github.com/oam-dev/kubevela/apis/types\""," \t\"github.com/oam-dev/kubevela/pkg/appfile\"","+\t\"github.com/oam-dev/kubevela/pkg/cue/cuex/providers/helm\""," \t\"github.com/oam-dev/kubevela/pkg/oam\""," \toamutil \"github.com/oam-dev/kubevela/pkg/oam/util\""," )","@@ -499,6 +500,8 @@ func generateManifestFromAppRevision(parser *appfile.Parser, appRevision *v1beta"," \t\treturn nil, err"," \t}"," \taf.Context = withPlaceholders(af.Context, &appRevision.Spec.Application)","+\t// Rendered as the other side of the diff is, client-side, so a chart is not installed.","+\taf.Context = helm.WithDryRun(af.Context)"," \tcomps, err := af.GenerateComponentManifests()"," \tif err != nil {"," \t\treturn nil, err"],"additions":3,"deletions":0,"truncated":false},{"path":"pkg/appfile/dryrun/dryrun.go","lines":["@@ -39,6 +39,7 @@ import ("," \t\"github.com/oam-dev/kubevela/apis/core.oam.dev/v1beta1\""," \t\"github.com/oam-dev/kubevela/apis/types\""," \t\"github.com/oam-dev/kubevela/pkg/appfile\"","+\t\"github.com/oam-dev/kubevela/pkg/cue/cuex/providers/helm\""," \t\"github.com/oam-dev/kubevela/pkg/cue/definition\""," \t\"github.com/oam-dev/kubevela/pkg/oam\""," \toamutil \"github.com/oam-dev/kubevela/pkg/oam/util\"","@@ -160,6 +161,8 @@ func (d *Option) ExecuteDryRun(ctx context.Context, application *v1beta1.Applica"," // withPlaceholders."," func (d *Option) executeDryRun(ctx context.Context, application *v1beta1.Application) ([]*types.ComponentManifest, []*unstructured.Unstructured, error) {"," \tctx = withPlaceholders(ctx, application)","+\t// A chart is rendered client-side, as admission renders it, rather than installed.","+\tctx = helm.WithDryRun(ctx)"," \tapp := application.DeepCopy()"," \tif app.Namespace != \"\" {"," \t\tctx = oamutil.SetNamespaceInCtx(ctx, app.Namespace)"],"additions":3,"deletions":0,"truncated":false},{"path":"pkg/cue/cuex/providers/helm/cluster.go","lines":["@@ -0,0 +1,206 @@","+/*","+Copyright 2026 The KubeVela Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+\thttp://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package helm","+","+// Kubernetes clients for the cluster a chart is rendered for, acting as the render's user: the hub","+// for the local cluster, and cluster-gateway for a managed one, routed the way the controller's own","+// multicluster client is.","+","+import (","+\t\"context\"","+\t\"os\"","+\t\"time\"","+","+\tpkgmulticluster \"github.com/kubevela/pkg/multicluster\"","+\t\"github.com/pkg/errors\"","+\t\"k8s.io/apimachinery/pkg/api/meta\"","+\t\"k8s.io/apiserver/pkg/endpoints/request\"","+\t\"k8s.io/cli-runtime/pkg/genericclioptions\"","+\t\"k8s.io/client-go/discovery\"","+\t\"k8s.io/client-go/discovery/cached/memory\"","+\t\"k8s.io/client-go/rest\"","+\t\"k8s.io/client-go/restmapper\"","+\t\"k8s.io/client-go/tools/clientcmd\"","+\tclientcmdapi \"k8s.io/client-go/tools/clientcmd/api\"","+)","+","+const (","+\t// clusterClientsCacheSize bounds the clusters whose clients are kept.","+\tclusterClientsCacheSize = 256","+\t// clusterClientsIdleTTL drops a cluster's clients, and its cached discovery, once unused this long.","+\tclusterClientsIdleTTL = time.Hour","+)","+","+// clusterClients is what every render for one cluster shares: the REST config that reaches it,","+// acting as the controller, and an in-memory discovery cache. Helm invalidates that cache before","+// each install or upgrade, when it reads the cluster's capabilities.","+type clusterClients struct {","+\tconfig    *rest.Config","+\tdiscovery discovery.CachedDiscoveryInterface","+}","+","+// clusterFrom returns the cluster a render is for, \"local\" when the context names none.","+func clusterFrom(ctx context.Context) string {","+\tif cluster, ok := pkgmulticluster.ClusterFrom(ctx); ok && !pkgmulticluster.IsLocal(cluster) {","+\t\treturn cluster","+\t}","+\treturn pkgmulticluster.Local","+}","+","+// restClientGetter returns the Helm client getter for the cluster a render is for, acting as the","+// user the render carries, as the controller's impersonating round tripper does. Helm does not","+// pass the caller's context on every request, so both are pinned on the getter's config.","+//","+// The local cluster with no user uses the Helm environment's own getter. Any other render gets a","+// getter over its cluster's shared clients, with the user's impersonation on its own copy of the","+// config, so discovery is cached per cluster however many users render there.","+func (p *Provider) restClientGetter(ctx context.Context) (genericclioptions.RESTClientGetter, error) {","+\tcluster := clusterFrom(ctx)","+\tu, _ := request.UserFrom(ctx)","+\tif u != nil && u.GetName() == \"\" {","+\t\tu = nil","+\t}","+\tif pkgmulticluster.IsLocal(cluster) && u == nil {","+\t\treturn p.helmClient.RESTClientGetter(), nil","+\t}","+\tclients, err := p.clientsFor(cluster)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tcfg := rest.CopyConfig(clients.config)","+\tif u != nil {","+\t\tcfg.Impersonate = rest.ImpersonationConfig{UserName: u.GetName(), Groups: u.GetGroups()}","+\t}","+\treturn &clusterRESTClientGetter{config: cfg, discovery: clients.discovery}, nil","+}","+","+// clientsFor returns a cluster's shared clients, building them on first use. Building them makes","+// no request, so holding the lock is cheap.","+func (p *Provider) clientsFor(cluster string) (*clusterClients, error) {","+\tp.clusterClientsMu.Lock()","+\tdefer p.clusterClientsMu.Unlock()","+\tif clients, ok := p.clusterClients.Get(cluster); ok {","+\t\tp.clusterClients.Put(cluster, clients, clusterClientsIdleTTL)","+\t\treturn clients, nil","+\t}","+\thub, err := p.hubConfig()","+\tif err != nil {","+\t\treturn nil, errors.Wrap(err, \"failed to get the hub REST config\")","+\t}","+\tcfg := rest.CopyConfig(hub)","+\tif !pkgmulticluster.IsLocal(cluster) {","+\t\tif cfg, err = routeToCluster(cfg, cluster); err != nil {","+\t\t\treturn nil, err","+\t\t}","+\t}","+\tdc, err := discovery.NewDiscoveryClientForConfig(cfg)","+\tif err != nil {","+\t\treturn nil, errors.Wrapf(err, \"failed to build a discovery client for cluster %s\", cluster)","+\t}","+\tclients := &clusterClients{config: cfg, discovery: memory.NewMemCacheClient(dc)}","+\tp.clusterClients.Put(cluster, clients, clusterClientsIdleTTL)","+\treturn clients, nil","+}","+","+// routeToCluster returns a copy of the hub config that reaches a managed cluster through","+// cluster-gateway: the aggregated API by default, or the gateway itself when","+// --cluster-gateway-url is set, as kubevela/pkg's multicluster.NewClient does.","+func routeToCluster(hub *rest.Config, cluster string) (*rest.Config, error) {","+\tcfg := rest.CopyConfig(hub)","+\tcfg.Wrap(pkgmulticluster.NewTransportWrapper(pkgmulticluster.ForCluster(cluster)))","+\tgateway := pkgmulticluster.DefaultClusterGatewayClientOptions","+\tif gateway.URL == \"\" {","+\t\treturn cfg, nil","+\t}","+\tcfg.Host = gateway.URL","+\t// client-go rejects a CA file alongside Insecure, so the hub's in-cluster CA file goes either way.","+\tcfg.CAFile = \"\"","+\tif gateway.CAFile == \"\" {","+\t\tcfg.CAData = nil","+\t\tcfg.Insecure = true","+\t\treturn cfg, nil","+\t}","+\tca, err := os.ReadFile(gateway.CAFile)","+\tif err != nil {","+\t\treturn nil, errors.Wrap(err, \"failed to read the cluster-gateway CA file\")","+\t}","+\tcfg.CAData = ca","+\treturn cfg, nil","+}","+","+// clusterRESTClientGetter is a RESTClientGetter over a fixed REST config and a cluster's shared","+// discovery. Each REST mapper it hands out is new, so it maps whatever discovery last fetched.","+type clusterRESTClientGetter struct {","+\tconfig    *rest.Config","+\tdiscovery discovery.CachedDiscoveryInterface","+}","+","+// ToRESTConfig implements genericclioptions.RESTClientGetter.","+func (g *clusterRESTClientGetter) ToRESTConfig() (*rest.Config, error) {","+\treturn rest.CopyConfig(g.config), nil","+}","+","+// ToDiscoveryClient implements genericclioptions.RESTClientGetter.","+func (g *clusterRESTClientGetter) ToDiscoveryClient() (discovery.CachedDiscoveryInterface, error) {","+\treturn g.discovery, nil","+}","+","+// ToRESTMapper implements genericclioptions.RESTClientGetter.","+func (g *clusterRESTClientGetter) ToRESTMapper() (meta.RESTMapper, error) {","+\treturn restmapper.NewShortcutExpander(restmapper.NewDeferredDiscoveryRESTMapper(g.discovery), g.discovery, nil), nil","+}","+","+// ToRawKubeConfigLoader implements genericclioptions.RESTClientGetter. Helm reads only the","+// namespace from it, and inReleaseNamespace overrides that.","+func (g *clusterRESTClientGetter) ToRawKubeConfigLoader() clientcmd.ClientConfig {","+\treturn clientcmd.NewDefaultClientConfig(*clientcmdapi.NewConfig(), &clientcmd.ConfigOverrides{})","+}","+","+// inReleaseNamespace wraps a getter so its kubeconfig reports the release namespace. Helm's kube","+// client places every object that names no namespace there, and the post-renderer that stamps","+// the namespace on rendered resources never sees hooks.","+func inReleaseNamespace(getter genericclioptions.RESTClientGetter, namespace string) genericclioptions.RESTClientGetter {","+\treturn &namespacedGetter{RESTClientGetter: getter, namespace: namespace}","+}","+","+type namespacedGetter struct {","+\tgenericclioptions.RESTClientGetter","+\tnamespace string","+}","+","+// ToRawKubeConfigLoader implements genericclioptions.RESTClientGetter.","+func (g *namespacedGetter) ToRawKubeConfigLoader() clientcmd.ClientConfig {","+\treturn &namespacedClientConfig{base: g.RESTClientGetter.ToRawKubeConfigLoader(), namespace: g.namespace}","+}","+","+// namespacedClientConfig is a clientcmd.ClientConfig that reports a fixed namespace.","+type namespacedClientConfig struct {","+\tbase      clientcmd.ClientConfig","+\tnamespace string","+}","+","+// RawConfig implements clientcmd.ClientConfig.","+func (c *namespacedClientConfig) RawConfig() (clientcmdapi.Config, error) { return c.base.RawConfig() }","+","+// ClientConfig implements clientcmd.ClientConfig.","+func (c *namespacedClientConfig) ClientConfig() (*rest.Config, error) { return c.base.ClientConfig() }","+","+// Namespace implements clientcmd.ClientConfig.","+func (c *namespacedClientConfig) Namespace() (string, bool, error) { return c.namespace, true, nil }","+","+// ConfigAccess implements clientcmd.ClientConfig.","+func (c *namespacedClientConfig) ConfigAccess() clientcmd.ConfigAccess { return c.base.ConfigAccess() }"],"additions":206,"deletions":0,"truncated":false},{"path":"pkg/cue/cuex/providers/helm/cluster_test.go","lines":["@@ -0,0 +1,442 @@","+/*","+Copyright 2026 The KubeVela Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+\thttp://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+*/","+","+package helm","+","+import (","+\t\"context\"","+\t\"fmt\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"strings\"","+\t\"sync\"","+\t\"time\"","+","+\t\"github.com/kubevela/pkg/cue/cuex/providers\"","+\tpkgmulticluster \"github.com/kubevela/pkg/multicluster\"","+\t\"github.com/kubevela/pkg/util/singleton\"","+\t. \"github.com/onsi/ginkgo/v2\"","+\t. \"github.com/onsi/gomega\"","+\t\"helm.sh/helm/v3/pkg/action\"","+\t\"helm.sh/helm/v3/pkg/chart\"","+\t\"k8s.io/apimachinery/pkg/api/meta\"","+\tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\"","+\t\"k8s.io/apimachinery/pkg/runtime\"","+\t\"k8s.io/apimachinery/pkg/runtime/schema\"","+\t\"k8s.io/apiserver/pkg/authentication/user\"","+\t\"k8s.io/apiserver/pkg/endpoints/request\"","+\t\"k8s.io/client-go/discovery\"","+\t\"k8s.io/client-go/kubernetes\"","+\tclientsetfake \"k8s.io/client-go/kubernetes/fake\"","+\t\"k8s.io/client-go/rest\"","+\t\"k8s.io/client-go/transport\"","+\t\"sigs.k8s.io/controller-runtime/pkg/client/fake\"","+","+\t\"github.com/oam-dev/kubevela/apis/core.oam.dev/v1beta1\"","+\t\"github.com/oam-dev/kubevela/pkg/oam\"","+)","+","+// pathRecorder is an API server stub that answers /version on any prefix and records each","+// path and the user each request impersonates.","+type pathRecorder struct {","+\tmu    sync.Mutex","+\tpaths []string","+\tusers []string","+}","+","+func (r *pathRecorder) ServeHTTP(w http.ResponseWriter, req *http.Request) {","+\tr.mu.Lock()","+\tr.paths = append(r.paths, req.URL.Path)","+\tr.users = append(r.users, req.Header.Get(transport.ImpersonateUserHeader))","+\tr.mu.Unlock()","+\tw.Header().Set(\"Content-Type\", \"application/json\")","+\t_, _ = w.Write([]byte(`{\"major\":\"1\",\"minor\":\"31\",\"gitVersion\":\"v1.31.0\"}`))","+}","+","+func (r *pathRecorder) Paths() []string {","+\tr.mu.Lock()","+\tdefer r.mu.Unlock()","+\treturn append([]string(nil), r.paths...)","+}","+","+func (r *pathRecorder) Users() []string {","+\tr.mu.Lock()","+\tdefer r.mu.Unlock()","+\treturn append([]string(nil), r.users...)","+}","+","+// renderCtx is the context the controller renders a component in: its cluster, and the","+// Application's user when there is one.","+func renderCtx(cluster string, u user.Info) context.Context {","+\tctx := pkgmulticluster.WithCluster(context.Background(), cluster)","+\tif u != nil {","+\t\tctx = request.WithUser(ctx, u)","+\t}","+\treturn ctx","+}","+","+var _ = Describe(\"Helm clients per cluster\", func() {","+\tconst proxyVersion = \"/apis/cluster.core.oam.dev/v1alpha1/clustergateways/managed/proxy/version\"","+","+\tvar (","+\t\thub     *pathRecorder","+\t\thubSrv  *httptest.Server","+\t\tp       *Provider","+\t\tsaveOpt pkgmulticluster.ClusterGatewayClientOptions","+\t)","+","+\tBeforeEach(func() {","+\t\thub = &pathRecorder{}","+\t\thubSrv = httptest.NewServer(hub)","+\t\tp = NewProviderWithConfig(nil)","+\t\tp.hubConfig = func() (*rest.Config, error) { return &rest.Config{Host: hubSrv.URL}, nil }","+\t\tsaveOpt = pkgmulticluster.DefaultClusterGatewayClientOptions","+\t})","+","+\tAfterEach(func() {","+\t\tpkgmulticluster.DefaultClusterGatewayClientOptions = saveOpt","+\t\thubSrv.Close()","+\t\tp.Close()","+\t})","+","+\t// serverVersion makes a request with the getter's REST config, the one Helm's writes use.","+\tserverVersion := func(ctx context.Context) {","+\t\tgetter, err := p.restClientGetter(ctx)","+\t\tExpect(err).ShouldNot(HaveOccurred())","+\t\tcfg, err := getter.ToRESTConfig()","+\t\tExpect(err).ShouldNot(HaveOccurred())","+\t\tdc, err := discovery.NewDiscoveryClientForConfig(cfg)","+\t\tExpect(err).ShouldNot(HaveOccurred())","+\t\t_, err = dc.ServerVersion()","+\t\tExpect(err).ShouldNot(HaveOccurred())","+\t}","+","+\tIt(\"uses the Helm environment's own client for the local cluster with no user\", func() {","+\t\tfor _, ctx := range []context.Context{context.Background(), renderCtx(pkgmulticluster.Local, nil), renderCtx(pkgmulticluster.Local, &user.DefaultInfo{})} {","+\t\t\tgetter, err := p.restClientGetter(ctx)","+\t\t\tExpect(err).ShouldNot(HaveOccurred())","+\t\t\tExpect(getter).Should(BeIdenticalTo(p.helmClient.RESTClientGetter()))","+\t\t}","+\t})","+","+\tIt(\"acts as the render's user on the local cluster\", func() {","+\t\tserverVersion(renderCtx(pkgmulticluster.Local, &user.DefaultInfo{Name: \"alice\", Groups: []string{\"dev\"}}))","+\t\tExpect(hub.Paths()).Should(ConsistOf(\"/version\"))","+\t\tExpect(hub.Users()).Should(ConsistOf(\"alice\"))","+\t})","+","+\tIt(\"acts as the render's user on a managed cluster\", func() {","+\t\tserverVersion(renderCtx(\"managed\", &user.DefaultInfo{Name: \"alice\"}))","+\t\tExpect(hub.Paths()).Should(ConsistOf(proxyVersion))","+\t\tExpect(hub.Users()).Should(ConsistOf(\"alice\"))","+\t})","+","+\tIt(\"sends a managed cluster's requests through the hub's cluster-gateway proxy\", func() {","+\t\tserverVersion(renderCtx(\"managed\", nil))","+\t\tExpect(hub.Paths()).Should(ConsistOf(proxyVersion))","+\t\tExpect(hub.Users()).Should(ConsistOf(\"\"))","+\t})","+","+\tIt(\"sends a managed cluster's requests straight to cluster-gateway when its URL is set\", func() {","+\t\tgw := &pathRecorder{}","+\t\tgwSrv := httptest.NewServer(gw)","+\t\tdefer gwSrv.Close()","+\t\tpkgmulticluster.DefaultClusterGatewayClientOptions = pkgmulticluster.ClusterGatewayClientOptions{URL: gwSrv.URL}","+","+\t\tserverVersion(renderCtx(\"managed\", nil))","+\t\tExpect(gw.Paths()).Should(ConsistOf(proxyVersion))","+\t\tExpect(hub.Paths()).Should(BeEmpty())","+\t})","+","+\tIt(\"shares a cluster's discovery between its users, and keeps it apart from other clusters'\", func() {","+\t\tdiscoveryOf := func(ctx context.Context) interface{} {","+\t\t\tg, err := p.restClientGetter(ctx)","+\t\t\tExpect(err).ShouldNot(HaveOccurred())","+\t\t\tdc, err := g.ToDiscoveryClient()","+\t\t\tExpect(err).ShouldNot(HaveOccurred())","+\t\t\treturn dc","+\t\t}","+\t\ta := discoveryOf(renderCtx(\"a\", nil))","+\t\tExpect(discoveryOf(renderCtx(\"a\", &user.DefaultInfo{Name: \"alice\"}))).Should(BeIdenticalTo(a))","+\t\tExpect(discoveryOf(renderCtx(\"a\", &user.DefaultInfo{Name: \"bob\", Groups: []string{\"ops\"}}))).Should(BeIdenticalTo(a))","+\t\tExpect(discoveryOf(renderCtx(\"b\", nil))).ShouldNot(BeIdenticalTo(a))","+\t})","+","+\tIt(\"reports the Kubernetes version of the cluster being rendered for\", func() {","+\t\tkv := p.getKubeVersion(renderCtx(\"managed\", nil))","+\t\tExpect(kv).ShouldNot(BeNil())","+\t\tExpect(kv.Version).Should(Equal(\"v1.31.0\"))","+\t\tExpect(hub.Paths()).Should(ConsistOf(proxyVersion))","+\t})","+","+\tIt(\"keys the release cache by cluster\", func() {","+\t\tExpect(releaseCacheKey(\"a\", \"ns\", \"r\")).ShouldNot(Equal(releaseCacheKey(\"b\", \"ns\", \"r\")))","+\t\tExpect(releaseCacheKey(\"\", \"ns\", \"r\")).Should(Equal(releaseCacheKey(pkgmulticluster.Local, \"ns\", \"r\")))","+\t})","+","+\tIt(\"installs into the cluster named by the render context\", func() {","+\t\tvar configClusters, clientClusters []string","+\t\tcfg := fakeActionConfig()","+\t\tcs := clientsetfake.NewSimpleClientset()","+\t\tp.actionConfigFactory = func(ctx context.Context, _ string) (*action.Configuration, error) {","+\t\t\tconfigClusters = append(configClusters, clusterFrom(ctx))","+\t\t\treturn cfg, nil","+\t\t}","+\t\tp.kubeClientFactory = func(ctx context.Context) (kubernetes.Interface, error) {","+\t\t\tclientClusters = append(clientClusters, clusterFrom(ctx))","+\t\t\treturn cs, nil","+\t\t}","+","+\t\tctx := renderCtx(\"managed\", nil)","+\t\t_, _, _, err := p.installOrUpgradeChart(ctx, minimalChart(\"c\", \"1.0.0\"), \"r\", \"ns\", map[string]interface{}{}, nil, nil)","+\t\tExpect(err).ShouldNot(HaveOccurred())","+\t\tBy(\"adopting the release, which labels its Secrets through the Kubernetes client\")","+\t\tvelaCtx := &ContextParams{AppName: \"app\", AppNamespace: \"ns\", Name: \"comp\"}","+\t\t_, _, _, err = p.installOrUpgradeChart(ctx, minimalChart(\"c\", \"1.0.0\"), \"r\", \"ns\", map[string]interface{}{}, nil, velaCtx)","+\t\tExpect(err).ShouldNot(HaveOccurred())","+\t\tExpect(configClusters).ShouldNot(BeEmpty())","+\t\tExpect(configClusters).Should(HaveEach(\"managed\"))","+\t\tExpect(clientClusters).Should(HaveEach(\"managed\"))","+\t\tExpect(p.releaseVersions).Should(HaveKey(releaseCacheKey(\"managed\", \"ns\", \"r\")))","+\t})","+})","+","+var _ = Describe(\"Render targets the component's cluster and user\", func() {","+\tIt(\"installs on the cluster the template names, as the Application's user\", func() {","+\t\tscheme := runtime.NewScheme()","+\t\tExpect(v1beta1.AddToScheme(scheme)).To(Succeed())","+\t\tapp := &v1beta1.Application{ObjectMeta: metav1.ObjectMeta{","+\t\t\tName: \"shop\", Namespace: \"team-a\",","+\t\t\tAnnotations: map[string]string{oam.AnnotationApplicationUsername: \"alice\"},","+\t\t}}","+\t\torigKube := singleton.KubeClient.Get()","+\t\tsingleton.KubeClient.Set(fake.NewClientBuilder().WithScheme(scheme).WithObjects(app).Build())","+\t\tdefer singleton.KubeClient.Set(origKube)","+","+\t\tp := NewProvider()","+\t\tsaveConfig, saveClient := p.actionConfigFactory, p.kubeClientFactory","+\t\tdefer func() { p.actionConfigFactory, p.kubeClientFactory = saveConfig, saveClient }()","+\t\tvar clusters, users []string","+\t\trecord := func(ctx context.Context) {","+\t\t\tclusters = append(clusters, clusterFrom(ctx))","+\t\t\tu, _ := request.UserFrom(ctx)","+\t\t\tExpect(u).ShouldNot(BeNil())","+\t\t\tusers = append(users, u.GetName())","+\t\t}","+\t\tcfg := fakeActionConfig()","+\t\tcs := clientsetfake.NewSimpleClientset()","+\t\tp.actionConfigFactory = func(ctx context.Context, _ string) (*action.Configuration, error) {","+\t\t\trecord(ctx)","+\t\t\treturn cfg, nil","+\t\t}","+\t\tp.kubeClientFactory = func(ctx context.Context) (kubernetes.Interface, error) {","+\t\t\trecord(ctx)","+\t\t\treturn cs, nil","+\t\t}","+\t\tp.cache.Put(\"repo/\"+sourceCacheID(\"render-target\")+\"/1.0.0\", createChartArchive(&chart.Chart{","+\t\t\tMetadata: &chart.Metadata{Name: \"render-target\", Version: \"1.0.0\"},","+\t\t\tTemplates: []*chart.File{{","+\t\t\t\tName: \"templates/cm.yaml\",","+\t\t\t\tData: []byte(\"apiVersion: v1\\nkind: ConfigMap\\nmetadata:\\n  name: {{ .Release.Name }}-cm\\n\"),","+\t\t\t}},","+\t\t}), time.Hour)","+","+\t\t_, err := Render(context.Background(), &providers.Params[RenderParams]{Params: RenderParams{","+\t\t\tChart:   ChartSourceParams{Source: \"render-target\", Version: \"1.0.0\"},","+\t\t\tRelease: &ReleaseParams{Name: \"rel\", Namespace: \"team-a\"},","+\t\t\tContext: &ContextParams{AppName: \"shop\", AppNamespace: \"team-a\", Name: \"web\", Namespace: \"team-a\", Cluster: \"eu-west\"},","+\t\t}})","+\t\tExpect(err).ShouldNot(HaveOccurred())","+\t\tExpect(clusters).ShouldNot(BeEmpty())","+\t\tExpect(clusters).Should(HaveEach(\"eu-west\"))","+\t\tExpect(users).Should(HaveEach(\"alice\"))","+\t})","+})","+","+var _ = Describe(\"Helm action configs\", func() {","+\tIt(\"place objects that name no namespace, hooks included, in the release namespace\", func() {","+\t\tp := NewProviderWithConfig(nil)","+\t\tdefer p.Close()","+\t\tp.hubConfig = func() (*rest.Config, error) { return &rest.Config{Host: \"https://127.0.0.1:1\"}, nil }","+\t\tfor _, ctx := range []context.Context{context.Background(), renderCtx(\"managed\", nil)} {","+\t\t\tgetter, err := p.restClientGetter(ctx)","+\t\t\tExpect(err).ShouldNot(HaveOccurred())","+\t\t\tns, explicit, err := inReleaseNamespace(getter, \"team-a\").ToRawKubeConfigLoader().Namespace()","+\t\t\tExpect(err).ShouldNot(HaveOccurred())","+\t\t\tExpect(explicit).Should(BeTrue())","+\