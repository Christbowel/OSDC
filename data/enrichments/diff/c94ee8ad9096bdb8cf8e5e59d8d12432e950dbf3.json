t2.getRow(0).getCell(0).removeHyperlink();","+                sheet2.createRow(1).createCell(0).setHyperlink(loaded);","+","+                try (XSSFWorkbook wb3 = XSSFTestDataSamples.writeOutAndReadBack(wb2)) {","+                    XSSFSheet sheet3 = wb3.getSheetAt(0);","+                    assertNull(sheet3.getHyperlink(0, 0));","+                    assertEquals(\"https://example.com/page#section\", sheet3.getHyperlink(1, 0).getAddress());","+                    assertEquals(1, hyperlinkTargets(sheet3).size());","+                }","+            }","+        }","+    }","+","+    @Test","+    void testMoveLoadedHyperlinkToAnotherSheet() throws IOException, InvalidFormatException {","+        try (XSSFWorkbook wb = new XSSFWorkbook()) {","+            XSSFSheet sheet = wb.createSheet(\"first\");","+            wb.createSheet(\"second\");","+            XSSFHyperlink link = wb.getCreationHelper().createHyperlink(HyperlinkType.URL);","+            link.setAddress(\"https://example.com/moved\");","+            link.setLocation(\"section\");","+            sheet.createRow(0).createCell(0).setHyperlink(link);","+","+            try (XSSFWorkbook wb2 = XSSFTestDataSamples.writeOutAndReadBack(wb)) {","+                XSSFSheet first = wb2.getSheet(\"first\");","+                XSSFSheet second = wb2.getSheet(\"second\");","+                XSSFHyperlink loaded = first.getHyperlink(0, 0);","+                first.getRow(0).getCell(0).removeHyperlink();","+                second.createRow(2).createCell(1).setHyperlink(loaded);","+","+                try (XSSFWorkbook wb3 = XSSFTestDataSamples.writeOutAndReadBack(wb2)) {","+                    assertNull(wb3.getSheet(\"first\").getHyperlink(0, 0));","+                    assertTrue(hyperlinkTargets(wb3.getSheet(\"first\")).isEmpty());","+                    // the second sheet has a relationship of its own for the moved hyperlink","+                    XSSFSheet second3 = wb3.getSheet(\"second\");","+                    assertEquals(\"https://example.com/moved#section\", second3.getHyperlink(2, 1).getAddress());","+                    assertEquals(List.of(\"https://example.com/moved\"), hyperlinkTargets(second3));","+                }","+            }","+        }","+    }","+","+    @Test","+    void testSetAddressOfRemovedHyperlink() throws IOException, InvalidFormatException {","+        try (XSSFWorkbook wb = new XSSFWorkbook()) {","+            XSSFSheet sheet = wb.createSheet();","+            XSSFHyperlink link = wb.getCreationHelper().createHyperlink(HyperlinkType.URL);","+            link.setAddress(\"https://example.com/old\");","+            sheet.createRow(0).createCell(0).setHyperlink(link);","+","+            try (XSSFWorkbook wb2 = XSSFTestDataSamples.writeOutAndReadBack(wb)) {","+                XSSFSheet sheet2 = wb2.getSheetAt(0);","+                XSSFHyperlink loaded = sheet2.getHyperlink(0, 0);","+                sheet2.removeHyperlink(loaded);","+                loaded.setAddress(\"https://example.org/new\");","+","+                // the removed hyperlink doesn't add a relationship to the sheet it was removed from","+                assertTrue(hyperlinkTargets(sheet2).isEmpty());","+","+                // and gets one for its new address once it is added again","+                sheet2.getRow(0).getCell(0).setHyperlink(loaded);","+                try (XSSFWorkbook wb3 = XSSFTestDataSamples.writeOutAndReadBack(wb2)) {","+                    XSSFSheet sheet3 = wb3.getSheetAt(0);","+                    assertEquals(\"https://example.org/new\", sheet3.getHyperlink(0, 0).getAddress());","+                    assertEquals(List.of(\"https://example.org/new\"), hyperlinkTargets(sheet3));","+                }","+            }","+        }","+    }","+","+    @Test","+    void testCloneSheetWithLoadedHyperlinkKeepsWorkbookRelationships() throws IOException, InvalidFormatException {","+        try (XSSFWorkbook wb = new XSSFWorkbook()) {","+            XSSFSheet sheet = wb.createSheet(\"src\");","+            XSSFHyperlink link = wb.getCreationHelper().createHyperlink(HyperlinkType.URL);","+            link.setAddress(\"https://example.com/cloned\");","+            sheet.createRow(0).createCell(0).setHyperlink(link);","+","+            try (XSSFWorkbook wb2 = XSSFTestDataSamples.writeOutAndReadBack(wb)) {","+                String linkRelId = wb2.getSheetAt(0).getHyperlink(0, 0).getCTHyperlink().getId();","+                // the premise of the test: both parts number their relationships from rId1, so the","+                // sheet's hyperlink relationship has the id of one of the workbook's. This fails","+                // rather than passing vacuously if that ever changes.","+                assertNotNull(wb2.getPackagePart().getRelationship(linkRelId));","+                Map<String, String> typesBefore = relationshipTypes(wb2);","+","+                wb2.cloneSheet(0, \"clone\");","+","+                // the hyperlink relationships of the source sheet don't replace any of the workbook's,","+                // cloning only adds the relationship of the new sheet","+                Map<String, String> typesAfter = relationshipTypes(wb2);","+                for (Map.Entry<String, String> before : typesBefore.entrySet()) {","+                    assertEquals(before.getValue(), typesAfter.get(before.getKey()), before.getKey());","+                }","+                assertEquals(typesBefore.size() + 1, typesAfter.size());","+                assertEquals(List.of(\"https://example.com/cloned\"), hyperlinkTargets(wb2.getSheet(\"clone\")));","+","+                try (XSSFWorkbook wb3 = XSSFTestDataSamples.writeOutAndReadBack(wb2)) {","+                    assertEquals(\"src\", wb3.getSheetName(0));","+                    assertEquals(\"clone\", wb3.getSheetName(1));","+                    assertEquals(\"https://example.com/cloned\", wb3.getSheet(\"src\").getHyperlink(0, 0).getAddress());","+                    assertEquals(\"h