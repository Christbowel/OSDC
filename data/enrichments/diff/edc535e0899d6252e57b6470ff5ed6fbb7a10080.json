expect(Storage::disk('local')->exists($media->thumbnail_path))->toBeFalse();"," ","-    // The row must stay re-selectable (not marked replicated).","+    // The row is marked replicated once the cloud copy is authoritative.","     $media->refresh();","-    expect($media->cdn_url)->toBeNull();","-    expect($media->replicated_at)->toBeNull();","-    expect((string) $media->version)->toBe('3');","+    expect($media->cdn_url)->not->toBeNull();","+    expect($media->replicated_at)->not->toBeNull();","+    expect((string) $media->version)->toBe('4');"," });"],"additions":19,"deletions":21,"truncated":false},{"path":"tests/Feature/Media/ResilientStorageFirstAttemptTest.php","lines":["@@ -0,0 +1,60 @@","+<?php","+","+use App\\Services\\ResilientMediaStorageService;","+use Illuminate\\Foundation\\Testing\\LazilyRefreshDatabase;","+use Illuminate\\Support\\Facades\\Config;","+use Illuminate\\Support\\Facades\\Storage;","+","+uses(LazilyRefreshDatabase::class);","+","+/*","+|--------------------------------------------------------------------------","+| Resilient store first-attempt disk routing","+|--------------------------------------------------------------------------","+|","+| The first attempt of every store must target the configured cloud disk.","+| Alternate disks are only a retry fallback. Two back-to-back stores must","+| both land on the configured cloud disk, never on an alternate.","+|","+*/","+","+beforeEach(function () {","+    Config::set('filesystems.cloud', 's3');","+    Config::set('pixelfed.cloud_storage', true);","+    Config::set('media.storage.remote.resilient_mode', true);","+    Config::set('filesystems.disks.alt-primary.enabled', true);","+    Config::set('filesystems.disks.alt-secondary.enabled', true);","+","+    Storage::fake('local');","+    Storage::fake('s3', ['url' => 'https://cdn.test']);","+    Storage::fake('alt-primary', ['url' => 'https://alt.test']);","+    Storage::fake('alt-secondary', ['url' => 'https://alt2.test']);","+});","+","+function makeLocalSourceForResilientFirstAttempt(string $name, string $contents): string","+{","+    $dir = sys_get_temp_dir().'/pf-resilient-first-'.uniqid();","+    mkdir($dir);","+    $file = $dir.'/'.$name;","+    file_put_contents($file, $contents);","+","+    return $file;","+}","+","+it('routes both successive first attempts to the configured cloud disk', function () {","+    $storagePath = 'public/m/_v2/1/aa/bb';","+","+    $firstSource = makeLocalSourceForResilientFirstAttempt('one.jpg', 'FIRST-BYTES-0001');","+    $secondSource = makeLocalSourceForResilientFirstAttempt('two.jpg', 'SECOND-BYTES-0002');","+","+    ResilientMediaStorageService::store($storagePath, $firstSource, 'one.jpg');","+    ResilientMediaStorageService::store($storagePath, $secondSource, 'two.jpg');","+","+    expect(Storage::disk('s3')->exists($storagePath.'/one.jpg'))->toBeTrue();","+    expect(Storage::disk('s3')->exists($storagePath.'/two.jpg'))->toBeTrue();","+","+    expect(Storage::disk('alt-primary')->exists($storagePath.'/one.jpg'))->toBeFalse();","+    expect(Storage::disk('alt-primary')->exists($storagePath.'/two.jpg'))->toBeFalse();","+    expect(Storage::disk('alt-secondary')->exists($storagePath.'/one.jpg'))->toBeFalse();","+    expect(Storage::disk('alt-secondary')->exists($storagePath.'/two.jpg'))->toBeFalse();","+});",""],"additions":60,"deletions":0,"truncated":false}],"additions":83,"deletions":35,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-10-20T14:26:05.765779+00:00"}