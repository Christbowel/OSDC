{"id":"0e8064a0ed67f5b991e954f413ee61188a59373f","axis":"silent","repo":"symfony/symfony","sha":"0e8064a0ed67f5b991e954f413ee61188a59373f","parsed":{"files":[{"path":"src/Symfony/Bundle/SecurityBundle/CHANGELOG.md","lines":["@@ -4,6 +4,7 @@ CHANGELOG"," 8.2"," ---"," ","+ * Default the `audience` of the `oidc` and `oauth2` token handlers to the `resource` of `resource_metadata` when it is a URL; with `oauth2`, `aud` then becomes a mandatory claim of the introspection response","  * Add the `entry_point_path` firewall option, redirecting anonymous users to a path or a route when they need to authenticate","  * Retain the referer after failed authentication when `use_referer` is enabled","  * Default the `cost`, `time_cost` and `memory_cost` options of password hashers to the lowest values bcrypt and argon2 accept when `framework.test` is enabled"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Symfony/Bundle/SecurityBundle/DependencyInjection/Security/AccessToken/OAuth2TokenHandlerFactory.php","lines":["@@ -108,7 +108,7 @@ public function addConfiguration(NodeBuilder $node): void","                     ->then(static fn ($v) => ['http_client' => $v])","                 ->end()","                 ->validate()","-                    ->ifTrue(static fn ($v) => $v['response_signature']['enabled'] && (null === $v['issuer'] || !$v['audience']))","+                    ->ifTrue(static fn ($v) => $v['response_signature']['enabled'] && null === $v['issuer'])","                     ->thenInvalid('The \"issuer\" and \"audience\" options of the \"oauth2\" token handler are required when \"response_signature\" is enabled: RFC 9701 §5 makes \"iss\" and \"aud\" mandatory claims of the response.')","                 ->end()","                 ->children()","@@ -117,7 +117,7 @@ public function addConfiguration(NodeBuilder $node): void","                         ->cannotBeEmpty()","                     ->end()","                     ->arrayNode('audience')","-              