{"id":"0316dc1eefa21ea77f48ae88960844635b020e40","axis":"silent","repo":"payloadcms/payload","sha":"0316dc1eefa21ea77f48ae88960844635b020e40","parsed":{"files":[{"path":"docs/rich-text/custom-features.mdx","lines":["@@ -770,6 +770,56 @@ export const MyClientFeature = createClientFeature({"," | **`onSelect`** | A function which is called when the slash menu item is selected.                                                                                                                                                                                                                  |"," | **`keywords`** | Keywords are used to match the item for different texts typed after the '/'. E.g. you might want to show a horizontal rule item if you type both /hr, /separator, /horizontal etc. In addition to the keywords, the label and key will be used to find the right slash menu item. |"," ","+### Dynamic Slash Menu groups","+","+Static items only appear when the text typed after the `/` matches their label, key or keywords. If an item depends on the typed text itself, use `dynamicGroups` instead. This example offers a \"3x4 Grid\" item when you type `/3x4`:","+","+```ts","+'use client'","+","+import { createClientFeature } from '@payloadcms/richtext-lexical/client'","+import { INSERT_GRID_COMMAND } from './plugin'","+import { GridIcon } from './icon'","+","+export const GridClientFeature = createClientFeature({","+  slashMenu: {","+    dynamicGroups: ({ queryString }) => {","+      const match = queryString.match(/^(\\d+)x(\\d+)$/)","+      if (!match) {","+        return []","+      }","+","+      const [, rows, columns] = match","+","+      return [","+        {","+          items: [","+            {","+              Icon: GridIcon,","+              key: `grid-${rows}x${columns}`,","+              label: `${rows}x${columns} Grid`,","+              onSelect: ({ editor }) => {","+                editor.dispatchCommand(INSERT_GRID_COMMAND, {","+                  columns: Number(columns),","+                  rows: Number(rows),","+                })","+              },","+            },","+          ],","+          key: 'grid',","+          label: 'Grid',","+        },","+      ]","+    },","+  },","+})","+```","+","+- The function runs when the slash menu opens and again on every keystroke. It receives the text typed after the `/` (an empty string for a bare `/`) and the `editor`, which you can use to read the current selection.","+- The items it returns are not filtered by the typed text. Your function decides which items to return.","+- Items from a group whose `key` matches an existing group are added to that group. Other groups are added after the static ones. Groups without items are hidden.","+- The function must be synchronous, and every item `key` must be unique. If it throws, the error is logged to the console and its groups are skipped.","+"," ### Markdown Transformers#client-feature-markdown-transformers"," "," The Client Feature, just like the Server Feature, allows you to add markdown transformers. Markdown transformers on the client are used to create new nodes when a certain markdown pattern is typed in the editor."],"additions":50,"deletions":0,"truncated":false},{"path":"packages/richtext-lexical/src/lexical/config/client/sanitize.spec.ts","lines":["@@ -0,0 +1,65 @@","+import { describe, expect, it } from 'vitest'","+","+import type {","+  ClientFeature,","+  ResolvedClientFeature,","+  ResolvedClientFeatureMap,","+} from '../../../features/typesClient.js'","+","+import { sanitizeClientFeatures } from './sanitize.js'","+","+const createFeatureMap = ({","+  features,","+}: {","+  features: Array<{ key: string } & ClientFeature<undefined>>","+}): ResolvedClientFeatureMap => {","+  const featureMap: ResolvedClientFeatureMap = new Map()","+","+  features.forEach((feature, order) => {","+    featureMap.set(feature.key, { ...feature, order } as ResolvedClientFeature<undefined>)","+  })","+","+  return featureMap","+}","+","+describe('sanitizeClientFeatures', () => {","+  it('should register slashMenu.dynamicGroups when the feature has no static groups', () => {","+    const dynamicGroups = ({ queryString }: { queryString: string }) => [","+      { items: [], key: queryString },","+    ]","+","+    const sanitized = sanitizeClientFeatures(","+      createFeatureMap({ features: [{ key: 'dynamicOnly', slashMenu: { dynamicGroups } }] }),","+    )","+","+    expect(sanitized.slashMenu.dynamicGroups).toEqual([dynamicGroups])","+  })","+","+  it('should register slashMenu.dynamicGroups when the function declares no parameters', () => {","+    const dynamicGroups = () => []","+","+    const sanitized = sanitizeClientFeatures(","+      createFeatureMap({","+        features: [{ key: 'noParams', slashMenu: { dynamicGroups, groups: [] } }],","+      }),","+    )","+","+    expect(sanitized.slashMenu.dynamicGroups).toEqual([dynamicGroups])","+  })","+","+  it('should register slashMenu.dynamicGroups from every feature in order', () => {","+    const dynamicGroupsA = () => []","+    const dynamicGroupsB = () => []","+","+    const sanitized = sanitizeClientFeatures(","+      createFeatureMap({","+        features: [","+          { key: 'a', slashMenu: { dynamicGroups: dynamicGroupsA } },","+          { key: 'b', slashMenu: { dynamicGroups: dynamicGroupsB } },","+        ],","+      }),","+    )","+","+    expect(sanitized.slashMenu.dynamicGroups).toEqual([dynamicGroupsA, dynamicGroupsB])","+  })","+})"],"additions":65,"deletions":0,"truncated":false},{"path":"packages/richtext-lexical/src/lexical/config/client/sanitize.ts","lines":["@@ -125,13 +125,11 @@ export const sanitizeClientFeatures = (","       }","     }"," ","-    if (feature.slashMenu?.groups) {","-      if (feature.slashMenu.dynamicGroups?.length) {","-        sanitized.slashMenu.dynamicGroups = sanitized.slashMenu.dynamicGroups.concat(","-          feature.slashMenu.dynamicGroups,","-        )","-      }","+    if (feature.slashMenu?.dynamicGroups) {","+      sanitized.slashMenu.dynamicGroups.push(feature.slashMenu.dynamicGroups)","+    }"," ","+    if (feature.slashMenu?.groups) {","       for (const optionGroup of feature.slashMenu.groups) {","         // 1. find the group with the same name or create new one","         let group = sanitized.slashMenu.groups.find((group) => group.key === optionGroup.key)"],"additions":4,"deletions":6,"truncated":false},{"path":"packages/richtext-lexical/src/lexical/plugins/SlashMenu/index.tsx","lines":["@@ -1,7 +1,7 @@"," 'use client'"," import { useLexicalComposerContext } from '@lexical/react/LexicalComposerContext.js'"," import { useTranslation } from '@payloadcms/ui'","-import { useCallback, useMemo, useState } from 'react'","+import { useMemo, useState } from 'react'"," import * as React from 'react'"," import * as ReactDOM from 'react-dom'"," ","@@ -15,6 +15,7 @@ import type {"," import { useEditorConfigContext } from '../../config/client/EditorConfigProvider.js'"," import './index.css'"," import { LexicalTypeaheadMenuPlugin } from './LexicalTypeaheadMenuPlugin/index.js'","+import { resolveSlashMenuGroups } from './mergeDynamicGroups.js'"," import { useMenuTriggerMatch } from './useMenuTriggerMatch.js'"," "," const baseClass = 'slash-menu-popup'","@@ -93,105 +94,55 @@ export function SlashMenuPlugin({","     minLength: 0,","   })"," ","-  const getDynamicItems = useCallback(() => {","-    let groupWithItems: Array<SlashMenuGroup> = []","-","-    for (const dynamicItem of editorConfig.features.slashMenu.dynamicGroups) {","-      if (queryString) {","-        const dynamicGroupWithItems = dynamicItem({","-          editor,","-          queryString,","-        })","-        groupWithItems = groupWithItems.concat(dynamicGroupWithItems)","-      }","-    }","-","-    return groupWithItems","-  }, [editor, queryString, editorConfig?.features])","-","   const groups: SlashMenuGroup[] = useMemo(() => {","-    let groupsWithItems: SlashMenuGroup[] = []","-    for (con