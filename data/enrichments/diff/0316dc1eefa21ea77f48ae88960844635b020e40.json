     if (new RegExp(queryString, 'gi').exec(itemTitle)) {","+              return true","+            }","+","+            // Try normalized match (allows \"nestedcontent\" to match \"Nested Content\")","+            const normalizedTitle = itemTitle.toLowerCase().replace(/[\\s\\-_]/g, '')","+            if (normalizedTitle.includes(normalizedQuery)) {","+              return true","+            }","+","+            if (item.keywords != null) {","+              return item.keywords.some((keyword) => {","+                if (new RegExp(queryString, 'gi').exec(keyword)) {","+                  return true","+                }","+                const normalizedKeyword = keyword.toLowerCase().replace(/[\\s\\-_]/g, '')","+                return normalizedKeyword.includes(normalizedQuery)","+              })","+            }","+            return false","           }","-","-          if (item.keywords != null) {","-            return item.keywords.some((keyword) => {","-              if (new RegExp(queryString, 'gi').exec(keyword)) {","-                return true","-              }","-              const normalizedKeyword = keyword.toLowerCase().replace(/[\\s\\-_]/g, '')","-              return normalizedKeyword.includes(normalizedQuery)","-            })","-          }","-          return false","-        })","-        if (filteredItems.length) {","-          return {","-            ...group,","-            items: filteredItems,","-          }","-        }","-        return null","-      })","-","-      groupsWithItems = groupsWithItems.filter((group) => group != null)","-","-      // Now add dynamic groups","-      const dynamicItemGroups = getDynamicItems()","-","-      // merge dynamic items into groups","-      for (const dynamicGroup of dynamicItemGroups) {","-        // 1. find the group with the same name or create new one","-        let group = groupsWithItems.find((group) => group.key === dynamicGroup.key)","-        if (!group) {","-          group = {","-            ...dynamicGroup,","-            items: [],","-          }","-        } else {","-          groupsWithItems = groupsWithItems.filter((group) => group.key !== dynamicGroup.key)","-        }","-","-        // 2. Add items to group items array and add to sanitized.slashMenu.groupsWithItems","-        if (group?.items?.length) {","-          group.items = group.items.concat(group.items)","-        }","-        groupsWithItems.push(group)","-      }","-    }","-","-    return groupsWithItems","+        : undefined,","+      groups: groupsWithItems,","+      queryString,","+    })","   }, [","+    editor,","     queryString,","+    editorConfig?.features.slashMenu.dynamicGroups,","     editorConfig?.features.slashMenu.groups,","-    getDynamicItems,","     featureClientSchemaMap,","     i18n,","     schemaPath,"],"additions":46,"deletions":95,"truncated":false},{"path":"packages/richtext-lexical/src/lexical/plugins/SlashMenu/mergeDynamicGroups.spec.ts","lines":["@@ -0,0 +1,233 @@","+import type { LexicalEditor } from 'lexical'","+","+import { describe, expect, it, vi } from 'vitest'","+","+import type { SlashMenuGroup, SlashMenuItem } from './LexicalTypeaheadMenuPlugin/types.js'","+","+import {","+  applyDynamicGroups,","+  mergeDynamicGroups,","+  resolveSlashMenuGroups,","+} from './mergeDynamicGroups.js'","+","+const editor = {} as LexicalEditor","+","+const createItem = ({ key }: { key: string }): SlashMenuItem => ({","+  Icon: () => null,","+  key,","+  onSelect: ({","+    editor: _editor,","+    queryString: _queryString,","+  }: {","+    editor: LexicalEditor","+    queryString: string","+  }) => {","+    return","+  },","+})","+","+const createGroup = ({","+  items,","+  key,","+  label,","+}: {","+  items: SlashMenuItem[]","+  key: string","+  label?: string","+}): SlashMenuGroup => ({","+  items,","+  key,","+  ...(label !== undefined ? { label } : {}),","+})","+","+describe('applyDynamicGroups', () => {","+  it(\"should call each dynamicGroups callback with queryString '' and include its items for a bare slash\", () => {","+    const staticItem = createItem({ key: 'paragraph' })","+    const dynamicItemA = createItem({ key: 'dynamic-a' })","+    const dynamicItemB = createItem({ key: 'dynamic-b' })","+    const groups = [createGroup({ items: [staticItem], key: 'basic' })]","+    const dynamicGroupFnA = vi.fn(() => [createGroup({ items: [dynamicItemA], key: 'basic' })])","+    const dynamicGroupFnB = vi.fn(() => [createGroup({ items: [dynamicItemB], key: 'custom' })])","+","+    const result = applyDynamicGroups({","+      dynamicGroupFns: [dynamicGroupFnA, dynamicGroupFnB],","+      editor,","+      groups,","+      queryString: '',","+    })","+","+    expect(dynamicGroupFnA).toHaveBeenCalledTimes(1)","+    expect(dynamicGroupFnA).toHaveBeenCalledWith({ editor, queryString: '' })","+    expect(dynamicGroupFnB).toHaveBeenCalledTimes(1)","+    expect(dynamicGroupFnB).toHaveBeenCalledWith({ editor, queryString: '' })","+    expect(result.map((group) => group.key)).toEqual(['basic', 'custom'])","+    expect(result[0]!.items.map((item) => item.key)).toEqual(['paragraph', 'dynamic-a'])","+    expect(result[1]!.items.map((item) => item.key)).toEqual(['dynamic-b'])","+  })","+","+  it('should not call dynamicGroups callbacks when queryString is null', () => {","+    const groups = [createGroup({ items: [createItem({ key: 'paragraph' })], key: 'basic' })]","+    const dynamicGroupFn = vi.fn(() => [","+      createGroup({ items: [createItem({ key: 'dynamic' })], key: 'custom' }),","+    ])","+","+    const result = applyDynamicGroups({","+      dynamicGroupFns: [dynamicGroupFn],","+      editor,","+      groups,","+      queryString: null,","+    })","+","+    expect(dynamicGroupFn).not.toHaveBeenCalled()","+    expect(result).toBe(groups)","+    expect(result.map((group) => group.key)).toEqual(['basic'])","+  })","+","+  it('should skip a dynamicGroups callback that throws and keep the other groups', () => {","+    const consoleErrorSpy = vi.spyOn(console, 'error').mockImplementation(() => {})","+    const groups = [createGroup({ items: [createItem({ key: 'paragraph' })], key: 'basic' })]","+    const throwingFn = vi.fn((): SlashMenuGroup[] => {","+      throw new Error('boom')","+    })","+    const workingFn = vi.fn(() => [","+      createGroup({ items: [createItem({ key: 'dynamic' })], key: 'custom' }),","+    ])","+","+    const result = applyDynamicGroups({","+      dynamicGroupFns: [throwingFn, workingFn],","+      editor,","+      groups,","+      queryString: 'x',","+    })","+","+    expect(result.map((group) => group.key)).toEqual(['basic', 'custom'])","+    expect(consoleErrorSpy).toHaveBeenCalledTimes(1)","+","+    consoleErrorSpy.mockRestore()","+  })","+})","+","+describe('resolveSlashMenuGroups', () => {","+  it('should keep configured group position and label when query filters out all static items and dynamic groups refill that key', () => {","+    const groups = [","+      createGroup({","+        items: [createItem({ key: 'paragraph' })],","+        key: 'basic',","+        label: 'Basic',","+      }),","+      createGroup({","+        items: [createItem({ key: 'upload' })],","+        key: 'media',","+        label: 'Media',","+      }),","+      createGroup({","+        items: [createItem({ key: 'code' })],","+        key: 'advanced',","+        label: 'Advanced',","+      }),","+    ]","+    const dynamicItem = createItem({ key: 'custom-paragraph' })","+    const dynamicGroupFn = vi.fn(() => [","+      createGroup({","+        items: [dynamicItem],","+        key: 'basic',","+        label: 'Dynamic Basic',","+      }),","+    ])","+","+    const result = resolveSlashMenuGroups({","+      dynamicGroupFns: [dynamicGroupFn],","+      editor,","+      filterItem: (item) => item.key.includes('upload'),","+      groups,","+      queryString: 'up',","+    })","+","+    expect(result.map((group) => group.key)).toEqual(['basic', 'media'])","+    expect(result[0]!.label).toBe('Basic')","+    expect(result[0]!.items.map((item) => item.key)).toEqual(['custom-paragraph'])","+    expect(result[1]!.items.map((item) => item.key)).toEqual(['upload'])","+    expect(dynamicGroupFn).toHaveBeenCalledWith({ editor, queryString: 'up' })","+  })","+","+  it('should drop a dynamic group without items for a bare slash', () => {","+    const groups = [createGroup({ items: [createItem({ key: 'paragraph' })], key: 'basic' })]","+","+    const result = resolveSlashMenuGroups({","+      dynamicGroupFns: [() => [createGroup({ items: [], key: 'custom' })]],","+      editor,","+      groups,","+      queryString: '',","+    })","+","+    expect(result.map((group) => group.key)).toEqual(['basic'])","+  })","+})","+","+describe('mergeDynamicGroups', () => {","+  it('should concatenate static and dynamic items for an existing group key without self-duplication', () => {","+    const staticItem = createItem({ key: 'paragraph' })","+    const dynamicItem = createItem({ key: 'custom-block' })","+    const groups = [createGroup({ items: [staticItem], key: 'basic' })]","+    const dynamicGroups = [createGroup({ items: [dynamicItem], key: 'basic' })]","+","+    const result = mergeDynamicGroups({ dynamicGroups, groups })","+","+    expect(result).toHaveLength(1)","+    expect(result[0]!.key).toBe('basic')","+    expect(result[0]!.items.map((item) => item.key)).toEqual(['paragraph', 'custom-block'])","+  })","+","+  it('should keep a matched group in its original position', () => {","+    const groups = [","+      createGroup({ items: [createItem({ key: 'a' })], key: 'first' }),","+      createGroup({ items: [createItem({ key: 'b' })], key: 'second' }),","+      createGroup({ items: [createItem({ key: 'c' })], key: 'third' }),","+    ]","+    const dynamicGroups = [createGroup({ items: [createItem({ key: 'b2' })], key: 'second' })]","+","+    const result = mergeDynamicGroups({ dynamicGroups, groups })","+","+    expect(result.map((group) => group.key)).toEqual(['first', 'second', 'third'])","+    expect(result[1]!.items.map((item) => item.key)).toEqual(['b', 'b2'])","+  })","+","+  it('should append a new group with its dynamic items', () => {","+    const groups = [createGroup({ items: [createItem({ key: 'paragraph' })], key: 'basic' })]","+    const dynamicItem = createItem({ key: 'dynamic-only' })","+    const dynamicGroups = [createGroup({ items: [dynamicItem], key: 'custom' })]","+","+    const result = mergeDynamicGroups({ dynamicGroups, groups })","+","+    expect(result.map((group) => group.key)).toEqual(['basic', 'custom'])","+    expect(result[1]!.items.map((item) => item.key)).toEqual(['dynamic-only'])","+  })","+","+  it('should not mutate the input groups or dynamic groups', () => {","+    const staticItem = createItem({ key: 'paragraph' })","+    const dynamicItem = createItem({ key: 'custom-block' })","+    const groups = [createGroup({ items: [staticItem], key: 'basic' })]","+    const dynamicGroups = [createGroup({ items: [dynamicItem], key: 'basic' })]","+    const groupsSnapshot = structuredClone({","+      items: groups[0]!.items.map((item) => item.key),","+      key: groups[0]!.key,","+    })","+    const dynamicSnapshot = structuredClone({","+      items: dynamicGroups[0]!.items.map((item) => item.key),","+      key: dynamicGroups[0]!.key,","+    })","+    const groupsRef = groups[0]!","+    const dynamicRef = dynamicGroups[0]!","+    const staticItemsRef = groupsRef.items","+    const dynamicItemsRef = dynamicRef.items","+","+    mergeDynamicGroups({ dynamicGroups, groups })","+","+    expect(groups[0]).toBe(groupsRef)","+    expect(dynamicGroups[0]).toBe(dynamicRef)","+    expect(groupsRef.items).toBe(staticItemsRef)","+    expect(dynamicRef.items).toBe(dynamicItemsRef)","+    expect(groupsRef.items.map((item) => item.key)).toEqual(groupsSnapshot.items)","+    expect(dynamicRef.items.map((item) => item.key)).toEqual(dynamicSnapshot.items)","+  })","+})"],"additions":233,"deletions":0,"truncated":false},{"path":"packages/richtext-lexical/src/lexical/plugins/SlashMenu/mergeDynamicGroups.ts","lines":["@@ -0,0 +1,129 @@","+import type { LexicalEditor } from 'lexical'","+","+import type { SlashMenuGroup, SlashMenuItem } from './LexicalTypeaheadMenuPlugin/types.js'","+","+type DynamicGroupFn = (args: { editor: LexicalEditor; queryString: string }) => SlashMenuGroup[]","+","+/**","+ * Filters configured slash-menu groups by `filterItem`, merges `dynamicGroups`","+ * results, then drops groups that ended up without items.","+ * Keeps configured group order and labels through the merge so a dynamic group","+ * with a matching key can refill a group whose static items were all filtered out.","+ * When `queryString` is `null` (menu closed), dynamic groups are not resolved.","+ * An empty string (bare `/`) skips item filtering.","+ */","+export function resolveSlashMenuGroups({","+  dynamicGroupFns,","+  editor,","+  filterItem,","+  groups,","+  queryString,","+}: {","+  dynamicGroupFns: DynamicGroupFn[]","+  editor: LexicalEditor","+  filterItem?: (item: SlashMenuItem) => boolean","+  groups: SlashMenuGroup[]","+  queryString: null | string","+}): SlashMenuGroup[] {","+  let groupsWithItems = groups","+","+  if (queryString && filterItem) {","+    // Keep empty groups so mergeDynamicGroups can refill matching keys in place","+    groupsWithItems = groups.map((group) => ({","+      ...group,","+      items: group.items.filter(filterItem),","+    }))","+  }","+","+  const mergedGroups = applyDynamicGroups({","+    dynamicGroupFns,","+    editor,","+    groups: groupsWithItems,","+    queryString,","+  })","+","+  return mergedGroups.filter((group) => group.items.length > 0)","+}","+","+/**","+ * Invokes slash-menu `dynamicGroups` callbacks when the menu is open and merges","+ * their results into `groups`. When `queryString` is `null` (menu closed),","+ * returns `groups` unchanged without calling any callbacks. An empty string","+ * (bare `/`) still invokes each callback with `queryString: ''`. A callback that","+ * throws is logged and skipped so the other groups still render.","+ */","+export function applyDynamicGroups({","+  dynamicGroupFns,","+  editor,","+  groups,","+  queryString,","+}: {","+  dynamicGroupFns: DynamicGroupFn[]","+  editor: LexicalEditor","+  groups: SlashMenuGroup[]","+  queryString: null | string","+}): SlashMenuGroup[] {","+  // queryString is '' for a bare '/', and null when the menu is closed","+  if (queryString == null) {","+    return groups","+  }","+","+  let dynamicGroups: SlashMenuGroup[] = []","+","+  for (const dynamicGroupFn of dynamicGroupFns) {","+    try {","+      dynamicGroups = dynamicGroups.concat(","+        dynamicGroupFn({","+          editor,","+          queryString,","+        }),","+      )","+    } catch (error) {","+      console.error('A slash menu dynamicGroups function threw an error and was skipped.', error)","+    }","+  }","+","+  return mergeDynamicGroups({","+    dynamicGroups,","+    groups,","+  })","+}","+","+/**","+ * Merges slash-menu dynamic groups into the current groups list.","+ * Does not mutate the input arrays or group/item objects.","+ * Existing groups keep their position; new groups are appended.","+ */","+export function mergeDynamicGroups({","+  dynamicGroups,","+  groups,","+}: {","+  dynamicGroups: SlashMenuGroup[]","+  groups: SlashMenuGroup[]","+}): SlashMenuGroup[] {","+  const result: SlashMenuGroup[] = groups.map((group) => ({","+    ...group,","+    items: [...group.items],","+  }))","+","+  for (const dynamicGroup of dynamicGroups) {","+    const existingIndex = result.findIndex((group) => group.key === dynamicGroup.key)","+","+    if (existingIndex === -1) {","+      result.push({","+        ...dynamicGroup,","+        items: [...dynamicGroup.items],","+      })","+      continue","+    }","+","+    const existingGroup = result[existingIndex]!","+","+    result[existingIndex] = {","+      ...existingGroup,","+      items: [...existingGroup.items, ...dynamicGroup.items],","+    }","+  }","+","+  return result","+}",""],"additions":129,"deletions":0,"truncated":false}],"additions":527,"deletions":101,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-21T16:32:04.611866+00:00"}