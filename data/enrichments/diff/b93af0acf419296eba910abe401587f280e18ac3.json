-","-\t// BGPCiliumPodIPPoolAdvert when configured, Cilium will advertise prefixes from CiliumPodIPPools to BGP peers.","-\tBGPCiliumPodIPPoolAdvert BGPAdvertisementType = \"CiliumPodIPPool\"","-","-\t// BGPServiceAdvert when configured, Cilium will advertise service related routes to BGP peers.","-\tBGPServiceAdvert BGPAdvertisementType = \"Service\"","-)","-","-// BGPServiceAddressType defines type of service address to be advertised.","-//","-// Note list of supported service addresses is not exhaustive and can be extended in the future.","-// Consumer of this API should be able to handle unknown values.","-//","-// +kubebuilder:validation:Enum=LoadBalancerIP;ClusterIP;ExternalIP","-type BGPServiceAddressType string","-","-const (","-\t// BGPLoadBalancerIPAddr when configured, Cilium will advertise load balancer services IPs to BGP peers.","-\t// The loadBalancerClass for a service must be nil or specify a class supported by Cilium,","-\t// e.g. \"io.cilium/bgp-control-plane\".","-\t//","-\t// Refer to the following document for additional details regarding load balancer","-\t// classes: https://kubernetes.io/docs/concepts/services-networking/service/#load-balancer-class","-\tBGPLoadBalancerIPAddr BGPServiceAddressType = \"LoadBalancerIP\"","-","-\t// BGPClusterIPAddr when configured, Cilium will advertise cluster IP prefix of a service to BGP peers.","-\t// Cluster IP for a service is defined here","-\t// https://kubernetes.io/docs/concepts/services-networking/service/#type-clusterip","-\tBGPClusterIPAddr BGPServiceAddressType = \"ClusterIP\"","-","-\t// BGPExternalIPAddr when configured, Cilium will advertise external IP prefix of a service to BGP peers.","-\t// External IP for a service is defined here","-\t// https://kubernetes.io/docs/concepts/services-networking/service/#external-ips","-\tBGPExternalIPAddr BGPServiceAddressType = \"ExternalIP\"","-)","-","-// +genclient","-// +genclient:nonNamespaced","-// +k8s:deepcopy-gen:interfaces=k8s.io/apimachinery/pkg/runtime.Object","-// +kubebuilder:resource:categories={cilium,ciliumbgp},singular=\"ciliumbgpadvertisement\",path=\"ciliumbgpadvertisements\",scope=\"Cluster\",shortName={cbgpadvert}","-// +kubebuilder:printcolumn:JSONPath=\".metadata.creationTimestamp\",name=\"Age\",type=date","-// +kubebuilder:deprecatedversion","-","-// CiliumBGPAdvertisement is the Schema for the ciliumbgpadvertisements API","-type CiliumBGPAdvertisement struct {","-\t// +deepequal-gen=false","-\tmetav1.TypeMeta `json:\",inline\"`","-\t// +deepequal-gen=false","-\t// +kubebuilder:validation:Required","-\tmetav1.ObjectMeta `json:\"metadata\"`","-","-\t// +kubebuilder:validation:Required","-\tSpec CiliumBGPAdvertisementSpec `json:\"spec\"`","-}","-","-// +k8s:deepcopy-gen:interfaces=k8s.io/apimachinery/pkg/runtime.Object","-// +k8s:openapi-gen=false","-// +deepequal-gen=false","-","-// CiliumBGPAdvertisementList contains a list of CiliumBGPAdvertisement","-type CiliumBGPAdvertisementList struct {","-\tmetav1.TypeMeta `json:\",inline\"`","-\tmetav1.ListMeta `json:\"metadata\"`","-","-\t// Items is a list of CiliumBGPAdvertisement.","-\tItems []CiliumBGPAdvertisement `json:\"items\"`","-}","-","-type CiliumBGPAdvertisementSpec struct {","-\t// Advertisements is a list of BGP advertisements.","-\t//","-\t// +kubebuilder:validation:Required","-\tAdvertisements []BGPAdvertisement `json:\"advertisements\"`","-}","-","-// BGPAdvertisement defines which routes Cilium should advertise to BGP peers. Optionally, additional attributes can be","-// set to the advertised routes.","-//","-// +kubebuilder:validation:XValidation:rule=\"self.advertisementType != 'Service' || has(self.service)\", message=\"service field is required for the 'Service' advertisementType\"","-// +kubebuilder:validation:XValidation:rule=\"self.advertisementType != 'PodCIDR' || !has(self.selector)\", message=\"selector field is not allowed for the 'PodCIDR' advertisementType\"","-type BGPAdvertisement struct {","-\t// AdvertisementType defines type of advertisement which has to be advertised.","-\t//","-\t// +kubebuilder:validation:Required","-\tAdvertisementType BGPAdvertisementType `json:\"advertisementType\"`","-","-\t// Service defines configuration options for advertisementType service.","-\t//","-\t// +kubebuilder:validation:Optional","-\tService *BGPServiceOptions `json:\"service,omitempty\"`","-","-\t// Selector is a label selector to select objects of the type specified by AdvertisementType.","-\t// For the PodCIDR AdvertisementType it is not applicable. For other advertisement types,","-\t// if not specified, no objects of the type specified by AdvertisementType are selected for advertisement.","-\t//","-\t// +kubebuilder:validation:Optional","-\tSelector *slimv1.LabelSelector `json:\"selector,omitempty\"`","-","-\t// Attributes defines additional attributes to set to the advertised routes.","-\t// If not specified, no additional attributes are set.","-\t//","-\t// +kubebuilder:validation:Optional","-\tAttributes *BGPAttributes `json:\"attributes,omitempty\"`","-}","-","-// BGPServiceOptions defines the configuration for Service advertisement type.","-type BGPServiceOptions struct {","-\t// Addresses is a list of service address types which needs to be advertised via BGP.","-\t//","-\t// +kubebuilder:validation:Required","-\t// +kubebuilder:validation:MinItems=1","-\tAddresses []BGPServiceAddressType `json:\"addresses,omitempty\"`","-","-\t// IPv4 mask to aggregate BGP route advertisements of service","-\t//","-\t// +kubebuilder:validation:Minimum=0","-\t// +kubebuilder:validation:Maximum=31","-\t// +kubebuilder:validation:Optional","-\tAggregationLengthIPv4 *int16 `json:\"aggregationLengthIPv4,omitempty\"`","-","-\t// IPv6 mask to aggregate BGP route advertisements of service","-\t//","-\t// +kubebuilder:validation:Minimum=0","-\t// +kubebuilder:validation:Maximum=127","-\t// +kubebuilder:validation:Optional","-\tAggregationLengthIPv6 *int16 `json:\"aggregationLengthIPv6,omitempty\"`","-}","-","-// BGPStandardCommunity type represents a value of the \"standard\" 32-bit BGP Communities Attribute (RFC 1997)","-// as a 4-byte decimal number or two 2-byte decimal numbers separated by a colon (<0-65535>:<0-65535>).","-// For example, no-export community value is 65553:65281.","-// +kubebuilder:validation:Pattern=`^([0-9]|[1-9][0-9]{1,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$|^([0-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]):([0-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$`","-type BGPStandardCommunity string","-","-// BGPWellKnownCommunity type represents a value of the \"standard\" 32-bit BGP Communities Attribute (RFC 1997)","-// as a well-known string alias to its numeric value. Allowed values and their mapping to the numeric values:","-//","-//\tinternet                   = 0x00000000 (0:0)","-//\tplanned-shut               = 0xffff0000 (65535:0)","-//\taccept-own                 = 0xffff0001 (65535:1)","-//\troute-filter-translated-v4 = 0xffff0002 (65535:2)","-//\troute-filter-v4            = 0xffff0003 (65535:3)","-//\troute-filter-translated-v6 = 0xffff0004 (65535:4)","-//\troute-filter-v6            = 0xffff0005 (65535:5)","-//\tllgr-stale                 = 0xffff0006 (65535:6)","-//\tno-llgr                    = 0xffff0007 (65535:7)","-//\tblackhole                  = 0xffff029a (65535:666)","-//\tno-export                  = 0xffffff01\t(65535:65281)","-//\tno-advertise               = 0xffffff02 (65535:65282)","-//\tno-export-subconfed        = 0xffffff03 (65535:65283)","-//\tno-peer                    = 0xffffff04 (65535:65284)","-//","-// +kubebuilder:validation:Enum=internet;planned-shut;accept-own;route-filter-translated-v4;route-filter-v4;route-filter-translated-v6;route-filter-v6;llgr-stale;no-llgr;blackhole;no-export;no-advertise;no-export-subconfed;no-peer","-type BGPWellKnownCommunity string","-","-// BGPLargeCommunity type represents a value of the BGP Large Communities Attribute (RFC 8092),","-// as three 4-byte decimal numbers separated by colons.","-// +kubebuilder:validation:Pattern=`^([0-9]|[1-9][0-9]{1,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5]):([0-9]|[1-9][0-9]{1,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5]):([0-9]|[1-9][0-9]{1,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$`","-type BGPLargeCommunity string","-","-// BGPCommunities holds community values of the supported BGP community path attributes.","-type BGPCommunities struct {","-\t// Standard holds a list of \"standard\" 32-bit BGP Communities Attribute (RFC 1997) values defined as numeric values.","-\t//","-\t// +kubebuilder:validation:Optional","-\tStandard []BGPStandardCommunity `json:\"standard,omitempty\"`","-","-\t// WellKnown holds a list \"standard\" 32-bit BGP Communities Attribute (RFC 1997) values defined as","-\t// well-known string aliases to their numeric values.","-\t//","-\t// +kubebuilder:validation:Optional","-\tWellKnown []BGPWellKnownCommunity `json:\"wellKnown,omitempty\"`","-","-\t// Large holds a list of the BGP Large Communities Attribute (RFC 8092) values.","-\t//","-\t// +kubebuilder:validation:Optional","-\tLarge []BGPLargeCommunity `json:\"large,omitempty\"`","-}","-","-// BGPAttributes defines additional attributes to set to the advertised NLRIs.","-type BGPAttributes struct {","-\t// Communities sets the community attributes in the route.","-\t// If not specified, no community attribute is set.