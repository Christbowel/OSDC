shCommandResult, ICopilotSlashCommandHandler, RuntimeSlashCommandInfo } from './copilotSlashCommand.js';","+","+export const copilotSandboxPolicyCommand: RuntimeSlashCommandInfo = {","+\tname: 'sandbox-policy',","+\tdescription: localize('copilotSlashCommand.sandboxPolicy', \"Show the effective sandbox policy for this session\"),","+\tkind: 'builtin',","+\tallowDuringAgentExecution: true,","+};","+","+export class CopilotSandboxPolicyDisplay {","+\tconstructor(","+\t\tprivate readonly _sessionId: string,","+\t\tprivate readonly _storageUri: URI,","+\t\t@IFileService private readonly _fileService: IFileService,","+\t\t@ILogService private readonly _logService: ILogService,","+\t\t@ISessionDataService private readonly _sessionDataService: ISessionDataService,","+\t) { }","+","+\tgetHandler(command: RuntimeSlashCommandInfo): ICopilotSlashCommandHandler | undefined {","+\t\tif (command.kind !== 'builtin' || (command.name !== copilotSandboxPolicyCommand.name && command.name !== 'sandbox')) {","+\t\t\treturn undefined;","+\t\t}","+\t\treturn {","+\t\t\tgetInvocation: command.name === copilotSandboxPolicyCommand.name ? input => this.getInvocation(input) : undefined,","+\t\t\tgetOutput: (input, result) => command.name === copilotSandboxPolicyCommand.name || input === 'policy' ? this.getOutput(result) : undefined,","+\t\t};","+\t}","+","+\tprivate getInvocation(input: string): CopilotSlashCommandInvocation {","+\t\tif (input.trim().length > 0) {","+\t\t\tthrow new Error(localize('copilotSlashCommand.sandboxPolicyNoArguments', \"The /sandbox-policy command does not accept arguments.\"));","+\t\t}","+\t\treturn { name: 'sandbox', input: 'policy' };","+\t}","+","+\tprivate async getOutput(result: CopilotSlashCommandResult): Promise<CopilotSlashCommandOutput> {","+\t\tconst text = result.kind === 'text' ? result.text : result.kind === 'completed' ? result.message : undefined;","+\t\tif (!text?.trim()) {","+\t\t\tthrow new Error(localize('copilotSlashCommand.sandboxPolicyUnavaila