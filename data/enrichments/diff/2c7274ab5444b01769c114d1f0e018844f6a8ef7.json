on direction).","+\t */","+\tpublic acceptHint(","+\t\thintOrMessage: UndoEditHint | UndoEditHintMessage,","+\t\ttrack?: TrackEditorOffset,","+\t\thasUnwritten = false,","+\t): void {","+\t\tconst message: UndoEditHintMessage = typeof hintOrMessage === 'string'","+\t\t\t? { kind: hintOrMessage }","+\t\t\t: hintOrMessage;","+","+\t\tif (message.kind === 'break') {","+\t\t\tif (!hasUnwritten) {","+\t\t\t\tthis.reset();","+\t\t\t\treturn;","+\t\t\t}","+\t\t\tif (track && message.version !== undefined && message.offset !== undefined) {","+\t\t\t\tconst tracked = track(message.version, message.offset, 'before');","+\t\t\t\tif (tracked) {","+\t\t\t\t\tthis.#breakOffsets.push(tracked);","+\t\t\t\t\treturn;","+\t\t\t\t}","+\t\t\t}","+\t\t\tthis.reset();","+\t\t\treturn;","+\t\t}","+","+\t\tif (message.kind === 'isolated') {","+\t\t\tif (track && message.version !== undefined && message.offset !== undefined && message.length !== undefined && message.length > 0) {","+\t\t\t\tconst tracked = track(message.version, message.offset, 'before');","+\t\t\t\tif (tracked) {","+\t\t\t\t\tthis.#isolatedRanges.push({ start: tracked, length: message.length });","+\t\t\t\t\treturn;","+\t\t\t\t}","+\t\t\t}","+\t\t\tthis.#pendingIsolatedFallback = true;","+\t\t\treturn;","+\t\t}","+","+\t\tthis.#pendingDeleteDirection = message.kind;","+\t}","+","+\t/**","+\t * Plans one or more sequential `applyEdit` steps for `edits` along with their","+\t * `undoStopBefore` / `undoStopAfter` metadata. Batched typing that crosses a","+\t * word/space undo boundary, a tracked paste range, or a tracked navigation break","+\t * is split at those boundaries so undo granularity does not depend on IPC batching.","+\t *","+\t * Call `step.commit()` after the atomic write succeeds.","+\t */","+\tpublic planEdits(edits: readonly DocumentTextEdit[], deletedText: string): readonly PlannedUndoStep[] {","+\t\tconst deleteHint = this.#pendingDeleteDirection;","+\t\tconst isolatedFallback = this.#pendingIsolatedFallback;