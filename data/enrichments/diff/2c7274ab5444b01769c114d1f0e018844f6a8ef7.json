m.offset <= endOffset) {","+\t\t\t\tconsumedBreaks.add(item);","+\t\t\t\tbreakPositions.add(item.offset - offset);","+\t\t\t}","+\t\t}","+","+\t\t// Fast path: no tracked isolated ranges and no tracked breaks","+\t\tif (isolatedSlices.length === 0 && breakPositions.size === 0) {","+\t\t\tif (text.length > MAX_COALESCED_EDIT_LENGTH) {","+\t\t\t\treturn [makeStep([{ offset, length: 0, newText: text }], { undoStopBefore: true, undoStopAfter: true }, { kind: 'other', offset: undefined })];","+\t\t\t}","+\t\t\treturn this.#planTyping(offset, text, this.#lastKind, this.#lastOffset, makeStep).steps;","+\t\t}","+","+\t\t// Merge overlapping/adjacent isolated slices in ascending order","+\t\tisolatedSlices.sort((a, b) => a.start - b.start || a.end - b.end);","+\t\tconst mergedIsolated: { start: number; end: number }[] = [];","+\t\tfor (const slice of isolatedSlices) {","+\t\t\tconst prev = mergedIsolated[mergedIsolated.length - 1];","+\t\t\tif (prev && slice.start <= prev.end) {","+\t\t\t\tprev.end = Math.max(prev.end, slice.end);","+\t\t\t} else {","+\t\t\t\tmergedIsolated.push({ ...slice });","+\t\t\t}","+\t\t}","+","+\t\t// Build ordered segments of [0, text.length]: typing slices (split at breakPositions) and isolated slices","+\t\tconst steps: PlannedUndoStep[] = [];","+\t\tlet kind: EditKind = breakPositions.has(0) ? 'other' : this.#lastKind;","+\t\tlet prevOffset: number | undefined = breakPositions.has(0) ? undefined : this.#lastOffset;","+","+\t\tconst emitTypingSlice = (relStart: number, relEnd: number): void => {","+\t\t\tif (relEnd <= relStart) {","+\t\t\t\treturn;","+\t\t\t}","+\t\t\t// Split further at any break points strictly inside (relStart, relEnd)","+\t\t\tconst cuts: number[] = [relStart];","+\t\t\tfor (const b of Array.from(breakPositions).sort((a, b) => a - b)) {","+\t\t\t\tif (b > relStart && b < relEnd) {","+\t\t\t\t\tcuts.push(b);","+\t\t\t\t}","+\t\t\t}","+\t\t\tcuts.push(relEnd);","+","+\t\t\tfor (let i = 0; i < cuts.length - 1; i++) {","+\t\t\t\t