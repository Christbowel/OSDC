ires ROCm\"","+)","+","+MODEL = \"Qwen/Qwen3.5-0.8B\"","+","+","+@pytest.mark.parametrize(\"tp_size,use_aiter\", [(1, \"0\"), (2, \"1\")])","+def test_models(","+    hf_runner,","+    vllm_runner,","+    example_prompts,","+    monkeypatch: pytest.MonkeyPatch,","+    tp_size: int,","+    use_aiter: str,","+) -> None:","+    if current_platform.device_count() < tp_size:","+        pytest.skip(f\"Need >= {tp_size} GPUs\")","+    monkeypatch.setenv(\"VLLM_ROCM_USE_AITER\", use_aiter)","+    max_tokens, num_logprobs = 32, 5","+","+    with hf_runner(MODEL, auto_cls=AutoModelForImageTextToText) as hf_model:","+        hf_outputs = hf_model.generate_greedy_logprobs_limit(","+            example_prompts, max_tokens, num_logprobs","+        )","+","+    with vllm_runner(","+        MODEL,","+        tensor_parallel_size=tp_size,","+        max_model_len=2048,","+        max_num_seqs=4,","+        enable_chunked_prefill=True,","+        gpu_memory_utilization=0.3,","+        language_model_only=True,","+    ) as vllm_model:","+        config = vllm_model.llm.llm_engine.vllm_config.compilation_config","+        assert config.use_breakable_cudagraph","+        vllm_outputs = vllm_model.generate_greedy_logprobs(","+            example_prompts, max_tokens, num_logprobs","+        )","+","+    check_logprobs_close(","+        outputs_0_lst=hf_outputs,","+        outputs_1_lst=vllm_outputs,","+        name_0=\"hf\",","+        name_1=\"vllm\",","+    )"],"additions":59,"deletions":0,"truncated":false},{"path":"tests/models/test_qwen3_5.py","lines":["@@ -1,17 +1,24 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project"," ","+import importlib","+","+import pytest","+"," "," def test_qwen3_5_models_use_platform_specific_implementation():","     from vllm.models.qwen3_5 import Qwen3_5ForCausalLM, Qwen3_5MTP","     from vllm.platforms import current_platform"," ","-    # Only the NVIDIA variant drops torch.compile; ROCm and other platforms","+    # The NVIDIA and ROCm variants drop torch.compile; other platforms","     # keep the previous torch.compile implementation in","     # vllm/model_executor/models/qwen3_5{,_mtp}.py.","     if current_platform.is_cuda():","         model_module = \"vllm.models.qwen3_5.nvidia.model\"","         mtp_module = \"vllm.models.qwen3_5.nvidia.mtp\"","+    elif current_platform.is_rocm():","+        model_module = \"vllm.models.qwen3_5.amd.model\"","+        mtp_module = \"vllm.models.qwen3_5.amd.mtp\"","     else:","         model_module = \"vllm.model_executor.models.qwen3_5\"","         mtp_module = \"vllm.model_executor.models.qwen3_5_mtp\"","@@ -19,12 +26,14 @@ def test_qwen3_5_models_use_platform_specific_implementation():","     assert Qwen3_5MTP.__module__ == mtp_module"," "," ","-def test_qwen3_5_nvidia_models_do_not_use_torch_compile_wrapper():","-    # Import the NVIDIA modules directly so the assertion is independent of","+@pytest.mark.parametrize(\"platform\", [\"nvidia\", \"amd\"])","+def test_qwen3_5_platform_models_do_not_use_torch_compile_wrapper(platform: str):","+    # Import the platform modules directly so the assertion is independent of","     # the platform this test runs on.","     from vllm.compilation.wrapper import TorchCompileWithNoGuardsWrapper","-    from vllm.models.qwen3_5.nvidia import model as model_module","-    from vllm.models.qwen3_5.nvidia import mtp as mtp_module","+","+    model_module = importlib.import_module(f\"vllm.models.qwen3_5.{platform}.model\")","+    mtp_module = importlib.import_module(f\"vllm.models.qwen3_5.{platform}.mtp\")"," ","     assert not issubclass(model_module.Qwen3_5Model, TorchCompileWithNoGuardsWrapper)","     assert not issubclass(","@@ -34,8 +43,8 @@ def test_qwen3_5_nvidia_models_do_not_use_torch_compile_wrapper():"," "," "," def test_qwen3_5_legacy_models_keep_torch_compile_wrapper():","-    # The legacy implementation in vllm/model_executor/models/ serves ROCm and","-    # other non-NVIDIA platforms; it must keep the torch.compile wrapper.","+    # The legacy implementation in vllm/model_executor/models/ serves the","+    # other platforms; it must keep the torch.compile wrapper.","     from vllm.compilation.wrapper import TorchCompileWithNoGuardsWrapper","     from vllm.model_executor.models import qwen3_5 as model_module","     from vllm.model_executor.models import qwen3_5_mtp as mtp_module"],"additions":16,"deletions":7,"truncated":false},{"path":"tests/test_config.py","lines":["@@ -1032,6 +1032,7 @@ def test_dsa_models_default_to_breakable_cudagraph(","         (\"Qwen4ExpForConditionalGeneration\", True, False),","         (\"Qwen4ExpMTP\", False, True),","         (\"Qwen4ExpMTP\", True, False),","+        (\"Qwen3_5ForConditionalGeneration\", True, True),","     ],"," )"," def test_breakable_cudagraph_platform_default("],"additions":1,"deletions":0,"truncated":false},{"path":"vllm/config/vllm.py","lines":["@@ -150,10 +150,14 @@ def default_breakable_cudagraph_architectures() -> frozenset[str]:","         # recipe can start.","         # HYV4 also runs without torch.compile, preserving runtime-shape","         # kernel selection during graph capture.","-        return frozenset({\"DeepseekV41ForCausalLM\", \"HYV4ForCausalLM\", \"HYV4MTPModel\"})","+        # Qwen3.5 runs the eager vllm/models/qwen3_5/amd model.","+        return (","+            frozenset({\"DeepseekV41ForCausalLM\", \"HYV4ForCausalLM\", \"HYV4MTPModel\"})","+            | _QWEN3_5_ARCHITECTURES","+        )","     if current_platform.is_cuda():","-        # Qwen3.5 migrates to breakable CUDA graphs on NVIDIA only; other","-        # platforms keep the torch.compile path.","+        # Qwen3.5 migrates to breakable CUDA graphs on NVIDIA and ROCm;","+        # other platforms keep the torch.compile path.","         return DEFAULT_BREAKABLE_CUDAGRAPH_ARCHITECTURES | _QWEN3_5_ARCHITECTURES","     return DEFAULT_BREAKABLE_CUDAGRAPH_ARCHITECTURES"," "],"additions":7,"deletions":3,"truncated":false},{"path":"vllm/model_executor/models/qwen3_next.py","lines":["@@ -382,13 +382,15 @@ def __init__(","             torch.float16,","             torch.bfloat16,","         )","-        self.use_fused_qk_norm_rope_gate = (","+        self.supports_fused_qk_norm_rope_gate = (","             self.attn_output_gate","             and getattr(self.rotary_emb, \"is_neox_style\", False)","-            and (current_platform.is_cuda() or current_platform.is_xpu())","             and supports_dtype","             and (text_only or supports_mrope)","         )","+        self.use_fused_qk_norm_rope_gate = self.supports_fused_qk_norm_rope_gate and (","+            current_platform.is_cuda() or current_platform.is_xpu()","+        )"," ","         # Off by default; Qwen3.5 enables the fused sigmoid-gate-mul Triton","         # kernel post-construction (see Qwen3_5DecoderLayer)."],"additions":4,"deletions":2,"truncated":false},{"path":"vllm/models/qwen3_5/__init__.py","lines":["@@ -2,10 +2,10 @@"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project"," \"\"\"Qwen3.5 model — hardware-isolated entry point."," ","-Only the NVIDIA variant migrates to the new eager + breakable CUDA-graph","-modelling code with explicit fused kernels. ROCm and all other platforms keep","-the previous torch.compile implementation in `vllm/model_executor/models/`","-so their behavior is unchanged.","+The NVIDIA and ROCm variants use the eager + breakable CUDA-graph modelling","+code with explicit fused kernels. All other platforms keep the previous","+torch.compile implementation in `vllm/model_executor/models/` so their behavior","+is unchanged."," \"\"\""," "," from typing import TYPE_CHECKING","@@ -22,6 +22,16 @@","         Qwen3_5MoeForConditionalGeneration,","     )","     from .nvidia.mtp import Qwen3_5MoeMTP, Qwen3_5MTP","+elif current_platform.is_rocm():","+    from .amd.model import (  # type: ignore[assignment]","+        Qwen3_5ForCausalLM,","+        Qwen3_5ForCausalLMBase,","+        Qwen3_5ForConditionalGeneration,","+        Qwen3_5Model,","+        Qwen3_5MoeForCausalLM,","+        Qwen3_5MoeForConditionalGeneration,","+    )","+    from .amd.mtp import Qwen3_5MoeMTP, Qwen3_5MTP  # type: ignore[assignment]"," else:","     from vllm.model_executor.models.qwen3_5 import (  # type: ignore[assignment]","         Qwen3_5ForCausalLM,"],"additions":14,"deletions":4,"truncated":false},{"path":"vllm/models/qwen3_5/amd/__init__.py","lines":["@@ -0,0 +1,2 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project"],"additions":2,"deletions":0,"truncated":false},{"path":"vllm/models/qwen3_5/amd/model.py","lines":["@@ -0,0 +1,990 @@","+# SPDX-License-Identifier: Apache-2.0","+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project","+","+# Copyright 2025 The vLLM team.","+# Copyright 2025 The Qwen Team.","+# Copyright 2025 The HuggingFace Inc. team.","+# All rights reserved.","+#","+# This code is based on EleutherAI's GPT-NeoX library and the GPT-NeoX","+# and OPT implementations in this library. It has been modified from its","+# original forms to accommodate minor architectural differences compared","+# to GPT-NeoX and OPT used by the Meta AI team that trained the model.","+#","+# Licensed under the Apache License, Version 2.0 (the \"License\");","+# you may not use this file except in compliance with the License.","+# You may obtain a copy of the License at","+#","+#     http://www.apache.org/licenses/LICENSE-2.0","+#","+# Unless required by applicable law or agreed to in writing, software","+# distributed under the License is distributed on an \"AS IS\" BASIS,","+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+# See the License for the specific language governing permissions and","+# limitations under the License.","+\"\"\"Inference-only Qwen3.5 Series, AMD ROCm implementation.","+","+Mirrors `../nvidia/model.py` (eager + br