t}),","+\t\t\t\tHandler: &tracedPluginHandler{","+\t\t\t\t\tpluginID: \"test-app\",","+\t\t\t\t\tHandler: &pluginroute.Handler{Handler: http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {","+\t\t\t\t\t\thandlerContext = trace.SpanContextFromContext(req.Context())","+\t\t\t\t\t\tgot, err := identity.GetRequester(req.Context())","+\t\t\t\t\t\trequire.NoError(t, err)","+\t\t\t\t\t\trequire.Same(t, requester, got)","+\t\t\t\t\t\tw.WriteHeader(http.StatusCreated)","+\t\t\t\t\t})},","+\t\t\t\t},","+\t\t\t}","+\t\t\treq := httptest.NewRequest(http.MethodPost, \"/apis/test.ext.grafana.app/v1/resources\", nil)","+\t\t\treq.Header.Set(\"X-Access-Token\", token)","+\t\t\tresponse := httptest.NewRecorder()","+\t\t\tserveThroughBreaker(newGroupBreaker(\"test.ext.grafana.app\"), \"test.ext.grafana.app\", handler, response, req)","+\t\t\tended := spans.Ended()","+\t\t\trequire.Equal(t, \"router.plugin.authenticate\", ended[0].Name())","+\t\t\tif token == \"valid\" {","+\t\t\t\trequire.Equal(t, http.StatusCreated, response.Code)","+\t\t\t\trequire.Len(t, ended, 2)","+\t\t\t\trequire.Equal(t, \"router.backend\", ended[1].Name())","+\t\t\t\trequire.Contains(t, ended[1].Attributes(), attribute.String(\"grafana.plugin.id\", \"test-app\"))","+\t\t\t\trequire.Equal(t, handlerContext, ended[1].SpanContext())","+\t\t\t\trequire.Contains(t, ended[1].Attributes(), attribute.Int(\"http.response.status_code\", http.StatusCreated))","+\t\t\t} else {","+\t\t\t\trequire.Equal(t, http.StatusUnauthorized, response.Code)","+\t\t\t\trequire.Len(t, ended, 2)","+\t\t\t\trequire.False(t, handlerContext.IsValid())","+\t\t\t\trequire.Equal(t, codes.Error, ended[0].Status().Code)","+\t\t\t\texpectedError := \"invalid_token\"","+\t\t\t\tif token == \"\" {","+\t\t\t\t\texpectedError = \"missing_token\"","+\t\t\t\t}","+\t\t\t\trequire.Contains(t, ended[0].Attributes(), attribute.String(\"error.type\", expectedError))","+\t\t\t}","+\t\t\tif token != \"\" {","+\t\t\t\trequire.Equal(t, authContext, ended[0].SpanContext())","+\t\t\t}","+\t\t\tfor _, attr := range ended[0].Attributes() {","+\t\t\t\trequire.NotEqual(t, attribute.Key(\"http.response.status_code\"), attr.Key)","+\t\t\t}","+\t\t\tbackend := ended[len(ended)-1]","+\t\t\trequire.Equal(t, \"router.backend\", backend.Name())","+\t\t\trequire.Equal(t, backend.SpanContext().SpanID(), ended[0].Parent().SpanID())","+\t\t})","+\t}","+}"],"additions":79,"deletions":0,"truncated":false},{"path":"pkg/router/router.go","lines":["@@ -162,7 +162,7 @@ func (cr *GrafanaRouter) HandleFunc(w http.ResponseWriter, req *http.Request, ne"," \t}"," \t// /apis/<group> group discovery and /apis/<group>/... both proxy to the"," \t// single owning backend (one backend owns all versions of a group).","-\tserveThroughBreaker(entry.breaker, entry.handler, w, req)","+\tserveThroughBreaker(entry.breaker, group, entry.handler, w, req)"," }"," "," func (cr *GrafanaRouter) serveUnregisteredGroup(w http.ResponseWriter, req *http.Request, next http.Handler, group string) {","@@ -273,7 +273,7 @@ func (cr *GrafanaRouter) serveOpenAPIGroupVersion(w http.ResponseWriter, req *ht"," \tstripConditionalHeaders(proxyReq)"," \tstripHashQueryParam(proxyReq)"," \trec := newCaptureWriter()","-\tserveThroughBreaker(entry.breaker, entry.handler, rec, proxyReq)","+\tserveThroughBreaker(entry.breaker, group, entry.handler, rec, proxyReq)"," "," \tmaps.Copy(w.Header(), rec.header)"," \t// Private schemas pass through authorization on every request. Honor their"],"additions":2,"deletions":2,"truncated":false},{"path":"pkg/router/st_fallback.go","lines":["@@ -188,10 +188,10 @@ func (st *singleTenantFallback) forward(host *url.URL, group string, w http.Resp"," \t\tRewrite: func(pr *httputil.ProxyRequest) {"," \t\t\tpr.SetURL(host)"," \t\t},","-\t\tTransport:      st.transport,","+\t\tTransport:      newBackendTransport(st.transport),"," \t\tModifyResponse: rejectBackendRedirects,"," \t}","-\tserveThroughBreaker(st.breakerForDestination(host, group), proxy,