rec := newStatusRecorder(w)","+\treturn rec, req.WithContext(ctx), func() {","+\t\tpanicked := recover()","+\t\tif panicked != nil {","+\t\t\tdefer func() { panic(panicked) }()","+\t\t}","+\t\t// End before re-panicking so the SDK does not record arbitrary panic payloads.","+\t\tdefer span.End()","+\t\t// A canceled or panicking handler may never have sent a response.","+\t\tif rec.wroteHeader || (panicked == nil && req.Context().Err() == nil) {","+\t\t\tspan.SetAttributes(semconv.HTTPResponseStatusCode(rec.status))","+\t\t}","+\t\tif err := req.Context().Err(); err == context.Canceled {","+\t\t\tspan.SetAttributes(attribute.Bool(\"grafana.router.canceled\", true))","+\t\t} else if err != nil {","+\t\t\tspan.SetAttributes(semconv.ErrorTypeKey.String(\"timeout\"))","+\t\t\tspan.SetStatus(codes.Error, \"\")","+\t\t} else if panicked != nil {","+\t\t\tspan.SetAttributes(semconv.ErrorTypeKey.String(\"panic\"))","+\t\t\tspan.SetStatus(codes.Error, \"\")","+\t\t} else if rec.status >= http.StatusInternalServerError {","+\t\t\tspan.SetAttributes(semconv.ErrorTypeKey.String(strconv.Itoa(rec.status)))","+\t\t\tspan.SetStatus(codes.Error, \"\")","+\t\t}","+\t}","+}","+","+func traceHTTPMethod(method string) string {","+\tswitch method {","+\tcase http.MethodGet, http.MethodHead, http.MethodPost, http.MethodPut, http.MethodDelete,","+\t\thttp.MethodConnect, http.MethodOptions, http.MethodTrace, http.MethodPatch:","+\t\treturn method","+\tdefault:","+\t\treturn \"_OTHER\"","+\t}","+}"],"additions":77,"deletions":0,"truncated":false},{"path":"pkg/router/tracing_test.go","lines":["@@ -0,0 +1,355 @@","+package router","+","+import (","+\t\"context\"","+\t\"encoding/json\"","+\t\"io\"","+\t\"net/http\"","+\t\"net/http/httptest\"","+\t\"net/url\"","+\t\"testing\"","+\t\"time\"","+","+\t\"github.com/stretchr/testify/require\"","+\t\"go.opentelemetry.io/otel\"","+\t\"go.opentelemetry.io/otel/attribute\"","+\t\"go.opentelemetry.io/otel/codes\"","+\t\"go.opentelemetry.io/otel/propagatio