\", c_plain, &[(\"d\", \"d@1.0.0\")], &[]));","+    graph.insert("],"additions":415,"deletions":12,"truncated":false}],"additions":609,"deletions":13,"truncated":true,"file_count":4},"error":null,"fetched_at":"2026-09-29T14:22:08.497336+00:00"}