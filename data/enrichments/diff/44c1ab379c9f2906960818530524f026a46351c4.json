ams } from 'next/navigation'","+import { useState } from 'react'","+","+export function Client() {","+  const params = useParams()","+  const [count, setCount] = useState(0)","+  return (","+    <>","+      <p id=\"params\">{JSON.stringify(params)}</p>","+      <button id=\"counter\" onClick={() => setCount(count + 1)}>","+        {count}","+      </button>","+    </>","+  )","+}"],"additions":17,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/static-fallback-csp-nonce/next.config.ts","lines":["@@ -0,0 +1,10 @@","+import type { NextConfig } from 'next'","+","+const nextConfig: NextConfig = {","+  cacheComponents: process.env.__NEXT_TEST_AXIS !== 'A',","+  experimental: {","+    cachedNavigations: false,","+  },","+}","+","+export default nextConfig"],"additions":10,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/static-fallback-csp-nonce/static-fallback-csp-nonce.test.ts","lines":["@@ -0,0 +1,51 @@","+import { nextTestSetup } from 'e2e-utils'","+import { load } from 'cheerio'","+","+// Static fallback bootstrap scripts are generated by production prerendering.","+// @force-gate !dev && cacheComponents","+describe('static-fallback-csp-nonce', () => {","+  const { next, isNextStart } = nextTestSetup({ files: __dirname })","+","+  // Each locale has no build-time shell, so its first request renders one.","+  for (const [locale, header, nonce] of [","+    ['fr', 'content-security-policy', 'fallback-test'],","+    ['de', 'content-security-policy-report-only', 'fallback-report'],","+    ['es', undefined, undefined],","+  ] as const) {","+    it(`preserves the available nonce for ${locale}`, async () => {","+      const response = await next.fetch(","+        `/static-fallback-csp-nonce/${locale}/new`,","+        {","+          headers: header","+            ? { [header]: `script-src 'self' 'nonce-${nonce}'` }","+            : {},","+        }","+      )","+      expect(response.status).toBe(200)","+      const $ = load(await response.text())","+      expect($('#locale').text()).toBe(locale)","+      const resume = $('script')","+        .toArray()","+        .filter((script) => $(script).html()?.includes('__NEXT_CLIENT_RESUME='))","+      // Next start generates a static fallback for the unbuilt locale.","+      // Deployment adapters may render the concrete route directly instead.","+      if (isNextStart) {","+        expect(resume).toHaveLength(1)","+      } else {","+        expect(resume.length).toBeLessThanOrEqual(1)","+      }","+      const flight = $('script')","+        .toArray()","+        .filter((script) => $(script).html()?.includes('self.__next_f'))","+      expect(flight.length).toBeGreaterThan(0)","+      // Cached deployment HTML may have no request-specific nonce.","+      const renderedNonce = $(flight[0]).attr('nonce')","+      if (isNextStart) {","+        expect(renderedNonce).toBe(nonce)","+      }","+      for (const script of [...resume, ...flight]) {","+        expect($(script).attr('nonce')).toBe(renderedNonce)","+      }","+    })","+  }","+})",""],"additions":51,"deletions":0,"truncated":false}],"additions":145,"deletions":10,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-18T16:49:33.488311+00:00"}