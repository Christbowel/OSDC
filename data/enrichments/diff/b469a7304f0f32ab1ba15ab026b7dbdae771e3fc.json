sync fn explicit_zero_without_stale_allowances_never_has_a_fresh_window() {","         )","         .await;","         let decoder = origin.decoder().await;","+        assert!(validates(&decoder, &origin.token()).await);","+        let fetched = origin.state.fetches.load(Ordering::SeqCst);","+        assert!(validates(&decoder, &origin.token()).await);","+        assert_eq!(origin.state.fetches.load(Ordering::SeqCst), fetched + 1);","+        origin.state.revoked.store(true, Ordering::SeqCst);","         assert!(!validates(&decoder, &origin.token()).await);","         assert_eq!(","             decoder.cache.read().await.cache_policy.max_age,"],"additions":6,"deletions":1,"truncated":false},{"path":"crates/jwt-auth/tests/authentication_contract.rs","lines":["@@ -0,0 +1,105 @@","+//! Audit evidence for generic decoder error exposure and Bearer challenges.","+use salvo_core::prelude::*;","+use salvo_core::test::{ResponseExt, TestClient};","+use salvo_jwt_auth::{ConstDecoder, JWT_AUTH_ERROR_KEY, JwtAuth, JwtAuthDecoder, JwtAuthDepotExt};","+use serde::Deserialize;","+","+#[derive(Clone, Deserialize)]","+struct Claims {}","+struct CustomDecoder;","+impl JwtAuthDecoder for CustomDecoder {","+    type Error = std::io::Error;","+    async fn decode<C>(","+        &self,","+        _: &str,","+        _: &mut Depot,","+    ) -> Result<salvo_jwt_auth::TokenData<C>, Self::Error>","+    where","+        C: for<'de> Deserialize<'de> + Clone,","+    {","+        Err(std::io::Error::other(\"provider is unavailable\"))","+    }","+}","+","+#[handler]","+async fn inspect(depot: &mut Depot) -> String {","+    format!(","+        \"typed={} public={}\",","+        depot.get::<std::io::Error>(JWT_AUTH_ERROR_KEY).is_ok(),","+        depot.jwt_auth_error_typed::<std::io::Error>().is_some()","+    )","+}","+","+#[tokio::test]","+async fn custom_decoder_error_is_available_from_the_typed_accessor() {","+    let auth: JwtAuth<Claims, _> = JwtAuth::new(CustomDecoder).force_passed(true);","+    let service = Service::new(Router::new().hoop(auth).goal(inspect));","+    let mut response = TestClient::get(\"http://localhost/\")","+        .add_header(\"authorization\", \"Bearer token\", true)","+        .send(&service)","+        .await;","+    assert_eq!(","+        response.take_string().await.unwrap(),","+        \"typed=true public=true\"","+    );","+}","+","+#[tokio::test]","+async fn missing_bearer_credential_returns_a_challenge() {","+    let auth: JwtAuth<Claims, _> =","+        JwtAuth::new(ConstDecoder::from_base64_secret(\"c2VjcmV0\").unwrap());","+    let service = Service::new(Router::new().hoop(auth).goal(inspect));","+    let response = TestClient::get(\"http://localhost/\").send(&service).await;","+    assert_eq!(response.status_code, Some(StatusCode::UNAUTHORIZED));","+    assert_eq!(response.headers()[\"www-authenticate\"], \"Bearer\");","+}","+","+#[tokio::test]","+async fn invalid_bearer_credential_requests_reauthentication() {","+    let auth: JwtAuth<Claims, _> =","+        JwtAuth::new(ConstDecoder::from_base64_secret(\"c2VjcmV0\").unwrap());","+    let service = Service::new(Router::new().hoop(auth).goal(inspect));","+    let response = TestClient::get(\"http://localhost/\")","+        .add_header(\"authorization\", \"Bearer invalid\", true)","+        .send(&service)","+        .await;","+    assert_eq!(response.status_code, Some(StatusCode::UNAUTHORIZED));","+    assert_eq!(","+        response.headers()[\"www-authenticate\"],","+        \"Bearer error=\\\"invalid_token\\\"\"","+    );","+}","+","+#[cfg(feature = \"oidc\")]","+#[test]","+fn jwk_store_constructor_indexes_supplied_keys() {","+    use jsonwebtoken::jwk::JwkSet;","+    use jsonwebtoken::{Algorithm, Validation};","+    use salvo_jwt_auth::oidc::{CachePolicy, JwkSetStore};","+    let jwks: JwkSet = serde_json::from_value(serde_json::json!({\"keys\":[{","+        \"kty\":\"RSA\", \"kid\":\"present\", \"alg\":\"RS256\", \"n\":\"AQID\", \"e\":\"AQAB\"","+    }]}))","+    .unwrap();","+    let store = JwkSetStore::new(","+        jwks,","+        CachePolicy::default(),","+        Validation::new(Algorithm::RS256),","+    );","+    assert_eq!(store.jwks().keys.len(), 1);","+    assert!(store.get_key(\"present\").is_some());","+}","+","+#[cfg(feature = \"oidc\")]","+#[test]","+fn first_max_age_is_not_extended_by_a_duplicate() {","+    use salvo_core::http::HeaderValue;","+    use salvo_jwt_auth::oidc::CachePolicy;","+    let fields = [","+        HeaderValue::from_static(\"max-age=0\"),","+        HeaderValue::from_static(\"max-age=2592000\"),","+    ];","+    assert_eq!(","+        CachePolicy::from_header_values(&fields).max_age,","+        std::time::Duration::ZERO","+    );","+}"],"additions":105,"deletions":0,"truncated":false},{"path":"crates/jwt-auth/tests/oidc_zero_freshness.rs","lines":["@@ -0,0 +1,105 @@","+//! Audit evidence: a successful max-age=0 revalidation is rejected for its own use.","+#![cfg(feature = \"oidc\")]","+use std::convert::Infallible;","+use std::time::Duration;","+","+use bytes::Bytes;","+use http_body_util::Full;","+use hyper_rustls::HttpsConnectorBuilder;","+use hyper_util::client::legacy::Client;","+use hyper_util::rt::{TokioExecutor, TokioIo};","+use jsonwebtoken::{EncodingKey, Header};","+use salvo_core::Depot;","+use salvo_core::hyper::Response;","+use salvo_core::hyper::server::conn::http1;","+use salvo_core::hyper::service::service_fn;","+use salvo_jwt_auth::oidc::OidcDecoder;","+use salvo_jwt_auth::{JwtAuthDecoder, install_crypto_provider};","+use serde_json::{Value, json};","+","+struct ServerTask(tokio::task::JoinHandle<()>);","+impl Drop for ServerTask {","+    fn drop(&mut self) {","+        self.0.abort();","+    }","+}","+","+async fn check(policy: &'static str) -> bool {","+    let _ = install_crypto_provider();","+    let listener = tokio::net::TcpListener::bind(\"127.0.0.1:0\").await.unwrap();","+    let issuer = format!(\"http://{}\", listener.local_addr().unwrap());","+    let discovery = json!({\"issuer\":issuer,\"jwks_uri\":format!(\"{issuer}/jwks\")}).to_string();","+    let jwks =","+        json!({\"keys\":[{\"kty\":\"oct\",\"kid\":\"signing\",\"alg\":\"HS256\",\"k\":\"c2VjcmV0\"}]}).to_string();","+    let _server = ServerTask(tokio::spawn(async move {","+        loop {","+            let (stream, _) = listener.accept().await.unwrap();","+            let (discovery, jwks) = (discovery.clone(), jwks.clone());","+            tokio::spawn(async move {","+                let service = service_fn(move |req: salvo_core::hyper::Request<_>| {","+                    let body = if req.uri().path() == \"/jwks\" {","+                        &jwks","+                    } else {","+                        &discovery","+                    };","+                    let response = Response::builder()","+                        .header(\"cache-control\", policy)","+                        .body(Full::new(Bytes::copy_from_slice(body.as_bytes())))","+                        .unwrap();","+                    async { Ok::<_, Infallible>(response) }","+                });","+                let _ = http1::Builder::new()","+                    .serve_connection(TokioIo::new(stream), service)","+                    .await;","+            });","+        }","+    }));","+    #[cfg(feature = \"aws-lc-rs\")]","+    let crypto = rustls::crypto::aws_lc_rs::default_provider();","+    #[cfg(all(not(feature = \"aws-lc-rs\"), feature = \"ring\"))]","+    let crypto = rustls::crypto::ring::default_provider();","+    let tls = rustls::ClientConfig::builder_with_provider(crypto.into())","+        .with_safe_default_protocol_versions()","+        .unwrap()","+        .with_root_certificates(rustls::RootCertStore::empty())","+        .with_no_client_auth();","+    let connector = HttpsConnectorBuilder::new()","+        .with_tls_config(tls)","+        .https_or_http()","+        .enable_http1()","+        .build();","+    let client = Client::builder(TokioExecutor::new()).build(connector);","+    let decoder = OidcDecoder::builder(&issuer)","+        .audience(\"client\")","+        .allow_symmetric_jwks(true)","+        .http_client(client)","+        .build()","+        .await","+        .unwrap()","+        .revalidation_interval(Duration::ZERO);","+    let mut header = Header::default();","+    header.kid = Some(\"signing\".into());","+    let token = jsonwebtoken::encode(","+        &header,","+        &json!({\"iss\":issuer,\"aud\":\"client\",\"exp\":4_000_000_000u64}),","+        &EncodingKey::from_base64_secret(\"c2VjcmV0\").unwrap(),","+    )","+    .unwrap();","+    decoder","+        .decode::<Value>(&token, &mut Depot::new())","+        .await","+        .is_ok()","+}","+","+#[tokio::test]","+async fn zero_lifetime_uses_the_directly_revalidated_response() {","+    assert!(","+        check(\"no-cache\").await,","+        \"control: direct per-use validation succeeds\"","+    );","+    assert!(","+        check(\"max-age=0, must-revalidate\").await,","+        \"the initiating request may use the validated key\"","+    );","+    assert!(check(\"max-age=0, stale-while-revalidate=0, stale-if-error=0\").await);","+}",""],"additions":105,"deletions":0,"truncated":false}],"additions":262,"deletions":13,"truncated":false,"file_count":6},"error":null,"fetched_at":"2026-11-16T17:24:01.939832+00:00"}