    }"," ","@@ -139,10 +146,27 @@ pub(super) async fn authenticate(","         Ok(resolved)","     }) {","         Ok(resolved) => attach_caller(&mut request, resolved),","-        Err(err) => return err.into_response(),","+        Err(err) => return token_failure_response(err.into_response(), header.as_deref()),","     };","     let mut response = next.run(request).await;","     response.extensions_mut().insert(caller);","+    token_failure_response(response, header.as_deref())","+}","+","+fn token_failure_response(mut response: Response, header: Option<&str>) -> Response {","+    if response.status() == StatusCode::UNAUTHORIZED","+        && response","+            .extensions()","+            .get::<PasswordAuthentication>()","+            .is_none()","+        && response","+            .extensions()","+            .get::<AuthedCaller>()","+            .is_none_or(|caller| matches!(caller.0, Identity::Anonymous))","+        && header.and_then(token_credentials).is_some()","+    {","+        response.extensions_mut().insert(InvalidToken);","+    }","     response"," }"," "],"additions":29,"deletions":5,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/routing.rs","lines":["@@ -1,3 +1,5 @@","+pub(super) mod npm_errors;","+"," pub(super) use super::{","     Action, AppInner, AppState, AuthedCaller, CanonicalPackageName, MAX_PUBLISH_BODY_BYTES,","     MAX_TEAM_BODY_BYTES, RegistrySource, TargetRegistry, authenticate, authorize_package, batch,","@@ -109,7 +111,8 @@ fn finish_router(","         // Inside the trace layer below, so a rejection is still one record.","         .layer(axum::middleware::from_fn_with_state(state.clone(), authenticate))","         .merge(main_listener_metrics_routes(&state));","-    let mut router = apply_request_timeout(router, state.inner.config.http.request_timeout);","+    let mut router = apply_request_timeout(router, state.inner.config.http.request_timeout)","+        .layer(axum::middleware::from_fn(npm_errors::render));","     if !cors_origins.is_empty() {","         router = router.layer(","             CorsLayer::new()","@@ -186,17 +189,25 @@ fn apply_request_timeout(","         move |request: axum::extract::Request, next: axum::middleware::Next| async move {","             match tokio::time::timeout(timeout_duration, next.run(request)).await {","                 Ok(response) => response,","-                Err(_) => (","-                    StatusCode::GATEWAY_TIMEOUT,","-                    [(header::CONTENT_TYPE, \"application/json\")],","-                    r#\"{\"error\":\"request timed out\"}\"#,","-                )","-                    .into_response(),","+                Err(_) => request_timeout_response(),","             }","         },","     ))"," }"," ","+fn request_timeout_response() -> Response {","+    let mut response = (","+        StatusCode::GATEWAY_TIMEOUT,","+        [(header::CONTENT_TYPE, \"application/json\")],","+        r#\"{\"error\":\"request timed out\"}\"#,","+    )","+        .into_response();","+    response","+        .extensions_mut()","+        .insert(pnpr_error::PublicErrorMessage(\"request timed out\".to_string()));","+    response","+}","+"," fn cors_origins(config: &Config) -> pnpr_error::Result<Vec<HeaderValue>> {","     config.http.cors","         .allowed_origins()"],"additions":18,"deletions":7,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/routing/npm_errors.rs","lines":["@@ -0,0 +1,64 @@","+use axum::{","+    Json,","+    body::Body,","+    extract::Request,","+    http::{HeaderValue, Method, StatusCode, header},","+    middleware::Next,","+    response::{IntoResponse, Response},","+};","+use pnpr_error::PublicErrorMessage;","+use serde_json::json;","+","+use super::super::authentication::InvalidToken;","+","+pub(in crate::server) async fn render(request: Request, next: Next) -> Response {","+    if !is_npm_path(request.uri().path()) {","+        return next.run(request).await;","+    }","+    let is_head = request.method() == Method::HEAD;","+    let mut response = next.run(request).await;","+    let invalid_token = response","+        .extensions()","+        .get::<InvalidToken>()","+        .is_some();","+    let message = if invalid_token {","+        \"Invalid authentication token\".to_string()","+    } else if let Some(PublicErrorMessage(message)) = response.extensions_mut().remove() {","+        message","+    } else {","+        return response;","+    };","+    if response.status() == StatusCode::UNAUTHORIZED {","+        let challenge = if invalid_token { r#\"Bearer error=\"invalid_token\"\"# } else { \"Bearer\" };","+        response","+            .headers_mut()","+            .insert(header::WWW_AUTHENTICATE, HeaderValue::from_static(challenge));","+    }","+    let json = json_error(response.status(), &message);","+    response","+        .headers_mut()","+        .insert(header::CONTENT_TYPE, HeaderValue::from_static(\"application/json\"));","+    response.headers_mut().remove(header::CONTENT_LENGTH);","+    *response.body_mut() = if is_head { Body::empty() } else { json.into_body() };","+    response","+}","+","+pub(in crate::server) fn json_error(status: StatusCode, message: &str) -> Response {","+    (status, Json(json!({ \"error\": message, \"reason\": message }))).into_response()","+}","+","+fn is_npm_path(path: &str) -> bool {","+    if path == \"/npm\" || path.starts_with(\"/npm/\") {","+        return true;","+    }","+    let path = path","+        .strip_prefix(\"/~\")","+        .and_then(|tail| tail.split_once('/').map(|(_, path)| path))","+        .unwrap_or(path);","+    let path = path.trim_start_matches('/');","+    path == \"-/whoami\"","+        || path.starts_with(\"-/user/\")","+        || path.starts_with(\"-/npm/\")","+        || path == \"-/v1/login\"","+        || path.starts_with(\"-/v1/login/\")","+}"],"additions":64,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/routing/npm_handlers.rs","lines":["@@ -235,7 +235,12 @@ async fn collect_publish_body("," ) -> Result<axum::body::Bytes, Response> {","     let _permit = state.inner.locks.publish_concurrency.acquire().await;","     axum::body::to_bytes(body, MAX_PUBLISH_BODY_BYTES).await","-        .map_err(|_| StatusCode::PAYLOAD_TOO_LARGE.into_response())","+        .map_err(|_| {","+            super::npm_errors::json_error(","+                StatusCode::PAYLOAD_TOO_LARGE,","+                \"Publish request body exceeds the size limit\",","+            )","+        })"," }"," "," /// `PUT {base}/{pkg}`."],"additions":6,"deletions":1,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/tests.rs","lines":["@@ -1,5 +1,6 @@"," use super::tokens::token_timestamp_millis;"," mod compiler_cache;","+mod npm_errors;"," mod observability;"," mod oidc_groups;"," mod web_ui;"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/tests/npm_errors.rs","lines":["@@ -0,0 +1,182 @@","+use super::{","+    Body, Method, RegistryError, Request, ServiceExt, StatusCode, TempDir, app_with_token, header,","+    record, signed, to_bytes,","+};","+","+#[tokio::test]","+async fn npm_authentication_errors_distinguish_missing_and_invalid_tokens() {","+    let tmp = TempDir::new().unwrap();","+    let app = app_with_token(&tmp, \"valid-token\", record(false, &[]));","+    for path in [\"/-/whoami\", \"/~local/-/whoami\", \"/npm/-/whoami\", \"/npm/~local/-/whoami\"] {","+        for (request, challenge, message) in [","+            (","+                Request::get(path)","+                    .body(Body::empty())","+                    .unwrap(),","+                \"Bearer\",","+                \"Authentication required\",","+            ),","+            (","+                signed(Method::GET, path, \"invalid-token\"),","+                r#\"Bearer error=\"invalid_token\"\"#,","+                \"Invalid authentication token\",","+            ),","+            (","+                signed(Method::GET, path, \"pnpr_workload_not-a-jwt\"),","+                r#\"Bearer error=\"invalid_token\"\"#,","+                \"Invalid authentication token\",","+            ),","+        ] {","+            let response = app","+                .clone()","+                .oneshot(request)","+                .await","+                .unwrap();","+            assert_eq!(response.status(), StatusCode::UNAUTHORIZED, \"{path}\");","+            assert_eq!(response.headers()[header::CONTENT_TYPE], \"application/json\");","+            assert_eq!(response.headers()[header::WWW_AUTHENTICATE], challenge);","+            let body = to_bytes(response.into_body(), usize::MAX).await.unwrap();","+            let body: serde_json::Value = serde_json::from_slice(&body).unwrap();","+            assert_eq!(body[\"error\"], body[\"reason\"]);","+            assert!(","+                body[\"error\"]","+                    .as_str()","+                    .unwrap()","+                    .contains(message),","+            );","+        }","+    }","+}","+","+#[tokio::test]","+async fn npm_errors_keep_status_safe_messages_and_retry_headers() {","+    use axum::{Router, middleware, response::IntoResponse, routing::get};","+    use serde_json::json;","+    use std::time::Duration;","+","+    let app = Router::new()","+        .route(\"/npm/missing\", get(|| async { RegistryError::NotFound }))","+        .route(","+            \"/npm/internal\",","+            get(|| async {","+                RegistryError::Internal { reason: \"private database detail\".to_string() }","+            }),","+        )","+        .route(","+            \"/npm/unpublished\",","+            get(|| async {","+                RegistryError::CannotRepublishUnpublishedVersion {","+                    package: \"example-package\".to_string(),","+                    version: \"1.0.0\".to_string(),","+                }","+            }),","+        )","+        .route(","+            \"/npm/unavailable\",","+            get(|| async {","+                RegistryError::UpstreamUnavailable {","+                    upstream: \"example\".to_string(),","+                    retry_after: Duration::from_millis(1500),","+                }","+                .into_response()","+            }),","+        )","+        .layer(middleware::from_fn(super::super::routing::npm_errors::render));","+    for (path, status, message) in [","+        (\"/npm/missing\", StatusCode::NOT_FOUND, \"Not Found\"),","+        (\"/npm/internal\", StatusCode::INTERNAL_SERVER_ERROR, \"Internal Server Error\"),","+    ] {","+        let response = app","+            .clone()","+            .oneshot(","+                Request::get(path)","+                    .body(Body::empty())","+                    .unwrap(),","+            )","+            .await","+            .unwrap();","+        assert_eq!(response.status(), status);","+        assert_eq!(response.headers()[header::CONTENT_TYPE], \"application/json\");","+        let bytes = to_bytes(response.into_body(), usize::MAX).await.unwrap();","+        assert_eq!(","+            serde_json::from_slice::<serde_json::Value>(&bytes).unwrap(),","+            json!({\"error\": message, \"reason\": message}),","+        );","+    }","+    let response = app","+        .clone()","+        .oneshot(","+            Request::get(\"/npm/unpublished\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(response.status(), StatusCode::FORBIDDEN);","+    let bytes = to_bytes(response.into_body(), usize::MAX).await.unwrap();","+    let body: serde_json::Value = serde_json::from_slice(&bytes).unwrap();","+    assert!(","+        body[\"error\"]","+            .as_str()","+            .unwrap()","+            .contains(\"Cannot republish\"),","+    );","+    assert_eq!(body[\"error\"], body[\"reason\"]);","+    let response = app","+        .oneshot(","+            Request::get(\"/npm/unavailable\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);","+    assert_eq!(response.headers()[header::RETRY_AFTER], \"2\");","+}","+","+#[tokio::test]","+async fn npm_head_errors_have_no_body_and_other_protocols_keep_plain_text() {","+    use axum::{Router, middleware, routing::get};","+    let app = Router::new()","+        .route(\"/npm/missing\", get(|| async { RegistryError::NotFound }))","+        .route(\"/cargo/missing\", get(|| async { RegistryError::NotFound }))","+        .layer(middleware::from_fn(super::super::routing::npm_errors::render));","+    let response = app","+        .clone()","+        .oneshot(","+            Request::head(\"/npm/missing\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(response.status(), StatusCode::NOT_FOUND);","+    assert_eq!(response.headers()[header::CONTENT_TYPE], \"application/json\");","+    assert!(to_bytes(response.into_body(), usize::MAX).await.unwrap().is_empty());","+    let response = app","+        .oneshot(","+            Request::get(\"/cargo/missing\")","+                .body(Body::empty())","+                .unwrap(),","+        )","+        .await","+        .unwrap();","+    assert_eq!(response.status(), StatusCode::NOT_FOUND);","+    assert_eq!(response.headers()[header::CONTENT_TYPE], \"text/plain; charset=utf-8\");","+    assert_eq!(to_bytes(response.into_body(), usize::MAX).await.unwrap().as_ref(), b\"Not Found\");","+}","+","+#[tokio::test]","+async fn oversized_npm_publish_explains_the_body_limit() {","+    let tmp = TempDir::new().unwrap();","+    let app = app_with_token(&tmp, \"valid-token\", record(false, &[]));","+    let mut request = signed(Method::PUT, \"/npm/example-package\", \"valid-token\");","+    *request.body_mut() = Body::from(vec![0; super::super::MAX_PUBLISH_BODY_BYTES + 1]);","+    let response = app.oneshot(request).await.unwrap();","+    assert_eq!(response.status(), StatusCode::PAYLOAD_TOO_LARGE);","+    assert_eq!(response.headers()[header::CONTENT_TYPE], \"application/json\");","+    let bytes = to_bytes(response.into_body(), usize::MAX).await.unwrap();","+    let body: serde_json::Value = serde_json::from_slice(&bytes).unwrap();","+    assert_eq!(body[\"error\"], \"Publish request body exceeds the size limit\");","+    assert_eq!(body[\"error\"], body[\"reason\"]);","+}"],"additions":182,"deletions":0,"truncated":false},{"path":"pnpr/crates/pnpr/src/server/user_accounts.rs","lines":["@@ -28,26 +28,30 @@ pub(crate) async fn put_login("," ) -> Response {","     let name = strip_couchdb_user_prefix(&path.user);","     let ip_address = client_ip.map(|axum::extract::Extension(super::ClientIp(ip))| ip);","-    if let Err(retry_after) = state.inner.identity.login_rate_limiter.check(ip_address, name) {","-        return login_throttled_response(&state, retry_after);","-    }","-    add_user(&state, ip_address, name, &body).await","+    let mut response = match state.inner.identity.login_rate_limiter.check(ip_address, name) {","+        Err(retry_after) => login_throttled_response(&state, retry_after),","+        Ok(()) => add_user(&state, ip_address, name, &body).await,","+    };","+    response.extensions_mut().insert(super::authentication::PasswordAuthentication);","+    response"," }"," "," pub(crate) fn login_throttled_response(state: &AppState, retry_after: u64) -> Response {","     state.inner.metrics.record_login_throttled();","-    (","+    let mut response = super::routing::npm_errors::json_error(","         StatusCode::TOO_MANY_REQUESTS,","-        [","-            (header::CONTENT_TYPE, \"application/json\"),","-            (header::RETRY_AFTER, &retry_after.to_string()),","-        ],","-        json!({","-            \"error\": \"too many failed login attempts, please try again later\"","-        })","-        .to_string(),","-    