ETURN("],"additions":36,"deletions":6,"truncated":false},{"path":"third_party/xla/xla/pjrt/gpu/gpu_helpers.h","lines":["@@ -79,18 +79,34 @@ absl::StatusOr<std::unique_ptr<tsl::BFCAllocator>> GetGpuHostAllocator("," // reserves the cap in VA and extends the mapped prefix without moving it. The"," // initial allocation must fit under the cap, otherwise InvalidArgument is"," // returned. Non-spatial and unified-memory pools use only the start fraction.","+//","+// The allocator is named `<name_prefix>_<device ordinal>_bfc`."," absl::StatusOr<std::shared_ptr<tsl::BFCAllocator>> CreateBFCAllocator(","     se::StreamExecutor* executor, const MemFraction& memory_fraction,","     bool preallocate, std::optional<int64_t> gpu_system_memory_size,","     const std::vector<tsl::SubAllocator::Visitor>& sub_allocator_alloc_visitors,","     const std::vector<tsl::SubAllocator::Visitor>& sub_allocator_free_visitors,","-    bool enable_spatial_partitioning = false);","+    bool enable_spatial_partitioning = false,","+    absl::string_view name_prefix = \"GPU\");"," "," // Builds a BFCAllocator for all local GPUs that uses collective memory."," absl::StatusOr<std::unique_ptr<tsl::BFCAllocator>> CreateCollectiveBFCAllocator(","     se::StreamExecutor* executor, double memory_fraction,","     size_t collective_memory_size);"," ","+// Builds a growing BFCAllocator for temp buffers on a device whose default pool","+// was created with `memory_fraction`, `preallocate` and","+// `gpu_system_memory_size`. Next to a preallocated default pool, the temp pool","+// may use the device memory that the start fraction leaves (MemFractionLeft;","+// like the collective pool, it does not consider `gpu_system_memory_size`), and","+// a default pool that grows can still take from it. Otherwise the temp pool has","+// the default pool's limit. Returns InvalidArgument if the limit is zero.","+absl::StatusOr<std::shared_ptr<tsl::BFCAllocator>> CreateTempBufferBFCAllocator(","+    se::StreamExecutor* executor, const MemFraction& memory_fraction,","+    bool preallocate, std::optional<int64_t> gpu_system_memory_size,","+    const std::vector<tsl::SubAllocator::Visitor>& sub_allocator_alloc_visitors,","+    const std::vector<tsl::SubAllocator::Visitor>& sub_allocator_free_visitors);","+"," // Represents topology of devices."," struct TopologySizes {","   int num_partitions = 0;"],"additions":17,"deletions":1,"truncated":false},{"path":"third_party/xla/xla/pjrt/gpu/gpu_helpers_test.cc","lines":["@@ -166,6 +166,40 @@ TEST_F(BfcMemorySizingTest, EqualEndpointsMatchFixedPolicy) {","   EXPECT_EQ(executor_.reservations_, 0);"," }"," ","+TEST_F(BfcMemorySizingTest, TempBufferPoolGetsWhatAPreallocatedPoolLeaves) {","+  ASSERT_OK_AND_ASSIGN(auto default_pool, Create(FixedMemFraction{0.75}));","+  ASSERT_OK_AND_ASSIGN(auto temp_pool,","+                       CreateTempBufferBFCAllocator(","+                           &executor_, FixedMemFraction{0.75},","+                           /*preallocate=*/true,","+                           /*gpu_system_memory_size=*/std::nullopt, {}, {}));","+  // Together the two pools may use the 64 MiB of device memory once.","+  EXPECT_EQ(default_pool->GetStats()->bytes_limit, 48 * kMiB);","+  EXPECT_EQ(temp_pool->GetStats()->bytes_limit, 16 * kMiB);","+}","+","+TEST_F(BfcMemorySizingTest, TempBufferPoolHasDefaultLimitWithoutPreallocation) {","+  ASSERT_OK_AND_ASSIGN(auto temp_pool,","+                       CreateTempBufferBFCAllocator(","+                           &executor_, FixedMemFraction{0.75},","+                           /*preallocate=*/false,","+                           /*gpu_system_memory_size=*/std::nullopt, {}, {}));","+  EXPECT_EQ(temp_pool->GetStats()->bytes_limit, 48 * kMiB);","+  ASSERT_OK_AND_ASSIGN(","+      temp_pool, CreateTempBufferBFCAllocator(","+                     &executor_, FixedMemFraction{0.75}, /*preallocate=*/false,","+                     /*gpu_system_memory_size=*/8 * kMiB, {}, {}));","+  EXPECT_EQ(temp_pool->GetStats()->bytes_limit, 8 * kMiB);","+}","+","+TEST_F(BfcMemorySizingTest, TempBufferPoolNeedsMemoryLeftByPreallocatedPool) {","+  EXPECT_THAT(CreateTempBufferBFCAllocator(","+                  &executor_, FixedMemFraction{1.0}, /*preallocate=*/true,","+                  /*gpu_system_memory_size=*/std::nullopt, {}, {}),","+              StatusIs(absl::StatusCode::kInvalidArgument,","+                       HasSubstr(\"leaves no device memory\")));","+}","+"," constexpr size_t kPoolLimit = 24 * kMiB;"," "," class GpuBFCAllocatorTest : public ::testing::Test {"],"additions":34,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/pjrt/gpu/se_gpu_pjrt_client.cc","lines":["@@ -1636,12 +1636,11 @@ GetStreamExecutorGpuDeviceAllocator(","   // pool.","   if (!shared_collective_pool) {","     for (const auto& ordinal_and_device : addressable_devices) {","-      ABSL_ASSIGN_OR_RETURN(","-          auto collective_bfc_allocator,","-          CreateCollectiveBFCAllocator(","-              ordinal_and_device.second->executor(),","-              /*memory_fraction=*/1.0 - MemFractionStart(memory_fraction),","-              allocator_config.collective_memory_size));","+      ABSL_ASSIGN_OR_RETURN(auto collective_bfc_allocator,","+                       CreateCollectiveBFCAllocator(","+                           ordinal_and_device.second->executor(),","+                           /*memory_fraction=*/MemFractionLeft(memory_fraction),","+                           allocator_config.collective_memory_size));","       allocators.push_back(","           {std::move(collective_bfc_allocator),","            ordinal_and_device.second->compute_stream(),","@@ -1672,6 +1671,29 @@ GetStreamExecutorGpuDeviceAllocator(","            /*memory_space=*/(int)xla::gpu::MemorySpaceColor::kTempBuffer});","     }","   }","+#elif TENSORFLOW_USE_ROCM","+  if (debug_options.xla_gpu_temp_buffer_use_separate_color()) {","+    // Only temp buffers may use this pool; that keeps their address the same","+    // across executions. Next to a preallocated default pool, its limit is the","+    // device memory the default pool leaves. Without spatial partitioning, the","+    // separate collective pool above gets the same limit (unless","+    // collective_memory_size preallocates it) and both pools take from that","+    // same memory: together they get it once, not once each.","+    for (const auto& ordinal_and_device : addressable_devices) {","+      ABSL_ASSIGN_OR_RETURN(auto temp_bfc_allocator,","+                       CreateTempBufferBFCAllocator(","+                           ordinal_and_device.second->executor(),","+                           memory_fraction, allocator_config.preallocate,","+                           allocator_config.gpu_system_memory_size,","+                           allocator_config.sub_allocator_alloc_visitors,","+                           allocator_config.sub_allocator_free_visitors));","+      allocators.push_back(","+          {std::move(temp_bfc_allocator),","+           ordinal_and_device.second->compute_stream(),","+           /*memory_space=*/","+           static_cast<int>(xla::gpu::MemorySpaceColor::kTempBuffer)});","+    }","+  }"," #endif","   return std::make_unique<se::MultiDeviceAdapter>(platform,","                                                   std::move(allocators));"],"additions":28,"deletions":6,"truncated":false},{"path":"third_party/xla/xla/pjrt/gpu/se_gpu_pjrt_client_test.cc","lines":["@@ -99,6 +99,7 @@ limitations under the License."," #include \"xla/service/gpu/gpu_memory_space_assignment.h\""," #include \"xla/service/gpu_topology.h\""," #include \"xla/service/gpu_topology.pb.h\"","+#include \"xla/service/hlo.pb.h\""," #include \"xla/service/platform_util.h\""," #include \"xla/shape.h\""," #include \"xla/shape_util.h\"","@@ -3571,7 +3572,7 @@ TEST(StreamExecutorGpuClientTest, SharedPoolAnchorsCollectiveMemoryAtLowerEnd) {","       static_cast<int>(gpu::MemorySpaceColor::kCollective);","   constexpr uint64_t kBytes = uint64_t{1} << 20;","   auto address = [](const se::ScopedDeviceAddress<uint8_t>& memory) {","-    return absl::bit_cast<uintptr_t>(memory->opaque());","+    return reinterpret_cast<uintptr_t>(memory->opaque());","   };"," ","   ASSERT_OK_AND_ASSIGN(","@@ -4493,6 +4494,195 @@ TEST_F(VmmTest, CollectiveSpacePlacementKeepsAddressStableAcrossExecutions) {","   }"," }"," ","+// kTempBuffer has its own pool, so default allocations cannot take a freed","+// temp slot.","+TEST(StreamExecutorGpuClientTest, TempBufferColorUsesSeparatePool) {","+  ScopedXlaFlags flags(\"--xla_gpu_temp_buffer_use_separate_color=true\");","+  GpuClientOptions options;","+  options.allocator_config.kind = GpuAllocatorConfig::Kind::kBFC;","+  options.allocator_config.memory_fraction = 0.05;","+  options.allowed_devices = {0};","+  ASSERT_OK_AND_ASSIGN(auto client, GetStreamExecutorGpuClient(options));","+  auto* raw_client = absl::down_cast<PjRtStreamExecutorRawClient*>(","+      absl::down_cast<CommonPjRtClient*>(client.get())->raw_client());","+  auto* allocator =","+      dynamic_cast<se::MultiDeviceAdapter*>(raw_client->allocator());","+  ASSERT_NE(allocator, nullptr);","+  ASSERT_OK_AND_ASSIGN(tsl::Allocator * default_pool,","+                       allocator->GetAllocator(/*device_ordinal=*/0));","+","+  constexpr int kDefault = static_cast<int>(gpu::MemorySpaceColor::kDefault);","+  constexpr int kTemp = static_cast<int>(gpu::MemorySpaceColor::kTempBuffer);","+  constexpr uint64_t kBytes = uint64_t{1} << 20;","+  std::optional<tsl::AllocatorStats> stats = default_pool->GetStats();","+  ASSERT_TRUE(stats.has_value());","+  const int64_t default_bytes_in_use = stats->bytes_in_use;","+","+  ASSERT_OK_AND_ASSIGN(se::ScopedDeviceAddress<uint8_t> temp,","+                       allocator->Allocate(/*device_ordinal=*/0, kBytes,","+                                           /*retry_on_failure=*/false, kTemp));","+  EXPECT_EQ(default_pool->GetStats()->bytes_in_use, default_bytes_in_use);","+  void* const temp_address = temp->opaque();","+  ASSERT_OK(temp.Free());","+","+  ASSERT_OK_AND_ASSIGN(","+      se::ScopedDeviceAddress<uint8_t> other,","+      allocator->Allocate(/*device_ordinal=*/0, kBytes,","+                          /*retry_on_failure=*/false, kDefault));","+  ASSERT_OK_AND_ASSIGN(se::ScopedDeviceAddress<uint8_t> temp_again,","+                       allocator->Allocate(/*device_ordinal=*/0, kBytes,","+                                           /*retry_on_failure=*/false, kTemp));","+  EXPECT_EQ(temp_again->opaque(), temp_address);","+#if TENSORFLOW_USE_ROCM","+  EXPECT_THAT(allocator->Allocate(/*device_ordinal=*/0, uint64_t{1} << 50,","+                                  /*retry_on_failure=*/false, kTemp),","+              StatusIs(absl::StatusCode::kResourceExhausted,","+                       HasSubstr(\"GPU_tempbuffer_0_bfc\")));","+#endif","+}","+","+#if TENSORFLOW_USE_ROCM","+// Like the default pool, the temp pool reports the device memory it allocates","+// and frees to the allocator config's sub-allocator visitors.","+TEST(StreamExecutorGpuClientTest, TempBufferPoolCallsSubAllocatorVisitors) {","+  ScopedXlaFlags flags(\"--xla_gpu_temp_buffer_use_separate_color=true\");","+  absl::Mutex mu;","+  std::vector<se::DeviceAddressBase> allocated;","+  std::vector<void*> freed;","+  GpuClientOptions options;","+  options.allocator_config.kind = GpuAllocatorConfig::Kind::kBFC;","+  options.allocator_config.memory_fraction = 0.05;","+  options.allocator_config.sub_allocator_alloc_visitors.push_back(","+      [&](void* ptr, int, size_t bytes) {","+        absl::MutexLock lock(mu);","+        allocated.emplace_back(ptr, bytes);","+      });","+  options.allocator_config.sub_allocator_free_visitors.push_back(","+      [&](void* ptr, int, size_t) {","+        absl::MutexLock lock(mu);","+        freed.push_back(ptr);","+      });","+  options.allowed_devices = {0};","+","+  void* temp_region = nullptr;","+  {","+    ASSERT_OK_AND_ASSIGN(auto client, GetStreamExecutorGpuClient(options));","+    auto* raw_client = absl::down_cast<PjRtStreamExecutorRawClient*>(","+        absl::down_cast<CommonPjRtClient*>(client.get())->raw_client());","+    auto* allocator =","+        dynamic_cast<se::MultiDeviceAdapter*>(raw_client->allocator());","+    ASSERT_NE(allocator, nullptr);","+    ASSERT_OK_AND_ASSIGN(","+        se::ScopedDeviceAddress<uint8_t> temp,","+        allocator->Allocate(","+            /*device_ordinal=*/0, uint64_t{1} << 20,","+            /*retry_on_failure=*/false,","+            static_cast<int>(gpu::MemorySpaceColor::kTempBuffer)));","+    const uintptr_t address = reinterpret_cast<uintptr_t>(temp->opaque());","+    absl::MutexLock lock(mu);","+    auto region =","+        absl::c_find_if(allocated, [&](const se::DeviceAddressBase& r) {","+          const uintptr_t base = reinterpret_cast<uintptr_t>(r.opaque());","+          return base <= address && address < base + r.size();","+        });","+    ASSERT_NE(region, allocated.end())","+        << \"The temp buffer's region was not reported to the alloc visitor\";","+    temp_region = region->opaque();","+  }","+  // Destroying the client returns the temp pool's region.","+  absl::MutexLock lock(mu);","+  EXPECT_THAT(freed, Contains(temp_region));","+}","+#endif","+","+// Records the address of its first (operand-aliased) result. The second result","+// makes the custom call tuple-shaped.","+absl::Status RecordTempAddressCustomCall(ffi::AnyBuffer,","+                                         ffi::Result<ffi::AnyBuffer> aliased,","+                                         ffi::Result<ffi::AnyBuffer>) {","+  RecordedBufferAddresses().push_back(aliased->untyped_data());","+  return absl::OkStatus();","+}","+","+XLA_FFI_DEFINE_HANDLER(kRecordTempAddressCustomCall,","+                       RecordTempAddressCustomCall,","+                       ffi::Ffi::Bind()","+                           .Arg<ffi::AnyBuffer>()","+                           .Ret<ffi::AnyBuffer>()","+                           .Ret<ffi::AnyBuffer>());","+","+XLA_FFI_REGISTER_HANDLER(ffi::GetXlaFfiApi(), \"RecordTempAddress\", \"CUDA\",","+                         kRecordTempAddressCustomCall);","+","+XLA_FFI_REGISTER_HANDLER(ffi::GetXlaFfiApi(), \"RecordTempAddress\", \"ROCM\",","+                         kRecordTempAddressCustomCall);","+","+// The flag recolours a temp allocation only when a second one is combined into","+// it; cc's tuple index table is that second one. Run i returns 512*1024*i*i.","+constexpr char kTempBufferModule[] = R\"(","+  HloModule temp_buffer_color","+  add {","+    a = f32[] parameter(0)","+    b = f32[] parameter(1)","+    ROOT sum = f32[] add(a, b)","+  }","+  ENTRY e {","+    p0 = f32[512,1024] parameter(0)","+    t = f32[512,1024] multiply(p0, p0)","+    cc = (f32[512,1024], f32[8]) custom-call(t),","+      custom_call_target=\"RecordTempAddress\", api_version=API_VERSION_TYPED_FFI,","+      output_to_operand_aliasing={{0}: (0, {})}","+    s = f32[512,1024] get-tuple-element(cc), index=0","+    zero = f32[] constant(0)","+    ROOT r = f32[] reduce(s, zero), dimensions={0,1}, to_apply=add","+  })\";","+","+TEST(StreamExecutorGpuClientTest, TempBufferColorKeepsTempAddressStable) {","+  ScopedXlaFlags flags(\"--xla_gpu_temp_buffer_use_separate_color=true\");","+  RecordedBufferAddresses().clear();","+  GpuClientOptions options;","+  options.allocator_config.kind = GpuAllocatorConfig::Kind::kBFC;","+  options.allocator_config.memory_fraction = 0.05;","+  options.allowed_devices = {0};","+  ASSERT_OK_AND_ASSIGN(auto client, GetStreamExecutorGpuClient(options));","+  CompileOptions opts;","+  opts.executable_build_options.mutable_debug_options()","+      ->set_xla_gpu_temp_buffer_use_separate_color(true);","+  ASSERT_OK_AND_ASSIGN(auto executable,","+                       CompileExecutable(kTempBufferModule, *client, opts));","+  ASSERT_OK_AND_ASSIGN(auto memory_stats,","+                       executable->GetExecutable()->GetCompiledMemoryStats());","+  BufferAssignmentProto buffer_assignment;","+  ASSERT_TRUE(buffer_assignment.ParseFromString(","+      memory_stats.serialized_buffer_assignment));","+  ASSERT_TRUE(absl::c_any_of(buffer_assignment.buffer_allocations(),","+                             [](const BufferAllocationProto& allocation) {","+                               return allocation.color() ==","+                                      static_cast<int64_t>(","+                                          gpu::MemorySpaceColor::kTempBuffer);","+                             }))","+      << \"No allocation was placed in memory space kTempBuffer\";","+  ASSERT_OK_AND_ASSIGN(","+      auto* mem, client->addressable_devices()[0]->default_memory_space());","+  constexpr int kIters = 3;","+  for (int i = 1; i <= kIters; ++i) {","+    const float v = static_cast<float>(i);","+    Literal input =","+        LiteralUtil::CreateFullWithDescendingLayout<float>({512, 1024}, v);","+    ASSERT_OK_AND_ASSIGN(auto in_buf,","+                         client->BufferFromHostLiteral(input, mem));","+    auto result = executable->Execute({{in_buf.get()}}, {});","+    ASSERT_OK_AND_ASSIGN(auto result_lit, ExtractSingleResult(result));","+    EXPECT_EQ(result_lit->Get<float>({}), 512 * 1024 * v * v)","+        << \"Mismatch on run \" << i;","+  }","+  ASSERT_EQ(RecordedBufferAddresses().size(), kIters);","+  for (int i = 1; i < kIters; ++i) {","+    EXPECT_EQ(RecordedBufferAddresses()[i], RecordedBufferAddresses()[0])","+        << \"Temp address changed on run \" << i + 1;","+  }","+}","+"," #endif  // GOOGLE_CUDA || TENSORFLOW_USE_ROCM"," "," TEST(StreamExecutorGpuClientTest, MemoryRegistrationDisabledByDefault) {",""],"additions":191,"deletions":1,"truncated":false}],"additions":330,"deletions":16,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-13T17:04:08.891962+00:00"}