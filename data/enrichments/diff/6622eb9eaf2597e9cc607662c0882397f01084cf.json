{"id":"6622eb9eaf2597e9cc607662c0882397f01084cf","axis":"silent","repo":"tensorflow/tensorflow","sha":"6622eb9eaf2597e9cc607662c0882397f01084cf","parsed":{"files":[{"path":"third_party/xla/xla/debug_options_flags.cc","lines":["@@ -2513,8 +2513,14 @@ void MakeDebugOptionsFlags(std::vector<tsl::Flag>* flag_list,","           &DebugOptions::set_xla_gpu_temp_buffer_use_separate_color),","       debug_options->xla_gpu_temp_buffer_use_separate_color(),","       \"Enables temp User Buffer Registration. Enable this flag will use a \"","-      \"separate cuda async memory allocator to allocate temp buffer, this will \"","-      \"allocate temp buffer to the fixed address on every iteration\"));","+      \"separate memory allocator (a CUDA async pool on CUDA, a BFC pool on \"","+      \"ROCm) to allocate temp buffer, this will allocate temp buffer to the \"","+      \"fixed address on every iteration. Temp buffers then do not come from \"","+      \"the default pool: next to a preallocated default pool they must fit in \"","+      \"the device memory its memory fraction leaves, which they share with the \"","+      \"collective memory pool unless \"","+      \"--xla_gpu_enable_allocator_spatial_partitioning puts collective memory \"","+      \"in the default pool.\"));"," ","   flag_list->push_back(tsl::Flag(","       \"xla_gpu_temp_buffer_use_collective_color\","],"additions":8,"deletions":2,"truncated":false},{"path":"third_party/xla/xla/pjrt/gpu/BUILD","lines":["@@ -477,6 +477,7 @@ xla_test(","         \"//xla/runtime:device_id\",","         \"//xla/service:gpu_topology\",","         \"//xla/service:gpu_topology_proto_cc\",","+        \"//xla/service:hlo_proto_cc\",","         \"//xla/service:platform_util\",","         \"//xla/service/gpu:gpu_executable_run_options\",","         \"//xla/service/gpu:gpu_memory_space_assignment\","],"additions":1,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/pjrt/gpu/allocator_config.cc","lines":["@@ -15,6 +15,7 @@ limitatio