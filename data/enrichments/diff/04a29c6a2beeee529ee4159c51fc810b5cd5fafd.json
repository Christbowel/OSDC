text"," {","-\tpublic class TestHttpContextDataContext(Uri baseAddress, Func<DataOptions, DataOptions>? optionBuilder = null) : HttpClientDataContext(baseAddress, \"remote/linq2db\", optionBuilder), ITestDataContext","+\tpublic class TestHttpContextDataContext : HttpClientDataContext, ITestDataContext"," \t{","+\t\t// One HttpClient for every test context in the process, so requests reuse pooled","+\t\t// connections instead of each context opening its own and leaving it in TIME_WAIT on","+\t\t// dispose. It has no BaseAddress because test hosts listen on different ports: each","+\t\t// context sends absolute request URIs to its own host.","+\t\tstatic readonly HttpClient _httpClient = new();","+","+\t\tpublic TestHttpContextDataContext(Uri baseAddress, Func<DataOptions, DataOptions>? optionBuilder = null)","+\t\t\t: base(_httpClient, new Uri(baseAddress, \"remote/linq2db\").AbsoluteUri, optionBuilder)","+\t\t{","+\t\t}","+"," \t\tpublic ITable<Person>                 Person                 => this.GetTable<Person>();"," \t\tpublic ITable<ComplexPerson>          ComplexPerson          => this.GetTable<ComplexPerson>();"," \t\tpublic ITable<Patient>                Patient                => this.GetTable<Patient>();"],"additions":13,"deletions":1,"truncated":false},{"path":"Tests/Model/Remote/RemoteHost.cs","lines":["@@ -0,0 +1,10 @@","+﻿namespace Tests.Model.Remote","+{","+\tpublic static class RemoteHost","+\t{","+\t\t// The address every remote test host binds to and every remote test client connects to.","+\t\t// \"localhost\" can resolve to ::1 first, and the IPv6 loopback is slow or unrouted on some","+\t\t// hosts (WSL with Docker in particular); the free-port probe also checks IPv4 only.","+\t\tpublic const string Loopback = \"127.0.0.1\";","+\t}","+}"],"additions":10,"deletions":0,"truncated":false},{"path":"Tests/Model/Remote/SignalR/TestSignalRDataContext.cs","lines":["@@ -1,14 +1,272 @@"," ﻿using System;","+using System.Collections.Generic;","+using System.Threading;","+using System.Threading.Tasks;"," "," using LinqToDB;","+using LinqToDB.Remote;"," using LinqToDB.Remote.SignalR;"," "," using Microsoft.AspNetCore.SignalR.Client;"," "," namespace Tests.Model.Remote.SignalR"," {","-\tpublic class TestSignalRDataContext(HubConnection hubConnection, Func<DataOptions, DataOptions>? optionBuilder = null) : SignalRDataContext(hubConnection, optionBuilder), ITestDataContext","+\tpublic class TestSignalRDataContext : SignalRDataContext, ITestDataContext"," \t{","+\t\t// Started hub connections not leased by any context, per hub URL. Contexts alive at the same time get","+\t\t// separate connections: the test hub runs one invocation per connection at a time.","+\t\tstatic readonly Dictionary<string, Stack<PooledHubConnection>> _idleConnections = new(StringComparer.Ordinal);","+\t\tstatic readonly Lock                                           _idleConnectionsLock = new();","+","+\t\t// Idle connections kept per URL; more than this only exist while that many contexts are alive.","+\t\tconst int MaxIdleConnectionsPerUrl = 32;","+","+\t\treadonly Lease _lease;","+","+\t\tpublic TestSignalRDataContext(string hubUrl, Func<DataOptions, DataOptions>? optionBuilder = null)","+\t\t\t: this(new Lease(hubUrl, RentConnection(hubUrl)), optionBuilder)","+\t\t{","+\t\t}","+","+\t\tTestSignalRDataContext(Lease lease, Func<DataOptions, DataOptions>? optionBuilder)","+\t\t\t: base(lease.Connection.Client, optionBuilder)","+\t\t{","+\t\t\t_lease = lease;","+\t\t}","+","+\t\t/// <summary>","+\t\t/// The client this context runs its queries through. It stops working when the context is disposed.","+\t\t/// </summary>","+\t\tpublic ILinqService LeasedClient => _lease;","+","+\t\t/// <summary>","+\t\t/// The pooled hub connection this context leased.","+\t\t/// </summary>","+\t\tpublic HubConnection HubConnection => _lease.Connection.Connection;","+","+\t\tprotected override ILinqService GetClient()","+\t\t{","+\t\t\treturn _lease;","+\t\t}","+","+\t\tpublic override void Dispose()","+\t\t{","+\t\t\ttry","+\t\t\t{","+\t\t\t\tbase.Dispose();","+\t\t\t}","+\t\t\tfinally","+\t\t\t{","+\t\t\t\t_lease.Return();","+\t\t\t}","+\t\t}","+","+\t\tpublic override async ValueTask DisposeAsync()","+\t\t{","+\t\t\ttry","+\t\t\t{","+\t\t\t\tawait base.DisposeAsync().ConfigureAwait(false);","+\t\t\t}","+\t\t\tfinally","+\t\t\t{","+\t\t\t\t_lease.Return();","+\t\t\t}","+\t\t}","+","+\t\tstatic PooledHubConnection RentConnection(string hubUrl)","+\t\t{","+\t\t\twhile (true)","+\t\t\t{","+\t\t\t\tPooledHubConnection? connection = null;","+","+\t\t\t\tlock (_idleConnectionsLock)","+\t\t\t\t{","+\t\t\t\t\tif (_idleConnections.TryGetValue(hubUrl, out var idle) && idle.Count > 0)","+\t\t\t\t\t\tconnection = idle.Pop();","+\t\t\t\t}","+","+\t\t\t\tif (connection == null)","+\t\t\t\t\treturn PooledHubConnection.Start(hubUrl);","+","+\t\t\t\t// It may have dropped while idle; a dropped connection would fail the test that gets it.","+\t\t\t\tif (connection.IsConnected)","+\t\t\t\t\treturn connection;","+","+\t\t\t\tconnection.Dispose();","+\t\t\t}","+\t\t}","+","+\t\tstatic void ReturnConnection(string hubUrl, PooledHubConnection connection)","+\t\t{","+\t\t\tif (connection.IsConnected)","+\t\t\t{","+\t\t\t\tlock (_idleConnectionsLock)","+\t\t\t\t{","+\t\t\t\t\tif (!_idleConnections.TryGetValue(hubUrl, out var idle))","+\t\t\t\t\t\t_idleConnections.Add(hubUrl, idle = new Stack<PooledHubConnection>());","+","+\t\t\t\t\tif (idle.Count < MaxIdleConnectionsPerUrl)","+\t\t\t\t\t{","+\t\t\t\t\t\tidle.Push(connection);","+\t\t\t\t\t\treturn;","+\t\t\t\t\t}","+\t\t\t\t}","+\t\t\t}","+","+\t\t\tconnection.Dispose();","+\t\t}","+","+\t\t// One context's use of a pooled connection. A call after Return is refused, and the connection is","+\t\t// pooled again only if no call is running and none was cancelled or failed: the hub keeps running a","+\t\t// cancelled invocation and runs one invocation per connection at a time.","+\t\tsealed class Lease(string hubUrl, PooledHubConnection connection) : ILinqService","+\t\t{","+\t\t\treadonly Lock _lock = new();","+","+\t\t\tint  _running;","+\t\t\tbool _interrupted;","+\t\t\tbool _returned;","+","+\t\t\tpublic PooledHubConnection Connection { get; } = connection;","+","+\t\t\tpublic void Return()","+\t\t\t{","+\t\t\t\tbool reusable;","+","+\t\t\t\tlock (_lock)","+\t\t\t\t{","+\t\t\t\t\tif (_returned)","+\t\t\t\t\t\treturn;","+","+\t\t\t\t\t_returned = true;","+\t\t\t\t\treusable  = _running == 0 && !_interrupted;","+\t\t\t\t}","+","+\t\t\t\tif (reusable)","+\t\t\t\t\tReturnConnection(hubUrl, Connection);","+\t\t\t\telse","+\t\t\t\t\tConnection.Dispose();","+\t\t\t}","+","+\t\t\tasync Task<T> RunAsync<T>(Func<ILinqService, Task<T>> invoke)","+\t\t\t{","+\t\t\t\tlock (_lock)","+\t\t\t\t{","+\t\t\t\t\tObjectDisposedException.ThrowIf(_returned, typeof(TestSignalRDataContext));","+","+\t\t\t\t\t_running++;","+\t\t\t\t}","+","+\t\t\t\ttry","+\t\t\t\t{","+\t\t\t\t\treturn await invoke(Connection.Client).ConfigureAwait(false);","+\t\t\t\t}","+\t\t\t\tcatch","+\t\t\t\t{","+\t\t\t\t\tlock (_lock)","+\t\t\t\t\t\t_interrupted = true;","+","+\t\t\t\t\tthrow;","+\t\t\t\t}","+\t\t\t\tfinally","+\t\t\t\t{","+\t\t\t\t\tlock (_lock)","+\t\t\t\t\t\t_running--;","+\t\t\t\t}","+\t\t\t}","+","+\t\t\tTask<LinqServiceInfo> ILinqService.GetInfoAsync(string? configuration, CancellationToken cancellationToken)","+\t\t\t{","+\t\t\t\treturn RunAsync(c => c.GetInfoAsync(configuration, cancellationToken));","+\t\t\t}","+","+\t\t\tTask<int> ILinqService.ExecuteNonQueryAsync(string? configuration, string queryData, CancellationToken cancellationToken)","+\t\t\t{","+\t\t\t\treturn RunAsync(c => c.ExecuteNonQueryAsync(configuration, queryData, cancellationToken));","+\t\t\t}","+","+\t\t\tTask<string?> ILinqService.ExecuteScalarAsync(string? configuration, string queryData, CancellationToken cancellationToken)","+\t\t\t{","+\t\t\t\treturn RunAsync(c => c.ExecuteScalarAsync(configuration, queryData, cancellationToken));","+\t\t\t}","+","+\t\t\tTask<string> ILinqService.ExecuteReaderAsync(string? configuration, string queryData, CancellationToken cancellationToken)","+\t\t\t{","+\t\t\t\treturn RunAsync(c => c.ExecuteReaderAsync(configuration, queryData, cancellationToken));","+\t\t\t}","+","+\t\t\tTask<int> ILinqService.ExecuteBatchAsync(string? configuration, string queryData, CancellationToken cancellationToken)","+\t\t\t{","+\t\t\t\treturn RunAsync(c => c.ExecuteBatchAsync(configuration, queryData, cancellationToken));","+\t\t\t}","+","+\t\t\tstring? ILinqService.RemoteClientTag","+\t\t\t{","+\t\t\t\tget => ((ILinqService)Connection.Client).RemoteClientTag;","+\t\t\t\tset => ((ILinqService)Connection.Client).RemoteClientTag = value;","+\t\t\t}","+\t\t}","+","+\t\tsealed class PooledHubConnection : IDisposable","+\t\t{","+\t\t\tvolatile bool _closed;","+","+\t\t\tPooledHubConnection(HubConnection connection)","+\t\t\t{","+\t\t\t\tConnection         = connection;","+\t\t\t\tClient             = new SignalRLinqServiceClient(connection);","+\t\t\t\tConnection.Closed += _ =>","+\t\t\t\t{","+\t\t\t\t\t_closed = true;","+\t\t\t\t\treturn Task.CompletedTask;","+\t\t\t\t};","+\t\t\t}","+","+\t\t\tpublic HubConnection            Connection { get; }","+\t\t\tpublic SignalRLinqServiceClient Client     { get; }","+","+\t\t\t// Without automatic reconnect a connection that drops stays down. It reports Disconnected","+\t\t\t// before it raises Closed, so check both where the client has State. The net462 client has","+\t\t\t// no State, so a connection that dropped but has not raised Closed yet can still be handed","+\t\t\t// out there; only the test using it fails, and it is not pooled again after that failure.","+#if NETFRAMEWORK","+\t\t\tpublic bool IsConnected => !_closed;","+#else","+\t\t\tpublic bool IsConnected => !_closed && Connection.State == HubConnectionState.Connected;","+#endif","+","+\t\t\tpublic static PooledHubConnection Start(string hubUrl)","+\t\t\t{","+\t\t\t\tvar connection = new PooledHubConnection(new HubConnectionBuilder().WithUrl(hubUrl).Build());","+","+\t\t\t\ttry","+\t\t\t\t{","+\t\t\t\t\tconnection.Connection.StartAsync().GetAwaiter().GetResult();","+\t\t\t\t}","+\t\t\t\tcatch","+\t\t\t\t{","+\t\t\t\t\tconnection.Dispose();","+\t\t\t\t\tthrow;","+\t\t\t\t}","+","+\t\t\t\treturn connection;","+\t\t\t}","+","+\t\t\tpublic void Dispose()","+\t\t\t{","+\t\t\t\tTask.Run(DisposeConnectionAsync).GetAwaiter().GetResult();","+\t\t\t}","+","+\t\t\t// DisposeAsync returns Task on net462 and ValueTask on net8.0+, so awaiting it is the one form","+\t\t\t// that compiles on both; MA0215 fires on net462 only, where returning the task would compile.","+#pragma warning disable MA0215 // Return the task instead of awaiting it","+\t\t\tasync Task DisposeConnectionAsync()","+\t\t\t{","+\t\t\t\tawait Connection.DisposeAsync().ConfigureAwait(false);","+\t\t\t}","+#pragma warning restore MA0215","+\t\t}","+"," \t\tpublic ITable<Person>                 Person                 => this.GetTable<Person>();"," \t\tpublic ITable<ComplexPerson>          ComplexPerson          => this.GetTable<ComplexPerson>();"," \t\tpublic ITable<Patient>                Patient                => this.GetTable<Patient>();"],"additions":259,"deletions":1,"truncated":false},{"path":"Tests/Model/Remote/WCF/TestWcfDataContext.cs","lines":["@@ -1,18 +1,43 @@"," ﻿#if NETFRAMEWORK"," using System;","+using System.Collections.Generic;"," using System.Globalization;"," using System.ServiceModel;","+using System.Threading;"," using System.Threading.Tasks;"," "," using LinqToDB;","+using LinqToDB.Remote;"," using LinqToDB.Remote.Wcf;"," "," namespace Tests.Model.Remote.Wcf"," {"," \tpublic class TestWcfDataContext : WcfDataContext, ITestDataContext"," \t{","-\t\tpublic TestWcfDataContext(int port, Func<DataOptions,DataOptions>? optionBuilder = null) : base(","-\t\t\tnew NetTcpBinding(SecurityMode.None)","+\t\tstatic readonly NetTcpBinding _binding = CreateBinding();","+","+\t\t// One channel factory per endpoint, shared by every test context targeting it. The library's","+\t\t// client builds a new ChannelFactory, and with it a new TCP connection, for every query; a","+\t\t// shared factory keeps its connections pooled, and a query only opens and closes a channel.","+\t\tstatic readonly Dictionary<string, ChannelFactory<IWcfLinqService>> _channelFactories = new(StringComparer.Ordinal);","+\t\tstatic readonly Lock                                                _channelFactoriesLock = new();","+","+\t\treadonly EndpointAddress _endpointAddress;","+","+\t\tpublic TestWcfDataContext(int port, Func<DataOptions,DataOptions>? optionBuilder = null)","+\t\t\t: this(new EndpointAddress(string.Create(CultureInfo.InvariantCulture, $\"net.tcp://{RemoteHost.Loopback}:{port}/LinqOverWcf\")), optionBuilder)","+\t\t{","+\t\t}","+","+\t\tTestWcfDataContext(EndpointAddress endpointAddress, Func<DataOptions,DataOptions>? optionBuilder)","+\t\t\t: base(_binding, endpointAddress, optionBuilder)","+\t\t{","+\t\t\t_endpointAddress = endpointAddress;","+\t\t}","+","+\t\tstatic NetTcpBinding CreateBinding()","+\t\t{","+\t\t\tvar binding = new NetTcpBinding(SecurityMode.None)"," \t\t\t{"," \t\t\t\tMaxReceivedMessageSize = 10000000,"," \t\t\t\tMaxBufferPoolSize      = 10000000,","@@ -21,11 +46,105 @@ public TestWcfDataContext(int port, Func<DataOptions,DataOptions>? optionBuilder"," \t\t\t\tOpenTimeout            = new TimeSpan(00, 01, 00),"," \t\t\t\tReceiveTimeout         = new TimeSpan(00, 10, 00),"," \t\t\t\tSendTimeout            = new TimeSpan(00, 10, 00),","-\t\t\t},","-\t\t\tnew EndpointAddress(string.Create(CultureInfo.InvariantCulture, $\"net.tcp://localhost:{port}/LinqOverWcf\")),","-\t\t\toptionBuilder)","+\t\t\t};","+","+\t\t\tbinding.ReaderQuotas.MaxStringContentLength = 1000000;","+","+\t\t\treturn binding;","+\t\t}","+","+\t\tprotected override ILinqService GetClient()","+\t\t{","+\t\t\treturn new SharedFactoryLinqServiceClient(GetChannelF