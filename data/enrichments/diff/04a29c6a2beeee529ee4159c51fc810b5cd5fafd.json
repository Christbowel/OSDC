n throws the same type; only the lease's refusal names the context","+\t\t\tAssert.That(ex?.ObjectName, Does.Contain(nameof(TestSignalRDataContext)));","+\t\t}","+","+\t\t[Test]","+\t\tpublic async Task SignalRTestContextReusesConnectionAfterCleanDispose([IncludeDataSources(true, TestProvName.AllSQLite)] string context)","+\t\t{","+\t\t\tif (!context.IsRemote()) Assert.Ignore(\"Skip non-remote context\");","+","+\t\t\tHubConnection connection;","+","+\t\t\tawait using (var db = (TestSignalRDataContext)GetDataContext(context, transport: RemoteTransport.SignalR))","+\t\t\t{","+\t\t\t\tconnection = db.HubConnection;","+","+\t\t\t\t_ = await db.LeasedClient.GetInfoAsync(db.ConfigurationString);","+\t\t\t}","+","+\t\t\tawait using (var db = (TestSignalRDataContext)GetDataContext(context, transport: RemoteTransport.SignalR))","+\t\t\t{","+\t\t\t\tAssert.That(db.HubConnection, Is.SameAs(connection));","+\t\t\t}","+\t\t}","+","+\t\t[Test]","+\t\tpublic async Task SignalRTestContextDiscardsConnectionAfterFailedCall([IncludeDataSources(true, TestProvName.AllSQLite)] string context)","+\t\t{","+\t\t\tif (!context.IsRemote()) Assert.Ignore(\"Skip non-remote context\");","+","+\t\t\tHubConnection connection;","+","+\t\t\tusing (var db = (TestSignalRDataContext)GetDataContext(context, transport: RemoteTransport.SignalR))","+\t\t\t{","+\t\t\t\tconnection = db.HubConnection;","+","+\t\t\t\tAssert.CatchAsync(() => db.LeasedClient.ExecuteNonQueryAsync(db.ConfigurationString, \"not a query\"));","+\t\t\t}","+","+\t\t\tusing (var db = (TestSignalRDataContext)GetDataContext(context, transport: RemoteTransport.SignalR))","+\t\t\t{","+\t\t\t\tAssert.That(db.HubConnection, Is.Not.SameAs(connection));","+\t\t\t}","+","+\t\t\tAssert.ThrowsAsync<ObjectDisposedException>(() => connection.StartAsync());","+\t\t}","+"," \t\t// The other constructor takes a client the caller built, so the connection inside it stays the"," \t\t// caller's: disposing the context must not touch it."," \t\t[Test]"],"