 callback(.success([\"status\": \"cancelled\"]))","+    finish(with: .success([\"status\": \"cancelled\"]))","+  }","+","+  // The session can report more than one result, but only the first one settles the call.","+  private func finish(with result: Result<[String: String], Error>) {","+    continuation?.resume(with: result)","+    continuation = nil","   }"," }"," "],"additions":21,"deletions":21,"truncated":false},{"path":"packages/expo-mail-composer/ios/Tests/MailComposerModuleTests.swift","lines":["@@ -0,0 +1,59 @@","+// Copyright 2026-present 650 Industries. All rights reserved.","+","+import ExpoModulesTestCore","+import MessageUI","+import Testing","+","+@testable import ExpoMailComposer","+@testable import ExpoModulesCore","+","+@Suite(\"MailComposerModule\")","+@JavaScriptActor","+struct MailComposerModuleTests {","+  let appContext: AppContext","+  let runtime: ExpoRuntime","+","+  init() throws {","+    appContext = TestAppContext()","+    runtime = try appContext.runtime","+    appContext.moduleRegistry.register(module: MailComposerModule(appContext: appContext), name: nil)","+  }","+","+  @Test","+  func `isAvailableAsync resolves to whether the device can send mail`() async throws {","+    let isAvailable = try await runtime.execute {","+      try await runtime.evalAsync(\"expo.modules.ExpoMailComposer.isAvailableAsync()\").asBool()","+    }","+    #expect(isAvailable == MFMailComposeViewController.canSendMail())","+  }","+","+  @Test(.enabled(if: !MFMailComposeViewController.canSendMail()))","+  func `composeAsync rejects when the device can't send mail`() async throws {","+    let code = try await runtime.execute {","+      try await runtime.evalAsync(","+        \"\"\"","+        expo.modules.ExpoMailComposer.composeAsync({ subject: 'Hello' })","+          .then(() => 'resolved', error => String(error.code))","+        \"\"\"","+      ).asString()","+    }","+    #expect(code == CannotSendMailException().code)","+  }","+","+  @Test","+  func `getClients returns the mail clients with a label and a URL`() async throws {","+    let isValid = try await runtime.execute {","+      try runtime.eval(","+        \"\"\"","+        (() => {","+          const clients = expo.modules.ExpoMailComposer.getClients();","+          return Array.isArray(clients) && clients.every(","+            (client) => typeof client.label === 'string' && typeof client.url === 'string'","+          );","+        })()","+        \"\"\"","+      ).asBool()","+    }","+    #expect(isValid)","+  }","+}",""],"additions":59,"deletions":0,"truncated":false}],"additions":134,"deletions":75,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-11-23T19:31:18.310538+00:00"}