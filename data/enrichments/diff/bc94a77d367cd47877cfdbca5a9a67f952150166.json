ltTask {","+","+    @Inject","+    public CacheDockerImages() {","+        onlyIf(\"There are images to cache\", t -> getImages().get().isEmpty() == false);","+        onlyIf(\"Docker is available\", t -> getDockerSupport().get().getDockerAvailability().isAvailable());","+    }","+","+    /** Images to cache. */","+    @Input","+    public abstract SetProperty<String> getImages();","+","+    /** Docker platform to cache the images for, e.g. {@code linux/amd64}. */","+    @Input","+    public abstract Property<String> getPlatform();","+","+    @ServiceReference(DockerSupportPlugin.DOCKER_SUPPORT_SERVICE_NAME)","+    public abstract Property<DockerSupportService> getDockerSupport();","+","+    @Inject","+    public abstract ExecOperations getExecOperations();","+","+    @TaskAction","+    public void cacheImages() {","+        String docker = getDockerSupport().get().getResolvedDockerExecutable();","+        String platform = getPlatform().get();","+        for (String image : getImages().get()) {","+            getLogger().lifecycle(\"Caching Docker image {} for platform {}\", image, platform);","+            try {","+                DockerImagePullSupport.ensureImageAvailable(getExecOperations(), docker, image, platform);","+            } catch (RuntimeException e) {","+                // Caching is a best-effort bake-time optimization: pre-pulling images so CI agents avoid the registry","+                // at job time. Not every base image is published for every architecture. For example the OIDC fixture","+                // declares the amd64-only c2id/c2id-server-demo base, which its Dockerfile pins to amd64 even though","+                // the final image is multi-arch; on an aarch64 agent that base simply cannot be pulled for the host","+                // platform. Such a failure must not break agent baking (resolveAllDependencies): the real build pulls","+                // with its own retries at job time and resolves per-stage platforms correctly. Warn and move on so the","+                // remaining images are still cached.","+                getLogger().warn(\"Skipping caching of Docker image {} for platform {}: {}\", image, platform, e.getMessage());","+            }","+        }","+    }","+}"],"additions":69,"deletions":0,"truncated":false},{"path":"build-tools-internal/src/main/java/org/elasticsearch/gradle/internal/docker/DockerBuildTask.java","lines":["@@ -15,8 +15,6 @@"," import org.gradle.api.file.DirectoryProperty;"," import org.gradle.api.file.ProjectLayout;"," import org.gradle.api.file.RegularFileProperty;","-import org.gradle.api.logging.Logger;","-import org.gradle.api.logging.Logging;"," import org.gradle.api.model.ObjectFactory;"," import org.gradle.api.provider.ListProperty;"," import org.gradle.api.provider.MapProperty;","@@ -38,13 +36,16 @@"," import org.gradle.workers.WorkerExecutor;"," "," import java.io.ByteArrayOutputStream;","+import java.io.File;"," import java.io.IOException;"," import java.io.UncheckedIOException;"," import java.nio.file.Files;"," import java.nio.file.Path;"," import java.util.Arrays;"," import java.util.Collections;","+import java.util.LinkedHashSet;"," import java.util.List;","+import java.util.Set;"," import java.util.regex.Matcher;"," import java.util.regex.Pattern;"," import java.util.stream.Collectors;","@@ -56,7 +57,7 @@","  * mechanism that can retry, and emitting the image SHA as a task output.","  */"," public abstract class DockerBuildTask extends DefaultTask {","-    private static final Logger LOGGER = Logging.getLogger(DockerBuildTask.class);","+    private static final int MAX_PULL_ATTEMPTS = 10;"," ","     private final WorkerExecutor workerExecutor;","     private final RegularFileProperty markerFile;","@@ -207,50 +208,48 @@ public DockerBuildAction(ExecOperations execOperations) {","         /**","          * Wraps `docker pull` in a retry loop, to try and provide some resilience against","          * transient errors","-         * @param baseImage the image to pull.","+         * @param image the image to pull.","          */","-        private void pullBaseImage(String baseImage) {","-            final int maxAttempts = 10;","-            String docker = getParameters().getDockerExecutable().get();","+        private void pullImage(String image) {","+            DockerImagePullSupport.pullImage(execOperations, getParameters().getDockerExecutable().get(), image, null, MAX_PULL_ATTEMPTS);","+        }"," ","-            for (int attempt = 1; attempt <= maxAttempts; attempt++) {","-                try {","-                    LoggedExec.exec(execOperations, spec -> {","-                        maybeConfigureDockerConfig(spec);","-                        spec.executable(docker);","-                        spec.args(\"pull\");","-                        spec.environment(\"DOCKER_BUILDKIT\", \"1\");","-                        spec.args(baseImage);","-                    });","-","-                    return;","-                } catch (Exception e) {","-                    LOGGER.warn(\"Attempt {}/{} to pull Docker base image {} failed\", attempt, maxAttempts, baseImage);","-                }","+        /**","+         * Base images pinned by digest are immutable, so an image that is already present locally (e.g. pre-cached on CI","+         * agents at image bake time, see {@link DockerImageCachePlugin}) is reused. Other base images (e.g. moving","+         * {@code latest} tags) are always pulled to pick up updates. Cross-platform builds use buildx, which resolves","+         * digest-pinned base images itself, so these are not pulled into the daemon.","+         */","+        private void pullBaseImage(String baseImage, boolean isCrossPlatform) {","+            if (DockerImagePullSupport.isDigestPinned(baseImage) == false) {","+                pullImage(baseImage);","+            } else if (isCrossPlatform == false) {","+                DockerImagePullSupport.ensureImageAvailable(execOperations, getParameters().getDockerExecutable().get(), baseImage, null);","             }","-","-            // If we successfully ran `docker pull` above, we would have returned before this point.","-            throw new GradleException(\"Failed to pull Docker base image [\" + baseImage + \"], all attempts failed\");","         }"," ","         private void maybeConfigureDockerConfig(ExecSpec spec) {","-            String dockerConfig = System.getenv(\"DOCKER_CONFIG\");","-            if (dockerConfig != null) {","-                spec.environment(\"DOCKER_CONFIG\", dockerConfig);","-            }","+            DockerImagePullSupport.maybeConfigureDockerConfig(spec);","         }"," ","         @Override","         public void execute() {","             final Parameters parameters = getParameters();"," ","-            if (parameters.getPull().get()) {","-                parameters.getBaseImages().get().forEach(this::pullBaseImage);","-            }","-","             final List<String> tags = parameters.getTags().get();","             final boolean isCrossPlatform = isCrossPlatform();"," ","+            if (parameters.getPull().get()) {","+                // Besides explicitly declared base images, also make sure digest-pinned images referenced in the","+                // Dockerfile are available, so `docker build` does not pull them implicitly without any retries.","+                Set<String> baseImages = new LinkedHashSet<>(parameters.getBaseImages().get());","+                File dockerfile = new File(parameters.getDockerContext().get().getAsFile(), \"Dockerfile\");","+                if (dockerfile.isFile()) {","+                    baseImages.addAll(DockerImagePullSupport.digestPinnedBaseImages(dockerfile));","+                }","+                baseImages.forEach(baseImage -> pullBaseImage(baseImage, isCrossPlatform));","+            }","+","             LoggedExec.exec(execOperations, spec -> {","                 maybeConfigureDockerConfig(spec);"," ","@@ -315,7 +314,7 @@ public void execute() {","                 // multi-platform image builds do not end up in local registry, so we need to pull the just build image","                 // first to get the checksum and also serves as a test for the image being pushed correctly","                 if (parameters.getPlatforms().get().size() > 1 && parameters.getPush().getOrElse(false)) {","-                    pullBaseImage(tags.get(0));","+                    pullImage(tags.get(0));","                 }","                 final String checksum = getImageChecksum(tags.get(0));","                 Files.writeString(parameters.getMarkerFile().getAsFile().get().toPath(), checksum + \"\\n\");"],"additions":32,"deletions":33,"truncated":false},{"path":"build-tools-internal/src/main/java/org/elasticsearch/gradle/internal/docker/DockerImageCachePlugin.java","lines":["@@ -0,0 +1,101 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the \"Elastic License","+ * 2.0\", the \"GNU Affero General Public License v3.0 only\", and the \"Server Side","+ * Public License v 1\"; you may not use this file except in compliance with, at","+ * your election, the \"Elastic License 2.0\", the \"GNU Affero General Public","+ * License v3.0 only\", or the \"Server Side Public License, v 1\".","+ */","+","+package org.elasticsearch.gradle.internal.docker;","+","+import org.elasticsearch.gradle.Architecture;","+import org.elasticsearch.gradle.VersionProperties;","+import org.elasticsearch.gradle.internal.ResolveAllDependencies;","+import org.gradle.api.Plugin;","+import org.gradle.api.Project;","+import org.gradle.api.artifacts.Dependency;","+import org.gradle.api.artifacts.dsl.DependencyHandler;","+import org.gradle.api.plugins.JavaPlugin;","+import org.gradle.api.plugins.JavaPluginExtension;","+import org.gradle.api.tasks.SourceSet;","+","+import java.util.Arrays;","+import java.util.LinkedHashSet;","+import java.util.Set;","+","+/**","+ * Pulls Docker images required by a project's build and tests as part of {@code resolveAllDependencies}, which is run","+ * when baking CI agent images (see {@code .buildkite/packer_cache.sh}). This avoids pulling them from remote registries","+ * at job time. Covers:","+ * <ul>","+ *     <li>images of {@code CacheableTestFixture} implementations (test containers) in this project</li>","+ *     <li>the builder images used by this project's {@link NativeImageBuildTask}s</li>","+ *     <li>the base images declared by this project's {@link DockerBuildTask}s</li>","+ * </ul>","+ */","+public class DockerImageCachePlugin implements Plugin<Project> {","+","+    public static final String CACHE_TEST_FIXTURES = \"cacheTestFixtures\";","+    public static final String CACHE_DOCKER_IMAGES = \"cacheDockerImages\";","+","+    @Override","+    public void apply(Project project) {","+        configureTestFixtureCaching(project);","+        configureDockerImageCaching(project);","+    }","+","+    private static void configureTestFixtureCaching(Project project) {","+        var cacheTestFixturesConfiguration = project.getConfigurations().create(CACHE_TEST_FIXTURES);","+        cacheTestFixturesConfiguration.defaultDependencies(deps -> {","+            DependencyHandler dependencyHandler = project.getDependencies();","+            Dependency reflections = dependencyHandler.create(","+                \"org.reflections:reflections:\" + VersionProperties.getVersions().get(\"reflections\")","+            );","+            deps.add(reflections);","+        });","+","+        project.getPlugins().withType(JavaPlugin.class, javaPlugin -> {","+            var cacheTestFixtures = project.getTasks().register(CACHE_TEST_FIXTURES, CacheCacheableTestFixtures.class, (t) -> {","+                // Test fixtures live in the main source set of fixture projects. Using the main rather than the test","+                // runtime classpath avoids compiling test code (and e.g. the test framework) when baking agent images.","+                var mainSourceSet = project.getExtensions()","+                    .getByType(JavaPluginExtension.class)","+                    .getSourceSets()","+                    .getByName(SourceSet.MAIN_SOURCE_SET_NAME);","+                t.getClasspath().from(cacheTestFixturesConfiguration);","+                t.getClasspath().from(mainSourceSet.getRuntimeClasspath());","+            });","+            project.getTasks().withType(ResolveAllDependencies.class).configureEach(r -> r.dependsOn(cacheTestFixtures));","+        });","+    }","+","+    /**","+     * Only images for the host architecture are cached: CI agents only build images for their own architecture (cross","+     * architecture builds use buildx, which has its own image store), and the Docker image store holds a single platform","+     * variant per tag.","+     */","+    private static void configureDockerImageCaching(Project project) {","+        project.getPluginManager().apply(DockerSupportPlugin.class);","+        String hostPlatform = Architecture.current().dockerPlatform;","+        var cacheDockerImages = project.getTasks().register(CACHE_DOCKER_IMAGES, CacheDockerImages.class, t -> {","+            t.setDescription(\"Pulls the Docker base and builder images used by this project for the host architecture\");","+            t.getPlatform().set(hostPlatform);","+            t.getImages().set(project.provider(() -> {","+                Set<String> images = new LinkedHashSet<>();","+                project.getTasks().withType(NativeImageBuildTask.class).forEach(n -> {","+                    if (hostPlatform.equals(n.getPlatform().getOrNull()) && n.getImageTag().isPresent()) {","+                        images.add(n.getImageTag().get());","+                    }","+                });","+                project.getTasks().withType(DockerBuildTask.class).forEach(d -> {","+                    if (d.isPull() && d.getBaseImages() != null && d.getPlatforms().getOrElse(Set.of()).contains(hostPlatform)) {","+                        images.addAll(Arrays.asList(d.getBaseImages()));","+                    }","+                });","+                return images;","+            }));","+        });","+        project.getTasks().withType(ResolveAllDependencies.class).configureEach(r -> r.dependsOn(cacheDockerImages));","+    }","+}"],"additions":101,"deletions":0,"truncated":false},{"path":"build-tools-internal/src/main/java/org/elasticsearch/gradle/internal/docker/DockerImagePullSupport.java","lines":["@@ -0,0 +1,206 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the \"Elastic License","+ * 2.0\", the \"GNU Affero General Public License v3.0 only\", and the \"Server Side","+ * Public License v 1\"; you may not use this file except in compliance with, at","+ * your election, the \"Elastic License 2.0\", the \"GNU Affero General Public","+ * License v3.0 only\", or the \"Server Side Public License, v 1\".","+ */","+package org.elasticsearch.gradle.internal.docker;","+","+import org.elasticsearch.gradle.LoggedExec;","+import org.gradle.api.GradleException;","+import org.gradle.api.logging.Logger;","+import org.gradle.api.logging.Logging;","+import org.gradle.process.ExecOperations;","+import org.gradle.process.ExecSpec;","+","+import java.io.ByteArrayOutputStream;","+import java.io.File;","+import java.io.IOException;","+import java.io.UncheckedIOException;","+import java.nio.charset.StandardCharsets;","+import java.nio.file.Files;","+import java.util.LinkedHashSet;","+import java.util.List;","+import java.util.Locale;","+import java.util.Set;","+import java.util.regex.Matcher;","+import java.util.regex.Pattern;","+","+/**","+ * Helpers for making Docker images available locally, pulling them with retries if needed.","+ */","+public final class DockerImagePullSupport {","+","+    private static final Logger LOGGER = Logging.getLogger(DockerImagePullSupport.class);","+    private static final int DEFAULT_MAX_PULL_ATTEMPTS = 5;","+    private static final long INITIAL_PULL_BACKOFF_MS = 2_000;","+    private static final Pattern FROM_INSTRUCTION = Pattern.compile(","+        \"^\\\\s*FROM\\\\s+(?:--platform=\\\\S+\\\\s+)?(\\\\S+)\",","+        Pattern.CASE_INSENSITIVE","+    );","+","+    private DockerImagePullSupport() {}","+","+    /**","+     * Makes sure the given image is available locally. If it is already present (e.g. pre-cached on CI agents at image","+     * bake time) no registry access is needed. Otherwise the image is pulled with retries and exponential backoff.","+     * <p>","+     * Only use this for references that are immutable (pinned by digest) or where reusing a possibly outdated local","+     * image for a moving tag is acceptable.","+     *","+     * @param platform the Docker platform (e.g. {@code linux/amd64}) the image must be available for, or {@code null}","+     *                 for the host platform","+     */","+    public static void ensureImageAvailable(ExecOperations execOperations, String dockerExecutable, String image, String platform) {","+        if (isImagePresent(execOperations, dockerExecutable, image, platform)) {","+            LOGGER.info(\"Docker image {} for platform {} is available locally, skipping pull\", image, describe(platform));","+            return;","+        }","+        pullImage(execOperations, dockerExecutable, image, platform, DEFAULT_MAX_PULL_ATTEMPTS);","+    }","+","+    /**","+     * Pulls the given image with retries and exponential backoff, regardless of whether it is already present locally.","+     *","+     * @param platform the Docker platform to pull, or {@code null} for the host platform","+     */","+    public static void pullImage(ExecOperations execOperations, String dockerExecutable, String image, String platform, int maxAttempts) {","+        pullImage(execOperations, dockerExecutable, image, platform, maxAttempts, INITIAL_PULL_BACKOFF_MS);","+    }","+","+    /**","+     * Package-private variant of {@link #pullImage(ExecOperations, String, String, String, int)} that allows the","+     * initial backoff to be overridden. Tests pass {@code 0} to avoid real sleeps between attempts.","+     */","+    static void pullImage(","+        ExecOperations execOperations,","+        String dockerExecutable,","+        String image,","+        String platform,","+        int maxAttempts,","+        long initialBackoffMs","+    ) {","+        long backoffMs = initialBackoffMs;","+        for (int attempt = 1; attempt <= maxAttempts; attempt++) {","+            try {","+                LoggedExec.exec(execOperations, spec -> {","+                    maybeConfigureDockerConfig(spec);","+                    spec.executable(dockerExecutable);","+                    spec.args(\"pull\");","+                    if (platform != null) {","+                        spec.args(\"--platform\", platform);","+                    }","+                    spec.args(image);","+                });","+                return;","+            } catch (Exception e) {","+                if (attempt == maxAttempts) {","+                    throw new GradleException(","+                        \"Failed to pull Docker image [\" + image + \"] for platform [\" + describe(platform) + \"], all attempts failed\",","+                        e","+                    );","+                }","+                LOGGER.warn(","+                    \"Attempt {}/{} to pull Docker image {} for platform {} failed, retrying in {}ms\",","+                    attempt,","+                    maxAttempts,","+                    image,","+                    describe(platform),","+                    backoffMs","+                );","+                try {","+                    Thread.sleep(backoffMs);","+                } catch (InterruptedException ie) {","+                    Thread.currentThread().interrupt();","+                    throw new GradleException(\"Interrupted while waiting to retry pulling Docker image [\" + image + \"]\", ie);","+                }","+                backoffMs *= 2;","+            }","+        }","+    }","+","+    /**","+     * Resolves the local image ID (content-addressed digest) of the given image reference as currently stored in the","+     * Docker image store. Unlike a tag, which the daemon rebinds to whichever platform variant was pulled last, the","+     * returned image ID is immutable and platform-specific. Running a container by this ID is therefore safe against a","+     * concurrent pull of a different platform variant for the same tag: the classic image store holds a single variant","+     * per tag, but keeps each pulled image object around.","+     *","+     * @return the image ID (e.g. {@code sha256:...}), or {@code null} if the image is not present locally","+     */","+    public static String resolveLocalImageId(ExecOperations execOperations, String dockerExecutable, String image) {","+        ByteArrayOutputStream output = new ByteArrayOutputStream();","+        var result = execOperations.exec(spec -> {","+            maybeConfigureDockerConfig(spec);","+            spec.executable(dockerExecutable);","+            spec.args(\"image\", \"inspect\", \"--format\", \"{{.Id}}\", image);","+            spec.setStandardOutput(output);","+            spec.setErrorOutput(new ByteArrayOutputStream());","+            spec.setIgnoreExitValue(true);","+        });","+        if (result.getExitValue() != 0) {","+            return null;","+        }","+        String id = output.toString(StandardCharsets.UTF_8).trim();","+        return id.isEmpty() ? null : id;","+    }","+","+    /**","+     * Returns whether the image reference is pinned by digest, i.e. immutable.","+     */","+    public static boolean isDigestPinned(String image) {","+        return image.contains(\"@sha256:\");","+    }","+","+    /**","+     * Returns the digest-pinned external images referenced by {@code FROM} instructions in the given Dockerfile.","+     * References to build stages, build args (e.g. {@code ${base_image}}) and unpinned tags are ignored. This keeps the","+     * Dockerfile (which is updated by Renovate) the single source of truth for those images.","+     */","+    public static List<String> digestPinnedBaseImages(File dockerfile) {","+        Set<String> images = new LinkedHashSet<>();","+        try {","+            for (String line : Files.readAllLines(dockerfile.toPath(), StandardCharsets.UTF_8)) {","+                Matcher matcher = FROM_INSTRUCTION.matcher(line);","+                if (matcher.find()) {","+                    String image = matcher.group(1);","+                    if (isDigestPinned(image) && image.contains(\"$\") == false) {","+                        images.add(image);","+                    }","+                }","+            }","+        } catch (IOException e) {","+            throw new UncheckedIOException(\"Failed to read Dockerfile \" + dockerfile, e);","+        }"],"additions":176,"deletions":0,"truncated":false}],"additions":397,"deletions":45,"truncated":true,"file_count":8},"error":null,"fetched_at":"2026-11-03T16:48:58.260405+00:00"}