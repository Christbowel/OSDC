nstall\")","+        .assert()","+        .success();","+    assert!(","+        workspace","+            .join(modules_dir)","+            .join(\"is-odd\")","+            .exists(),","+    );","+    pacquet_at(&workspace)","+        .args([\"store\", \"status\"])","+        .assert()","+        .success();","+}","+","+fn check_global_virtual_store_status(settings: &str) {","+    let CommandTempCwd {","+        mut pacquet, workspace, root: _root, ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    _utils::enable_gvs_in_workspace_yaml(&workspace, settings);","+    pacquet","+        .args([","+            \"add\",","+            \"is-odd@3.0.1\",","+            \"@pnpm.e2e/abc@1.0.0\",","+            \"@pnpm.e2e/generated-bins@1.0.0\",","+            \"--allow-build=@pnpm.e2e/generated-bins\",","+        ])","+        .assert()","+        .success();","+","+    let generated_bin = workspace.join(\"node_modules/@pnpm.e2e/generated-bins/bin/cmd1\");","+    assert!(generated_bin.is_file(), \"build output at {generated_bin:?}\");","+","+    pacquet_at(&workspace)","+        .args([\"store\", \"status\"])","+        .assert()","+        .success();","+","+    fs::write(workspace.join(\"node_modules/@pnpm.e2e/abc/package.json\"), \"{}\\n\").unwrap();","+    let output = pacquet_at(&workspace)","+        .args([\"store\", \"status\"])","+        .output()","+        .unwrap();","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    eprintln!(\"stderr={stderr}\");","+    assert!(!output.status.success());","+    assert!(stderr.contains(\"ERR_PNPM_MODIFIED_DEPENDENCY\"));","+    assert!(stderr.contains(\"@pnpm.e2e/abc@1.0.0(\"));","+    assert!(!stderr.contains(\"is-odd@3.0.1\"));","+}"],"additions":229,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/optimistic_repeat_install/tests/validation.rs","lines":["@@ -352,6 +352,13 @@ fn a_manifest_whose_trusted_stat_is_unchanged_keeps_its_record() {","     for file in previous_v