&key.name.to_string()).ok()?,","                 store_index_key,","             })","         })","+        .collect())","+}","+","+fn installed_layout(","+    config: &Config,","+    lockfile: &Lockfile,","+    modules_manifest: Option<&Modules>,","+    lockfile_dir: &Path,","+    virtual_store_dir: &Path,","+) -> miette::Result<VirtualStoreLayout> {","+    let max_length = modules_manifest.map_or(config.virtual_store_dir_max_length, |manifest| {","+        manifest.virtual_store_dir_max_length","+    }) as usize;","+    let layout = if config.enable_global_virtual_store {","+        let policy = installed_build_policy(config, modules_manifest)?;","+        virtual_store_layout_for_lockfile(","+            config,","+            config.node_version.as_deref(),","+            lockfile,","+            Some(&policy),","+            Some(lockfile_dir),","+        )","+    } else {","+        VirtualStoreLayout::legacy(virtual_store_dir, max_length)","+    };","+    validate_virtual_store_slot_containment(lockfile.snapshots.as_ref(), &layout)","+        .into_diagnostic()?;","+    Ok(layout)","+}","+","+fn installed_build_policy(","+    config: &Config,","+    modules_manifest: Option<&Modules>,","+) -> miette::Result<AllowBuildPolicy> {","+    let Some(manifest) = modules_manifest else {","+        return AllowBuildPolicy::from_config(config).into_diagnostic();","+    };","+    let approvals = manifest.allow_builds","+        .iter()","+        .flatten()","+        .filter_map(|(spec, value)| match value {","+            AllowBuildValue::Bool(allowed) => Some((spec.clone(), *allowed)),","+            AllowBuildValue::String(_) => None,","+        })","+        .collect();","+    AllowBuildPolicy::from_approvals(&approvals, config.dangerously_allow_all_builds)","+        .into_diagnostic()?","+        .with_side_effects_cache_exclude(","+            config.side_effects_cache_exclude.as_deref().unwrap_or_default(),","+        )","+        .into_diagnostic()","+}","+","+fn validate_project_links(","+    config: &Config,","+    lockfile: &Lockfile,","+    lockfile_dir: &Path,","+    packages: &[PackageToCheck],","+) -> miette::Result<()> {","+    let package_dirs = resolved_package_dirs(packages)?;","+    let root_modules_dir = project_modules_dir(config, lockfile_dir);","+    for (id, importer) in &lockfile.importers {","+        validate_importer_id(id.as_str())?;","+        let modules_dir = project_modules_dir(config, &lockfile_dir.join(id.as_str()));","+        let dependencies =","+            [&importer.dependencies, &importer.dev_dependencies, &importer.optional_dependencies];","+        for (alias, reference) in dependencies","+            .into_iter()","+            .flatten()","+            .flatten()","+        {","+            let Some(key) = reference.version.resolved_key(alias) else { continue };","+            let Some(expected) = package_dirs.get(key.to_string().as_str()) else { continue };","+            let link = installed_project_link(&modules_dir, &root_modules_dir, &alias.to_string())?;","+            let actual = installed_link_realpath(&link)?;","+            if &actual != expected {","+                return Err(UnverifiablePackageError { path: link.display().to_string() }.into());","+            }","+        }","+    }","+    Ok(())","+}","+","+fn resolved_package_dirs(packages: &[PackageToCheck]) -> miette::Result<HashMap<&str, PathBuf>> {","+    packages","+        .iter()","+        .map(|package| {","+            installed_link_realpath(&package.package_dir)","+                .map(|path| (package.dep_path.as_str(), path))","+        })","         .collect()"," }"," ","+fn project_modules_dir(config: &Config, project_dir: &Path) -> PathBuf {","+    let name = config","+        .applies_package_configs()","+        .then(|| pnpm_workspace::read_project_name(project_dir))","+        .flatten();","+    config.project_modules_dir(project_dir, name.as_deref())","+}","+","+fn installed_link_realpath(link: &Path) -> miette::Result<PathBuf> {","+    match pnpm_fs::realpath_missing(link) {","+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {","+            Err(UnverifiablePackageError { path: link.display().to_string() }.into())","+        }","+        result => result.into_diagnostic(),","+    }","+}","+","+fn installed_project_link(","+    modules_dir: &Path,","+    root_modules_dir: &Path,","+    alias: &str,","+) -> miette::Result<PathBuf> {","+    let link = safe_join_modules_dir(modules_dir, alias).into_diagnostic()?;","+    match std::fs::symlink_metadata(&link) {","+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {","+            safe_join_modules_dir(root_modules_dir, alias).into_diagnostic()","+        }","+        Err(error) => Err(error).into_diagnostic(),","+        Ok(_) => Ok(link),","+    }","+}","+"," /// Re-hash every candidate against its store row. Runs on the blocking"," /// pool: it is filesystem-bound work over the whole virtual store."," fn find_modified(","     store_dir: &Path,","     frozen_store: bool,","     packages: &[PackageToCheck],","-) -> Result<Vec<String>, StoreIndexError> {","+) -> miette::Result<Vec<String>> {","     if !StoreIndex::exists(store_dir) {","         return Ok(Vec::new());","     }","     let store_index = if frozen_store {","-        StoreIndex::open_immutable(store_dir)?","+        StoreIndex::open_immutable(store_dir).into_diagnostic()?","     } else {","-        StoreIndex::open_readonly(store_dir)?","+        StoreIndex::open_readonly(store_dir).into_diagnostic()?","     };","     let keys = packages","         .iter()","         .map(|package| package.store_index_key.clone())","         .collect::<Vec<_>>();","-    let rows = store_index.get_many(&keys)?;","+    let rows = store_index.get_many(&keys).into_diagnostic()?;","+    for package in packages {","+        if package.global_virtual_store","+            && rows.contains_key(&package.store_index_key)","+            && !package.package_dir.try_exists().into_diagnostic()?","+        {","+            return Err(UnverifiablePackageError {","+                path: package.package_dir.display().to_string(),","+            }","+            .into());","+        }","+    }","     Ok(packages","         .par_iter()","         .filter(|package| {"],"additions":183,"deletions":19,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/store.rs","lines":["@@ -1,3 +1,5 @@","+mod global_status;","+"," use crate::_utils;"," use assert_cmd::prelude::*;"," use command_extra::CommandExtra;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/store/global_status.rs","lines":["@@ -0,0 +1,229 @@","+use super::pacquet_at;","+use crate::_utils;","+use assert_cmd::prelude::*;","+use pnpm_testing_utils::bin::CommandTempCwd;","+use std::fs;","+","+#[test]","+fn store_status_checks_global_virtual_store_packages() {","+    check_global_virtual_store_status(\"\");","+}","+","+#[test]","+fn store_status_checks_custom_global_virtual_store_packages() {","+    check_global_virtual_store_status(\"globalVirtualStoreDir: custom-links\\n\");","+}","+","+#[test]","+fn store_status_checks_global_packages_with_virtual_store_dir_override() {","+    check_global_virtual_store_status(\"virtualStoreDir: custom-links\\n\");","+}","+","+#[test]","+fn store_status_uses_installed_build_approvals() {","+    let CommandTempCwd {","+        mut pacquet, workspace, root: _root, ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    _utils::enable_gvs_in_workspace_yaml(&workspace, \"\");","+    pacquet","+        .args([\"add\", \"@pnpm.e2e/generated-bins@1.0.0\", \"--allow-build=@pnpm.e2e/generated-bins\"])","+        .assert()","+        .success();","+    let settings = workspace.join(\"pnpm-workspace.yaml\");","+    let mut yaml: serde_json::Value =","+        serde_saphyr::from_str(&fs::read_to_string(&settings).unwrap()).unwrap();","+    yaml[\"allowBuilds\"][\"@pnpm.e2e/generated-bins\"] = serde_json::Value::Bool(false);","+    fs::write(&settings, serde_saphyr::to_string(&yaml).unwrap()).unwrap();","+    pacquet_at(&workspace)","+        .args([\"store\", \"status\"])","+        .assert()","+        .success();","+}","+","+#[test]","+fn store_status_checks_global_packages_without_optional_dependencies() {","+    let CommandTempCwd {","+        mut pacquet, workspace, root: _root, ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    _utils::enable_gvs_in_workspace_yaml(&workspace, \"\");","+    pacquet","+        .args([\"add\", \"@pnpm.e2e/pkg-with-good-optional\", \"--no-optional\"])","+        .assert()","+        .success();","+    pacquet_at(&workspace)","+        .args([\"store\", \"status\"])","+        .assert()","+        .success();","+}","+","+#[test]","+fn store_status_reports_unverifiable_global_slots_after_node_version_changes() {","+    let CommandTempCwd {","+        mut pacquet, workspace, root: _root, ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    _utils::enable_gvs_in_workspace_yaml(&workspace, \"nodeVersion: 22.0.0\\n\");","+    pacquet","+        .args([\"add\", \"@pnpm.e2e/generated-bins@1.0.0\", \"--allow-build=@pnpm.e2e/generated-bins\"])","+        .assert()","+        .success();","+    let settings = workspace.join(\"pnpm-workspace.yaml\");","+    let yaml = fs::read_to_string(&settings).unwrap();","+    fs::write(&settings, yaml.replace(\"22.0.0\", \"24.0.0\")).unwrap();","+    let output = pacquet_at(&workspace)","+        .args([\"store\", \"status\"])","+        .output()","+        .unwrap();","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    assert!(!output.status.success());","+    assert!(stderr.contains(\"ERR_PNPM_STORE_STATUS_UNVERIFIABLE\"), \"{stderr}\");","+    assert!(!stderr.contains(\"ERR_PNPM_MODIFIED_DEPENDENCY\"));","+}","+","+#[test]","+fn store_status_rejects_project_links_to_a_different_global_slot() {","+    let CommandTempCwd {","+        mut pacquet, workspace, root: _root, ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    _utils::enable_gvs_in_workspace_yaml(&workspace, \"\");","+    pacquet","+        .args([\"add\", \"is-odd@3.0.1\"])","+        .assert()","+        .success();","+    let replacement = workspace.join(\"replacement\");","+    fs::create_dir(&replacement).unwrap();","+    fs::write(replacement.join(\"package.json\"), \"{}\\n\").unwrap();","+    pnpm_fs::force_symlink_dir(&replacement, &workspace.join(\"node_modules/is-odd\")).unwrap();","+    let output = pacquet_at(&workspace)","+        .args([\"store\", \"status\"])","+        .output()","+        .unwrap();","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    assert!(!output.status.success());","+    assert!(stderr.contains(\"ERR_PNPM_STORE_STATUS_UNVERIFIABLE\"), \"{stderr}\");","+}","+","+#[test]","+fn store_status_reports_dangling_global_links_as_unverifiable() {","+    let CommandTempCwd {","+        mut pacquet, workspace, root: _root, ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    _utils::enable_gvs_in_workspace_yaml(&workspace, \"\");","+    pacquet","+        .args([\"add\", \"is-odd@3.0.1\"])","+        .assert()","+        .success();","+    let package_dir = fs::canonicalize(workspace.join(\"node_modules/is-odd\")).unwrap();","+    fs::remove_dir_all(package_dir).unwrap();","+    let output = pacquet_at(&workspace)","+        .args([\"store\", \"status\"])","+        .output()","+        .unwrap();","+    let stderr = String::from_utf8_lossy(&output.stderr);","+    assert!(!output.status.success());","+    assert!(stderr.contains(\"ERR_PNPM_STORE_STATUS_UNVERIFIABLE\"), \"{stderr}\");","+}","+","+#[test]","+fn store_status_checks_custom_modules_directory() {","+    check_workspace_links(\"modulesDir: custom_modules\\n\", \"custom_modules\");","+}","+","+#[test]","+fn store_status_checks_deduplicated_workspace_links() {","+    check_workspace_links(\"dedupeDirectDeps