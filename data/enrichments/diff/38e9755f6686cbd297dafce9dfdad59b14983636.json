{"id":"38e9755f6686cbd297dafce9dfdad59b14983636","axis":"silent","repo":"pnpm/pnpm","sha":"38e9755f6686cbd297dafce9dfdad59b14983636","parsed":{"files":[{"path":".changeset/pin-tag-catalog-adds.md","lines":["@@ -0,0 +1,7 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm add` now saves the resolved version range of an npm alias. For example, `pnpm add v2@npm:vue` and `pnpm add v2@npm:vue@^3.0.0` both save `npm:vue@^3.5.13`.","+","+When `pnpm add` adds a dist-tag such as `vue@legacy` to a catalog, the catalog entry records the exact version the tag points to. The same applies to a dependency added without a version when the `tag` setting names a dist-tag other than `latest`."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/add.rs","lines":["@@ -553,7 +553,7 @@ fn add_aliasing_a_package_manager_name_installs_the_aliased_package() {","         \"yarn@npm:@pnpm.e2e/dep-of-pkg-with-1-dep@^100.0.0\",","         \"--lockfile-only\",","     ]);","-    assert_eq!(prod_spec(&dir, \"yarn\"), \"npm:@pnpm.e2e/dep-of-pkg-with-1-dep@^100.0.0\");","+    assert_eq!(prod_spec(&dir, \"yarn\"), \"npm:@pnpm.e2e/dep-of-pkg-with-1-dep@^100.1.0\");","     let manifest: serde_json::Value =","         serde_json::from_str(&std::fs::read_to_string(dir.join(\"package.json\")).unwrap()).unwrap();","     assert_eq!(manifest.get(\"devEngines\"), None, \"{manifest}\");"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/add/version_specifiers.rs","lines":["@@ -569,16 +569,16 @@ fn add_explicit_range_honors_requested_operator() {","     drop((root, npmrc_info)); // cleanup"," }"," ","-/// An `npm:` alias specifier is written verbatim — never resolved (which","-/// would risk dropping the aliased target name).","+/// An `npm:` alias keeps its target name and records the resolved range,","+/// as a plain registry specifier does."," #[test]","-fn add_npm_alias_spec_is_kept_verbatim() {","+fn add_npm_alias_spec_records_the_resolved_range() {","     let (root, dir, anchor) = exec_pacquet_in_temp_cwd([","         \"add\",","         \"my-alias@npm:@pnpm.e2e/dep-of-pkg-with-1-dep@^100.0.0\",","         \"--lockfile-only\",","     ]);","-    assert_eq!(prod_spec(&dir, \"my-alias\"), \"npm:@pnpm.e2e/dep-of-pkg-with-1-dep@^100.0.0\");","+    assert_eq!(prod_spec(&dir, \"my-alias\"), \"npm:@pnpm.e2e/dep-of-pkg-with-1-dep@^100.1.0\");","     drop((root, anchor)); // cleanup"," }"," "],"additions":4,"deletions":4,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/catalog.rs","lines":["@@ -250,6 +250,75 @@ fn add_mismatched_version_strict_errors() {","     drop((root, anchor));"," }"," ","+/// A catalog entry added for a dist-tag records the exact version the tag","+/// points to, in every catalog mode. The manifest of a project that is not","+/// cataloged keeps the range.","+#[test]","+fn add_pins_a_dist_tag_in_a_new_catalog_entry() {","+    for (catalog_mode, args) in","+        [(\"strict\", &[][..]), (\"prefer\", &[][..]), (\"manual\", &[\"--save-catalog\"][..])]","+    {","+        let CommandTempCwd {","+            root, workspace, npmrc_info: anchor, ..","+        } = CommandTempCwd::init().add_mocked_registry_with_own_storage();","+        anchor.set_dist_tag(FOO, \"100.0.0\", \"legacy\");","+        write_manifest(&workspace, \"{}\");","+        append_workspace_yaml(&workspace, &format!(\"catalogMode: {catalog_mode}\\n\"));","+","+        let selector = format!(\"{FOO}@legacy\");","+        let mut add_args = vec![\"add\", \"--lockfile-only\"];","+        add_args.extend(args);","+        add_args.push(&selector);","+        run_ok(&workspace, &add_args);","+","+        assert_eq!(dep_spec(&workspace, FOO).as_deref(), Some(\"catalog:\"), \"{catalog_mode}\");","+        let workspace_yaml = read(&workspace, \"pnpm-workspace.yaml\");","+        assert!(workspace_yaml.contains(&format!(\"'{FOO}': 100.0.0\")), \"{workspace_yaml}\");","+        assert_eq!(","+            catalog_snapshot(&workspace, FOO),","+            (\"100.0.0\".to_string(), \"100.0.0\".to_string()),","+            \"{catalog_mode}\",","+        );","+","+        drop((root, anchor));","+    }","+}","+","+#[test]","+fn add_pins_the_configured_tag_in_a_new_catalog_entry() {","+    let CommandTempCwd {","+        root, workspace, npmrc_info: anchor, ..","+    } = CommandTempCwd::init().add_mocked_registry_with_own_storage();","+    anchor.set_dist_tag(FOO, \"100.0.0\", \"legacy\");","+    write_manifest(&workspace, \"{}\");","+    append_workspace_yaml(&workspace, \"catalogMode: prefer\\ntag: legacy\\n\");","+","+    run_ok(&workspace, &[\"add\", \"--lockfile-only\", FOO]);","+","+    assert_eq!(dep_spec(&workspace, FOO).as_deref(), Some(\"catalog:\"));","+    let workspace_yaml = read(&workspace, \"pnpm-workspace.yaml\");","+    assert!(workspace_yaml.contains(&format!(\"'{FOO}': 100.0.0\")), \"{workspace_yaml}\");","+    assert_eq!(catalog_snapshot(&workspace, FOO), (\"100.0.0\".to_string(), \"100.0.0\".to_string()));","+","+    drop((root, anchor));","+}","+","+#[test]","+fn add_keeps_a_dist_tag_range_outside_the_catalog() {","+    let CommandTempCwd {","+        root, workspace, npmrc_info: anchor, ..","+    } = CommandTempCwd::init().add_mocked_registry_with_own_storage();","+    anchor.set_dist_tag(FOO, \"100.0.0\", \"legacy\");","+    write_manifest(&workspace, \"{}\");","+","+    run_ok(&workspace, &[\"add\", \"--lockfile-only\", &format!(\"{FOO}@legacy\")]);","+","+    assert_eq!(dep_spec(&workspace, FOO).as_deref(), Some(\"^100.0.0\"));","+    assert!(!read(&workspace, \"pnpm-workspace.yaml\").contains(\"catalog:\"));","+","+    drop((root, anchor));","+}","+"," #[test]"," fn save_catalog_flag_writes_the_default_catalog() {","     let (root, workspace, anchor) = setup();"],"additions":69,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/add.rs","lines":["@@ -7,6 +7,8 @@ use install::{"," mod specifier;"," use specifier::{normalized_save_specifier, resolve_added_dependency};"," ","+mod alias;","+"," mod workspace_specifier;"," use workspace_specifier::workspace_packages_for_add;"," "],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/add/alias.rs","lines":["@@ -0,0 +1,55 @@","+use super::{","+    AddError, AddResolveInputs,","+    specifier::{ProtocolSelector, SaveSpecifier, explicit_registry_save_specifier},","+};","+use pnpm_package_manifest::PackageManifest;","+","+pub(super) async fn resolve_npm_alias_save_specifier(","+    name: &str,","+    spec: Option<String>,","+    prev_specifier: Option<&str>,","+    manifest: &PackageManifest,","+    inputs: &AddResolveInputs<'_, '_>,","+) -> Result<SaveSpecifier, AddError> {","+    let previous_specifier =","+        prev_specifier.and_then(|previous| previous_npm_alias_specifier(previous, name));","+    let target_specifier = spec","+        .as_deref()","+        .filter(|spec| !spec.is_empty());","+    if target_specifier.is_none()","+        && let Some(previous_specifier) = previous_specifier.as_deref()","+    {","+        return Ok(format!(\"npm:{name}@{previous_specifier}\").into());","+    }","+    let mut saved = explicit_registry_save_specifier(","+        name,","+        target_specifier.unwrap_or_else(|| inputs.add.config.default_tag()),","+        previous_specifier.as_deref(),","+        manifest,","+        inputs,","+    )","+    .await?;","+    saved.specifier = format!(\"npm:{name}@{}\", saved.specifier);","+    Ok(saved)","+}","+","+pub(super) fn npm_alias_target(","+    package_selector: &str,","+) -> Result<Option<ProtocolSelector>, AddError> {","+    let parsed = pnpm_resolving_parse_wanted_dependency::parse_wanted_dependency(package_selector);","+    if parsed.alias.is_none() {","+        return Ok(None);","+    }","+    let Some(specifier) = parsed.bare_specifier.filter(|specifier| specifier.starts_with(\"npm:\"))","+    else {","+        return Ok(None);","+    };","+    ProtocolSelector::parse(&specifier)","+}","+","+fn previous_npm_alias_specifier(previous: &str, name: &str) -> Option<String> {","+    match ProtocolSelector::parse(previous).ok().flatten()? {","+        ProtocolSelector::Npm { name: previous_name, spec } if previous_name == name => spec,","+        _ => None,","+    }","+}"],"additions":55,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/add/specifier.rs","lines":["@@ -1,5 +1,6 @@"," use super::{","     AddError, AddResolveInputs,","+    alias::{npm_alias_target, resolve_npm_alias_save_specifier},","     aliasless::{AliaslessDependency, resolve_aliasless_specifier},","     manifest::apply_catalog_decision,","     registry::{pick_latest_range, resolve_explicit_registry_spec},","@@ -55,13 +56,19 @@ pub(super) async fn resolve_added_dependency(","     let types_selector =","         super::types::resolve_types_selector(package_name, &bare_specifier, manifest, inputs)","             .await?;","-    let (manifest_specifier, updated_catalogs, mut warnings) = resolve_catalog_and_warnings(","+    let (manifest_specifier, mut updated_catalogs, mut warnings) = resolve_catalog_and_warnings(","         inputs,","         package_name,","         bare_specifier,","         prev_specifier.as_deref(),","         package_selector,","     )?;","+    if let Some(picked) = picked","+        .as_ref()","+        .filter(|_| selector.names_dist_tag(package_selector, inputs.add.config.default_tag()))","+    {","+        pin_catalog_entry(&mut updated_catalogs, package_name, &picked.version);","+    }","     warnings.extend(selector.linked_peer_dependencies_warning(package_name, inputs.prefix));","     Ok(ResolvedAddedDependency {","         package_name: package_name.to_string(),","@@ -73,6 +80,17 @@ pub(super) async fn resolve_added_dependency(","     })"," }"," ","+/// A catalog entry written for a dist-tag records the exact version the tag","+/// pointed to, so the catalog does not drift when the tag moves.","+fn pin_catalog_entry(updated_c