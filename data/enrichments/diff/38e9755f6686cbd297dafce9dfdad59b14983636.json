`26.5.0`, not the","@@ -207,6 +236,10 @@ pub(super) async fn bare_save_specifier("," ) -> Result<SaveSpecifier, AddError> {","     let package_name = selector.package_name(package_selector);","     let explicit_spec = selector.explicit_spec(package_selector);","+    if let Some(ProtocolSelector::Npm { name, spec }) = npm_alias_target(package_selector)? {","+        return resolve_npm_alias_save_specifier(&name, spec, prev_specifier, manifest, inputs)","+            .await;","+    }","     if let Some(workspace_specifier) = workspace_save_specifier(","         package_name,","         explicit_spec,","@@ -264,7 +297,7 @@ async fn registry_save_specifier(","     }"," }"," /// [`registry_save_specifier`] for a registry selector that names `spec`.","-async fn explicit_registry_save_specifier(","+pub(super) async fn explicit_registry_save_specifier(","     package_name: &str,","     spec: &str,","     prev_specifier: Option<&str>,","@@ -289,7 +322,7 @@ async fn explicit_registry_save_specifier("," /// What [`bare_save_specifier`] records, and the version it resolved an"," /// explicit registry specifier to."," pub(super) struct SaveSpecifier {","-    specifier: String,","+    pub(super) specifier: String,","     picked: Option<PickedPackage>,"," }"," impl From<String> for SaveSpecifier {"],"additions":38,"deletions":5,"truncated":false},{"path":"pnpm/crates/package-manager/src/add/tests.rs","lines":["@@ -19,6 +19,7 @@ use pnpm_network::ThrottledClient;"," use pnpm_package_manifest::{DependencyGroup, PackageManifest};"," use pnpm_registry::RangeSpecStyle;"," use pnpm_reporter::SilentReporter;","+use pnpm_resolving_parse_wanted_dependency::parse_wanted_dependency;"," use pnpm_workspace::Project;"," use serde_json::json;"," use std::sync::Arc;","@@ -119,7 +120,8 @@ async fn add_npm_selector(selector: &str) -> Option<String> {","     .await","     .unwrap_or_else(|error| panic!(\"add {selector} should succeed: {error}\"));"," ","-    saved_dependency_specifier(&manifest, \"f