rue,","+        );","+        assert_eq!(results, jobs);","+    }","+","+    #[test]","+    fn in_order_jobs_never_overlap_and_stop_after_a_failure() {","+        let running = Mutex::new(0);","+        let jobs = [\"js\", \"uv\", \"cargo\"];","+        let results = Schedule::InOrder.run(","+            &jobs,","+            |job| {","+                *running.lock().unwrap() += 1;","+                assert_eq!(*running.lock().unwrap(), 1, \"jobs overlapped\");","+                std::thread::sleep(Duration::from_millis(20));","+                *running.lock().unwrap() -= 1;","+                (*job, *job == \"uv\")","+            },","+            |(_, failed)| *failed,","+        );","+        assert_eq!(results, [(\"js\", false), (\"uv\", true)]);","+    }","+}"],"additions":247,"deletions":18,"truncated":false},{"path":"crates/turborepo-cli/src/commands/setup/output.rs","lines":["@@ -176,6 +176,7 @@ pub(super) enum Note {"," pub(super) struct DependencyReport {","     pub steps: Vec<StepOutcome>,","     pub offline: bool,","+    pub ran_concurrently: bool,"," }"," "," impl DependencyReport {","@@ -435,14 +436,31 @@ pub(super) fn render_final(deps: &DependencyReport, elapsed: Duration, style: St","                 .map(|(step, _)| step.toolchain.as_str())","                 .collect::<Vec<_>>()","                 .join(\", \");","-            format!(","-                \"{cross} {} installers failed offline ({ids}); run turbo setup without --offline \\","-                 to download what they need\",","-                many.len()","-            )","+            if deps.offline {","+                format!(","+                    \"{cross} {} installers failed offline ({ids}); run turbo setup without \\","+                     --offline to download what they need\",","+                    many.len()","+                )","+            } else {","+                format!(\"{cross} {} installers failed ({ids})\", many.len())","+            }","         }","     }