{"id":"698ec00d38e7def1bf8ab7f21f11ed16a7bd3641","axis":"silent","repo":"pnpm/pnpm","sha":"698ec00d38e7def1bf8ab7f21f11ed16a7bd3641","parsed":{"files":[{"path":".changeset/hoisted-removed-count.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/installing.deps-restorer\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm install` with `nodeLinker: hoisted` no longer counts missing packages as removed. This fixes inflated removal counts for skipped optional dependencies [pnpm/pnpm#18178](https://github.com/pnpm/pnpm/issues/18178)."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/link_hoisted_modules/orphans.rs","lines":["@@ -32,17 +32,22 @@ struct UnplannedDir {"," /// way an alien package directory already is. Both are best-effort with"," /// the same `EPERM`/`EBUSY` tolerance: a directory we cannot clear right"," /// now is no worse than leaving a stale entry, and the next install will","-/// retry. Returns the count attempted, not necessarily cleared — the","-/// same number pnpm reports.","+/// retry. Paths known to be missing are excluded from the attempted removal count."," pub(super) fn remove_orphans(","     opts: &LinkHoistedModulesOpts<'_>,"," ) -> Result<u64, LinkHoistedModulesError> {","-    let recorded_dirs: BTreeSet<&PathBuf> = opts.previous_dirs","+    let recorded_dirs = opts.previous_dirs","         .iter()","         .filter(|dir| !opts.graph.contains_key(*dir))","         .filter(|dir| !holds_importer(opts, dir))","         .filter(|dir| confined(dir, opts.modules_dirs.removal_bound(dir)))","-        .collect();","+        .collect::<BTreeSet<_>>();","+    // Probe every candidate before deleting a parent that may contain another candidate.","+    let recorded_dirs = recorded_dirs","+        .par_iter()","+        .filter(|dir| orphan_path_may_exist(dir))","+        .copied()","+        .collect::<BTreeSet<_>>();","     let unplanned_dirs = unplanned_dirs(opts, &recorded_dirs)?;","     recorded_dirs","         .par_iter()","@@ -58,6 +63,22 @@ pub(super) fn remove_orphans(","     Ok((recorded_dirs.len() + unplanned_dirs.len()) as u64)"," }"," ","+fn orphan_path_may_exist(dir: &Path) -> bool {","+    match fs::symlink_metadata(dir) {","+        Ok(_) => true,","+        Err(error)","+            if matches!(error.kind(), io::ErrorKind::NotFound | io::ErrorKind::NotADirectory) =>","+        {","+            false","+        }","+        // Metadata failures must not make best-effort orphan cleanup fatal.","+        Err(error) => {","+            tracing::debug!(?dir, %error, \"failed to inspect an orphan package\");","+            true","+        }","+    }","+}","+"," /// The package directories in the importers' modules directories that"," /// neither the plan nor the previous install placed."," ///"],"additions":25,"deletions":4,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/link_hoisted_modules/orphans/tests.rs","lines":["@@ -4,13 +4,13 @@ use crate::{"," };"," use pnpm_cmd_shim::LinkBinsOptions;"," use pnpm_config::PackageImportMethod;","-use pnpm_reporter::SilentReporter;","+use pnpm_reporter::{LogEvent, Reporter, SilentReporter, StatsMessage};"," use std::{","     collections::{BTreeMap, BTreeSet, HashMap},","     ffi::OsStr,","     fs,","     path::{Path, PathBuf},","-    sync::atomic::AtomicU8,","+    sync::{Mutex, atomic::AtomicU8},"," };"," "," fn write_package(dir: &Path) {","@@ -21,7 +21,11 @@ fn write_package(dir: &Path) {"," "," /// Links an empty plan for a workspace of the root and a dependency-free"," /// `packages/foo`, with the root's modules directory at `root_modules_dir`.","-fn link_empty_plan(lockfile_dir: &Path, root_modules_dir: &str, previous_dirs: &BTreeSet<PathBuf>) {","+fn link_empty_plan<LogReporter: Reporter>(","+    lockfile_dir: &Path,","+    root_modules_dir: &str,","+    previous_dirs: &BTreeSet<PathBuf>,","+) {","     let hierarchy = BTreeMap::from([(lockfile_dir.to_path_buf(), DepHierarchy::default())]);","     let logged = AtomicU8::new(0);","     let opts = LinkHoistedModulesOpts {","@@ -45,7 +49,7 @@ fn link_empty_plan(lockfile_dir: &Path, root_modules_dir: &str, previous_dirs: &","         )","         .with_importers([\".\", \"packages/foo\"]),","     };","-    link_hoisted_modules::<SilentReporter>(&opts).expect(\"linker succeeds\");","+    link_hoisted_modules::<LogReporter>(&opts).expect(\"linker succeeds\");"," }"," "," #[test]","@@ -55,7 +59,7 @@ fn a_modules_dir_holding_a_project_is_not_scanned() {","     write_package(&lockfile_dir.join(\"packages/foo\"));","     write_package(&lockfile_dir.join(\"packages/stray\"));"," ","-    link_empty_plan(&lockfile_dir, \"packages\", &BTreeSet::new());","+    link_empty_plan::<SilentReporter>(&lockfile_dir, \"packages\", &BTreeSet::new());"," ","     assert!(lockfile_dir.join(\"packages/foo/package.json\").exists());","     assert!(lockfile_dir.join(\"packages/stray/package.json\").exists());","@@ -70,7 +74,7 @@ fn a_modules_dir_that_is_not_inside_its_importer_is_not_scanned() {","         let stray = modules_dir.join(\"stray\");","         write_package(&stray);"," ","-        link_empty_plan(&lockfile_dir, root_modules_dir, &BTreeSet::new());","+        link_empty_plan::<SilentReporter>(&lockfile_dir, root_modules_dir, &BTreeSet::new());"," ","         eprintln!(\"modulesDir: {root_modules_dir}\");","         assert!(stray.join(\"package.json\").exists());","@@ -89,8 +93,59 @@ fn a_previous_dir_that_is_the_workspace_or_holds_a_project_is_kept() {","         lockfile_dir.join(\"packages/foo\"),","     ]);"," ","-    link_empty_plan(&lockfile_dir, \"node_modules\", &previous_dirs);","+    link_empty_plan::<SilentReporter>(&lockfile_dir, \"node_modules\", &previous_dirs);"," ","     assert!(lockfile_dir.join(\"package.json\").exists());","     assert!(lockfile_dir.join(\"packages/foo/package.json\").exists());"," }","+","+#[test]","+fn orphan_removal_counts_paths_present_before_cleanup() {","+    static REMOVED: Mutex<u64> = Mutex::new(0);","+    struct RecordingReporter;","+    impl Reporter for RecordingReporter {","+        fn emit(event: &LogEvent) {","+            if let LogEvent::Stats(log) = event","+                && let StatsMessage::Removed { removed, .. } = &log.message","+            {","+                *REMOVED.lock().unwrap() = *removed;","+            }","+        }","+    }","+","+    let tmp = tempfile::tempdir().expect(\"tempdir\");","+    let lockfile_dir = tmp.path();","+    let modules_dir = lockfile_dir.join(\"node_modules\");","+    let installed = modules_dir.join(\"installed\");","+    let missing = modules_dir.join(\"@scope/skipped\");","+    write_package(&installed);","+    fs::create_dir_all(missing.parent().unwrap()).unwrap();","+    let previous_dirs = BTreeSet::from([installed.clone(), missing.clone()]);","+","+    link_empty_plan::<RecordingReporter>(lockfile_dir, \"node_modules\", &previous_dirs);","+    assert_eq!(*REMOVED.lock().unwrap(), 1);","+    assert!(!installed.exists());","+    link_empty_plan::<RecordingReporter>(lockfile_dir, \"node_modules\", &previous_dirs);","+    assert_eq!(*REMOVED.lock().unwrap(), 0);","+","+    let scope = missing.parent().unwrap();","+    fs::remove_dir(scope).unwrap();","+    fs::write(scope, b\"not a directory\").unwrap();","+    link_empty_plan::<RecordingReporter>(lockfile_dir, \"node_modules\", &previous_dirs);","+    assert_eq!(*REMOVED.lock().unwrap(), 0);","+    assert_eq!(fs::read(scope).unwrap(), b\"not a directory\");","+","+    let parent = modules_dir.join(\"parent\");","+    let child = parent.join(\"node_modules/child\");","+    write_package(&child);","+    let nested_dirs = BTreeSet::from([parent.clone(), child]);","+    rayon::ThreadPoolBuilder::new()","+        .num_threads(1)","+        .build()","+        .unwrap()","+        .install(|| {","+            link_empty_plan::<RecordingReporter>(lockfile_dir, \"node_modules\", &nested_dirs);","+        });","+    assert_eq!(*REMOVED.lock().unwrap(), 2);","+    assert!(!parent.exists());","+}"],"additions":62,"deletions":7,"truncated":false},{"path":"pnpm11/exec/commands/src/dlx.ts","lines":["@@ -285,7 +285,7 @@ function createDlxAddOptions (ctx: DlxInstallContext, cachedDir: string): add.Ad","     lockfileDir: cachedDir,","     allowBuilds: ctx.allowBuilds,","     rootProjectManifestDir: cachedDir,","-    saveProd: true, // dlx will be looking for the package in the \"dependencies\" field!","+    saveProd: true, // dlx will be looking for the package in the \"dependencies\" field.","     saveDev: false,","     saveOptional: false,","     savePeer: false,"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm11/installing/deps-restorer/src/linkHoistedModules.ts","lines":["@@ -129,8 +129,11 @@ async function removeDirsOutsidePlan (","   const holdsImporter = holdsAnyOf([lockfileDir, ...importerDirs, ...Object.keys(hierarchy)])","   const rootModulesDir = importerModulesDir(lockfileDir, { lockfileDir, modulesDir })","   const isPermittedDir = (dir: string) => isStrictlyInside(dir, lockfileDir) || isStrictlyInside(dir, rootModulesDir)","-  const dirsToRemove = difference(previousDirs, Object.keys(graph))","+  const orphanDirs = difference(previousDirs, Object.keys(graph))","     .filter((dir) => !holdsImporter(dir) && isPermittedDir(dir))","+  // Probe every candidate before deleting a parent that may contain another candidate.","+  const existingOrphanDirs = await Promise.all(orphanDirs.map((dir) => limitLinking(async () => await orphanPathMayExist(dir) ? dir : null)))","+  const dirsToRemove = existingOrphanDirs.filter((dir) => dir != null)","   // A directory the previous install recorded is pnpm's to delete. One that only","   // the on-disk scan found is not: pnpm has no record of putting it there, so it","   // is quarantined instead, the way an alien package directory already is.","@@ -144,7 +147,7 @@ async function removeDirsOutsidePlan (","   // We should avoid removing unnecessary directories while simultaneously adding new ones.","   // Doing so can sometimes lead to a race condition when linking commands to `node_modules/.bin`.","   await Promise.all([","-    ...dirsToRemove.map((dir) => tryRemoveDir(dir)),","+    ...dirsToRemove.map((dir) => limitLinking(() => tryRemoveDir(dir))),","     ...dirsToQuarantine.map((unplanned) => quarantineDir(unplanned, lockfileDir)),","   ])"," }","@@ -256,6 +259,17 @@ async function makeRealDir (parent: string, name: string): Promise<string | null","   return dir"," }"," ","+async function orphanPathMayExist (dir: string): Promise<boolean> {","+  try {","+    return await pathExistsNoFollow(dir)","+  } catch (error: unknown) {","+    if (isError(error) && 'code' in error && error.code === 'ENOTDIR') return false","+    // Metadata failures must not make best-effort orphan cleanup fatal.","+    logger.debug({ error, message: `Failed to inspect the orphan package at \"${dir}\"` })","+    return true","+  }","+}","+"," async function tryRemoveDir (dir: string): Promise<void> {","   removalLogger.debug(dir)","   try {"],"additions":16,"deletions":2,"truncated":false},{"path":"pnpm11/installing/deps-restorer/test/linkHoistedModules.test.ts","lines":["@@ -0,0 +1,55 @@","+import fs from 'node:fs'","+import path from 'node:path'","+","+import { expect, jest, test } from '@jest/globals'","+import { statsLogger } from '@pnpm/core-loggers'","+import { tempDir } from '@pnpm/prepare'","+import type { StoreController } from '@pnpm/store.controller-types'","+","+import { linkHoistedModules } from '../src/linkHoistedModules.js'","+","+test('orphan removal counts paths present before cleanup', async () => {","+  const lockfileDir = tempDir(false)","+  const modulesDir = path.join(lockfileDir, 'node_modules')","+  const installed = path.join(modulesDir, 'installed')","+  const missing = path.join(modulesDir, '@scope/skipped')","+  fs.mkdirSync(installed, { recursive: true })","+  fs.mkdirSync(path.dirname(missing), { recursive: true })","+  fs.writeFileSync(path.join(installed, 'package.json'), JSON.stringify({ name: 'installed', version: '1.0.0' }))","+  const stats = jest.spyOn(statsLogger, 'debug')","+  const opts = {","+    configByUri: {},","+    deferDependencyBuilds: false,","+    depsStateCache: {},","+    force: false,","+    holdBackMissingBins: false,","+    ignoreScripts: true,","+    importerDirs: [lockfileDir],","+    lockfileDir,","+    sideEffectsCacheRead: false,","+  }","+  try {","+    await linkHoistedModules({} as StoreController, {}, [installed, missing], { [lockfileDir]: {} }, opts)","+    expect(stats).toHaveBeenLastCalledWith({ prefix: lockfileDir, removed: 1 })","+    expect(fs.existsSync(installed)).toBe(false)","+","+    await linkHoistedModules({} as StoreController, {}, [installed, missing], { [lockfileDir]: {} }, opts)","+    expect(stats).toHaveBeenLastCalledWith({ prefix: lockfileDir, removed: 0 })","+","+    const scope = path.dirname(missing)","+    fs.rmdirSync(scope)","+    fs.writeFileSync(scope, 'not a directory')","+    await linkHoistedModules({} as StoreController, {}, [installed, missing], { [lockfileDir]: {} }, opts)","+    expect(stats).toHaveBeenLastCalledWith({ prefix: lockfileDir, removed: 0 })","+    expect(fs.readFileSync(scope, 'utf8')).toBe('not a directory')","+","+    const parents = Array.from({ length: 17 }, (_, index) => path.join(modulesDir, `parent-${index}`))","+    const children = parents.map((parent) => path.join(parent, 'node_modules/child'))","+    for (const child of children) fs.mkdirSync(child, { recursive: true })","+    await linkHoistedModules({} as StoreController, {}, [...parents, ...children], { [lockfileDir]: {} }, opts)","+    expect(stats).toHaveBeenLastCalledWith({ prefix: lockfileDir, removed: parents.length + children.length })","+    for (const parent of parents) expect(fs.existsSync(parent)).toBe(false)","+  } finally {","+    stats.mockRestore()","+  }","+})"],"additions":55,"deletions":0,"truncated":false},{"path":