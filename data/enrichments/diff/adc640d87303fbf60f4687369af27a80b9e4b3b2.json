e TYPO3\\CMS\\Core\\Authentication\\Pipeline\\Authenticated;","+use TYPO3\\CMS\\Core\\Authentication\\Pipeline\\AuthenticationResult;","+use TYPO3\\CMS\\Core\\Authentication\\Pipeline\\AuthenticatorInterface;","+use TYPO3\\CMS\\Core\\Authentication\\Pipeline\\Challenge;","+use TYPO3\\CMS\\Core\\Authentication\\Pipeline\\LegacyUserPrincipalFactory;","+use TYPO3\\CMS\\Core\\Authentication\\Pipeline\\LoginRateLimiterGuard;","+use TYPO3\\CMS\\Core\\Authentication\\Pipeline\\NotApplicable;","+use TYPO3\\CMS\\Core\\Authentication\\Pipeline\\Realm;","+use TYPO3\\CMS\\Core\\Http\\Response;","+use TYPO3\\CMS\\Core\\Utility\\GeneralUtility;","+","+/**","+ * Performs backend authentication through the legacy user authentication","+ * object and its T3_SERVICES chain, exposed as a pipeline authenticator.","+ * A pending multi-factor requirement is translated into a Challenge","+ * outcome, an established user is handed over as \"legacyUser\" attribute","+ * of the Authenticated outcome.","+ *","+ * @internal not part of TYPO3 Core API, only exists for the migration period","+ *           towards native pipeline authenticators","+ */","+#[AsAuthenticator(realm: 'backend')]","+final class LegacyBackendAuthenticator implements AuthenticatorInterface","+{","+    public function __construct(","+        private readonly LoginRateLimiterGuard $rateLimiterGuard,","+        private readonly MfaChallengeResponseFactory $mfaChallengeResponseFactory,","+        private readonly LegacyUserPrincipalFactory $principalFactory,","+    ) {}","+","+    public function authenticate(ServerRequestInterface $request, Realm $realm): AuthenticationResult","+    {","+        /** @var Route|null $route */","+        $route = $request->getAttribute('route');","+        $isAjaxCall = (bool)($route?->getOption('ajax') ?? false);","+        $mfaRequested = $route?->getOption('_identifier') === 'auth_mfa';","+","+        $user = GeneralUtility::makeInstance(BackendUserAuthentication::class);","+        // The