{"id":"GHSA-wf6j-7hvr-gr93","axis":"advisories","repo":"hydra-ecosystem/hydra","sha":"9a7a9a287d565311183da3392bee4345a7fab6d7","parsed":{"files":[{"path":"hydra/_internal/execution_policy.py","lines":["@@ -356,6 +356,9 @@","     # unpickles a counts file. The inert Trace constructor is excepted below.","     \"shelve.\",","     \"trace.\",","+    # PyYAML exposes Python-object loading and constructor dispatch. Keep only","+    # exact safe load/dump functions available.","+    \"yaml.\",","     # pydoc imports/executes modules and files (importfile runs a file,","     # safeimport imports by name). Inert documentation formatters are excepted","     # below.","@@ -367,7 +370,7 @@","     \"bdb.\","," )"," ","-# Exact legitimate constructors within otherwise denied module families. Exact","+# Exact legitimate targets within otherwise denied module families. Exact"," # entries in UNCONTROLLED_EXECUTION_TARGETS still take precedence over exceptions."," # An exception permits only the named target, not its methods or descendants."," UNCONTROLLED_EXECUTION_TARGET_PREFIX_EXCEPTIONS = frozenset(","@@ -378,6 +381,10 @@","         \"pydoc.HTMLDoc\",","         \"pydoc.TextDoc\",","         \"trace.Trace\",","+        \"yaml.safe_load\",","+        \"yaml.safe_load_all\",","+        \"yaml.safe_dump\",","+        \"yaml.safe_dump_all\",","     }"," )"," "],"additions":8,"deletions":1,"truncated":false},{"path":"hydra/_internal/instantiate/_instantiate2.py","lines":["@@ -523,7 +523,7 @@ def instantiate(","         None","         if execution_whitelist is UNSAFE_DISABLE_EXECUTION_CHECKS","         else _validated_execution_policy(","-            \"5e70100572e2183db32478e51b32d1edd9b9e1af4a47747d10c7b80b8fadf76e\"","+            \"208a0d1fdfebeb40610a31c5aff0373b690af5cbcc1bb1cf3c83cfd8bf3ccf41\"","         )","     )","     token = _ISOLATE_CONFIG_ARGUMENTS.set("],"additions":1,"deletions":1,"truncated":false},{"path":"hydra/_internal/logging_config.py","lines":["@@ -94,7 +94,7