     add.config,","+                manifest","+                    .path()","+                    .parent()","+                    .expect(\"manifest path always has a parent dir\"),","+            ),","+            (&mut dropped_pins, &mut preferred_versions_override),","+        );","         let install_result = add_install(","             add,","             owned,","@@ -225,7 +240,7 @@ where","                 preferred_versions_override,","                 catalogs_override: merged_catalogs_override(","                     catalog_ctx.catalogs,","-                    &updated_catalogs,","+                    &prepared.updated_catalogs,","                 ),","             },","         )","@@ -258,6 +273,7 @@ where","             &owned,","             manifest,","             (selected.projects, &selected_indices),","+            &prepared.picked_versions,","             prepared.catalogs_override,","             &prepared.catalogs,","         );"],"additions":22,"deletions":6,"truncated":false},{"path":"pnpm/crates/package-manager/src/add/install.rs","lines":["@@ -1,13 +1,15 @@"," use super::{","     AddOptions, AddOwned,","-    manifest::{catalog_version_requests, merge_catalogs},","+    manifest::{PickedVersion, catalog_version_requests, merge_catalogs},"," };"," use crate::{","     ImporterUpdateSeedPolicy, Install, PolicyExcludes, ProjectMutation, UpdateSeedPolicy,","     included_direct_groups,"," };","+use node_semver::Version;"," use pnpm_catalogs_types::Catalogs;"," use pnpm_config::Config;","+use pnpm_lockfile::{Lockfile, PkgName, PkgVerPeer, ProjectSnapshot};"," use pnpm_package_manifest::{DependencyGroup, PackageManifest};"," use pnpm_resolving_deps_resolver::{UpdateDepth, UpdateTargets};"," use pnpm_resolving_resolver_base::PreferredVersions;","@@ -54,6 +56,7 @@ pub(super) fn selected_add_seed(","     owned: &AddOwned,","     manifest: &PackageManifest,","     selected: (&[pnpm_workspace::Project], &[usize]),","+    picked_versions: &[Vec<PickedVersion>],","     catalogs_override: Option<Catalogs>,","     catalogs: &Catalogs,"," ) -> AddSeed {","@@ -65,8 +68,8 @@ pub(super) fn selected_add_seed(","     let importer_root = add.config.lockfile_dir_for(manifest_dir);","     let mut seed_policies = BTreeMap::new();","     let mut preferred_versions_override = PreferredVersions::new();","-    for &index in selected_indices {","-        let (names, preferred) = catalog_version_requests(","+    for (&index, picked) in selected_indices.iter().zip(picked_versions) {","+        let (mut names, mut preferred) = catalog_version_requests(","             add.package_names,","             &projects[index].manifest,","             catalogs,","@@ -74,13 +77,17 @@ pub(super) fn selected_add_seed(","             add.config,","             owned.save_catalog_name.as_deref(),","         );","-        if names.is_empty() {","-            continue;","-        }","-        seed_policies.insert(","-            pnpm_workspace::importer_id_from_root_dir(importer_root, &projects[index].root_dir),","-            ImporterUpdateSeedPolicy::DropOnly(unversioned_targets(names)),","+        seed_picked_versions(","+            picked,","+            &LockedVersions::of(add.lockfile.document, add.config, &projects[index].root_dir),","+            (&mut names, &mut preferred),","         );","+        if !names.is_empty() {","+            seed_policies.insert(","+                pnpm_workspace::importer_id_from_root_dir(importer_root, &projects[index].root_dir),","+                ImporterUpdateSeedPolicy::DropOnly(unversioned_targets(names)),","+            );","+        }","         for (name, selectors) in preferred {","             preferred_versions_override","                 .entry(name)","@@ -90,6 +97,88 @@ pub(super) fn selected_add_seed(","     }","     AddSeed { seed_policies, preferred_versions_override, catalogs_override }"," }","+/// Prefer the version an explicit specifier picked, since the saved range can","+/// admit newer ones, and withhold the pin the importer holds at another","+/// version. A pick the fast lockfile update cannot move off needs no seed, so","+/// the install can keep that fast path: the importer keeps its pin and its","+/// specifier, or the lockfile holds no other version to retarget to.","+pub(super) fn seed_picked_versions(","+    picked_versions: &[PickedVersion],","+    locked: &LockedVersions<'_>,","+    seed: (&mut HashSet<String>, &mut PreferredVersions),","+) {","+    let (dropped_pins, preferred) = seed;","+    for PickedVersion { name, version, specifier } in picked_versions {","+        let (Ok(package), Ok(semver)) = (name.parse::<PkgName>(), version.parse::<Version>())","+        else {","+            continue;","+        };","+        let direct = locked.direct(&package);","+        let pinned_elsewhere = direct.is_some_and(|(locked, _)| {","+            !locked.is_some_and(|locked| same_build(locked, &semver))","+        });","+        let settled = match direct {","+            Some(_) if pinned_elsewhere => false,","+            Some((_, locked_specifier)) if locked_specifier == specifier => true,","+            _ => locked.only_version_of(&package, &semver),","+        };","+        if settled {","+            continue;","+        }","+        crate::install_with_fresh_lockfile::prefer_requested_version(preferred, name, version);","+        if pinned_elsewhere {","+            dropped_pins.insert(name.clone());","+        }","+    }","+}","+/// What the wanted lockfile holds for the importer an add rewrites.","+pub(super) struct LockedVersions<'l> {","+    lockfile: Option<&'l Lockfile>,","+    importer: Option<&'l ProjectSnapshot>,","+}","+impl<'l> LockedVersions<'l> {","+    pub(super) fn of(","+        lockfile: Option<&'l Lockfile>,","+        config: &Config,","+        manifest_dir: &std::path::Path,","+    ) -> Self {","+        let importer_id = pnpm_workspace::importer_id_from_root_dir(","+            config.lockfile_dir_for(manifest_dir)