pnpm.e2e/dep-of-pkg-with-1-dep@>=100.0.0 <100.1.0\",","+        \"--lockfile-only\",","+    ]);","+    assert_eq!(prod_spec(&dir, \"@pnpm.e2e/dep-of-pkg-with-1-dep\"), \"^100.0.0\");","+    assert_eq!(locked_version(&dir, \"@pnpm.e2e/dep-of-pkg-with-1-dep\"), \"100.0.0\");","+    drop((root, anchor)); // cleanup","+}","+","+/// The specifier the add saves is the one already declared, so only the","+/// picked version can move the lockfile off `100.1.0`.","+#[test]","+fn readd_moves_the_lockfile_to_the_picked_version() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let name = \"@pnpm.e2e/dep-of-pkg-with-1-dep\";","+    std::fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({ \"dependencies\": { (name): \"^100.0.0\" } }).to_string(),","+    )","+    .expect(\"write package.json\");","+    pacquet","+        .with_arg(\"install\")","+        .with_arg(\"--lockfile-only\")","+        .assert()","+        .success();","+    assert_eq!(locked_version(&workspace, name), \"100.1.0\");","+","+    pacquet_in(&workspace)","+        .with_args([\"add\", &format!(\"{name}@>=100.0.0 <100.1.0\"), \"--lockfile-only\"])","+        .assert()","+        .success();","+","+    assert_eq!(prod_spec(&workspace, name), \"^100.0.0\");","+    assert_eq!(locked_version(&workspace, name), \"100.0.0\");","+    drop((root, npmrc_info)); // cleanup","+}","+","+/// `@pnpm.e2e/pkg-with-1-dep` locks `100.1.0` transitively, which the saved","+/// `^100.0.0` also admits.","+#[test]","+fn add_locks_the_picked_version_over_a_transitive_lock() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let name = \"@pnpm.e2e/dep-of-pkg-with-1-dep\";","+    std::fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({ \"dependencies\": { \"@pnpm.e2e/pkg-with-1-dep\": \"100.0.0\" } }).to_string(","+        ),","+    )","+    .expect(\"write package.json\");","+    pacquet","+        .with_arg(\"install\")","+        .with_arg(\"--lockfile-only\")","+        .assert()","+        .success();","+","+    pacquet_in(&workspace)","+        .with_args([\"add\", &format!(\"{name}@>=100.0.0 <100.1.0\"), \"--lockfile-only\"])","+        .assert()","+        .success();","+","+    assert_eq!(prod_spec(&workspace, name), \"^100.0.0\");","+    assert_eq!(locked_version(&workspace, name), \"100.0.0\");","+    drop((root, npmrc_info)); // cleanup","+}","+","+#[test]","+fn filtered_add_locks_the_picked_version_over_a_transitive_lock() {","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let name = \"@pnpm.e2e/dep-of-pkg-with-1-dep\";","+    let workspace_yaml = workspace.join(\"pnpm-workspace.yaml\");","+    let settings = std::fs::read_to_string(&workspace_yaml).expect(\"read pnpm-workspace.yaml\");","+    std::fs::write(&workspace_yaml, format!(\"{settings}\\npackages:\\n  - app\\n\"))","+        .expect(\"write pnpm-workspace.yaml\");","+    std::fs::write(workspace.join(\"package.json\"), r#\"{ \"name\": \"root\" }\"#)","+        .expect(\"write root package.json\");","+    let app = workspace.join(\"app\");","+    std::fs::create_dir(&app).expect(\"create app\");","+    std::fs::write(","+        app.join(\"package.json\"),","+        serde_json::json!({ \"name\": \"app\", \"dependencies\": { \"@pnpm.e2e/pkg-with-1-dep\": \"100.0.0\" } })","+            .to_string(),","+    )","+    .expect(\"write app/package.json\");","+    pacquet_in(&workspace)","+        .with_args([\"install\", \"--lockfile-only\"])","+        .assert()","+        .success();","+","+    pacquet_in(&workspace)","+        .with_args([","+            \"--filter\",","+            \"app\",","+            \"add\",","+            &format!(\"{name}@>=100.0.0 <100.1.0\"),","+            \"--lockfile-only\",","+        ])","+        .assert()","+        .success();","+","+    assert_eq!(prod_spec(&app, name), \"^100.0.0\");","+    let lockfile = crate::_utils::read_lockfile(&workspace.join(\"pnpm-lock.yaml\"));","+    assert_eq!(crate::_utils::importer_version(&lockfile, \"app\", name), \"100.0.0\");","+    drop((root, npmrc_info)); // cleanup","+}","+","+/// The direct edge already locks the picked `100.0.0`, but the add changes","+/// its specifier, which the fast lockfile update would retarget to the","+/// `100.1.0` the alias locks.","+#[test]","+fn readd_with_a_new_specifier_keeps_the_picked_version() {","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = CommandTempCwd::init().add_mocked_registry();","+    let name = \"@pnpm.e2e/dep-of-pkg-with-1-dep\";","+    std::fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({","+            \"dependencies\": {","+                (name): \">=100.0.0 <100.1.0\",","+                \"newer\": format!(\"npm:{name}@100.1.0\"),","+            }","+        })","+        .to_string(),","+    )","+    .expect(\"write package.json\");","+    pacquet","+        .with_arg(\"install\")","+        .with_arg(\"--lockfile-only\")","+        .assert()","+        .success();","+    assert_eq!(locked_version(&workspace, name), \"100.0.0\");","+","+    pacquet_in(&workspace)","+        .with_args([\"add\", &format!(\"{name}@<100.1.0\")])","+        .assert()","+        .success();","+","+    assert_eq!(prod_spec(&workspace, name), \"^100.0.0\");","+    assert_eq!(locked_version(&workspace, name), \"100.0.0\");","+    drop((root, npmrc_info)); // cleanup","+}","+","+fn pacquet_in(workspace: &std::path::Path) -> std::process::Command {","+    std::process::Command::cargo_bin(\"pnpm\")","+        .expect(\"find the pnpm binary\")","+        .with_current_dir(workspace)","+}","+","+fn locked_version(workspace: &std::path::Path, name: &str) -> String {","+    let lockfile = crate::_utils::read_lockfile(&workspace.join(\"pnpm-lock.yaml\"));","+    crate::_utils::importer_version(&lockfile, \".\", name)","+}","+"," #[test]"," fn readding_a_dev_dependency_at_a_dist_tag_keeps_its_group() {","     let CommandTempCwd {"],"additions":193,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/add_types.rs","lines":["@@ -476,7 +476,7 @@ fn bulk_add_fetches_only_required_metadata_formats() {","                 .with_header(\"content-type\", \"application/json\")","                 .with_header(\"etag\", METADATA_ETAG)","                 .with_body(packument.to_string())","-                .expect(1 + usize::from(types_package))","+                .expect(1)","                 .create(),","         );","     }"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/config_includes.rs","lines":["@@ -265,7 +265,7 @@ fn a_config_dependency_packed_with_pnpm_pack_keeps_its_config_entry() {","         &workspace,","         \"pnpm-workspace.yaml\",","         &format!(","-            \"configDependencies:\\n  '@acme/pnpm-policy':\\n    integrity: 1.0.0+{integrity}\\n    tarball: {}{tarball_path}\\ninclude:\\n  '@acme/pnpm-policy': [nodeLinker]\\n\",","+            \"storeDir: ../store\\ncacheDir: ../cache\\nconfigDependencies:\\n  '@acme/pnpm-policy':\\n    integrity: 1.0.0+{integrity}\\n    tarball: {}{tarball_path}\\ninclude:\\n  '@acme/pnpm-policy': [nodeLinker]\\n\",","             server.url(),","         ),","     );"],"additions":1,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/lockfile_resolution_reuse/mutations.rs","lines":["@@ -704,6 +704,68 @@ fn add_command_reuses_a_locked_version_without_resolving() {","     drop((root, mock_instance));"," }"," ","+#[test]","+fn promoting_the_locked_version_through_a_range_skips_resolution() {","