{"id":"aeeba836c409103831d1d5d57e1dfcbcffdbcfa8","axis":"silent","repo":"pnpm/pnpm","sha":"aeeba836c409103831d1d5d57e1dfcbcffdbcfa8","parsed":{"files":[{"path":".changeset/registries-default-scope-warning.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+pnpm no longer warns that a `registries` entry routed through the `@` scope matches no configured registry. pnpm applied such an entry and its options such as `serverType` while reporting it as ignored [pnpm/tasks#184](https://github.com/pnpm/tasks/issues/184)."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/config_warnings.rs","lines":["@@ -59,7 +59,8 @@ fn unmatched_registry_options_warning(config: &Config) -> Option<String> {","     if config.registry_options_by_url.is_empty() {","         return None;","     }","-    let configured: BTreeSet<&str> = config.registries_by_scope","+    let registries_by_scope = config.resolved_registries();","+    let configured: BTreeSet<&str> = registries_by_scope","         .values()","         .chain(config.registries_by_prefix.values())","         .map(String::as_str)"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/config_warnings/tests.rs","lines":["@@ -7,12 +7,16 @@ use pnpm_config::{Config, ProjectConfig};"," use pnpm_lockfile::{RegistryOptions, RegistryServerType};"," use pretty_assertions::assert_eq;"," ","+/// `registries` are keyed by scope; a `default` entry is the default","+/// registry, which a registry override records under both fields."," fn config_with(registries: &[(&str, &str)], registry_options_by_url: &[&str]) -> Config {","     let mut config = Config::new();","-    config.registries_by_scope = registries","-        .iter()","-        .map(|(scope, url)| ((*scope).to_string(), (*url).to_string()))","-        .collect();","+    for (scope, url) in registries {","+        if *scope == \"default\" {","+            config.registry = (*url).to_string();","+        }","+        config.registries_by_scope.insert((*scope).to_string(), (*url).to_string());","+    }","     config.registry_options_by_url = registry_options_by_url","         .iter()","         .map(|registry| {","@@ -52,6 +56,17 @@ fn no_warning_for_a_builtin_named_registry() {","     assert_eq!(unmatched_registry_options_warning(&config), None);"," }"," ","+/// A `registries` entry whose only route is the bare `@` scope becomes the","+/// default registry and is stored under no scope, so it must be matched","+/// through `config.registry`.","+#[test]","+fn no_warning_for_an_entry_routed_only_through_the_default_scope() {","+    let mut config = config_with(&[], &[\"https://pnpr.example.com/npm/\"]);","+    config.registry = \"https://pnpr.example.com/npm/\".to_string();","+    assert!(config.registries_by_scope.is_empty());","+    assert_eq!(unmatched_registry_options_warning(&config), None);","+}","+"," #[test]"," fn warns_about_an_entry_matching_no_configured_registry() {","     let config = config_with("],"additions":19,"deletions":4,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/tar_registry.rs","lines":["@@ -119,6 +119,34 @@ fn installs_from_a_tar_registry_and_pins_the_tar_hashes() {","     drop((root, npmrc_info));"," }"," ","+/// An entry routed only through the bare `@` scope is the default registry:","+/// the install resolves through it with the entry's `serverType`, so it must","+/// not be reported as an entry that matches no registry.","+/// <https://github.com/pnpm/tasks/issues/184>","+#[test]","+fn an_entry_routed_through_the_default_scope_is_not_reported_as_unmatched() {","+    let (env, tar_registry) = project();","+    let CommandTempCwd {","+        pacquet,","+        root,","+        workspace,","+        npmrc_info,","+        ..","+    } = env;","+    use_tar_registry(&workspace, &tar_registry, Some(\"pnpr\"));","+    let output = pacquet","+        .with_args([\"install\", \"--lockfile-only\"])","+        .assert()","+        .success();","+    let stderr = String::from_utf8_lossy(&output.get_output().stderr).into_owned();","+    println!(\"{stderr}\");","+    assert!(!stderr.contains(\"do not match any configured registry\"), \"{stderr}\");","+    let lockfile = fs::read_to_string(workspace.join(\"pnpm-lock.yaml\")).unwrap();","+    assert!(!lockfile.contains(\"tarball:\"), \"the entry's serverType applied: {lockfile}\");","+    assert_pins_tar_hashes(&workspace, &tar_registry);","+    drop((root, npmrc_info));","+}","+"," #[test]"," fn a_lockfile_only_resolution_records_the_hash_a_tar_registry_omits() {","     let (env, tar_registry) = project();",""],"additions":28,"deletions":0,"truncated":false}],"additions":54,"deletions":5,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-10-23T14:14:48.508300+00:00"}