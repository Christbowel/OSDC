{"id":"3a8473cd02a6d8e131ad0469f4719c1006a55f81","axis":"silent","repo":"envoyproxy/envoy","sha":"3a8473cd02a6d8e131ad0469f4719c1006a55f81","parsed":{"files":[{"path":"changelogs/current/minor_behavior_changes/quic__upstream-auto-host-sni.rst","lines":["@@ -0,0 +1,7 @@","+Upstream HTTP/3 connections now honor :ref:`auto_host_sni","+<envoy_v3_api_field_extensions.transport_sockets.tls.v3.UpstreamTlsContext.auto_host_sni>` and send","+the upstream host's hostname as SNI. The server certificate must match that hostname. Hostnames","+that are not valid SNI, such as IP addresses, are ignored. Clusters with HTTP/3 enabled in","+``auto_config`` also look up the hostname in the alternate protocols cache. This behavioral change","+can be temporarily reverted by setting the runtime guard","+``envoy.reloadable_features.quic_upstream_auto_host_sni`` to ``false``."],"additions":7,"deletions":0,"truncated":false},{"path":"source/common/http/conn_pool_grid.cc","lines":["@@ -29,13 +29,9 @@ static constexpr uint32_t kDefaultTimeoutMs = 300;"," "," std::string getTargetHostname(const Network::TransportSocketOptionsConstSharedPtr& options,","                               Upstream::HostConstSharedPtr& host) {","-  if (options && options->serverNameOverride().has_value()) {","-    return options->serverNameOverride().value();","-  }","-  std::string default_sni =","-      std::string(host->transportSocketFactory().defaultServerNameIndication());","-  if (!default_sni.empty()) {","-    return default_sni;","+  std::string sni = Http3::effectiveSni(options, *host);","+  if (!sni.empty()) {","+    return sni;","   }","   // If there's no configured SNI the hostname is probably an IP address. Return it here.","   return host->hostname();"],"additions":3,"deletions":7,"truncated":false},{"path":"source/common/http/conn_pool_grid.h","lines":["@@ -290,7 +290,8 @@ class ConnectivityGrid : public ConnectionPool::Instance,"," ","   // The origin for this pool.","   // Note the host name here is based off of the host name used for SNI, which","-  // may be from the cluster config, or the request headers for auto-sni.","+  // may be from the cluster config, the upstream host's hostname, or the request","+  // headers for auto-sni.","   HttpServerPropertiesCache::Origin origin_;"," ","   Http::PersistentQuicInfo& quic_info_;"],"additions":2,"deletions":1,"truncated":false},{"path":"source/common/http/http3/BUILD","lines":["@@ -21,6 +21,7 @@ envoy_cc_library(","         \"//source/common/http:conn_pool_base_lib\",","         \"//source/common/quic:client_connection_factory_lib\",","         \"@quiche//:quic_core_deterministic_connection_id_generator_lib\",","+        \"@quiche//:quic_platform_hostname_utils\",","     ]),"," )"," "],"additions":1,"deletions":0,"truncated":false},{"path":"source/common/http/http3/conn_pool.cc","lines":["@@ -13,6 +13,8 @@"," #include \"source/common/runtime/runtime_features.h\""," #include \"source/common/upstream/upstream_impl.h\""," ","+#include \"quiche/quic/platform/api/quic_hostname_utils.h\"","+"," namespace Envoy {"," namespace Http {"," namespace Http3 {","@@ -45,21 +47,26 @@ uint32_t getMaxStreams(const Upstream::ClusterInfo& cluster) {","       100);"," }"," ","-const Envoy::Ssl::ClientContextConfig&","-getConfig(Network::UpstreamTransportSocketFactory& transport_socket_factory) {","-  ASSERT(transport_socket_factory.clientContextConfig().has_value());","-  return transport_socket_factory.clientContextConfig().value();","-}","+} // namespace"," ","-std::string sni(const Network::TransportSocketOptionsConstSharedPtr& options,","-                Upstream::HostConstSharedPtr host) {","-  return options && options->serverNameOverride().has_value()","-             ? options->serverNameOverride().value()","-             : getConfig(host->transportSocketFactory()).serverNameIndication();","+std::string effectiveSni(const Network::TransportSocketOptionsConstSharedPtr& options,","+                         const Upstream::HostDescription& host) {","+  if (options && options->serverNameOverride().has_value()) {","+    return options->serverNameOverride().value();","+  }","+  const Network::UpstreamTransportSocketFactory& factory = host.transportSocketFactory();","+  OptRef<const Envoy::Ssl::ClientContextConfig> config = factory.clientContextConfig();","+  const std::string& hostname = host.hostname();","+  // QUICHE does not send an invalid SNI but still verifies the certificate against it, so an","+  // invalid hostname such as an IP address falls back to the configured SNI.","+  if (config.has_value() && config->autoHostServerNameIndication() &&","+      quic::QuicHostnameUtils::IsValidSNI(hostname) &&","+      Runtime::runtimeFeatureEnabled(\"envoy.reloadable_features.quic_upstream_auto_host_sni\")) {","+    return hostname;","+  }","+  return std::string(factory.defaultServerNameIndication());"," }"," ","-} // namespace","-"," ActiveClient::ActiveClient(Envoy::Http::HttpConnPoolImplBase& parent,","                            Upstream::Host::CreateConnectionData& data)","     : MultiplexedActiveClientBase(","@@ -124,7 +131,7 @@ Http3ConnPoolImpl::Http3ConnPoolImpl(","                             random_generator, state, client_fn, codec_fn, protocol,","                             overload_manager, {}, nullptr),","       quic_info_(dynamic_cast<Quic::PersistentQuicInfoImpl&>(quic_info)),","-      server_id_(sni(transport_socket_options, host),","+      server_id_(effectiveSni(transport_socket_options, *host),","                  static_cast<uint16_t>(host_->address()->ip()->port())),","       connect_callback_(connect_callback), attempt_happy_eyeballs_(attempt_happy_eyeballs),","       network_observer_registry_(network_observer_registry) {}"],"additions":20,"deletions":13,"truncated":false},{"path":"source/common/http/http3/conn_pool.h","lines":["@@ -214,6 +214,12 @@ class Http3ConnPoolImpl : public FixedHttpConnPoolImpl {","   OptRef<Quic::EnvoyQuicNetworkObserverRegistry> network_obser