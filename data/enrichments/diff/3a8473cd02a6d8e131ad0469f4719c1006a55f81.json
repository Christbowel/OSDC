 hostname_;","   NiceMock<Server::Configuration::MockTransportSocketFactoryContext> context_;","+  NiceMock<Ssl::MockClientContextConfig>* client_context_config_{nullptr};","   std::unique_ptr<Quic::QuicClientTransportSocketFactory> factory_;","+  Network::TransportSocketOptionsConstSharedPtr transport_socket_options_;","   Ssl::ClientContextSharedPtr ssl_context_{new NiceMock<Ssl::MockClientContext>()};","   Stats::IsolatedStoreImpl store_{context_.server_context_.serverScope().symbolTable()};","   Quic::QuicStatNames quic_stat_names_{store_.symbolTable()};","@@ -319,6 +324,50 @@ TEST_F(Http3ConnPoolImplTest, GetNetworkChangeEvents) {","   observers_.onNetworkDisconnected(-1);"," }"," ","+TEST_F(Http3ConnPoolImplTest, ServerIdUsesConfiguredSniWithoutAutoHostSni) {","+  hostname_ = \"upstream.example.com\";","+  initialize();","+  EXPECT_EQ(\"default_sni.example.com\", Http3ConnPoolImplPeer::getServerId(*pool_).host());","+}","+","+TEST_F(Http3ConnPoolImplTest, ServerIdUsesHostnameWithAutoHostSni) {","+  ON_CALL(*client_context_config_, autoHostServerNameIndication()).WillByDefault(Return(true));","+  hostname_ = \"upstream.example.com\";","+  initialize();","+  EXPECT_EQ(\"upstream.example.com\", Http3ConnPoolImplPeer::getServerId(*pool_).host());","+}","+","+TEST_F(Http3ConnPoolImplTest, ServerIdUsesConfiguredSniWithAutoHostSniAndNoHostname) {","+  ON_CALL(*client_context_config_, autoHostServerNameIndication()).WillByDefault(Return(true));","+  initialize();","+  EXPECT_EQ(\"default_sni.example.com\", Http3ConnPoolImplPeer::getServerId(*pool_).host());","+}","+","+TEST_F(Http3ConnPoolImplTest, ServerIdUsesConfiguredSniWithAutoHostSniAndIpHostname) {","+  ON_CALL(*client_context_config_, autoHostServerNameIndication()).WillByDefault(Return(true));","+  hostname_ = \"127.0.0.1\";","+  initialize();","+  EXPECT_EQ(\"default_sni.example.com\", Http3ConnPoolImplPeer::getServerId(*pool_).host());","+}","+","+TEST_F(Http3ConnPoolImplTest, ServerIdUsesServerNameOverrideWithAutoHostSni) {","+  ON_CALL(*client_context_config_, autoHostServerNameIndication()).WillByDefault(Return(true));","+  hostname_ = \"upstream.example.com\";","+  transport_socket_options_ =","+      std::make_shared<Network::TransportSocketOptionsImpl>(\"override.example.com\");","+  initialize();","+  EXPECT_EQ(\"override.example.com\", Http3ConnPoolImplPeer::getServerId(*pool_).host());","+}","+","+TEST_F(Http3ConnPoolImplTest, ServerIdUsesConfiguredSniWithAutoHostSniAndRuntimeGuardDisabled) {","+  TestScopedRuntime scoped_runtime;","+  scoped_runtime.mergeValues({{\"envoy.reloadable_features.quic_upstream_auto_host_sni\", \"false\"}});","+  ON_CALL(*client_context_config_, autoHostServerNameIndication()).WillByDefault(Return(true));","+  hostname_ = \"upstream.example.com\";","+  initialize();","+  EXPECT_EQ(\"default_sni.example.com\", Http3ConnPoolImplPeer::getServerId(*pool_).host());","+}","+"," } // namespace Http3"," } // namespace Http"," } // namespace Envoy"],"additions":59,"deletions":10,"truncated":false},{"path":"test/extensions/filters/http/alternate_protocols_cache/filter_integration_test.cc","lines":["@@ -61,11 +61,40 @@ name: alternate_protocols_cache","     upstream_tls_ = true;","     // This configures the upstream to use the connection grid (automatically","     // selecting protocol and allowing HTTP/3)","-    config_helper_.configureUpstreamTls(/*use_alpn=*/true, /*http3=*/true, alt_cache);","+    config_helper_.configureUpstreamTls(","+        /*use_alpn=*/true, /*http3=*/true, alt_cache,","+        [this](envoy::extensions::transport_sockets::tls::v3::UpstreamTlsContext& tls_context) {","+          tls_context.set_auto_host_sni(auto_host_sni_);","+        });","+    if (auto_host_sni_) {","+      config_helper_.addConfigModifier([](envoy::config::bootstrap::v3::Bootstrap& bootstrap) {","+        auto* cluster = bootstrap.mutable_static_resources()->mutable_clusters(0);","+        cluster->mutable_load_assignment()","+            ->mutable_endpoints(0)","+            ->mutable_lb_endpoints(0)","+            ->mutable_endpoint()","+            ->set_hostname(\"upstream.lyft.com\");","+        // Turn off `auto_sni` so that the request host does not override the SNI.","+        auto& protocol_options = (*cluster->mutable_typed_extension_protocol_options())","+            [\"envoy.extensions.upstreams.http.v3.HttpProtocolOptions\"];","+        auto http_protocol_options =","+            MessageUtil::anyConvert<ConfigHelper::HttpProtocolOptions>(protocol_options);","+        http_protocol_options.mutable_upstream_http_protocol_options()->set_auto_sni(false);","+        std::ignore = protocol_options.PackFrom(http_protocol_options);","+      });","+    }"," ","     HttpProtocolIntegrationTest::initialize();","   }"," ","+  // Returns the SNI that the current upstream connection received.","+  std::string upstreamSni() {","+    std::string sni;","+    EXPECT_TRUE(fake_upstream_connection_->sharedConnection().executeOnDispatcher(","+        [&sni](Network::Connection& connection) { sni = connection.ssl()->sni(); }));","+    return sni;","+  }","+","   void writeAltSvcToFile(uint32_t index) {","     uint32_t port = fake_upstreams_[index]->localAddress()->ip()->port();","     std::string key = absl::StrCat(\"https://sni.lyft.com:\", port);","@@ -122,6 +151,8 @@ name: alternate_protocols_cache","   // If this is set to true, it pre-fills the alt-svc cache, setting up HTTP/3","   // support and pointing at the HTTP/3 upstream.","   bool write_alt_svc_to_file_ = false;","+  // If this is set to true, the upstream host has a hostname and the cluster sets `auto_host_sni`.","+  bool auto_host_sni_ = false;"," };"," "," TEST_P(FilterIntegrationTest, AltSvc) {","@@ -161,6 +192,37 @@ TEST_P(FilterIntegrationTest, AltSvc) {","   test_server_->waitForCounter(\"cluster.cluster_0.upstream_cx_http3_total\", Eq(1));"," }"," ","+// With `auto_host_sni`, the Alt-Svc header is cached for the upstream host's hostname. The grid","+// looks up that hostname to find HTTP/3, and the HTTP/3 connection sends it as SNI.","+TEST_P(FilterIntegrationTest, AltSvcWithAutoHostSni) {","+  auto_host_sni_ = true;","+  initialize();","+  codec_client_ = makeHttpConnection(makeClientConnection(lookupPort(\"http\")));","+","+  int port = fake_upstreams_[1]->localAddress()->ip()->port();","+  std::string alt_svc = absl::StrCat(\"h3=\\\":\", port, \"\\\"; ma=86400\");","+  Http::TestResponseHeaderMapImpl response_headers{{\":status\", \"200\"}, {\"alt-svc\", alt_svc}};","+","+  // The first request goes out over HTTP/2 and caches the Alt-Svc header.","+  auto response =","+      sendRequestAndWaitForResponse(default_request_headers_, 0, response_headers, 0, 0);","+  checkSimpleRequestSuccess(0, 0, response.get());","+  EXPECT_EQ(\"upstream.lyft.com\", upstreamSni());","+  test_server_->waitForCounter(\"cluster.cluster_0.upstream_cx_http2_total\", Eq(1));","+  ASSERT_TRUE(fake_upstream_connection_->close());","+  test_server_->waitForCounter(\"cluster.cluster_0.upstream_cx_destroy\", Eq(1));","+  fake_upstream_connection_.reset();","+  // Stop the HTTP/2 upstream so that only HTTP/3 can serve the next request.","+  fake_upstreams_[0]->cleanUp();","+","+  // The second request goes out over HTTP/3 because of the cached Alt-Svc header.","+  auto response2 =","+      sendRequestAndWaitForResponse(default_request_headers_, 0, response_headers, 0, 1);","+  checkSimpleRequestSuccess(0, 0, response2.get());","+  EXPECT_EQ(\"upstream.lyft.com\", upstreamSni());","+  test_server_->waitForCounter(\"cluster.cluster_0.upstream_cx_http3_total\", Eq(1));","+}","+"," TEST_P(FilterIntegrationTest, AltSvcCached) {","   // Start with the alt-svc header in the cache.","   write_alt_svc_to_file_ = true;"],"additions":63,"deletions":1,"truncated":false},{"path":"test/integration/quic_http_integration_test.cc","lines":["@@ -2460,5 +2460,91 @@ TEST_P(QuicHttpIntegrationTest, FirstRequestSucceedsWithoutEnvoyBugOnNewConnecti","   codec_client_->close();"," }"," ","+class QuicUpstreamAutoHostSniIntegrationTest : public QuicHttpIntegrationTest {","+public:","+  void initialize() override {","+    setUpstreamProtocol(Http::CodecType::HTTP3);","+    config_helper_.addConfigModifier([this](envoy::config::bootstrap::v3::Bootstrap& bootstrap) {","+      auto* cluster = bootstrap.mutable_static_resources()->mutable_clusters(0);","+      cluster->mutable_load_assignment()","+          ->mutable_endpoints(0)","+          ->mutable_lb_endpoints(0)","+          ->mutable_endpoint()","+          ->set_hostname(upstream_hostname_);","+      // Turn off `auto_sni` so that the request host does not override the SNI.","+      auto& protocol_options = (*cluster->mutable_typed_extension_protocol_options())","+          [\"envoy.extensions.upstreams.http.v3.HttpProtocolOptions\"];","+      auto http_protocol_options =","+          MessageUtil::anyConvert<ConfigHelper::HttpProtocolOptions>(protocol_options);","+      http_protocol_options.mutable_upstream_http_protocol_options()->set_auto_sni(false);","+      std::ignore = protocol_options.PackFrom(http_protocol_options);","+      auto* transport_socket = cluster->mutable_transport_socket();","+      auto quic_transport = MessageUtil::anyConvert<","+          envoy::extensions::transport_sockets::quic::v3::QuicUpstreamTransport>(","+          transport_socket->typed_config());","+      quic_transport.mutable_upstream_tls_context()->set_auto_host_sni(true);","+      std::ignore = transport_socket->mutable_typed_config()->PackFrom(quic_transport);","+    });","+    QuicHttpIntegrationTest::initialize();","+  }","+","+  // Sends a request through the HTTP/3 cluster and checks the SNI that the upstream received.","+  void expectUpstreamSni(absl::string_view expected_sni) {","+    codec_client_ = makeHttpConnection(makeClientConnection(lookupPort(\"http\")));","+    auto response = codec_client_->makeHeaderOnlyRequest(default_request_headers_);","+    waitForNextUpstreamRequest();","+    std::string sni;","+    ASSERT_TRUE(fake_upstream_connection_->sharedConnection().executeOnDispatcher(","+        [&sni](Network::Connection& connection) { sni = connection.ssl()->sni(); }));","+    EXPECT_EQ(expected_sni, sni);","+    upstream_request_->encodeHeaders(default_response_headers_, true);","+    ASSERT_TRUE(response->waitForEndStream());","+    EXPECT_EQ(\"200\", response->headers().getStatusValue());","+    codec_client_->close();","+  }","+","+  std::string upstream_hostname_{\"upstream.lyft.com\"};","+};","+","+INSTANTIATE_TEST_SUITE_P(QuicHttpIntegrationTests, QuicUpstreamAutoHostSniIntegrationTest,","+                         testing::ValuesIn(TestEnvironment::getIpVersionsForTest()),","+                         TestUtility::ipTestParamsToString);","+","+// The upstream host's hostname takes precedence over the configured SNI.","+TEST_P(QuicUpstreamAutoHostSniIntegrationTest, UsesHostname) {","+  initialize();","+  expectUpstreamSni(\"upstream.lyft.com\");","+}","+","+// The server certificate is validated against the upstream host's hostname.","+TEST_P(QuicUpstreamAutoHostSniIntegrationTest, FailsWhenCertificateDoesNotMatchHostname) {","+  upstream_hostname_ = \"upstream.example.com\";","+  initialize();","+  codec_client_ = makeHttpConnection(makeClientConnection(lookupPort(\"http\")));","+  auto response = codec_client_->makeHeaderOnlyRequest(default_request_headers_);","+  ASSERT_TRUE(response->waitForEndStream());","+  EXPECT_EQ(\"503\", response->headers().getStatusValue());","+  test_server_->waitForCounter(","+      \"http3.upstream.tx.quic_connection_close_error_code_QUIC_TLS_CERTIFICATE_UNKNOWN\", Eq(1));","+  test_server_->waitForCounter(\"cluster.cluster_0.upstream_cx_connect_fail\", Eq(1));","+  codec_client_->close();","+}","+","+// Hostnames that are not valid SNI fall back to the configured SNI.","+TEST_P(QuicUpstreamAutoHostSniIntegrationTest, UsesConfiguredSniWithIpHostname) {","+  upstream_hostname_ = Network::Test::getLoopbackAddressString(version_);","+  initialize();","+  expectUpstreamSni(\"foo.lyft.com\");","+}","+","+// Disabling the runtime guard restores the previous behavior.","+TEST_P(QuicUpstreamAutoHostSniIntegrationTest, UsesConfiguredSniWithRuntimeGuardDisabled) {","+  config_helper_.addRuntimeOverride(\"envoy.reloadable_features.quic_upstream_auto_host_sni\",","+                                    \"false\");","+  upstream_hostname_ = \"upstream.example.com\";","+  initialize();","+  expectUpstreamSni(\"foo.lyft.com\");","+}","+"," } // namespace Quic"," } // namespace Envoy",""],"additions":86,"deletions":0,"truncated":false}],"additions":273,"deletions":32,"truncated":false,"file_count":12},"error":null,"fetched_at":"2026-10-14T13:05:39.228581+00:00"}