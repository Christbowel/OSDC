{"id":"4a0a639de6b7b427c0d1924f093e35d96e6e05f2","axis":"silent","repo":"envoyproxy/envoy","sha":"4a0a639de6b7b427c0d1924f093e35d96e6e05f2","parsed":{"files":[{"path":"changelogs/current/behavior_changes/geoip__sanitize-geo-headers.rst","lines":["@@ -0,0 +1,8 @@","+The :ref:`HTTP geoip filter <config_http_filters_geoip>` now removes every configured geolocation header","+from the incoming request before the lookup, so a header a client sent is never forwarded upstream as if the","+lookup had set it. Previously a client-supplied header was kept whenever the lookup had no value for it: an","+address absent from the database, a database error, a field the database lacks for that address, or a request","+whose lookup was skipped because the downstream address was not an IP address. Geolocation providers report the","+headers they are configured to write through the new ``Driver::geoHeaderNames()`` method, which defaults to","+empty for providers that do not implement it. This behavior can be reverted by setting the runtime guard","+``envoy.reloadable_features.geoip_sanitize_geo_headers`` to ``false``."],"additions":8,"deletions":0,"truncated":false},{"path":"docs/root/configuration/http/http_filters/geoip_filter.rst","lines":["@@ -5,7 +5,11 @@ IP Geolocation Filter"," This filter decorates HTTP requests with the geolocation data."," Filter uses client address to lookup information (e.g., client's city, country) in the geolocation provider database."," Upon a successful lookup request will be enriched with the configured geolocation header and the value from the database.","-In case the configured geolocation headers are present in the incoming request, they will be overridden by the filter.","+The configured geolocation headers are removed from the incoming request before the lookup, so a value a client","+sent is never forwarded as if the lookup had produced it: after the filter, a geolocation header is present only","+if the lookup populated it. This removal can be disabled by setting the runtime guard","+``envoy.reloadable_features.geoip_sanitize_geo_headers`` to ``false``, in which case a client-supplied header is","+kept whenever the lookup has no value for it."," Geolocation filter emits stats for the number of the successful lookups and the number of total lookups."," English language is used for the geolocation lookups, the result of the lookup will be UTF-8 encoded."," Please note that Geolocation filter and providers are not yet supported on Windows."],"additions":5,"deletions":1,"truncated":false},{"path":"envoy/geoip/BUILD","lines":["@@ -19,6 +19,7 @@ envoy_cc_library(","     tags = [\"skip_on_windows\"],","     deps = [","         \"//envoy/config:typed_config_interface\",","+        \"//envoy/http:header_map_interface\",","         \"//envoy/network:address_interface\",","         \"//envoy/protobuf:message_validator_interface\",","         \"//envoy/server:factory_context_interface\","],"additions":1,"deletions":0,"truncated":false},{"path":"envoy/geoip/geoip_provider_driver.h","lines":["@@ -1,11 +1,13 @@"," #pragma once"," "," #include \"envoy/config/typed_config.h\"","+#include \"envoy/http/header_map.h\""," #include \"envoy/network/address.h\""," #include \"envoy/protobuf/message_validator.h\""," #include \"envoy/server/factory_context.h\""," "," #include \"absl/container/flat_hash_set.h\"","+#include \"absl/types/span.h\""," "," namespace Envoy {"," namespace Geolocation {","@@ -40,6 +42,17 @@ class Driver {","    *  @param cb supplies the filter callbacks to notify when lookup is complete.","    */","   virtual void lookup(LookupRequest&& request, LookupGeoHeadersCallback&& cb) const PURE;","+","+  /**","+   * @return every key this driver is configured to populate in a ``LookupResult``, that is, every","+   * request header the HTTP geoip filter may write, lower-cased once at configuration time so the","+   * filter can remove them from each request without further conversions. The filter removes","+   * these headers from the request before the lookup, so a value a client sent cannot stand in","+   * for one the lookup did not produce. The default is empty, which keeps a provider that does","+   * not override this method on the previous behavior of only writing the headers a lookup","+   * returns.","+   */","+  virtual absl::Span<const Http::LowerCaseString> geoHeaderNames() const { return {}; }"," };"," "," using DriverSharedPtr = std::shared_ptr<Driver>;"],"additions":13,"deletions":0,"truncated":false},{"path":"source/common/runtime/runtime_features.cc","lines":["@@ -96,6 +96,7 @@ RUNTIME_GUARD(envoy_reloadable_features_filter_chain_drain_uses_configured_strat"," // lost. See https://github.com/envoyproxy/envoy/issues/46841"," RUNTIME_GUARD(envoy_reloadable_features_filter_manager_forward_added_data_on_continue);"," RUNTIME_GUARD(envoy_reloadable_features_fix_http3_early_data_timing);","+RUNTIME_GUARD(envoy_reloadable_features_geoip_sanitize_geo_headers);"," RUNTIME_GUARD(envoy_reloadable_features_grpc_side_stream_flow_control);"," RUNTIME_GUARD(envoy_reloadable_features_happy_eyeballs_sort_non_ip_addresses);"," RUNTIME_GUARD(envoy_reloadable_features_header_mutation_url_encode_query_params);"],"additions":1,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/geoip/BUILD","lines":["@@ -25,6 +25,7 @@ envoy_cc_library(","         \"//source/common/http:header_map_lib\",","         \"//source/common/http:headers_lib\",","         \"//source/common/http:utility_lib\",","+        \"//source/common/runtime:runtime_features_lib\",","         \"//source/common/stats:symbol_table_lib\",","         \"@envoy_api//envoy/extensions/filters/http/geoip/v3:pkg_cc_proto\",","     ],"],"additions":1,"deletions":0,"truncated":false},{"path":"source/extensions/filters/http/geoip/geoip_filter.cc","lines":["@@ -4,6 +4,7 @@"," "," #include \"source/common/http/utility.h\""," #include \"source/common/network/utility.h\"","+#include \"source/common/runtime/runtime_features.h\""," "," #include \"absl/memory/memory.h\""," ","@@ -43,6 +44,17 @@ Http::FilterHeadersStatus GeoipFilter::decodeHeaders(Http::RequestHeaderMap& hea","   // Save request headers for later header manipulation once geolocation lookups are complete.","   request_headers_ = headers;"," ","+  // The configured geolocation headers are this filter's to write: an upstream reads them as facts","+  // about the client address, so a value the client sent must not reach it as one. They are","+  // removed before the lookup rather than overwritten after it, because the lookup sets no header","+  // it has no value for (an address the database does not contain, a lookup error, a field the","+  // database lacks for that address) and does not run at all for the non-IP addresses below.","+  if (Runtime::runtimeFeatureEnabled(\"envoy.reloadable_features.geoip_sanitize_geo_headers\")) {","+    for (const Http::LowerCaseString& geo_header : driver_->geoHeaderNames()) {","+      headers.remove(geo_header);","+    }","+  }","+","   Network::Address::InstanceConstSharedPtr remote_address;","   const auto& ip_address_header = config_->ipAddressHeader();","   if (ip_address_header.has_value()) {"],"additions":12,"deletions":0,"truncated":false},{"path":"source/extensions/geoip_providers/maxmind/BUILD","lines":["@@ -46,6 +46,7 @@ envoy_cc_library(","     deps = [","         \"//bazel/deps:maxmind_linux_darwin\",","         \"//envoy/geoip:geoip_provider_driver_interface\",","+        \"//envoy/http:header_map_interface\",","         \"//envoy/stats:stats_macros\",","         \"//source/common/common:enum_to_int\",","         \"//source/common/common:thread_synchronizer_lib\","],"additions":1,"deletions":0,"truncated":false},{"path":"source/extensions/geoip_providers/maxmind/geoip_provider.cc","lines":["@@ -189,6 +189,9 @@ void GeoipProviderConfig::registerGeoDbStats(const absl::string_view& db_type) {"," "," void GeoipProviderConfig::setFieldKey(GeoField field, const std::string& value) {","   field_keys_[enumToInt(field)] = getOptionalString(value);","+  if (!value.empty()) {","+    field_key_names_.emplace_back(value);","+  }"," }"," "," void GeoipProviderConfig::incCounter(Stats::StatName name) {"],"additions":3,"deletions":0,"truncated":false},{"path":"source/extensions/geoip_providers/maxmind/geoip_provider.h","lines":["@@ -1,10 +1,12 @@"," #pragma once"," "," #include <array>","+#include <vector>"," "," #include \"envoy/common/platform.h\""," #include \"envoy/extensions/geoip_providers/maxmind/v3/maxmind.pb.h\""," #include \"envoy/geoip/geoip_provider_driver.h\"","+#include \"envoy/http/header_map.h\""," #include \"envoy/stats/stats_macros.h\""," "," #include \"source/common/common/enum_to_int.h\"","@@ -58,6 +60,10 @@ class GeoipProviderConfig {","     return field_keys_[enumToInt(field)];","   }"," ","+  // Every configured output key, in the order the fields were configured, lower-cased once here","+  // so the HTTP filter can remove them from a request without per-request conversions.","+  absl::Span<const Http::LowerCaseString> fieldKeyNames() const { return field_key_names_; }","+","   void incLookupError(absl::string_view maxmind_db_type) {","     incCounter(","         stat_name_set_->getBuiltin(absl::StrCat(maxmind_db_type, \".lookup_error\"), unknown_hit_));","@@ -78,6 +84,8 @@ class GeoipProviderConfig {"," private:","   // Configured output key for each GeoField.","   std::array<std::optional<std::string>, enumToInt(GeoField::Count)> field_keys_;","+  // The configured output keys as a list, for callers that need all of them at once.","+  std::vector<Http::LowerCaseString> field_key_names_;"," ","   Stats::ScopeSharedPtr stats_scope_;","   Stats::StatNameSetPtr stat_name_set_;","@@ -172,6 +180,9 @@ class GeoipProvider : public Envoy::Geolocation::Driver,"," ","   // Envoy::Geolocation::Driver","   void lookup(Geolocation::LookupRequest&&, Geolocation::LookupGeoHeadersCallback&&) const override;","+  absl::Span<const Http::LowerCaseString> geoHeaderNames() const override {","+    return config_->fieldKeyNames();","+  }"," "," private:","   // Allow the unit test to have access to private members."],"additions":11,"deletions":0,"truncated":false},{"path":"test/extensions/filters/http/geoip/BUILD","lines":["@@ -44,6 +44,7 @@ envoy_extension_cc_test(","         \"//test/mocks/geoip:geoip_mocks\",","         \"//test/mocks/http:http_mocks\",","         \"//test/test_common:registry_lib\",","+        \"//test/test_common:test_runtime_lib\",","         \"@envoy_api//envoy/extensions/filters/http/geoip/v3:pkg_cc_proto\",","     ],"," )"],"additions":1,"deletions":0,"truncated":false},{"path":"test/extensions/filters/http/geoip/geoip_filter_integration_test.cc","lines":["@@ -248,6 +248,54 @@ TEST_P(GeoipFilterIntegrationTest, GeoDataDontPopulatedWhenCalledFromLocalhosNoX","   EXPECT_EQ(nullptr, test_server_->counter(\"http.config_test.maxmind.asn_db.hit\"));"," }"," ","+// The loopback address is in none of the test databases, so the lookup populates nothing. The","+// geolocation headers the client sent must not reach the upstream in its place.","+TEST_P(GeoipFilterIntegrationTest, ClientSuppliedGeoHeadersRemovedWhenLookupHasNoData) {","+  config_helper_.prependFilter(TestEnvironment::substitute(DefaultConfig));","+  initialize();","+  codec_client_ = makeHttpConnection(makeClientConnection(lookupPort(\"http\")));","+  Http::TestRequestHeaderMapImpl request_headers{","+      {\":method\", \"GET\"},       {\":path\", \"/\"},          {\":scheme\", \"http\"},","+      {\":authority\", \"host\"},   {\"x-geo-country\", \"US\"}, {\"x-geo-region\", \"WA\"},","+      {\"x-geo-city\", \"Milton\"}, {\"x-geo-asn\", \"209\"},    {\"x-unrelated\", \"kept\"}};","+  auto response = sendRequestAndWaitForResponse(request_headers, 0, default_response_headers_, 0);","+  ASSERT_TRUE(response->complete());","+  EXPECT_EQ(\"200\", response->headers().getStatusValue());","+  EXPECT_TRUE(upstream_request_->headers().get(Http::LowerCaseString(\"x-geo-country\")).empty());","+  EXPECT_TRUE(upstream_request_->headers().get(Http::LowerCaseString(\"x-geo-region\")).empty());","+  EXPECT_TRUE(upstream_request_->headers().get(Http::LowerCaseString(\"x-geo-city\")).empty());","+  EXPECT_TRUE(upstream_request_->headers().get(Http::LowerCaseString(\"x-geo-asn\")).empty());","+  EXPECT_EQ(\"kept\", headerValue(\"x-unrelated\"));","+  test_server_->waitForCounter(\"http.config_test.geoip.total\", Eq(1));","+  EXPECT_EQ(nullptr, test_server_->counter(\"http.config_test.maxmind.city_db.hit\"));","+}","+","+// When the lookup does have data, the value from the database is the only one the upstream sees:","+// the client's copy is removed rather than left as a second value of the same header.","+TEST_P(GeoipFilterIntegrationTest, ClientSuppliedGeoHeadersReplacedWhenLookupHasData) {","+  config_helper_.prependFilter(TestEnvironment::substitute(ConfigWithXff));","+  initialize();","+  codec_client_ = makeHttpConnection(makeClientConnection(lookupPort(\"http\")));","+  Http::TestRequestHeaderMapImpl request_headers{{\":method\", \"GET\"},","+                                                 {\":path\", \"/\"},","+                                                 {\":scheme\", \"http\"},","+                                                 {\":authority\", \"host\"},","+                                                 {\"x-forwarded-for\", \"216.160.83.56\"},","+                                                 {\"x-geo-country\", \"ZZ\"},","+                                                 {\"x-geo-anon-vpn\", \"true\"}};","+  auto response = sendRequestAndWaitForResponse(request_headers, 0, default_response_headers_, 0);","+  ASSERT_TRUE(response->complete());","+  EXPECT_EQ(\"200\", response->headers().getStatusValue());","+  EXPECT_EQ(1, upstream_request_->headers().get(Http::LowerCaseString(\"x-geo-country\")).size());","+  EXPECT_EQ(\"US\", headerValue(\"x-geo-country\"));","+  EXPECT_EQ(\"Milton\", headerValue(\"x-geo-city\"));","+  // 216.160.83.56 is not in the anonymous IP test database, so the lookup sets no anon headers","+  // and the client's claim is not carried through either.","+  EXPECT_TRUE(upstream_request_->headers().get(Http::LowerCaseString(\"x-geo-anon-vpn\")).empty());","+  test_server_->waitForCounter(\"http.config_test.geoip.total\", Eq(1));","+  EXPECT_EQ(1, test_server_->counter(\"http.config_test.maxmind.city_db.hit\")->value());","+}","+"," TEST_P(GeoipFilterIntegrationTest, GeoAnonDataPopulatedUseXff) {","   config_helper_.prependFilter(TestEnvironment::substitute(ConfigWithXff));","   initialize();"],"additions":48,"deletions":0,"truncated":false},{"path":"test/extensions/filters/http/geoip/geoip_filter_test.cc","lines":["@@ -8,12 +8,14 @@"," #include \"test/mocks/http/mocks.h\""," #include \"test/mocks/stats/mocks.h\""," #include \"test/test_common/registry.h\"","+#include \"test/test_common/test_runtime.h\""," #include \"test/test_common/utility.h\""," "," #include \"gmock/gmock.h\""," #include \"gtest/gtest.h\""," "," using testing::DoAll;","+using testing::Return;"," using testing::SaveArg;"," "," namespace Envoy {","@@ -271,6 +273,88 @@ TEST_F(GeoipFilterTest, GeoHeaderNotAppendedOnEmptyLookup) {","   filter_->onDestroy();"," }"," ","+// A geolocation header a client sent is removed before the lookup, so it does not survive a","+// lookup that has no value for it. Only the header the lookup populated reaches the upstream.","+TEST_F(GeoipFilterTest, ClientSuppliedGeoHeadersRemovedBeforeLookup) {","+  initializeProviderFactory();","+  const std::string external_request_yaml = R\"EOF(","+    provider:","+        name: \"envoy.geoip_providers.dummy\"","+        typed_config:","+          \"@type\": type.googleapis.com/test.mocks.geoip.DummyProvider","+)EOF\";","+  initializeFilter(external_request_yaml);","+  const std::vector<Http::LowerCaseString> geo_header_names = {","+      Http::LowerCaseString(\"x-geo-country\"), Http::LowerCaseString(\"x-geo-city\"),","+      Http::LowerCaseString(\"x-geo-anon-vpn\")};","+  EXPECT_CALL(*dummy_driver_, geoHeaderNames())","+      .WillRepeatedly(Return(absl::MakeConstSpan(geo_header_names)));","+  Http::TestRequestHeaderMapImpl request_headers;","+  request_headers.addCopy(\"x-geo-country\", \"US\");","+  request_headers.addCopy(\"x-geo-city\", \"client_city\");","+  request_headers.addCopy(\"x-geo-anon-vpn\", \"false\");","+  request_headers.addCopy(\"x-unrelated\", \"kept\");","+  expectStats();","+  Network::Address::InstanceConstSharedPtr remote_address =","+      Network::Utility::parseInternetAddressNoThrow(\"1.2.3.4\");","+  filter_callbacks_.stream_info_.downstream_connection_info_provider_->setRemoteAddress(","+      remote_address);","+  EXPECT_CALL(*dummy_driver_, lookup(_, _))","+      .WillRepeatedly(DoAll(SaveArg<0>(&captured_rq_), SaveArg<1>(&captured_cb_), Invoke([this]() {","+                              captured_cb_(Geolocation::LookupResult{{\"x-geo-city\", \"dummy-city\"}});","+                            })));","+  EXPECT_EQ(Http::FilterHeadersStatus::StopAllIterationAndWatermark,","+            filter_->decodeHeaders(request_headers, false));","+  EXPECT_CALL(filter_callbacks_, continueDecoding());","+  dispatcher_->run(Event::Dispatcher::RunType::Block);","+  EXPECT_EQ(2, request_headers.size());","+  EXPECT_THAT(request_headers, HasExpectedHeader(\"x-geo-city\", \"dummy-city\"));","+  EXPECT_THAT(request_headers, HasExpectedHeader(\"x-unrelated\", \"kept\"));","+  EXPECT_FALSE(request_headers.has(\"x-geo-country\"));","+  EXPECT_FALSE(request_headers.has(\"x-geo-anon-vpn\"));","+  ::testing::Mock::VerifyAndClearExpectations(&filter_callbacks_);","+  filter_->onDestroy();","+}","+","+// The removal is guarded by a runtime flag so that a deployment which relied on client-supplied","+// geolocation headers passing through can keep the previous behavior while it migrates.","+TEST_F(GeoipFilterTest, ClientSuppliedGeoHeadersKeptWhenSanitizationDisabled) {","+  TestScopedRuntime scoped_runtime;","+  scoped_runtime.mergeValues({{\"envoy.reloadable_features.geoip_sanitize_geo_headers\", \"false\"}});","+  initializeProviderFactory();","+  const std::string external_request_yaml = R\"EOF(","+    provider:","+        name: \"envoy.geoip_providers.dummy\"","+        typed_config:","+          \"@type\": type.googleapis.com/test.mocks.geoip.DummyProvider","+)EOF\";","+  initializeFilter(external_request_yaml);","+  const std::vector<Http::LowerCaseString> geo_header_names = {","+      Http::LowerCaseString(\"x-geo-country\"), Http::LowerCaseString(\"x-geo-city\")};","+  EXPECT_CALL(*dummy_driver_, geoHeaderNames())","+      .WillRepeatedly(Return(absl::MakeConstSpan(geo_header_names)));","+  Http::TestRequestHeaderMapImpl request_headers;","+  request_headers.addCopy(\"x-geo-country\", \"US\");","+  expectStats();","+  Network::Address::InstanceConstSharedPtr remote_address =","+      Network::Utility::parseInternetAddressNoThrow(\"1.2.3.4\");","+  filter_callbacks_.stream_info_.downstream_connection_info_provider_->setRemoteAddress(","+      remote_address);","+  EXPECT_CALL(*dummy_driver_, lookup(_, _))","+      .WillRepeatedly(DoAll(SaveArg<0>(&captured_rq_), SaveArg<1>(&captured_cb_), Invoke([this]() {","+                              captured_cb_(Geolocation::LookupResult{{\"x-geo-city\", \"dummy-city\"}});","+                            })));","+  EXPECT_EQ(Http::FilterHeadersStatus::StopAllIterationAndWatermark,","+            filter_->decodeHeaders(request_headers, false));","+  EXPECT_CALL(filter_callbacks_, continueDecoding());","+  dispatcher_->run(Event::Dispatcher::RunType::Block);","+  EXPECT_EQ(2, request_headers.size());","+  EXPECT_THAT(request_headers, HasExpectedHeader(\"x-geo-country\", \"US\"));","+  EXPECT_THAT(request_headers, HasExpectedHeader(\"x-geo-city\", \"dummy-city\"));","+  ::testing::Mock::VerifyAndClearExpectations(&filter_callbacks_);","+  filter_->onDestroy();","+}","+"," TEST_F(GeoipFilterTest, NoCrashIfFilterDestroyedBeforeCallbackCalled) {","   initializeProviderFactory();","   const std::string external_request_yaml = R\"EOF(","@@ -507,6 +591,36 @@ TEST_F(GeoipFilterNonIpAddressTest, SkipLookupForNullDownstreamAddress) {","   expectLookupSkipped(nullptr);"," }"," ","+// A skipped lookup sets no header, so the client-supplied geolocation headers are removed on that","+// path as well; the upstream must not read them as the filter's own.","+TEST_F(GeoipFilterNonIpAddressTest, ClientSuppliedGeoHeadersRemovedWhenLookupSkipped) {","+  initializeProviderFactory();","+  const std::string external_request_yaml = R\"EOF(","+    provider:","+        name: \"envoy.geoip_providers.dummy\"","+        typed_config:","+          \"@type\": type.googleapis.com/test.mocks.geoip.DummyProvider","+)EOF\";","+  initializeFilter(external_request_yaml);","+  const std::vector<Http::LowerCaseString> geo_header_names = {","+      Http::LowerCaseString(\"x-geo-country\")};","+  EXPECT_CALL(*dummy_driver_, geoHeaderNames())","+      .WillRepeatedly(Return(absl::MakeConstSpan(geo_header_names)));","+  Http::TestRequestHeaderMapImpl request_headers;","+  request_headers.addCopy(\"x-geo-country\", \"US\");","+  request_headers.addCopy(\"x-unrelated\", \"kept\");","+  filter_callbacks_.stream_info_.downstream_connection_info_provider_->setRemoteAddress(","+      std::make_shared<Network::Address::EnvoyInternalInstance>(\"internal_address_for_test\"));","+  expectStats();","+  EXPECT_CALL(stats_, counter(\"prefix.geoip.skipped\"));","+  EXPECT_CALL(*dummy_driver_, lookup(_, _)).Times(0);","+  EXPECT_EQ(Http::FilterHeadersStatus::Continue, filter_->decodeHeaders(request_headers, false));","+  EXPECT_EQ(1, request_headers.size());","+  EXPECT_FALSE(request_headers.has(\"x-geo-country\"));","+  EXPECT_THAT(request_headers, HasExpectedHeader(\"x-unrelated\", \"kept\"));","+  filter_->onDestroy();","+}","+"," } // namespace"," } // namespace Geoip"," } // namespace HttpFilters"],"additions":114,"deletions":0,"truncated":false},{"path":"test/extensions/geoip_providers/maxmind/geoip_provider_test.cc","lines":["@@ -227,6 +227,15 @@ class GeoipProviderTestBase {","   std::vector<Filesystem::Watcher::OnChangedCb> on_changed_cbs_ ABSL_GUARDED_BY(mutex_);","   std::optional<ConditionalInitializer> cb_added_nullopt = std::nullopt;","   DriverSharedPtr provider_;","+","+  // The provider reports its keys as Http::LowerCaseString; compare them as plain strings.","+  std::vector<std::string> geoHeaderNameStrings() const {","+    std::vector<std::string> names;","+    for (const Http::LowerCaseString& name : provider_->geoHeaderNames()) {","+      names.push_back(name.get());","+    }","+    return names;","+  }"," };"," "," class GeoipProviderTest : public testing::Test, public GeoipProviderTestBase {};","@@ -263,6 +272,41 @@ TEST_F(GeoipProviderTest, ValidConfigCityAndAsnDbsSuccessfulLookup) {","   expectStats(\"asn_db\");"," }"," ","+// The provider reports every configured output key, so the HTTP filter can remove them from a","+// request before the lookup; a key that was not configured is not reported.","+TEST_F(GeoipProviderTest, GeoHeaderNamesListEveryConfiguredKey) {","+  const std::string config_yaml = R\"EOF(","+    common_provider_config:","+      geo_field_keys:","+        country: \"x-geo-country\"","+        region: \"x-geo-region\"","+        city: \"x-geo-city\"","+        asn: \"x-geo-asn\"","+        anon_vpn: \"x-geo-anon-vpn\"","+    city_db_path: \"{{ test_rundir }}/test/extensions/geoip_providers/maxmind/test_data/GeoLite2-City-Test.mmdb\"","+    asn_db_path: \"{{ test_rundir }}/test/extensions/geoip_providers/maxmind/test_data/GeoLite2-ASN-Test.mmdb\"","+    anon_db_path: \"{{ test_rundir }}/test/extensions/geoip_providers/maxmind/test_data/GeoIP2-Anonymous-IP-Test.mmdb\"","+  )EOF\";","+  initializeProvider(config_yaml, cb_added_nullopt);","+  EXPECT_THAT(geoHeaderNameStrings(),","+              testing::UnorderedElementsAre(\"x-geo-country\", \"x-geo-region\", \"x-geo-city\",","+                                            \"x-geo-asn\", \"x-geo-anon-vpn\"));","+}","+","+// The deprecated geo_headers_to_add form, including the is_anon fallback, reports its keys too.","+TEST_F(GeoipProviderTest, DEPRECATED_FEATURE_TEST(GeoHeaderNamesListDeprecatedGeoHeadersToAdd)) {","+  const std::string config_yaml = R\"EOF(","+    common_provider_config:","+      geo_headers_to_add:","+        country: \"x-geo-country\"","+        is_anon: \"x-geo-anon\"","+    city_db_path: \"{{ test_rundir }}/test/extensions/geoip_providers/maxmind/test_data/GeoLite2-City-Test.mmdb\"","+    anon_db_path: \"{{ test_rundir }}/test/extensions/geoip_providers/maxmind/test_data/GeoIP2-Anonymous-IP-Test.mmdb\"","+  )EOF\";","+  initializeProvider(config_yaml, cb_added_nullopt);","+  EXPECT_THAT(geoHeaderNameStrings(), testing::UnorderedElementsAre(\"x-geo-country\", \"x-geo-anon\"));","+}","+"," TEST_F(GeoipProviderTest, ValidConfigAsnDbsSuccessfulLookup) {","   const std::string config_yaml = R\"EOF(","     common_provider_config:"],"additions":44,"deletions":0,"truncated":false},{"path":"test/mocks/geoip/mocks.h","lines":["@@ -15,13 +15,16 @@ class MockDriver : public Driver {","   MOCK_METHOD(void, lookup,","               (Geolocation::LookupRequest && request, Geolocation::LookupGeoHeadersCallback&&),","               (const));","+  MOCK_METHOD(absl::Span<const Http::LowerCaseString>, geoHeaderNames, (), (const));"," };"," "," using MockDriverSharedPtr = std::shared_ptr<MockDriver>;"," "," class DummyGeoipProviderFactory : public GeoipProviderFactory {"," public:","-  DummyGeoipProviderFactory() : driver_(new MockDriver()) {}","+  // A NiceMock so that tests which do not care about geoHeaderNames() are not warned about the","+  // call the HTTP filter makes on every request; it returns an empty span by default.","+  DummyGeoipProviderFactory() : driver_(new testing::NiceMock<MockDriver>()) {}","   Geolocation::DriverSharedPtr","   createGeoipProviderDriver(const Protobuf::Message&, const std::string&,","                             Server::Configuration::ServerFactoryContext&) override {",""],"additions":4,"deletions":1,"truncated":false}],"additions":267,"deletions":2,"truncated":false,"file_count":15},"error":null,"fetched_at":"2026-10-17T12:25:38.353820+00:00"}