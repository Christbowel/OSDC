ile","+  // simple-extension routes (`app/page.tsx`) keep working alongside it.","+  pageExtensions: ['page.tsx', 'tsx'],","+}"],"additions":7,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/proxy-mixed-page-extensions/proxy-mixed-page-extensions.test.ts","lines":["@@ -0,0 +1,21 @@","+import { nextTestSetup } from 'e2e-utils'","+","+describe('proxy-mixed-page-extensions', () => {","+  const { next } = nextTestSetup({","+    files: __dirname,","+    skipDeployment: true,","+  })","+","+  it('should detect proxy.page.tsx when pageExtensions mixes compound and simple', async () => {","+    // pageExtensions = ['page.tsx', 'tsx']: the compound rule must still","+    // recognize `proxy.page.tsx` as a proxy. The simple rule (`tsx`)","+    // shouldn't accidentally take over and route the file as something","+    // else, nor should the convention loop confuse `proxy.page.tsx` with","+    // a non-proxy file.","+    const res = await next.fetch('/')","+    expect(res.status).toBe(200)","+    expect(res.headers.get('x-proxy-ran')).toBe('true')","+    const html = await res.text()","+    expect(html).toContain('hello from proxy-mixed-page-extensions')","+  })","+})"],"additions":21,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/proxy-mixed-page-extensions/proxy.page.tsx","lines":["@@ -0,0 +1,8 @@","+import { NextResponse } from 'next/server'","+import type { NextRequest } from 'next/server'","+","+export function proxy(_request: NextRequest) {","+  const response = NextResponse.next()","+  response.headers.set('x-proxy-ran', 'true')","+  return response","+}"],"additions":8,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/proxy-page-extensions/app/headers/loading.page.tsx","lines":["@@ -0,0 +1,3 @@","+export default function Loading() {","+  return <p>Loading headers...</p>","+}"],"additions":3,"deletions":0,"truncated":false},{"path":"test/e2e/app-dir/proxy-page-extensions/app/headers/page.page.tsx","lines":["@@ -0,0 +1,11 @@","+import { he