 {"," \t\t\t\t\t\treturn;"," \t\t\t\t\t}"," \t\t\t\t\tconst idx_t to_read = MinValue(block_size, file_size - offset);","-\t\t\t\t\tauto buf = buffer_manager.Allocate(MemoryTag::EXTERNAL_FILE_CACHE, to_read);","+\t\t\t\t\tauto buf =","+\t\t\t\t\t    ExternalFileCache::AllocateCacheBuffer(buffer_manager, caching_file_handle.GetPath(), to_read);"," \t\t\t\t\tcaching_file_handle.ReadAndRecord(context, buf.GetDataMutable(), to_read, offset);"," "," \t\t\t\t\tlk.lock();"],"additions":2,"deletions":1,"truncated":false},{"path":"src/storage/external_file_cache/external_file_cache.cpp","lines":["@@ -88,6 +88,11 @@ void ExternalFileCache::ReindexCachedFileCore(CachedFile &cached_file, idx_t fil"," \t\tif (block.state != CacheBlockState::LOADED || !block.block_handle) {"," \t\t\tcontinue;"," \t\t}","+\t\tif (block.block_handle->GetMemory().IsUnloaded()) {","+\t\t\t// Evicted blocks do not survive a re-index, whether they spilled or were dropped:","+\t\t\t// pinning all of them to copy them over could exceed the memory limit","+\t\t\tcontinue;","+\t\t}"," \t\tauto pin = buffer_manager.Pin(block.block_handle);"," \t\tif (pin.IsValid()) {"," \t\t\tpinned.emplace(old_idx, make_pair(std::move(pin), block.nr_bytes));","@@ -129,7 +134,7 @@ void ExternalFileCache::ReindexCachedFileCore(CachedFile &cached_file, idx_t fil"," \t\t\t}"," \t\t\tconst idx_t new_size = new_end - new_start;"," ","-\t\t\tauto buf = buffer_manager.Allocate(MemoryTag::EXTERNAL_FILE_CACHE, new_size);","+\t\t\tauto buf = AllocateCacheBuffer(buffer_manager, cached_file.path, new_size);"," "," \t\t\t// Copy from each contributing old block in the run."," \t\t\tconst idx_t contrib_first = new_start / old_block_size;","@@ -319,8 +324,11 @@ vector<CachedFileInformation> ExternalFileCache::GetCachedFileInformation() cons"," \t\t\t\tcontinue;"," \t\t\t}"," \t\t\tconst idx_t location = block_idx * block_size;","-\t\t\tconst bool loaded = !block.block_handle->GetMemory().IsUnloaded();","-\t\t\tresult.push_back({file->path, block.nr_bytes, location, loaded});","+\t\t\tconst auto &memory = block.block_handle->GetMemory();","+\t\t\tconst bool loaded = !memory.IsUnloaded();","+\t\t\t// An unloaded cache block is spilled if it still has a temporary file backing","+\t\t\tconst bool spilled = !loaded && memory.MustWriteToTemporaryFile();","+\t\t\tresult.push_back({file->path, block.nr_bytes, location, loaded, spilled});"," \t\t}"," \t}"," \treturn result;","@@ -343,6 +351,13 @@ BufferManager &ExternalFileCache::GetBufferManager() const {"," \treturn buffer_manager;"," }"," ","+BufferHandle ExternalFileCache::AllocateCacheBuffer(BufferManager &buffer_manager, const string &path, idx_t nr_bytes) {","+\tconst bool spill = Settings::Get<ExternalFileCacheSpillSetting>(buffer_manager.GetDatabase()) &&","+\t                   FileSystem::IsRemoteFile(path) && buffer_manager.HasTemporaryDirectory() &&","+\t                   nr_bytes >= buffer_manager.GetBlockAllocSize();","+\treturn buffer_manager.Allocate(MemoryTag::EXTERNAL_FILE_CACHE, nr_bytes, !spill);","+}","+"," void ExternalFileCache::DeleteObjectCacheEntries(const vector<string> &paths) {"," \tauto &object_cache = buffer_manager.GetDatabase().GetObjectCache();"," \tfor (auto &path : paths) {"],"additions":18,"deletions":3,"truncated":false},{"path":"test/sql/storage/external_file_cache/external_file_cache_spill.test_slow","lines":["@@ -0,0 +1,114 @@","+# name: test/sql/storage/external_file_cache/external_file_cache_spill.test_slow","+# description: Cache blocks of remote files spill to the temporary directory, local files are dropped","+# group: [external_file_cache]","+","+require parquet","+","+require skip_reload","+","+statement ok","+SET external_file_cache_spill=true;","+","+statement ok","+SET cache_local_files=true;","+","+statement ok","+SET external_file_cache_local_block_size=2097152;","+","+statement ok","+SET memory_limit='200MB';","+","+statement ok","+SET temp_directory='{TEST_DIR}/external_file_cache_spill';","+","+statement ok","+SET preserve_insertion_order=false;","+","+# roughly 290MB of incompressible data, well above the memory limit","+statement ok","+COPY (SELECT hash(i) a, hash(i * 2) b, hash(i * 3) c FROM range(12000000) t(i))","+TO '{TEST_DIR}/efc_spill.parquet' (FORMAT parquet);","+","+# local files can be re-read at the same cost as a spilled block, so even with spilling","+# enabled and large cache blocks, evicted local blocks are dropped, never spilled","+query I","+SELECT sum(a) - (SELECT sum(hash(i)) FROM range(12000000) t(i)) FROM read_parquet('{TEST_DIR}/efc_spill.parquet');","+----","+0","+","+query I","+SELECT count(*) > 0 FROM duckdb_external_file_cache() WHERE NOT loaded;","+----","+true","+","+query I","+SELECT count(*) FROM duckdb_external_file_cache() WHERE spilled;","+----","+0","+","+query I","+SELECT temporary_storage_bytes FROM duckdb_memory() WHERE tag = 'EXTERNAL_FILE_CACHE';","+----","+0","+","+# reads must still reassemble the same data through the dropped blocks","+query II","+SELECT sum(b) - (SELECT sum(hash(i * 2)) FROM range(12000000) t(i)),","+       sum(c) - (SELECT sum(hash(i * 3)) FROM range(12000000) t(i))","+FROM read_parquet('{TEST_DIR}/efc_spill.parquet');","+----","+0\t0","+","+# reads reassemble the correct content after a cache block size change re-indexes the cache","+statement ok","+SET external_file_cache_local_block_size=16384;","+","+query I","+SELECT sum(a) - (SELECT sum(hash(i)) FROM range(12000000) t(i)) FROM read_parquet('{TEST_DIR}/efc_spill.parquet');","+----","+0","+","+# remote cache blocks above the block size are marked for spilling instead of dropping","+require httpfs","+","+query IRR","+SELECT count(*), min(temp), max(temp)","+FROM read_parquet('https://github.com/duckdb/duckdb-data/releases/download/v1.0/city_temperature.parquet') t(temp);","+----","+2905886\t-99.0\t110.0","+","+# shrinking the memory limit evicts the cache, remote blocks spill instead of being dropped","+statement ok","+SET memory_limit='1MB';","+","+query I","+SELECT count(*) > 0 FROM duckdb_external_file_cache() WHERE path LIKE '%city_temperature%' AND spilled;","+----","+true","+","+query I","+SELECT temporary_storage_bytes > 0 FROM duckdb_memory() WHERE tag = 'EXTERNAL_FILE_CACHE';","+----","+true","+","+statement ok","+SET memory_limit='200MB';","+","+# the spilled blocks reassemble the same remote content","+query IRR","+SELECT count(*), min(temp), max(temp)","+FROM read_parquet('https://github.com/duckdb/duckdb-data/releases/download/v1.0/city_temperature.parquet') t(temp);","+----","+2905886\t-99.0\t110.0","+","+# disabling the cache deletes all cache blocks, including spilled remote ones","+statement ok","+SET enable_external_file_cache=false;","+","+query I","+SELECT count(*) FROM duckdb_external_file_cache();","+----","+0","+","+statement ok","+SET enable_external_file_cache=true;",""],"additions":114,"deletions":0,"truncated":false}],"additions":185,"deletions":8,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-08-19T08:08:19.159404+00:00"}