utes.some((route) => route.test(pathname)) &&","+\tisrRoutes.some((route) => route.test(pathname));","+","+// Cached routes go back through \\`_isr\\`, or every request would re-render.","+// Keep in step with \\`getIsrPath\\`.","+function forwardPath(pathname) {","+\tif (!isCached(pathname)) return '/${NODE_PATH}';","+\tconst params = new URLSearchParams({","+\t\t'${ASTRO_PATH_PARAM}': pathname,","+\t\t'${ASTRO_PATH_TOKEN_PARAM}': '${middlewareSecret}',","+\t});","+\treturn '/_isr?' + params.toString();","+}","+"," export default async function middleware(request, context) {"," \tconst ctx = createContext({"," \t\trequest,","@@ -123,10 +157,10 @@ export default async function middleware(request, context) {"," \t\tclientAddress: request.headers.get('x-real-ip') || undefined,"," \t});"," \tObject.assign(ctx.locals, { vercel: { edge: context }, ...${handlerTemplateCall} });","-\tconst { origin } = new URL(request.url);","+\tconst { origin, pathname } = new URL(request.url);"," \tconst next = async () => {"," \t\tconst { vercel, ...locals } = ctx.locals;","-\t\tconst response = await fetch(new URL('/${NODE_PATH}', request.url), {","+\t\tconst response = await fetch(new URL(forwardPath(pathname), request.url), {"," \t\t\tmethod: request.method,"," \t\t\theaders: {"," \t\t\t\t...Object.fromEntries(request.headers.entries()),"],"additions":36,"deletions":2,"truncated":false},{"path":"packages/integrations/vercel/test/fixtures/isr-edge-no-middleware/astro.config.mjs","lines":["@@ -0,0 +1,13 @@","+import vercel from '@astrojs/vercel';","+import { defineConfig } from 'astro/config';","+","+// `middlewareMode: 'edge'` with no middleware file in the project.","+export default defineConfig({","+\toutput: 'server',","+\tadapter: vercel({","+\t\tmiddlewareMode: 'edge',","+\t\tisr: {","+\t\t\texpiration: 120,","+\t\t},","+\t}),","+});"],"additions":13,"deletions":0,"truncated":false},{"path":"packages/integrations/vercel/test/fixtures/isr-edge-no-middleware/package.json","lines":[