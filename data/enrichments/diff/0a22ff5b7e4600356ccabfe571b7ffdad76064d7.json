letions":0,"truncated":false},{"path":"packages/integrations/vercel/test/fixtures/isr-with-edge-middleware/src/pages/[slug].astro","lines":["@@ -0,0 +1,13 @@","+---","+// Its pattern also matches `/live`, which `isr.exclude` keeps out of the cache.","+export const prerender = false;","+---","+","+<html lang=\"en\">","+\t<head>","+\t\t<title>{Astro.params.slug}</title>","+\t</head>","+\t<body>","+\t\t<h1>{Astro.params.slug}</h1>","+\t</body>","+</html>"],"additions":13,"deletions":0,"truncated":false},{"path":"packages/integrations/vercel/test/fixtures/isr-with-edge-middleware/src/pages/api/data.ts","lines":["@@ -0,0 +1,3 @@","+import type { APIRoute } from 'astro';","+","+export const GET: APIRoute = ({ url }) => Response.json({ ok: true, query: url.search });"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/integrations/vercel/test/fixtures/isr-with-edge-middleware/src/pages/cached/[id].astro","lines":["@@ -0,0 +1,12 @@","+---","+const { id } = Astro.params;","+---","+","+<html lang=\"en\">","+\t<head>","+\t\t<title>Cached {id}</title>","+\t</head>","+\t<body>","+\t\t<h1>{id}</h1>","+\t</body>","+</html>"],"additions":12,"deletions":0,"truncated":false},{"path":"packages/integrations/vercel/test/fixtures/isr-with-edge-middleware/src/pages/index.astro","lines":["@@ -0,0 +1,8 @@","+<html lang=\"en\">","+\t<head>","+\t\t<title>ISR with edge middleware</title>","+\t</head>","+\t<body>","+\t\t<h1>Testing</h1>","+\t</body>","+</html>"],"additions":8,"deletions":0,"truncated":false},{"path":"packages/integrations/vercel/test/fixtures/isr-with-edge-middleware/src/pages/live.astro","lines":["@@ -0,0 +1,12 @@","+---","+// Listed in `isr.exclude`, so it must reach `_render` rather than the cache.","+---","+","+<html lang=\"en\">","+\t<head>","+\t\t<title>Live</title>","+\t</head>","+\t<body>","+\t\t<h1>Live</h1>","+\t</body>","+</html>"],"additions":12,"deletions":0,"truncated":false},{"path":"packages/integrations/vercel/test/fixtures/isr-with-edge-middleware/src/pages/static.astro","lines":["@@ -0,0 +1,12 @@","+---","+export const prerender = true;","+---","+","+<html lang=\"en\">","+\t<head>","+\t\t<title>Static</title>","+\t</head>","+\t<body>","+\t\t<h1>Static</h1>","+\t</body>","+</html>"],"additions":12,"deletions":0,"truncated":false},{"path":"packages/integrations/vercel/test/isr-edge-middleware.test.ts","lines":["@@ -0,0 +1,250 @@","+import assert from 'node:assert/strict';","+import { before, describe, it } from 'node:test';","+import { type Fixture, getVercelConfig, loadFixture } from './test-utils.ts';","+","+const destOf = (routes: { src?: string; dest?: string }[], src: string) =>","+\troutes.find((route) => route.src === src)?.dest;","+","+/**","+ * With `isr`, every route used to be pointed straight at the ISR function, so","+ * the middleware edge function was built and deployed but never invoked — and","+ * ISR skips the function entirely on a cache hit, so middleware stopped running","+ * once an entry was warm.","+ */","+describe('ISR with edge middleware', () => {","+\tlet fixture: Fixture;","+","+\tbefore(async () => {","+\t\tfixture = await loadFixture({","+\t\t\troot: './fixtures/isr-with-edge-middleware/',","+\t\t});","+\t\tawait fixture.build({});","+\t});","+","+\t/** The URL `next()` forwards to, with `fetch` stubbed out. */","+\tasync function forwardedUrl(path: string): Promise<URL> {","+\t\tconst entry = new URL(","+\t\t\t'../.vercel/output/functions/_middleware.func/middleware.mjs',","+\t\t\tfixture.config.outDir,","+\t\t);","+\t\tconst module = await import(entry.href);","+","+\t\tconst originalFetch = globalThis.fetch;","+\t\tlet captured: string | undefined;","+\t\tglobalThis.fetch = async (url) => {","+\t\t\tcaptured = String(url);","+\t\t\treturn new Response('ok');","+\t\t};","+\t\ttry {","+\t\t\tawait module.default(new Request(`http://example.com${path}`), {});","+\t\t} finally {","+\t\t\tglobalThis.fetch = originalFetch;","+\t\t}","+","+\t\tassert.ok(captured, 'next() did not forward the request');","+\t\treturn new URL(captured);","+\t}","+","+\tit('builds the middleware edge function', { timeout: 30000 }, async () => {","+\t\tconst config = JSON.parse(","+\t\t\tawait fixture.readFile('../.vercel/output/functions/_middleware.func/.vc-config.json'),","+\t\t);","+\t\tassert.equal(config.runtime, 'edge');","+\t\tassert.equal(config.entrypoint, 'middleware.mjs');","+\t});","+","+\tit('points page routes at the middleware', { timeout: 30000 }, async () => {","+\t\tconst { routes } = await getVercelConfig(fixture);","+","+\t\t// Not `routes.some((r) => r.dest === '_middleware')`: the 404 catch-all","+\t\t// always points there, so that passes even when no page route does.","+\t\tassert.equal(destOf(routes, '^/$'), '_middleware');","+\t\tassert.equal(destOf(routes, '^/cached/([^/]+?)/?$'), '_middleware');","+\t});","+","+\tit('points routes excluded from ISR at the middleware too', { timeout: 30000 }, async () => {","+\t\tconst { routes } = await getVercelConfig(fixture);","+\t\tassert.equal(destOf(routes, '^/live$'), '_middleware');","+\t});","+","+\tit('leaves internal endpoints on the serverless function', { timeout: 30000 }, async () => {","+\t\tconst { routes } = await getVercelConfig(fixture);","+\t\tassert.equal(destOf(routes, '^/_image/?$'), '_render');","+\t\tassert.equal(destOf(routes, '^/_server-islands/([^/]+?)/?$'), '_render');","+\t});","+","+\tit('routes every on-demand route kind through the middleware', {","+\t\ttimeout: 30000,","+\t}, async () => {","+\t\tconst { routes } = await getVercelConfig(fixture);","+\t\tassert.equal(destOf(routes, '^/api/data/?$'), '_middleware', 'endpoint');","+\t\tassert.equal(destOf(routes, '^/404/?$'), '_middleware', '404 page');","+\t});","+","+\tit('leaves prerendered pages as static files', { timeout: 30000 }, async () => {","+\t\tconst { routes } = await getVercelConfig(fixture);","+\t\tassert.equal(destOf(routes, '^/static/?$'), undefined, 'no route: the file is served directly');","+","+\t\tconst html = await fixture.readFile('../.vercel/output/static/static/index.html');","+\t\tassert.ok(html.includes('<h1>Static</h1>'));","+\t});","+","+\tit('keeps redirects ahead of the middleware', { timeout: 30000 }, async () => {","+\t\tconst { routes } = await getVercelConfig(fixture);","+\t\tconst redirect = routes.find((route) => route.src === '^/old$');","+\t\tconst filesystem = routes.findIndex((route) => route.handle === 'filesystem');","+","+\t\tassert.equal(redirect?.status, 301);","+\t\tassert.equal(redirect?.headers.Location, '/');","+\t\tassert.ok(routes.indexOf(redirect!) < filesystem, 'redirects resolve before anything else');","+\t});","+","+\tit('keeps the ISR config', { timeout: 30000 }, async () => {","+\t\tconst config = JSON.parse(","+\t\t\tawait fixture.readFile('../.vercel/output/functions/_isr.prerender-config.json'),","+\t\t);","+\t\tassert.equal(config.expiration, 120);","+\t});","+","+\tit('forwards cached routes to the ISR function', { timeout: 30000 }, async () => {","+\t\tconst url = await forwardedUrl('/');","+\t\tassert.equal(url.pathname, '/_isr');","+\t\tassert.equal(url.searchParams.get('x_astro_path'), '/');","+\t\tassert.ok(","+\t\t\turl.searchParams.get('x_astro_path_token'),","+\t\t\t'the entrypoint ignores an untokened path',","+\t\t);","+\t});","+","+\tit('forwards endpoints to the ISR function too', { timeout: 30000 }, async () => {","+\t\tconst url = await forwardedUrl('/api/data');","+\t\tassert.equal(url.pathname, '/_isr');","+\t\tassert.equal(url.searchParams.get('x_astro_path'), '/api/data');","+\t});","+","+\tit('forwards dynamic routes with their real path', { timeout: 30000 }, async () => {","+\t\tconst url = await forwardedUrl('/cached/42');","+\t\tassert.equal(url.pathname, '/_isr');","+\t\t// The path is the ISR cache key. Getting it wrong gives every page one entry.","+\t\tassert.equal(url.searchParams.get('x_astro_path'), '/cached/42');","+\t});","+","+\tit('forwards routes excluded from ISR to the serverless function', {","+\t\ttimeout: 30000,","+\t}, async () => {","+\t\t// `/live` also matches the `[slug]` route, which is cached: an exclusion","+\t\t// only holds if it is checked before the ISR patterns.","+\t\tconst url = await forwardedUrl('/live');","+\t\tassert.equal(url.pathname, '/_render');","+\t});","+","+\tit('still caches the dynamic route the exclusion overlaps', {","+\t\ttimeout: 30000,","+\t}, async () => {","+\t\tconst url = await forwardedUrl('/anything-else');","+\t\tassert.equal(url.pathname, '/_isr');","+\t\tassert.equal(url.searchParams.get('x_astro_path'), '/anything-else');","+\t});","+","+\tit('renders paths no route matches instead of caching them', {","+\t\ttimeout: 30000,","+\t}, async () => {","+\t\t// The 404 catch-all reaches the middleware too. Forwarding those to `_isr`","+\t\t// would give every unmatched URL a cache entry.","+\t\tconst url = await forwardedUrl('/no/such/page');","+\t\tassert.equal(url.pathname, '/_render');","+\t});","+","+\tit('keeps the query string out of the cache key', { timeout: 30000 }, async () => {","+\t\tconst url = await forwardedUrl('/?foo=1');","+\t\tassert.equal(url.searchParams.get('x_astro_path'), '/');","+\t});","+","+\t/** The build's middleware secret, read back out of the generated middleware. */","+\tasync function middlewareSecret(): Promise<string> {","+\t\tconst bundle = await fixture.readFile(","+\t\t\t'../.vercel/output/functions/_middleware.func/middleware.mjs',","+\t\t);","+\t\tconst secret = (/\"x-astro-middleware-secret\":\\s*\"([^\"]+)\"/.exec(bundle))?.[1];","+\t\tassert.ok(secret, 'the generated middleware carries no secret');","+\t\treturn secret;","+\t}","+","+\tasync function isrFetch(path: string, headers: Record<string, string> = {}) {","+\t\tconst functionConfig = JSON.parse(","+\t\t\tawait fixture.readFile('../.vercel/output/functions/_isr.func/.vc-config.json'),","+\t\t);","+\t\tconst entry = new URL(","+\t\t\t`../.vercel/output/functions/_isr.func/${functionConfig.handler}`,","+\t\t\tfixture.config.outDir,","+\t\t);","+\t\tconst module = await import(entry.href);","+","+\t\treturn module.default.fetch(new Request(`https://example.com${path}`, { headers }));","+\t}","+","+\tit('keeps the query string the middleware forwarded', { timeout: 30000 }, async () => {","+\t\tconst secret = await middlewareSecret();","+\t\t// The query rides the header, not the forward URL: it must not be swallowed","+\t\t// by the path override.","+\t\tconst response = await isrFetch(","+\t\t\t`/_isr?x_astro_path=%2Fapi%2Fdata&x_astro_path_token=${secret}`,","+\t\t\t{","+\t\t\t\t'x-astro-middleware-secret': secret,","+\t\t\t\t'x-astro-path': '/api/data?foo=bar',","+\t\t\t},","+\t\t);","+","+\t\tassert.deepEqual(await response.json(), { ok: true, query: '?foo=bar' });","+\t});","+","+\tit('keeps the query string the route rewrite passed through', { timeout: 30000 }, async () => {","+\t\tconst secret = await middlewareSecret();","+\t\t// No middleware header: `passQuery` leaves the client's query on the request","+\t\t// while the path arrives as a param.","+\t\tconst response = await isrFetch(","+\t\t\t`/_isr?x_astro_path=%2Fapi%2Fdata&x_astro_path_token=${secret}&foo=bar`,","+\t\t);","+","+\t\tassert.deepEqual(await response.json(), { ok: true, query: '?foo=bar' });","+\t});","+","+\tit('still returns the response to the middleware', { timeout: 30000 }, async () => {","+\t\tconst entry = new URL(","+\t\t\t'../.vercel/output/functions/_middleware.func/middleware.mjs',","+\t\t\tfixture.config.outDir,","+\t\t);","+\t\tconst module = await import(entry.href);","+","+\t\tconst originalFetch = globalThis.fetch;","+\t\tglobalThis.fetch = async () => new Response('ok');","+\t\ttry {","+\t\t\tconst response = await module.default(new Request('http://example.com/'), {});","+\t\t\tassert.equal(response.headers.get('x-astro-middleware'), 'ran');","+\t\t} finally {","+\t\t\tglobalThis.fetch = originalFetch;","+\t\t}","+\t});","+});","+","+describe('ISR with edge middleware reque