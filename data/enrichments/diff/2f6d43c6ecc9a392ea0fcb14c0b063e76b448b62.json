{"id":"2f6d43c6ecc9a392ea0fcb14c0b063e76b448b62","axis":"silent","repo":"tiangolo/fastapi","sha":"2f6d43c6ecc9a392ea0fcb14c0b063e76b448b62","parsed":{"files":[{"path":"docs/en/docs/tutorial/cookie-param-models.md","lines":["@@ -77,6 +77,16 @@ You can combine multiple cookie parameter models with individual cookie paramete"," "," Parameters declared elsewhere in the same operation or its dependencies are not treated as extra fields of a model. Undeclared cookie parameters still follow the model's `extra` configuration."," ","+## Optional Cookie Parameter Models { #optional-cookie-parameter-models }","+","+Declare a cookie parameter model with `| None` and a default of `None` to make the group optional.","+","+{* ../../docs_src/cookie_param_models/tutorial003_an_py310.py hl[15] *}","+","+If neither `theme` nor `locale` is sent, `preferences` is `None`. If either is sent, FastAPI validates the model and requires both fields.","+","+The same rules for defaults, extra fields, and OpenAPI apply as for [optional query parameter models](query-param-models.md#optional-query-parameter-models).","+"," ## Summary { #summary }"," "," You can use **Pydantic models** to declare <dfn title=\"Have a last cookie before you go. 🍪\">**cookies**</dfn> in **FastAPI**. 😎"],"additions":10,"deletions":0,"truncated":false},{"path":"docs/en/docs/tutorial/header-param-models.md","lines":["@@ -75,6 +75,18 @@ Parameters declared elsewhere in the same operation or its dependencies are not"," "," Each model uses its own `Header(convert_underscores=...)` setting, both when reading the request and when generating OpenAPI. Explicit field aliases remain literal header names."," ","+## Optional Header Parameter Models { #optional-header-parameter-models }","+","+Declare a header parameter model with `| None` and a default of `None` to make the group optional.","+","+{* ../../docs_src/header_param_models/tutorial004_an_py310.py hl[15] *}","+","+If neither `x-client-name` nor `x-client-version` is sent, `client` is `None`. If either is sent, FastAPI validates the model and requires both fields.","+","+The same rules for defaults, extra fields, and OpenAPI apply as for [optional query parameter models](query-param-models.md#optional-query-parameter-models).","+","+Headers such as `Host` also follow the model's `extra` configuration. With `extra=\"allow\"`, they make the model present even if neither declared field is supplied.","+"," ## Summary { #summary }"," "," You can use **Pydantic models** to declare **headers** in **FastAPI**. 😎"],"additions":12,"deletions":0,"truncated":false},{"path":"docs/en/docs/tutorial/query-param-models.md","lines":["@@ -77,6 +77,22 @@ With `extra=\"forbid\"`, parameters declared elsewhere in the same operation or it"," "," This also works for `Header` and `Cookie` models."," ","+## Optional Query Parameter Models { #optional-query-parameter-models }","+","+Declare a query parameter model with `| None` and a default of `None` to make the group optional.","+","+{* ../../docs_src/query_param_models/tutorial004_an_py310.py hl[18] *}","+","+If neither `start` nor `end` is sent, `date_range` is `None`. If either is sent, FastAPI validates the model and requires both fields.","+","+Using `| None` without a default still makes the parameter required.","+","+Unknown parameters follow the model's `extra` configuration. Ignored extras do not make the model present.","+","+OpenAPI lists the group's fields individually and marks them as optional.","+","+You can also declare optional [header parameter models](header-param-models.md#optional-header-parameter-models) and [cookie parameter models](cookie-param-models.md#optional-cookie-parameter-models).","+"," ## Summary { #summary }"," "," You can use **Pydantic models** to declare **query parameters** in **FastAPI**. 😎"],"additions":16,"deletions":0,"truncated":false},{"path":"docs_src/cookie_param_models/tutorial003_an_py310.py","lines":["@@ -0,0 +1,16 @@","+from typing import Annotated","+","+from fastapi import Cookie, FastAPI","+from pydantic import BaseModel","+","+app = FastAPI()","+","+","+class Preferences(BaseModel):","+    theme: str","+    locale: str","+","+","+@app.get(\"/items/\")","+async def read_items(preferences: Annotated[Preferences | None, Cookie()] = None):","+    return preferences"],"additions":16,"deletions":0,"truncated":false},{"path":"docs_src/cookie_param_models/tutorial003_py310.py","lines":["@@ -0,0 +1,14 @@","+from fastapi import Cookie, FastAPI","+from pydantic import BaseModel","+","+app = FastAPI()","+","+","+class Preferences(BaseModel):","+    theme: str","+    locale: str","+","+","+@app.get(\"/items/\")","+async def read_items(preferences: Preferences | None = Cookie(default=None)):","+    return preferences"],"additions":14,"deletions":0,"truncated":false},{"path":"docs_src/header_param_models/tutorial004_an_py310.py","lines":["@@ -0,0 +1,16 @@","+from typing import Annotated","+","+from fastapi import FastAPI, Header","+from pydantic import BaseModel","+","+app = FastAPI()","+","+","+class ClientHeaders(BaseModel):","+    x_client_name: str","+    x_client_version: str","+","+","+@app.get(\"/items/\")","+async def read_items(client: Annotated[ClientHeaders | None, Header()] = None):","+    return client"],"additions":16,"deletions":0,"truncated":false},{"path":"docs_src/header_param_models/tutorial004_py310.py","lines":["@@ -0,0 +1,14 @@","+from fastapi import FastAPI, Header","+from pydantic import BaseModel","+","+app = FastAPI()","+","+","+class ClientHeaders(BaseModel):","+    x_client_name: str","+    x_client_version: str","+","+","+@app.get(\"/items/\")","+async def read_items(client: ClientHeaders | None = Header(default=None)):","+    return client"],"additions":14,"deletions":0,"truncated":false},{"path":"docs_src/query_param_models/tutorial004_an_py310.py","lines":["@@ -0,0 +1,20 @@","+from datetime import date","+from typing import Annotated","+","+from fastapi import FastAPI, Query","+from pydantic import 