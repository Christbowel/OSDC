nt(app)","+    response = client.get(\"/\")","+    assert response.status_code == 200, response.text","+    assert response.json() is None","+    response = client.get(","+        \"/\", params={\"start\": \"0\", \"end\": \"10\", \"tags\": [\"a\", \"b\"], \"label\": \"\"}","+    )","+    assert response.status_code == 200, response.text","+    assert response.json() == {","+        \"start\": 0,","+        \"end\": 10,","+        \"tags\": [\"a\", \"b\"],","+        \"enabled\": True,","+        \"label\": \"\",","+    }","+    response = client.get(\"/\", params={\"start\": \"\", \"end\": \"10\"})","+    assert response.status_code == 422"],"additions":45,"deletions":0,"truncated":false}],"additions":672,"deletions":19,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-10-22T13:45:35.480362+00:00"}