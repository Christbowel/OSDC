ag parameter. Use kExternalPointerTypeTagDefault"," for all existing call sites."," "," diff --git a/src/crypto/crypto_context.cc b/src/crypto/crypto_context.cc","-index b531f3649d44c700af92f454302c11d2d8660f2c..0b5db5e13715ffa214a0d4c87879dacd686e51ea 100644","+index 9fbca1812491c8a181ab791eeb33a18f906af66f..03a3b93f0cf60a6eab4128a8e58a240169ed2d06 100644"," --- a/src/crypto/crypto_context.cc"," +++ b/src/crypto/crypto_context.cc","-@@ -2628,7 +2628,7 @@ int SecureContext::TicketCompatibilityCallback(SSL* ssl,","+@@ -2625,7 +2625,7 @@ int SecureContext::TicketCompatibilityCallback(SSL* ssl,","  void SecureContext::CtxGetter(const FunctionCallbackInfo<Value>& info) {","    SecureContext* sc;","    ASSIGN_OR_RETURN_UNWRAP(&sc, info.This());","@@ -78,10 +78,10 @@ index 75ce4c921b5acf5d612aeb5a7720b5874b6066ac..6c87611f7cbaf8a0b4c04f812f65381e","  ","    void* Data() { return data_; }"," diff --git a/src/node_modules.cc b/src/node_modules.cc","-index 541c1580f7b29cb2bdd4bbdc5e056b46bba08dbb..34ced47c7142be3ab8d97840ea88770c18b0742b 100644","+index 757d39558f7853d39ee0d574152bb3810cfa3ca5..51c097e69388a516aa7a9239053367faa4f7595e 100644"," --- a/src/node_modules.cc"," +++ b/src/node_modules.cc","-@@ -650,7 +650,7 @@ void GetCompileCacheEntry(const FunctionCallbackInfo<Value>& args) {","+@@ -665,7 +665,7 @@ void GetCompileCacheEntry(const FunctionCallbackInfo<Value>& args) {","    v8::LocalVector<v8::Name> names(isolate,","                                    {FIXED_ONE_BYTE_STRING(isolate, \"external\")});","    v8::LocalVector<v8::Value> values(isolate,","@@ -90,7 +90,7 @@ index 541c1580f7b29cb2bdd4bbdc5e056b46bba08dbb..34ced47c7142be3ab8d97840ea88770c","    if (cache_entry->cache != nullptr) {","      Debug(env,","            DebugCategory::COMPILE_CACHE,","-@@ -760,7 +760,7 @@ void SaveCompileCacheEntry(const FunctionCallbackInfo<Value>& args) {","+@@ -775,7 +775,7 @@ void SaveCompileCacheEntry(const FunctionCallbackInfo<Value>& args) {","    CHECK(args[0]->IsExternal());","    CHECK(args[1]->IsString());  // TODO(joyeecheung): accept buffer.","    auto* cache_entry =","@@ -113,7 +113,7 @@ index ce381c00888b032c281938a7bab334058e075ec8..6d3373caae6c5cc22e16fc32e7ea0071","    Local<BigInt> ret = BigInt::NewFromUnsigned(isolate, value);","    args.GetReturnValue().Set(ret);"," diff --git a/src/stream_base.cc b/src/stream_base.cc","-index 360986c8935dde85d7e946699731b17a3bd5d209..c61bb72fabb8854a5b3a3fc88b347581fcb5c1ca 100644","+index f57f75e5f2750a8f56258c043717c15adad1cf2a..287a41b3af00ea937ca0267a230b94c9c6566f00 100644"," --- a/src/stream_base.cc"," +++ b/src/stream_base.cc"," @@ -649,7 +649,7 @@ void StreamBase::GetExternal(const FunctionCallbackInfo<Value>& args) {"],"additions":6,"deletions":6,"truncated":false},{"path":"patches/node/fix_allow_electron_s_linked_bindings_under_the_permission_model.patch","lines":["@@ -0,0 +1,48 @@","+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001","+From: Sam Attard <sattard@anthropic.com>","+Date: Wed, 9 Sep 2026 13:41:43 +0000","+Subject: fix: allow Electron's linked bindings under the permission model","+","+https://github.com/nodejs/node/pull/65432 made process._linkedBinding()","+throw ERR_ACCESS_DENIED when the permission model is enabled without","+--allow-addons. Electron exposes all of its built-in modules to JS as","+linked bindings (electron_common_*, electron_browser_*, ...), and its","+own bootstrap script (node_init and friends) reaches them through","+process._linkedBinding(), so with that change `electron --permission`","+in ELECTRON_RUN_AS_NODE mode can no longer initialise Electron's Node.js","+integration (ASAR support etc.) and logs a CompileAndCall error.","+","+In an Electron build the linked-binding list only ever contains","+Electron's own runtime modules; applications cannot link bindings into","+the binary and real native addons still go through process.dlopen(),","+which remains gated on --allow-addons. Exempt the electron_* bindings","+from the addon check so the runtime can bootstrap, while keeping the","+upstream behaviour for any other name.","+","+This can be removed if upstream grows a way for embedders to register","+linked bindings that are not treated as addons by the permission model,","+or if Electron stops routing its internal bindings through","+process._linkedBinding().","+","+diff --git a/src/node_binding.cc b/src/node_binding.cc","+index 9f34534d2fa8e52612d4e1d55a39742213046218..ba3f06b8df90bce623e656940a27fae2b4e0206d 100644","+--- a/src/node_binding.cc","+@@ -670,8 +670,15 @@ void GetLinkedBinding(const FunctionCallbackInfo<Value>& args) {","+ ","+   node::Utf8Value module_name_v(env->isolate(), module_name);","+   const char* name = *module_name_v;","+-  THROW_IF_INSUFFICIENT_PERMISSIONS(","+-      env, permission::PermissionScope::kAddon, module_name_v.ToStringView());","++  // Electron's built-in modules are registered as linked bindings and are","++  // part of the runtime rather than user-supplied addons; Electron's own","++  // bootstrap scripts cannot run without them, so they are not subject to","++  // the addon permission.","++  if (!module_name_v.ToStringView().starts_with(\"electron_\")) {","++    THROW_IF_INSUFFICIENT_PERMISSIONS(env,","++                                      permission::PermissionScope::kAddon,","++                                      module_name_v.ToStringView());","++  }","+ ","+   node_module* mod = nullptr;","+ "],"additions":47,"deletions":0,"truncated":false},{"path":"patches/node/fix_allow_passing_fileexists_fn_to_legacymainresolve.patch","lines":["@@ -50,10 +50,10 @@ index e7311af43237c9459263d15c6b10749b92a5b7d3..66f71c3845361cc380d89ec50472658b","    const maybeMain = resolvedOption <= legacyMainResolveExtensionsIndexes.kResolvedByMainIndexNode ?","      packageConfig.main || './' : '';"," diff --git a/src/node_file.cc b/src/node_file.cc","-index 126913185e0cd3e0e78cb2fb92177c9a8d9de044..5be1b553e29dbcc78c4bee1b778587ede6bc60f8 100644","+index a576b4a9d4ebbee73cd3ea038ab2d84210fcc21b..c2bc9dfaa6a0d10624362d217fe591d8465a6c3a 100644"," --- a/src/node_file.cc"," +++ b/src/node_file.cc","-@@ -3877,13 +3877,25 @@ static void CpSyncCopyDir(const FunctionCallbackInfo<Value>& args) {","+@@ -3943,13 +3943,25 @@ static void CpSyncCopyDir(const FunctionCallbackInfo<Value>& args) {","  }","  ","  BindingData::FilePathIsFileReturnType BindingData::FilePathIsFile(","@@ -80,7 +80,7 @@ index 126913185e0cd3e0e78cb2fb92177c9a8d9de044..5be1b553e29dbcc78c4bee1b778587ed","    uv_fs_t req;","  ","    int rc = uv_fs_stat(env->event_loop(), &req, file_path.c_str(), nullptr);","-@@ -3941,6 +3953,11 @@ void BindingData::LegacyMainResolve(const FunctionCallbackInfo<Value>& args) {","+@@ -4007,6 +4019,11 @@ void BindingData::LegacyMainResolve(const FunctionCallbackInfo<Value>& args) {","    std::optional<std::string> initial_file_path;","    std::string file_path;","  ","@@ -92,7 +92,7 @@ index 126913185e0cd3e0e78cb2fb92177c9a8d9de044..5be1b553e29dbcc78c4bee1b778587ed","    if (args.Length() >= 2 && args[1]->IsString()) {","      auto package_config_main = Utf8Value(isolate, args[1]).ToString();"],"additions":3,"deletions":3,"truncated":false}],"additions":107,"deletions":59,"truncated":true,"file_count":13},"error":null,"fetched_at":"2026-09-10T12:26:27.500294+00:00"}