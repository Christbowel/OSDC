{"id":"0c7dae72b5b6e543fbb0b93ac95a7ff97e5f5d93","axis":"silent","repo":"open-telemetry/opentelemetry-collector","sha":"0c7dae72b5b6e543fbb0b93ac95a7ff97e5f5d93","parsed":{"files":[{"path":".chloggen/11449-sanitize-invalid-utf8-pdata.yaml","lines":["@@ -0,0 +1,25 @@","+# Use this changelog template to create an entry for release notes.","+","+# One of 'breaking', 'deprecation', 'new_component', 'enhancement', 'bug_fix'","+change_type: enhancement","+","+# The name of the component, or a single word describing the area of concern, (e.g. receiver/otlp)","+component: pkg/pdata","+","+# A brief description of the change.  Surround your text with quotes (\"\") if it needs to start with a backtick (`).","+note: Add `SanitizeUTF8` to the OTLP `ExportRequest` types to replace invalid UTF-8 byte sequences in all string fields with `U+FFFD`","+","+# One or more tracking issues or pull requests related to the change","+issues: [11449]","+","+# (Optional) One or more lines of additional information to render under the primary note.","+# These lines will be padded with 2 spaces and then inserted directly into the document.","+# Use pipe (|) for multiline entries.","+subtext:","+","+# Optional: The change log or logs in which this entry should be included.","+# e.g. '[user]' or '[user, api]'","+# Include 'user' if the change is relevant to end users.","+# Include 'api' if there is a change to a library API.","+# Default: '[user]'","+change_logs: [api]"],"additions":25,"deletions":0,"truncated":false},{"path":"pdata/internal/utf8.go","lines":["@@ -5,9 +5,81 @@ package internal // import \"go.opentelemetry.io/collector/pdata/internal\""," "," import ("," \t\"reflect\"","+\t\"strings\""," \t\"unicode/utf8\""," )"," ","+// utf8Replacement is the Unicode replacement character used for invalid UTF-8 byte sequences.","+const utf8Replacement = \"�\"","+","+// SanitizeUTF8String returns s unchanged when it is valid UTF-8. Otherwise it returns a copy of s","+// where every run of invalid UTF-8 bytes is replaced with the Unicode replacement character U+FFFD.","+func SanitizeUTF8String(s string) string {","+\t// utf8.ValidString has an ASCII fast path and does not allocate, so valid strings (the common case)","+\t// cost a single scan. strings.ToValidUTF8 only allocates when there is something to replace.","+\tif utf8.ValidString(s) {","+\t\treturn s","+\t}","+\treturn strings.ToValidUTF8(s, utf8Replacement)","+}","+","+// SanitizeUTF8StringSlice sanitizes every string in ss in place.","+func SanitizeUTF8StringSlice(ss []string) {","+\tfor i := range ss {","+\t\tss[i] = SanitizeUTF8String(ss[i])","+\t}","+}","+","+// SanitizeUTF8AnyValue sanitizes the string value and all nested string values and keys of v in place.","+// Bytes values and string table indices are left untouched.","+func SanitizeUTF8AnyValue(v *AnyValue) {","+\tswitch ov := v.Value.(type) {","+\tcase *AnyValue_StringValue:","+\t\tov.StringValue = SanitizeUTF8String(ov.StringValue)","+\tcase *AnyValue_ArrayValue:","+\t\tif ov.ArrayValue != nil {","+\t\t\tSanitizeUTF8AnyValueSlice(ov.ArrayValue.Values)","+\t\t}","+\tcase *AnyValue_KvlistValue:","+\t\tif ov.KvlistValue != nil {","+\t\t\tSanitizeUTF8KeyValueSlice(ov.KvlistValue.Values)","+\t\t}","+\t}","+}","+","+// SanitizeUTF8AnyValueSlice sanitizes every value in vs in place.","+func SanitizeUTF8AnyValueSlice(vs []AnyValue) {","+\tfor i := range vs {","+\t\tSanitizeUTF8AnyValue(&vs[i])","+\t}","+}","+","+// SanitizeUTF8KeyValueSlice sanitizes every key and value in kvs in place.","+func SanitizeUTF8KeyValueSlice(kvs []KeyValue) {","+\tfor i := range kvs {","+\t\tkvs[i].Key = SanitizeUTF8String(kvs[i].Key)","+\t\tSanitizeUTF8AnyValue(&kvs[i].Value)","+\t}","+}","+","+// SanitizeUTF8Resource sanitizes the attributes and entity references of r in place.","+func SanitizeUTF8Resource(r *Resource) {","+\tSanitizeUTF8KeyValueSlice(r.Attributes)","+\tfor _, er := range r.EntityRefs {","+\t\ter.SchemaUrl = SanitizeUTF8String(er.SchemaUrl)","+\t\ter.Type = SanitizeUTF8String(er.Type)","+\t\tSanitizeUTF8StringSlice(er.IdKeys)","+\t\tSanitizeUTF8StringSlice(er.DescriptionKeys)","+\t}","+}","+","+// SanitizeUTF8InstrumentationScope sanitizes the name, version and attributes of s in place.","+func SanitizeUTF8InstrumentationScope(s *InstrumentationScope) {","+\ts.Name = SanitizeUTF8String(s.Name)","+\ts.Version = SanitizeUTF8String(s.Version)","+\tSanitizeUTF8KeyValueSlice(s.Attributes)","+}","+"," // ValidateUTF8 returns false when any string in v contains invalid UTF-8."," func ValidateUTF8(v any) bool {"," \treturn validateUTF8(reflect.ValueOf(v))"],"additions":72,"deletions":0,"truncated":false},{"path":"pdata/internal/utf8_logs.go","lines":["@@ -0,0 +1,34 @@","+// Copyright The OpenTelemetry Authors","+// SPDX-License-Identifier: Apache-2.0","+","+package internal // import \"go.opentelemetry.io/collector/pdata/internal\"","+","+// SanitizeUTF8ExportLogsServiceRequest replaces invalid UTF-8 byte sequences in every string field of req","+// with the Unicode replacement character U+FFFD.","+func SanitizeUTF8ExportLogsServiceRequest(req *ExportLogsServiceRequest) {","+\tfor _, rl := range req.ResourceLogs {","+\t\tSanitizeUTF8Resource(&rl.Resource)","+\t\trl.SchemaUrl = SanitizeUTF8String(rl.SchemaUrl)","+\t\tsanitizeUTF8ScopeLogsSlice(rl.ScopeLogs)","+\t\t// DeprecatedScopeLogs is normally emptied by otlp.MigrateLogs, but JSON unmarshalling can still","+\t\t// populate it, so it is walked as well.","+\t\tsanitizeUTF8ScopeLogsSlice(rl.DeprecatedScopeLogs)","+\t}","+}","+","+func sanitizeUTF8ScopeLogsSlice(sls []*ScopeLogs) {","+\tfor _, sl := range sls {","+\t\tSanitizeUTF8InstrumentationScope(&sl.Scope)","+\t\tsl.SchemaUrl = SanitizeUTF8String(sl.SchemaUrl)","+\t\tfor _, lr := range sl.LogRecords {","+\t\t\tsanitizeUTF8LogRecord(lr)","+\t\t}","+\t}","+}","+","+func sanitizeUTF8LogRecord(lr *LogRecord) {","+\tlr.SeverityText = SanitizeUTF8String(lr.SeverityText)","+\tlr.EventName = SanitizeUTF8String(lr.EventName)","+\tSanitizeUTF8AnyValue(&lr.Body)","+\tSanitizeUTF8KeyValueSlice(lr.Attributes)","+}"],"additions":34,"deletions":0,"truncated":false},{"path":"pdata/internal/utf8_metrics.go","lines":["@@ -0,0 +1,77 @@","+// Copyright The OpenTelemetry Authors","+// SPDX-License-Identifier: Apache-2.0","+","+package internal // import \"go.opentelemetry.io/collector/pdata/internal\"","+","+// SanitizeUTF8ExportMetricsServiceRequest replaces invalid UTF-8 byte sequences in every string field of req","+// with the Unicode replacement character U+FFFD.","+func SanitizeUTF8ExportMetricsServiceRequest(req *ExportMetricsServiceRequest) {","+\tfor _, rm := range req.ResourceMetrics {","+\t\tSanitizeUTF8Resource(&rm.Resource)","+\t\trm.SchemaUrl = SanitizeUTF8String(rm.SchemaUrl)","+\t\tsanitizeUTF8ScopeMetricsSlice(rm.ScopeMetrics)","+\t\t// DeprecatedScopeMetrics is normally emptied by otlp.MigrateMetrics, but JSON unmarshalling can","+\t\t// still populate it, so it is walked as well.","+\t\tsanitizeUTF8ScopeMetricsSlice(rm.DeprecatedScopeMetrics)","+\t}","+}","+","+func sanitizeUTF8ScopeMetricsSlice(sms []*ScopeMetrics) {","+\tfor _, sm := range sms {","+\t\tSanitizeUTF8InstrumentationScope(&sm.Scope)","+\t\tsm.SchemaUrl = SanitizeUTF8String(sm.SchemaUrl)","+\t\tfor _, m := range sm.Metrics {","+\t\t\tsanitizeUTF8Metric(m)","+\t\t}","+\t}","+}","+","+func sanitizeUTF8Metric(m *Metric) {","+\tm.Name = SanitizeUTF8String(m.Name)","+\tm.Description = SanitizeUTF8String(m.Description)","+\tm.Unit = SanitizeUTF8String(m.Unit)","+\tSanitizeUTF8KeyValueSlice(m.Metadata)","+\tswitch data := m.Data.(type) {","+\tcase *Metric_Gauge:","+\t\tif data.Gauge != nil {","+\t\t\tsanitizeUTF8NumberDataPoints(data.Gauge.DataPoints)","+\t\t}","+\tcase *Metric_Sum:","+\t\tif data.Sum != nil {","+\t\t\tsanitizeUTF8NumberDataPoints(data.Sum.DataPoints)","+\t\t}","+\tcase *Metric_Histogram:","+\t\tif data.Histogram != nil {","+\t\t\tfor _, dp := range data.Histogram.DataPoints {","+\t\t\t\tSanitizeUTF8KeyValueSlice(dp.Attributes)","+\t\t\t\tsanitizeUTF8Exemplars(dp.Exemplars)","+\t\t\t}","+\t\t}","+\tcase *Metric_ExponentialHistogram:","+\t\tif data.ExponentialHistogram != nil {","+\t\t\tfor _, dp := range data.ExponentialHistogram.DataPoints {","+\t\t\t\tSanitizeUTF8KeyValueSlice(dp.Attributes)","+\t\t\t\tsanitizeUTF8Exemplars(dp.Exemplars)","+\t\t\t}","+\t\t}","+\tcase *Metric_Summary:","+\t\tif data.Summary != nil {","+\t\t\tfor _, dp := range data.Summary.DataPoints {","+\t\t\t\tSanitizeUTF8KeyValueSlice(dp.Attributes)","+\t\t\t}","+\t\t}","+\t}","+}","+","+func sanitizeUTF8NumberDataPoints(dps []*NumberDataPoint) {","+\tfor _, dp := range dps {","+\t\tSanitizeUTF8KeyValueSlice(dp.Attributes)","+\t\tsanitizeUTF8Exemplars(dp.Exemplars)","+\t}","+}","+","+func sanitizeUTF8Exemplars(exemplars []Exemplar) {","+\tfor i := range exemplars {","+\t\tSanitizeUTF8KeyValueSlice(exemplars[i].FilteredAttributes)","+\t}","+}"],"additions":77,"deletions":0,"truncated":false},{"path":"pdata/internal/utf8_profiles.go","lines":["@@ -0,0 +1,25 @@","+// Copyright The OpenTelemetry Authors","+// SPDX-License-Identifier: Apache-2.0","+","+package internal // import \"go.opentelemetry.io/collector/pdata/internal\"","+","+// SanitizeUTF8ExportProfilesServiceRequest replaces invalid UTF-8 byte sequences in every string field of req","+// with the Unicode replacement character U+FFFD. Strings referenced through the profiles","+// dictionary are sanitized once in the dictionary string table.","+func SanitizeUTF8ExportProfilesServiceRequest(req *ExportProfilesServiceRequest) {","+\tSanitizeUTF8StringSlice(req.Dictionary.StringTable)","+\tfor _, kv := range req.Dictionary.AttributeTable {","+\t\tSanitizeUTF8AnyValue(&kv.Value)","+\t}","+\tfor _, rp := range req.ResourceProfiles {","+\t\tSanitizeUTF8Resource(&rp.Resource)","+\t\trp.SchemaUrl = SanitizeUTF8String(rp.SchemaUrl)","+\t\tfor _, sp := range rp.ScopeProfiles {","+\t\t\tSanitizeUTF8InstrumentationScope(&sp.Scope)","+\t\t\tsp.SchemaUrl = SanitizeUTF8String(sp.SchemaUrl)","+\t\t\tfor _, p := range sp.Profiles {","+\t\t\t\tp.OriginalPayloadFormat = SanitizeUTF8String(p.OriginalPayloadFormat)","+\t\t\t}","+\t\t}","+\t}","+}"],"additions":25,"deletions":0,"truncated":false},{"path":"pdata/internal/utf8_test.go","lines":["@@ -4,11 +4,438 @@"," package internal"," "," import (","+\t\"fmt\"","+\t\"reflect\"","+\t\"strings\""," \t\"testing\"","+\t\"unicode/utf8\""," "," \t\"github.com/stretchr/testify/assert\"","+\t\"github.com/stretchr/testify/require\""," )"," ","+const (","+\tutf8InvalidStr   = \"bad\\xff\\xfestring\"","+\tutf8SanitizedStr = \"bad�string\"","+)","+","+func utf8StrValue(s string) AnyValue {","+\treturn AnyValue{Value: &AnyValue_StringValue{StringValue: s}}","+}","+","+func utf8KeyValues(s string) []KeyValue {","+\treturn []KeyValue{","+\t\t{Key: s, Value: utf8StrValue(s)},","+\t\t{Key: \"int\", Value: AnyValue{Value: &AnyValue_IntValue{IntValue: 1}}},","+\t\t{Key: \"bytes\", Value: AnyValue{Value: &AnyValue_BytesValue{BytesValue: []byte(utf8InvalidStr)}}},","+\t\t{Key: \"array\", Value: AnyValue{Value: &AnyValue_ArrayValue{ArrayValue: &ArrayValue{Values: []AnyValue{utf8StrValue(s), {}}}}}},","+\t\t{Key: \"kvlist\", Value: AnyValue{Value: &AnyValue_KvlistValue{KvlistValue: &KeyValueList{Values: []KeyValue{{Key: s, Value: utf8StrValue(s)}}}}}},","+\t\t{Key: \"empty\"},","+\t}","+}","+","+func utf8Resource(s string) Resource {","+\treturn Resource{","+\t\tAttributes: utf8KeyValues(s),","+\t\tEntityRefs: []*EntityRef{{SchemaUrl: s, Type: s, IdKeys: []string{s, \"ok\"}, DescriptionKeys: []string{s}}},","+\t}","+}","+","+func utf8Scope(s string) InstrumentationScope {","+\treturn InstrumentationScope{Name: s, Version: s, Attributes: utf8KeyValues(s)}","+}","+","+func TestSanitizeUTF8String(t *testing.T) {","+\ttests := []struct {","+\t\tname string","+\t\tin   string","+\t\twant string","+\t}{","+\t\t{name: \"empty\", in: \"\", want: \"\"},","+\t\t{name: \"ascii\", in: \"hello\", want: \"hello\"},","+\t\t{name: \"multibyte\", in: \"héllo 世界 🌍\", want: \"héllo 世界 🌍\"},","+\t\t{name: \"single invalid byte\", in: \"a\\xffb\", want: \"a�b\"},","+\t\t{name: \"run of invalid bytes\", in: \"a\\xff\\xfe\\xfdb\", want: \"a�b\"},","+\t\t{name: \"truncated multibyte\", in: \"a\\xe4\\xb8\", want: \"a�\"},","+\t\t{name: \"only invalid\", in: \"\\xff\", want: \"�\"},","+\t\t{name: \"surrogate half\", in: \"a\\xed\\xa0\\x80b\", want: \"a�b\"},","+\t}","+\tfor _, tt := range tests {","+\t\tt.Run(tt.name, func(t *testing.T) {","+\t\t\tassert.Equal(t, tt.want, SanitizeUTF8String(tt.in))","+\t\t})","+\t}","+}","+","+func TestSanitizeUTF8StringNoAllocWhenValid(t *testing.T) {","+\tin := strings.Repeat(\"valid\", 10)","+\tallocs := testing.AllocsPerRun(100, func() {","+\t\tif SanitizeUTF8String(in) != in {","+\t\t\tt.Fatal(\"valid string must be returned unchanged\")","+\t\t}","+\t})","+\tassert.Zero(t, allocs)","+}","+","+func TestSanitizeUTF8AnyValue(t *testing.T) {","+\tt.Run(\"nil value\", func(t *testing.T) {","+\t\tv := AnyValue{}","+\t\tSanitizeUTF8AnyValue(&v)","+\t\tassert.Equal(t, AnyValue{}, v)","+\t})","+","+\tt.Run(\"nil array\", func(t *testing.T) {","+\t\tv := AnyValue{Value: &AnyValue_ArrayValue{}}","+\t\tSanitizeUTF8AnyValue(&v)","+\t\tassert.Equal(t, AnyValue{Value: &AnyValue_ArrayValue{}}, v)","+\t})","+","+\tt.Run(\"nil kvlist\", func(t *testing.T) {","+\t\tv := AnyValue{Value: &AnyValue_KvlistValue{}}","+\t\tSanitizeUTF8AnyValue(&v)","+\t\tassert.Equal(t, AnyValue{Value: &AnyValue_KvlistValue{}}, v)","+\t})","+","+\tt.Run(\"bytes untouched\", func(t *testing.T) {","+\t\tv := AnyValue{Value: &AnyValue_BytesValue{BytesValue: []byte(utf8InvalidStr)}}","+\t\tSanitizeUTF8AnyValue(&v)","+\t\tassert.Equal(t, []byte(utf8InvalidStr), v.Value.(*AnyValue_BytesValue).BytesValue)","+\t})","+","+\tt.Run(\"string table index untouched\", func(t *testing.T) {","+\t\tv := AnyValue{Value: &AnyValue_StringValueStrindex{StringValueStrindex: 3}}","+\t\tSanitizeUTF8AnyValue(&v)","+\t\tassert.Equal(t, AnyValue{Value: &AnyValue_StringValueStrindex{StringValueStrindex: 3}}, v)","+\t})","+","+\tt.Run(\"nested\", func(t *testing.T) {","+\t\tkvs := utf8KeyValues(utf8InvalidStr)","+\t\tSanitizeUTF8KeyValueSlice(kvs)","+\t\tassert.Equal(t, utf8KeyValues(utf8SanitizedStr), kvs)","+\t})","+}","+","+func TestSanitizeUTF8Resource(t *testing.T) {","+\tr := utf8Resource(utf8InvalidStr)","+\tSanitizeUTF8Resource(&r)","+\tassert.Equal(t, utf8Resource(utf8SanitizedStr), r)","+}","+","+func TestSanitizeUTF8InstrumentationScope(t *testing.T) {","+\ts := utf8Scope(utf8InvalidStr)","+\tSanitizeUTF8InstrumentationScope(&s)","+\tassert.Equal(t, utf8Scope(utf8SanitizedStr), s)","+}","+","+func utf8LogsRequest(s string) *ExportLogsServiceRequest {","+\treturn &ExportLogsServiceRequest{","+\t\tResourceLogs: []*ResourceLogs{{","+\t\t\tResource:  utf8Resource(s),","+\t\t\tSchemaUrl: s,","+\t\t\tScopeLogs: []*ScopeLogs{{","+\t\t\t\tScope:     utf8Scope(s),","+\t\t\t\tSchemaUrl: s,","+\t\t\t\tLogRecords: []*LogRecord{","+\t\t\t\t\t{SeverityText: s, EventName: s, Body: utf8StrValue(s), Attributes: utf8KeyValues(s)},","+\t\t\t\t\t{Body: AnyValue{Value: &AnyValue_KvlistValue{KvlistValue: &KeyValueList{Values: utf8KeyValues(s)}}}},","+\t\t\t\t\t{Body: AnyValue{Value: &AnyValue_BytesValue{BytesValue: []byte(utf8InvalidStr)}}},","+\t\t\t\t},","+\t\t\t}},","+\t\t\tDeprecatedScopeLogs: []*ScopeLogs{{","+\t\t\t\tScope:      utf8Scope(s),","+\t\t\t\tLogRecords: []*LogRecord{{SeverityText: s}},","+\t\t\t}},","+\t\t}},","+\t}","+}","+","+func TestSanitizeUTF8ExportLogsServiceRequest(t *testing.T) {","+\treq := utf8LogsRequest(utf8InvalidStr)","+\tSanitizeUTF8ExportLogsServiceRequest(req)","+\tassert.Equal(t, utf8LogsRequest(utf8SanitizedStr), req)","+","+\tt.Run(\"valid request unchanged\", func(t *testing.T) {","+\t\treq := utf8LogsRequest(\"valid\")","+\t\tSanitizeUTF8ExportLogsServiceRequest(req)","+\t\tassert.Equal(t, utf8LogsRequest(\"valid\"), req)","+\t})","+","+\t