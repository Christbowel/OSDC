eate(&thread, nullptr, start, &func), 0);","+  ASSERT_EQ(pthread_join(thread, nullptr), 0);","+}","+} // namespace","+","+TEST(PThreadKeyTest, getAfterSet) {","+  pthread_key_t key;","+  ASSERT_EQ(pthread_key_create(&key, nullptr), 0);","+  int a = 0;","+  int b = 0;","+  EXPECT_EQ(pthread_getspecific(key), nullptr);","+  EXPECT_EQ(pthread_setspecific(key, &a), 0);","+  EXPECT_EQ(pthread_getspecific(key), &a);","+  runInPthread([&] {","+    EXPECT_EQ(pthread_getspecific(key), nullptr);","+    EXPECT_EQ(pthread_setspecific(key, &b), 0);","+    EXPECT_EQ(pthread_getspecific(key), &b);","+  });","+  std::thread([&] {","+    EXPECT_EQ(pthread_getspecific(key), nullptr);","+    EXPECT_EQ(pthread_setspecific(key, &b), 0);","+    EXPECT_EQ(pthread_getspecific(key), &b);","+  }).join();","+  EXPECT_EQ(pthread_getspecific(key), &a);","+  EXPECT_EQ(pthread_setspecific(key, nullptr), 0);","+  EXPECT_EQ(pthread_getspecific(key), nullptr);","+  EXPECT_EQ(pthread_key_delete(key), 0);","+}","+","+TEST(PThreadKeyTest, recreatedKeyStartsNull) {","+  int value = 0;","+  std::vector<pthread_key_t> keys(10);","+  for (auto& key : keys) {","+    ASSERT_EQ(pthread_key_create(&key, nullptr), 0);","+    EXPECT_EQ(pthread_getspecific(key), nullptr);","+    EXPECT_EQ(pthread_setspecific(key, &value), 0);","+  }","+  for (auto key : keys) {","+    EXPECT_EQ(pthread_key_delete(key), 0);","+  }","+  for (auto& key : keys) {","+    ASSERT_EQ(pthread_key_create(&key, nullptr), 0);","+    EXPECT_EQ(pthread_getspecific(key), nullptr);","+  }","+  for (auto key : keys) {","+    EXPECT_EQ(pthread_key_delete(key), 0);","+  }","+}","+","+TEST(PThreadKeyTest, manyKeys) {","+  constexpr int kNumKeys = 200;","+  std::vector<pthread_key_t> keys(kNumKeys);","+  for (auto& key : keys) {","+    ASSERT_EQ(pthread_key_create(&key, nullptr), 0);","+  }","+  std::vector<int> values(kNumKeys);","+  runInPthread([&] {","+    for (int i = 0; i < kNumKeys; ++i) {","+      EXPECT_EQ(pthread_setspecific(keys[i], &values[i]), 0);","+    }","+    for (int i = 0; i < kNumKeys; ++i) {","+      EXPECT_EQ(pthread_getspecific(keys[i]), &values[i]);","+    }","+  });","+  for (auto key : keys) {","+    EXPECT_EQ(pthread_key_delete(key), 0);","+  }","+}","+","+TEST(PThreadKeyTest, createFailsWithEagainWhenKeysRunOut) {","+  std::vector<pthread_key_t> keys;","+  int ret = 0;","+  while (keys.size() <= 100000) {","+    pthread_key_t key;","+    ret = pthread_key_create(&key, nullptr);","+    if (ret != 0) {","+      break;","+    }","+    keys.push_back(key);","+  }","+  EXPECT_EQ(ret, EAGAIN);","+  for (auto key : keys) {","+    EXPECT_EQ(pthread_key_delete(key), 0);","+  }","+  pthread_key_t key;","+  ASSERT_EQ(pthread_key_create(&key, nullptr), 0);","+  EXPECT_EQ(pthread_key_delete(key), 0);","+}","+","+TEST(PThreadKeyTest, recreatedKeyStartsNullInOtherThreads) {","+  pthread_key_t key;","+  ASSERT_EQ(pthread_key_create(&key, nullptr), 0);","+  int value = 0;","+  std::mutex mutex;","+  std::condition_variable cv;","+  int step = 0;","+  auto advanceTo = [&](int next) {","+    std::lock_guard lock(mutex);","+    step = next;","+    cv.notify_all();","+  };","+  auto waitFor = [&](int expected) {","+    std::unique_lock lock(mutex);","+    cv.wait(lock, [&] { return step == expected; });","+  };","+  std::vector<pthread_key_t> recreated(10);","+  std::thread other([&] {","+    EXPECT_EQ(pthread_setspecific(key, &value), 0);","+    advanceTo(1);","+    waitFor(2);","+    for (auto newKey : recreated) {","+      EXPECT_EQ(pthread_getspecific(newKey), nullptr);","+    }","+  });","+  waitFor(1);","+  EXPECT_EQ(pthread_key_delete(key), 0);","+  for (auto& newKey : recreated) {","+    ASSERT_EQ(pthread_key_create(&newKey, nullptr), 0);","+  }","+  advanceTo(2);","+  other.join();","+  for (auto newKey : recreated) {","+    EXPECT_EQ(pthread_key_delete(newKey), 0);","+  }","+}","+","+#if defined(_WIN32) && !FOLLY_HAVE_PTHREAD","+// The emulation reports invalid keys; POSIX leaves this undefined.","+TEST(PThreadKeyTest, emulationRejectsInvalidKeys) {","+  int value = 0;","+  pthread_key_t invalid = TLS_OUT_OF_INDEXES;","+  EXPECT_EQ(pthread_setspecific(invalid, &value), EINVAL);","+  EXPECT_EQ(pthread_getspecific(invalid), nullptr);","+  EXPECT_EQ(pthread_key_delete(invalid), EINVAL);","+}","+","+TEST(PThreadKeyTest, getspecificPreservesLastError) {","+  pthread_key_t key;","+  ASSERT_EQ(pthread_key_create(&key, nullptr), 0);","+  SetLastError(ERROR_FILE_NOT_FOUND);","+  EXPECT_EQ(pthread_getspecific(key), nullptr);","+  EXPECT_EQ(GetLastError(), ERROR_FILE_NOT_FOUND);","+  EXPECT_EQ(pthread_key_delete(key), 0);","+}","+#endif"],"additions":161,"deletions":0,"truncated":false},{"path":"folly/test/BUCK","lines":["@@ -636,7 +636,6 @@ fb_dirsync_cpp_unittest(","         \"FOLLY_FILE_LOCK_TEST_HELPER\": \"$(exe_target :file_test_lock_helper)\",","     },","     deps = [","-        \"fbsource//third-party/boost:boost_thread\",  # @manual","         \"fbsource//third-party/glog:glog\",","         \"//folly:file\",","         \"//folly:string\",","@@ -1305,7 +1304,6 @@ fb_dirsync_cpp_unittest(","     }),","     labels = [tpx_labels.heavyweight],","     deps = [","-        \"fbsource//third-party/boost:boost_thread\",  # @manual","         \":deterministic_schedule\",","         \":test_utils\",","         \"//folly:benchmark\",","@@ -1632,7 +1630,6 @@ fb_dirsync_cpp_benchmark(","     name = \"thread_local_benchmark\",","     srcs = [\"ThreadLocalBenchmark.cpp\"],","     deps = [","-        \"fbsource//third-party/boost:boost_thread\",  # @manual","         \"fbsource//third-party/glog:glog\",","         \"//folly:benchmark\",","         \"//folly:thread_local\","],"additions":0,"deletions":3,"truncated":false},{"path":"folly/test/FileLockTest.cpp","lines":["@@ -16,8 +16,8 @@"," "," #include <cstdlib>"," #include <mutex>","+#include <shared_mutex>"," ","-#include <boost/thread/locks.hpp>"," #include <glog/logging.h>"," "," #include <folly/File.h>","@@ -36,7 +36,7 