 \"bitbucket\",","+            HostedGitType::Gist => \"gist\",","         }","     }"," ","@@ -55,6 +63,7 @@ impl HostedGitType {","             \"github\" => Some(HostedGitType::Github),","             \"gitlab\" => Some(HostedGitType::Gitlab),","             \"bitbucket\" => Some(HostedGitType::Bitbucket),","+            \"gist\" => Some(HostedGitType::Gist),","             _ => None,","         }","     }","@@ -67,6 +76,7 @@ impl HostedGitType {","             \"github.com\" => Some(HostedGitType::Github),","             \"gitlab.com\" => Some(HostedGitType::Gitlab),","             \"bitbucket.org\" => Some(HostedGitType::Bitbucket),","+            \"gist.github.com\" => Some(HostedGitType::Gist),","             _ => None,","         }","     }","@@ -81,6 +91,10 @@ impl HostedGitType {","             HostedGitType::Gitlab | HostedGitType::Bitbucket => {","                 matches!(proto, \"git+ssh\" | \"git+https\" | \"ssh\" | \"https\")","             }","+            // gitHosts.gist.protocols","+            HostedGitType::Gist => {","+                matches!(proto, \"git\" | \"git+ssh\" | \"git+https\" | \"ssh\" | \"https\")","+            }","         }","     }"," }","@@ -199,22 +213,38 @@ impl HostedGit {","     /// nested in subgroups arrives with its groups joined by `/`, which","     /// a scope cannot hold; they join with `~`, which a group path","     /// cannot contain, so a nested path cannot be spelled by a group","-    /// name. A shortcut naming no owner keeps the bare project name.","+    /// name. A shortcut naming no owner keeps the bare project name, and","+    /// so does a gist, whose id is unique on its own.","     #[must_use]","     pub fn synthesized_package_name(&self) -> String {","-        if self.user.is_empty() {","+        if self.user.is_empty() || self.host_type == HostedGitType::Gist {","             return self.project.to_ascii_lowercase();","         }","         format!(\"@{}/{}\", self.user.replace('/', SUBGROUP_SEPARATOR), self.project)","             .to_ascii_lowercase()","     }"," ","+    /// Whether the URL forms name a whole repository. They do not for a","+    /// shortcut with no owner, such as `github:skills`. A gist needs no owner.","+    #[must_use]","+    pub fn names_repository(&self) -> bool {","+        !self.user.is_empty() || self.host_type == HostedGitType::Gist","+    }","+","+    /// The `<user>/<project>` path every URL form shares, or the bare","+    /// project id for a gist.","+    fn repo_path(&self) -> String {","+        if self.host_type == HostedGitType::Gist {","+            return self.project.clone();","+        }","+        format!(\"{}/{}\", self.user, self.project)","+    }","+","     /// Shorthand `<type>:<user>/<project>[#committish]`. Mirrors","     /// upstream's `shortcuttemplate`.","     #[must_use]","     pub fn shortcut(&self, opts: HostedOpts) -> String {","-        let mut out =","-            format!(\"{}:{}/{}\", self.host_type.shortcut_prefix(), self.user, self.project);","+        let mut out = format!(\"{}:{}\", self.host_type.shortcut_prefix(), self.repo_path());","         if !opts.no_committish","             && let Some(ref c) = self.committish","         {","@@ -234,10 +264,9 @@ impl HostedGit {","             .map(|a| format!(\"{a}@\"))","             .unwrap_or_default();","         let mut out = format!(","-            \"git+https://{auth}{domain}/{user}/{project}.git\",","+            \"git+https://{auth}{domain}/{path}.git\",","             domain = self.host_type.domain(),","-            user = self.user,","-            project = self.project,","+            path = self.repo_path(),","         );","         if !opts.no_committish","             && let Some(ref c) = self.committish","@@ -267,11 +296,20 @@ impl HostedGit {","     }"," ","     fn docs(&self) -> String {","+        let separator = match self.host_type {","+            HostedGitType::Github | HostedGitType::Gitlab => \"tree\",","+            HostedGitType::Bitbucket => \"src\",","+            // Upstream's gist `docstemplate`: no tree segment and no `#readme`.","+            HostedGitType::Gist => {","+                let mut out = format!(\"https://gist.github.com/{}\", self.project);","+                if let Some(committish) = &self.committish {","+                    out.push('/');","+                    out.push_str(&encode_uri_component(committish));","+                }","+                return out;","+            }","+        };","         if let Some(committish) = &self.committish {","-            let separator = match self.host_type {","-                HostedGitType::Github | HostedGitType::Gitlab => \"tree\",","-                HostedGitType::Bitbucket => \"src\",","-            };","             return format!(","                 \"https://{domain}/{user}/{project}/{separator}/{committish}#readme\",","                 domain = self.host_type.domain(),","@@ -293,10 +331,9 @@ impl HostedGit {","     #[must_use]","     pub fn ssh(&self, opts: HostedOpts) -> Option<String> {","         let mut out = format!(","-            \"git@{domain}:{user}/{project}.git\",","+            \"git@{domain}:{path}.git\",","             domain = self.host_type.domain(),","-            user = self.user,","-            project = self.project,","+            path = self.repo_path(),","         );","         if !opts.no_committish","             && let Some(ref c) = self.committish","@@ -312,10 +349,9 @@ impl HostedGit {","     #[must_use]","     pub fn sshurl(&self, opts: HostedOpts) -> Option<String> {","         let mut out = format!(","-            \"git+ssh://git@{domain}/{user}/{project}.git\",","+            \"git+ssh://git@{domain}/{path}.git\",","             domain = self.host_type.domain(),","-            user = self.user,","-            project = self.project,","+            path = self.repo_path(),","         );","         if !opts.no_committish","             && let Some(ref c) = self.committish","@@ -332,9 +368,9 @@ impl HostedGit {","     }"," ","     /// `git://[auth@]<domain>/<user>/<project>.git[#committish]`. Mirrors","-    /// upstream's `gittemplate`, which only GitHub defines.","+    /// upstream's `gittemplate`, which only GitHub and gist define.","     fn git(&self) -> Option<String> {","-        if self.host_type != HostedGitType::Github {","+        if !matches!(self.host_type, HostedGitType::Github | HostedGitType::Gist) {","             return None;","         }","         let auth = self.auth","@@ -342,10 +378,9 @@ impl HostedGit {","             .map(|auth| format!(\"{auth}@\"))","             .unwrap_or_default();","         let mut out = format!(","-            \"git://{auth}{domain}/{user}/{project}.git\",","+            \"git://{auth}{domain}/{path}.git\",","             domain = self.host_type.domain(),","-            user = self.user,","-            project = self.project,","+            path = self.repo_path(),","         );","         if let Some(committish) = &self.committish {","             out.push('#');","@@ -364,16 +399,22 @@ impl HostedGit {","     /// URL form for that protocol.","     #[must_use]","     pub fn normalized_repository_url(&self) -> Option<String> {","-        // Rendering an ownerless shortcut such as `github:skills` yields a broken URL.","-        if self.user.is_empty() {","+        if !self.names_repository() {","             return None;","         }","+        // Upstream's gist templates drop credentials; see the module docs for","+        // why `https` and `git` keep them.","+        let hosted = if self.host_type == HostedGitType::Gist {","+            &HostedGit { auth: None, ..self.clone() }","+        } else {","+            self","+        };","         let opts = HostedOpts::default();","-        match self.default_representation {","-            Representation::Shortcut | Representation::Https => self.https(opts),","+        match hosted.default_representation {","+            Representation::Shortcut | Representation::Https => hosted.https(opts),","             // Upstream has no `http` template, so `toString` falls back to `sshurl`.","-            Representation::Sshurl | Representation::Http => self.sshurl(opts),","-            Representation::Git => self.git(),","+            Representation::Sshurl | Representation::Http => hosted.sshurl(opts),","+            Representation::Git => hosted.git(),","         }","     }"," ","@@ -415,6 +456,11 @@ impl HostedGit {","                 project = self.project,","                 r#ref = encoded_committish,","             ),","+            HostedGitType::Gist => format!(","+                \"https://codeload.github.com/gist/{project}/tar.gz/{ref}\",","+                project = self.project,","+                r#ref = encoded_committish,","+            ),","         })","     }"," }"],"additions":76,"deletions":30,"truncated":false},{"path":"pnpm/crates/resolving-git-resolver/src/hosted_git/tests.rs","lines":["@@ -297,6 +297,11 @@ fn normalized_repository_url_matches_npm_pkg_fix() {","         (\"bitbucket:foo/bar\", \"git+https://bitbucket.org/foo/bar.git\"),","         (\"github:pnpm/example#v1\", \"git+https://github.com/pnpm/example.git#v1\"),","         (\"github:pnpm/example#semver:^1\", \"git+https://github.com/pnpm/example.git#semver:^1\"),","+        (\"gist:abc123\", \"git+https://gist.github.com/abc123.git\"),","+        (\"gist:abc123#deadbeef\", \"git+https://gist.github.com/abc123.git#deadbeef\"),","+        (\"https://gist.github.com/foo/abc123\", \"git+https://gist.github.com/abc123.git\"),","+        (\"git+ssh://git@gist.github.com/abc123.git\", \"git+ssh://git@gist.github.com/abc123.git\"),","+        (\"git://gist.github.com/abc123.git\", \"git://gist.github.com/abc123.git\"),","     ] {","         let hosted = HostedGit::from_url(url).expect(\"recognised\");","         assert_eq!(hosted.normalized_repository_url().as_deref(), Some(expected), \"url: {url}\");","@@ -304,11 +309,84 @@ fn normalized_repository_url_matches_npm_pkg_fix() {"," }"," "," /// `npm pkg fix` leaves these URLs as they are because hosted-git-info does","-/// not recognise them. `gist:` is the exception: npm recognises it, but the","-/// `gist` host is not implemented here.","+/// not recognise them."," #[test]"," fn from_url_rejects_repository_urls_npm_leaves_unchanged() {","-    for url in [\"git://gitlab.com/foo/bar.git\", \"https://example.com/repo.git\", \"gist:abc123\"] {","+    for url in [","+        \"git://gitlab.com/foo/bar.git\",","+        \"https://example.com/repo.git\",","+        \"http://gist.github.com/abc123\",","+        \"https://gist.github.com/foo/abc123/raw/file.js\",","+        \"https://gist.github.com/abc123/raw/file.js\",","+        \"https://gist.github.com/abc123/raw\",","+        \"https://gist.github.com/\",","+    ] {","         assert_eq!(HostedGit::from_url(url), None, \"url: {url}\");","     }"," }","+","+#[test]","+fn gist_shortcut() {","+    let hosted = HostedGit::from_url(\"gist:abc123#deadbeef\").expect(\"recognised\");","+    assert_eq!(hosted.host_type, HostedGitType::Gist);","+    assert_eq!(hosted.user, \"\");","+    assert_eq!(hosted.project, \"abc123\");","+    assert_eq!(hosted.committish.as_deref(), Some(\"deadbeef\"));","+    assert!(hosted.names_repository());","+}","+","+#[test]","+fn gist_url_with_and_without_owner() {","+    for url in [\"https://gist.github.com/abc123\", \"https://gist.github.com/foo/abc123.git\"] {","+        let hosted = HostedGit::from_url(url).expect(\"recognised\");","+        assert_eq!(hosted.host_type, HostedGitType::Gist, \"url: {url}\");","+        assert_eq!(hosted.project, \"abc123\", \"url: {url}\");","+    }","+    assert_eq!(HostedGit::from_url(\"https://gist.github.com/foo/abc123\").unwrap().user, \"foo\");","+}","+","+/// Every gist form omits the owner, as upstream's gist templates do.","+#[test]","+fn gist_url_forms_omit_the_owner() {","+    let hosted = HostedGit::from_url(\"https://gist.github.com/foo/abc123#deadbeef\").unwrap();","+    let opts = HostedOpts::default();","+    assert_eq!(hosted.shortcut(opts), \"gist:abc123#deadbeef\");","+    assert_eq!(hosted.https(opts).unwrap(), \"git+https://gist.github.com/abc123.git#deadbeef\");","+    assert_eq!(hosted.ssh(opts).unwrap(), \"git@gist.github.com:abc123.git#deadbeef\");","+    assert_eq!(hosted.sshurl(opts).unwrap(), \"git+ssh://git@gist.github.com/abc123.git#deadbeef\");","+    assert_eq!(","+        hosted.tarball(opts).unwrap(),","+        \"https://codeload.github.com/gist/abc123/tar.gz/deadbeef\",","+    );","+    assert_eq!(hosted.synthesized_package_name(), \"abc123\");","+}","+","+#[test]","+fn gist_package_docs_url() {","+    assert_eq!(","+        HostedGit::package_docs_url(\"gist:abc123\").as_deref(),","+        Some(\"https://gist.github.com/abc123\"),","+    );","+    assert_eq!(","+        HostedGit::package_docs_url(\"https://gist.github.com/foo/abc123#deadbeef\").as_deref(),","+        Some(\"https://gist.github.com/abc123/deadbeef\"),","+    );","+}","+","+/// The gist forms keep URL-embedded credentials so `git ls-remote` can","+/// still reach a private gist. The `repository` field `npm pkg fix` writes","+/// drops them, as upstream's gist templates do.","+#[test]","+fn gist_https_keeps_credentials() {","+    let hosted = HostedGit::from_url(\"https://user:token@gist.github.com/abc123.git\").unwrap();","+    assert_eq!(","+        hosted","+            .https(HostedOpts::default())","+            .unwrap(),","+        \"git+https://user:token@gist.github.com/abc123.git\",","+    );","+    assert_eq!(","+        hosted.normalized_repository_url().unwrap(),","+        \"git+https://gist.github.com/abc123.git\",","+    );","+}"],"additions":81,"deletions":3,"truncated":false},{"path":"pnpm/crates/resolving-git-resolver/src/hosted_git/url_parse.rs","lines":["@@ -66,8 +66,8 @@ pub(super) fn whatwg_parse(giturl: &str) -> Option<ParsedUrl> {"," /// for inputs that already use a known scheme, return as-is; for"," /// `user@host:path` SCP-style strings, prepend `git+ssh://`; otherwise,"," /// insert the missing `//` after the first colon. Pacquet mirrors the","-/// `knownProtocols` set (`github:`, `gitlab:`, `bitbucket:`, `http:`,","-/// `https:`, `git:`, `git+ssh:`, `git+https:`, `ssh:`).","+/// `knownProtocols` set (`github:`, `gitlab:`, `bitbucket:`, `gist:`,","+/// `http:`, `https:`, `git:`, `git+ssh:`, `git+https:`, `ssh:`)."," pub(super) fn correct_protocol(input: &str) -> String {","     let Some(first_colon) = input.find(':') else {","         return input.to_string();","@@ -77,6 +77,7 @@ pub(super) fn correct_protocol(input: &str) -> String {","         \"github:\",","         \"gitlab:\",","         \"bitbucket:\",","+        \"gist:\",","         \"http:\",","         \"https:\",","         \"git:\",","@@ -237,9 +238,34 @@ pub(super) fn extract_for_host(host: HostedGitType, parsed: &ParsedUrl) -> Optio","         HostedGitType::Github => extract_github(parsed),","         HostedGitType::Bitbucket => extract_bitbucket(parsed),","         HostedGitType::Gitlab => extract_gitlab(parsed),","+        HostedGitType::Gist => extract_gist(parsed),","     }"," }"," ","+/// Port of `gitHosts.gist.extract`: `/<user>/<id>` or `/<id>`, but not a","+/// `/<user>/<id>/raw/…` or `/<id>/raw/…` file URL.","+pub(super) fn extract_gist(parsed: &ParsedUrl) -> Option<Segments> {","+    let mut parts = parsed.pathname.split('/').skip(1);","+    let first = parts.next().unwrap_or_default();","+    let second = parts.next().unwrap_or_default();","+    if second == \"raw\" || parts.next() == Some(\"raw\") {","+        return None;","+    }","+    let (user, project) = match (first, second) {","+        (\"\", \"\") => return None,","+        (id, \"\") => (\"\", id),","+        (user, id) => (user, id),","+    };","+    let committish = parsed.hash","+        .as_deref()","+        .map(|hash| {","+            hash.strip_prefix('#')","+                .unwrap_or(hash)","+                .to_string()","+        });","+    Some(Segments { user: user.to_string(), project: strip_dot_git(project), committish })","+}","+"," /// Port of `gitHosts.github.extract`."," pub(super) fn extract_github(parsed: &ParsedUrl) -> Option<Segments> {","     let path = parsed.pathname.trim_start_matches('/');"],"additions":28,"deletions":2,"truncated":false},{"path":"pnpm/crates/resolving-git-resolver/src/parse_bare_specifier/tests.rs","lines":["@@ -90,6 +90,18 @@ fn finalize_hosted_uses_canonical_https() {","     assert!(spec.hosted.is_some());"," }"," ","+#[test]","+fn finalize_gist_uses_canonical_https() {","+    for bare in","+        [\"gist:abc123\", \"https://gist.github.com/foo/abc123\", \"git@gist.github.com:abc123.git\"]","+    {","+        let spec = parse_bare_specifier(bare).expect(\"hosted\").finalize();","+        assert_eq!(spec.fetch_spec, \"https://gist.github.com/abc123.git\", \"bare: {bare}\");","+        assert_eq!(spec.normalized_bare_specifier, \"gist:abc123\", \"bare: {bare}\");","+        assert!(spec.hosted.is_some(), \"bare: {bare}\");","+    }","+}","+"," #[test]"," fn finalize_hosted_ssh_input_becomes_the_same_https_identity() {","     let kind = parse_bare_specifier(\"git+ssh://git@github.com/foo/bar.git\").expect(\"hosted\");"],"additions":12,"deletions":0,"truncated":false},{"path":"pnpm/docs/package-sources.md","lines":["@@ -212,6 +212,7 @@ You can use a protocol shorthand `[provider]:` for certain Git providers:"," pnpm add github:zkochan/is-negative"," pnpm add bitbucket:pnpmjs/git-resolver"," pnpm add gitlab:pnpm/git-resolver","+pnpm add gist:106cfef49f8476b753a9cbbf9c65aff1"," ```"," "," If `[provider]:` is omitted, it defaults to `github:`.","@@ -230,7 +231,7 @@ Installs from the `beta` branch and only the subdirectory at `/packages/simple-r"," "," Added in: v12.0.0 (pnpm v12 only)"," ","-For repositories on GitHub, GitLab, and Bitbucket, the specifier is an **identity**, not a choice of transport. All of the following name the same dependency and resolve identically:","+For repositories on GitHub, GitLab, Bitbucket, and GitHub Gist, the specifier is an **identity**, not a choice of transport. All of the following name the same dependency and resolve identically:"," "," ```text"," kevva/is-positive"],"additions":2,"deletions":1,"truncated":false},{"path":"pnpm11/deps/compliance/sbom/src/getPkgMetadata.ts","lines":["@@ -106,10 +106,8 @@ export function repositoryFromField (field: unknown): string | undefined {","   const absolute = absoluteUrl(raw)","   if (absolute) return absolute","   const hosted = HostedGit.fromUrl(raw)","-  // An ownerless shorthand derives a URL naming `null` as the owner.","-  // `gist:<id>` is ownerless too and pnpm v12's parser has no gist support, so","-  // dropping it here is what keeps the two versions in step.","-  if (!hosted?.user) return undefined","+  // An ownerless shorthand derives a URL naming `null` as the owner. A gist needs no owner.","+  if (hosted == null || (!hosted.user && hosted.type !== 'gist')) return undefined","   const expanded = hosted.https()","   return expanded ? urlWithoutCredentials(expanded)?.href : undefined"," }"],"additions":2,"deletions":4,"truncated":false},{"path":"pnpm11/deps/compliance/sbom/test/getPkgMetadata.test.ts","lines":["@@ -229,9 +229,8 @@ describe('repositoryFromField', () => {","     expect(repositoryFromField('https://github.com/foo/bar/baz@qux')).toBe('https://github.com/foo/bar/baz@qux')","   })"," ","-  // Expanding the shorthand in one pnpm version alone would split the two.","-  it('keeps a gist URL and drops the gist shorthand', () => {","-    expect(repositoryFromField('gist:11081aaa281')).toBeUndefined()","+  it('expands the gist shorthand and keeps a gist URL', () => {","+    expect(repositoryFromField('gist:11081aaa281')).toBe('git+https://gist.github.com/11081aaa281.git')","     expect(repositoryFromField('https://gist.github.com/11081aaa281')).toBe('https://gist.github.com/11081aaa281')","   })"," "],"a