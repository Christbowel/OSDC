{"id":"9bb8f52b67fa801841f1072084d8812a1573807d","axis":"silent","repo":"pnpm/pnpm","sha":"9bb8f52b67fa801841f1072084d8812a1573807d","parsed":{"files":[{"path":".changeset/gist-dependencies.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm add` and `pnpm install` now accept `gist:<id>` dependencies and GitHub Gist URLs, and install them from the gist's archive. `pnpm pkg fix` now normalizes a `gist:` repository the way `npm pkg fix` does, and `pnpm licenses` links a gist package to its gist page."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/gist-same-source.md","lines":["@@ -0,0 +1,6 @@","+---","+\"@pnpm/installing.deps-installer\": patch","+\"pnpm\": patch","+---","+","+`pnpm add` no longer warns that a gist dependency was replaced from a different source when the new specifier names the same gist in another form, such as `gist:<id>` and `https://gist.github.com/<user>/<id>`."],"additions":6,"deletions":0,"truncated":false},{"path":".changeset/sbom-gist-repository.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/deps.compliance.sbom\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+`pnpm sbom` now reports the repository of a package whose `repository` field is a `gist:` shorthand."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/src/cli_args/pkg/tests.rs","lines":["@@ -205,13 +205,11 @@ fn test_fix_converts_repository_string_to_object() {","     }"," }"," ","-/// `npm pkg fix` writes `git+https://gist.github.com/abc123.git` here. The","-/// gist host is not recognised, so the url stays as it is."," #[test]","-fn test_fix_keeps_gist_repository_url() {","+fn test_fix_normalizes_gist_repository_url() {","     assert_eq!(","         fix_repository(json!(\"gist:abc123\")),","-        json!({ \"type\": \"git\", \"url\": \"gist:abc123\" }),","+        json!({ \"type\": \"git\", \"url\": \"git+https://gist.github.com/abc123.git\" }),","     );"," }"," "],"additions":2,"deletions":4,"