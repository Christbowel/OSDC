// Register an IClientFactory for Blazor Server Apps using ASP.NET Core claims-based Authentication,","+    /// e.g. ASP.NET Core Identity, OIDC or Microsoft Entra ID. In Process Gateway requests use the ServiceStack","+    /// Session converted from the circuit's AuthenticationStateProvider User, never the HttpContext.","+    /// </summary>","+    public static IHttpClientBuilder AddBlazorServerClaimsApiClient(this IServiceCollection services, string baseUrl, Action<BlazorServerApiClientConfig>? configure = null)","+    {","+        var config = new BlazorServerApiClientConfig();","+        configure?.Invoke(config);","+        return services.AddBlazorServerClaimsApiClient(baseUrl, config);","+    }","+","+    public static IHttpClientBuilder AddBlazorServerClaimsApiClient(this IServiceCollection services, string baseUrl, BlazorServerApiClientConfig config)","+    {","+        return services","+            .AddScoped<IClientFactory>(c => new BlazorServerClaimsClientFactory(","+                c.GetRequiredService<JsonApiClient>(), baseUrl, c, config) {","+                AuthenticationStateProvider = c.GetService<AuthenticationStateProvider>(),","+                RequestFactory = c.GetService<IGatewayRequestFactory>(),","+            })","+            .AddHttpClient<JsonApiClient>(client => {","+                client.BaseAddress = new Uri(baseUrl);","+                config.HttpClientFilter?.Invoke(client);","+            })","+            .ConfigurePrimaryHttpMessageHandler(() => {","+                var to = HttpUtils.HttpClientHandlerFactory();","+                to.DefaultProxyCredentials = CredentialCache.DefaultCredentials;","+                config.HttpClientHandlerFilter?.Invoke(to);","+                return to;","+            });","+    }","+","     public static JsonApiClient ConfigureClient(this HostState hostState, JsonApiClient Client)","     {","         Client.ClearHeaders();","@@ -145,6 +177,150 @@ public IServiceGateway GetGateway()","     }"," }"," ","+public class BlazorServerApiClientConfig","+{","+    public Action<HttpClient>? HttpClientFilter { get; set; }","+    public Action<HttpClientHandler>? HttpClientHandlerFilter { get; set; }","+","+    /// <summary>","+    /// Custom conversion of an authenticated ClaimsPrincipal into a ServiceStack Session.","+    /// Defaults to the registered IClaimsPrincipalSessionConverter Auth Provider, e.g. NetCoreIdentityAuthProvider or IdentityAuth","+    /// </summary>","+    public Func<IRequest, ClaimsPrincipal, Task<IAuthSession>>? ConvertPrincipalToSessionAsync { get; set; }","+","+    /// <summary>","+    /// Resolve dependencies of In Process Gateway calls from the circuit's DI scope instead of creating","+    /// a new DI scope for each call. Scoped services like DbContext are then shared by concurrent calls in the circuit.","+    /// </summary>","+    public bool UseCircuitServiceScope { get; set; }","+","+    /// <summary>","+    /// Customize each In Process Gateway request","+    /// </summary>","+    public Action<IRequest>? GatewayRequestFilter { get; set; }","+}","+","+/// <summary>","+/// Blazor Server IClientFactory that populates In Process Gateway requests with the ServiceStack Session converted","+/// from the User of the circuit's AuthenticationStateProvider","+/// </summary>","+public class BlazorServerClaimsClientFactory : IClientFactory","+{","+    static readonly ILog Log = LogManager.GetLogger(typeof(BlazorServerClaimsClientFactory));","+","+    public JsonApiClient Client { get; }","+    public string BaseUrl { get; }","+    public IServiceProvider Services { get; }","+    public BlazorServerApiClientConfig Config { get; }","+    public AuthenticationStateProvider? AuthenticationStateProvider { get; set; }","+    public IGatewayRequestFactory? RequestFactory { get; set; }","+","+    private readonly object cacheLock = new();","+    private AuthenticationState? lastState;","+    private IAuthSession? lastSession;","+","+    public BlazorServerClaimsClientFactory(JsonApiClient client, string baseUrl, IServiceProvider services, BlazorServerApiClientConfig? config = null)","+    {","+        Client = client;","+        BaseUrl = baseUrl;","+        Services = services;","+        Config = config ?? new();","+    }","+","+    public JsonApiClient GetClient() => Client;","+","+    public IServiceGateway GetGateway() => new InProcessServiceGateway(CreateGatewayRequest());","+","+    public virtual IRequest CreateGatewayRequest()","+    {","+        var state = GetAuthenticationState();","+        var user = state?.User ?? new ClaimsPrincipal(new ClaimsIdentity());","+        var basicRequest = new BasicHttpRequest","+        {","+            AbsoluteUri = BaseUrl,","+            RawUrl = BaseUrl,","+            PathInfo = \"/\",","+            User = user, // GatewayRequest.Clone() copies the User from its OriginalRequest","+        };","+        var request = RequestFactory?.Create(basicRequest) ?? GatewayRequest.Create(basicRequest);","+        if (request is BasicRequest basicReq)","+            basicReq.User = user;","+        request.SetItem(Keywords.Session, GetSession(request, state, user));","+        if (Config.UseCircuitServiceScope && request is IHasServiceScope hasScope)","+            hasScope.ServiceScope = new CircuitServiceScope(Services);","+        Config.GatewayRequestFilter?.Invoke(request);","+        return request;","+    }","+","+    public virtual AuthenticationState? GetAuthenticationState()","+    {","+        if (AuthenticationStateProvider == null)","+            return null;","+        try","+        {","+            var task = AuthenticationStateProvider.GetAuthenticationStateAsync();","+            // Completed for Blazor Server's ServerAuthenticationStateProvider once the circuit is initialized","+            return task.IsCompletedSuccessfully ? task.Result : task.GetAwaiter().GetResult();","+        }","+        catch (InvalidOperationException ex) // Authentication state