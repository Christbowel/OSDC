ut\",","+\t\t\tNamespace: \"default\",","+\t\t},","+\t\tSpec: LLMInferenceServiceSpec{","+\t\t\tModel: LLMModelSpec{","+\t\t\t\tURI: apis.URL{Scheme: \"hf\", Host: \"meta-llama/Llama-4-Scout-17B-16E-Instruct\"},","+\t\t\t},","+\t\t\tWorkloadSpec: WorkloadSpec{","+\t\t\t\tReplicas: ptr.To[int32](2),","+\t\t\t\tRolloutStrategy: &RolloutStrategy{","+\t\t\t\t\tMaxUnavailable: &maxUnavail,","+\t\t\t\t\tMaxSurge:       &maxSurge,","+\t\t\t\t},","+\t\t\t},","+\t\t\tPrefill: &WorkloadSpec{","+\t\t\t\tReplicas: ptr.To[int32](2),","+\t\t\t\tRolloutStrategy: &RolloutStrategy{","+\t\t\t\t\tMaxUnavailable: &maxUnavail,","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t}","+","+\t// v1alpha1 -> v1alpha2","+\thub := &v1alpha2.LLMInferenceService{}","+\terr := src.ConvertTo(hub)","+\trequire.NoError(t, err)","+","+\trequire.NotNil(t, hub.Spec.RolloutStrategy)","+\tassert.Equal(t, intstr.FromInt32(1), *hub.Spec.RolloutStrategy.MaxUnavailable)","+\tassert.Equal(t, intstr.FromString(\"50%\"), *hub.Spec.RolloutStrategy.MaxSurge)","+","+\trequire.NotNil(t, hub.Spec.Prefill)","+\trequire.NotNil(t, hub.Spec.Prefill.RolloutStrategy)","+\tassert.Equal(t, intstr.FromInt32(1), *hub.Spec.Prefill.RolloutStrategy.MaxUnavailable)","+\tassert.Nil(t, hub.Spec.Prefill.RolloutStrategy.MaxSurge)","+","+\t// v1alpha2 -> v1alpha1","+\trestored := &LLMInferenceService{}","+\terr = restored.ConvertFrom(hub)","+\trequire.NoError(t, err)","+","+\trequire.NotNil(t, restored.Spec.RolloutStrategy)","+\tassert.Equal(t, intstr.FromInt32(1), *restored.Spec.RolloutStrategy.MaxUnavailable)","+\tassert.Equal(t, intstr.FromString(\"50%\"), *restored.Spec.RolloutStrategy.MaxSurge)","+","+\trequire.NotNil(t, restored.Spec.Prefill)","+\trequire.NotNil(t, restored.Spec.Prefill.RolloutStrategy)","+\tassert.Equal(t, intstr.FromInt32(1), *restored.Spec.Prefill.RolloutStrategy.MaxUnavailable)","+\tassert.Nil(t, restored.Spec.Prefill.RolloutStrategy.MaxSurge)","+}","+","+func TestLLMInferenceServiceConversion_NilRolloutStrategy(t *testing.T) {","+\tsrc := &LLMInferenceService{","+\t\tObjectMeta: metav1.ObjectMeta{","+\t\t\tName:      \"test-llm-no-rollout\",","+\t\t\tNamespace: \"default\",","+\t\t},","+\t\tSpec: LLMInferenceServiceSpec{","+\t\t\tModel: LLMModelSpec{","+\t\t\t\tURI: apis.URL{Scheme: \"hf\", Host: \"meta-llama/Llama-4-Scout-17B-16E-Instruct\"},","+\t\t\t},","+\t\t},","+\t}","+","+\thub := &v1alpha2.LLMInferenceService{}","+\terr := src.ConvertTo(hub)","+\trequire.NoError(t, err)","+\tassert.Nil(t, hub.Spec.RolloutStrategy)","+","+\trestored := &LLMInferenceService{}","+\terr = restored.ConvertFrom(hub)","+\trequire.NoError(t, err)","+\tassert.Nil(t, restored.Spec.RolloutStrategy)","+}"],"additions":83,"deletions":0,"truncated":false},{"path":"pkg/apis/serving/v1alpha1/llm_inference_service_types.go","lines":["@@ -22,6 +22,7 @@ import ("," \tcorev1 \"k8s.io/api/core/v1\""," \tmetav1 \"k8s.io/apimachinery/pkg/apis/meta/v1\""," \t\"k8s.io/apimachinery/pkg/runtime\"","+\t\"k8s.io/apimachinery/pkg/util/intstr\""," \t\"knative.dev/pkg/apis\""," \tduckv1 \"knative.dev/pkg/apis/duck/v1\""," \tgwapiv1 \"sigs.k8s.io/gateway-api/apis/v1\"","@@ -169,6 +170,26 @@ type WorkloadSpec struct {"," \t// The controller is responsible for enabling discovery between head and worker pods."," \t// +optional"," \tWorker *corev1.PodSpec `json:\"worker,omitempty\"`","+","+\t// RolloutStrategy configures how rolling updates are performed for this workload.","+\t// When omitted, Kubernetes/LWS defaults apply.","+\t// +optional","+\tRolloutStrategy *RolloutStrategy `json:\"rolloutStrategy,omitempty\"`","+}","+","+// RolloutStrategy configures the rolling update behavior for a workload."],"additions":9,"deletions":0,"truncated":false}],"additions":522,"deletions":0,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-08-08T08:33:12.392855+00:00"}