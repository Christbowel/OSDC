ts.mu.Lock()","+\tif s.tasks == nil {","+\t\ts.mu.Unlock()","+\t\treturn","+\t}","+\tid := s.nextID","+\ts.nextID++","+\ts.tasks[id] = task","+\ts.active++","+\ts.mu.Unlock()","+","+\t// A native commit can release its last reference to the Envoy object and re-enter","+\t// Close. Keep the native scheduler alive until every in-flight commit returns.","+\tdefer func() {","+\t\ts.mu.Lock()","+\t\ts.active--","+\t\tdestroy := s.closed && s.active == 0","+\t\ts.mu.Unlock()","+\t\tif destroy {","+\t\t\ts.destroy()","+\t\t}","+\t}()","+\ts.commit(id)","+}","+","+// Run dispatches a posted task on the main thread. The task may itself schedule more work.","+func (s *Scheduler) Run(id uint64) {","+\ts.mu.Lock()","+\ttask := s.tasks[id]","+\tdelete(s.tasks, id)","+\ts.mu.Unlock()","+\tif task != nil {","+\t\ttask()","+\t}","+}","+","+// Close discards pending tasks and releases the native scheduler after its last commit.","+func (s *Scheduler) Close() {","+\ts.mu.Lock()","+\tdestroy := !s.closed && s.active == 0 && s.destroy != nil","+\ts.closed = true","+\ts.tasks = nil","+\ts.mu.Unlock()","+\tif destroy {","+\t\ts.destroy()","+\t}","+}"],"additions":75,"deletions":0,"truncated":false},{"path":"source/extensions/dynamic_modules/sdk/go/internal/scheduler/scheduler_test.go","lines":["@@ -0,0 +1,117 @@","+package scheduler","+","+import (","+\t\"sync\"","+\t\"testing\"","+\t\"time\"","+)","+","+func waitFor(t *testing.T, event <-chan struct{}, description string) {","+\tt.Helper()","+\tselect {","+\tcase <-event:","+\tcase <-time.After(10 * time.Second):","+\t\tt.Fatalf(\"timed out waiting for %s\", description)","+\t}","+}","+","+func TestCloseDuringCommits(t *testing.T) {","+\tvar s Scheduler","+\tvar deletes int","+\tfirstCommit := make(chan struct{})","+\trelease := make(chan struct{}, 1)","+\tdefer close(release)","+\ts.Init(func() (func(uint64), func()) {","+\t\tcommit := func(id uint64) {","+\t\t\tswitch id {","+\t\t\tcase 0:","+\t\t\t\tclose(firstCommit)","+\t\t\t\t<-release","+\t\t\tcase 1:","+\t\t\t\t// The last native owner releases its reference inside this commit.","+\t\t\t\ts.Close()","+\t\t\tdefault:","+\t\t\t\tt.Errorf(\"unexpected commit %d\", id)","+\t\t\t}","+\t\t}","+\t\treturn commit, func() { deletes++ }","+\t})","+","+\tdiscarded := func() { t.Error(\"ran a task after close\") }","+\tfirstDone := make(chan struct{})","+\tgo func() {","+\t\ts.Schedule(discarded)","+\t\tclose(firstDone)","+\t}()","+\twaitFor(t, firstCommit, \"the first commit to enter the host\")","+\tsecondDone := make(chan struct{})","+\tgo func() {","+\t\ts.Schedule(discarded)","+\t\tclose(secondDone)","+\t}()","+\twaitFor(t, secondDone, \"the reentrant close to return\")","+\tif deletes != 0 {","+\t\tt.Error(\"deleted the scheduler while the first commit was active\")","+\t}","+\ts.Schedule(discarded)","+\ts.Run(0)","+\ts.Run(1)","+\trelease <- struct{}{}","+\twaitFor(t, firstDone, \"the first commit to finish\")","+\ts.Close()","+\tif deletes != 1 {","+\t\tt.Fatalf(\"delete called %d times, want 1\", deletes)","+\t}","+}","+","+func TestConcurrentInitAndDispatch(t *testing.T) {","+\tvar s Scheduler","+\tconst count = 10","+\tposted := make(chan uint64, count)","+\tvar ran [count]int","+\tcreates, deletes := 0, 0","+\tvar wg sync.WaitGroup","+\tfor i := range count {","+\t\twg.Go(func() {","+\t\t\ts.Init(func() (func(uint64), func()) {","+\t\t\t\tcreates++","+\t\t\t\treturn func(id uint64) { posted <- id }, func() { deletes++ }","+\t\t\t})","+\t\t\ts.Schedule(func() { ran[i]++ })","+\t\t})","+\t}","+\twg.Wait()","+\tif got := len(posted); got != count {","+\t\tt.Fatalf(\"committed %d tasks, want %d\", got, count)","+\t}","+\tfor range count {","+\t\tid := <-posted","+\t\ts.Run(id)","+\t\ts.Run(id)","+\t}","+\tfor i := range ran {","+\t\tif ran[i] != 1 {","+\t\t\tt.Errorf(\"task %d ran %d times, want 1\", i, ran[i])","+\t\t}","+\t}","+\t// The scheduler lock must be released before the task runs.","+\ts.Schedule(s.Close)","+\tdone := make(chan struct{})","+\tgo func() {","+\t\ts.Run(<-posted)","+\t\tclose(done)","+\t}()","+\twaitFor(t, done, \"the task to close its scheduler\")","+\tif creates != 1 || deletes != 1 {","+\t\tt.Errorf(\"create and delete called %d and %d times, want 1 each\", creates, deletes)","+\t}","+}","+","+func TestCloseBeforeInit(t *testing.T) {"],"additions":110,"deletions":0,"truncated":false}],"additions":745,"deletions":0,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-11-24T20:29:53.927090+00:00"}