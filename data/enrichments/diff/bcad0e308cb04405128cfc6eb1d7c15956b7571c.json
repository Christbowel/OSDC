xtension_config_module_ptr) {","+\tdefer recovery.Export(\"envoy_dynamic_module_on_bootstrap_extension_config_new\", nil, &result)","+\thandle := &dymBootstrapConfigHandle{host: host}","+\tretained := false","+\tdefer func() {","+\t\tif !retained {","+\t\t\thandle.scheduler.Close()","+\t\t}","+\t}()","+\tnameString := envoyBufferToStringUnsafe(name)","+\textensionConfig, err := sdk.NewBootstrapExtensionConfig(handle, nameString, envoyBufferToBytesUnsafe(config))","+\tif err != nil {","+\t\thandle.Log(shared.LogLevelWarn, \"Failed to load bootstrap configuration for %q: %v\", nameString, err)","+\t\treturn nil","+\t}","+\tif extensionConfig == nil {","+\t\thandle.Log(shared.LogLevelWarn, \"Failed to load bootstrap configuration for %q: config is nil\", nameString)","+\t\treturn nil","+\t}","+\tresult = C.envoy_dynamic_module_type_bootstrap_extension_config_module_ptr(","+\t\tnewHandle(&bootstrapConfigWrapper{config: extensionConfig, handle: handle}))","+\tretained = true","+\treturn result","+}","+","+//export envoy_dynamic_module_on_bootstrap_extension_config_destroy","+func envoy_dynamic_module_on_bootstrap_extension_config_destroy(ptr C.envoy_dynamic_module_type_bootstrap_extension_config_module_ptr) {","+\tdefer recovery.ExportVoid(\"envoy_dynamic_module_on_bootstrap_extension_config_destroy\")","+\tbox := unsafe.Pointer(ptr)","+\twrapper := handleValue[*bootstrapConfigWrapper](box)","+\tdefer deleteHandle(box)","+\tdefer wrapper.handle.scheduler.Close()","+\twrapper.config.OnDestroy()","+}","+","+//export envoy_dynamic_module_on_bootstrap_extension_new","+func envoy_dynamic_module_on_bootstrap_extension_new(","+\tptr C.envoy_dynamic_module_type_bootstrap_extension_config_module_ptr,","+\t_ C.envoy_dynamic_module_type_bootstrap_extension_envoy_ptr,","+) (result C.envoy_dynamic_module_type_bootstrap_extension_module_ptr) {","+\tdefer recovery.Export(\"envoy_dynamic_module_on_bootstrap_extension_new\", nil, &result)","+\twrapper := handleValue[*bootstrapConfigWrapper](unsafe.Pointer(ptr))","+\textension := wrapper.config.Create(dymBootstrapExtensionHandle{})","+\tif extension == nil {","+\t\treturn nil","+\t}","+\treturn C.envoy_dynamic_module_type_bootstrap_extension_module_ptr(newHandle(extension))","+}","+","+//export envoy_dynamic_module_on_bootstrap_extension_destroy","+func envoy_dynamic_module_on_bootstrap_extension_destroy(ptr C.envoy_dynamic_module_type_bootstrap_extension_module_ptr) {","+\tdefer recovery.ExportVoid(\"envoy_dynamic_module_on_bootstrap_extension_destroy\")","+\tbox := unsafe.Pointer(ptr)","+\tdefer deleteHandle(box)","+\thandleValue[shared.BootstrapExtension](box).OnDestroy()","+}","+","+//export envoy_dynamic_module_on_bootstrap_extension_server_initialized","+func envoy_dynamic_module_on_bootstrap_extension_server_initialized(","+\t_ C.envoy_dynamic_module_type_bootstrap_extension_envoy_ptr,","+\tptr C.envoy_dynamic_module_type_bootstrap_extension_module_ptr,","+) {","+\tdefer recovery.ExportVoid(\"envoy_dynamic_module_on_bootstrap_extension_server_initialized\")","+\thandleValue[shared.BootstrapExtension](unsafe.Pointer(ptr)).OnServerInitialized()","+}","+","+//export envoy_dynamic_module_on_bootstrap_extension_worker_thread_initialized","+func envoy_dynamic_module_on_bootstrap_extension_worker_thread_initialized(","+\t_ C.envoy_dynamic_module_type_bootstrap_extension_envoy_ptr,","+\tptr C.envoy_dynamic_module_type_bootstrap_extension_module_ptr,","+) {","+\tdefer recovery.ExportVoid(\"envoy_dynamic_module_on_bootstrap_extension_worker_thread_initialized\")","+\thandleValue[shared.BootstrapExtension](unsafe.Pointer(ptr)).OnWorkerThreadInitialized()","+}","+","+//export envoy_dynamic_module_on_bootstrap_extension_drain_started","+func envoy_dynamic_module_on_bootstrap_extension_drain_started(","+\t_ C.envoy_dynamic_module_type_bootstrap_extension_envoy_ptr,","+\tptr C.envoy_dynamic_module_type_bootstrap_extension_module_ptr,","+) {","+\tdefer recovery.ExportVoid(\"envoy_dynamic_module_on_bootstrap_extension_drain_started\")","+\thandleValue[shared.BootstrapExtension](unsafe.Pointer(ptr)).OnDrainStarted()","+}","+","+//export envoy_dynamic_module_on_bootstrap_extension_shutdown","+func envoy_dynamic_module_on_bootstrap_extension_shutdown(","+\t_ C.envoy_dynamic_module_type_bootstrap_extension_envoy_ptr,","+\tptr C.envoy_dynamic_module_type_bootstrap_extension_module_ptr,","+\tcallback C.envoy_dynamic_module_type_event_cb, context unsafe.Pointer,","+) {","+\tdefer recovery.ExportVoid(\"envoy_dynamic_module_on_bootstrap_extension_shutdown\")","+\tvar once sync.Once","+\tcomplete := func() { once.Do(func() { C.bootstrap_complete(callback, context) }) }","+\treturned := false","+\tdefer func() {","+\t\tif !returned {","+\t\t\tcomplete()","+\t\t}","+\t}()","+\thandleValue[shared.BootstrapExtension](unsafe.Pointer(ptr)).OnShutdown(complete)","+\treturned = true","+}","+","+//export envoy_dynamic_module_on_bootstrap_extension_config_scheduled","+func envoy_dynamic_module_on_bootstrap_extension_config_scheduled(","+\t_ C.envoy_dynamic_module_type_bootstrap_extension_config_envoy_ptr,","+\tptr C.envoy_dynamic_module_type_bootstrap_extension_config_module_ptr, id C.uint64_t,","+) {","+\tdefer recovery.ExportVoid(\"envoy_dynamic_module_on_bootstrap_extension_config_scheduled\")","+\twrapper := handleValue[*bootstrapConfigWrapper](unsafe.Pointer(ptr))","+\twrapper.handle.scheduler.Run(uint64(id))","+}","+","+// Envoy requires these hooks when loading a bootstrap module. The Go SDK does","+// not yet expose the corresponding optional capabilities, so none are registered.","+","+//export envoy_dynamic_module_on_bootstrap_extension_http_callout_done","+func envoy_dynamic_module_on_bootstrap_extension_http_callout_done(","+\thost C.envoy_dynamic_module_type_bootstrap_extension_config_envoy_ptr,","+\tconfig C.envoy_dynamic_module_type_bootstrap_extension_config_module_ptr,","+\tid C.uint64_t, result C.envoy_dynamic_module_type_http_callout_result,","+\theaders *C.envoy_dynamic