   continue;","+        }","+        let group = graph.chunk_group_by_ukey.expect_get(&key);","+        // Follow this runtime's groups, not every group of a shared chunk.","+        queue.extend(group.children.iter().copied());","+        let Some(last) = group.get_hmr_loading_chunk(compilation) else {","+          continue;","+        };","+        let siblings = group","+          .get_loading_chunks(compilation)","+          .filter(|chunk| chunk.ukey() != last.ukey())","+          .map(|chunk| chunk.expect_id().clone())","+          .collect::<Vec<_>>();","+        if !siblings.is_empty() {","+          groups.insert(last.expect_id().clone(), siblings);","+        }","+      }","+      Arc::new(ChunkGroupMapData(groups))","+    })","+  }","+}","+","+#[async_trait::async_trait]","+impl RuntimeModule for ChunkGroupMapRuntimeModule {","+  fn runtime_module_variables() -> &'static [&'static str] {","+    &[]","+  }","+","+  fn stage(&self) -> RuntimeModuleStage {","+    RuntimeModuleStage::Basic","+  }","+","+  fn template(&self) -> Vec<(String, String)> {","+    vec![(","+      self.id().to_string(),","+      include_str!(\"runtime/chunk_group_map.ejs\").to_string(),","+    )]","+  }","+","+  async fn generate(","+    &self,","+    context: &RuntimeModuleGenerateContext<'_>,","+  ) -> rspack_error::Result<String> {","+    let groups = &self.data(context.compilation).0;","+    context.runtime_template.render(","+      self.id(),","+      Some(serde_json::json!({","+        \"_full\": true,","+        \"_groups\": rspack_util::json_stringify(groups),","+      })),","+    )","+  }","+","+  fn get_update_data(&self, compilation: &Compilation) -> Option<Arc<dyn RuntimeModuleUpdateData>> {","+    let data = Arc::clone(self.data(compilation));","+    Some(data)","+  }","+","+  async fn generate_update(","+    &self,","+    context: &RuntimeModuleGenerateContext<'_>,","+    previous: &dyn RuntimeModuleUpdateData,","+  ) -> rspack_error::Result<Option<String>> {","+    let Some(previous) = previous.as_any().downcast_ref::<ChunkGroupMapData>() else {","+      return Ok(None);","+    };","+    let groups = &self.data(context.compilation).0;","+    let mut changes = serde_json::Map::new();","+    for (id, chunks) in groups {","+      if previous.0.get(id) != Some(chunks) {","+        changes.insert(id.to_string(), serde_json::json!(chunks));","+      }","+    }","+    for id in previous.0.keys() {","+      if !groups.contains_key(id) {","+        changes.insert(id.to_string(), serde_json::Value::Null);","+      }","+    }","+    if changes.is_empty() {","+      return Ok(Some(String::new()));","+    }","+    context","+      .runtime_template","+      .render(","+        self.id(),","+        Some(serde_json::json!({","+          \"_full\": false,","+          \"_groups\": rspack_util::json_stringify(&changes),","+        })),","+      )","+      .map(Some)","+  }","+","+  fn runtime_requirements(&self, _compilation: &Compilation) -> RuntimeModuleRuntimeRequirements {","+    RuntimeModuleRuntimeRequirements {","+      dependencies: RuntimeGlobals::REQUIRE_SCOPE | RuntimeGlobals::ENSURE_CHUNK_HANDLERS,","+      ..Default::default()","+    }","+  }","+}"],"additions":140,"deletions":0,"truncated":false},{"path":"crates/rspack_plugin_runtime/src/runtime_module/ensure_chunk.rs","lines":["@@ -71,6 +71,7 @@ impl RuntimeModule for EnsureChunkRuntimeModule {","         Some(serde_json::json!({","           \"_fetch_priority\": fetch_priority,","           \"_with_hmr\": with_hmr,","+          \"_hmr\": compilation.hot,","         })),","       )?","     } else {","@@ -85,6 +86,11 @@ impl RuntimeModule for EnsureChunkRuntimeModule {","   ) -> rspack_core::RuntimeModuleRuntimeRequirements {","     let mut dependencies = RuntimeGlobals::default();","     let mut define = RuntimeGlobals::ENSURE_CHUNK;","+    let mut force_context = RuntimeGlobals::default();","+    if compilation.hot {","+      dependencies.insert(RuntimeGlobals::REQUIRE_SCOPE);","