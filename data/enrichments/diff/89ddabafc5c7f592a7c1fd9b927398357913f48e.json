{"id":"89ddabafc5c7f592a7c1fd9b927398357913f48e","axis":"silent","repo":"envoyproxy/envoy","sha":"89ddabafc5c7f592a7c1fd9b927398357913f48e","parsed":{"files":[{"path":"changelogs/current/minor_behavior_changes/upstream__metadata-pool-serialized-bytes.rst","lines":["@@ -0,0 +1,6 @@","+EDS and static cluster hosts now share endpoint and locality metadata only when it serializes to the","+same bytes. Endpoints and localities whose","+:ref:`typed_filter_metadata <envoy_v3_api_field_config.core.v3.Metadata.typed_filter_metadata>`","+holds equal messages encoded differently, for example by a control plane that does not serialize","+map fields deterministically, no longer share one in-memory copy of that metadata, while an update","+still treats endpoint metadata as unchanged."],"additions":6,"deletions":0,"truncated":false},{"path":"envoy/upstream/host_description.h","lines":["@@ -153,7 +153,8 @@ class HostDescription {","   virtual MetadataConstSharedPtr metadata() const PURE;"," ","   /**","-   * @return the cached hash of the metadata associated with this host, or 0 if no metadata.","+   * @return the hash of the metadata associated with this host, or 0 if no metadata. The first call","+   * after the metadata is set computes the hash, and later calls return the cached value.","    */","   virtual std::size_t metadataHash() const PURE;"," "],"additions":2,"deletions":1,"truncated":false},{"path":"source/common/config/BUILD","lines":["@@ -153,6 +153,7 @@ envoy_cc_library(","         \"//envoy/registry\",","         \"//envoy/singleton:manager_interface\",","         \"//source/common/common:assert_lib\",","+        \"//source/common/common:hash_lib\",","         \"//source/common/common:thread_lib\",","         \"//source/common/protobuf\",","         \"//source/common/protobuf:utility_lib\","],"additions":1,"deletions":0,"truncated":false},{"path":"source/common/config/metadata.cc","lines":["@@ -3,6 +3,7 @@"," #include \"envoy/config/core/v3/base.pb.h\""," #include \"envoy/type/metadata/v3/metadata.pb.h\""," ","+#include \"source/common/common/hash.h\""," #include \"source/common/protobuf/utility.h\""," "," namespace Envoy {","@@ -168,14 +169,21 @@ bool Metadata::metadataLabelMatch(const LabelSet& label_set,","   return true;"," }"," ","+size_t SerializedMetadataHash::operator()(const envoy::config::core::v3::Metadata& metadata) const {","+  return HashUtil::xxHash64(MessageUtil::serializeDeterministically(metadata));","+}","+","+bool SerializedMetadataEqual::operator()(const envoy::config::core::v3::Metadata& lhs,","+                                         const envoy::config::core::v3::Metadata& rhs) const {","+  return MessageUtil::serializeDeterministically(lhs) ==","+         MessageUtil::serializeDeterministically(rhs);","+}","+"," ConstMetadataSharedPoolSharedPtr"," Metadata::getConstMetadataSharedPool(Singleton::Manager& manager, Event::Dispatcher& dispatcher) {","-  return manager.getTyped<SharedPool::ObjectSharedPool<const envoy::config::core::v3::Metadata,","-                                                       MessageUtil, MessageUtil>>(","-      SINGLETON_MANAGER_REGISTERED_NAME(const_metadata_shared_pool), [&dispatcher] {","-        return std::make_shared<SharedPool::ObjectSharedPool<","-            const envoy::config::core::v3::Metadata, MessageUtil, MessageUtil>>(dispatcher);","-      });","+  return manager.getTyped<ConstMetadataSharedPool>(","+      SINGLETON_MANAGER_REGISTERED_NAME(const_metadata_shared_pool),","+      [&dispatcher] { return std::make_shared<ConstMetadataSharedPool>(dispatcher); });"," }"," "," } // namespace Config"],"additions":14,"deletions":6,"truncated":false},{"path":"source/common/config/metadata.h","lines":["@@ -22,9 +22,22 @@"," namespace Envoy {"," namespace Config {"," ","-using ConstMetadataSharedPoolSharedPtr =","-    std::shared_ptr<SharedPool::ObjectSharedPool<const envoy::config::core::v3::Metadata,","-                                                 MessageUtil, MessageUtil>>;","+// Hashes and compares metadata by its deterministic serialization, without reflection. Some equal","+// metadata compares unequal, such as metadata whose google.protobuf.Any payloads were serialized","+// differently.","+struct SerializedMetadataHash {","+  size_t operator()(const envoy::config::core::v3::Metadata& metadata) const;","+};","+","+struct SerializedMetadataEqual {","+  bool operator()(const envoy::config::core::v3::Metadata& lhs,","+                  const envoy::config::core::v3::Metadata& rhs) const;","+};","+","+using ConstMetadataSharedPool =","+    SharedPool::ObjectSharedPool<const envoy::config::core::v3::Metadata, SerializedMetadataHash,","+                                 SerializedMetadataEqual>;","+using ConstMetadataSharedPoolSharedPtr = std::shared_ptr<ConstMetadataSharedPool>;"," "," /**","  * PathSegment represents one segment in a metadata access path."],"additions":16,"deletions":3,"truncated":false},{"path":"source/common/upstream/upstream_impl.cc","lines":["@@ -627,9 +627,8 @@ HostDescriptionImplBase::HostDescriptionImplBase(","                                               Config::MetadataFilters::get().ENVOY_LB,","                                               Config::MetadataEnvoyLbKeys::get().CANARY)","                   .bool_value()),","-      endpoint_metadata_(endpoint_metadata),","-      endpoint_metadata_hash_(endpoint_metadata ? MessageUtil::hash(*endpoint_metadata) : 0),","-      locality_metadata_(locality_metadata), locality_(std::move(locality)),","+      endpoint_metadata_(endpoint_metadata), locality_metadata_(locality_metadata),","+      locality_(std::move(locality)),","       locality_zone_stat_name_(locality_->zone(), cluster->statsScope().symbolTable()),","       priority_(priority),","       // TODO(wbpcode): This should be resolved.","@@ -2676,8 +2675,11 @@ bool BaseDynamicClusterImpl::updateDynamicHostList("," ","       hosts_changed |= updateEdsHealthFlag(*host, *existing_host);"," ","-      // Did metadata change? Compare cached hashes for O(1) comparison.","-      const bool metadata_changed = host->metadataHash() != existing_host->metadataHash();","+      // Did metadata change? Hosts built through the metadata pool share one object when their","+      // metadata serializes to the same bytes. Other hosts, such as those of DNS clusters, hold","+      // their own copies, and distinct objects can still hold equal metadata, so hashes decide.","+      const bool metadata_changed = host->metadata() != existing_host->metadata() &&","+                                    host->metadataHash() != existing_host->metadataHash();"," ","       if (metadata_changed) {","         // First, update the entire metadata for the endpoint."],"additions":7,"deletions":5,"truncated":false},{"path":"source/common/upstream/upstream_impl.h","lines":["@@ -183,7 +183,10 @@ class HostDescriptionImplBase : virtual public HostDescription,","     return endpoint_metadata_;","   }","   std::size_t metadataHash() const override {","-    absl::ReaderMutexLock lock(metadata_mutex_);","+    absl::MutexLock lock(metadata_mutex_);","+    if (endpoint_metadata_hash_ == 0 && endpoint_metadata_ != nullptr) {","+      endpoint_metadata_hash_ = MessageUtil::hash(*endpoint_metadata_);","+    }","     return endpoint_metadata_hash_;","   }","   void metadata(MetadataConstSharedPtr new_metadata) override {","@@ -191,7 +194,7 @@ class HostDescriptionImplBase : virtual public HostDescription,","     {","       absl::WriterMutexLock lock(metadata_mutex_);","       endpoint_metadata_ = new_metadata;","-      endpoint_metadata_hash_ = new_metadata ? MessageUtil::hash(*new_metadata) : 0;","+      endpoint_metadata_hash_ = 0;","       // Update data members dependent on metadata.","       socket_factory_ = new_socket_factory;","     }","@@ -300,7 +303,8 @@ class HostDescriptionImplBase : virtual public HostDescription,","   std::atomic<bool> canary_;","   mutable absl::Mutex metadata_mutex_;","   MetadataConstSharedPtr endpoint_metadata_ ABSL_GUARDED_BY(metadata_mutex_);","-  std::size_t endpoint_metadata_hash_ ABSL_GUARDED_BY(metadata_mutex_){0};","+  // Zero until metadataHash() computes it.","+  mutable std::size_t endpoint_metadata_hash_ ABSL_GUARDED_BY(metadata_mutex_){0};","   const MetadataConstSharedPtr locality_metadata_;","   const std::shared_ptr<const envoy::config::core::v3::Locality> locality_;","   Stats::StatNameDynamicStorage locality_zone_stat_name_;"],"additions":7,"deletions":3,"truncated":false},{"path":"test/common/config/BUILD","lines":["@@ -137,9 +137,12 @@ envoy_cc_test(","     srcs = [\"metadata_test.cc\"],","     deps = [","         \"//envoy/common:base_includes\",","+        \"//source/common/common:base64_lib\",","         \"//source/common/config:metadata_lib\",","         \"//source/common/config:well_known_names\",","         \"//source/common/protobuf:utility_lib\",","+        \"//source/common/singleton:manager_impl_lib\",","+        \"//test/mocks/event:event_mocks\",","         \"//test/test_common:registry_lib\",","         \"//test/test_common:utility_lib\",","         \"@envoy_api//envoy/config/core/v3:pkg_cc_proto\","],"additions":3,"deletions":0,"truncated":false},{"path":"test/common/config/metadata_test.cc","lines":["@@ -1,10 +1,13 @@"," #include \"envoy/common/exception.h\""," #include \"envoy/config/core/v3/base.pb.h\""," ","+#include \"source/common/common/base64.h\""," #include \"source/common/config/metadata.h\""," #include \"source/common/config/well_known_names.h\""," #include \"source/common/protobuf/utility.h\"","+#include \"source/common/singleton/manager_impl.h\""," ","+#include \"test/mocks/event/mocks.h\""," #include \"test/test_common/registry.h\""," #include \"test/test_common/utility.h\""," ","@@ -243,6 +246,61 @@ TEST(MetadataTest, MetadataLabelMatch) {","   }"," }"," ","+TEST(MetadataTest, ConstMetadataSharedPoolSharesMetadataWithEqualBytes) {","+  Singleton::ManagerImpl singleton_manager;","+  testing::NiceMock<Event::MockDispatcher> dispatcher;","+  ConstMetadataSharedPoolSharedPtr pool =","+      Metadata::getConstMetadataSharedPool(singleton_manager, dispatcher);","+","+  // Two maps with only a few entries can iterate in the same order by chance, which would hide a","+  // serialization that does not sort them, so this inserts many entries in opposite orders.","+  constexpr int num_entries = 16;","+  envoy::config::core::v3::Metadata metadata;","+  envoy::config::core::v3::Metadata reordered_metadata;","+  for (int i = 0; i < num_entries; ++i) {","+    const int reversed = num_entries - 1 - i;","+    Metadata::mutableMetadataValue(metadata, \"namespace\", \"key_\" + std::to_string(i))","+        .set_string_value(std::to_string(i));","+    Metadata::mutableMetadataValue(reordered_metadata, \"namespace\",","+                                   \"key_\" + std::to_string(reversed))","+        .set_string_value(std::to_string(reversed));","+  }","+  const std::shared_ptr<const envoy::config::core::v3::Metadata> shared_metadata =","+      pool->getObject(metadata);","+  EXPECT_EQ(shared_metadata, pool->getObject(reordered_metadata));","+  // In an optimized build a pool with a single entry compares without hashing, so this checks the","+  // functors directly too.","+  EXPECT_EQ(SerializedMetadataHash{}(metadata), SerializedMetadataHash{}(reordered_metadata));","+  EXPECT_TRUE(SerializedMetadataEqual{}(metadata, reordered_metadata));","+","+  // A changed value of the same size still gets its own object.","+  Metadata::mutableMetadataValue(reordered_metadata, \"namespace\", \"key_0\").set_string_value(\"9\");","+  EXPECT_NE(shared_metadata, pool->getObject(reordered_metadata));","+  EXPECT_FALSE(SerializedMetadataEqual{}(metadata, reordered_metadata));","+}","+","+TEST(MetadataTest, ConstMetadataSharedPoolKeepsReserializedAnyPayloadsApart) {","+  Singleton::ManagerImpl singleton_manager;","+  testing::NiceMock<Event::MockDispatcher> dispatcher;","+  ConstMetadataSharedPoolSharedPtr pool =","+      Metadata::getConstMetadataSharedPool(singleton_manager, dispatcher);","+","+  // The same struct with its two fields serialized in two orders.","+  envoy::config::core::v3::Metadata metadata;","+  Protobuf::Any& any = (*metadata.mutable_typed_filter_metadata())[\"custom_namespace\"];","+  any.set_type_url(\"type.googleapis.com/google.protobuf.Struct\");","+  any.set_value(Base64::decode(\"CgsKA2NkZRIEGgJpagoLCgJhYhIFGgNmZ2g=\"));","+  envoy::config::core::v3::Metadata reserialized_metadata = metadata;","+  (*reserialized_metadata.mutable_typed_filter_metadata())[\"custom_namespace\"].set_value(","+      Base64::decode(\"CgsKAmFiEgUaA2ZnaAoLCgNjZGUSBBoCaWo=\"));","+","+  const std::shared_ptr<const envoy::config::core::v3::Metadata> shared_metadata =","+      pool->getObject(metadata);","+  EXPECT_NE(shared_metadata, pool->getObject(reserialized_metadata));","+  // Host updates fall back to this hash when two hosts hold distinct objects.","+  EXPECT_EQ(MessageUtil::hash(metadata), MessageUtil::hash(reserialized_metadata));","+}","+"," class TypedMetadataTest : public testing::Test {"," public:","   TypedMetadataTest()"],"additions":58,"deletions":0,"truncated":false},{"path":"test/common/upstream/metadata_comparison_benchmark.cc","lines":["@@ -151,8 +151,9 @@ BENCHMARK(bmUpdateHostListHash)","     ->Args({5000, 20})","     ->Unit(::benchmark::kMillisecond);"," ","-// Simulate updateDynamicHostList with cached hashes (pre-computed at metadata set time).","-// This is the approach used in the actual implementation.","+// Time only the hash comparison updateDynamicHostList makes when two hosts hold distinct metadata","+// objects. This benchmark computes both hashes beforehand, while an update computes each host's","+// hash the first time that comparison needs it."," void bmUpdateHostListCachedHash(::benchmark::State& state) {","   const int num_hosts = state.range(0);","   const int num_fields = state.range(1);"],"additions":3,"deletions":2,"truncated":false},{"path":"test/common/upstream/upstream_impl_test.cc","lines":["@@ -2002,6 +2002,25 @@ TEST_F(HostImplTest, HostnameCanaryAndLocality) {","   EXPECT_EQ(1, host->priority());"," }"," ","+TEST_F(HostImplTest, MetadataHashFollowsMetadataUpdates) {","+  MockClusterMockPrioritySet cluster;","+  envoy::config::core::v3::Metadata metadata;","+  Config::Metadata::mutableMetadataValue(metadata, \"custom_namespace\", \"key\")","+      .set_string_value(\"value\");","+  HostSharedPtr host = makeTestHost(cluster.info_, \"tcp://10.0.0.1:1234\", metadata);","+  EXPECT_EQ(MessageUtil::hash(metadata), host->metadataHash());","+  // The second call returns the cached hash, which must match.","+  EXPECT_EQ(MessageUtil::hash(metadata), host->metadataHash());","+","+  Config::Metadata::mutableMetadataValue(metadata, \"custom_namespace\", \"key\")","+      .set_string_value(\"new_value\");","+  host->metadata(std::make_shared<const envoy::config::core::v3::Metadata>(metadata));","+  EXPECT_EQ(MessageUtil::hash(metadata), host->metadataHash());","+","+  host->metadata(nullptr);","+  EXPECT_EQ(0, host->metadataHash());","+}","+"," TEST_F(HostImplTest, EmptyLocalityZoneStatName) {","   MockClusterMockPrioritySet cluster;","   std::unique_ptr<HostImpl> host = *HostImpl::create("],"additions":19,"deletions":0,"truncated":false},{"path":"test/extensions/clusters/eds/BUILD","lines":["@@ -25,6 +25,7 @@ envoy_extension_cc_test(","         },","     },","     deps = [","+        \"//source/common/common:base64_lib\",","         \"//source/common/config:utility_lib\",","         \"//source/extensions/clusters/eds:eds_lib\",","         \"//source/extensions/load_balancing_policies/round_robin:config\",","@@ -61,6 +62,7 @@ envoy_extension_cc_benchmark_binary(","     rbe_pool = {\"build\": \"linux_x64_small\"},","     deps = [","         \"//envoy/config:xds_resources_delegate_interface\",","+        \"//source/common/config:metadata_lib\",","         \"//source/common/config:protobu