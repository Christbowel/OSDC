fo\");","+      Config::Metadata::mutableMetadataValue(metadata, \"istio\", \"service_account\")","+          .set_string_value(\"bookinfo-reviews\");","+    }","+","     envoy::config::endpoint::v3::ClusterLoadAssignment cluster_load_assignment;","     cluster_load_assignment.set_cluster_name(\"fare\");"," ","@@ -132,6 +151,13 @@ class EdsSpeedTest {","     uint32_t port = 1000;","     for (size_t i = 0; i < num_hosts; ++i) {","       auto* lb_endpoint = endpoints->add_lb_endpoints();","+      if (!metadata_version.empty()) {","+        *lb_endpoint->mutable_metadata() = metadata;","+        if (distinct_metadata) {","+          Config::Metadata::mutableMetadataValue(*lb_endpoint->mutable_metadata(), \"istio\", \"pod\")","+              .set_string_value(fmt::format(\"reviews-v1-{:06}\", i));","+        }","+      }","       if (healthy) {","         lb_endpoint->set_health_status(envoy::config::core::v3::HEALTHY);","       } else {","@@ -228,6 +254,42 @@ static void duplicateUpdate(State& state) {"," "," BENCHMARK(duplicateUpdate)->Ranges({{1, 100000}, {false, true}})->Unit(benchmark::kMillisecond);"," ","+static void duplicateUpdateWithEndpointMetadata(State& state) {","+  Envoy::Thread::MutexBasicLockable lock;","+  Envoy::Logger::Context logging_state(spdlog::level::warn,","+                                       Envoy::Logger::Logger::DEFAULT_LOG_FORMAT, lock, false);","+","+  for (auto _ : state) { // NOLINT: Silences warning about dead store","+    Envoy::Upstream::EdsSpeedTest speed_test(state, state.range(1));","+    uint32_t endpoints = skipExpensiveBenchmarks() ? 1 : state.range(0);","+","+    speed_test.priorityAndLocalityWeightedHelper(true, endpoints, true, \"v1.2.3\", state.range(2));","+    speed_test.priorityAndLocalityWeightedHelper(true, endpoints, true, \"v1.2.3\", state.range(2));","+  }","+}","+","+BENCHMARK(duplicateUpdateWithEndpointMetadata)","+    ->Ranges({{1, 100000}, {false, true}, {false, true}})","+    ->Unit(benchmark::kMillisecond);","+","+static void metadataOnlyUpdate(State& state) {","+  Envoy::Thread::MutexBasicLockable lock;","+  Envoy::Logger::Context logging_state(spdlog::level::warn,","+                                       Envoy::Logger::Logger::DEFAULT_LOG_FORMAT, lock, false);","+","+  for (auto _ : state) { // NOLINT: Silences warning about dead store","+    Envoy::Upstream::EdsSpeedTest speed_test(state, state.range(1));","+    uint32_t endpoints = skipExpensiveBenchmarks() ? 1 : state.range(0);","+","+    speed_test.priorityAndLocalityWeightedHelper(true, endpoints, true, \"v1.2.3\", state.range(2));","+    speed_test.priorityAndLocalityWeightedHelper(true, endpoints, true, \"v1.2.4\", state.range(2));","+  }","+}","+","+BENCHMARK(metadataOnlyUpdate)","+    ->Ranges({{1, 100000}, {false, true}, {false, true}})","+    ->Unit(benchmark::kMillisecond);","+"," static void healthOnlyUpdate(State& state) {","   Envoy::Thread::MutexBasicLockable lock;","   Envoy::Logger::Context logging_state(spdlog::level::warn,"],"additions":63,"deletions":1,"truncated":false},{"path":"test/extensions/clusters/eds/eds_test.cc","lines":["@@ -7,6 +7,7 @@"," #include \"envoy/service/discovery/v3/discovery.pb.h\""," #include \"envoy/stats/scope.h\""," ","+#include \"source/common/common/base64.h\""," #include \"source/common/config/utility.h\""," #include \"source/common/singleton/manager_impl.h\""," #include \"source/extensions/clusters/eds/eds.h\"","@@ -623,6 +624,34 @@ TEST_F(EdsTest, EndpointMetadata) {","             \"v3\");"," }"," ","+// Validate that onConfigUpdate() keeps the endpoint metadata when only the serialization of its Any","+// payload changes.","+TEST_F(EdsTest, EndpointMetadataWithReserializedAnyIsKept) {","+  envoy::config::endpoint::v3::ClusterLoadAssignment cluster_load_assignment;","+  cluster_load_assignment.set_cluster_name(\"fare\");","+  auto* endpoint = cluster_load_assignment.add_endpoints()->add_lb_endpoints();","+  endpoint->mutable_endpoint()->mutable_address()->mutable