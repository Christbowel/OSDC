rc/schema.rs","lines":["@@ -0,0 +1,293 @@","+use crate::token_store::unix_seconds;","+use pnpr_error::{RegistryError, Result};","+use rusqlite::OptionalExtension as _;","+","+/// Current version of the auth database schema.","+pub const CURRENT_SCHEMA_VERSION: i64 = 2;","+","+/// Table storing schema migrations applied to the auth database.","+pub(crate) const SCHEMA_MIGRATIONS_TABLE_SQL: &str =","+    \"CREATE TABLE IF NOT EXISTS auth_schema_migrations (","+        version     BIGINT PRIMARY KEY,","+        applied_at  BIGINT NOT NULL","+    )\";","+","+fn check_schema_version(max_version: Option<i64>) -> Result<()> {","+    if let Some(version) = max_version","+        && version > CURRENT_SCHEMA_VERSION","+    {","+        return Err(RegistryError::Internal {","+            reason: format!(","+                \"auth database schema version {version} is newer than supported version {CURRENT_SCHEMA_VERSION}; please upgrade pnpr\",","+            ),","+        });","+    }","+    Ok(())","+}","+","+/// Run schema migrations on a `SQLite` token database.","+pub(crate) fn migrate_sqlite(conn: &rusqlite::Connection) -> Result<()> {","+    conn.execute(SCHEMA_MIGRATIONS_TABLE_SQL, [])?;","+    let max_version: Option<i64> = conn","+        .query_row(\"SELECT MAX(version) FROM auth_schema_migrations\", [], |row| row.get(0))","+        .optional()?","+        .flatten();","+    check_schema_version(max_version)?;","+    let current = max_version.unwrap_or(0);","+    if current < 1 {","+        apply_sqlite_v1(conn)?;","+    }","+    if current < 2 {","+        apply_sqlite_v2(conn)?;","+    }","+    Ok(())","+}","+","+fn apply_sqlite_v1(conn: &rusqlite::Connection) -> Result<()> {","+    conn.execute(super::token_store::sqlite::TOKENS_TABLE_SQL, [])?;","+    conn.execute(super::token_store::sqlite::TOKENS_INDEX_SQL, [])?;","+    let now = unix_seconds() as i64;","+    conn.execute(","+        \"INSERT INTO auth_schema_migrations (version, applied_at) VALUES (1, ?1) ON CONFLICT (version) DO NOTHING\",","+        rusqlite::params![now],","+    )?;","+    Ok(())","+}","+","+fn apply_sqlite_v2(conn: &rusqlite::Connection) -> Result<()> {","+    add_column_if_missing_sqlite(conn, \"ALTER TABLE tokens ADD COLUMN name VARCHAR(255)\")?;","+    add_column_if_missing_sqlite(conn, \"ALTER TABLE tokens ADD COLUMN expires_at BIGINT\")?;","+    add_column_if_missing_sqlite(conn, \"ALTER TABLE tokens ADD COLUMN scopes TEXT\")?;","+    add_column_if_missing_sqlite(conn, \"ALTER TABLE tokens ADD COLUMN kind VARCHAR(64)\")?;","+    let now = unix_seconds() as i64;","+    conn.execute(","+        \"INSERT INTO auth_schema_migrations (version, applied_at) VALUES (2, ?1) ON CONFLICT (version) DO NOTHING\",","+        rusqlite::params![now],","+    )?;","+    Ok(())","+}","+","+fn add_column_if_missing_sqlite(conn: &rusqlite::Connection, sql: &str) -> Result<()> {","+    match conn.execute(sql, []) {","+        Ok(_) => Ok(()),","+        Err(err) if err.to_string().contains(\"duplicate column name\") => Ok(()),","+        Err(err) => Err(err.into()),","+    }","+}","+","+/// Run schema migrations on a `LibSQL` database.","+#[cfg(feature = \"backend-libsql\")]","+pub(crate) async fn migrate_libsql(conn: &libsql::Connection) -> Result<()> {","+    conn.execute(SCHEMA_MIGRATIONS_TABLE_SQL, ()).await?;","+    let mut rows = conn.query(\"SELECT MAX(version) FROM auth_schema_migrations\", ()).await?;","+    let max_version: Option<i64> =","+        if let Some(row) = rows.next().await? { row.get(0)? } else { None };","+    check_schema_version(max_version)?;","+    let current = max_version.unwrap_or(0);","+    if current < 1 {","+        apply_libsql_v1(conn).await?;","+    }","+    if current < 2 {","+        apply_libsql_v2(conn).await?;","+    }","+    Ok(())","+}","+","+#[cfg(feature = \"backend-libsql\")]","+async fn apply_libsql_v1(conn: &libsql::Connection) -> Result<()> {","+    conn.execute(super::USERS_TABLE_SQL, ()).await?;","+    conn.execute(super::token_store::sqlite::TOKENS_TABLE_SQL, ()).await?;","+    conn.execute(super::token_store::sqlite::TOKENS_INDEX_SQL, ()).await?;","+    conn.execute(super::AUTH_COUNTERS_TABLE_SQL, ()).await?;","+    let now = unix_seconds() as i64;","+    conn.execute(","+        \"INSERT INTO auth_schema_migrations (version, applied_at) VALUES (1, ?1) ON CONFLICT (version) DO NOTHING\",","+        libsql::params![now],","+    )","+    .await?;","+    Ok(())","+}","+","+#[cfg(feature = \"backend-libsql\")]","+async fn apply_libsql_v2(conn: &libsql::Connection) -> Result<()> {","+    add_column_if_missing_libsql(conn, \"ALTER TABLE tokens ADD COLUMN name VARCHAR(255)\").await?;","+    add_column_if_missing_libsql(conn, \"ALTER TABLE tokens ADD COLUMN expires_at BIGINT\").await?;","+    add_column_if_missing_libsql(conn, \"ALTER TABLE tokens ADD COLUMN scopes TEXT\").await?;","+    add_column_if_missing_libsql(conn, \"ALTER TABLE tokens ADD COLUMN kind VARCHAR(64)\").await?;","+    let now = unix_seconds() as i64;","+    conn.execute(","+        \"INSERT INTO auth_schema_migrations (version, applied_at) VALUES (2, ?1) ON CONFLICT (version) DO NOTHING\",","+        libsql::params![now],","+    )","+    .await?;","+    Ok(())","+}","+","+#[cfg(feature = \"backend-libsql\")]","+async fn add_column_if_missing_libsql(conn: &libsql::Connection, sql: &str) -> Result<()> {","+    match conn.execute(sql, ()).await {","+        Ok(_) => Ok(()),","+        Err(err) if err.to_string().contains(\"duplicate column name\") => Ok(()),","+        Err(err) => Err(err.into()),","+    }","+}","+","+/// Run schema migrations on a `PostgreSQL` database.","+#[cfg(feature = \"backend-postgres\")]","+pub(crate) async fn migrate_postgres(pool: &sqlx::PgPool) -> Result<()> {","+    sqlx::query(SCHEMA_MIGRATIONS_TABLE_SQL).execute(pool).await?;","+    let max_version: Option<i64> =","+        sqlx::query_scalar(\"SELECT MAX(version) FROM auth_schema_migrations\").fetch_one(pool)","+            .await?;","+