pt checked wrong variable name for major.minor","+\t\t// collisions (major_minor_collisions vs major_minor_with_duplicates).","+\t\t\"major.minor collision is detected (regression: correct variable name)\": {","+\t\t\tversions:      []string{\"1.21.2\", \"1.21.1\", \"1.20.4\"},","+\t\t\twantViolation: true,","+\t\t\tcheck: func(t *testing.T, res *CheckVersionViolationsRes) {","+\t\t\t\tt.Helper()","+\t\t\t\trequire.Contains(t, res.MajorMinorDuplicates, \"1.21\")","+\t\t\t},","+\t\t},","+\t\t// Regression: original script checked wrong variable name for RC patch","+\t\t// level (invalid_rc_patch_level vs release_candidate_with_invalid_patch_level).","+\t\t\"RC with invalid patch level is detected (regression: correct variable name)\": {","+\t\t\tversions:      []string{\"1.21.2-rc1\", \"1.20.4\"},","+\t\t\twantViolation: true,","+\t\t\tcheck: func(t *testing.T, res *CheckVersionViolationsRes) {","+\t\t\t\tt.Helper()","+\t\t\t\trequire.Contains(t, res.RCWithInvalidPatchLevel, \"1.21.2-rc1\")","+\t\t\t},","+\t\t},","+\t\t// Regression: original script RC regex only matched -rc1 through -rc9.","+\t\t\"multi-digit RC number is valid format\": {","+\t\t\tversions:      []string{\"1.21.0-rc10\", \"1.20.4\"},","+\t\t\twantViolation: false,","+\t\t\tcheck: func(t *testing.T, res *CheckVersionViolationsRes) {","+\t\t\t\tt.Helper()","+\t\t\t\trequire.Empty(t, res.InvalidVersionFormat)"],"additions":150,"deletions":0,"truncated":false}],"additions":811,"deletions":0,"truncated":true,"file_count":9},"error":null,"fetched_at":"2026-10-22T13:46:03.211973+00:00"}