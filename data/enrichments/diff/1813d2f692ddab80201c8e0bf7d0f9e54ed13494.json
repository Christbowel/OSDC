{"id":"1813d2f692ddab80201c8e0bf7d0f9e54ed13494","axis":"silent","repo":"hashicorp/vault","sha":"1813d2f692ddab80201c8e0bf7d0f9e54ed13494","parsed":{"files":[{"path":"tools/pipeline/internal/cmd/github_check.go","lines":["@@ -16,6 +16,7 @@ func newGithubCheckCmd() *cobra.Command {"," \tcheckCmd.AddCommand(newGithubCheckCommitStatusCmd())"," \tcheckCmd.AddCommand(newGithubCheckGoModDiffCmd())"," \tcheckCmd.AddCommand(newGithubCheckWorkflowRunCmd())","+\tcheckCmd.AddCommand(newGithubCheckVersionTagsCmd())"," "," \treturn checkCmd"," }"],"additions":1,"deletions":0,"truncated":false},{"path":"tools/pipeline/internal/cmd/github_check_version_tags.go","lines":["@@ -0,0 +1,105 @@","+// Copyright IBM Corp. 2016, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package cmd","+","+import (","+\t\"fmt\"","+\t\"strings\"","+","+\t\"github.com/hashicorp/vault/tools/pipeline/internal/pkg/github\"","+\t\"github.com/spf13/cobra\"","+)","+","+// entSuffixRepos is the set of repository names whose tags carry the +ent suffix.","+var entSuffixRepos = map[string]struct{}{","+\t\"vault-enterprise\": {},","+}","+","+var checkVersionTagsReq = &github.CheckVersionTagsReq{}","+","+func newGithubCheckVersionTagsCmd() *cobra.Command {","+\tcmd := &cobra.Command{","+\t\tUse:   \"version-tags --owner <org> --repo <repo> --versions <v1 v2 ...>\",","+\t\tShort: \"Validate that versions satisfy tag sequencing rules\",","+\t\tLong: `Fetches all repository tags from GitHub and validates each version against","+four tag sequencing rules:","+","+  Rule 0: The exact tag must not already exist.","+  Rule 1: A GA version (patch=0) requires at least one RC tag for that major.minor.","+  Rule 2: An rcN version (N>1) requires the rc(N-1) tag to exist.","+  Rule 3: An rc1 version must be the first tag for that major.minor.","+  Rule 4: A minor release (patch>0) requires the previous patch-level tag to exist.","+","+For repositories in the enterprise set (e.g. vault-enterprise) the +ent tag","+suffix is applied automatically unless --tag-suffix is provided explicitly.","+Use --tag-prefix and --tag-suffix to override the tag format for any project.","+When --github-output is set the results are written to $GITHUB_OUTPUT.`,","+\t\tRunE: runGithubCheckVersionTagsCmd,","+\t\tArgs: cobra.NoArgs,","+\t}","+","+\tvar rawVersions string","+\tcmd.PersistentFlags().StringVarP(&checkVersionTagsReq.Owner, \"owner\", \"o\", \"hashicorp\", \"GitHub organization\")","+\tcmd.PersistentFlags().StringVarP(&checkVersionTagsReq.Repo, \"repo\", \"r\", \"\", \"GitHub repository\")","+\tcmd.PersistentFlags().StringVar(&rawVersions, \"versions\", \"\", \"Space-separated list of versions to validate (e.g. '1.21.0-rc1 1.20.4 1.19.10')\")","+\tcmd.PersistentFlags().StringVar(&checkVersionTagsReq.TagPrefix, \"tag-prefix\", \"v\", \"Tag prefix (e.g. 'v')\")","+\tcmd.PersistentFlags().StringVar(&checkVersionTagsReq.TagSuffix, \"tag-suffix\", \"\", \"Tag suffix applied to every tag (e.g. '+ent'). Derived automatically for known enterprise repos when omitted.\")","+\tcmd.PersistentFlags().BoolVar(&checkVersionTagsReq.WriteToGithubOutput, \"github-output\", false, \"Write outputs to $GITHUB_OUTPUT\")","+","+\tfor _, flag := range []string{\"repo\", \"versions\"} {","+\t\tif err := cmd.MarkPersistentFlagRequired(flag); err != nil {","+\t\t\tpanic(err)","+\t\t}","+\t}","+","+\tcmd.PersistentPreRunE = func(c *cobra.Command, args []string) error {","+\t\tcheckVersionTagsReq.Versions = strings.Fields(rawVersions)","+","+\t\t// Apply the +ent suffix automatically for known enterprise repos unless","+\t\t// the caller has already set --tag-suffix explicitly.","+\t\tif !c.Flags().Changed(\"tag-suffix\") {","+\t\t\tif _, isEnt := entSuffixRepos[checkVersionTagsReq.Repo]; isEnt {","+\t\t\t\tcheckVersionTagsReq.TagSuffix = \"+ent\"","+\t\t\t}","+\t\t}","+","+\t\treturn nil","+\t}","+","+\treturn cmd","+}","+","+func runGithubCheckVersionTagsCmd(cmd *cobra.Command, args []string) error {","+\tcmd.SilenceUsage = true","+","+\tres, err := checkVersionTagsReq.Run(cmd.Context(), githubCmdState.GithubV3)","+\tif err != nil {","+\t\treturn fmt.Errorf(\"check-version-tags: %w\", err)","+\t}","+","+\tswitch rootCfg.format {","+\tcase \"json\":","+\t\tb, err := res.ToJSON()","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\tfmt.Println(string(b))","+\tdefault:","+\t\tfmt.Println(res.ToTable())","+\t}","+","+\tif checkVersionTagsReq.WriteToGithubOutput {","+\t\toutput, err := res.ToGithubOutput()","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\treturn writeToGithubOutput(\"version-tags\", output)","+\t}","+","+\tif !res.Passed {","+\t\treturn fmt.Errorf(\"version tag validation failed:\\n%s\", res.String())","+\t}","+","+\treturn nil","+}"],"additions":105,"deletions":0,"truncated":false},{"path":"tools/pipeline/internal/cmd/github_check_version_tags_test.go","lines":["@@ -0,0 +1,72 @@","+// Copyright IBM Corp. 2016, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package cmd","+","+import (","+\t\"testing\"","+","+\t\"github.com/hashicorp/vault/tools/pipeline/internal/pkg/github\"","+\t\"github.com/spf13/cobra\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+// TestGithubCheckVersionTagsCmd_FlagParsing verifies that required flags are","+// enforced, versions are split correctly, and that the +ent suffix is derived","+// automatically for vault-enterprise but not for other repos.","+func TestGithubCheckVersionTagsCmd_FlagParsing(t *testing.T) {","+\tfor name, tc := range map[string]struct {","+\t\targs          []string","+\t\twantVersions  []string","+\t\twantTagSuffix string","+\t\twantErr       bool","+\t}{","+\t\t\"required --repo missing returns error\": {","+\t\t\targs:    []string{\"--versions\", \"1.21.0\"},","+\t\t\twantErr: true,","+\t\t},","+\t\t\"required --versions missing returns error\": {","+\t\t\targs:    []string{\"--repo\", \"vault-enterprise\"},","+\t\t\twantErr: true,","+\t\t},","+\t\t\"vault-enterprise gets +ent suffix automatically\": {","+\t\t\targs:          []string{\"--repo\", \"vault-enterprise\", \"--versions\", \"1.21.0 1.20.4\"},","+\t\t\twantVersions:  []string{\"1.21.0\", \"1.20.4\"},","+\t\t\twantTagSuffix: \"+ent\",","+\t\t},","+\t\t\"non-enterprise repo gets no suffix\": {","+\t\t\targs:          []string{\"--repo\", \"some-oss-project\", \"--versions\", \"1.21.0\"},","+\t\t\twantVersions:  []string{\"1.21.0\"},","+\t\t\twantTagSuffix: \"\",","+\t\t},","+\t\t\"explicit --tag-suffix overrides automatic derivation\": {","+\t\t\targs:          []string{\"--repo\", \"vault-enterprise\", \"--versions\", \"1.21.0\", \"--tag-suffix\", \"\"},","+\t\t\twantVersions:  []string{\"1.21.0\"},","+\t\t\twantTagSuffix: \"\",","+\t\t},","+\t\t\"explicit non-empty --tag-suffix is preserved\": {","+\t\t\targs:          []string{\"--repo\", \"some-project\", \"--versions\", \"1.21.0\", \"--tag-suffix\", \"-custom\"},","+\t\t\twantVersions:  []string{\"1.21.0\"},","+\t\t\twantTagSuffix: \"-custom\",","+\t\t},","+\t} {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tcheckVersionTagsReq = &github.CheckVersionTagsReq{}","+\t\t\tcmd := newGithubCheckVersionTagsCmd()","+\t\t\tcmd.RunE = func(cmd *cobra.Command, args []string) error { return nil }","+\t\t\tcmd.SetArgs(tc.args)","+","+\t\t\terr := cmd.Execute()","+\t\t\tif tc.wantErr {","+\t\t\t\trequire.Error(t, err)","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.NoError(t, err)","+","+\t\t\tif tc.wantVersions != nil {","+\t\t\t\trequire.Equal(t, tc.wantVersions, checkVersionTagsReq.Versions)","+\t\t\t}","+\t\t\trequire.Equal(t, tc.wantTagSuffix, checkVersionTagsReq.TagSuffix)","+\t\t})","+\t}","+}"],"additions":72,"deletions":0,"truncated":false},{"path":"tools/pipeline/internal/cmd/releases_list.go","lines":["@@ -16,6 +16,8 @@ func newReleasesListCmd() *cobra.Command {"," \tlistCmd.AddCommand(newReleasesListBinaryVersionsCmd())"," \tlistCmd.AddCommand(newReleasesListActiveVersionsCmd())"," \tlistCmd.AddCommand(newReleasesListUpdatedVersionsCmd())","+\tlistCmd.AddCommand(newReleasesSanitizeSortVersionsCmd())","+\tlistCmd.AddCommand(newReleasesCheckVersionViolationsCmd())"," "," \treturn listCmd"," }"],"additions":2,"deletions":0,"truncated":false},{"path":"tools/pipeline/internal/cmd/releases_list_check_version_violations.go","lines":["@@ -0,0 +1,85 @@","+// Copyright IBM Corp. 2016, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package cmd","+","+import (","+\t\"fmt\"","+\t\"strings\"","+","+\t\"github.com/hashicorp/vault/tools/pipeline/internal/pkg/releases\"","+\t\"github.com/spf13/cobra\"","+)","+","+var checkVersionViolationsReq = &releases.CheckVersionViolationsReq{}","+","+func newReleasesCheckVersionViolationsCmd() *cobra.Command {","+\tcmd := &cobra.Command{","+\t\tUse:   \"check-version-violations --versions <v1 v2 ...>\",","+\t\tShort: \"Check a sorted list of versions for rule violations\",","+\t\tLong: `Checks a sorted, normalized list of versions for the following violations:","+","+  Rule 1: Only one version per major.minor series is allowed.","+  Rule 2: Only one version with patch level 0 is allowed.","+  Rule 3: A GA (patch=0) or RC version must be the highest version in the list.","+  Rule 4: GA and RC versions cannot coexist in the same release set.","+  Rule 5: RC versions must have patch level 0 (e.g. 1.2.0-rc1, not 1.2.1-rc1).","+  Rule 6: Version format must be valid (X.Y.Z or X.Y.Z-rcN, no leading zeros).","+  Rule 7: Only one GA version is allowed per release set.","+","+Input should be the sorted_versions output from 'pipeline releases list sanitize-sort-versions'.","+When --github-output is set the results are written to $GITHUB_OUTPUT using the","+same output key names as the check-for-version-violations-ent.sh script.`,","+\t\tRunE: runReleasesCheckVersionViolationsCmd,","+\t\tArgs: cobra.NoArgs,","+\t}","+","+\tvar rawVersions string","+\tcmd.PersistentFlags().StringVar(&rawVersions, \"versions\", \"\", \"Space-separated sorted list of versions to check (e.g. '1.21.0-rc1 1.20.4 1.19.10')\")","+\tcmd.PersistentFlags().BoolVar(&checkVersionViolationsReq.WriteToGithubOutput, \"github-output\", false, \"Write outputs to $GITHUB_OUTPUT\")","+","+\tif err := cmd.MarkPersistentFlagRequired(\"versions\"); err != nil {","+\t\tpanic(err)","+\t}","+","+\tcmd.PersistentPreRunE = func(c *cobra.Command, args []string) error {","+\t\tcheckVersionViolationsReq.Versions = strings.Fields(rawVersions)","+\t\treturn nil","+\t}","+","+\treturn cmd","+}","+","+func runReleasesCheckVersionViolationsCmd(cmd *cobra.Command, args []string) error {","+\tcmd.SilenceUsage = true","+","+\tres, err := checkVersionViolationsReq.Run(cmd.Context())","+\tif err != nil {","+\t\treturn fmt.Errorf(\"check-version-violations: %w\", err)","+\t}","+","+\tswitch rootCfg.format {","+\tcase \"json\":","+\t\tb, err := res.ToJSON()","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\tfmt.Println(string(b))","+\tdefault:","+\t\tfmt.Println(res.ToTable())","+\t}","+","+\tif checkVersionViolationsReq.WriteToGithubOutput {","+\t\toutput, err := res.ToGithubOutput()","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\treturn writeToGithubOutput(\"check-version-violations\", output)","+\t}","+","+\tif res.HasViolations {","+\t\treturn fmt.Errorf(\"version violations detected:\\n%s\", res.String())","+\t}","+","+\treturn nil","+}"],"additions":85,"deletions":0,"truncated":false},{"path":"tools/pipeline/internal/cmd/releases_list_sanitize_sort_versions.go","lines":["@@ -0,0 +1,81 @@","+// Copyright IBM Corp. 2016, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package cmd","+","+import (","+\t\"fmt\"","+\t\"strings\"","+","+\t\"github.com/hashicorp/vault/tools/pipeline/internal/pkg/releases\"","+\t\"github.com/spf13/cobra\"","+)","+","+var sanitizeSortVersionsReq = &releases.SanitizeSortVersionsReq{","+\tDescending: true, // default matches the original shell script behaviour","+}","+","+func newReleasesSanitizeSortVersionsCmd() *cobra.Command {","+\tcmd := &cobra.Command{","+\t\tUse:   \"sanitize-sort-versions --versions <v1 v2 ...>\",","+\t\tShort: \"Sanitize and sort a list of version strings\",","+\t\tLong: `Sanitize, normalize, and sort a space-separated list of version strings.","+Versions are sorted in descending (highest-first) order by default. Use --asc to","+sort ascending instead. Versions carrying a -lts suffix are tracked separately.","+Versions that do not match the expected format are reported as invalid.","+","+Outputs sorted_versions, lts_versions, and invalid_versions. When --github-output","+is set the results are written to $GITHUB_OUTPUT.`,","+\t\tRunE: runReleasesSanitizeSortVersionsCmd,","+\t\tArgs: cobra.NoArgs,","+\t}","+","+\tvar rawVersions string","+\tvar asc bool","+\tcmd.PersistentFlags().StringVar(&rawVersions, \"versions\", \"\", \"Space-separated list of version strings to process (e.g. '1.21.0 1.20.4-lts 1.19.10+ent')\")","+\tcmd.PersistentFlags().BoolVar(&asc, \"asc\", false, \"Sort versions ascending (lowest-first) instead of the default descending\")","+\tcmd.PersistentFlags().BoolVar(&sanitizeSortVersionsReq.WriteToGithubOutput, \"github-output\", false, \"Write outputs to $GITHUB_OUTPUT\")","+","+\terr := cmd.MarkPersistentFlagRequired(\"versions\")","+\tif err != nil {","+\t\tpanic(err)","+\t}","+","+\tcmd.PersistentPreRunE = func(c *cobra.Command, args []string) error {","+\t\tsanitizeSortVersionsReq.Versions = strings.Fields(rawVersions)","+\t\tsanitizeSortVersionsReq.Descending = !asc","+\t\treturn nil","+\t}","+","+\treturn cmd","+}","+","+func runReleasesSanitizeSortVersionsCmd(cmd *cobra.Command, args []string) error {","+\tcmd.SilenceUsage = true","+","+\tres, err := sanitizeSortVersionsReq.Run(cmd.Context())","+\tif err != nil {","+\t\treturn fmt.Errorf(\"sanitize-sort-versions: %w\", err)","+\t}","+","+\tswitch rootCfg.format {","+\tcase \"json\":","+\t\tb, err := res.ToJSON()","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\tfmt.Println(string(b))","+\tdefault:","+\t\tfmt.Println(res.ToTable())","+\t}","+","+\tif sanitizeSortVersionsReq.WriteToGithubOutput {","+\t\toutput, err := res.ToGithubOutput()","+\t\tif err != nil {","+\t\t\treturn err","+\t\t}","+\t\treturn writeToGithubOutput(\"sanitize-sort-versions\", output)","+\t}","+","+\treturn nil","+}"],"additions":81,"deletions":0,"truncated":false},{"path":"tools/pipeline/internal/cmd/releases_list_sanitize_sort_versions_test.go","lines":["@@ -0,0 +1,61 @@","+// Copyright IBM Corp. 2016, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package cmd","+","+import (","+\t\"testing\"","+","+\t\"github.com/hashicorp/vault/tools/pipeline/internal/pkg/releases\"","+\t\"github.com/spf13/cobra\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+// TestReleasesSanitizeSortVersionsCmd_FlagParsing verifies that --versions","+// is correctly split into the Versions slice and that --asc toggles sort","+// direction without requiring a real Run execution.","+func TestReleasesSanitizeSortVersionsCmd_FlagParsing(t *testing.T) {","+\tfor name, tc := range map[string]struct {","+\t\targs           []string","+\t\twantVersions   []string","+\t\twantDescending bool","+\t\twantErr        bool","+\t}{","+\t\t\"versions flag is split on whitespace\": {","+\t\t\targs:           []string{\"--versions\", \"1.21.0 1.20.4 1.19.10\"},","+\t\t\twantVersions:   []string{\"1.21.0\", \"1.20.4\", \"1.19.10\"},","+\t\t\twantDescending: true,","+\t\t},","+\t\t\"default sort is descending\": {","+\t\t\targs:           []string{\"--versions\", \"1.21.0 1.20.4\"},","+\t\t\twantDescending: true,","+\t\t},","+\t\t\"--asc sets descending to false\": {","+\t\t\targs:           []string{\"--versions\", \"1.21.0 1.20.4\", \"--asc\"},","+\t\t\twantDescending: false,","+\t\t},","+\t\t\"missing --versions flag returns error\": {","+\t\t\targs:    []string{},","+\t\t\twantErr: true,","+\t\t},","+\t} {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tsanitizeSortVersionsReq = &releases.SanitizeSortVersionsReq{Descending: true}","+\t\t\tcmd := newReleasesSanitizeSortVersionsCmd()","+\t\t\tcmd.RunE = func(cmd *cobra.Command, args []string) error { return nil }","+\t\t\tcmd.SetArgs(tc.args)","+","+\t\t\terr := cmd.Execute()","+\t\t\tif tc.wantErr {","+\t\t\t\trequire.Error(t, err)","+\t\t\t\treturn","+\t\t\t}","+\t\t\trequire.NoError(t, err)","+","+\t\t\tif tc.wantVersions != nil {","+\t\t\t\trequire.Equal(t, tc.wantVersions, sanitizeSortVersionsReq.Versions)","+\t\t\t}","+\t\t\trequire.Equal(t, tc.wantDescending, sanitizeSortVersionsReq.Descending)","+\t\t})","+\t}","+}"],"additions":61,"deletions":0,"truncated":false},{"path":"tools/pipeline/internal/pkg/releases/check_version_violations.go","lines":["@@ -0,0 +1,254 @@","+// Copyright IBM Corp. 2016, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package releases","+","+import (","+\t\"context\"","+\t\"encoding/json\"","+\t\"errors\"","+\t\"fmt\"","+\t\"log/slog\"","+\t\"regexp\"","+\t\"strconv\"","+\t\"strings\"","+","+\t\"github.com/jedib0t/go-pretty/v6/table\"","+)","+","+// violationVersionPattern matches the normalized version format produced by","+// sanitize-sort-versions: X.Y.Z or X.Y.Z-rcN (no +ent, no -lts).","+var violationVersionPattern = regexp.MustCompile(","+\t`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-rc([1-9][0-9]*))?$`,","+)","+","+// CheckVersionViolationsReq holds the parameters for checking a sorted,","+// normalized list of versions for rule violations.","+type CheckVersionViolationsReq struct {","+\t// Versions is the sorted, normalized list to check (output of sanitize-sort-versions).","+\tVersions []string","+\t// WriteToGithubOutput controls whether the command layer writes to $GITHUB_OUTPUT.","+\tWriteToGithubOutput bool","+}","+","+// CheckVersionViolationsRes is the result of the violations check.","+type CheckVersionViolationsRes struct {","+\t// HasViolations is true when at least one rule was violated.","+\tHasViolations bool `json:\"has_violations\"`","+\t// InvalidVersionFormat holds versions that did not match X.Y.Z or X.Y.Z-rcN.","+\tInvalidVersionFormat []string `json:\"invalid_version_format_violations\"`","+\t// MajorMinorDuplicates holds major.minor keys that appeared more than once.","+\tMajorMinorDuplicates []string `json:\"major_minor_with_duplicates_violations\"`","+\t// PatchZeroHits holds all versions with patch level 0 (there may only be one).","+\tPatchZeroHits []string `json:\"patch_zero_hits\"`","+\t// GaOrRcNotTopVersion holds GA or RC versions that were not the highest in the list.","+\tGaOrRcNotTopVersion []string `json:\"ga_or_rc_not_top_version_violations\"`","+\t// RCVersions holds all RC versions found (more than one is a violation).","+\tRCVersions []string `json:\"rc_version_violations\"`","+\t// GAVersions holds all GA (patch=0, no RC) versions found (more than one is a violation).","+\tGAVersions []string `json:\"ga_version_violations\"`","+\t// GaAndRcMixedInSet holds the merged GA+RC list when both appear together.","+\tGaAndRcMixedInSet []string `json:\"ga_and_rc_mixed_in_set_violations\"`","+\t// RCWithInvalidPatchLevel holds RC versions whose patch level is not 0.","+\tRCWithInvalidPatchLevel []string `json:\"release_candidate_with_invalid_patch_level_violations\"`","+}","+","+// Run checks the provided sorted, normalized versions for the seven violation rules.","+func (r *CheckVersionViolationsReq) Run(ctx context.Context) (*CheckVersionViolationsRes, error) {","+\tif err := r.validate(); err != nil {","+\t\treturn nil, err","+\t}","+","+\tslog.Default().DebugContext(ctx, \"starting check-version-violations\",","+\t\tslog.Int(\"version_count\", len(r.Versions)),","+\t)","+","+\tres := &CheckVersionViolationsRes{","+\t\tInvalidVersionFormat:    []string{},","+\t\tMajorMinorDuplicates:    []string{},","+\t\tPatchZeroHits:           []string{},","+\t\tGaOrRcNotTopVersion:     []string{},","+\t\tRCVersions:              []string{},","+\t\tGAVersions:              []string{},","+\t\tGaAndRcMixedInSet:       []string{},","+\t\tRCWithInvalidPatchLevel: []string{},","+\t}","+","+\tmajorMinorMap := make(map[string]int)","+","+\tfor _, version := range r.Versions {","+\t\tm := violationVersionPattern.FindStringSubmatch(version)","+\t\tif m == nil {","+\t\t\tslog.Default().DebugContext(ctx, \"invalid version format\", slog.String(\"version\", version))","+\t\t\tres.InvalidVersionFormat = append(res.InvalidVersionFormat, version)","+\t\t\tcontinue","+\t\t}","+","+\t\tpatch, _ := strconv.Atoi(m[3])","+\t\trc := m[4] // e.g. \"-rc1\", or \"\" for GA/release","+","+\t\tmajorMinorKey := fmt.Sprintf(\"%s.%s\", m[1], m[2])","+","+\t\t// Rule 1: track major.minor to detect duplicates.","+\t\tmajorMinorMap[majorMinorKey]++","+","+\t\t// Rule 2: patch level 0 tracking.","+\t\tif patch == 0 {","+\t\t\tres.PatchZeroHits = append(res.PatchZeroHits, version)","+\t\t}","+","+\t\t// Rule 3: GA (patch=0) or RC must be the highest version (first in the","+\t\t// descending-sorted list).","+\t\tif (patch == 0 || rc != \"\") && version != r.Versions[0] {","+\t\t\tres.GaOrRcNotTopVersion = append(res.GaOrRcNotTopVersion, version)","+\t\t}","+","+\t\t// Rule 4 & 7: classify into RC, GA, or plain release.","+\t\tif rc != \"\" {","+\t\t\tres.RCVersions = append(res.RCVersions, version)","+\t\t} else if patch == 0 {","+\t\t\tres.GAVersions = append(res.GAVersions, version)","+\t\t}","+","+\t\t// Rule 5: RC must have patch level 0.","+\t\tif rc != \"\" && patch != 0 {","+\t\t\tres.RCWithInvalidPatchLevel = append(res.RCWithInvalidPatchLevel, version)","+\t\t}","+\t}","+","+\t// Rule 1 (continued): collect major.minor keys with more than one version.","+\tfor key, count := range majorMinorMap {","+\t\tif count > 1 {","+\t\t\tres.MajorMinorDuplicates = append(res.MajorMinorDuplicates, key)","+\t\t}","+\t}","+","+\t// Rule 4: GA and RC cannot coexist.","+\tif len(res.GAVersions) > 0 && len(res.RCVersions) > 0 {","+\t\tres.GaAndRcMixedInSet = append(res.GAVersions, res.RCVersions...)","+\t}","+","+\tres.HasViolations = len(res.InvalidVersionFormat) > 0 ||","+\t\tlen(res.PatchZeroHits) > 1 ||","+\t\tlen(res.GaOrRcNotTopVersion) > 0 ||","+\t\tlen(res.MajorMinorDuplicates) > 0 ||","+\t\tlen(res.RCVersions) > 1 ||","+\t\tlen(res.GAVersions) > 1 ||","+\t\tlen(res.GaAndRcMixedInSet) > 0 ||","+\t\tlen(res.RCWithInvalidPatchLevel) > 0","+","+\tslog.Default().DebugContext(ctx, \"completed check-version-violations\",","+\t\tslog.Bool(\"has_violations\", res.HasViolations),","+\t)","+","+\treturn res, nil","+}","+","+// validate checks that the request is initialized.","+func (r *CheckVersionViolationsReq) validate() error {","+\tif r == nil {","+\t\treturn errors.New(\"uninitialized request\")","+\t}","+","+\treturn nil","+}","+","+// ToJSON marshals the response to JSON.","+func (r *CheckVersionViolationsRes) ToJSON() ([]byte, error) {","+\tif r == nil {","+\t\treturn nil, errors.New(\"uninitialized response\")","+\t}","+","+\tb, err := json.Marshal(r)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"marshaling check-version-violations response to JSON: %w\", err)","+\t}","+","+\treturn b, nil","+}","+","+// ToTable marshals the response to a text table.","+func (r *CheckVersionViolationsRes) ToTable() string {","+\tif r == nil {","+\t\treturn \"\"","+\t}","+","+\tt := table.NewWriter()","+\tt.Style().Options.DrawBorder = false","+\tt.Style().Options.SeparateColumns = false","+\tt.Style().Options.SeparateFooter = false","+\tt.Style().Options.SeparateHeader = false","+\tt.Style().Options.SeparateRows = false","+","+\tt.AppendHeader(table.Row{\"violation\", \"versions\"})","+\tappendViolation := func(name string, items []string) {","+\t\tif len(items) > 0 {","+\t\t\tt.AppendRow(table.Row{name, strings.Join(items, \", \")})","+\t\t}","+\t}","+\tappendViolation(\"invalid_version_format\", r.InvalidVersionFormat)","+\tappendViolation(\"major_minor_duplicates\", r.MajorMinorDuplicates)","+\tappendViolation(\"patch_zero_hits\", r.PatchZeroHits)","+\tappendViolation(\"ga_or_rc_not_top_version\", r.GaOrRcNotTopVersion)","+\tappendViolation(\"multiple_rc_versions\", r.RCVersions)","+\tappendViolation(\"multiple_ga_versions\", r.GAVersions)","+\tappendViolation(\"ga_and_rc_mixed\", r.GaAndRcMixedInSet)","+\tappendViolation(\"rc_invalid_patch_level\", r.RCWithInvalidPatchLevel)","+","+\tt.SuppressEmptyColumns()","+\tt.SuppressTrailingSpaces()","+","+\treturn t.Render()","+}","+","+// ToGithubOutput returns the outputs formatted for $GITHUB_OUTPUT, matching","+// the key names the compile-version-rule-violations workflow step expects.","+func (r *CheckVersionViolationsRes) ToGithubOutput() ([]byte, error) {","+\tif r == nil {","+\t\treturn nil, errors.New(\"uninitialized response\")","+\t}","+","+\tjoin := func(items []string) string { return strings.Join(items, \",\") }","+","+\tout := strings.Builder{}","+\tout.WriteString(fmt.Sprintf(\"has_violations=%t\\n\", r.HasViolations))","+\tout.WriteString(fmt.Sprintf(\"invalid_version_format_violations=%s\\n\", join(r.InvalidVersionFormat)))","+\tout.WriteString(fmt.Sprintf(\"patch_zero_hits=%s\\n\", join(r.PatchZeroHits)))","+\tout.WriteString(fmt.Sprintf(\"ga_or_rc_not_top_version_violations=%s\\n\", join(r.GaOrRcNotTopVersion)))","+\tout.WriteString(fmt.Sprintf(\"major_minor_with_duplicates_violations=%s\\n\", join(r.MajorMinorDuplicates)))","+\tout.WriteString(fmt.Sprintf(\"ga_and_rc_mixed_in_set_violations=%s\\n\", join(r.GaAndRcMixedInSet)))","+\tout.WriteString(fmt.Sprintf(\"release_candidate_with_invalid_patch_level_violations=%s\\n\", join(r.RCWithInvalidPatchLevel)))","+\tout.WriteString(fmt.Sprintf(\"rc_version_violations=%s\\n\", join(r.RCVersions)))","+\tout.WriteString(fmt.Sprintf(\"ga_version_violations=%s\\n\", join(r.GAVersions)))","+","+\treturn []byte(out.String()), nil","+}","+","+// String returns a human-readable summary.","+func (r *CheckVersionViolationsRes) String() string {","+\tif r == nil {","+\t\treturn \"\"","+\t}","+","+\tif !r.HasViolations {","+\t\treturn \"No version violations found.\\n\"","+\t}","+","+\tw := strings.Builder{}","+\tw.WriteString(\"Version violations found:\\n\")","+\treport := func(label string, items []string) {","+\t\tif len(items) > 0 {","+\t\t\tw.WriteString(fmt.Sprintf(\"  %s: %s\\n\", label, strings.Join(items, \", \")))","+\t\t}","+\t}","+\treport(\"invalid_version_format\", r.InvalidVersionFormat)","+\treport(\"major_minor_duplicates\", r.MajorMinorDuplicates)","+\treport(\"patch_zero_hits (>1 not allowed)\", r.PatchZeroHits)","+\treport(\"ga_or_rc_not_top_version\", r.GaOrRcNotTopVersion)","+\treport(\"multiple_rc_versions\", r.RCVersions)","+\treport(\"multiple_ga_versions\", r.GAVersions)","+\treport(\"ga_and_rc_mixed_in_set\", r.GaAndRcMixedInSet)","+\treport(\"rc_with_invalid_patch_level\", r.RCWithInvalidPatchLevel)","+","+\treturn w.String()","+}"],"additions":254,"deletions":0,"truncated":false},{"path":"tools/pipeline/internal/pkg/releases/check_version_violations_test.go","lines":["@@ -0,0 +1,239 @@","+// Copyright IBM Corp. 2016, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package releases","+","+import (","+\t\"context\"","+\t\"encoding/json\"","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+)","+","+// Test_CheckVersionViolationsReq_Run verifies that each of the seven rules is","+// correctly detected, and that a clean input produces no violations. The bugs","+// in the original shell script (double-counted GA versions, wrong variable","+// names for major.minor collisions and RC-patch-level violations) are each","+// covered by a dedicated case.","+func Test_CheckVersionViolationsReq_Run(t *testing.T) {","+\tt.Parallel()","+","+\tctx := context.Background()","+","+\tfor name, tc := range map[string]struct {","+\t\tversions      []string","+\t\twantViolation bool","+\t\tcheck         func(t *testing.T, res *CheckVersionViolationsRes)","+\t}{","+\t\t\"nil request returns error\": {","+\t\t\tversions: nil,","+\t\t\tcheck: func(t *testing.T, res *CheckVersionViolationsRes) {","+\t\t\t\tt.Helper()","+\t\t\t\t// handled separately below","+\t\t\t},","+\t\t},","+\t\t\"clean release set has no violations\": {","+\t\t\tversions:      []string{\"1.21.0-rc1\", \"1.20.4\", \"1.19.10\", \"1.18.15\"},","+\t\t\twantViolation: false,","+\t\t\tcheck: func(t *testing.T, res *CheckVersionViolationsRes) {","+\t\t\t\tt.Helper()","+\t\t\t\trequire.Empty(t, res.InvalidVersionFormat)","+\t\t\t\trequire.Empty(t, res.MajorMinorDuplicates)","+\t\t\t\trequire.Empty(t, res.GaOrRcNotTopVersion)","+\t\t\t\trequire.Empty(t, res.GaAndRcMixedInSet)","+\t\t\t\trequire.Empty(t, res.RCWithInvalidPatchLevel)","+\t\t\t},","+\t\t},","+\t\t\"rule 1: two versions with same major.minor detected\": {","+\t\t\tversions:      []string{\"1.21.1\", \"1.21.0\", \"1.20.4\"},","+\t\t\twantViolation: true,","+\t\t\tcheck: func(t *testing.T, res *CheckVersionViolationsRes) {","+\t\t\t\tt.Helper()","+\t\t\t\trequire.Contains(t, res.MajorMinorDuplicates, \"1.21\")","+\t\t\t},","+\t\t},","+\t\t\"rule 2: two versions with patch level 0 detected\": {","+\t\t\tversions:      []string{\"2.0.0\", \"1.20.4\", \"1.19.0\"},","+\t\t\twantViolation: true,","+\t\t\tcheck: func(t *testing.T, res *CheckVersionViolationsRes) {","+\t\t\t\tt.Helper()","+\t\t\t\trequire.Len(t, res.PatchZeroHits, 2)","+\t\t\t},","+\t\t},","+\t\t\"rule 3: GA version not at top of list detected\": {","+\t\t\tversions:      []string{\"1.21.1\", \"1.20.0\", \"1.19.10\"},","+\t\t\twantViolation: true,","+\t\t\tcheck: func(t *testing.T, res *CheckVersionViolationsRes) {","+\t\t\t\tt.Helper()","+\t\t\t\trequire.Contains(t, res.GaOrRcNotTopVersion, \"1.20.0\")","+\t\t\t},","+\t\t},","+\t\t\"rule 3: RC version not at top of list detected\": {","+\t\t\tversions:      []string{\"1.21.1\", \"1.20.0-rc1\", \"1.19.10\"},","+\t\t\twantViolation: true,","+\t\t\tcheck: func(t *testing.T, res *CheckVersionViolationsRes) {","+\t\t\t\tt.Helper()","+\t\t\t\trequire.Contains(t, res.GaOrRcNotTopVersion, \"1.20.0-rc1\")","+\t\t\t},","+\t\t},"