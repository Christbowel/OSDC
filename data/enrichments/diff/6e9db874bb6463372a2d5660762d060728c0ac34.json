              b\"\\n  Rules that need type information did not run there.\",","+            ),","+            Self::BelowBackslash => (","+                b\"The type checker cannot read a path that has a backslash in a directory's name: \",","+                b\"\\n  Rules that need type information did not run there.\",","+            ),","+        }","+    }","+","+    /// `--type-check`","+    fn error(self) -> &'static [u8] {","+        match self {","+            Self::OutOfStack => {","+                b\"The type checker ran out of stack. Type errors in this file may be missing. This is a bug in Bun.\"","+            }","+            Self::NestedTooDeeply => {","+                b\"The code is nested too deeply for the type checker. Type errors in this file may be missing.\"","+            }","+            Self::BelowBackslash => {","+                b\"The type checker cannot read this file because a directory in its path has a backslash in its name.\"","+            }","+        }","+    }","+}","+","+/// [`Context::not_type_checked`], without the files that couldn't be parsed, which say so themselves.","+fn not_type_checked(context: &Context, results: &[FileResult]) -> Vec<NotTypeChecked> {","+    let mut noted = std::mem::take(&mut *context.not_type_checked.lock());","+    if !noted.is_empty() {","+        bun_lint::utils::sort::sort_by(&mut noted, |a, b| a.cmp(b));","+        noted.dedup();","+        let rejected = results.iter().filter(|it| it.counts.fatal_errors > 0);","+        let rejected: FxHashSet<&[u8]> = rejected.map(|it| &it.path[..]).collect();","+        noted.retain(|it| !rejected.contains(&it.path[..]));","+    }","+    noted","+}","+","+/// Without `--type-check`: the warnings about the files that weren't checked in full.","+pub(crate) fn warnings_about_not_type_checked(","+    context: &Context,","+    results: &[FileResult],","+) -> Vec<Vec<u8>> {","+    if context.checks_types {","+        return Vec::new();","+    }","+    let noted = not_type_checked(context, results);","+    let warnings = noted.chunk_by(|a, b| a.why == b.why).map(|files| {","+        let (start, end) = files[0].why.warning();","+        let examples = files.iter().take(3).map(|it| {","+            let path = crate::paths::from_native(&it.path);","+            crate::paths::relative_escaped(context.cwd, &path)","+        });","+        let examples: Vec<Vec<u8>> = examples.collect();","+        let more: &[u8] = if files.len() > 3 { b\", ..\" } else { b\"\" };","+        [start, &examples.join(&b\", \"[..]), more, end].concat()","+    });","+    warnings.collect()","+}","+","+/// With `--type-check`, a file that wasn't checked in full has an error, as it does for `bun check`: nobody has looked for","+/// its type errors. Call this once no rule runs any more.","+pub(crate) fn report_not_type_checked(context: &Context, results: &mut [FileResult]) {","+    if !context.checks_types {","+        return;","+    }","+    let noted = not_type_checked(context, results);","+    let mut by_path: FxHashMap<&[u8], Vec<LintMessage>> = FxHashMap::default();","+    for it in &noted {","+        by_path.entry(&it.path).or_default().push(LintMessage {","+            message: it.why.error().to_vec(),","+            line: 1,","+            column: 1,","+            ..LintMessage::default()","+        });","+    }","+    if by_path.is_empty() {","+        return;","+    }","+    for result in results {","+        if let Some(messages) = by_path.remove(&result.path[..]) {","+            result.messages.splice(0..0, messages);","+            result.counts = Counts::of(&result.messages);","+        }","+    }","+}","+"," /// The warning for a file where"," /// [`File::is_too_large_for_flow_analysis`](bun_lint::ast::File::is_too_large_for_flow_analysis) is true."," /// typescript-eslint reports nothing.","@@ -767,7 +903,15 @@ pub(crate) fn lint(","         ..Fixing::default()","     };","     let mut states: Vec<Fixing> = files.iter().map(state).coll