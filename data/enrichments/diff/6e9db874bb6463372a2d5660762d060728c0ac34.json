er().filter(|it| it.thrown.is_some());"],"additions":6,"deletions":19,"truncated":false},{"path":"src/lint/driver/typed.rs","lines":["@@ -353,6 +353,15 @@ fn check_and_lint_in(","     project: Project<'_>,","     is_first_pass: bool,"," ) -> (Vec<Option<Linted>>, Vec<ProgramKind>) {","+    // What an earlier pass of `--fix`, or another program, couldn't check is checked again.","+    {","+        let mut noted = context.not_type_checked.lock();","+        if !noted.is_empty() {","+            let checked = indices.iter().map(|&it| files[it].path.to_vec());","+            let checked: FxHashSet<Vec<u8>> = checked.map(crate::paths::to_native).collect();","+            noted.retain(|it| !checked.contains(&it.path));","+        }","+    }","     let by_path = ByPath {","         exact: indices","             .iter()","@@ -463,7 +472,7 @@ fn check_and_lint_in(","             Some(linted) => results.lock()[at] = Some(linted),","             // It'll be linted without types. If the tree is too deep for the parser, the linter reports that itself.","             None if !checker.hir(file).ran_out_of_stack && checker.bound(file).ran_out_of_stack => {","-                context.out_of_stack.lock().push(path.to_vec());","+                note_not_type_checked(context, path, NotTypeCheckedBecause::NestedTooDeeply);","             }","             None => {}","         }","@@ -571,9 +580,15 @@ fn check_and_lint_in(","         }","         note_invalid_tsconfig(context, rejected);","     }","-    // The linter itself reports code that's nested too deeply for the parser.","-    let out_of_stack = incomplete.into_iter().filter(|it| !it.is_nested_too_deeply);","-    (context.out_of_stack.lock()).extend(out_of_stack.map(|it| to_native(&it.path).to_vec()));","+    for it in incomplete {","+        if let Some(at) = by_path.get(&it.path, is_case_sensitive) {","+            let why = match it.is_nested_too_deeply {","+                true => NotTypeCheckedBecause::NestedTooDeeply,","+   