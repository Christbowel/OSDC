radleRunner(\"generateMetadataFileForLibraryPublication\").withEnvironment([\"TEST_NATIVE_BUILD\": \"host\"]).build()","+","+        then:","+        def variants = new JsonSlurper().parse(file(\"build/publications/library/module.json\")).variants","+        variants*.name.contains(\"runtimeElements\")","+        variants.every { it.attributes[\"org.gradle.libraryelements\"] != NativeLibraries.LIBRARY_ELEMENTS }","     }"," ","     /**","-     * Adds a second project that consumes this library. How a consumer reaches the library is the part","-     * expected to change — today a named configuration, later carried along by depending on the owning","-     * project — so it is wired in one place, leaving the tests above about behaviour only.","+     * Adds a project, {@code consumer}, that depends on this one as a Java library and selects the native","+     * library directory from its runtime classpath. {@code consumer} also depends on a project and on an","+     * external module that build no native library, so the tests check that the selection skips them.","      */","     private void addConsumingProject() {","+        buildFile << \"\"\"","+        apply plugin: 'java-library'","+        \"\"\"","         settingsFile << \"\"\"","         include 'consumer'","+        include 'plain'","+        \"\"\"","+        file(\"plain/build.gradle\") << \"\"\"","+        apply plugin: 'java-library'","+        \"\"\"","+        file(\"repo/org/example/plain-external/1.0/plain-external-1.0.jar\") << \"not really a jar\"","+        file(\"repo/org/example/plain-external/1.0/plain-external-1.0.pom\") << \"\"\"<?xml version=\"1.0\" encoding=\"UTF-8\"?>","+        <project xmlns=\"http://maven.apache.org/POM/4.0.0\">","+          <modelVersion>4.0.0</modelVersion>","+          <groupId>org.example</groupId>","+          <artifactId>plain-external</artifactId>","+          <version>1.0</version>","+        </project>","         \"\"\"","         file(\"consumer/build.gradle\") << \"\"\"","-        import org.gradle.api.artifacts.type.ArtifactTypeDefinition","+        import ${NativeLibraryPathExtension.name}"," ","-        // Gradle 9 rejects a configuration that both declares dependencies and is resolved.","-        configurations.dependencyScope('nativeLibsDeclared')","-        configurations.resolvable('nativeLibs') {","-          extendsFrom(configurations.nativeLibsDeclared)","-          attributes.attribute(ArtifactTypeDefinition.ARTIFACT_TYPE_ATTRIBUTE, ArtifactTypeDefinition.DIRECTORY_TYPE)","+        apply plugin: 'java'","+        repositories {","+          maven { url = file('../repo') }","         }","         dependencies {","-          nativeLibsDeclared project(path: ':', configuration: '${NativeLibraryBuildPlugin.ELEMENTS_CONFIGURATION}')","+          implementation project(':')","+          implementation project(':plain')","+          implementation 'org.example:plain-external:1.0'","         }","         tasks.register('consume', Copy) {","-          from configurations.nativeLibs","+          from NativeLibraryPathExtension.of(project).libraryDirectoriesOf(configurations.runtimeClasspath)","           into layout.buildDirectory.dir('consumed')","         }","+        tasks.register('copyClasspath', Copy) {","+          from configurations.runtimeClasspath","+          into layout.buildDirectory.dir('classpath')","+        }","         \"\"\"","     }"," ","-    /** Where {@link #addConsumingProject} leaves the library it consumed. */","-    private File consumedLibrary() {","-        file(\"consumer/build/consumed/${PLATFORM}/libtest.so\")","+    /**","+     * The paths of all the files the {@code consume} task of {@link #addConsumingProject} copied, relative to its","+     * destination directory and separated by {@code /}.","+     */","+    private List<String> consumedFiles() {","+        def destination = file(\"consumer/build/consumed\").toPath()","+        def files = []","+        destination.toFile().eachFileRecurse(FileType.FILES) { files << destination.relativize(it.toPath()).toString().replace(File.separator, \"/\") }","+        return files","     }"," ","     /**"],"additions":80,"deletions":15,"truncated":false},{"path":"build-tools-internal/src/integTest/groovy/org/elasticsearch/gradle/internal/nativelibs/NativeLibraryCollectionPluginFuncTest.groovy","lines":["@@ -33,14 +33,8 @@ class NativeLibraryCollectionPluginFuncTest extends AbstractGradleInternalPlugin"," ","     def setup() {","         buildFile << \"\"\"","-        import org.gradle.api.artifacts.type.ArtifactTypeDefinition","-","-        configurations.resolvable('collected') {","-          extendsFrom(configurations.${NativeLibraryCollectionPlugin.PROJECTS_CONFIGURATION})","-          attributes.attribute(ArtifactTypeDefinition.ARTIFACT_TYPE_ATTRIBUTE, ArtifactTypeDefinition.DIRECTORY_TYPE)","-        }","         tasks.register('collect', Copy) {","-          from configurations.collected","+          from configurations.${NativeLibraryCollectionPlugin.ALL_LIBRARIES_CONFIGURATION}","           into layout.buildDirectory.dir('platform')","         }","         \"\"\""],"additions":1,"deletions":7,"truncated":false},{"path":"build-tools-internal/src/integTest/groovy/org/elasticsearch/gradle/internal/nativelibs/NativeLibraryPathFuncTest.groovy","lines":["@@ -0,0 +1,252 @@","+/*","+ * Copyright Elasticsearch B.V. and/or licensed to Elasticsearch B.V. under one","+ * or more contributor license agreements. Licensed under the \"Elastic License","+ * 2.0\", the \"GNU Affero General Public License v3.0 only\", and the \"Server Side","+ * Public License v 1\"; you may not use this file except in compliance with, at","+ * your election, the \"Elastic License 2.0\", the \"GNU Affero General Public","+ * License v3.0 only\", or the \"Server Side Public License, v 1\".","+ */","+","+package org.elasticsearch.gradle.internal.nativelibs","+","+import org.elasticsearch.gradle.fixtures.AbstractGradleInternalPluginFuncTest","+import org.elasticsearch.gradle.internal.ElasticsearchJavaBasePlugin","+import org.gradle.api.Plugin","+import org.gradle.testkit.runner.TaskOutcome","+","+/**","+ * Tests how {@link ElasticsearchJavaBasePlugin} sets {@code es.nativelibs.path} on {@code Test}","+ * tasks. Instead of running a test JVM, a {@code report<Task>} task writes out the","+ * {@code es.nativelibs.path} argument that the {@code Test} task would pass to its JVM, and","+ * the tests check that file.","+ */","+class NativeLibraryPathFuncTest extends AbstractGradleInternalPluginFuncTest {","+","+    /** The {@code <os>-<arch>} name of the platform the test runs on. */","+    static final String PLATFORM = BuildNativeLibraryTask.hostPlatform()","+","+    Class<? extends Plugin> pluginClassUnderTest = ElasticsearchJavaBasePlugin.class","+","+    def setup() {","+        buildFile << \"\"\"","+        import ${NativeLibraryPathArgumentProvider.name}","+","+        apply plugin: 'java'","+","+        abstract class ReportJvmArguments extends DefaultTask {","+          @Nested","+          abstract ListProperty<CommandLineArgumentProvider> getProviders()","+","+          @OutputFile","+          abstract RegularFileProperty getReport()","+","+          @TaskAction","+          void write() {","+            report.get().asFile.text = providers.get().collectMany { it.asArguments() as List }.join('\\\\n')","+          }","+        }","+","+        def reportOn = { String testTask ->","+          tasks.register(\"report\\${testTask.capitalize()}\", ReportJvmArguments) {","+            providers.addAll(tasks.named(testTask).map { t -> t.jvmArgumentProviders.findAll { it instanceof NativeLibraryPathArgumentProvider } })","+            report = layout.buildDirectory.file(\"\\${testTask}-jvm-arguments.txt\")","+          }","+        }","+        reportOn('test')","+        \"\"\"","+    }","+","+    def \"a test task passes the directories containing the native libraries of the projects it depends on\"() {","+        given:","+        nativeLibraryProject('library')","+        buildFile << \"\"\"","+        dependencies {","+          implementation project(':library')","+        }","+        \"\"\"","+","+        when:","+        def result = gradleRunner(\"reportTest\").withEnvironment([\"TEST_NATIVE_BUILD\": \"host\"]).build()","+        def pathWhenStored = nativeLibraryPath('test')","+        // the report task must run again for the reused entry to show the argument it passes","+        file(\"build/test-jvm-arguments.txt\").delete()","+        def reused = gradleRunner(\"reportTest\").withEnvironment([\"TEST_NATIVE_BUILD\": \"host\"]).build()","+","+        then:","+        result.task(\":library:buildNativeLibrary\").outcome == TaskOutcome.SUCCESS","+        result.output.contains(\"Configuration cache entry stored.\")","+        pathWhenStored == [file(\"library/build/native-libs/${PLATFORM}\").canonicalPath]","+        reused.output.contains(\"Reusing configuration cache.\")","+        nativeLibraryPath('test') == pathWhenStored","+    }","+","+    def \"a test task depending on no project that builds native libraries passes an empty es.nativelibs.path\"() {","+        given:","+        nativeLibraryProject('library')","+        plainProject('plain')","+        buildFile << \"\"\"","+        dependencies {","+          implementation project(':plain')","+        }","+        \"\"\"","+","+        when:","+        def result = gradleRunner(\"reportTest\").withEnvironment([\"TEST_NATIVE_BUILD\": \"host\"]).build()","+","+        then:","+        result.task(\":library:buildNativeLibrary\") == null","+        file(\"build/test-jvm-arguments.txt\").text == \"-Des.nativelibs.path=\"","+    }","+","+    def \"a test task named after a source set uses that source set's runtime classpath, any other test task uses the runtime classpaths of all test source sets\"() {","+        given:","+        nativeLibraryProject('testLibrary')","+        nativeLibraryProject('extraLibrary')","+        nativeLibraryProject('toolsLibrary')","+        buildFile << \"\"\"","+        sourceSets {","+          extraTest","+          tools","+        }","+        dependencies {","+          testImplementation project(':testLibrary')","+          extraTestImplementation project(':extraLibrary')","+          toolsImplementation project(':toolsLibrary')","+        }","+        tasks.register('extraTest', Test)","+        tasks.register('otherTest', Test)","+        reportOn('extraTest')","+        reportOn('otherTest')","+        \"\"\"","+","+        when:","+        gradleRunner(\"reportTest\", \"reportExtraTest\", \"reportOtherTest\").withEnvironment([\"TEST_NATIVE_BUILD\": \"host\"]).build()","+","+        then:","+        nativeLibraryPath('test') == [file(\"testLibrary/build/native-libs/${PLATFORM}\").canonicalPath]","+        nativeLibraryPath('extraTest') == [file(\"extraLibrary/build/native-libs/${PLATFORM}\").canonicalPath]","+        // the tools source set is not one that tests run on, so its library is not passed down","+        nativeLibraryPath('otherTest') as Set == [","+            file(\"testLibrary/build/native-libs/${PLATFORM}\").canonicalPath,","+            file(\"extraLibrary/build/native-libs/${PLATFORM}\").canonicalPath","+        ] as Set","+    }","+","+    def \"a test task is bound to the source set named like it, whether the task or the source set is created first\"() {","+        given:","+        nativeLibraryProject('lateLibrary')","+        nativeLibraryProject('earlyLibrary')","+        buildFile << \"\"\"","+        // the task is created, and gets its default, before the source set it is named after exists","+        tasks.register('late', Test).get()","+        sourceSets.create('late')","+        // the source set is created before the task is","+        sourceSets.create('early')","+        tasks.register('early', Test)","+        dependencies {","+          lateImplementation project(':lateLibrary')","+          earlyImplementation project(':earlyLibrary')","+        }","+        reportOn('late')","+        reportOn('early')","+        \"\"\"","+","+        when:","+        gradleRunner(\"reportLate\", \"reportEarly\").withEnvironment([\"TEST_NATIVE_BUILD\": \"host\"]).build()","+","+        then:","+        nativeLibraryPath('late') == [file(\"lateLibrary/build/native-libs/${PLATFORM}\").canonicalPath]","+        nativeLibraryPath('early') == [file(\"earlyLibrary/build/native-libs/${PLATFORM}\").canonicalPath]","+    }","+","+    def \"an explicit configuration of a test task named like a source set wins, whether the task or the source set is created first\"() {","+        given:","+        nativeLibraryProject('sourceSetLibrary')","+        buildFile << \"\"\"","+        import ${NativeLibraryPathExtension.name}","+        def nativeLibraryPath = NativeLibraryPathExtension.of(project)","+","+        // the task, configured in its register closure, is created before the source set it is named after","+        tasks.register('first', Test) { nativeLibraryPath.configureWithDirectories(it, file('explicit')) }.get()","+        sourceSets.create('first')","+        // the source set is created before the task is","+        sourceSets.create('second')","+        tasks.register('second', Test) { nativeLibraryPath.configureWithDirectories(it, file('explicit')) }","+        dependencies {","+          firstImplementation project(':sourceSetLibrary')","+          secondImplementation project(':sourceSetLibrary')","+        }","+        reportOn('first')","+        reportOn('second')","+        \"\"\"","+","+        when:","+        gradleRunner(\"reportFirst\", \"reportSecond\").withEnvironment([\"TEST_NATIVE_BUILD\": \"host\"]).build()","+","+        then:","+        nativeLibraryPath('first') == [file(\"explicit/${PLATFORM}\").canonicalPath]","+        nativeLibraryPath('second') == [file(\"explicit/${PLATFORM}\").canonicalPath]","+    }","+","+    def \"a test task passes the directory containing the native libraries built by the project of the task\"() {","+        given:","+        file(\"native/Makefile\") << \"all:\\n\\ttrue\\n\"","+        buildFile << \"\"\"","+        plugins.apply(${NativeLibraryBuildPlugin.name})","+        ${nativeLibraryBuild('hello-world')}","+        \"\"\"","+","+        when:","+        def result = gradleRunner(\"reportTest\").withEnvironment([\"TEST_NATIVE_BUILD\": \"host\"]).build()","+","+        then:","+        result.task(\":buildNativeLibrary\").outcome == TaskOutcome.SUCCESS","+        nativeLibraryPath('test') == [file(\"build/native-libs/${PLATFORM}\").canonicalPath]","+    }","+","+    /** The directories listed in the {@code es.nativelibs.path} argument that {@code testTask} would pass to its JVM. */","+    private List<String> nativeLibraryPath(String testTask) {","+        String arguments = file(\"build/${testTask}-jvm-arguments.txt\").text","+        assert arguments.startsWith(\"-Des.nativelibs.path=\")","+        String path = arguments.substring(\"-Des.nativelibs.path=\".length())","+        return path.isEmpty() ? [] : path.split(File.pathSeparator).collect { new File(it).canonicalPath }","+    }","+","+    /** Adds a Java library project, {@code name}, that applies {@link NativeLibraryBuildPlugin} and builds {@code lib<name>.so}. */","+    private void nativeLibraryProject(String name) {","+        settingsFile << \"\"\"","+        include '${name}'","+        \"\"\"","+        file(\"${name}/native/Makefile\") << \"all:\\n\\ttrue\\n\"","+        file(\"${name}/build.gradle\") << \"\"\"","+        apply plugin: 'java-library'","+        plugins.apply(${NativeLibraryBuildPlugin.name})","+        ${nativeLibraryBuild(name)}","+        \"\"\"","+    }","+","+    /** Adds a Java library project, {@code name}, that builds no native library. */","+    private void plainProject(String name) {","+        settingsFile << \"\"\"","+        include '${name}'","+        \"\"\"","+        file(\"${name}/build.gradle\") << \"\"\"","+        apply plugin: 'java-library'","+        \"\"\"","+    }","+","+    /** A {@code nativeLibraryBuild} block whose host build writes {@code lib<name>.so} for the platform the test runs on. */","+    private static String nativeLibraryBuild(String name) {","+        return \"\"\"","+        nativeLibraryBuild {","+          modeEnvironmentVariable = 'TEST_NATIVE_BUILD'","+          supportedPlatforms = ['${PLATFORM}']","+          workingDir = layout.projectDirectory.dir('native')","+          sources = ['native/Makefile']","+          toolchainImage = 'example/toolchain:1'","+          dockerCommand = ['make', 'all']","+          hostCommand { outputDir -> ['sh', '-c', \"mkdir -p \\$outputDir.asFile/${PLATFORM} && echo built > \\$outputDir.asFile/${PLATFORM}/lib${name}.so\"] }","+        }","+        \"\"\"","+    }","+}"],"additions":252,"deletions":0,"truncated":false},{"path":"build-tools-internal/src/main/groovy/elasticsearch.ide.gradle","lines":["@@ -12,6 +12,7 @@ import org.elasticsearch.gradle.util.GradleUtils"," import org.elasticsearch.gradle.internal.test.TestUtil"," import org.elasticsearch.gradle.internal.idea.EnablePreviewFeaturesTask"," import org.elasticsearch.gradle.internal.idea.IdeaXmlUtil","+import org.elasticsearch.gradle.internal.nativelibs.NativeLibraryCollectionPlugin"," import org.jetbrains.gradle.ext.JUnit"," "," import java.nio.file.Files","@@ -165,6 +166,20 @@ if (providers.systemProperty('idea.active').getOrNull() == 'true') {","     }","   }"," ","+  // The JUnit run configuration defaults below take es.nativelibs.path as one fixed string, the directory this","+  // task fills with the native libraries of all the projects that build them. Only the root project of the","+  // Elasticsearch build has them to collect; a build that includes Elasticsearch applies this script too.","+  if (project == rootProject && file('build-tools-internal/version.properties').exists()) {","+    project.apply(plu