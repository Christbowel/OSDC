{"id":"c17ab03e5a8872d9941ffa3d35d990c4626c6c3b","axis":"silent","repo":"pnpm/pnpm","sha":"c17ab03e5a8872d9941ffa3d35d990c4626c6c3b","parsed":{"files":[{"path":".changeset/hoisted-fetch-gvs-v12.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pacquet\": patch","+---","+","+`pnpm fetch` with `nodeLinker` set to `hoisted` no longer populates global virtual store links. `pnpm fetch` also preserves an existing hoisted `node_modules` directory. `pnpm fetch` no longer modifies linked agent skills. `pnpm install` with `frozenStore` enabled no longer fails with `ERR_PNPM_FROZEN_STORE_NEEDS_BUILD` when `nodeLinker` is `hoisted` [#18037](https://github.com/pnpm/pnpm/issues/18037)."],"additions":5,"deletions":0,"truncated":false},{"path":".changeset/hoisted-fetch-patched-deps.md","lines":["@@ -0,0 +1,8 @@","+---","+\"@pnpm/installing.commands\": patch","+\"@pnpm/installing.deps-installer\": patch","+\"@pnpm/installing.deps-restorer\": patch","+\"pnpm\": patch","+---","+","+`pnpm fetch` no longer fails with `ENOENT` when `nodeLinker` is `hoisted` and the project configures `patchedDependencies` or `allowBuilds`. `pnpm fetch` also preserves an existing hoisted `node_modules` directory [#18037](https://github.com/pnpm/pnpm/issues/18037)."],"additions":8,"deletions":0,"truncated":false},{"path":"pnpm/crates/cli/tests/suite/fetch.rs","lines":["@@ -308,8 +308,8 @@ fn fetch_runs_a_build_script_that_calls_a_sibling_dependency_bin() {","     drop((root, mock_instance));"," }"," ","-/// TS: `fetch fails with ERR_PNPM_PATCH_NOT_FOUND when a patch file is","-/// missing` ([pnpm/pnpm#5268](https://github.com/pnpm/pnpm/issues/5268)).","+/// TS: `fetch with nodeLinker=%s fails with ERR_PNPM_PATCH_NOT_FOUND when a","+/// patch file is missing` ([pnpm/pnpm#5268](https://github.com/pnpm/pnpm/issues/5268))."," #[test]"," fn fetch_fails_with_patch_not_found_when_a_patch_file_is_missing() {","     const PATCHED_DEP: &str = \"@pnpm.e2e/console-log\";","@@ -317,46 +317,284 @@ fn fetch_fails_with_patch_not_found_when_a_patch_file_is_missing() {","         \"../../../../../pnpm11/installing/commands/test/__fixtures__/patchedDependencies/console-log-replace-1st-line.patch\"","     );"," ","+    for node_linker in [\"isolated\", \"hoisted\"] {","+        let CommandTempCwd { root, workspace, npmrc_info, .. } =","+            CommandTempCwd::init().add_mocked_registry();","+        let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+","+        fs::create_dir_all(workspace.join(\"patches\")).expect(\"create patches dir\");","+        fs::write(workspace.join(\"patches/console-log.patch\"), PATCH).expect(\"write patch file\");","+        append_workspace_yaml_key(&workspace, \"nodeLinker\", format!(\" {node_linker}\"));","+        append_workspace_yaml_key(","+            &workspace,","+            \"patchedDependencies\",","+            format!(\"\\n  '{PATCHED_DEP}': patches/console-log.patch\"),","+        );","+","+        fs::write(","+            workspace.join(\"package.json\"),","+            serde_json::json!({ \"dependencies\": { PATCHED_DEP: \"1.0.0\" } }).to_string(),","+        )","+        .expect(\"write package.json\");","+        pacquet_at(&workspace)","+            .with_args([\"install\", \"--lockfile-only\"])","+            .assert()","+            .success();","+        fs::remove_dir_all(workspace.join(\"patches\")).expect(\"remove patches dir\");","+","+        let output = pacquet_at(&workspace)","+            .with_arg(\"fetch\")","+            .output()","+            .expect(\"run pnpm fetch\");","+","+        assert!(","+            !output.status.success(),","+            \"fetch under {node_linker} must fail without the patch file\",","+        );","+        let stderr = String::from_utf8_lossy(&output.stderr);","+        assert!(stderr.contains(\"ERR_PNPM_PATCH_NOT_FOUND\"), \"stderr: {stderr}\");","+        assert!(stderr.contains(\"Patch file not found\"), \"stderr: {stderr}\");","+        // miette wraps the report at the terminal width, splitting the temp path.","+        let unwrapped: String = stderr","+            .chars()","+            .filter(|&c| !c.is_whitespace() && c != '│')","+            .collect();","+        assert!(unwrapped.contains(\"console-log.patch\"), \"stderr: {stderr}\");","+","+        drop((root, mock_instance));","+    }","+}","+","+/// `nodeLinker: hoisted` has no virtual store, so `fetch` populates only the","+/// CAS store and defers patching and dependency build scripts to the install","+/// that materializes the hoisted tree","+/// ([pnpm/pnpm#18037](https://github.com/pnpm/pnpm/issues/18037)).","+#[test]","+fn fetch_under_hoisted_defers_patches_and_builds_until_offline_install() {","+    const PATCHED_DEP: &str = \"@pnpm.e2e/console-log\";","+    const BUILT_DEP: &str = \"@pnpm.e2e/pre-and-postinstall-scripts-example\";","+    const PATCH: &str = include_str!(","+        \"../../../../../pnpm11/installing/commands/test/__fixtures__/patchedDependencies/console-log-replace-1st-line.patch\"","+    );","+","     let CommandTempCwd { root, workspace, npmrc_info, .. } =","         CommandTempCwd::init().add_mocked_registry();","-    let AddMockedRegistry { mock_instance, .. } = npmrc_info;","+    let AddMockedRegistry { store_dir, mock_instance, .. } = npmrc_info;"," ","     fs::create_dir_all(workspace.join(\"patches\")).expect(\"create patches dir\");","     fs::write(workspace.join(\"patches/console-log.patch\"), PATCH).expect(\"write patch file\");","-    append_workspace_yaml_key(","-        &workspace,","-        \"patchedDependencies\",","-        format!(\"\\n  '{PATCHED_DEP}': patches/console-log.patch\"),","+    let yaml_path = workspace.join(\"pnpm-workspace.yaml\");","+    let yaml = fs::read_to_string(&yaml_path)","+        .expect(\"read pnpm-workspace.yaml\")","+        .replace(\"enableGlobalVirtualStore: false\", \"enableGlobalVirtualStore: true\");","+    fs::write(","+        &yaml_path,","+        format!(","+            \"{yaml}nodeLinker: hoisted\\nallowBuilds:\\n  '{BUILT_DEP}': true\\npatchedDependencies:\\n  '{PATCHED_DEP}': patches/console-log.patch\\n\",","+        ),","+    )","+    .expect(\"write pnpm-workspace.yaml\");","+","+    let manifest = serde_json::json!({","+        \"dependencies\": {","+            PATCHED_DEP: \"1.0.0\",","+            BUILT_DEP: \"1.0.0\",","+        },","+    })","+    .to_string();","+    fs::write(workspace.join(\"package.json\"), &manifest).expect(\"write package.json\");","+    pacquet_at(&workspace)","+        .with_args([\"install\", \"--lockfile-only\"])","+        .assert()","+        .success();","+","+    fs::remove_file(workspace.join(\"package.json\")).expect(\"remove package.json\");","+","+    pacquet_at(&workspace)","+        .with_arg(\"fetch\")","+        .assert()","+        .success();","+","+    assert!(store_dir.join(STORE_VERSION).exists(), \"fetch must populate the CAS store\");","+    assert!(","+        !store_dir","+            .join(STORE_VERSION)","+            .join(\"links\")","+            .exists(),","+        \"hoisted fetch must not populate global virtual store links\",","+    );","+    assert!(","+        !workspace","+            .join(\"node_modules\")","+            .join(PATCHED_DEP)","+            .exists(),","+        \"hoisted fetch must not materialize project node_modules\",","+    );","+    let modules_after_fetch = pnpm_modules_yaml::read_modules_manifest::<pnpm_modules_yaml::Host>(","+        &workspace.join(\"node_modules\"),","+    )","+    .expect(\"read .modules.yaml\")","+    .expect(\"fetch must write .modules.yaml\");","+    assert_eq!(modules_after_fetch.virtual_store_only, Some(true));","+    assert_eq!(modules_after_fetch.hoisted_locations, None);","+","+    fs::write(workspace.join(\"package.json\"), &manifest).expect(\"restore package.json\");","+","+    pacquet_at(&workspace)","+        .with_args([\"install\", \"--offline\", \"--frozen-lockfile\", \"--config.frozen-store=true\"])","+        .assert()","+        .success();","+","+    let patched_index = fs::read_to_string(","+        workspace","+            .join(\"node_modules\")","+            .join(PATCHED_DEP)","+            .join(\"index.js\"),","+    )","+    .expect(\"read patched index.js\");","+    assert!(patched_index.contains(\"FIRST LINE\"), \"patched index.js: {patched_index}\");","+    assert!(","+        workspace","+            .join(\"node_modules\")","+            .join(BUILT_DEP)","+            .join(\"generated-by-postinstall.js\")","+            .exists(),","+        \"offline install must run the approved postinstall script\",","+    );","+    let modules_after_install =","+        pnpm_modules_yaml::read_modules_manifest::<pnpm_modules_yaml::Host>(&workspace.join(","+            \"node_modules\",","+        ))","+        .expect(\"read .modules.yaml\")","+        .expect(\"install must write .modules.yaml\");","+    assert_eq!(modules_after_install.virtual_store_only, None);","+    assert!(modules_after_install.hoisted_locations.is_some());","+","+    drop((root, mock_instance, store_dir));","+}","+","+#[test]","+fn fetch_under_hoisted_preserves_existing_hoisted_locations_and_ignored_builds() {","+    const BUILT_DEP: &str = \"@pnpm.e2e/pre-and-postinstall-scripts-example\";","+    const BUILT_DEP_KEY: &str = \"@pnpm.e2e/pre-and-postinstall-scripts-example@1.0.0\";","+","+    let CommandTempCwd { root, workspace, npmrc_info, .. } =","+        CommandTempCwd::init().add_mocked_registry();","+    let AddMockedRegistry { store_dir, mock_instance, .. } = npmrc_info;","+","+    let yaml_path = workspace.join(\"pnpm-workspace.yaml\");","+    let base_yaml = fs::read_to_string(&yaml_path).expect(\"read pnpm-workspace.yaml\");","+    fs::write(&yaml_path, format!(\"{base_yaml}nodeLinker: hoisted\\nstrictDepBuilds: false\\n\"))","+        .expect(\"write pnpm-workspace.yaml\");","+","+    fs::write(","+        workspace.join(\"package.json\"),","+        serde_json::json!({ \"dependencies\": { BUILT_DEP: \"1.0.0\" } }).to_string(),","+    )","+    .expect(\"write initial package.json\");","+    pacquet_at(&workspace)","+        .with_arg(\"install\")","+        .assert()","+        .success();","+","+    let modules_before_fetch = pnpm_modules_yaml::read_modules_manifest::<pnpm_modules_yaml::Host>(","+        &workspace.join(\"node_modules\"),","+    )","+    .expect(\"read .modules.yaml\")","+    .expect(\"install must write .modules.yaml\");","+    assert!(","+        modules_before_fetch.hoisted_locations","+            .as_ref()","+            .is_some_and(|locations| locations.contains_key(BUILT_DEP_KEY)),","+    );","+    assert_eq!(","+        modules_before_fetch.ignored_builds","+            .as_ref()","+            .map(|ignored| ignored","+                .iter()","+                .map(pnpm_modules_yaml::DepPath::as_str)","+                .collect::<Vec<_>>()),","+        Some(vec![BUILT_DEP_KEY]),","+    );","+    assert!(","+        !workspace","+            .join(\"node_modules\")","+            .join(BUILT_DEP)","+            .join(\"generated-by-postinstall.js\")","+            .exists(),","     );"," ","     fs::write(","         workspace.join(\"package.json\"),","-        serde_json::json!({ \"dependencies\": { PATCHED_DEP: \"1.0.0\" } }).to_string(),","+        serde_json::json!({","+            \"dependencies\": {","+                BUILT_DEP: \"1.0.0\",","+                \"is-positive\": \"1.0.0\",","+            },","+        })","+        .to_string(),","     )","-    .expect(\"write package.json\");","+    .expect(\"write updated package.json\");","     pacquet_at(&workspace)","         .with_args([\"install\", \"--lockfile-only\"])","         .assert()","         .success();","-    fs::remove_dir_all(workspace.join(\"patches\")).expect(\"remove patches dir\");"," ","-    let output = pacquet_at(&workspace)","+    fs::write(","+        &yaml_path,","+        format!(\"{base_yaml}nodeLinker: hoisted\\nallowBuilds:\\n  '{BUILT_DEP}': true\\n\"),","+    )","+    .expect(\"approve build in pnpm-workspace.yaml\");","+","+    pacquet_at(&workspace)","         .with_arg(\"fetch\")","-        .output()","-        .expect(\"run pnpm fetch\");","+        .assert()","+        .success();"," ","-    assert!(!output.status.success(), \"fetch must fail without the patch file\");","-    let stderr = String::from_utf8_lossy(&output.stderr);","-    assert!(stderr.contains(\"ERR_PNPM_PATCH_NOT_FOUND\"), \"stderr: {stderr}\");","-    assert!(stderr.contains(\"Patch file not found\"), \"stderr: {stderr}\");","-    // miette wraps the report at the terminal width, splitting the temp path.","-    let unwrapped: String = stderr","-        .chars()","-        .filter(|&c| !c.is_whitespace() && c != '│')","-        .collect();","-    assert!(unwrapped.contains(\"console-log.patch\"), \"stderr: {stderr}\");","+    assert!(!workspace.join(\"node_modules/is-positive\").exists());","+    assert!(","+        !workspace","+            .join(\"node_modules\")","+            .join(BUILT_DEP)","+            .join(\"generated-by-postinstall.js\")","+            .exists(),","+        \"hoisted fetch must not build an existing package on disk\",","+    );","+    let modules_after_fetch = pnpm_modules_yaml::read_modules_manifest::<pnpm_modules_yaml::Host>(","+        &workspace.join(\"node_modules\"),","+    )","+    .expect(\"read .modules.yaml\")","+    .expect(\"fetch must write .modules.yaml\");","+    assert_eq!(modules_after_fetch.hoisted_locations, modules_before_fetch.hoisted_locations);","+    assert_eq!(modules_after_fetch.ignored_builds, modules_before_fetch.ignored_builds);"," ","-    drop((root, mock_instance));","+    pacquet_at(&workspace)","+        .with_args([\"install\", \"--offline\", \"--frozen-lockfile\"])","+        .assert()","+        .success();","+","+    assert!(workspace.join(\"node_modules/is-positive\").exists());","+    assert!(","+        workspace","+            .join(\"node_modules\")","+            .join(BUILT_DEP)","+            .join(\"generated-by-postinstall.js\")","+            .exists(),","+    );","+    let modules_after_install =","+        pnpm_modules_yaml::read_modules_manifest::<pnpm_modules_yaml::Host>(&workspace.join(","+            \"node_modules\",","+        ))","+        .expect(\"read .modules.yaml\")","+        .expect(\"install must write .modules.yaml\");","+    assert!(","+        modules_after_install.hoisted_locations","+            .as_ref()","+            .is_some_and(|locations| locations.contains_key(\"is-positive@1.0.0\")),","+    );","+    assert_eq!(modules_after_install.ignored_builds, None);","+","+    drop((root, mock_instance, store_dir));"," }"," "," /// An env document pinning pnpm 99.0.0, recorded as the bare `pnpm` package"],"additions":262,"deletions":24,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/build_modules/build_one_snapshot.rs","lines":["@@ -244,6 +244,7 @@ fn reject_frozen_store_build<Reporter: self::Reporter>(","     } = writes;","     if !context.cache.frozen_store","         || !context.directories.layout.enable_global_virtual_store()","+        || context.directories.pkg_roots_by_key.is_some()","         || !(has_patch || should_run_scripts)","     {","         return Ok(false);"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/install_frozen_lockfile/build_phase.rs","lines":["@@ -142,12 +142,18 @@ pub fn run_build_phase<Reporter: self::Reporter>(","         crate::shared_side_effects::shared_side_effects_publisher(config, inputs.graph.importers);"," ","     let bin_state = crate::build_options::BuildBinState::default();","-    let build_output = build_or_defer::<Reporter>(","-        inputs,","-        patches.as_ref(),","-        shared_side_effects_publisher.as_ref(),","-        &bin_state,","-    )?;","+    // `nodeLinker: hoisted` has no virtual store, so `virtual_store_only`","+    // materialized no package directories to patch or build.","+    let build_output = if inputs.directories.is_hoisted && config.virtual_store_only {","+        crate::BuildModulesOutput::default()","+    } else {","+        build_or_defer::<Reporter>(","+            inputs,","+            patches.as_ref(),","+            shared_side_effects_publisher.as_ref(),","+            &bin_state,","+        )?","+    };"," ","     // Always emit the `pnpm:ignored-scripts` event with the package","     // names, unconditionally, so structured / NDJSON consumers always"],"additions":12,"deletions":6,"truncated":false},{"path":"pnpm/crates/deps-restorer/src/linking.rs","lines":["@@ -212,9 +212,15 @@ pub fn run_link_phase<Reporter: self::Reporter>(","     }"," ","     // Everything below writes into the project that `virtual_store_only`","-    // exists to leave alone.","+    // exists to leave alone. Under the hoisted linker there is no virtual","+    // store either, so an empty root map and build list keep downstream","+    // phases from mistaking the run for an isolated one.","     if inputs.ctx.config.virtual_store_only {","-        return Ok(LinkPhaseOutput::empty());","+        return Ok(LinkPhaseOutput {","+            hoisted_pkg_roots_by_key: (!has_virtual_store).then(HashMap::new),","+            hoisted_build_snapshots: (!has_virtual_store).then(Vec::new),","+            ..LinkPhaseOutput::empty()","+        });","     }","     write_project_links::<Reporter>(inputs, skipped, hoist.plan, claimed_importer_bins)"," }"],"additions":8,"deletions":2,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/apply_materialization.rs","lines":["@@ -56,6 +56,7 @@ fn select_apply_state<'a>(inputs: &'a ApplyMaterializationInputs<'_, '_>) -> Mat","         projects: inputs.projects.importers,"," ","         node_linker: inputs.projects.node_linker,","+        virtual_store_only: inputs.completion.config.virtual_store_only,","         workspace_root: &inputs.projects.workspace_root,","         groups: applied_groups(inputs),","         install_skipped: &inputs.materialized.install_skipped,"],"additions":1,"deletions":0,"truncated":false},{"path":"pnpm/crates/package-manager/src/install/apply_materialization/commit.rs","lines":["@@ -75,6 +75,9 @@ fn record_agent_skills(","         next_modules.linked_skills.clone_from(&prior.linked_skills);","         next_modules.has_unlinked_skills = prior.has_unlinked_skills;","     }","+    if inputs.tree.config.virtual_store_only {","+        return Ok(Vec::new());","+    }","     let Some(lockfile) = inputs.lockfiles.materialized else { return Ok(Vec::new()) };","     let linked = inputs.prior.metadata","         .and_then(|modules| modules.linked_skills.as_deref())","@@ -149,10 +152,11 @@ pub(super) fn merge_committed_modules_metadata(","     {","         keep_recorded_layout(next_modules, recorded);","     }","+    let retention = preserve_skipped_hoisted_tree_metadata(inputs, next_modules);","     if let (Some(previous), Some(current), Some(policy)) =","         (inputs.prior.layout, inputs.lockfiles.materialized, allow_build_policy)","     {","-        retain_current_ignored_builds(next_modules, previous, current, policy);","+        retain_current_ignored_builds(next_modules, previous, current, policy, retention);","     }","     if inputs.prior.filtered_install","         && !inputs.prior.is_inconsistent","@@ -162,6 +166,27 @@ pub(super) fn merge_committed_modules_metadata(","         merge_filtered_modules_metadata(next_modules, previous, current, selected);","     }"," }","+","+fn preserve_skipped_hoisted_tree_metadata(","+    inputs: &CommitModulesStateInputs<'_>,","+    next_modules: &mut Modules,","+) -> IgnoredBuildRetention {","+    if !inputs.tree.config.virtual_store_only","+        || inputs.tree.node_linker != pnpm_config::NodeLinker::Hoisted","+    {","+        return IgnoredBuildRetention::SettledByBuildPhase;","+    }","+    if !inputs.prior.is_inconsistent {","+        if let Some(recorded) = inputs.prior.layout {","+            next_mod