hen the module asked for persistent host partitions and was refused.","+  bool persistent_host_partitions_refused_ = false;"," ","   // ----------------------------- Metrics Support -----------------------------","   // The shared registry holding all module-defined metrics.","@@ -130,7 +138,7 @@ class DynamicModuleClusterConfig {"," private:","   DynamicModuleClusterConfig(const std::string& cluster_name, const std::string& cluster_config,","                              Envoy::Extensions::DynamicModules::DynamicModulePtr module,","-                             Stats::Scope& stats_scope);","+                             Stats::Scope& stats_scope, bool persistent_host_partitions_allowed);"," ","   const std::string cluster_name_;","   const std::string cluster_config_;","@@ -258,6 +266,8 @@ class DynamicModuleCluster : public Upstream::ClusterImplBase,"," ","   // The PersistentHostSet at `priority`, created if missing. Only valid with persistent partitions.","   PersistentHostSet& persistentHostSet(uint32_t priority);","+  // Whether the host sets are PersistentHostSet. The factory is fixed once a host set exists.","+  bool usesPersistentHostSets() const;","   // Hands `snapshot`, returned by a PersistentHostSet change, to the priority set with its delta.","   void updateHostsFromSnapshot(uint32_t priority, Upstream::HostSetSnapshotConstSharedPtr snapshot,","                                const Upstream::HostVector& hosts_added,"],"additions":13,"deletions":3,"truncated":false},{"path":"source/extensions/dynamic_modules/abi/abi.h","lines":["@@ -10643,6 +10643,25 @@ void envoy_dynamic_module_callback_cluster_pre_init_complete("," void envoy_dynamic_module_callback_cluster_use_persistent_host_map(","     envoy_dynamic_module_type_cluster_envoy_ptr cluster_envoy_ptr);"," ","+/**","+ * envoy_dynamic_module_callback_cluster_config_use_persistent_host_partitions makes the cluster","+ * keep persistent host partitions, as if its ClusterConfig set use_persistent_host_partitions. This","+ * lets the module choose the host set storage without the cluster's configuration carrying the","+ * field. The same costs apply, so pair it with","+ * envoy_dynamic_module_callback_cluster_use_persistent_host_map.","+ *","+ * This is optional and must be called on the main thread during","+ * envoy_dynamic_module_on_cluster_config_new, before the cluster and its host sets exist. A call","+ * made then off the main thread is reported as a bug. A refusal for the lb_policy is logged.","+ *","+ * @param cluster_config_envoy_ptr is the pointer to the DynamicModuleClusterConfig.","+ * @return true if the cluster will keep persistent host partitions. It returns false on a null","+ * pointer, after envoy_dynamic_module_on_cluster_config_new returned, off the main thread, and","+ * when the cluster's lb_policy is not CLUSTER_PROVIDED.","+ */","+bool envoy_dynamic_module_callback_cluster_config_use_persistent_host_partitions(","+    envoy_dynamic_module_type_cluster_config_envoy_ptr cluster_config_envoy_ptr);","+"," /**","  * envoy_dynamic_module_callback_cluster_lb_get_healthy_host_count returns the number of healthy","  * hosts at the given priority level in the cluster's host set.","@@ -11960,10 +11979,11 @@ bool envoy_dynamic_module_callback_cluster_lb_get_member_update_host_packed_addr","  * envoy_dynamic_module_on_cluster_lb_on_host_membership_update, on the worker thread that runs it.","  *","  * Envoy only knows this when the cluster keeps persistent host partitions, which requires","- * use_persistent_host_partitions in the cluster's ClusterConfig, and no health refresh happened","- * since the previous update. A refresh covers every host, and with an active health checker it","- * precedes a worker's first update. Otherwise it returns false and the module must reread the hosts","- * it tracks.","+ * use_persistent_host_partitions in the cluster's ClusterConfig or a call to","+ * envoy_dynamic_module_callback_cluster_config_use_persistent_host_partitions, and no health","+ * refresh happened since the previous update. A refresh covers every host, and with an active","+ * health checker it precedes a worker's first update. Otherwise it returns false and the module","+ * must reread the hosts it tracks.","  *","  * @param lb_envoy_ptr is the pointer to the Envoy cluster load balancer.","  * @param result receives the count. Its contents are unspecified when the callback returns false."],"additions":24,"deletions":4,"truncated":false},{"path":"source/extensions/dynamic_modules/abi_impl.cc","lines":["@@ -582,6 +582,9 @@ WEAK_STUB_VOID(envoy_dynamic_module_callback_cluster_pre_init_complete,"," WEAK_STUB_VOID(envoy_dynamic_module_callback_cluster_use_persistent_host_map,","                envoy_dynamic_module_type_cluster_envoy_ptr)"," ","+WEAK_STUB(bool, envoy_dynamic_module_callback_cluster_config_use_persistent_host_partitions, false,","+          envoy_dynamic_module_type_cluster_config_envoy_ptr)","+"," WEAK_STUB(size_t, envoy_dynamic_module_callback_cluster_lb_get_healthy_host_count, 0,","           envoy_dynamic_module_type_cluster_lb_envoy_ptr, uint32_t)"," "],"additions":3,"deletions":0,"truncated":false},{"path":"source/extensions/dynamic_modules/sdk/rust/src/cluster.rs","lines":["@@ -1010,6 +1010,15 @@ impl EnvoyResolvedHistogram {"," #[cfg_attr(any(test, feature = \"mock\"), automock)]"," #[allow(clippy::needless_lifetimes)]"," pub trait EnvoyClusterMetrics: Send + Sync {","+  /// Make the cluster keep persistent host partitions, as if its `ClusterConfig` set","+  /// `use_persistent_host_partitions`. The same costs apply, so pair it with","+  /// [`EnvoyCluster::use_persistent_host_map`].","+  ///","+  /// This is optional and must be called during config creation, before the cluster and its host","+  /// sets exist. Returns `false` if called later or if the cluster's `lb_policy` is not","+  /// `CLUSTER_PROVIDED`.","+  fn use_persistent_host_partitions(&self) -> bool;","+","   // -------------------------------------------------------------------------","   // Define metrics (call during config creation).","   // -------------------------------------------------------------------------","@@ -2185,6 +2194,12 @@ fn cluster_metric_result_to_rust("," }"," "," impl EnvoyClusterMetrics for EnvoyClusterMetricsImpl {","+  fn use_persistent_host_partitions(&self) -> bool {","+    unsafe {","+      abi::envoy_dynamic_module_callback_cluster_config_use_persistent_host_partitions(self.raw)","+    }","+  }","+","   fn define_counter(","     &self,","     name: &str,","@@ -3525,6 +3540,19 @@ mod tests {","     );","   }"," ","+  // The stub in `lib_test.rs` accepts any non-null config.","+  #[test]","+  fn use_persistent_host_partitions_forwards_to_envoy() {","+    let config = EnvoyClusterMetricsImpl {","+      raw: 0x1 as abi::envoy_dynamic_module_type_cluster_config_envoy_ptr,","+    };","+    assert!(config.use_persistent_host_partitions());","+    let null_config = EnvoyClusterMetricsImpl {","+      raw: std::ptr::null_mut(),","+    };","+    assert!(!null_config.use_persistent_host_partitions());","+  }","+","   // The stubs in `lib_test.rs` report two health-changed hosts for a null load balancer and an","   // unknown count for any other.","   #[test]"],"additions":28,"deletions":0,"truncated":false},{"path":"source/extensions/dynamic_modules/sdk/rust/src/lib_test.rs","lines":["@@ -6431,6 +6431,13 @@ pub extern \"C\" fn envoy_dynamic_module_callback_cluster_use_persistent_host_map("," ) {"," }"," ","+#[no_mangle]","+pub extern \"C\" fn envoy_dynamic_module_callback_cluster_config_use_persistent_host_partitions(","+  cluster_config_envoy_ptr: abi::envoy_dynamic_module_type_cluster_config_envoy_ptr,","+) -> bool {","+  !cluster_config_envoy_ptr.is_null()","+}","+"," #[no_mangle]"," pub extern \"C\" fn envoy_dynamic_module_callback_cluster_update_host_health(","   _cluster_envoy_ptr: abi::envoy_dynamic_module_type_cluster_envoy_ptr,"],"additions":7,"deletions":0,"truncated":false},{"path":"test/extensions/clusters/dynamic_modules/BUILD","lines":["@@ -99,6 +99,7 @@ envoy_extension_cc_dyn_module_test(","         \"//source/extensions/filters/http/dynamic_modules:factory_registration\",","         \"//source/extensions/load_balancing_policies/cluster_provided:config\",","         \"//source/extensions/transport_sockets/tls:config\",","+        \"//test/config:utility_lib\",","         \"//test/extensions/dynamic_modules:util\",","         \"//test/integration:http_integration_lib\",","         \"//test/test_common:logging_lib\",","@@ -106,6 +107,7 @@ envoy_extension_cc_dyn_module_test(","         \"@envoy_api//envoy/config/bootstrap/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/config/cluster/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/extensions/clusters/dynamic_modules/v3:pkg_cc_proto\",","+        \"@envoy_api//envoy/extensions/filters/network/http_connection_manager/v3:pkg_cc_proto\",","         \"@envoy_api//envoy/extensions/transport_sockets/tls/v3:pkg_cc_proto\",","     ],"," )"],"additions":2,"deletions":0,"truncated":false},{"path":"test/extensions/clusters/dynamic_modules/cluster_test.cc","lines":["@@ -5542,6 +5542,60 @@ TEST_F(DynamicModuleClusterPersistentPartitionsTest, HealthUpdateForForeignHost)","   EXPECT_EQ(1, cluster->prioritySet().hostSetsPerPriority()[0]->hostCounts().healthy);"," }"," ","+// The module opts the cluster in from on_cluster_config_new, without the config field.","+TEST_F(DynamicModuleClusterPersistentPartitionsTest, ModuleOptInDuringConfigNew) {","+  auto result = createCluster(makeYamlConfig(\"cluster_no_op\", \"use_persistent_host_partitions\"));","+  ASSERT_TRUE(result.ok()) << result.status().message();","+  auto cluster = std::dynamic_pointer_cast<DynamicModuleCluster>(result->first);","+  clusters_.push_back(std::move(*result));","+","+  EXPECT_EQ(reinterpret_cast<envoy_dynamic_module_type_cluster_config_module_ptr>(0x5),","+            cluster->config()->in_module_config_);","+  EXPECT_TRUE(cluster->config()->use_persistent_host_partitions_);","+  EXPECT_TRUE(isPersistent(*cluster->prioritySet().hostSetsPerPriority()[0]));","+  std::vector<Upstream::HostSharedPtr> hosts;","+  ASSERT_TRUE(addSimpleHosts(*cluster, {\"127.0.0.1:10001\"}, {1}, hosts, 1));","+  EXPECT_TRUE(isPersistent(*cluster->prioritySet().hostSetsPerPriority()[1]));","+  EXPECT_NE(nullptr, cluster->prioritySet().hostSetsPerPriority()[1]->snapshot());","+}","+","+// The host sets exist once on_cluster_config_new returns, so a later request is refused.","+TEST_F(DynamicModuleClusterPersistentPartitionsTest, ModuleOptInAfterConfigNewIsRefused) {","+  auto cluster = createDecCluster();","+  EXPECT_FALSE(envoy_dynamic_module_callback_cluster_config_use_persistent_host_partitions(","+      cluster->config().get()));","+  EXPECT_FALSE(","+      envoy_dynamic_module_callback_cluster_config_use_persistent_host_partitions(nullptr));","+  EXPECT_FALSE(cluster->config()->use_persistent_host_partitions_);","+  EXPECT_FALSE(isPersistent(*cluster->prioritySet().hostSetsPerPriority()[0]));","+}","+","+// Native load balancing policies read the flat host vectors on every update, so the module's","+// request is refused and the cluster keeps flat host sets.","+TEST_F(DynamicModuleClusterPersistentPartitionsTest, ModuleOptInRefusedForNativeLbPolicy) {","+  const std::string yaml = R\"EOF(","+name: test_cluster","+connect_timeout: 0.25s","+lb_policy: ROUND_ROBIN","+cluster_type:","+  name: envoy.clusters.dynamic_modules","+  typed_config:","+    \"@type\": type.googleapis.com/envoy.extensions.clusters.dynamic_modules.v3.ClusterConfig","+    dynamic_module_config:","+      name: cluster_no_op","+    cluster_name: use_persistent_host_partitions","+)EOF\";","+  auto result = createCluster(yaml);","+  ASSERT_TRUE(result.ok()) << result.status().message();","+  auto cluster = std::dynamic_pointer_cast<DynamicModuleCluster>(result->first);","+  clusters_.push_back(std::move(*result));","+","+  EXPECT_EQ