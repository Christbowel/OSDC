uster_type()->mutable_typed_config()->PackFrom(dec_config);","+    return cluster;","+  }","+","+  // Writes the cluster and waits until Envoy has applied this CDS update, without waiting for the","+  // cluster to warm or for its posted host churn to run.","+  void pushCluster(uint32_t generation) {","+    const uint64_t applied = test_server_->counter(\"cluster_manager.cds.update_success\")->value();","+    cds_helper_.setCds({decCluster(generation)});","+    test_server_->waitForCounter(\"cluster_manager.cds.update_success\", testing::Ge(applied + 1));","+  }","+","+  void removeCluster() {","+    const uint64_t applied = test_server_->counter(\"cluster_manager.cds.update_success\")->value();","+    cds_helper_.setCds({});","+    test_server_->waitForCounter(\"cluster_manager.cds.update_success\", testing::Ge(applied + 1));","+  }","+","+  void initializeWithCds() {","+    TestEnvironment::setEnvVar(","+        \"ENVOY_DYNAMIC_MODULES_SEARCH_PATH\",","+        TestEnvironment::runfilesPath(\"test/extensions/dynamic_modules/test_data/rust\"), 1);","+    autonomous_upstream_ = true;","+    config_helper_.addConfigModifier([this](envoy::config::bootstrap::v3::Bootstrap& bootstrap) {","+      bootstrap.mutable_dynamic_resources()->mutable_cds_config()->set_resource_api_version("],"additions":86,"deletions":1,"truncated":false}],"additions":280,"deletions":25,"truncated":true,"file_count":12},"error":null,"fetched_at":"2026-11-03T16:48:46.225346+00:00"}