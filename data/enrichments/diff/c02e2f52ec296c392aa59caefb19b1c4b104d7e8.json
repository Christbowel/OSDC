{"id":"c02e2f52ec296c392aa59caefb19b1c4b104d7e8","axis":"silent","repo":"tensorflow/tensorflow","sha":"c02e2f52ec296c392aa59caefb19b1c4b104d7e8","parsed":{"files":[{"path":"third_party/xla/xla/backends/gpu/transforms/BUILD","lines":["@@ -136,6 +136,45 @@ xla_cc_test(","     ],"," )"," ","+cc_library(","+    name = \"config_aware_cse\",","+    srcs = [\"config_aware_cse.cc\"],","+    hdrs = [\"config_aware_cse.h\"],","+    deps = [","+        \"//xla:status_macros\",","+        \"//xla/codegen/tiling:tiling_space\",","+        \"//xla/codegen/xtile:xtile_config_proto_cc\",","+        \"//xla/hlo/ir:hlo\",","+        \"//xla/hlo/pass:hlo_pass\",","+        \"//xla/hlo/utils:hlo_traversal\",","+        \"//xla/service:hlo_cse\",","+        \"//xla/service/gpu:backend_configs_cc\",","+        \"//xla/service/gpu:gpu_fusible\",","+        \"@com_google_absl//absl/container:flat_hash_map\",","+        \"@com_google_absl//absl/container:flat_hash_set\",","+        \"@com_google_absl//absl/status:status_macros\",","+        \"@com_google_absl//absl/status:statusor\",","+        \"@com_google_absl//absl/strings:string_view\",","+        \"@llvm-project//mlir:IR\",","+    ],","+)","+","+xla_cc_test(","+    name = \"config_aware_cse_test\",","+    srcs = [\"config_aware_cse_test.cc\"],","+    deps = [","+        \":config_aware_cse\",","+        \"//xla/codegen/xtile:xtile_config_proto_cc\",","+        \"//xla/hlo/ir:hlo\",","+        \"//xla/hlo/testlib:hlo_hardware_independent_test_base\",","+        \"//xla/service/gpu:backend_configs_cc\",","+        \"@com_google_absl//absl/status:status_matchers\",","+        \"@com_google_absl//absl/strings:string_view\",","+        \"@com_google_googletest//:gtest_main\",","+        \"@llvm-project//mlir:IR\",","+    ],","+)","+"," cc_library(","     name = \"conv_canonicalizer\",","     srcs = [\"conv_canonicalizer.cc\"],","@@ -269,7 +308,6 @@ cc_library(","         \"//xla:xla_data_proto_cc\",","         \"//xla:xla_proto_cc\",","         \"//xla/backends/gpu/codegen/triton:support\",","-        \"//xla/codegen/tiling:tile\",","         \"//xla/codegen/tiling:tiling_util\",","         \"//xla/hlo/ir:hlo\",","         \"//xla/hlo/pass:hlo_pass\",","@@ -279,7 +317,6 @@ cc_library(","         \"//xla/service:instruction_fusion\",","         \"//xla/service:pattern_matcher\",","         \"//xla/service/gpu:backend_configs_cc\",","-        \"//xla/service/gpu:gpu_fusible\",","         \"//xla/service/gpu:hlo_fusion_analysis\",","         \"//xla/service/gpu:ir_emission_utils\",","         \"//xla/service/gpu:mlir_context_pool\","],"additions":39,"deletions":2,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/transforms/config_aware_cse.cc","lines":["@@ -0,0 +1,135 @@","+/* Copyright 2026 The OpenXLA Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+==============================================================================*/","+","+#include \"xla/backends/gpu/transforms/config_aware_cse.h\"","+","+#include <cstdint>","+#include <memory>","+#include <utility>","+#include <vector>","+","+#include \"absl/container/flat_hash_map.h\"","+#include \"absl/container/flat_hash_set.h\"","+#include \"absl/status/status_macros.h\"","+#include \"absl/status/statusor.h\"","+#include \"absl/strings/string_view.h\"","+#include \"mlir/IR/MLIRContext.h\"","+#include \"xla/codegen/tiling/tiling_space.h\"","+#include \"xla/codegen/xtile/xtile_config.pb.h\"","+#include \"xla/hlo/ir/hlo_computation.h\"","+#include \"xla/hlo/ir/hlo_instruction.h\"","+#include \"xla/hlo/ir/hlo_module.h\"","+#include \"xla/hlo/utils/hlo_traversal.h\"","+#include \"xla/service/gpu/backend_configs.pb.h\"","+#include \"xla/service/gpu/gpu_fusible.h\"","+#include \"xla/service/hlo_cse.h\"","+#include \"xla/status_macros.h\"","+","+namespace xla {","+namespace gpu {","+namespace {","+","+// A sequential dimension: the unique ID of the instruction that defines it and","+// its position in that instruction's dimensions.","+using SequentialDim = std::pair<int64_t, int64_t>;","+","+// Returns the sequential dimensions of `fusion`'s tiling space, in order.","+absl::StatusOr<std::vector<SequentialDim>> GetSequentialDims(","+    const HloInstruction& fusion, mlir::MLIRContext* mlir_context) {","+  ABSL_ASSIGN_OR_RETURN(","+      std::unique_ptr<TilingSpace> tiling_space,","+      TilingSpace::Create(*HloFusionAdaptor::ForInstruction(&fusion),","+                          mlir_context));","+  std::vector<SequentialDim> dims;","+  for (const TilingSpace::DimensionInfo& dim : tiling_space->dimensions()) {","+    if (dim.type == TilingSpace::DimensionSemantics::kSequential) {","+      dims.push_back({dim.hlo->unique_id(), dim.dim_position});","+    }","+  }","+  return dims;","+}","+","+}  // namespace","+","+absl::StatusOr<bool> ConfigAwareCSE::RunImpl(","+    HloModule* module,","+    const absl::flat_hash_set<absl::string_view>& execution_threads) {","+  // CSE keeps one of the instructions it merges, so only fusions with more than","+  // one sequential dimension can lose one. CSE only removes instructions from","+  // fusion computations, so fusions and the remaining instructions keep their","+  // IDs, which are unique in the module.","+  absl::flat_hash_map<SequentialDim, int64_t> tile_sizes;","+  std::vector<std::pair<HloInstruction*, int64_t>> instruction_counts;","+  for (HloComputation* computation :","+       module->MakeNonfusionComputations(execution_threads)) {","+    for (HloInstruction* instr : computation->instructions()) {","+      if (!IsGenericTritonFusion(*instr)) {","+        continue;","+      }","+      ABSL_ASSIGN_OR_RETURN(GpuBackendConfig config,","+                       instr->backend_config<GpuBackendConfig>());","+      const auto& sizes = config.fusion_backend_config()","+                              .block_level_fusion_config()","+                              .sequential_tile_sizes();","+      if (sizes.size() <= 1) {","+        continue;","+      }","+      ABSL_ASSIGN_OR_RETURN(std::vector<SequentialDim> dims,","+                       GetSequentialDims(*instr, mlir_context_));","+      TF_RET_CHECK(dims.size() == sizes.size());","+      instruction_counts.push_back(","+          {instr,","+           instr->fused_instructions_computation()->instruction_count()});","+      for (int i = 0; i < dims.size(); ++i) {","+        tile_sizes[dims[i]] = sizes[i];","+      }","+    }","+  }","+","+  ABSL_ASSIGN_OR_RETURN(bool changed, HloCSE(/*is_layout_sensitive=*/true,","+                                        /*ignore_control_dependencies=*/false,","+                                        /*should_eliminate_computation=*/","+                                        &HloComputation::IsFusionComputation)","+                                     .Run(module, execution_threads));","+  if (!changed) {","+    return false;","+  }","+","+  // Keep the tile sizes of the sequential dimensions that CSE didn't remove.","+  for (auto& [fusion, instruction_count] : instruction_counts) {","+    if (fusion->fused_instructions_computation()->instruction_count() ==","+        instruction_count) {","+      continue;","+    }","+    ABSL_ASSIGN_OR_RETURN(std::vector<SequentialDim> dims,","+                     GetSequentialDims(*fusion, mlir_context_));","+    ABSL_ASSIGN_OR_RETURN(GpuBackendConfig config,","+                     fusion->backend_config<GpuBackendConfig>());","+    auto* sizes = config.mutable_fusion_backend_config()","+                      ->mutable_block_level_fusion_config()","+                      ->mutable_sequential_tile_sizes();","+    sizes->Clear();","+    for (const SequentialDim& dim : dims) {","+      auto it = tile_sizes.find(dim);","+      TF_RET_CHECK(it != tile_sizes.end());","+      sizes->Add(it->second);","+    }","+    ABSL_RETURN_IF_ERROR(fusion->set_backend_config(config));","+  }","+  return true;","+}","+","+}  // namespace gpu","+}  // namespace xla"],"additions":135,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/transforms/config_aware_cse.h","lines":["@@ -0,0 +1,55 @@","+/* Copyright 2026 The OpenXLA Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+==============================================================================*/","+","+#ifndef XLA_BACKENDS_GPU_TRANSFORMS_CONFIG_AWARE_CSE_H_","+#define XLA_BACKENDS_GPU_TRANSFORMS_CONFIG_AWARE_CSE_H_","+","+#include \"absl/container/flat_hash_set.h\"","+#include \"absl/status/statusor.h\"","+#include \"absl/strings/string_view.h\"","+#include \"mlir/IR/MLIRContext.h\"","+#include \"xla/hlo/ir/hlo_module.h\"","+#include \"xla/hlo/pass/hlo_pass_interface.h\"","+","+namespace xla {","+namespace gpu {","+","+// Runs HloCSE on fusion computations and drops the `sequential_tile_sizes` of","+// Triton fusions whose sequential dimensions CSE removed, e.g. by merging","+// reduces that producer fusion duplicated into a scan fusion.","+//","+// TODO(b/538986250): This is a temporary workaround until the new generic","+// config is available. Then this pass should be removed and HloCSE be used","+// directly again.","+class ConfigAwareCSE : public HloModulePass {","+ public:","+  explicit ConfigAwareCSE(mlir::MLIRContext* mlir_context)","+      : mlir_context_(mlir_context) {}","+","+  absl::string_view name() const override { return \"config-aware-cse\"; }","+","+ protected:","+  absl::StatusOr<bool> RunImpl(","+      HloModule* module,","+      const absl::flat_hash_set<absl::string_view>& execution_threads) override;","+","+ private:","+  mlir::MLIRContext* mlir_context_;","+};","+","+}  // namespace gpu","+}  // namespace xla","+","+#endif  // XLA_BACKENDS_GPU_TRANSFORMS_CONFIG_AWARE_CSE_H_"],"additions":55,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/transforms/config_aware_cse_test.cc","lines":["@@ -0,0 +1,213 @@","+/* Copyright 2026 The OpenXLA Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+==============================================================================*/","+","+#include \"xla/backends/gpu/transforms/config_aware_cse.h\"","+","+#include <memory>","+","+#include <gmock/gmock.h>","+#include <gtest/gtest.h>","+#include \"absl/status/status_matchers.h\"","+#include \"absl/strings/string_view.h\"","+#include \"mlir/IR/MLIRContext.h\"","+#include \"xla/codegen/xtile/xtile_config.pb.h\"","+#include \"xla/hlo/ir/hlo_instruction.h\"","+#include \"xla/hlo/ir/hlo_module.h\"","+#include \"xla/hlo/testlib/hlo_hardware_independent_test_base.h\"","+#include \"xla/service/gpu/backend_configs.pb.h\"","+","+namespace xla {","+namespace gpu {","+namespace {","+","+using ::absl_testing::IsOkAndHolds;","+using ::testing::ElementsAre;","+","+using ConfigAwareCSETest = HloHardwareIndependentTestBase;","+","+TEST_F(ConfigAwareCSETest, DropsTileSizesOfMergedReducesInScanFusion) {","+  // The sequential dimensions are the scan dimension and one per reduce.","+  constexpr absl::string_view kHloText = R\"(","+scan_combiner {","+  in = f32[8]{0} parameter(0)","+  carry = f32[8]{0} parameter(1)","+  add = f32[8]{0} add(carry, in)","+  ROOT t = (f32[8]{0}, f32[8]{0}) tuple(add, add)","+}","+","+add {","+  p0 = f32[] parameter(0)","+  p1 = f32[] parameter(1)","+  ROOT add = f32[] add(p0, p1)","+}","+","+fused_scan {","+  input = f32[8,16]{1,0} parameter(0)","+  init = f32[8]{0} parameter(1)","+  zero = f32[] constant(0)","+  reduce.0 = f32[8]{0} reduce(input, zero), dimensions={1}, to_apply=add","+  reduce.1 = f32[8]{0} reduce(input, zero), dimensions={1}, to_apply=add","+  sum = f32[8]{0} add(reduce.0, reduce.1)","+  bcast = f32[8,16]{1,0} broadcast(sum), dimensions={0}","+  scan = (f32[8,16]{1,0}, f32[8]{0}) scan(bcast, init), dimensions={1},","+    num_carries=1, to_apply=scan_combiner, is_associative=true","+  ROOT gte = f32[8,16]{1,0} get-tuple-element(scan), index=0","+}","+","+ENTRY entry {","+  input = f32[8,16]{1,0} parameter(0)","+  init = f32[8]{0} parameter(1)","+  ROOT fusion = f32[8,16]{1,0} fusion(input, init), kind=kCustom,","+    calls=fused_scan,","+    backend_config={\"fusion_backend_config\":{\"kind\":\"__triton\",","+      \"block_level_fusion_config\":{\"output_tiles\":[{\"sizes\":[\"1\"]}],","+        \"sequential_tile_sizes\":[\"4\",\"8\",\"8\"],","+        \"num_warps\":4,\"num_ctas\":1,\"num_stages\":1}}}","+})\";","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> module,","+                       ParseAndReturnVerifiedModule(kHloText));","+  mlir::MLIRContext mlir_context;","+","+  EXPECT_THAT(ConfigAwareCSE(&mlir_context).Run(module.get()),","+              IsOkAndHolds(true));","+","+  const HloInstruction* fusion =","+      module->entry_computation()->root_instruction();","+  EXPECT_EQ(fusion->fused_instructions_computation()->instruction_count(), 8);","+  ASSERT_OK_AND_ASSIGN(GpuBackendConfig config,","+                       fusion->backend_config<GpuBackendConfig>());","+  EXPECT_THAT(config.fusion_backend_config()","+                  .block_level_fusion_config()","+                  .sequential_tile_sizes(),","+              ElementsAre(4, 8));","+}","+","+TEST_F(ConfigAwareCSETest, KeepsTileSizesIfCSEChangesNothing) {","+  constexpr absl::string_view kHloText = R\"(","+scan_combiner {","+  in = f32[8]{0} parameter(0)","+  carry = f32[8]{0} parameter(1)","+  add = f32[8]{0} add(carry, in)","+  ROOT t = (f32[8]{0}, f32[8]{0}) tuple(add, add)","+}","+","+add {","+  p0 = f32[] parameter(0)","+  p1 = f32[] parameter(1)","+  ROOT add = f32[] add(p0, p1)","+}","+","+fused_scan {","+  input = f32[8,16]{1,0} parameter(0)","+  init = f32[8]{0} parameter(1)","+  zero = f32[] constant(0)","+  reduce = f32[8]{0} reduce(input, zero), dimensions={1}, to_apply=add","+  bcast = f32[8,16]{1,0} broadcast(reduce), dimensions={0}","+  scan = (f32[8,16]{1,0}, f32[8]{0}) scan(bcast, init), dimensions={1},","+    num_carries=1, to_apply=scan_combiner, is_associative=true","+  ROOT gte = f32[8,16]{1,0} get-tuple-element(scan), index=0","+}","+","+ENTRY entry {","+  input = f32[8,16]{1,0} parameter(0)","+  init = f32[8]{0} parameter(1)","+  ROOT fusion = f32[8,16]{1,0} fusion(input, init), kind=kCustom,","+    calls=fused_scan,","+    backend_config={\"fusion_backend_config\":{\"kind\":\"__triton\",","+      \"block_level_fusion_config\":{\"output_tiles\":[{\"sizes\":[\"1\"]}],","+        \"sequential_tile_sizes\":[\"4\",\"8\"],","+        \"num_warps\":4,\"num_ctas\":1,\"num_stages\":1}}}","+})\";","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> module,","+                       ParseAndReturnVerifiedModule(kHloText));","+  mlir::MLIRContext mlir_context;","+","+  EXPECT_THAT(ConfigAwareCSE(&mlir_context).Run(module.get()),","+              IsOkAndHolds(false));","+","+  ASSERT_OK_AND_ASSIGN(GpuBackendConfig config,","+                       module->entry_computation()","+                           ->root_instruction()","+                           ->backend_config<GpuBackendConfig>());","+  EXPECT_THAT(config.fusion_backend_config()","+                  .block_level_fusion_config()","+                  .sequential_tile_sizes(),","+              ElementsAre(4, 8));","+}","+","+// Different fusion computations can have instructions with the same local IDs.","+TEST_F(ConfigAwareCSETest, KeepsTileSizesOfEachFusion) {","+  constexpr absl::string_view kHloText = R\"(","+add {","+  p0 = f32[] parameter(0)","+  p1 = f32[] parameter(1)","+  ROOT add = f32[] add(p0, p1)","+}","+","+fused_a {","+  p = f32[8,16]{1,0} parameter(0)","+  zero = f32[] constant(0)","+  reduce.0 = f32[8]{0} reduce(p, zero), dimensions={1}, to_apply=add","+  reduce.1 = f32[8]{0} reduce(p, zero), dimensions={1}, to_apply=add","+  ROOT sum = f32[8]{0} add(reduce.0, reduce.1)","+}","+","+fused_b {","+  p = f32[8,16]{1,0} parameter(0)","+  zero = f32[] constant(0)","+  reduce.0 = f32[8]{0} reduce(p, zero), dimensions={1}, to_apply=add","+  reduce.1 = f32[8]{0} reduce(p, zero), dimensions={1}, to_apply=add","+  ROOT sum = f32[8]{0} add(reduce.0, reduce.1)","+}","+","+ENTRY entry {","+  p = f32[8,16]{1,0} parameter(0)","+  a = f32[8]{0} fusion(p), kind=kCustom, calls=fused_a,","+    backend_config={\"fusion_backend_config\":{\"kind\":\"__triton\",","+      \"block_level_fusion_config\":{\"output_tiles\":[{\"sizes\":[\"1\"]}],","+        \"sequential_tile_sizes\":[\"4\",\"4\"],","+        \"num_warps\":4,\"num_ctas\":1,\"num_stages\":1}}}","+  b = f32[8]{0} fusion(p), kind=kCustom, calls=fused_b,","+    backend_config={\"fusion_backend_config\":{\"kind\":\"__triton\",","+      \"block_level_fusion_config\":{\"output_tiles\":[{\"sizes\":[\"1\"]}],","+        \"sequential_tile_sizes\":[\"8\",\"8\"],","+        \"num_warps\":4,\"num_ctas\":1,\"num_stages\":1}}}","+  ROOT t = (f32[8]{0}, f32[8]{0}) tuple(a, b)","+})\";","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> module,","+                       ParseAndReturnVerifiedModule(kHloText));","+  mlir::MLIRContext mlir_context;","+","+  EXPECT_THAT(ConfigAwareCSE(&mlir_context).Run(module.get()),","+              IsOkAndHolds(true));","+","+  const HloInstruction* root = module->entry_computation()->root_instruction();","+  ASSERT_OK_AND_ASSIGN(GpuBackendConfig config_a,","+                       root->operand(0)->backend_config<GpuBackendConfig>());","+  EXPECT_THAT(config_a.fusion_backend_config()","+                  .block_level_fusion_config()","+                  .sequential_tile_sizes(),","+              ElementsAre(4));","+  ASSERT_OK_AND_ASSIGN(GpuBackendConfig config_b,","+                       root->operand(1)->backend_config<GpuBackendConfig>());","+  EXPECT_THAT(config_b.fusion_backend_config()","+                  .block_level_fusion_config()","+                  .sequential_tile_sizes(),","+              ElementsAre(8));","+}","+","+}  // namespace","+}  // namespace gpu","+}  // namespace xla"],"additions":213,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/transforms/fusion_block_level_rewriter.cc","lines":["@@ -33,7 +33,6 @@ limitations under the License."," #include \"llvm/Support/MathExtras.h\""," #include \"mlir/IR/MLIRContext.h\""," #include \"xla/backends/gpu/codegen/triton/support.h\"","-#include \"xla/codegen/tiling/tiling_space.h\""," #include \"xla/codegen/tiling/tiling_util.h\""," #include \"xla/hlo/ir/hlo_casting_utils.h\""," #include \"xla/hlo/ir/hlo_computation.h\"","@@ -44,7 +43,6 @@ limitations under the License."," #include \"xla/hlo/utils/hlo_trave