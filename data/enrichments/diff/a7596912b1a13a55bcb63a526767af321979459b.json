e::FlushCommit(bool sync_now) {"," \t\twal_sync_offset = wal.FlushMarker();"," \t}"," \tstate = WALCommitState::FLUSHED;","+\t// checkpoints whose bound is past the commit include the blocks of its optimistically written row groups","+\tauto &block_manager = storage.GetBlockManager();","+\tfor (auto &entry : optimistically_written_data) {","+\t\tfor (auto &rg_entry : entry.second) {","+\t\t\tif (rg_entry.second.row_group_data) {","+\t\t\t\tfor (auto &block_id : rg_entry.second.row_group_data->GetBlockIds()) {","+\t\t\t\t\tblock_manager.MarkBlockAsCommitted(block_id, commit_id);","+\t\t\t\t}","+\t\t\t}","+\t\t}","+\t}"," \treturn wal_sync_offset;"," }"," "],"additions":13,"deletions":2,"truncated":false},{"path":"src/storage/table/column_data_checkpointer.cpp","lines":["@@ -6,6 +6,7 @@"," #include \"duckdb/main/settings.hpp\""," #include \"duckdb/logging/log_manager.hpp\""," #include \"duckdb/parser/column_definition.hpp\"","+#include \"duckdb/storage/partial_block_manager.hpp\""," #include \"duckdb/storage/storage_manager.hpp\""," #include \"duckdb/storage/table/data_table_info.hpp\""," #include \"duckdb/storage/table/scan_state.hpp\"","@@ -422,6 +423,10 @@ void ColumnDataCheckpointer::Checkpoint() {"," \tif (!has_changes) {"," \t\t// Nothing has undergone any changes, no need to checkpoint"," \t\t// just move on to finalizing","+\t\tif (checkpoint_info.GetPartialBlockManager().GetPartialBlockType() == PartialBlockType::APPEND_TO_TABLE) {","+\t\t\t// an optimistic write: its blocks stay newly used until its commit","+\t\t\treturn;","+\t\t}"," \t\t// mark block ids as checkpointed"," \t\tCheckpointBlockIdMarker marker(storage_manager.GetBlockManager());"," \t\tfor (idx_t i = 0; i < checkpoint_states.size(); i++) {"],"additions":5,"deletions":0,"truncated":false},{"path":"src/storage/write_ahead_log.cpp","lines":["@@ -494,12 +494,6 @@ void WriteAheadLog::WriteRowGroupData(const PersistentCollectionData &data) {"," \tWriteAheadLogSerializer serializer(*this, WALType::ROW_GROUP_DATA);"," \tserializer.WriteProperty(101, \"row_group_data\", data);"," \tserializer.End();","-","-\t// mark written blocks as checkpointed","-\tauto &block_manager = GetDatabase().GetStorageManager().GetBlockManager();","-\tfor (auto &block_id : data.GetBlockIds()) {","-\t\tblock_manager.MarkBlockAsCheckpointed(block_id);","-\t}"," }"," "," void WriteAheadLog::WriteDelete(DataChunk &chunk) {"],"additions":0,"deletions":6,"truncated":false},{"path":"src/transaction/duck_transaction.cpp","lines":["@@ -302,7 +302,7 @@ ErrorData DuckTransaction::Commit(AttachedDatabase &db, CommitInfo &commit_info,"," \t\t\t// transaction there is nothing to share the sync with, so sync now under the transaction lock;"," \t\t\t// otherwise only write the marker and sync once the locks are released"," \t\t\tbool sync_now = commit_info.active_transactions == ActiveTransactionState::NO_OTHER_TRANSACTIONS;","-\t\t\tcommit_info.wal_sync_offset = commit_state->FlushCommit(sync_now);","+\t\t\tcommit_info.wal_sync_offset = commit_state->FlushCommit(commit_info.commit_id, sync_now);"," \t\t}"," \t\tdrop_state.FinalizeCommit();"," \t\treturn ErrorData();"],"additions":1,"deletions":1,"truncated":false},{"path":"test/sql/storage/concurrent_checkpoint_optimistic_commit.test_slow","lines":["@@ -0,0 +1,91 @@","+# name: test/sql/storage/concurrent_checkpoint_optimistic_commit.test_slow","+# description: Blocks an optimistic insert logs to the WAL during a checkpoint are free in that checkpoint's header","+# group: [storage]","+","+load {TEST_DIR}/concurrent_checkpoint_optimistic_commit.db","+","+statement ok","+SET checkpoint_threshold='1TB'","+","+statement ok","+PRAGMA disable_checkpoint_on_shutdown","+","+statement ok","+SET debug_verify_blocks=true","+","+statement ok","+CREATE TABLE t (i INTEGER, s VARCHAR);","+","+statement ok","+INSERT INTO t SELECT i, 'x' || i FROM range(1000) t(i);","+","+statement ok","+CHECKPOINT","+","+statement ok","+SET debug_checkpoint_sleep_ms=3000","+","+concurrentloop threadid 0 3","+","+onlyif threadid=2","+statement ok","+BEGIN TRANSACTION","+","+onlyif threadid=2","+query I","+SELECT COUNT(*) FROM t","+----","+1000","+","+sleep 500 millisecond","+","+onlyif threadid=0","+statement ok","+INSERT INTO t VALUES (-1, 'pre')","+","+onlyif threadid=0","+statement ok","+CHECKPOINT","+","+sleep 1000 millisecond","+","+# an insert large enough to be written optimistically commits after the checkpoint's bound, before its header","+onlyif threadid=1","+statement ok","+INSERT INTO t SELECT i, repeat('y', 50) || i FROM range(500000) t(i)","+","+sleep 4000 millisecond","+","+onlyif threadid=2","+statement ok","+COMMIT","+","+endloop","+","+statement ok","+SET debug_checkpoint_sleep_ms=0","+","+restart","+","+statement ok","+PRAGMA disable_checkpoint_on_shutdown","+","+statement ok","+SET debug_verify_blocks=true","+","+query I","+SELECT COUNT(*) FROM t","+----","+501001","+","+statement ok","+INSERT INTO t VALUES (-2, 'post')","+","+statement ok","+CHECKPOINT","+","+statement ok","+DELETE FROM t WHERE i >= 0 AND s LIKE 'y%'","+","+statement ok","+CHECKPOINT"],"additions":91,"deletions":0,"truncated":false},{"path":"test/sql/storage/concurrent_checkpoint_optimistic_commit_failure.test_slow","lines":["@@ -0,0 +1,123 @@","+# name: test/sql/storage/concurrent_checkpoint_optimistic_commit_failure.test_slow","+# description: An optimistic insert that fails to commit during a checkpoint does not leak or share its blocks","+# group: [storage]","+","+load {TEST_DIR}/concurrent_checkpoint_optimistic_commit_failure.db","+","+statement ok","+SET checkpoint_threshold='1TB'","+","+statement ok","+PRAGMA disable_checkpoint_on_shutdown","+","+statement ok","+SET debug_verify_blocks=true","+","+statement ok","+CREATE TABLE t (i INTEGER, s VARCHAR);","+","+statement ok","+INSERT INTO t SELECT i, 'x' || i FROM range(1000) t(i);","+","+statement ok","+CHECKPOINT","+","+statement ok","+SET debug_checkpoint_sleep_ms=5000","+","+concurrentloop threadid 0 4","+","+# an open transaction makes the checkpoints concurrent","+onlyif threadid=2","+statement ok","+BEGIN TRANSACTION","+","+onlyif threadid=2","+query I","+SELECT COUNT(*) FROM t","+----","+1000","+","+sleep 500 millisecond","+","+# commit after the open transaction started, so the checkpoint cannot be a full one","+onlyif threadid=0","+statement ok","+INSERT INTO t VALUES (-1, 'pre')","+","+onlyif threadid=0","+statement ok","+CHECKPOINT","+","+sleep 1000 millisecond","+","+# the commit writes its row groups to the WAL, then fails and is reverted, freeing their blocks","+onlyif threadid=1","+statement ok","+SET debug_force_commit_failure=true","+","+onlyif threadid=1","+statement error","+INSERT INTO t SELECT i, repeat('y', 50) || i FROM range(200000) t(i)","+----","+Forced commit failure","+","+sleep 1000 millisecond","+","+# a new optimistic write reuses the freed blocks before the checkpoint ends, and stays uncommitted","+onlyif threadid=3","+statement ok","+BEGIN","+","+onlyif threadid=3","+statement ok","+INSERT INTO t SELECT i, repeat('z', 50) || i FROM range(2000000) t(i)","+","+sleep 4000 millisecond","+","+onlyif threadid=1","+statement ok","+SET debug_force_commit_failure=false","+","+# a second checkpoint writes its header while that write is still uncommitted","+onlyif threadid=0","+statement ok","+INSERT INTO t VALUES (-2, 'mid')","+","+onlyif threadid=0","+statement ok","+CHECKPOINT","+","+sleep 12000 millisecond","+","+onlyif threadid=3","+statement ok","+ROLLBACK","+","+onlyif threadid=2","+statement ok","+COMMIT","+","+endloop","+","+statement ok","+SET debug_checkpoint_sleep_ms=0","+","+restart","+","+statement ok","+PRAGMA disable_checkpoint_on_shutdown","+","+statement ok","+SET debug_verify_blocks=true","+","+query I","+SELECT COUNT(*) FROM t","+----","+1002","+","+statement ok","+INSERT INTO t VALUES (-3, 'post')","+","+statement ok","+CHECKPOINT"],"additions":123,"deletions":0,"truncated":false},{"path":"test/sql/storage/optimistic_commit_failure_frees_blocks.test_slow","lines":["@@ -0,0 +1,62 @@","+# name: test/sql/storage/optimistic_commit_failure_frees_blocks.test_slow","+# description: A bulk insert whose commit fails before its WAL flush returns its blocks to the free list right away","+# group: [storage]","+","+load {TEST_DIR}/optimistic_commit_failure_frees_blocks.db","+","+statement ok","+SET checkpoint_threshold='1TB'","+","+statement ok","+SET debug_verify_blocks=true","+","+statement ok","+CREATE TABLE t (i INTEGER, s VARCHAR);","+","+statement ok","+CHECKPOINT","+","+statement ok","+SET debug_force_commit_failure=true","+","+statement error","+INSERT INTO t SELECT i, repeat('y', 50) || i FROM range(200000) t(i)","+----","+Forced commit failure","+","+statement ok","+SET debug_force_commit_failure=false","+","+# no checkpoint ran since: the blocks are free already","+statement ok","+CREATE TEMPORARY TABLE after_failure AS SELECT total_blocks, free_blocks FROM pragma_database_size()","+","+query I","+SELECT free_blocks > 0 FROM after_failure","+----","+true","+","+# the retry reuses them instead of growing the file","+statement ok","+INSERT INTO t SELECT i, repeat('y', 50) || i FROM range(200000) t(i)","+","+query I","+SELECT p.total_blocks = a.total_blocks FROM pragma_database_size() p, after_failure a","+----","+true","+","+statement ok","+CHECKPOINT","+","+restart","+","+statement ok","+SET debug_verify_blocks=true","+","+query I","+SELECT COUNT(*) FROM t","+----","+200000","+","+statement ok","+CHECKPOINT",""],"additions":62,"deletions":0,"truncated":false}],"additions":341,"deletions":26,"truncated":false,"file_count":14},"error":null,"fetched_at":"2026-11-17T18:47:05.988881+00:00"}