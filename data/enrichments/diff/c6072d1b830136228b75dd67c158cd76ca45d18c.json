then","+      task:close() -- Timed out, or CTRL-C.","+    end","+    local decoded, json = pcall(vim.json.decode, res and res.body or '')","+    ---@type { name: string, digest: string? }[]","+    local assets = decoded and type(json) == 'table' and json.assets or {}","+    local asset = vim.iter(assets):find(function(a)","+      return a.name == name","+    end) or {}","+    local sha256 = type(asset.digest) == 'string' and asset.digest:match('^sha256:(%x+)$')","+    if not sha256 then","+      log().warn('fetch_sha256s: no digest of', name, err)","+    end","+    return sha256 or '-'","+  end","+end","+"," --- Gets the Nvim release URL/dir/version based on the local version + remote platform."," ---"," ---@param os string","@@ -494,11 +536,10 @@ end"," ---@return string version Minimum version of an `nvim` on the remote `$PATH` to use instead, e.g."," ---   `v0.12.0`, or `v0.13.0-dev` (any build) for a prerelease."," local function get_release(os, arch)","-  local ver = vim.version()","-  local base = ('v%d.%d.%d'):format(ver.major, ver.minor, ver.patch)","+  local tag, base = release_tag()","+  local prerelease = vim.version().prerelease","   -- Prerelease: installs the current nightly once per version, until \"Update\" (see `M.connect()`).","-  local tag = ver.prerelease and 'nightly' or base","-  local install_name = ver.prerelease and ('nightly-%s'):format(base) or base","+  local install_name = prerelease and ('nightly-%s'):format(base) or base"," ","   local os_map = { linux = 'linux', darwin = 'macos' }","   local arch_map = { x86_64 = 'x86_64', aarch64 = 'arm64', arm64 = 'arm64' }","@@ -515,7 +556,7 @@ local function get_release(os, arch)","     release_name","   )","   local dir = ('%s/releases/%s-%s-%s'):format(remote_data_dir, install_name, target_os, target_arch)","-  return dir, release_url, ver.prerelease and ('%s-%s'):format(base, ver.prerelease) or base","+  return dir, release_url, prerelease and ('%s-%s'):format(base, prerelease) or base"," end"