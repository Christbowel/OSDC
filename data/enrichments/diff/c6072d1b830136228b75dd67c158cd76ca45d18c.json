{"id":"c6072d1b830136228b75dd67c158cd76ca45d18c","axis":"silent","repo":"neovim/neovim","sha":"c6072d1b830136228b75dd67c158cd76ca45d18c","parsed":{"files":[{"path":"runtime/doc/gui.txt","lines":["@@ -141,32 +141,33 @@ Connect UI to a different server","                 no other UI is currently attached to it."," "," :connect ssh://[{user}@]{host}[:{port}]                 *remote-ssh* *E6101*","-                Connects to Nvim on {host} over SSH:","-                1. Uses `nvim` from `$PATH` on {host} if it is the local","-                   version or newer (except when \"Update Nvim\" is selected).","-                   Else auto-installs Nvim on the remote (based on the local","-                   version). (Note: `$PATH` is derived from a non-login shell,","-                   your shell rc isn't applied.)","-                2. Starts Nvim on {host}.","-                3. Attaches the UI to it, through an SSH tunnel owned by the","+                Connects to Nvim on {host} (the \"remote\") over SSH:","+","+                1. Uses `nvim` found in the remote `$PATH` if it is >= the","+                   local version (except when \"Update Nvim\" is selected), or","+                   else auto-installs Nvim. (Note: `$PATH` is from a non-login","+                   shell, your shell rc isn't applied.)","+                2. Copies your local config files (`stdpath(\"config\")`) to","+                   `~/.config/nvim-remote/`.","+                3. Starts Nvim on the remote.","+                4. Attaches the UI to it, through an SSH tunnel owned by the","                    current (local) server."," ","                 The session ends when either side exits or the connection","                 drops: the remote Nvim stops, and so does the local server,","                 unless a UI is attached to it or a buffer is modified."," ","-                The remote Nvim runs with `NVIM_APPNAME=nvim-remote` (see","-                |$NVIM_APPNAME|), so its config/data are separate from other","-                Nvims, and owned by remote-ssh:","+                The remote Nvim runs with `NVIM_APPNAME=nvim-remote`, so its","+                config/data are isolated (appname \"nvim-remote\" is reserved","+                for this purpose):","                 - Config: `~/.config/nvim-remote/`, overwritten on connect by","-                  a copy of the local config (|stdpath()| \"config\", e.g.","-                  `~/.config/nvim/`), except `.git/`. Plugins are not copied:","-                  your plugin manager (e.g. |vim.pack|) installs them.","+                  a copy of your local config files (`stdpath(\"config\")`,","+                  excluding `.git/`). Plugins are not copied, that is","+                  delegated to your plugin manager (|vim.pack|).","                 - Data: `~/.local/share/nvim-remote/`, kept across sessions","-                  for fast reconnects. Caches installed releases, e.g.","-                  `releases/v0.12.0-linux-x86_64/`. Nightly is installed once;","-                  choose \"Update Nvim\" at the prompt to refresh it, and use it","-                  instead of `$PATH` (may break other sessions using it).","+                  for fast reconnect. Caches autoinstalls in `…/releases/`.","+                  Nightly is installed once; choose \"Update Nvim\" at the","+                  prompt to refresh it (may break other sessions using it)."," ","                 Requirements:","                 - Local: `ssh` (OpenSSH 7.6+). Win32-OpenSSH lacks","@@ -176,7 +177,8 @@ Connect UI to a different server","                   accepted and recorded, unless your ssh_config sets","                   `StrictHostKeyChecking`.","                 - Remote: Linux (x86_64, aarch64) or macOS (arm64, x86_64),","-                  with `curl`, `tar`, POSIX `sh`, and a writable `/tmp`.","+                  with `curl`, `tar`, `sha256sum` or `shasum`, POSIX `sh`, and","+                  a writable `/tmp`."," ","                 Examples: >vim","                     :connect ssh://myhost"],"additions":21,"deletions":19,"truncated":false},{"path":"runtime/doc/lua.txt","lines":["@@ -4628,6 +4628,11 @@ vim.net.request({method}, {url}, {opts}, {on_response})    *vim.net.request()*","         })","         job:close()"," ","+        -- Await the response in a task (|lua-async|). Closing the task cancels the request.","+        vim.async.run(function()","+          local err, res = vim.async.await(3, vim.net.request, 'https://neovim.io/charter/', {})","+        end)","+","         -- Add custom headers in the request.","         vim.net.request('https://neovim.io/charter/', {","           headers = { Authorization = 'Bearer XYZ' },","@@ -4667,8 +4672,7 @@ vim.net.request({method}, {url}, {opts}, {on_response})    *vim.net.request()*","       • `fun(method: vim.net.HttpMethod, url: string, opts: vim.net.request.Opts, response: vim.net.request.ResponseFunc)`"," ","     Return: ~","-        (`{ close: fun() }`) Object with `close()` method which cancels the","-        request.","+        (`vim.async.Closable`) Cancels the request or checks its status."," "," "," =============================================================================="],"additions":6,"deletions":2,"truncated":false},{"path":"runtime/doc/news.txt","lines":["@@ -424,6 +424,8 @@ LUA","   your terminal supports it."," • |vim.net.request()| can specify custom headers by passing `opts.headers`."," • |vim.net.request()| can now accept  `method` param overload for multiple HTTP methods.","+• |vim.net.request()| works with |vim.async.await()|: closing the task cancels","+  the request."," • |vim.rpcrequest()| can specify `opts.timeout`."," • |SystemObj:wait()| accepts a `cond` predicate which allows you to wait for","   a condition instead of process termination."],"additions":2,"deletions":0,"truncated":false},{"path":"runtime/lua/vim/net.lua","lines":["@@ -67,6 +67,11 @@ local http_methods = {"," --- })"," --- job:close()"," ---","+--- -- Await the response in a task (|lua-async|). Closing the task cancels the request.","+--- vim.async.run(function()","+---   local err, res = vim.async.await(3, vim.net.request, 'https://neovim.io/charter/', {})","+--- end)","+---"," --- -- Add custom headers in the request."," --- vim.net.request('https://neovim.io/charter/', {"," ---   headers = { Authorization = 'Bearer XYZ' },","@@ -85,7 +90,7 @@ local http_methods = {"," --- @param on_response? vim.net.request.ResponseFunc Callback invoked on request completion."," --- @overload fun(url: string, opts: vim.net.request.Opts, response: vim.net.request.ResponseFunc)"," --- @overload fun(method: vim.net.HttpMethod, url: string, opts: vim.net.request.Opts, response: vim.net.request.ResponseFunc)","+--- @return vim.async.Closable # Cancels the request or checks its status."," function M.request(method, url, opts, on_response)","   if type(url) ~= 'string' then","     on_response = opts --[[@as vim.net.request.ResponseFunc?]]","@@ -151,6 +156,8 @@ function M.request(method, url, opts, on_response)","   table.insert(args, url)"," ","   local system_opts = opts.body and { stdin = opts.body } or {}","+  local closing = false -- close() was called.","+  local on_close --- @type fun()?","   local job = vim.system(args, system_opts, function(res)","     --- @cast res.stdout -?","     ---@type string?, vim.net.request.Response?","@@ -173,15 +180,32 @@ function M.request(method, url, opts, on_response)","       end","     end)"," ","+    if on_close then","+      on_close()","+    end","     if on_response then","       on_response(err, response)","     end","   end)"," ","   return {","-    close = function()","+    -- Calls `callback` after the request stops. |vim.async.Closable|","+    --- @param callback? fun()","+    close = function(_, callback)","+      closing = true","+      if job:is_closing() then -- Stopped already.","+        if callback then","+          callback()","+        end","+       