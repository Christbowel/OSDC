(response.read().decode('utf8'))","-]]):format(url)","-    local out, rc = system({ 'python', '-c', script })","-    if out == '' and rc ~= 0 then","-      return 'python urllib.request error: ' .. rc","-    else","-      return out","-    end","+--- Gets the latest Nvim Python client (pynvim) version from PyPI.","+---@async","+local function latest_pypi_version()","+  if vim.fn.executable('curl') == 0 then","+    return 'unable to get pypi response: curl not found'","   end","-","-  local message = 'missing `curl` '","-","-  if has_curl then","-    message = message .. '(with HTTPS support) '","+  local url = 'https://pypi.org/pypi/pynvim/json'","+  local err, res = vim.async.await(3, vim.net.request, url, {})","+  vim.async.await(vim.schedule) -- Leaves the fast event (the `vim.net.request()` callback).","+  if not res then","+    return ('unable to get pypi response: %s'):format(vim.trim(err or ''))","   end","-  message = message .. 'and `python`, cannot make web request'","-","-  return message","-end","-","-local function latest_pypi_version()","-  local pypi_version = 'unable to get pypi response'","-  local pypi_response = download('https://pypi.org/pypi/pynvim/json')","-  if pypi_response ~= '' then","-    local pcall_ok, output = pcall(vim.fn.json_decode, pypi_response)","-    if not pcall_ok then","-      return 'error: ' .. pypi_response","-    end","-","-    local pypi_data = output","-    local pypi_element = pypi_data['info'] or {}","-    pypi_version = pypi_element['version'] or 'unable to parse'","+  local ok, json = pcall(vim.json.decode, res.body)","+  if not ok or type(json) ~= 'table' then","+    return ('error: %s'):format(res.body)","   end","-  return pypi_version","+  local version = vim.tbl_get(json, 'info', 'version')","+  return type(version) == 'string' and version or 'unable to parse'"," end"," "," --- @param s string","@@ -532,6 +492,7 @@ end"," ---     {current pypi nvim status},"," ---     {installed version status}"," --- }","+---@async"," local function version_info(python)","   local pypi_version = latest_pypi_version()"," ","@@ -606,6 +567,7 @@ local function version_info(python)","   return { python_version, nvim_version, pypi_version, version_status }"," end"," ","+---@async"," local function python()","   health.start('Python 3 provider (optional)')"," ","@@ -960,6 +922,7 @@ local function ruby()","   end"," end"," ","+---@async"," function M.check()","   clipboard()","   node()"],"additions":18,"deletions":51,"truncated":false},{"path":"runtime/plugin/net.lua","lines":["@@ -15,18 +15,15 @@ local archive_patterns = {","   { suffix = '.zip', kind = 'zip' },"," }"," ","-local function url_path(url)","-  return (url:gsub('[?#].*$', ''))","-end","-"," ---@param url string"," ---@return 'zip'|'tar'?"," local function archive_type(url)","-  local path = url_path(url)","+  local uri = vim.uri.parse(url)","+  if not uri then","+    return nil","+  end","   for _, pattern in ipairs(archive_patterns) do","-    if vim.endswith(path, pattern.suffix) then","+    if vim.endswith(uri.path, pattern.suffix) then","       return pattern.kind","     end","   end"],"additions":5,"deletions":6,"truncated":false},{"path":"runtime/scripts/remote_ssh.sh","lines":["@@ -3,13 +3,17 @@"," # Bootstraps the headless Nvim server of a |remote-ssh| session: finds or installs `nvim`, which then"," # runs and supervises the server (vim.net._ssh.serve())."," #","-# Usage: remote_ssh.sh [--update] {sock} {dir} {url} {version}","+# Usage: remote_ssh.sh [--update] {sock} {dir} {url} {sha256} {version}"," #   Runs `nvim` from $PATH if it is {version} or newer, else the release {url}, which it installs","-#   to {dir} (relative to $HOME) unless present. --update: (re)installs and runs the release. E.g.","-#   remote_ssh.sh /tmp/nvim-remote.0123abcd/nvim.sock .local/share/nvim-remote/releases/v0.12.0-linux-x86_64 https://…/nvim-linux-x86_64.tar.gz v0.12.0","+#   to {dir} (relative to $HOME) unless present, if its SHA-256 is {sha256} (`-`: unknown, so it","+#   does not install). --update: (re)installs and runs the release.","+#","+#   Example:","+#     remote_ssh.sh /tmp/nvim-remote.0123abcd/nvim.sock .local/share/nvim-remote/releases/v0.12.0-linux-x86_64 https://…/nvim-linux-x86_64.tar.gz 474430d5…7d87 v0.12.0"," "," set -eu","-# dash (Debian's sh) has no pipefail; tar still fails on an empty or truncated stream.","+# dash (Debian's sh) has no pipefail, so a pipeline must also fail safely without it, e.g.","+# `file_sha256` then prints nothing (a mismatch)."," # shellcheck disable=SC3040"," if (set -o pipefail) 2>/dev/null; then","   set -o pipefail","@@ -27,17 +31,36 @@ system_nvim() {","   echo \"$nvim\""," }"," ","+# Prints the SHA-256 of file $1.","+file_sha256() {","+  if command -v sha256sum >/dev/null 2>&1; then","+    sha256sum \"$1\"","+  else","+    shasum -a 256 \"$1\" # macOS.","+  fi | cut -d ' ' -f 1","+}","+"," # Installs the release to $dest, unless present (and not $update)."," install_release() (","   if [ -x \"$dest/bin/nvim\" ] && [ -z \"$update\" ]; then","     exit 0","   fi","+  if [ \"$sha256\" = - ]; then","+    echo \"Cannot verify $url: SHA-256 unknown (see the local remote-ssh.log)\" >&2","+    exit 1","+  fi","   echo \"Installing $dest...\" >&2","   mkdir -p \"${dest%/*}\"","   tmp=$(mktemp -d \"$dest.XXXXXX\")","   trap 'rm -rf \"$tmp\"' EXIT","+  curl -fsSL --retry 3 -o \"$tmp/nvim.tar.gz\" \"$url\"","+  got=$(file_sha256 \"$tmp/nvim.tar.gz\")","+  if [ \"$got\" != \"$sha256\" ]; then","+    echo \"SHA-256 mismatch: $url (expected $sha256, got $got)\" >&2","+    exit 1","+  fi","   mkdir \"$tmp/new\"","-  curl -fsSL \"$url\" | tar -xzf - -C \"$tmp/new\"","+  tar -xzf \"$tmp/nvim.tar.gz\" -C \"$tmp/new\"","   if [ -n \"$update\" ]; then","     # Removed with $tmp. Gone already if a concurrent update moved it.","     mv \"$dest\" \"$tmp/old\" 2>/dev/null || :","@@ -56,7 +79,8 @@ main() {","   sock=$1","   dest=\"$HOME/$2\"","   url=$3","-  want=$4","+  sha256