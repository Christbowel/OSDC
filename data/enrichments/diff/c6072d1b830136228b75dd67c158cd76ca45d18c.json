):format(server:getsockname().port)","+    end)","+","+    -- is_closing() after close().","+    t.eq(","+      { false, true },","+      exec_lua(function()","+        local req = vim.net.request(url, {})","+        local closing = req:is_closing()","+        req:close()","+        return { closing, req:is_closing() }","+      end)","+    )","+    -- The task completes after the request stops.","+    t.eq(","+      { false, true },","+      exec_lua(function()","+        local task = vim.async.run(function()","+          return vim.async.await(3, vim.net.request, url, {})","+        end)","+        local ok = task:pwait(100)","+        task:close()","+        return { ok, vim.wait(5000, function()","+          return task:completed()","+        end) }","+      end)","+    )","+    exec_lua(function()","+      for _, h in ipairs(_G.handles) do","+        h:close()","+      end","+    end)","+  end)","+","   it('plugin writes output to buffer', function()","     local url = http_server('<html>test</html>')"," ","@@ -202,7 +276,8 @@ describe('vim.net.request', function()","         assert(vim.uv.fs_copyfile(path, opts.outpath))","         callback(nil)","       end","-      vim.cmd.edit('https://example.com/browser.zip')","+      -- The query is not part of the path (see |vim.Uri|).","+      vim.cmd.edit({ 'https://example.com/browser.zip?raw=1', magic = { file = false } })","       vim.wait(1000, function()","         return vim.b.nvim_zip ~= nil","       end)","@@ -215,7 +290,7 @@ describe('vim.net.request', function()","     end, fixture)"," ","     t.eq(false, rv.legacy)","-    t.eq('https://example.com/browser.zip', rv.name)","+    t.eq('https://example.com/browser.zip?raw=1', rv.name)","     t.eq(true, rv.nvim_zip)","   end)"," "],"additions":78,"deletions":3,"truncated":false},{"path":"test/functional/lua/ssh_spec.lua","lines":["@@ -115,6 +115,8 @@ describe('remote-ssh', function()","   --- @param behavior? table Optional fields:","   ---   - `confirm`: Result 