dminUserId;","+","+  React.useEffect(() => {","+    let disposed = false;","+","+    const reconcileSharedSession = (forceReset: boolean = false) => {","+      if (disposed) {","+        return;","+      }","+","+      const nextToken = getStoredToken();","+      if (!nextToken) {","+        return;","+      }","+","+      const currentToken = store.getState().admin_app.token ?? null;","+      if (currentToken === nextToken && !forceReset) {","+        return;","+      }","+","+      // Broadcast and storage notices for one change arrive as separate tasks.","+      // Resetting again for the token just adopted only repeats identity fetches.","+      if (lastResetTokenRef.current === nextToken && currentToken === nextToken) {","+        return;","+      }","+","+      // The new token's admin is unknown until their profile loads. Remember","+      // unsaved edits so we can say they were discarded if the admin changes.","+      if (hasUnsavedChanges() && adminUserIdRef.current !== undefined) {","+        discardedEditsAdminIdRef.current = adminUserIdRef.current;","+      }","+","+      discardPendingLogout();","+      resetSessionExpiredNotification();","+      if (currentToken !== nextToken) {","+        dispatch(setToken(nextToken));","+      }","+      resetAdminApiState(dispatch);","+      lastResetTokenRef.current = nextToken;","+    };","+","+    const unsubscribe = subscribeToAdminSessionChanges(() => reconcileSharedSession(true));","+    queueMicrotask(reconcileSharedSession);","+","+    return () => {","+      disposed = true;","+      unsubscribe();","+    };","+  }, [discardPendingLogout, dispatch, store]);","+","   const login = React.useCallback<AuthContextValue['login']>(","     async ({ rememberMe, ...body }) => {","       const res = await loginMutation({ ...body, deviceId: getOrCreateDeviceId(), rememberMe });","@@ -417,12 +523,10 @@ const AuthProvider = ({","         const { token } = res.data;"," ","         resetSessionExpiredNotification();","-  