  return 'a' as const;","+};","+","+const mockIdentityHandlers = () => {","+  server.use(","+    http.get('/admin/users/me', ({ request }) => {","+      const who = identityForAuthorization(request.headers.get('Authorization'));","+","+      return HttpResponse.json({","+        data: who === 'a' ? USER_A : USER_B,","+      });","+    }),","+    http.get('/admin/users/me/permissions', ({ request }) => {","+      const who = identityForAuthorization(request.headers.get('Authorization'));","+","+      return HttpResponse.json({","+        data: who === 'a' ? [PERMISSION_A] : [PERMISSION_B],","+      });","+    })","+  );","+};","+","+const setAuthCookie = (token: string) => {","+  document.cookie = `jwtToken=${encodeURIComponent(token)}; Path=/admin`;","+};","+","+const clearAuthCookie = () => {","+  document.cookie = 'jwtToken=; Path=/admin; Expires=Thu, 01 Jan 1970 00:00:01 GMT';","+  document.cookie = 'jwtToken=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT';","+};","+","+/** What another document publishes after it has already written the new session. */","+const emitExternalSessionBroadcast = () => {","+  const channel = new BroadcastChannel(ADMIN_SESSION_CHANNEL);","+  channel.postMessage({","+    type: ADMIN_SESSION_MESSAGE_TYPE,","+    tabId: 'external-tab',","+  });","+  channel.close();","+};","+","+const emitExternalStorageSignal = () => {","+  window.dispatchEvent(","+    new StorageEvent('storage', {","+      key: ADMIN_SESSION_STORAGE_KEY,","+      newValue: `external-${Date.now()}`,","+    })","+  );","+};","+","+const IdentityProbe = () => {","+  const permissions = useAuth('IdentityProbe', (state) => state.permissions);","+  const user = useAuth('IdentityProbe', (state) => state.user);","+  const login = useAuth('IdentityProbe', (state) => state.login);","+  const isLoading = useAuth('IdentityProbe', (state) => state.isLoading);","+  const token = useAuth('IdentityProbe', (state) => state.token);","+","+  return (","+    <div>","+      <div data-testid=\"identity-loading\">{String(isLoading)}</div>","+      <div data-testid=\"identity-token\">{token ?? ''}</div>","+      <div data-testid=\"identity-email\">{user?.email ?? ''}</div>","+      <div data-testid=\"identity-actions\">","+        {permissions.map((permission) => permission.action).join(',')}","+      </div>","+      <button","+        type=\"button\"","+        onClick={() => {","+          void login({","+            email: USER_B.email,","+            password: 'Testing123!',","+            rememberMe: true,","+          });","+        }}","+      >","+        login-as-b","+      </button>","+    </div>","+  );","+};","+","+const EstablishSessionProbe = () => {","+  const dispatch = useTypedDispatch();","+","+  return (","+    <>","+      <IdentityProbe />","+      <button","+        type=\"button\"","+        onClick={() => {","+          establishAdminSession(dispatch, { token: TOKEN_B });","+        }}","+      >","+        establish-session-b","+      </button>","+    </>","+  );","+};","+","+const InitProbe = () => {","+  const { data } = useInitQuery();","+","+  return <div data-testid=\"has-admin\">{String(data?.hasAdmin)}</div>;","+};","+","+const RbacProbe = () => {","+  const { allowedActions, isLoading } = useRBAC([CONDITIONAL_PERMISSION]);","+","+  return (","+    <div data-testid=\"rbac-result\">{isLoading ? 'loading' : String(allowedActions.canUpdate)}</div>","+  );","+};","+","+const QueryStringMenuProbe = () => {","+  const navigate = useNavigate();","+  const mainMenu = useMenu(false);","+  const settingsMenu = useSettingsMenu();","+","+  return (","+    <>","+      <div data-testid=\"main-menu-loading\">{String(mainMenu.isLoading)}</div>","+      <div data-testid=\"settings-menu-loading\">{String(settingsMenu.isLoading)}</div>","+      <button type=\"button\" onClick={() => navigate('?page=2')}>","+        change-query","+      </button>","+    </>","+  );","+};","+","+const waitForUserA = async () => {","+  await waitFor(() => expect(screen.getByTestId('identity-loading')).toHaveTextContent('false'));","+  expect(screen.getByTestId('identity-email')).toHaveTextContent(USER_A.email);","+  expect(screen.getByTestId('identity-actions')).toHaveTextContent(PERMISSION_A.action);","+  expect(screen.getByTestId('identity-actions')).not.toHaveTextContent(PERMISSION_B.action);","+};","+","+const waitForUserB = async () => {","+  await waitFor(() => expect(screen.getByTestId('identity-email')).toHaveTextContent(USER_B.email));","+  expect(screen.getByTestId('identity-actions')).toHaveTextContent(PERMISSION_B.action);","+  expect(screen.getByTestId('identity-actions')).not.toHaveTextContent(PERMISSION_A.action);","+};","+","+const bearer = (token: string) => `Bearer ${token}`;","+","+/**","+ * Keep the first bearer-A `getMe` / `getMyPermissions` responses pending.","+ * This proves that a response started for the previous credential cannot","+ * repopulate the cache after the session changes.","+ */","+const holdInFlightOldBearer = () => {","+  const authorizations: { me: Array<string | null>; permissions: Array<string | null> } = {","+    me: [],","+    permissions: [],","+  };","+  let released = false;","+  let releaseGate: () => void = () => {};","+  const gate = new Promise<void>((resolve) => {","+    releaseGate = () => {","+      if (!released) {","+        released = true;","+        resolve();","+      }","+    };","+  });","+","+  const identityResponse = (authorization: string | null, kind: 'me' | 'permissions') => {","+    const who = identityForAuthorization(authorization);","+","+    if (kind === 'me') {","+      return HttpResponse.json({ data: who === 'a' ? USER_A : USER_B });","+    }","+","+    return HttpResponse.json({","+      data: who === 'a' ? [PERMISSION_A] : [PERMISSION_B],","+    });","+  };","+","+  server.use(","+    http.get('/admin/users/me', async ({ request }) => {","+      const authorization = request.headers.get('Authorization');","+      authorizations.me.push(author