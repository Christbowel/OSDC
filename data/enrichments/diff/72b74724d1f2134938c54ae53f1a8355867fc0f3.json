{"id":"72b74724d1f2134938c54ae53f1a8355867fc0f3","axis":"silent","repo":"vercel/next.js","sha":"72b74724d1f2134938c54ae53f1a8355867fc0f3","parsed":{"files":[{"path":"crates/next-core/src/chunk_size_defaults.rs","lines":["@@ -0,0 +1,45 @@","+use turbopack_core::chunk::chunking::DEFAULT_ESTIMATED_REQUEST_COST_BYTES;","+","+/// Scale of the default chunk size limits and request cost when chunk items are minified before","+/// chunking, in percent of the unminified defaults.","+const MINIFIED_PERCENT: u64 = 40;","+","+/// Defaults for the production chunking size limits and request cost.","+///","+/// The defaults are tuned for chunk items measured by their unminified code. When chunk items are","+/// minified one by one before chunking (`turbopackMinifyBeforeChunking`, which only applies when","+/// minification is enabled), chunking measures their minified code instead, which is a few times","+/// smaller, so the defaults are scaled down to match. Values set explicitly in the config are used","+/// as-is.","+#[derive(Clone, Copy, Debug)]","+pub struct ChunkSizeDefaults {","+    percent: u64,","+}","+","+impl ChunkSizeDefaults {","+    pub fn new(minify: bool, minify_before_chunking: bool) -> Self {","+        ChunkSizeDefaults {","+            percent: if minify && minify_before_chunking {","+                MINIFIED_PERCENT","+            } else {","+                100","+            },","+        }","+    }","+","+    /// Scales a default size limit, given in unminified bytes.","+    pub fn size(self, unminified: usize) -> usize {","+        unminified * self.percent as usize / 100","+    }","+","+    /// Scales a default request cost, given in unminified bytes.","+    pub fn request_cost(self, unminified: u64) -> u64 {","+        unminified * self.percent / 100","+    }","+","+    /// The request cost to use when the config sets none: `None` keeps the chunker's own default,","+    /// unless it needs scaling.","+    pub fn default_request_cost(self) -> Option<u64> {","+        (self.percent != 100).then(|| self.request_cost(DEFAULT_ESTIMATED_REQUEST_COST_BYTES))","+    }","+}"],"additions":45,"deletions":0,"truncated":false},{"path":"crates/next-core/src/lib.rs","lines":["@@ -7,6 +7,7 @@ pub mod app_structure;"," mod base_loader_tree;"," mod bootstrap;"," mod browser_variant_modules;","+mod chunk_size_defaults;"," mod embed_js;"," mod emit;"," pub mod hmr_entry;"],"additions":1,"deletions":0,"truncated":false},{"path":"crates/next-core/src/next_client/context.rs","lines":["@@ -42,6 +42,7 @@ use turbopack_node::{"," use turbopack_resolve::resolve_options_context::{ResolveOptionsContext, TsConfigHandling};"," "," use crate::{","+    chunk_size_defaults::ChunkSizeDefaults,","     mode::NextMode,","     next_build::get_postcss_package_mapping,","     next_client::{","@@ -636,20 +637,24 @@ pub async fn get_client_chunking_context(","             // A manifest chunk keeps a lazily compiled import's URL stable across activation.","             .manifest_chunks(*lazy_dynamic_imports.await?);","     } else {","+        let defaults = ChunkSizeDefaults::new(*minify.await?, *minify_before_chunking.await?);","         builder = builder","             .chunking_config(","                 Vc::<EcmascriptChunkType>::default().to_resolved().await?,","                 ChunkingConfig {","-                    min_chunk_size: chunking_min_chunk_size.unwrap_or(50_000),","+                    min_chunk_size: chunking_min_chunk_size","+                        .unwrap_or_else(|| defaults.size(50_000)),","                     max_chunk_count_per_group: chunking_max_chunk_count_per_group.unwrap_or(40),","-                    max_merge_chunk_size: chunking_max_merge_chunk_size.unwrap_or(200_000),","+                    max_merge_chunk_size: chunking_max_merge_chunk_size","+                        .unwrap_or_else(|| defaults.size(200_000)),","                     first_page_load_priority: chunking_first_page_load_priority,","                     priori