/ otherwise. Fails if the content failed to generate.","+pub(crate) async fn estimated_chunk_item_size(","+    chunk_item: ResolvedVc<Box<dyn EcmascriptChunkItem>>,","+    async_module_info: Option<Vc<AsyncModuleInfo>>,","+    minify: MinifyType,","+    source_maps: bool,","+) -> Result<usize> {","+    Ok(","+        match chunk_item_factory_content(chunk_item, async_module_info, true, minify, source_maps)","+            .await?","+        {","+            // When chunk items are minified one by one, the chunk is made of the minified","+            // factories, so size them as such. This minifies every item before chunking, but the","+            // result is shared with code generation (see `minified_module_factory`), so the work","+            // isn't repeated.","+            ChunkItemFactoryContent::Minified { factory, .. } => factory.await?.source_code().len(),","+            ChunkItemFactoryContent::Unminified(content) => content.await?.inner_code.len(),","+        },","+    )","+}","+"," #[turbo_tasks::value_impl]"," impl ValueDefault for EcmascriptChunkType {","     #[turbo_tasks::function]"],"additions":66,"deletions":16,"truncated":false},{"path":"turbopack/crates/turbopack-ecmascript/src/chunk/code_module_ids_and_paths.rs","lines":["@@ -12,42 +12,68 @@ use turbopack_core::{"," "," use crate::{","     chunk::{","-        EcmascriptChunkItemBatchGroup, EcmascriptChunkItemExt,","+        EcmascriptChunkItemBatchGroup, EcmascriptChunkItemContent, EcmascriptChunkItemExt,","         EcmascriptChunkItemOrBatchWithAsyncInfo, EcmascriptChunkItemWithAsyncInfo,","+        item::{ChunkItemFactoryContent, chunk_item_factory_content},","     },","     minify::minify_chunk_item,"," };"," ","+/// The mangling used when minifying a single chunk item.","+///","+/// `OptimalSize` orders mangled names by the character frequency of the code being minified. Per","+/// item, that order differs from factory to factory, which hurts gzip across the chunk. A fixed","+/// order keeps names consistent between factories. (`OptimalSize` was also seen to break React's","+/// generated stack traces.)","+fn per_item_mangle(mangle: bool) -> Option<MangleType> {","+    mangle.then_some(MangleType::Deterministic)","+}","+","+/// The module factory of a chunk item, minified on its own.","+///","+/// Keyed by the content cell rather than by the chunk item, so that chunk size estimation (which","+/// reads the estimated content) and code generation (which reads the final content) share one","+/// minification: for most modules both are the same cell, see","+/// `chunk_item_factory_content`. Modules whose estimated content differs (e.g. async loaders)","+/// produce two small factories.","+///","+/// The result is a hash-only cell: it is recomputed rather than persisted.","+#[turbo_tasks::function]","+pub async fn minified_module_factory(","+    content: Vc<EcmascriptChunkItemContent>,","+    source_maps: bool,","+    mangle: bool,","+) -> Result<Vc<Code>> {","+    let factory = content.await?.module_factory().await?;","+    Ok(minify_chunk_item(&factory, source_maps, per_item_mangle(mangle))?.cell())","+}","+"," async fn code_module_id_and_path(","     item: &EcmascriptChunkItemWithAsyncInfo,","     minify: MinifyType,","     source_maps: bool,"," ) -> Result<CodeModuleIdAndPath> {","-    let factory = item","-        .chunk_item","-        .code(item.async_info.map(|info| *info))","-        .await?;","-    let code = factory.code.to_code().await?;","+    let async_info = item.async_info.map(|info| *info);","     // `MinifyType::NoMinify` here means the chunk will be minified as a whole later (or not at","     // all); only the per-item mode asks for the factory to be minified now. A strict factory keeps","     // its `\"use strict\"` directive either way; the chunk drops it where it places the factory in a","     // strict context (see `write_module_factories`).","-    let code = match minify {","-        MinifyType::Minify { mangle } => ReadRef::new_owned(minify_chunk_item(","-            &code,","-            source_maps,","-            // `OptimalSize` orders mangled names by the character frequency of the code being","-            // minified. Per item, that order differs from factory to factory, which hurts gzip","-            // across the chunk. A fixed order keeps names consistent between factories.","-            mangle.map(|_| MangleType::Deterministic),","-        )?),","-        MinifyType::NoMinify => code,","+    let (code, strict) = if let Ok(ChunkItemFactoryContent::Minified { factory, strict }) =","+        chunk_item_factory_content(item.chunk_item, async_info, false, minify, source_maps).await","+    {","+        (factory.await?, strict)","+    } else {","+        // Not minified per item, or the content failed to generate. Dropping that error is","+        // intentional: `code` reports it as an issue and returns a factory that throws it, so the","+        // chunk still builds.","+        let factory = item.chunk_item.code(async_info).await?;","+        (factory.code.to_code().await?, factory.strict)","     };","     Ok(CodeModuleIdAndPath {","         id: item.chunk_item.id().await?,","         code,","         path: item.chunk_item.asset_ident().to_string().owned().await?,","-        strict: factory.strict,","+        strict,","     })"," }"," "],"additions":43,"deletions":17,"truncated":false},{"path":"turbopack/crates/turbopack-ecmascript/src/chunk/content.rs","lines":["@@ -50,7 +50,7 @@ impl ChunkMinification {","     }"," ","     /// The minification to apply to each chunk item before it is written into the chunk.","-    fn per_item(self) -> MinifyType {","+    pub(crate) fn per_item(self) -> MinifyType {","         match self {","             ChunkMinification::PerItem { mangle } => MinifyType::Minify { mangle },","             ChunkMinification::None | ChunkMinification::WholeChunk { .. } => MinifyType::NoMinify,"],"additions":1,"deletions":1,"truncated":false},{"path":"turbopack/crates/turbopack-ecmascript/src/chunk/factory_content_tests.rs","lines":["@@ -0,0 +1,245 @@","+//! Chunk sizing and code generation go through one entry point,","+//! [`chunk_item_factory_content`](super::item::chunk_item_factory_content): they share the per-item","+//! minification, size raw content outside per-item mode, and handle a failed content differently","+//! (sizing counts it as empty, code generation reports it and emits a throwing factory).","+","+use anyhow::{Result, bail};","+use async_trait::async_trait;","+use turbo_tasks::{OperationVc, ReadRef, ResolvedVc, Vc};","+use turbo_tasks_backend::{BackendOptions, TurboTasksBackend, noop_backing_storage};","+use turbo_tasks_fs::{FileSystem, VirtualFileSystem};","+use turbopack_core::{","+    chunk::{","+        AsyncModuleInfo, ChunkItem, ChunkType, ChunkingContext, MinifyType, round_chunk_item_size,","+    },","+    ident::AssetIdent,","+    issue::{CollectibleIssuesExt, IssueFilter},","+    module::Module,","+    output::OutputAssetsReference,","+};","+","+use crate::chunk::{","+    EcmascriptChunkItem, EcmascriptChunkItemContent, EcmascriptChunkItemExt, EcmascriptChunkType,","+    chunk_type::{estimated_chunk_item_size, rounded_chunk_item_size},","+    item::{ChunkItemFactoryContent, chunk_item_factory_content},","+};","+","+const CODE: &str = \"(() => {\\n  const value = 1 + 2;\\n  console.log(value);\\n})\";","+","+/// A chunk item whose content is [`CODE`] (the same cell whether estimated or not), or fails to","+/// generate.","+#[turbo_tasks::value]","+struct TestItem {","+    ident: ResolvedVc<AssetIdent>,","+    fails: bool,","+}","+","+#[turbo_tasks::function]","+fn test_content() -> Vc<EcmascriptChunkItemContent> {","+    EcmascriptChunkItemContent {","+        inner_code: CODE.into(),","+        ..Default::default()","+    }","+    .cell()","+}","+","+#[turbo_tasks::function]","+async fn test_item(fails: bool) -> Result<Vc<Box<dyn EcmascriptChunkItem>>> {","+    let path = VirtualFileSystem::new().root().await?.join(\"item.js\")?;","+    Ok(Vc::upcast(","+        TestItem {","+            ident: AssetIdent::from_path(path).into_vc().to_resolved().await?,","+            fails,","+        }","+        .cell(),","+    ))","+}","+","+#[turbo_tasks::value_impl]","+impl OutputAssetsReference for TestItem {}","+","+#[turbo_tasks::value_impl]","+impl ChunkItem for TestItem {","+    #[turbo_tasks::function]","+    fn asset_ident(&self) -> Vc<AssetIdent> {","+        *self.ident","+    }","+","+    fn ty(&self) -> Vc<Box<dyn ChunkType>> {","+        Vc::upcast(Vc::<EcmascriptChunkType>::default())","+    }","+","+    #[turbo_tasks::function]","+    fn module(&self) -> Result<Vc<Box<dyn Module>>> {","+        bail!(\"not needed by the tests\")","+    }","+","+    fn chunking_context(&self) -> Vc<Box<dyn ChunkingContext>> {","+        unreachable!(\"not needed by the tests\")","+    }","+}","+","+#[async_trait]","+#[turbo_tasks::value_impl]","+impl EcmascriptChunkItem for TestItem {","+    async fn content_with_async_module_info(","+        &self,","+        _async_module_info: Option<Vc<AsyncModuleInfo>>,","+        _estimated: bool,","+    ) -> Result<Vc<EcmascriptChunkItemContent>> {","+        if self.fails {","+            bail!(\"the content failed to generate\");","+        }","+        Ok(test_content())","+    }","+}","+","+const MINIFY: MinifyType = MinifyType::Minify { mangle: None };","+","+#[turbo_tasks::value(shared, serialization = \"skip\")]","+struct Sizes {","+    /// The estimated and final contents' minified factories are the same cell.","+    shared_minification: bool,","+    minified_size: usize,","+    minified_code: String,","+    raw_size: usize,","+    /// What chunking sees outside per-item mode.","+    rounded_raw_size: usize,","+}","+","+#[turbo_tasks::function(operation, root)]","+async fn sizes_operation() -> Result<Vc<Sizes>> {","+    let item = test_item(false).to_resolved().await?;","+    let factory = async |estimated| -> Result<_> {","+        let ChunkItemFactoryContent::Minified { factory, .. } =","+            chunk_item_factory_content(item, None, estimated, MINIFY, false).await?","+        else {","+            bail!(\"per-item minification minifies the item\");","+        };","+        factory.to_resolved().await","+    };","+    let estimated = factory(true).await?;","+    let final_factory = factory(false).await?;","+    Ok(Sizes {","+        shared_minification: estimated == final_factory,","+        minified_size: estimated_chunk_item_size(item, None, MINIFY, false).await?,","+        minified_code: final_factory.await?.source_code().to_str()?.into_owned(),","+        raw_size: estimated_chunk_item_size(item, None, MinifyType::NoMinify, false).await?,","+        rounded_raw_size: rounded_chunk_item_size(item, None, MinifyType::NoMinify, false).await,","+    }","+    .cell())","+}","+","+#[turbo_tasks::value(shared, serialization = \"skip\")]","+struct Failure {","+    /// What chunking sees for the item.","+    size: usize,","+    factory: String,","+}","+","+/// The result of `op`, and the titles of the issues it emitted.","+#[turbo_tasks::value(shared, serialization = \"skip\")]","+struct WithIssues {","+    failure: ReadRef<Failure>,","+    issues: Vec<String>,","+}","+","+#[turbo_tasks::function(operation, root)]","+async fn with_issues_operation(op: OperationVc<Failure>) -> Result<Vc<WithIssues>> {","+    let failure = op.read_strongly_consistent().await?;","+    let issues = op","+        .peek_issues()","+        .get_plain_issues(&IssueFilter::everything())","+        .await?","+        .iter()","+        .map(|issue| issue.title.to_unstyled_string())","+        .collect();","+    Ok(WithIssues { failure, issues }.cell())","+}","+","+#[turbo_tasks::function(operation, root)]","+async fn size_failed_operation() -> Result<Vc<Failure>> {","+    let item = test_item(true).to_resolved().await?;","+    Ok(Failure {","+        size: rounded_chunk_item_size(item, None, MINIFY, false).await,","+        factory: String::new(),","+    }","+    .cell())","+}","+","+#[turbo_tasks::function(operation, root)]","+async fn code_failed_operation() -> Result<Vc<Failure>> {","+    let code = test_item(true).code(None).await?;","+    Ok(Failure {","+        size: 0,","+        factory: code","+            .code","+            .to_code()","+            .await?","+            .source_code()","+            .to_str()?","+            .into_owned(),","+    }","+    .cell())","+}","+","+async fn run(f: impl Future<Output = Result<()>> + Send + 'static) {","+    turbo_tasks::TurboTasks::new(TurboTasksBackend::new(","+        BackendOptions::default(),","+        noop_backing_storage(),","+    ))","+    .run_once(f)","+    .await","+    .unwrap();","+}","+","+#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]","+async fn estimated_and_final_content_share_one_minification() {","+    run(async {","+        let sizes = sizes_operation().read_strongly_consistent().await?;","+        assert!(sizes.shared_minification);","+        assert_eq!(sizes.minified_size, sizes.minified_code.len());","+        assert!(sizes.minified_size < CODE.len(), \"{}\", sizes.minified_code);","+        // Not minified per item: the raw code, without the factory wrapper.","+        assert_eq!(sizes.raw_size, CODE.len());","+        assert_eq!(sizes.rounded_raw_size, round_chunk_item_size(CODE.len()));","+        Ok(())","+    })","+    .await;","+}","+","+#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]","+async fn failed_content_sizes_as_empty_but_code_generation_reports_it() {","+    run(async {","+        let size = with_issues_operation(size_failed_operation())","+            .read_strongly_consistent()","+            .await?;","+        assert_eq!(size.failure.size, 0);","+        assert!(","+            size.issues.is_empty(),","+            \"sizing must not report: {:?}\",","+            size.issues","+        );","+","+        let code_result = with_issues_operation(code_failed_operation())","+            .read_strongly_consistent()","+            .await?;","+        let code = &code_result.failure;","+        assert!(","+            code.factory.contains(\"throw new Error(\")","+                && code.factory.contains(\"the content failed to generate\"),","+            \"{}\",","+            code.factory","+        );","+        assert!(","+            code_result","+                .issues","+                .iter()","+                .any(|title| title.contains(\"Code generation\")),","+            \"{:?}\",","+            code_result.issues","+        );","+        Ok(())","+    })","+    .await;","+}"],"additions":245,"deletions":0,"truncated":false},{"path":"turbopack/crates/turbopack-ecmascript/src/chunk/item.rs","lines":["@@ -12,9 +12,9 @@ use turbo_tasks_fs::{FileSystemPath, rope::Rope};"," use turbopack_core::{","     chunk::{","         AsyncModuleInfo, ChunkItem, ChunkItemWithAsyncModuleInfo, ChunkType, ChunkingContext,","-        ChunkingContextExt, ModuleId, SourceMapSourceType,","+        ChunkingContextExt, MinifyType, ModuleId, SourceMapSourceType,","     },","-    code_builder::{CodeBuilder, PersistedCode},","+    code_builder::{Code, CodeBuilder, PersistedCode},","     ident::AssetIdent,","     issue::{IssueExt, IssueSeverity, StyledString, code_gen::CodeGenerationIssue},","     module::Module,","@@ -29,7 +29,10 @@ use turbopack_core::{"," "," use crate::{","     EcmascriptModuleContent,","-    chunk::{chunk_type::EcmascriptChunkType, placeable::EcmascriptChunkPlaceable},"],"additions":2,"deletions":3,"truncated":false}],"additions":443,"deletions":47,"truncated":true,"file_count":15},"error":null,"fetched_at":"2026-11-14T15:12:45.549523+00:00"}