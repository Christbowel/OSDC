[0])","+\t\tif v == \"\" {","+\t\t\tcontinue","+\t\t}","+\t\ttruncated := len(v) > maxLoggedHeaderValueLength","+\t\tif truncated {","+\t\t\t// Truncate before sanitizing: the sanitizer drops a rune cut in half.","+\t\t\tv = v[:maxLoggedHeaderValueLength]","+\t\t}","+\t\tv = dskitlog.DropUnsafeChars(v).String()","+\t\tif truncated {","+\t\t\tv += \"...\""," \t\t}","+\t\tfields = append(fields, s.logKey, v)"," \t}"," \treturn fields"," }"],"additions":60,"deletions":17,"truncated":false},{"path":"modules/frontend/handler_test.go","lines":["@@ -9,6 +9,7 @@ import ("," \t\"testing\""," "," \t\"github.com/go-kit/log\"","+\t\"github.com/go-kit/log/level\""," \t\"github.com/stretchr/testify/assert\""," \t\"github.com/stretchr/testify/require\""," \t\"go.opentelemetry.io/otel/attribute\"","@@ -22,7 +23,7 @@ func TestFormatRequestHeaders(t *testing.T) {"," \th.Add(\"X-Header-To-Log\", \"i should be logged!\")"," \th.Add(\"X-Header-To-Not-Log\", \"i shouldn't be logged!\")"," ","-\tfields := formatRequestHeaders(&h, []string{\"X-Header-To-Log\", \"X-Header-Not-Present\"})","+\tfields := formatRequestHeaders(&h, logHeaders([]string{\"X-Header-To-Log\", \"X-Header-Not-Present\"}))"," "," \texpected := []interface{}{"," \t\t\"header_x_header_to_log\",","@@ -32,6 +33,57 @@ func TestFormatRequestHeaders(t *testing.T) {"," \trequire.Equal(t, expected, fields)"," }"," ","+func TestFormatRequestHeadersDropsUnsafeChars(t *testing.T) {","+\th := http.Header{}","+\th[\"User-Agent\"] = []string{\"  Grafana/12.0.0\\n level=error msg=injected\\x1b[31m  \"}","+","+\tfields := formatRequestHeaders(&h, logHeaders([]string{\"User-Agent\"}))","+","+\trequire.Equal(t, []interface{}{\"header_user_agent\", \"Grafana/12.0.0 level=error msg=injected[31m\"}, fields)","+}","+","+func TestFormatRequestHeadersTruncatesLongValues(t *testing.T) {","+\tatLimit := strings.Repeat(\"a\", maxLoggedHeaderValueLength)","+\t// The two-byte é starts at the last byte inside the limit, so truncation cuts it in half