.Type,","+\t\t\t\"query_weight\", qs.Weight,","+\t\t\t\"query_sub_queries\", qs.SubQueries,","+\t\t\t\"query_conditions\", qs.Conditions,","+\t\t\t\"query_regex_conditions\", qs.RegexConditions,","+\t\t\t\"query_has_or\", qs.HasOr,","+\t\t\t\"query_needs_full_trace\", qs.NeedsFullTrace,","+\t\t\t\"query_select_all\", qs.SelectAll,","+\t\t)","+\t}","+\tout = append(out, headerFields...)"," \t_ = logger.Log(out...)"," }"," "],"additions":34,"deletions":15,"truncated":false},{"path":"modules/frontend/util_test.go","lines":["@@ -222,3 +222,25 @@ func TestRecordResult_NilAdditionalMetrics(t *testing.T) {"," \trecordResult(level.Info(logger), context.Background(), nil, \"msg\", \"test\")"," \trequire.Contains(t, logger.String(), \"msg test\")"," }","+","+func TestLogWithShape_RequestHeaderFields(t *testing.T) {","+\tt.Parallel()","+","+\tt.Run(\"appends header fields from the context\", func(t *testing.T) {","+\t\tt.Parallel()","+","+\t\tctx := withRequestHeaderFields(context.Background(), []any{\"header_user_agent\", \"Grafana/12.0.0\"})","+\t\tlogger := &recordingLogger{}","+\t\tlogWithShape(level.Info(logger), ctx, \"msg\", \"search response\")","+\t\trequire.Equal(t, \"level info msg search response header_user_agent Grafana/12.0.0\\n\", logger.String())","+\t})","+","+\tt.Run(\"logs only the given fields without header fields\", func(t *testing.T) {","+\t\tt.Parallel()","+","+\t\tctx := withRequestHeaderFields(context.Background(), nil)","+\t\tlogger := &recordingLogger{}","+\t\tlogWithShape(level.Info(logger), ctx, \"msg\", \"search response\")","+\t\trequire.Equal(t, \"level info msg search response\\n\", logger.String())","+\t})","+}"],"additions":22,"deletions":0,"truncated":false},{"path":"modules/frontend/v1/frontend.go","lines":["@@ -41,7 +41,7 @@ type Config struct {"," // RegisterFlags adds the flags required to config this to the given FlagSet."," func (cfg *Config) RegisterFlags(f *flag.FlagSet) {"," \tf.IntVar(&cfg.MaxOutstandingPerTenant, \"querier.max-o