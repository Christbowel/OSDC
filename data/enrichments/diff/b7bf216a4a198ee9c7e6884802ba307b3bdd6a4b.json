{"id":"b7bf216a4a198ee9c7e6884802ba307b3bdd6a4b","axis":"silent","repo":"grafana/tempo","sha":"b7bf216a4a198ee9c7e6884802ba307b3bdd6a4b","parsed":{"files":[{"path":".chloggen/frontend-log-request-headers.yaml","lines":["@@ -0,0 +1,11 @@","+change_type: enhancement","+","+component: query-frontend","+","+note: Add the request headers configured with `log_query_request_headers` to the per-query response log lines for search, metrics, trace by ID and tag queries, not only to the `query stats` line. Logged header values have control characters removed and are truncated to 1 KiB each.","+","+issues: []","+","+subtext:","+","+user: ankit--sethi"],"additions":11,"deletions":0,"truncated":false},{"path":"docs/sources/tempo/configuration/_index.md","lines":["@@ -1065,7 +1065,10 @@ query_frontend:","     [multi_tenant_queries_enabled: <bool>]"," ","     # Comma-separated list of request header names to include in query logs. Applies","-    # to both query stats and slow queries logs.","+    # to both the query stats log line and the per-query response log lines for","+    # search, metrics, trace by ID and tag queries. Each header value is truncated to","+    # 1 KiB. Do not include headers that carry credentials or session material, such","+    # as Authorization or Cookie, because their values are written to the logs.","     [log_query_request_headers: <string> | default = \"\"]"," ","     # Set a maximum timeout for all api queries at which point the frontend will cancel queued jobs"],"additions":4,"deletions":1,"truncated":false},{"path":"modules/frontend/handler.go","lines":["@@ -3,14 +3,15 @@ package frontend"," import ("," \t\"context\""," \t\"errors\"","-\t\"fmt\""," \t\"io\""," \t\"net/http\"","+\t\"net/textproto\""," \t\"strings\""," \t\"time\""," "," \t\"github.com/grafana/dskit/flagext\""," \t\"github.com/grafana/dskit/grpcutil\"","+\tdskitlog \"github.com/grafana/dskit/log\""," \t\"github.com/grafana/tempo/v3/modules/frontend/pipeline\""," \t\"github.com/grafana/