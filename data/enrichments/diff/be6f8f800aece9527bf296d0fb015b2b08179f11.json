 }));","+  return;","+}","+","+function nextMessage(child) {","+  return new Promise((resolve) => child.once('message', resolve));","+}","+","+function request(port, agent) {","+  return new Promise((resolve, reject) => {","+    https.get({","+      agent,","+      host: '127.0.0.1',","+      port,","+      rejectUnauthorized: false,","+    }, (res) => {","+      const socket = res.socket;","+      let body = '';","+      res.setEncoding('utf8');","+      res.on('data', (chunk) => body += chunk);","+      res.on('end', () => resolve({ body, socket }));","+    }).on('error', reject);","+  });","+}","+","+async function main() {","+  const child = fork(__filename, ['server']);","+  const exited = new Promise((resolve, reject) => {","+    child.once('error', reject);","+    child.once('exit', (code, signal) => {","+      if (code === 0) {","+        resolve();","+      } else {","+        reject(new Error(`server exited with code ${code}, signal ${signal}`));","+      }","+    });","+  });","+","+  const { port } = await nextMessage(child);","+  const injected = nextMessage(child);","+  const agent = new https.Agent({ keepAlive: true, maxSockets: 1 });","+  const first = await request(port, agent);","+  assert.strictEqual(first.body, 'first');","+  assert.deepStrictEqual(await injected, { injected: true });","+","+  const second = await request(port, agent);","+  assert.strictEqual(second.socket, first.socket);","+  assert.strictEqual(second.body, 'clear');","+  agent.destroy();","+  await exited;","+}","+","+main().then(common.mustCall());",""],"additions":95,"deletions":0,"truncated":false}],"additions":283,"deletions":5,"truncated":false,"file_count":11},"error":null,"fetched_at":"2026-11-06T17:00:18.557453+00:00"}