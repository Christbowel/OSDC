\", \"serving.kserve.io/managed-by\": \"kserve-controller-manager\"}) {","+\t\t\t\t\tt.Fatalf(\"cache excludes resources owned by %s\", ownerLabel)","+\t\t\t\t}","+\t\t\t}","+\t\t})","+\t}","+}","+","+var _ = Describe(\"managed resource cache\", func() {","+\tIt(\"filters child watches while retaining direct reads of legacy resources\", func(ctx SpecContext) {","+\t\topts, err := NewCacheOptions()","+\t\tExpect(err).NotTo(HaveOccurred())","+\t\tmgr, err := ctrl.NewManager(cfg, ctrl.Options{","+\t\t\tScheme: k8sClient.Scheme(), Cache: opts, Client: NewClientOptions(),","+\t\t\tMetrics: metricsserver.Options{BindAddress: \"0\"},","+\t\t})","+\t\tExpect(err).NotTo(HaveOccurred())","+\t\tfor _, object := range []client.Object{&appsv1.Deployment{}, &corev1.Service{}} {","+\t\t\t_, err = mgr.GetCache().GetInformer(ctx, object, cache.BlockUntilSynced(false))","+\t\t\tExpect(err).NotTo(HaveOccurred())","+\t\t}","+\t\tmanagerCtx, cancel := context.WithCancel(ctx)","+\t\tdone := make(chan error, 1)","+\t\tgo func() { done <- mgr.Start(managerCtx) }()","+\t\tDeferCleanup(func() {","+\t\t\tcancel()","+\t\t\tEventually(done, 10*time.Second).Should(Receive(Succeed()))","+\t\t})","+\t\tExpect(mgr.GetCache().WaitForCacheSync(ctx)).To(BeTrue())","+","+\t\tns := &corev1.Namespace{ObjectMeta: metav1.ObjectMeta{GenerateName: \"cache-filter-\"}}","+\t\tExpect(k8sClient.Create(ctx, ns)).To(Succeed())","+\t\tDeferCleanup(func(ctx SpecContext) { Expect(k8sClient.Delete(ctx, ns)).To(Succeed()) })","+\t\tfor _, name := range []string{\"isvc\", \"graph\", \"legacy\", \"unrelated\"} {","+\t\t\tresourceLabels := map[string]string{\"app\": name}","+\t\t\tif name == \"isvc\" || name == \"graph\" {","+\t\t\t\tresourceLabels[constants.KServeManagedLabelKey] = constants.KServeManagedLabelValue","+\t\t\t}","+\t\t\tif name == \"graph\" {","+\t\t\t\tresourceLabels[constants.InferenceGraphLabel] = name","+\t\t\t} else if name != \"unrelated\" {","+\t\t\t\tresourceLabels[constants.InferenceServicePodLabelKey] = name","+\t\t\t}","+\t\t\tmetadata := metav1.ObjectMeta{Name: name, Namespace: ns.Name, Labels: resourceLabels}","+\t\t\tExpect(k8sClient.Create(ctx, &appsv1.Deployment{","+\t\t\t\tObjectMeta: metadata,","+\t\t\t\tSpec: appsv1.DeploymentSpec{","+\t\t\t\t\tSelector: &metav1.LabelSelector{MatchLabels: map[string]string{\"app\": name}},","+\t\t\t\t\tTemplate: corev1.PodTemplateSpec{","+\t\t\t\t\t\tObjectMeta: metav1.ObjectMeta{Labels: map[string]string{\"app\": name}},","+\t\t\t\t\t\tSpec:       corev1.PodSpec{Containers: []corev1.Container{{Name: \"model\", Image: \"example.com/model:test\"}}},","+\t\t\t\t\t},","+\t\t\t\t},","+\t\t\t})).To(Succeed())","+\t\t\tExpect(k8sClient.Create(ctx, &corev1.Service{","+\t\t\t\tObjectMeta: metadata,","+\t\t\t\tSpec:       corev1.ServiceSpec{Ports: []corev1.ServicePort{{Port: 80}}},","+\t\t\t})).To(Succeed())","+\t\t}","+","+\t\tfor _, list := range []client.ObjectList{&appsv1.DeploymentList{}, &corev1.ServiceList{}} {","+\t\t\tEventually(func(g Gomega) {","+\t\t\t\tg.Expect(mgr.GetCache().List(ctx, list, client.InNamespace(ns.Name))).To(Succeed())","+\t\t\t\tswitch resources := list.(type) {","+\t\t\t\tcase *appsv1.DeploymentList:","+\t\t\t\t\tg.Expect(resources.Items).To(HaveLen(2))","+\t\t\t\tcase *corev1.ServiceList:","+\t\t\t\t\tg.Expect(resources.Items).To(HaveLen(2))","+\t\t\t\t}","+\t\t\t}, 10*time.Second).Should(Succeed())","+\t\t\t// Orphan cleanup must also see legacy resources through List.","+\t\t\tExpect(mgr.GetClient().List(ctx, list, client.InNamespace(ns.Name))).To(Succeed())","+\t\t\tswitch resources := list.(type) {","+\t\t\tcase *appsv1.DeploymentList:","+\t\t\t\tExpect(resources.Items).To(HaveLen(4))","+\t\t\tcase *corev1.ServiceList:","+\t\t\t\tExpect(resources.Items).To(HaveLen(4))","+\t\t\t}","+\t\t}","+\t\tfor _, object := range []client.Object{&appsv1.Deployment{}, &corev1.Service{}} {","+\t\t\tkey := client.ObjectKey{Namespace: ns.Name, Name: \"legacy\"}","+\t\t\tExpect(apierrors.IsNotFound(mgr.GetCache().Get(ctx, key, object))).To(BeTrue())","+\t\t\tExpect(mgr.GetClient().Get(ctx, key, object)).To(Succeed())","+\t\t\tobject.GetLabels()[constants.KServeManagedLabelKey] = constants.KServeManagedLabelValue","+\t\t\tExpect(mgr.GetClient().Update(ctx, object)).To(Succeed())","+\t\t\tEventually(func() error { return mgr.GetCache().Get(ctx, key, object) }, 10*time.Second).Should(Succeed())","+\t\t}","+\t})","+})"],"additions":148,"deletions":0,"truncated":false},{"path":"pkg/controller/v1beta1/inferenceservice/reconcilers/deployment/deployment_reconciler.go","lines":["@@ -576,6 +576,13 @@ func (r *DeploymentReconciler) Reconcile(ctx context.Context) ([]*appsv1.Deploym"," \t\t\tresultList = append(resultList, existingDep)"," "," \t\tcase constants.CheckResultExisted:","+\t\t\tif desiredDep.Labels[constants.KServeManagedLabelKey] != existingDep.Labels[constants.KServeManagedLabelKey] {","+\t\t\t\tbefore := existingDep.DeepCopy()","+\t\t\t\texistingDep.Labels = utils.Union(existingDep.Labels, map[string]string{","+\t\t\t\t\tconstants.KServeManagedLabelKey: desiredDep.Labels[constants.KServeManagedLabelKey],","+\t\t\t\t})","+\t\t\t\topErr = r.client.Patch(ctx, existingDep, kclient.MergeFrom(before))","+\t\t\t}"," \t\t\t// Spec is unchanged. existingDep has the live .Status.Conditions from the server"," \t\t\t// (e.g. ReplicaFailure, Available, Progressing) which PropagateRawStatus needs."," \t\t\tresultList = append(resultList, existingDep)","@@ -614,6 +621,11 @@ func (r *DeploymentReconciler) SetControllerReferences(owner metav1.Object, sche"," \t\tif err := controllerutil.SetControllerReference(owner, deployment, scheme); err != nil {"," \t\t\treturn err"," \t\t}","+\t\t// Copy the labels: the pod template can share this map. Labeling the","+\t\t// Deployment must not roll out existing pods during an upgrade.","+\t\tdeployment.Labels = utils.Union(deployment.Labels, map[string]string{","+\t\t\tconstants.KServeManagedLabelKey: constants.KServeManagedLabelValue,","+\t\