{"id":"ad64c4c8150656cbd41116fd20a3943979fe6572","axis":"silent","repo":"datafuselabs/databend","sha":"ad64c4c8150656cbd41116fd20a3943979fe6572","parsed":{"files":[{"path":"src/query/service/src/pipelines/processors/horizontal_recluster.rs","lines":["@@ -713,7 +713,7 @@ impl ReclusterMergeFactory {","         let mut input_blocks = Vec::with_capacity(task.parts.len());","         for (ordinal, part) in task.parts.partitions.iter().enumerate() {","             let part = FuseBlockPartInfo::from_part(part)?;","-            let meta = BlockMeta::new(","+            let mut meta = BlockMeta::new(","                 part.nums_rows as _,","                 0,","                 0,","@@ -734,6 +734,14 @@ impl ReclusterMergeFactory {","                 part.compression,","                 part.create_on,","             );","+            if !part.column_groups.is_empty() {","+                meta.col_metas.clear();","+                meta.column_groups = part","+                    .column_groups","+                    .iter()","+                    .map(|group| group.to_file_meta())","+                    .collect();","+            }","             input_blocks.push(ReclusterMergeInputBlock {","                 meta: Arc::new(meta),","                 ordinal: u32::try_from(ordinal)"],"additions":9,"deletions":1,"truncated":false},{"path":"src/query/service/src/servers/flight/v1/exchange/fuse_part_exchange.rs","lines":["@@ -235,6 +235,7 @@ mod tests {","                 ..Default::default()","             }),","             None,","+            vec![],","         )","     }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"src/query/service/tests/it/storages/fuse/operations/column_groups.rs","lines":["@@ -0,0 +1,402 @@","+// Copyright 2021 Datafuse Labs","+//","+// Licensed under the Apache License, Version 2.0 (the \"License\");","+// you may not use this file except in compliance with the License.","+// You may obtain a copy of the License at","+//","+//     http://www.apache.org/licenses/LICENSE-2.0","+//","+// Unless required by applicable law or agreed to in writing, software","+// distributed under the License is distributed on an \"AS IS\" BASIS,","+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+// See the License for the specific language governing permissions and","+// limitations under the License.","+","+//! Reading blocks whose columns live in several column group files (\"split blocks\").","+//!","+//! Nothing writes split blocks yet, so `split_blocks` forges them: it moves columns of every","+//! block of a table into new group files, as a partial-column UPDATE will. Each test runs the","+//! same statements on the split table and on a reference table that holds the same rows in","+//! legacy blocks, and compares the results.","+","+use std::collections::HashMap;","+use std::sync::Arc;","+","+use databend_common_catalog::plan::Projection;","+use databend_common_catalog::table::Table;","+use databend_common_exception::Result;","+use databend_common_expression::Column;","+use databend_common_expression::DataBlock;","+use databend_common_expression::block_debug::pretty_format_blocks;","+use databend_common_storages_fuse::FuseTable;","+use databend_common_storages_fuse::io::MetaWriter;","+use databend_common_storages_fuse::io::SegmentsIO;","+use databend_common_storages_fuse::io::WriteSettings;","+use databend_common_storages_fuse::io::serialize_block;","+use databend_common_storages_fuse::statistics::gen_columns_statistics;","+use databend_common_storages_fuse::statistics::reducers::reduce_block_metas;","+use databend_query::sessions::QueryContext;","+use databend_query::sessions::TableContext;","+use databend_query::sessions::TableContextTableAccess;","+use databend_query::sessions::TableContextTableManagement;","+use databend_query::test_kits::*;","+use databend_storages_common_cache::CachePolicy;","+use databend_storages_common_io::ReadSettings;","+use databend_storages_common_table_meta::meta::ColumnGroupFileMeta;","+use databend_storages_common_table_meta::meta::SegmentInfo;","+use databend_storages_common_table_meta::meta::TableSnapshot;","+use databend_storages_common_table_meta::meta::Versioned;","+use databend_storages_common_table_meta::table::TableCompression;","+use futures::TryStreamExt;","+","+/// One group file to write for every block: its columns and its codec.","+struct Group {","+    columns: &'static [&'static str],","+    compression: TableCompression,","+}","+","+/// `a` takes the values of `id`, so that reading `a` from the legacy file would show.","+/// `id` and `arr` stay in the legacy file.","+const GROUPS: &[Group] = &[","+    Group {","+        columns: &[\"a\"],","+        compression: TableCompression::LZ4,","+    },","+    Group {","+        columns: &[\"s\", \"n\"],","+        compression: TableCompression::None,","+    },","+];","+","+const SCHEMA: &str =","+    \"(id int not null, a int not null, s string, n tuple(x int, y string), arr array(int))\";","+","+/// Creates the table `t`, made of split blocks, and the table `t_ref`, holding the same rows in","+/// legacy blocks.","+async fn setup(fixture: &TestFixture, drop_stats_of: &[&str]) -> Result<()> {","+    fixture","+        .execute_command(&format!(\"create table t {SCHEMA} row_per_block = 4\"))","+        .await?;","+    fixture","+        .execute_command(&format!(\"create table t_ref {SCHEMA} row_per_block = 4\"))","+        .await?;","+    for batch in 0..3 {","+        let values = \"select number + {start} as id, (number + {start}) * 2 as a, \\","+             concat('v', (number + {start})::string) as s, \\","+             (number + {start}, concat('y', (number + {start})::string)) as n, \\","+             [number + {start}, number + {start} + 1] as arr from numbers(6)\"","+            .replace(\"{start}\", &(batch * 6).to_string());","+        fixture","+            .execute_command(&format!(\"insert into t {values}\"))","+            .await?;","+        fixture","+            .execute_command(&format!(","+                \"insert into t_ref select id, id, s, n, arr from ({values})\"","+            ))","+            .await?;","+    }","+    split_blocks(fixture, \"t\", drop_stats_of).await","+}","+","+async fn latest_table(ctx: &Arc<QueryContext>, name: &str) -> Result<FuseTable> {","+    ctx.evict_table_from_cache(\"default\", \"default\", name)?;","+    let table = ctx","+        .get_catalog(\"default\")","+        .await?","+        .get_table(&ctx.get_tenant(), \"default\", name)","+        .await?;","+    Ok(FuseTable::try_from_table(table.as_ref())?.clone())","+}","+","+/// Moves the columns of `GROUPS` of every block of `name` into new group files, and drops the","+/// column statistics of `drop_stats_of`, which a block may legitimately lack.","+async fn split_blocks(fixture: &TestFixture, name: &str, drop_stats_of: &[&str]) -> Result<()> {","+    let ctx = fixture.new_query_ctx().await?;","+    let table = latest_table(&ctx, name).await?;","+    let snapshot = table.read_table_snapshot().await?.unwrap();","+    let schema = table.schema();","+    let operator = table.get_operator();","+    let location_gen = table.meta_location_generator();","+    let timestamps = TestFixture::default_table_meta_timestamps();","+    let reader = table.create_block_reader(","+        ctx.clone(),","+        Projection::Columns((0..schema.num_fields()).collect()),","+        CachePolicy::READ_ONLY,","+    )?;","+    let table_ctx: Arc<dyn TableContext> = ctx.clone();","+    let read_settings = ReadSettings::from_ctx(&table_ctx)?;","+    let segments = SegmentsIO::create(ctx.clone(), operator.clone(), schema.clone())","+        .read_segments::<SegmentInfo>(&snapshot.segments, CachePolicy::READ_ONLY)","+        .await?;","+","+    let mut segment_locations = Vec::with_capacity(segments.len());","+    let mut all_blocks = Vec::new();","+    for segment in segments {","+        let mut segment = segment?;","+        let mut blocks = Vec::with_capacity(segment.blocks.len());","+        for block in &segment.blocks {","+            let data = reader","+                .read_by_meta(&read_settings, block, &table.get_storage_format())","+                .await?;","+            let mut meta = block.as_ref().clone();","+            for group in GROUPS {","+                let indices = group","+                    .columns","+                    .iter()","+                    .map(|name| schema.index_of(name))","+                    .collect::<Result<Vec<_>>>()?;","+                let group_schema = Arc::new(schema.project(&indices));","+                let columns = group","+                    .columns","+                    .iter()","+                    .zip(&indices)","+                    .map(|(name, index)| {","+                        let source = if *name == \"a\" {","+                            schema.index_of(\"id\").unwrap()","+                        } else {","+                            *index","+                        };","+                        data.get_by_offset(source).to_column()","+                    })","+                    .collect::<Vec<Column>>();","+                let group_block = DataBlock::new_from_columns(columns);","+                let stats = gen_columns_statistics(","+                    &group_block,","+                    None,","+                    &group_schema,","+                    &Default::default(),","+                    HashMap::new(),","+                )?;","+                let write_settings = WriteSettings {","+                    table_compression: group.compression,","+                    ..table.get_write_settings()","+                };","+                let (col_metas, bytes) =","+                    serialize_block(&write_settings, &group_schema, group_block)?;","+                let (location, _) = location_gen.gen_block_location(timestamps);","+                let file_size = bytes.len() as u64;","+                operator.write(&location.0, bytes).await?;","+                meta.col_stats.extend(stats);","+                meta.append_column_group(ColumnGroupFileMeta {","+                    location,","+                    file_size,","+                    leaf_column_metas: col_metas,","+                    bloom: None,","+                    compression: group.compression.into(),","+                })?;","+            }","+            for name in drop_stats_of {","+                let field = schema.field_with_name(name)?;","+                for column_id in field.leaf_column_ids() {","+                    meta.col_stats.remove(&column_id);","+                }","+            }","+            assert!(meta.is_split());","+            blocks.push(Arc::new(meta));","+        }","+        // Pruning trusts the summaries: they must cover the new values.","+        segment.summary.col_stats =","+            reduce_block_metas(&blocks, table.get_block_thresholds(), None)?.col_stats;","+        all_blocks.extend(blocks.iter().cloned());","+        segment.blocks = blocks;","+        let location = location_gen.gen_segment_info_location(timestamps, false);","+        segment.write_meta(&operator, &location).await?;","+        segment_locations.push((location, SegmentInfo::VERSION));","+    }","+","+    let mut new_snapshot =","+        TableSnapshot::try_from_previous(snapshot, table.cluster_key_info(), None, timestamps)?;","+    new_snapshot.segments = segment_locations;","+    new_snapshot.summary.col_stats =","+        reduce_block_metas(&all_blocks, table.get_block_thresholds(), None)?.col_stats;","+    table","+        .commit_to_meta_server(","+            ctx.as_ref(),","+            table.get_table_info(),","+            location_gen,","+            new_snapshot,","+            None,","+            &None,","+            &operator,","+        )","+        .await","+}","+","+async fn query(fixture: &TestFixture, sql: &str) -> Result<String> {","+    let blocks: Vec<DataBlock> = fixture.execute_query(sql).await?.try_collect().await?;","+    if blocks.is_empty() {","+        return Ok(\"<no rows>\".to_string());","+    }","+    pretty_format_blocks(&blocks)","+}","+","+/// Runs `sql` on `t` and on `t_ref`, `{t}` standing for the table, and compares the results.","+async fn assert_same(fixture: &TestFixture, sql: &str) -> Result<()> {","+    let split = query(fixture, &sql.replace(\"{t}\", \"t\")).await?;","+    let reference = query(fixture, &sql.replace(\"{t}\", \"t_ref\")).await?;","+    assert_eq!(split, reference, \"{sql}\");","+    Ok(())","+}","+","+async fn execute_on_both(fixture: &TestFixture, sql: &str) -> Result<()> {","+    fixture.execute_command(&sql.replace(\"{t}\", \"t\")).await?;","+    fixture.execute_command(&sql.replace(\"{t}\", \"t_ref\")).await","+}","+","+/// The number of split blocks of `name`, and the number of all its blocks.","+async fn block_counts(fixture: &TestFixture, name: &str) -> Result<(usize, usize)> {","+    let ctx = fixture.new_query_ctx().await?;","+    let table = latest_table(&ctx, name).await?;","+    let Some(snapshot) = table.read_table_snapshot().await? else {","+        return Ok((0, 0));","+    };","+    let segments = SegmentsIO::create(ctx.clone(), table.get_operator(), table.schema())","+        .read_segments::<SegmentInfo>(&snapshot.segments, CachePolicy::READ_ONLY)","+        .await?;","+    let (mut split, mut total) = (0, 0);","+    for segment in segments {","+        let segment = segment?;","+        split += segment.blocks.iter().filter(|b| b.is_split()).count();","+        total += segment.blocks.len();","+    }","+    Ok((split, total))","+}","+","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_scan_split_blocks() -> anyhow::Result<()> {","+    let fixture = TestFixture::setup().await?;","+    setup(&fixture, &[]).await?;","+    let (split, total) = block_counts(&fixture, \"t\").await?;","+    assert!(total > 1);","+    assert_eq!(split, total);","+","+    for sql in [","+        \"select * from {t} order by id\",","+        \"select a, arr from {t} where id > 5 order by id\",","+        \"select id, s from {t} where a = 3\",","+        \"select n.1, n.2, a from {t} where a between 4 and 9 order by a\",","+        \"select count(*), sum(a) from {t}\",","+        \"select id from {t} where s = 'v7'\",","+        // Lazy materialization fetches the rows of the top-k from the blocks.","+        \"select * from {t} order by a desc limit 3\",","+    ] {","+        assert_same(&fixture, sql).await?;","+    }","+","+    // A column added after the split is in no group and reads as its default.","+    execute_on_both(&fixture, \"alter table {t} add column z int default 7\").await?;","+    assert_same(&fixture, \"select * from {t} order by id\").await?;","+    Ok(())","+}","+","+/// A split block keeps a column without statistics. Range pruning must not take the column for","+/// one the block lacks, which it would read as its default value.","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_range_pruning_split_block_without_column_stats() -> anyhow::Result<()> {","+    let fixture = TestFixture::setup().await?;","+    setup(&fixture, &[\"s\", \"a\"]).await?;","+    assert_same(&fixture, \"select id from {t} where s = 'v7'\").await?;","+    assert_same(&fixture, \"select id from {t} where a = 7\").await?;","+    Ok(())","+}","+","+/// Every mutation reads the split blocks it rewrites and writes legacy blocks.","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_mutate_split_blocks() -> anyhow::Result<()> {","+    let fixture = TestFixture::setup().await?;","+    setup(&fixture, &[]).await?;","+","+    execute_on_both(&fixture, \"update {t} set s = 'u' where id % 3 = 0\").await?;","+    assert_same(&fixture, \"select * from {t} order by id\").await?;","+","+    execute_on_both(&fixture, \"delete from {t} where id % 4 = 1\").await?;","+    assert_same(&fixture, \"select * from {t} order by id\").await?;","+","+    execute_on_both(","+        &fixture,","+        \"merge into {t} using (select number as id from numbers(18) where number % 5 = 0) as src \\","+         on {t}.id = src.id when matched then update set a = {t}.a + 100\",","+    )","+    .await?;","+    assert_same(&fixture, \"select * from {t} order by id\").await?;","+","+    execute_on_both(","+        &fixture,","+        \"replace into {t} on(id) values (2, 200, 'r', (2, 'r'), [2]), (100, 100, 'n', (1, 'n'), [])\",","+    )","+    .await?;","+    assert_same(&fixture, \"select * from {t} order by id\").await?;","+    Ok(())","+}","+","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_compact_split_blocks() -> anyhow::Result<()> {","+    let fixture = TestFixture::setup().await?;","+    setup(&fixture, &[]).await?;","+    execute_on_both(","+        &fixture,","+        \"alter table {t} set options(row_per_block = 1000)\",","+    )","+    .await?;","+    execute_on_both(&fixture, \"optimize table {t} compact\").await?;","+    assert_eq!(block_counts(&fixture, \"t\").await?.0, 0);","+    assert_same(&fixture, \"select * from {t} order by id\").await?;","+    Ok(())","+}","+","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_recluster_split_blocks() -> anyhow::Result<()> {","+    let fixture = TestFixture::setup().await?;","+    setup(&fixture, &[]).await?;","+    for multiway_merge in [0, 1] {","+        fixture","+            .execute_command(&format!(","+                \"set enable_recluster_multiway_merge = {multiway_merge}\"","+            ))","+            .await?;","+        execute_on_both(&fixture, \"alter table {t} cluster by (a)\").await?;","+        execute_on_both(&fixture, \"alter table {t} recluster final\").await?;","+        assert_same(&fixture, \"select * from {t} order by id\").await?;","+    }","+    Ok(())","+}","+","+#[tokio::test(flavor = \"multi_thread\")]","+async fn test_table_functions_on_split_blocks() -> anyhow::Result<()> {","+    let fixture = TestFixture::setup().await?;","+    setup(&fixture, &[]).await?;","+","+    // Each column is reported in the file that stores it: every block has 3 files.","+    let (_, blocks) = block_counts(&fixture, \"t\").await?;","+    let files = query(","+        &fixture,","+        &format!(","+            \"select count(distinct block_location) = {} from fuse_column('default', 't')\",","+            blocks * 3","+        ),","+    )","+    .await?;","+    assert!(files.contains(\"true\"), \"{files}\");","+    assert_same(","+        &fixture,","+        \"select column_name, count(*), sum(row_count) from fuse_column('default', '{t}') \\","+         group by column_name order by column_name\",","+    )","+    .await?;","+    assert_same(","+        &fixture,","+        \"select column_name, count(*) from fuse_encoding('default', '{t}') \\","+         group by column_name order by column_name\",","+    )","+    .await?;","+    assert_same(","+        &fixture,","+        // The group files are written with dictionary pages, so only data pages compare.","+        \"select column_name, sum(num_values) from fuse_page('default', '{t}') \\","+         where page_type <> 'dictionary' group by column_name order by column_name\",","+    )","+    .await?;","+","+    execute_on_both(&fixture, \"analyze table {t}\").await?;","+    Ok(())","+}"],"additions":402,"deletions":0,"truncated":false},{"path":"src/query/service/tests/it/storages/fuse/operations/mod.rs","lines":["@@ -17,6 +17,7 @@ mod alter_table;"," mod analyze;"," mod clone;"," mod clustering;","+mod column_groups;"," mod commit;"," mod fault_injection;"," mod logical_change_retry;"],"additions":1,"deletions":0,"truncated":false},{"path":"src/query/service/tests/it/storages/fuse/operations/prewhere.rs","lines":["@@ -360,6 +360,7 @@ async fn prepare_prewhere_data() -> Result<PrewhereTestSetup> {","         compression,","         sort_min_max: None,","         block_meta_index: None,","+        column_groups: vec![],","     };"," ","     let bloom_y_plus_ten = create_bloom_filter(Int64Type::from_data(vec![40]));"],"additions":1,"deletions":0,"truncated":false},{"path":"src/query/storages/common/table_meta/src/meta/column_oriented_segment/block_meta.rs","lines":["@@ -29,6 +29,10 @@ pub trait AbstractBlockMeta: Send + Sync + 'static + Sized {","     fn row_count(&self) -> u64;","     fn location_path(&self) -> String;","     fn col_metas(&self, col_ids: &HashSet<ColumnId>) -> HashMap<ColumnId, ColumnMeta>;","+    /// The path of the file that stores a leaf column of the block.","+    fn column_location_path(&self, _col_id: &ColumnId) -> String {","+        self.location_path()","+    }","     fn virtual_block_meta(&self) -> Option<VirtualBlockMeta>;"," }"," ","@@ -47,7 +51,7 @@ impl AbstractBlockMeta for BlockMeta {","     fn col_metas(&self, col_ids: &HashSet<ColumnId>) -> HashMap<ColumnId, ColumnMeta> {","         let mut col_metas = HashMap::new();","         for col_id in col_ids {","-            if let Some(col_meta) = self.col_metas.get(col_id) {","+            if let Some(col_meta) = self.column_meta(col_id) {","                 col_metas.insert(*col_id, col_meta.clone());","             }","         }","@@ -58,6 +62,11 @@ impl AbstractBlockMeta for BlockMeta {","         self.location.0.to_string()","     }"," ","+    fn column_location_path(&self, col_id: &ColumnId) -> String {","+        self.column_chunk(col_id)","+            .map_or_else(|| self.location_path(), |chunk| chunk.location.to_string())","+    }","+","     fn virtual_block_meta(&self) -> Option<VirtualBlockMeta> {","         self.virtual_block_meta.clone()","     }"],"additions":10,"deletions":1,"truncated":false},{"path":"src/query/storages/common/table_meta/src/meta/column_oriented_segment/segment_builder.rs","lines":["@@ -15,6 +15,7 @@"," use std::collections::HashMap;"," use std::sync::Arc;"," ","+use databend_common_exception::ErrorCode;"," use databend_common_exception::Result;"," use databend_common_expression::BlockThresholds;"," use databend_common_expression::Column;","@@ -152,6 +153,13 @@ impl SegmentBuilder for ColumnOrientedSegmentBuilder {","         block_meta: BlockMeta,","         _virtual_input: VirtualBlockInput,","     ) -> Result<()> {","+        if block_meta.is_split() {","+            // A column-oriented segment has no place for the column groups.","+            return Err(ErrorCode::Unimplemented(format!(","+                \"column-oriented segments cannot store split block {}\",","+                block_meta.location.0","+            )));","+        }","         self.row_count.push(block_meta.row_count);","         self.block_size.push(block_meta.block_size);","         self.file_size.push(block_meta.file_size);"],"additions":8,"deletions":0,"truncated":false},{"path":"src/query/storages/common/table_meta/src/meta/current/mod.rs","lines":["@@ -14,9 +14,11 @@"," "," pub use v0::ColumnMeta as SingleColumnMeta;"," pub use v2::AdditionalStatsMeta;","+pub use v2::BlockDataFile;"," pub use v2::BlockIndexMeta;"," pub use v2::BlockMeta;"," pub use v2::ClusterStatistics;","+pub use v2::ColumnChunkRef;"," pub use v2::ColumnGroupBloomMeta;"," pub use v2::ColumnGroupFileMeta;"," pub use v2::ColumnMeta;"],"additions":2,"deletions":0,"truncated":false},{"path":"src/query/storages/common/table_meta/src/meta/v2/column_group.rs","lines":["@@ -12,6 +12,7 @@"," // See the License for the specific language governing permissions and"," // limitations under the License."," ","+use std::borrow::Cow;"," use std::collections::HashMap;"," use std::collections::HashSet;"," ","@@ -53,6 +54,23 @@ pub struct ColumnGroupFileMeta {","     pub compression: Compression,"," }"," ","+/// A data file holding column chunks of a block, as a reader sees it.","+#[derive(Clone, Copy, Debug)]","+pub struct BlockDataFile<'a> {","+    pub location: &'a str,","+    /// Chunks the reader may read from this file. A column absent here is not in this file.","+    pub col_metas: &'a HashMap<ColumnId, ColumnMeta>,","+    pub compression: Compression,","+}","+","+/// A leaf column chunk of a block and the file that stores it.","+#[derive(Clone, Copy, Debug)]","+pub struct ColumnChunkRef<'a> {","+    pub location: &'a str,","+    pub meta: &'a ColumnMeta,","+    pub compression: Compression,","+}","+"," impl BlockMeta {","     /// A split block stores its columns across the group files in `column_groups`.","     /// A legacy block stores all columns in the single file at `location`.","@@ -60,6 +78,67 @@ impl BlockMeta {","         !self.column_groups.is_empty()","     }"," ","+    /// The files the columns of this block are read from: the single data file of a legacy","+    /// block, or the group files of a split block.","+    pub fn data_files(&self) -> Vec<BlockDataFile<'_>> {","+        if !self.is_split() {","+            return vec![BlockDataFile {","+                location: &self.location.0,","+                col_metas: &self.col_metas,","+                compression: self.compression,","+            }];","+        }","+        self.column_groups","+            .iter()","+            .map(|group| BlockDataFile {","+                location: &group.location.0,","+                col_metas: &group.leaf_column_metas,","+                compression: group.compression,","+            })","+            .collect()","+    }","+","+    /// The chunk of a leaf column, with the file of the block that stores it.","+    pub fn column_chunk(&self, column_id: &ColumnId) -> Option<ColumnChunkRef<'_>> {","+        if !self.is_split() {","+            return self.col_metas.get(column_id).map(|meta| ColumnChunkRef {","+                location: &self.location.0,","+                meta,","+                compression: self.compression,","+            });","+        }","+        self.column_groups.iter().find_map(|group| {","+            group","+                .leaf_column_metas","+                .get(column_id)","+                .map(|meta| ColumnChunkRef {","+                    location: &group.location.0,","+                    meta,","+                    compression: group.compression,","+                })","+        })","+    }","+","+    /// The chunk of a leaf column, in whichever file of the block stores it.","+    pub fn column_meta(&self, column_id: &ColumnId) -> Option<&ColumnMeta> {","+        self.column_chunk(column_id).map(|chunk| chunk.meta)","+    }","+","+    /// The chunks of all leaf columns the block stores. Each column appears in one group, so","+    /// the chunks of a split block do not collide.","+    pub fn column_metas(&self) -> Cow<'_, HashMap<ColumnId, ColumnMeta>> {","+        if !self.is_split() {","+            return Cow::Borrowed(&self.col_metas);","+        }","+        Cow::Owned(","+            self.column_groups","+                .iter()","+                .flat_map(|group| group.leaf_column_metas.iter())","+                .map(|(id, meta)| (*id, meta.clone()))","+                .collect(),","+        )","+    }","+","     /// Records that `group` now serves every column it stores.","     ///","     /// A legacy block first folds its single data file into group 0 so that no column loses","@@ -292,6 +371,44 @@ mod tests {","         block.check_column_groups()","     }"," ","+    #[test]","+    fn readers_find_each_column_in_its_file() -> Result<()> {","+        let legacy = legacy_block();","+        let files = legacy.data_files();","+        assert_eq!(files.len(), 1);","+        assert_eq!(files[0].location, \"d0.parquet\");","+        assert_eq!(files[0].compression, Compression::Lz4);","+        assert_eq!(files[0].col_metas, &col_metas(&[ID, A, B]));","+        assert_eq!(legacy.column_chunk(&A).unwrap().location, \"d0.parquet\");","+        assert!(matches!(legacy.column_metas(), Cow::Borrowed(_)));","+","+        let mut split = legacy_block();","+        split.append_column_group(group(\"d1\", &[A]))?;","+        let files = split","+            .data_files()","+            .iter()","+          