(&app, \"PUT\", &register_path, None, Some(register_body)).await.0,","+            StatusCode::BAD_REQUEST,","+            \"register {decoded:?}\",","+        );","+        let admin_put_path = format!(\"/-/pnpr/v0/admin/users/{encoded}\");","+        assert_eq!(","+            send(","+                &app,","+                \"PUT\",","+                &admin_put_path,","+                Some(&root),","+                Some(json!({ \"password\": \"secret123\" }))","+            )","+            .await","+            .0,","+            StatusCode::BAD_REQUEST,","+            \"admin create {decoded:?}\",","+        );","+    }","+","+    let (status, other) = send(","+        &app,","+        \"PUT\",","+        \"/-/pnpr/v0/admin/users/other\",","+        Some(&root),","+        Some(json!({ \"password\": \"secret123\" })),","+    )","+    .await;","+    assert_eq!(status, StatusCode::CREATED);","+    let other_rename_path = format!(\"/-/pnpr/v0/admin/users/{}\", other[\"id\"].as_str().unwrap());","+    for lookalike in [\"CLTEST\", \"Cltest\", \"clt\\u{00e9}st\", \"clte\\u{0301}st\", \"cl\\u{0442}est\"] {","+        assert_eq!(","+            send(","+                &app,","+                \"PATCH\",","+                &other_rename_path,","+                Some(&root),","+                Some(json!({ \"name\": lookalike }))","+            )","+            .await","+            .0,","+            StatusCode::BAD_REQUEST,","+            \"rename other to {lookalike:?}\",","+        );","+    }","+","+    let own_rename_path = format!(\"/-/pnpr/v0/admin/users/{cltest_id}\");","+    assert_eq!(","+        send(&app, \"PATCH\", &own_rename_path, Some(&root), Some(json!({ \"name\": \"Cltest\" })))","+            .await","+            .0,","+        StatusCode::OK,","+    );","+    let (_, roster) = send(&app, \"GET\", \"/-/pnpr/v0/admin/users\", Some(&root), None).await;","+    let names: Vec<_> = roster[\"users\"]","+        .as_array()","+        .unwrap()","+   