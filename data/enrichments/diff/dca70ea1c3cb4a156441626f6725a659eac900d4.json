,"@@ -3203,8 +3245,12 @@ static int FIO_decompressDstFile(FIO_ctx_t* const fCtx,"," ","         releaseDstFile = 1;"," ","-        dstFile = FIO_openDstFile(fCtx, prefs, srcFileName, dstFileName, dstFilePermissions);","-        if (dstFile==NULL) return 1;","+        if (strcmp(dstFileName, stdoutmark))","+            dstDir = UTIL_openParentDir(dstFileName, srcDir, srcFileName);","+        dstFile = FIO_openDstFile(fCtx, prefs, dstDir, srcFileName,","+                                  strcmp(srcFileName, stdinmark) ? srcFileStat : NULL,","+                                  dstFileName, dstFilePermissions);","+        if (dstFile==NULL) goto cleanup;","         dstFd = fileno(dstFile);","         /* identity of the file just created : on failure, remove only that one */","         if (strcmp(dstFileName, stdoutmark))","@@ -3215,7 +3261,7 @@ static int FIO_decompressDstFile(FIO_ctx_t* const fCtx,","          * Otherwise we may delete the destination file if it already exists,","          * and the user presses Ctrl-C when asked if they wish to overwrite.","          */","-        addHandler(dstFileName);","+        addHandler(dstDir, dstFileName, dstFileStatValid ? &dstFileStat : NULL);","     }"," ","     result = FIO_decompressFrames(fCtx, ress, prefs, dstFileName, srcFileName);","@@ -3233,16 +3279,18 @@ static int FIO_decompressDstFile(FIO_ctx_t* const fCtx,","         }"," ","         if (transferStat) {","-            UTIL_utime(dstFileName, srcFileStat);","+            UTIL_utimeInDir(dstDir, dstFileName, srcFileStat);","         }"," ","         if ( (result != 0)  /* operation failure */","           && strcmp(dstFileName, stdoutmark)  /* special case : don't remove() stdout */","           && dstFileStatValid ) {","-            FIO_removeFile(dstFileName, &dstFileStat);  /* remove decompression artefact; note: don't do anything special if remove() fails */","+            FIO_removeFile(dstDir, dstFileName, &dstFileStat);  /* remove decompression artefact; no