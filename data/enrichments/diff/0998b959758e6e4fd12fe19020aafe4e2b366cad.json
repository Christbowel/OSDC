configs.pb.h\""," #include \"xla/service/gpu/buffer_allocations.h\""," #include \"xla/service/gpu/cublas_cudnn.h\"","+#include \"xla/service/gpu/gpu_executable.h\""," #include \"xla/service/gpu/matmul_utils.h\""," #include \"xla/service/hlo_module_config.h\""," #include \"xla/service/platform_util.h\"","@@ -60,9 +67,13 @@ limitations under the License."," #include \"xla/service/shaped_slice.h\""," #include \"xla/shape_util.h\""," #include \"xla/stream_executor/command_buffer.h\"","+#include \"xla/stream_executor/cuda/cublas_lt_matmul_algorithm.h\"","+#include \"xla/stream_executor/cuda/cublas_lt_matmul_algorithm.pb.h\""," #include \"xla/stream_executor/device_address.h\""," #include \"xla/stream_executor/device_address_allocator.h\""," #include \"xla/stream_executor/device_description.h\"","+#include \"xla/stream_executor/gpu/blas_lt_matmul_algorithm.h\"","+#include \"xla/stream_executor/gpu/blas_lt_matmul_algorithm.pb.h\""," #include \"xla/stream_executor/gpu/gpu_blas_lt.h\""," #include \"xla/stream_executor/platform.h\""," #include \"xla/stream_executor/platform_manager.h\"","@@ -79,8 +90,9 @@ limitations under the License."," namespace xla::gpu {"," "," namespace {","-using absl_testing::IsOkAndHolds;","-using tsl::proto_testing::EqualsProto;","+using ::absl_testing::IsOkAndHolds;","+using ::absl_testing::StatusIs;","+using ::tsl::proto_testing::EqualsProto;"," "," class GpuBlasLtMatmulThunkTest : public HloTestBaseLegacy {","  public:","@@ -356,6 +368,54 @@ ENTRY AddDotsFunc {","   EXPECT_EQ(blas_lt->GetMatmulPlanCacheSize(), 1);"," }"," ","+TEST_F(GpuBlasLtMatmulThunkTest,","+       CompileGemmHloGeneratesThunkWithAlgorithmDescriptor) {","+  if (!gpu_comp().IsCuda()) {","+    GTEST_SKIP() << \"cuBLASLt algorithm descriptors are only populated on CUDA\";","+  }","+","+  constexpr absl::string_view kGemmHlo = R\"(","+HloModule SimpleGemm","+","+ENTRY AddDotsFunc {","+  x = f32[128,128] parameter(0)","+  y = f32[128,128] parameter(1)","+  ROOT dot_a = f32[128,128] dot(x, y), lhs_contracting_dims={1}, rhs_contracting_dims={0}","+})\";","+","+  HloModuleConfig config = GetModuleConfigForTest();","+  DebugOptions& debug_opts = config.mutable_debug_options();","+  debug_opts.set_xla_gpu_autotune_level(1);","+  debug_opts.set_xla_gpu_enable_triton_gemm(false);","+  debug_opts.clear_xla_gpu_enable_command_buffer();","+","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> module,","+                       ParseAndReturnVerifiedModule(kGemmHlo, config));","+  ASSERT_OK_AND_ASSIGN(","+      std::unique_ptr<Compiler> compiler,","+      Compiler::GetForPlatform(default_exec()->GetPlatform()->id()));","+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> compiled_module,","+                       compiler->RunHloPasses(std::move(module), default_exec(),","+                                              /*device_allocator=*/nullptr));","+  ASSERT_OK_AND_ASSIGN(","+      std::unique_ptr<Executable> executable,","+      compiler->RunBackend(std::move(compiled_module), default_exec(),","+                           /*device_allocator=*/nullptr));","+  const auto* gpu_executable =","+      absl::down_cast<GpuExecutable*>(executable.get());","+  ASSERT_NE(gpu_executable, nullptr);","+","+  const ThunkSequence& thunks = gpu_executable->thunk_executor().thunks();","+  ASSERT_EQ(thunks.size(), 1);","+  ASSERT_EQ(thunks[0]->kind(), Thunk::kCublasLtMatmul);","+  const auto* matmul_thunk =","+      absl::down_cast<const CublasLtMatmulThunk*>(thunks[0].get());","+  ASSERT_TRUE(matmul_thunk->blas_lt_algorithm().has_value());","+  EXPECT_GT(matmul_thunk->blas_lt_algorithm()->library_version, 0);","+  EXPECT_TRUE(std::holds_alternative<se::cuda::CublasLtMatmulAlgorithm>(","+      matmul_thunk->blas_lt_algorithm()->algorithm));","+}","+"," TEST_F(GpuBlasLtMatmulThunkTest, GroupedGemmWithAutotuneOneCacheEntry) {","   auto* rocm = gpu_comp().rocm_compute_capability();","   if (rocm == nullptr || !rocm->gfx9_mi300_series()) {","@@ -413,6 +473,20 @@ struct MockMatmulPlan : public se::gpu::BlasLt::MatmulPlan {","   // On a real backend GetAlgorithms is the solution heuristic, which is what","   // the plan caches; tests assert it does not re-run per call.","   mutable int get_algorithms_calls = 0;","+  mutable int get_matmul_algorithm_calls = 0;","+  int set_algorithm_calls = 0;","+  bool fail_get_matmul_algorithm = false;","+","+  absl::StatusOr<se::gpu::BlasLt::MatmulAlgorithm> GetMatmulAlgorithm(","+      const se::gpu::BlasLtMatmulAlgorithm& algorithm,","+      size_t max_workspace_size) const override {","+    ++get_matmul_algorithm_calls;","+    if (fail_get_matmul_algorithm) {","+      return absl::InvalidArgumentError(\"Invalid algorithm\");","+    }","+    return se::gpu::BlasLt::MatmulAlgorithm{/*opaque_algo=*/{},","+                                            /*workspace_size=*/0};","+  }"," ","   absl::StatusOr<std::vector<se::gpu::BlasLt::MatmulAlgorithm>> GetAlgorithms(","       size_t max_algorithm_count, size_t max_workspace_size) const override {","@@ -425,6 +499,7 @@ struct MockMatmulPlan : public se::gpu::BlasLt::MatmulPlan {","   }"," ","   absl::Status SetAlgorithm(const se::gpu::BlasLt::MatmulAlgorithm&) override {","+    ++set_algorithm_calls;","     return absl::OkStatus();","   }"," ","@@ -563,6 +638,66 @@ TEST_F(GpuBlasLtMatmulThunkTest, WorkspaceChangeRefetchesAlgorithms) {","   EXPECT_EQ(static_cast<MockMatmulPlan*>(plan)->get_algorithms_calls, 2);"," }"," ","+TEST_F(GpuBlasLtMatmulThunkTest,","+       AlgorithmDescriptorUsedAndCachedWithoutCallingGetAlgorithms) {","+  MockBlasLt blas_lt;","+  auto create_func = [&]() -> absl::StatusOr<se::gpu::BlasLt::MatmulPlanPtr> {","+    return std::make_unique<MockMatmulPlan>();","+  };","+","+  se::cuda::CublasLtMatmulAlgorithm cublaslt_algo;","+  cublaslt_algo.algo_id = 23;","+  cublaslt_algo.tile_id = 15;","+  se::gpu::BlasLtMatmulAlgorithm algorithm{","+      /*library_version=*/120800,","+      /*algorithm=*/cublaslt_algo,","+  };","+","+  se::gpu::BlasLt::MatmulPlan* plan = nullptr;","+  for (int i = 0; i < 5; ++i) {","+    ASSERT_OK_AND_ASSIGN(plan, blas_lt.GetOrCreateMatmulPlanWithAlgorithm(","+                                   \"gemm_with_proto\", create_func, algorithm,","+                                   /*max_workspace_size=*/4194304));","+  }","+","+  auto* mock_plan = static_cast<MockMatmulPlan*>(plan);","+  EXPECT_EQ(mock_plan->get_matmul_algorithm_calls, 1);","+  EXPECT_EQ(mock_plan->set_algorithm_calls, 1);","+  EXPECT_EQ(mock_plan->get_algorithms_calls, 0);","+","+  // Changing the algorithm descriptor or workspace size must invalidate the","+  // cached algorithm and re-run GetMatmulAlgorithm and SetAlgorithm.","+  cublaslt_algo.tile_id = 16;","+  algorithm.algorithm = cublaslt_algo;","+  ASSERT_OK_AND_ASSIGN(plan, blas_lt.GetOrCreateMatmulPlanWithAlgorithm(","+                                 \"gemm_with_proto\", create_func, algorithm,","+                                 /*max_workspace_size=*/4194304));","+  EXPECT_EQ(mock_plan->get_matmul_algorithm_calls, 2);","+  EXPECT_EQ(mock_plan->set_algorithm_calls, 2);","+","+  ASSERT_OK_AND_ASSIGN(plan, blas_lt.GetOrCreateMatmulPlanWithAlgorithm(","+                                 \"gemm_with_proto\", create_func, algorithm,","+                                 /*max_workspace_size=*/8388608));","+  EXPECT_EQ(mock_plan->get_matmul_algorithm_calls, 3);","+  EXPECT_EQ(mock_plan->set_algorithm_calls, 3);","+  EXPECT_EQ(mock_plan->get_algorithms_calls, 0);","+","+  // Switching to the index overload and back on the same cached plan must","+  // re-apply SetAlgorithm in both directions.","+  ASSERT_OK_AND_ASSIGN(","+      plan, blas_lt.GetOrCreateMatmulPlanWithAlgorithm(","+                \"gemm_with_proto\", create_func, /*algorithm_idx=*/0,","+                /*num_algorithms=*/128, /*max_workspace_size=*/8388608));","+  EXPECT_EQ(mock_plan->get_algorithms_calls, 1);","+  EXPECT_EQ(mock_plan->set_algorithm_calls, 4);","+","+  ASSERT_OK_AND_ASSIGN(plan,