l(std::move(columns));","+\t}","+\t// struct.*","+\tauto struct_binding = bind_context.GetMatchingBinding(star.RelationName(), star);","+\tif (!struct_binding) {","+\t\terror.Throw();","+\t}","+\tif (!struct_binding->IsNullExtended()) {","+\t\treturn nullptr;","+\t}","+\treturn make_uniq<ColumnRefExpression>(star.RelationName(), struct_binding->GetBindingAlias());","+}","+","+//! COUNT(tbl.*) counts every row of tbl, except for the rows that an outer join NULL-extended","+unique_ptr<ParsedExpression> Binder::TryRewriteQualifiedCountStar(const ParsedExpression &expr) {","+\tif (!IsQualifiedCountStar(expr)) {","+\t\treturn nullptr;","+\t}","+\tauto result = expr.Copy();","+\tif (result->GetAlias().empty()) {","+\t\t// the rewrite is an implementation detail - keep the original expression as the name","+\t\tresult->SetAlias(Identifier(expr.ToString()));","+\t}","+\tauto &arguments = GetFunctionArgumentsMutable(*result);","+\tauto &star = arguments[0].GetExpressionMutable()->Cast<StarExpression>();","+\tauto count_argument = GetCountStarArgument(star, bind_context);","+\tif (count_argument) {","+\t\targuments[0] = FunctionArgument(std::move(count_argument));","+\t} else {","+\t\targuments.clear();","+\t}","+\treturn result;","+}","+"," void Binder::ExpandStarExpression(unique_ptr<ParsedExpression> expr,","                                   vector<unique_ptr<ParsedExpression>> &new_select_list) {"," \tTryTransformStarLike(expr);"],"additions":159,"deletions":0,"truncated":false},{"path":"src/planner/binder/expression/bind_window_expression.cpp","lines":["@@ -8,6 +8,7 @@"," #include \"duckdb/parser/expression/constant_expression.hpp\""," #include \"duckdb/parser/expression/function_expression.hpp\""," #include \"duckdb/parser/expression/window_expression.hpp\"","+#include \"duckdb/planner/binder.hpp\""," #include \"duckdb/planner/expression/bound_aggregate_expression.hpp\""," #include \"duckdb/planner/expression/bound_cast_expression.hpp\""," #include \"duckdb/planner/expression/bound_columnref_expression.hpp\"","@@ -87,6 +88,10 @@ BindResult BaseSelectBinder::BindWindowExpression(WindowExpression &window, idx_"," \t\t                                           std::move(window.FilterMutable()), nullptr, window.Distinct());"," \t\treturn BindMacro(*macro, entry->Cast<ScalarMacroCatalogEntry>(), depth, macro_expr);"," \t}","+\tauto count_star = binder.TryRewriteQualifiedCountStar(window);","+\tif (count_star) {","+\t\treturn BindWindowExpression(count_star->Cast<WindowExpression>(), depth);","+\t}"," "," \tauto name = window.GetAlias();"," "],"additions":5,"deletions":0,"truncated":false},{"path":"src/planner/binder/tableref/bind_joinref.cpp","lines":["@@ -365,6 +365,18 @@ BoundStatement Binder::Bind(JoinRef &ref) {"," \t\t}"," \t}"," ","+\t// a positional join pads the shorter side with NULLs","+\tconst bool full_outer = result->type == JoinType::OUTER || ref.ref_type == JoinRefType::POSITIONAL;","+\tif (result->type == JoinType::LEFT || full_outer) {","+\t\tfor (auto &binding : right_binder.bind_context.GetBindingsList()) {","+\t\t\tbinding->SetNullExtended();","+\t\t}","+\t}","+\tif (result->type == JoinType::RIGHT || full_outer) {","+\t\tfor (auto &binding : left_binder.bind_context.GetBindingsList()) {","+\t\t\tbinding->SetNullExtended();","+\t\t}","+\t}"," \tauto right_bindings = right_binder.bind_context.GetBindingAliases();"," \tauto left_bindings = left_binder.bind_context.GetBindingAliases();"," \tbind_context.AddContext(std::move(left_binder.bind_context));"],"additions":12,"deletions":0,"truncated":false},{"path":"src/planner/table_binding.cpp","lines":["@@ -65,6 +65,14 @@ void Binding::SetColumnType(idx_t col_idx, LogicalType type_p) {"," \ttypes[col_idx] = std::move(type_p);"," }"," ","+void Binding::SetNullExtended() {","+\tnull_extended = true;","+}","+","+bool Binding::IsNullExtended() const {","+\treturn null_extended;","+}","+"," const Identifier &Binding::GetAlias() const {"," \treturn alias.GetAlias();"," }"],"additions":8,"deletions":0,"truncated":false},{"path":"test/sql/aggregate/aggregates/test_count_qualified_star.test","lines":["@@ -0,0 +1,496 @@","+# name: test/sql/aggregate/aggregates/test_count_qualified_star.test","+# description: Test COUNT over a qualified star (COUNT(tbl.*))","+# group: [aggregates]","+","+require no_force_storage","+","+statement ok","+CREATE TABLE a(id int4);","+","+statement ok","+CREATE TABLE b(id int4);","+","+statement ok","+INSERT INTO a (id) VALUES (1), (2), (3);","+","+statement ok","+INSERT INTO b (id) VALUES (2), (3), (3);","+","+query IIIII","+SELECT a.id, COUNT(*), COUNT(a.*) AS a_start, COUNT(b.*) AS b_star, COUNT(b.id) AS b_id FROM a LEFT JOIN b ON a.id = b.id GROUP BY a.id ORDER BY a.id;","+----","+1\t1\t1\t0\t0","+2\t1\t1\t1\t1","+3\t2\t2\t2\t2","+","+# multi-column relations - count over the row versus over individual columns","+statement ok","+DROP TABLE a;","+","+statement ok","+DROP TABLE b;","+","+statement ok","+CREATE TABLE a (id INT, uniq INT);","+","+statement ok","+CREATE TABLE b (id INT, uniq INT);","+","+statement ok","+INSERT INTO a VALUES (1, 100), (1, 101), (2, 102), (2, 103), (3, 104), (3, 105);","+","+statement ok","+INSERT INTO b VALUES (2, 500), (3, 502), (3, 503), (3, 504), (3, 505);","+","+query IIIIII","+SELECT","+a.id,","+COUNT(*),","+COUNT(a.*) AS a_star,","+COUNT(b.*) AS b_star,","+COUNT(b.id) AS b_id,","+COUNT(b.uniq) AS b_uniq","+FROM a","+LEFT JOIN b","+ON a.id = b.id","+GROUP BY a.id","+ORDER BY a.id;","+----","+1\t2\t2\t0\t0\t0","+2\t2\t2\t2\t2\t2","+3\t8\t8\t8\t8\t8","+","+# a partially NULL row still counts as a row, but does not count towards the NULL column","+statement ok","+INSERT INTO b VALUES (3, NULL);","+","+query IIIIII","+SELECT","+a.id,","+COUNT(*),","+COUNT(a.*) AS a_star,","+COUNT(b.*) AS b_star,","+COUNT(b.id) AS b_id,","+COUNT(b.uniq) AS b_uniq","+FROM a","+LEFT JOIN b","+ON a.id = b.id","+GROUP BY a.id","+ORDER BY a.id;","+----","+1\t2\t2\t0\t0\t0","+2\t2\t2\t2\t2\t2","+3\t10\t10\t10\t10\t8","+","+# a row in which all columns are NULL is still a row","+statement ok","+INSERT INTO b VALUES (NULL, NULL);","+","+query III","+SELECT COUNT(*), COUNT(b.*), COUNT(b.id) FROM b;","+----","+7\t7\t6","+","+# ... unless it is NULL-extended by an outer join (the unmatched all-NULL row of b is still counted)","+query IIII","+SELECT COUNT(*), COUNT(a.*), COUNT(b.*), COUNT(b.id) FROM b FULL OUTER JOIN a ON a.id = b.id;","+----","+15\t14\t13\t12","+","+# all-NULL rows that match each other are real rows on both sides","+statement ok","+CREATE TABLE nx(v INT);","+","+statement ok","+CREATE TABLE ny(v INT);","+","+statement ok","+INSERT INTO nx VALUES (NULL), (1);","+","+statement ok","+INSERT INTO ny VALUES (NULL), (2);","+","+query III","+SELECT count(*), count(nx.*), count(ny.*) FROM nx FULL OUTER JOIN ny ON nx.v IS NOT DISTINCT FROM ny.v;","+----","+3\t2\t2","+","+# a regular column that hides the row id","+statement ok","+CREATE TABLE shadow(rowid INT, v INT);","+","+statement ok","+INSERT INTO shadow VALUES (NULL, 1), (NULL, NULL);","+","+query II","+SELECT count(shadow.*), count(shadow.v) FROM a LEFT JOIN shadow ON a.id = shadow.v;","+----","+2\t2","+","+# a relation that wraps an outer join is not NULL-extended itself","+query II","+SELECT COUNT(t.*), COUNT(t.id) FROM (SELECT b.* FROM a LEFT JOIN b ON a.id = b.id) t;","+----","+14\t12","+","+# an inner join does not NULL-extend","+query I","+SELECT COUNT(b.*) FROM a JOIN b ON true WHERE a.id = 1;","+----","+14","+","+# ---- COUNT(tbl.*) in every clause that allows aggregates ----","+","+statement ok","+CREATE TABLE l(id INT);","+","+statement ok","+CREATE TABLE r(id INT, y VARCHAR);","+","+statement ok","+CREATE TABLE s(id INT, z INT);","+","+statement ok","+INSERT INTO l VALUES (1), (2), (3);","+","+statement ok","+INSERT INTO r VALUES (2, NULL), (3, 'x');","+","+statement ok","+INSERT INTO s VALUES (1, 10), (2, NULL);","+","+# the rewrite is not visible in the column name","+query I","+SELECT column_name FROM (DESCRIBE SELECT count(r.*) FROM r);","+----","+count(r.*)","+","+query I","+SELECT column_name FROM (DESCRIBE SELECT count(r.*) AS my_count FROM r);","+----","+my_count","+","+# HAVING","+query I","+SELECT l.id FROM l LEFT JOIN r ON l.id = r.id GROUP BY l.id HAVING count(r.*) > 0 ORDER BY 1;","+----","+2","+3","+","+# ORDER BY","+query I","+SELECT l.id FROM l LEFT JOIN r ON l.id = r.id GROUP BY l.id ORDER BY count(r.*), l.id;","+----","+1","+2","+3","+","+# window","+query II","+SELECT l.id, count(r.*) OVER () FROM l LEFT JOIN r ON l.id = r.id ORDER BY 1;","+----","+1\t2","+2\t2","+3\t2","+","+# window with PARTITION BY and FILTER","+query II","+SELECT l.id, count(r.*) FILTER (WHERE l.id > 1) OVER (PARTITION BY l.id) FROM l LEFT JOIN r ON l.id = r.id ORDER BY 1;","+----","+1\t0","+2\t1","+3\t1","+","+# QUALIFY","+query I","+SELECT l.id FROM l LEFT JOIN r ON l.id = r.id QUALIFY count(r.*) OVER (PARTITION BY l.id) > 0 ORDER BY 1;","+----","+2","+3","+","+# FILTER","+query I","+SELECT count(r.*) FILTER (WHERE l.id > 2) FROM l LEFT JOIN r ON l.id = r.id;","+----","+1","+","+# DISTINCT ON target","+query II","+SELECT DISTINCT ON (count(r.*)) l.id, count(r.*) FROM l LEFT JOIN r ON l.id = r.id GROUP BY l.id ORDER BY 1;","+----","+1\t0","+2\t1","+","+# GROUP BY ALL","+query II","+SELECT l.id, count(r.*) FROM l LEFT JOIN r ON l.id = r.id GROUP BY ALL ORDER BY 1;","+----","+1\t0","+2\t1","+3\t1","+","+# ROLLUP","+query II","+SELECT l.id, count(r.*) FROM l LEFT JOIN r ON l.id = r.id GROUP BY ROLLUP (l.id) ORDER BY 1 NULLS LAST;","+----","+1\t0","+2\t1","+3\t1","+NULL\t2","+","+# two different qualified stars in one expression","+query I","+SELECT count(l.*) + count(r.*) FROM l LEFT JOIN r ON l.id = r.id;","+----","+5","+","+# a root star combined with a qualified count star","+query II","+SELECT l.*, count(r.*) FROM l LEFT JOIN r ON l.id = r.id GROUP BY l.id ORDER BY 1;","+----","+1\t0","+2\t1","+3\t1","+","+# correlated scalar subquery","+# note: the empty group (which must return 0, not NULL) is covered in","+# test/sql/subquery/scalar/test_count_star_subquery.test","+query II","+SELECT l.id, (SELECT count(r.*) FROM r WHERE r.id = l.id) FROM l WHERE l.id > 1 ORDER BY 1;","+----","+2\t1","+3\t1","+","+# uncorrelated subquery in WHERE","+query I","+SELECT count(*) FROM l WHERE (SELECT count(r.*) FROM r) > 1;","+----","+3","+","+# set operations","+query I","+SELECT count(l.*) FROM l UNION ALL SELECT count(r.*) FROM r ORDER BY 1;","+----","+2","+3","+","+# ---- the relation of a qualified star ----","+","+# FULL OUTER join","+query II","+SELECT count(l.*), count(r.*) FROM l FULL OUTER JOIN r ON l.id = r.id;","+----","+3\t2","+","+# RIGHT join","+query II","+SELECT count(l.*), count(r.*) FROM r RIGHT JOIN l ON l.id = r.id;","+----","+3\t2","+","+# USING join","+query I","+SELECT count(r.*) FROM l LEFT JOIN r USING (id);","+----","+2","+","+# nested joins - both null-producing sides are counted separately","+query III","+SELECT l.id, count(r.*), count(s.*) FROM l LEFT JOIN r ON l.id = r.id LEFT JOIN s ON l.id = s.id GROUP BY l.id ORDER BY 1;","+----","+1\t0\t1","+2\t1\t1","+3\t1\t0","+","+# self join","+query II","+SELECT count(r1.*), count(r2.*) FROM r r1 LEFT JOIN r r2 ON r1.y = r2.y;","+----","+2\t1","+","+# table alias","+query I","+SELECT count(rr.*) FROM l LEFT JOIN r rr ON l.id = rr.id;","+----","+2","+","+# an alias hides the table name","+statement error","+SELECT count(r.*) FROM l LEFT JOIN r rr ON l.id = rr.id;","+----","+<REGEX>:.*Referenced table.*not found.*","+","+# quoted relation name","+query I","+SELECT count(\"R\".*) FROM r AS \"R\";","+----","+2","+","+# subquery alias","+query I","+SELECT count(t.*) FROM l LEFT JOIN (SELECT * FROM r) t ON l.id = t.id;","+----","+2","+","+# CTE","+query I","+WITH cte AS (SELECT * FROM r) SELECT count(cte.*) FROM l LEFT JOIN cte ON l.id = cte.id;","+----","+2","+","+# lateral join","+query I","+SELECT count(lat.*) FROM l, LATERAL (SELECT r.id FROM r WHERE r.id = l.id) lat;","+-