          </Column>","+","+          <Column spacing={8} style={{ width: '100%' }}>","+            <Text textStyle={{ fontSize: 18, fontWeight: 'bold' }}>Column alignment</Text>","+            {(['start', 'center', 'end'] as const).map((align) => (","+              <Column","+                key={align}","+                alignment={align}","+                style={{","+                  width: '100%',","+                  backgroundColor: track,","+                  padding: 8,","+                  borderRadius: 8,","+                }}>","+                <Column","+                  style={{ width: '40%', height: 24, backgroundColor: half, borderRadius: 4 }}","+                />","+                <Text textStyle={{ fontSize: 12 }}>{align}</Text>","+              </Column>","+            ))}","+          </Column>","+","+          <Column spacing={8} style={{ width: '100%' }}>","+            <Text textStyle={{ fontSize: 18, fontWeight: 'bold' }}>Row alignment</Text>","+            {(['start', 'center', 'end'] as const).map((align) => (","+              <Row","+                key={align}","+                testID={`universal-size-row-align-${align}`}","+                alignment={align}","+                spacing={8}","+                style={{","+                  width: '100%',","+                  height: 56,","+                  backgroundColor: track,","+                  padding: 8,","+                  borderRadius: 8,","+                }}>","+                <Row","+                  alignment=\"center\"","+                  style={{","+                    height: 24,","+                    paddingHorizontal: 8,","+                    backgroundColor: half,","+                    borderRadius: 4,","+                  }}>","+                  <Text textStyle={{ fontSize: 12, color: '#FFFFFF' }}>{align}</Text>","+                </Row>","+              </Row>","+            ))}","+            <Text textStyle={{ fontSize: 12, color: '#666666' }}>","+              The pill sets only a height. The row places it.","+            </Text>","+          </Column>","+","+          <Column style={{ height: 40 }} />","+        </Column>","+      </ScrollView>","+    </Host>","+  );","+}","+","+SizeScreen.navigationOptions = {","+  title: 'Size',","+};"],"additions":146,"deletions":0,"truncated":false},{"path":"apps/native-component-list/src/screens/UIUniversal/UIUniversalScreen.tsx","lines":["@@ -39,6 +39,14 @@ export const UIUniversalScreens = [","       return optionalRequire(() => require('./RowScreen'));","     },","   },","+  {","+    name: `${SCREEN_NAME_PREFIX}Size`,","+    route: 'ui-universal/size',","+    options: { title: 'Size' },","+    getComponent() {","+      return optionalRequire(() => require('./SizeScreen'));","+    },","+  },","   {","     name: `${SCREEN_NAME_PREFIX}ScrollView`,","     route: 'ui-universal/scrollview',"],"additions":8,"deletions":0,"truncated":false},{"path":"apps/test-suite/TestModules.ts","lines":["@@ -87,6 +87,7 @@ export function getTestModules() {","     modules.push(require('./tests/ExpoUIMeasurement'));","     modules.push(require('./tests/ExpoUIHostSize'));","     modules.push(require('./tests/ExpoUIRNHostViewSize'));","+    modules.push(require('./tests/ExpoUIUniversalSize'));","     modules.push(require('./tests/AppMetrics'));","     modules.push(require('./tests/Blob'));","     modules.push(require('./tests/FileSystem'));"],"additions":1,"deletions":0,"truncated":false},{"path":"apps/test-suite/tests/ExpoUIUniversalSize.tsx","lines":["@@ -0,0 +1,255 @@","+import { Column, Host, Row, type ColumnProps } from '@expo/ui';","+import React from 'react';","+import { Platform, View } from 'react-native';","+","+import type { JasmineInterface, TestPortal } from '../types';","+import { mountAndWaitForWithTimeout } from './helpers';","+","+export const name = 'ExpoUI Universal size';","+export const route = 'expo-ui-universal-size';","+","+// `onLayout` is the Host frame from `style`. `onLayoutContent` is the native content size.","+// The wrapper is wider than the Host, so a percentage is of the Host and not of that wrapper.","+const SETTLE_MS = 250;","+const TIMEOUT_MS = 10000;","+// Anything under a point is rounding between the two measurement systems.","+const TOLERANCE = 1;","+","+const PARENT_WIDTH = 300;","+const HOST_WIDTH = 200;","+const HOST_HEIGHT = 100;","+","+type Axes = { width: number; height: number };","+type Measured = { laid: Axes; content: Axes };","+type Modifier = NonNullable<ColumnProps['modifiers']>[number];","+","+/** A platform modifier that reports the size of the view it is on, in points. */","+function sizeReporter(onSize: (size: Axes) => void): Modifier {","+  if (Platform.OS === 'ios') {","+    const { onGeometryChange } = require('@expo/ui/swift-ui/modifiers');","+    return onGeometryChange(({ width, height }: Axes) => onSize({ width, height }));","+  }","+  const { onSizeChanged } = require('@expo/ui/jetpack-compose/modifiers');","+  return onSizeChanged(onSize);","+}","+","+/** Reports both sizes once layout has been quiet for `SETTLE_MS`. */","+function useSettledSize(onSettled: (measured: Measured) => void) {","+  const sizes = React.useRef<{ laid?: Axes; content?: Axes }>({});","+  const settle = React.useRef<ReturnType<typeof setTimeout> | undefined>(undefined);","+  const onSettledRef = React.useRef(onSettled);","+","+  React.useEffect(() => {","+    onSettledRef.current = onSettled;","+  });","+","+  React.useEffect(() => () => clearTimeout(settle.current), []);","+","+  const scheduleReport = React.useCallback(() => {","+    clearTimeout(settle.current);","+    settle.current = setTimeout(() => {","+      const { laid, content } = sizes.current;","+      if (laid && content) {","+        onSettledRef.current({ laid, content });","+      }","+    }, SETTLE_MS);","+  }, []);","+","+  const onLayout = React.useCallback(","+    (event: { nativeEvent: { layout: Axes } }) => {","+      const { width, height } = event.nativeEvent.layout;","+      sizes.current.laid = { width, height };","+      scheduleReport();","+    },","+    [scheduleReport]","+  );","+","+  const onLayoutContent = React.useCallback(","+    (event: { nativeEvent: Axes }) => {","+      const { width, height } = event.nativeEvent;","+      sizes.current.content = { width, height };","+      scheduleReport();","+    },","+    [scheduleReport]","+  );","+","+  return { onLayout, onLayoutContent };","+}","+","+function SizeProbe({","+  children,","+  onMeasured,","+}: {","+  children: React.ReactNode;","+  onMeasured: (measured: Measured) => void;","+}) {","+  const { onLayout, onLayoutContent } = useSettledSize(onMeasured);","+","+  return (","+    <View style={{ width: PARENT_WIDTH }}>","+      <Host","+        style={{ width: HOST_WIDTH, height: HOST_HEIGHT }}","+        onLayout={onLayout}","+        onLayoutContent={onLayoutContent}>","+        {children}","+      </Host>","+    </View>","+  );","+}","+","+/** Reports the size of the child that carries `report`, once layout has been quiet for `SETTLE_MS`. */","+function ChildSizeProbe({","+  children,","+  onMeasured,","+}: {","+  children: (report: Modifier) => React.ReactNode;","+  onMeasured: (size: Axes) => void;","+}) {","+  const settle = React.useRef<ReturnType<typeof setTimeout> | undefined>(undefined);","+  const onMeasuredRef = React.useRef(onMeasured);","+","+  React.useEffect(() => {","+    onMeasuredRef.current = onMeasured;","+  });","+","+  React.useEffect(() => () => clearTimeout(settle.current), []);","+","+  const report = React.useMemo(","+    () =>","+      sizeReporter((size) => {","+        clearTimeout(settle.current);","+        settle.current = setTimeout(() => onMeasuredRef.current(size), SETTLE_MS);","+      }),","+    []","+  );","+","+  return (","+    <View style={{ width: PARENT_WIDTH }}>","+      <Host style={{ width: HOST_WIDTH, height: HOST_HEIGHT }}>{children(report)}</Host>","+    </View>","+  );","+}","+","+export async function test(","+  { it, describe, expect, afterEach }: JasmineInterface,","+  { setPortalChild, cleanupPortal }: TestPortal","+) {","+  const expectNear = (actual: number, expected: number) => {","+    expect(Math.abs(actual - expected)).toBeLessThan(TOLERANCE);","+  };","+","+  const measure = (children: React.ReactNode) =>","+    mountAndWaitForWithTimeout<Measured>(","+      <SizeProbe onMeasured={() => {}}>{children}</SizeProbe>,","+      'onMeasured',","+      setPortalChild,","+      TIMEOUT_MS","+    );","+","+  const measureChild = (children: (report: Modifier) => React.ReactNode) =>","+    mountAndWaitForWithTimeout<Axes>(","+      <ChildSizeProbe onMeasured={() => {}}>{children}</ChildSizeProbe>,","+      'onMeasured',","+      setPortalChild,","+      TIMEOUT_MS","+    );","+","+  describe(name, () => {","+    afterEach(async () => {","+      await cleanupPortal();","+    });","+","+    it('lays a 100% column out at the host size', async () => {","+      const measured = await measure(<Column style={{ width: '100%', height: '100%' }} />);","+","+      expectNear(measured.laid.width, HOST_WIDTH);","+      expectNear(measured.laid.height, HOST_HEIGHT);","+      expectNear(measured.content.width, HOST_WIDTH);","+      expectNear(measured.content.height, HOST_HEIGHT);","+    });","+","+    it('lays a column out at half the host width', async () => {","+      const measured = await measure(<Column style={{ width: '50%', height: '100%' }} />);","+","+      expectNear(measured.laid.width, HOST_WIDTH);","+      expectNear(measured.laid.height, HOST_HEIGHT);","+      expectNear(measured.content.width, HOST_WIDTH / 2);","+      expectNear(measured.content.height, HOST_HEIGHT);","+    });","+","+    it('lays a column out at a fraction of the host height', async () => {","+      const measured = await measure(<Column style={{ width: '100%', height: '40%' }} />);","+","+      expectNear(measured.laid.width, HOST_WIDTH);","+      expectNear(measured.laid.height, HOST_HEIGHT);","+      expectNear(measured.content.width, HOST_WIDTH);","+      expectNear(measured.content.height, HOST_HEIGHT * 0.4);","+    });","+","+    it('lays a fixed-size column out in points inside a larger host', async () => {","+      const measured = await measure(<Column style={{ width: 80, height: 36 }} />);","+","+      expectNear(measured.laid.width, HOST_WIDTH);","+      expectNear(measured.laid.height, HOST_HEIGHT);","+      expectNear(measured.content.width, 80);","+      expectNear(measured.content.height, 36);","+    });","+","+    it('lays a 0% wide column out with no width', async () => {","+      // The child has its own width. If `0%` were ignored, the content would be at least this wide.","+      const measured = await measure(","+        <Column style={{ width: '0%', height: '100%' }}>","+          <Column style={{ width: 40, height: 20 }} />","+        </Column>","+      );","+","+      expectNear(measured.laid.width, HOST_WIDTH);","+      expectNear(measured.laid.height, HOST_HEIGHT);","+      expectNear(measured.content.width, 0);","+      expectNear(measured.content.height, HOST_HEIGHT);","+    });","+","+    it('lays a row out at a fraction of the host width', async () => {","+      const measured = await measure(<Row spacing={0} style={{ width: '60%', height: '100%' }} />);","+","+      expectNear(measured.laid.width, HOST_WIDTH);","+      expectNear(measured.laid.height, HOST_HEIGHT);","+      expectNear(measured.content.width, HOST_WIDTH * 0.6);","+      expectNear(measured.content.height, HOST_HEIGHT);","+    });","+","+    it('lays a percentage child out against its column', async () => {","+      const size = await measureChild((report) => (","+        <Column style={{ width: '100%', height: '100%' }}>","+          <Column style={{ width: '50%', height: '25%' }} modifiers={[report]} />","+        </Column>","+      ));","+","+      expectNear(size.width, HOST_WIDTH / 2);","+      expectNear(size.height, HOST_HEIGHT / 4);","+    });","+","+    it('lays a percentage child out against its row', async () => {","+      const size = await measureChild((report) => (","+        <Row spacing={0} style={{ width: '100%', height: '100%' }}>","+          <Column style={{ width: '30%', height: '50%' }} modifiers={[report]} />","+          <Column style={{ width: '70%', height: '100%' }} />","+        </Row>","+      ));","+","+      expectNear(size.width, HOST_WIDTH * 0.3);","+      expectNear(size.height, HOST_HEIGHT / 2);","+    });","+","+    it('lays a nested percentage out against the column and not the host', async () => {","+      const size = await measureChild((report) => (","+        <Column style={{ width: 120, height: '100%' }}>","+          <Column style={{ width: '50%', height: 20 }} modifiers={[report]} />","+        </Column>","+      ));","+","+      expectNear(size.width, 60);","+      expectNear(size.height, 20);","+    });","+  });","+}"],"additions":255,"deletions":0,"truncated":false},{"path":"packages/expo-ui/src/universal/Column/index.tsx","lines":["@@ -1,13 +1,16 @@"," import { Pressable, StyleSheet, View, type ViewStyle } from 'react-native';"," "," import { useUniversalLifecycle } from '../hooks';","+import { StackAxisContext, useCrossAxisSize } from '../stackAxis';"," import type { UniversalAlignment } from '../types';"," import type { ColumnProps } from './types';"," "," const styles = StyleSheet.create({","-  // `alignSelf: 'stretch'` — match SwiftUI `VStack` / Compose `Column`, which fill their parent's cross-axis.","-  // Without this, a nested Column inherits its parent's `alignItems` (often `flex-start`) and shrinks to content.","-  column: { flexDirection: 'column', alignSelf: 'stretch' },","+  column: { flexDirection: 'column' },","+  // Fill the parent's cross axis when this column has no size of its own on that axis.","+  // A set size must not use stretch: that overrides the parent's `alignItems`,","+  // and the column then sits at the start.","+  stretch: { alignSelf: 'stretch' },","   hidden: { display: 'none' },","   disabled: {","     opacity: 0.5,","@@ -37,6 +40,7 @@ export function Column({","   testID,"," }: ColumnProps) {","   useUniversalLifecycle(onAppear, onDisappear);","+  const crossAxisSize = useCrossAxisSize(style);"," ","   const Container = onPress ? Pressable : View;"," ","@@ -47,13 +51,14 @@ export function Column({","       testID={testID}","       style={[","         styles.column,","+        crossAxisSize == null && styles.stretch,","         alignmentStyles[alignment],","         spacing != null && { gap: spacing },","         style,","         hidden && styles.hidden,","         disabled && styles.disabled,","       ]}>","-      {children}","+      <StackAxisContext.Provider value=\"vertical\">{children}</StackAxisContext.Provider>","     </Container>","   );"," }"],"additions":9,"deletions":4,"truncated":false},{"path":"packages/expo-ui/src/universal/Row/index.tsx","lines":["@@ -1,19 +1,16 @@"," import { Pressable, StyleSheet, View, type ViewStyle } from 'react-native';"," "," import { useUniversalLifecycle } from '../hooks';","+import { StackAxisContext, useCrossAxisSize } from '../stackAxis';"," import type { UniversalAlignment } from '../types';"," import type { RowProps } from './types';"," "," const styles = StyleSheet.create({","-  row: {","-    // Fill the parent's cross-axis by default so a `<Spacer flexible />`","-    // child has room to grow. Without this, a Row placed inside a `Column`","-    // with alignment other than 'stretch' is content-sized on web, which","-    // leaves flex children with no leftover space. SwiftUI and Compose","-    // achieve the same effect via their own layout phases.","-    alignSelf: 'stretch',","-    flexDirection: 'row',","-  },","+  row: { flexDirection: 'row' },","+  // Fill the parent's cross axis when this row has no size of its own on that axis,","+  // so a flexible child still has leftover space. A set size must not use","+  // stretch, or the parent's alignment cannot move it.","+  stretch: { alignSelf: 'stretch' },","   hidden: { display: 'none' },","   disabled: {","     opacity: 0.5,","@@ -43,6 +40,7 @@ export function Row({","   testID,"," }: RowProps) {","   useUniversalLifecycle(onAppear, onDisappear);","+  const crossAxisSize = useCrossAxisSize(style);"," ","   const Container = onPress ? Pressable : View;"," ","@@ -53,13 +51,14 @@ export function Row({","       testID={testID}","       style={[","         styles.row,","+        crossAxisSize == null && styles.stretch,","         alignmentStyles[alignment],","         spacing != null && { gap: spacing },","         style,","         hidden && styles.hidden,","         disabled && styles.disabled,","       ]}>","-      {children}","+      <StackAxisContext.Provider value=\"horizontal\">{children}</StackAxisContext.Provider>","     </Container>","   );"," }"],"additions":9,"deletions":10,"truncated":false},{"path":"packages/expo-ui/src/universal/stackAxis.ts","lines":["@@ -0,0 +1,17 @@","+import { createContext, useContext } from 'react';","+","+import type { UniversalStyle } from './types';","+","+export type StackAxis = 'horizontal' | 'vertical';","+","+/**","+ * Main axis of the nearest universal `Row` or `Column` on web.","+ * A plain view lays its children out vertically, so that is the default.","+ */","+export const StackAxisContext = createContext<StackAxis>('vertical');","+","+/** The size `style` sets on the parent's cross axis, if any. */","+export function useCrossAxisSize(style: UniversalStyle | undefined) {","+  const parentAxis = useContext(StackAxisContext);","+  return parentAxis === 'horizontal' ? style?.height : style?.width;","+}",""],"additions":17,"deletions":0,"truncated":false}],"additions":450,"deletions":14,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-10-22T13:45:02.080922+00:00"}