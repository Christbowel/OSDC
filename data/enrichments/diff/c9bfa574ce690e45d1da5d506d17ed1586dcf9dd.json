{"id":"c9bfa574ce690e45d1da5d506d17ed1586dcf9dd","axis":"silent","repo":"vllm-project/vllm","sha":"c9bfa574ce690e45d1da5d506d17ed1586dcf9dd","parsed":{"files":[{"path":"docs/features/quantization/online.md","lines":["@@ -111,7 +111,10 @@ Currently supported combinations are:"," "," | Checkpoint layer | Online target | Requirements |"," | ---------------- | ------------- | ------------ |","-| Serialized ModelOpt MXFP8 linear | any | Target-specific hardware requirements |","+| Serialized ModelOpt MXFP8 linear | any online linear method | Target-specific hardware requirements |","+| Serialized compressed-tensors NVFP4 MoE | any online MoE method | Target-specific hardware requirements |","+| Serialized ModelOpt NVFP4 MoE | any online MoE method | Target-specific hardware requirements |","+| Serialized Quark NVFP4 MoE | any online MoE method | Target-specific hardware requirements |"," "," For example, serialized ModelOpt MXFP8 linears can be converted to"," per-channel-weight/per-token-activation FP8 at load time:","@@ -122,10 +125,18 @@ vllm serve MiniMaxAI/MiniMax-M3-MXFP8 \\","   --quantization-config.linear fp8_per_channel"," ```"," ","+Similarly, for example, NVFP4 MoE checkpoints can be re-quantized to any online MoE method,","+for example compressed-tensors NVFP4 experts to online MXFP4:","+","+```bash","+vllm serve RedHatAI/Qwen3-30B-A3B-NVFP4 \\","+  --quantization-config '{\"targets\":{\"*mlp.experts*\":\"mxfp4\"}}'","+```","+"," !!! info"," ","-    This is only available for linear layers at the moment.","-    ","+    Re-quantization is available for both linear and MoE layers.","+","     Checkpoint-exclusion policy is not enforced by online quantization/re-quantization. Only exclusion through `--quantization-config.targets`/`--quantization-config.ignore` is enforced. "," "," ### Online quantization on unquantized layers from partially-quantized checkpoints"],"additions":14,"deletions":3,"truncated":false},{"path":"tests/quantization/test_online.py","lines":["@@ -42,11 +42,13 @@","     MarlinFP8ScaledMMLinearKernel,"," )"," from vllm.model_executor.layers.attention import Attention","-from vllm.model_executor.layers.fused_moe import FusedMoEFactory","+from vllm.model_executor.layers.fused_moe import FusedMoEFactory, RoutedExperts"," from vllm.model_executor.layers.fused_moe.oracle import nvfp4 as nvfp4_oracle"," from vllm.model_executor.layers.linear import (","     ColumnParallelLinear,","     LinearBase,","+    MergedColumnParallelLinear,","+    RowParallelLinear,","     UnquantizedLinearMethod,"," )"," from vllm.model_executor.layers.quantization.auto_awq import AutoAWQConfig","@@ -57,10 +59,15 @@"," from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors_moe import (  # noqa: E501","     CompressedTensorsMoEMethod,"," )","+from vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors_moe.compressed_tensors_moe_w4a4_nvfp4 import (  # noqa: E501","+    CompressedTensorsW4A4Nvfp4MoEMethod,","+)"," from vllm.model_executor.layers.quantization.modelopt import (","     ModelOptFp8Config,","     ModelOptLinearMethod,","     ModelOptMxFp8Config,","+    ModelOptNvFp4Config,","+    ModelOptNvFp4FusedMoE,"," )"," from vllm.model_executor.layers.quantization.online.base import (","     OnlineQuantizationConfig,","@@ -84,6 +91,7 @@"," )"," from vllm.model_executor.layers.quantization.online.mxfp8 import (","     Mxfp8OnlineLinearMethod,","+    Mxfp8OnlineMoEMethod,"," )"," from vllm.model_executor.layers.quantization.online.nvfp4 import (","     Nvfp4OnlineMoEMethod,","@@ -93,16 +101,23 @@","     QuarkConfig,","     QuarkLinearMethod,"," )","+from vllm.model_executor.layers.quantization.quark.quark_moe import (","+    QuarkNvfp4MoEMethod,","+)"," from vllm.model_executor.layers.quantization.utils import quant_utils"," from vllm.model_executor.layers.quantization.utils.mxfp8_utils import (","     MXFP8_SCALE_DTYPE,","     MXFP8_VALUE_DTYPE,"," )","+from vllm.model_executor.layers.quantization.utils.nvfp4_emulation_utils import (","+    ref_nvfp4_quant,","+)"," from vllm.model_executor.layers.quantization.utils.quant_utils import (","     amax_for_moe_weight_quant,","     amax_for_tp_weight_quant,","     kMxfp8Dynamic,","     kMxfp8Static,","+    kNvfp4Dynamic,","     kNvfp4DynamicToken,","     kNvfp4Static,","     weight_amax,","@@ -113,6 +128,12 @@"," from vllm.model_executor.model_loader import weight_utils"," from vllm.model_executor.model_loader.base_loader import log_online_quantization"," from vllm.model_executor.model_loader.dummy_loader import DummyModelLoader","+from vllm.model_executor.model_loader.reload.layerwise import (","+    finalize_layerwise_reload,","+    initialize_layerwise_reload,","+    record_metadata_for_reloading,","+)","+from vllm.model_executor.model_loader.weight_utils import default_weight_loader"," from vllm.model_executor.models.granitemoe import (","     GraniteMoeModel,"," )","@@ -136,6 +157,8 @@ def on_gfx942() -> bool:"," PARTIALLY_PREQUANTIZED_MODEL_NAME = (","     \"nm-testing/tinysmokeqwen3moe-W4A16-first-only-CTstable\""," )","+NVFP4_MOE_MODEL_NAME = \"RedHatAI/Qwen3-30B-A3B-NVFP4\"","+MODELOPT_NVFP4_MOE_MODEL_NAME = \"nvidia/Qwen3-30B-A3B-NVFP4\""," "," "," @pytest.mark.parametrize(","@@ -507,36 +530,750 @@ def test_online_ignore_keeps_checkpoint_quantization_linear(","     assert isinstance(layer.quant_method, QuarkLinearMethod)"," "," ","-def test_online_quantization_rejects_prequantized_moe(","-    default_vllm_config, dist_init, monkeypatch","+def test_online_quantization_configures_prequantized_moe(","+    default_vllm_config, dist_init"," ) -> None:","-    \"\"\"Reject pre-quantized MoE before constructing an online target backend.\"\"\"","+    \"\"\"Configure the checkpoint method as the online MoE's weight source.\"\"\"","     default_vllm_config.model_config = ModelConfig()","     prefix = \"model.layers.0.mlp.experts\"","     quant_config = _fully_quantized_quark_config()","     quant_config.online_quantization_config = OnlineQuantizationConfig(","         quant_config_args(linear=\"mxfp4\", moe=\"mxfp4\")","     )","+","+    layer = FusedMoEFactory(","+        num_experts=4,","+        top_k=2,","+        hidden_size=32,","+        intermediate_size=64,","+        params_dtype=torch.bfloat16,","+        quant_config=quant_config,","+        prefix=prefix,","+    )","+","+    assert isinstance(layer._quant_method, Mxfp4OnlineMoEMethod)","+    assert layer._quant_method.requantization_source is not None","+","+","+def _pack_e2m1(values: torch.Tensor) -> torch.Tensor:","+    codes = torch.zeros_like(values, dtype=torch.uint8)","+    for code, magnitude in enumerate((0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0)):","+        codes[values.abs() == magnitude] = code","+    codes |= (values < 0).to(torch.uint8) << 3","+    return codes[..., 0::2] | (codes[..., 1::2] << 4)","+","+","+def _serialize_nvfp4_experts(","+    weights: torch.Tensor, global_scales: torch.Tensor","+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:","+    packed_weights = []","+    block_scales = []","+    reconstructed_weights = []","+    for weight, global_scale in zip(weights, global_scales, strict=True):","+        fp4_values, block_scale = ref_nvfp4_quant(weight, global_scale, block_size=16)","+        packed_weights.append(_pack_e2m1(fp4_values))","+        block_scales.append(block_scale.to(torch.float8_e4m3fn))","+        reconstructed_weights.append(","+            (","+                fp4_values.reshape(*fp4_values.shape[:-1], -1, 16)","+                * (block_scale / global_scale).unsqueeze(-1)","+            )","+            .reshape_as(weight)","+            .to(weight.dtype)","+        )","+    return (","+        torch.stack(packed_weights),","+        torch.stack(block_scales),","+        torch.stack(reconstructed_weights),","+    )","+","+","+def _make_nvfp4_moe_source(source_format: str, moe, monkeypatch):","+    if source_format == \"compressed_tensors\":","+        monkeypatch.setattr(","+            \"vllm.model_executor.layers.quantization.compressed_tensors.\"","+            \"compressed_tensors_moe.compressed_tensors_moe_w4a4_nvfp4.\"","+            \"select_nvfp4_moe_backend\",","+            lambda **kwargs: (object(), None),","+        )","+        monkeypatch.setattr(","+            \"vllm.model_executor.layers.quantization.compressed_tensors.\"","+            \"compressed_tensors_moe.compressed_tensors_moe_w4a4_nvfp4.\"","+            \"is_global_sf_supported_for_nvfp4_backend\",","+            lambda backend: False,","+        )","+        return CompressedTensorsW4A4Nvfp4MoEMethod(moe)","+","+    if source_format == \"quark\":","+        monkeypatch.setattr(","+            \"vllm.model_executor.layers.quantization.quark.quark_moe.\"","+            \"select_nvfp4_moe_backend\",","+            lambda **kwargs: (object(), None),","+        )","+        return QuarkNvfp4MoEMethod(","+            moe=moe,","+            quant_config=QuarkConfig({}),","+            activation_quant_key=kNvfp4Dynamic,","+        )","+","     monkeypatch.setattr(","-        quant_config.online_quantization_config,","-        \"get_quant_method\",","-        lambda *args: pytest.fail(\"unsupported online backend must not be constructed\"),","+        \"vllm.model_executor.layers.quantization.modelopt.select_nvfp4_moe_backend\",","+        lambda **kwargs: (object(), None),","+    )","+    monkeypatch.setattr(","+        \"vllm.model_executor.layers.quantization.modelopt.\"","+        \"is_global_sf_supported_for_nvfp4_backend\",","+        lambda backend: False,","     )","+    config = ModelOptNvFp4Config(","+        is_checkpoint_nvfp4_serialized=True,","+        kv_cache_quant_algo=None,","+        exclude_modules=[],","+    )","+    return ModelOptNvFp4FusedMoE(config, moe)","+","+","+def _nvfp4_moe_checkpoint_tensors(","+    source_format: str,","+    w1: torch.Tensor,","+    w3: torch.Tensor,","+    w2: torch.Tensor,","+    w1_global_scale: torch.Tensor,","+    w3_global_scale: torch.Tensor,","+    w2_global_scale: torch.Tensor,","+) -> tuple[dict[str, torch.Tensor], torch.Tensor, torch.Tensor]:","+    w1_packed, w1_scale, w1_reference = _serialize_nvfp4_experts(w1, w1_global_scale)","+    w3_packed, w3_scale, w3_reference = _serialize_nvfp4_experts(w3, w3_global_scale)","+    w2_packed, w2_scale, w2_reference = _serialize_nvfp4_experts(w2, w2_global_scale)","+    tensors = {","+        \"w13_weight_scale\": torch.cat((w1_scale, w3_scale), dim=1),","+        \"w2_weight_scale\": w2_scale,","+    }","+    if source_format == \"compressed_tensors\":","+        tensors.update(","+            {","+                \"w13_weight_packed\": torch.cat((w1_packed, w3_packed), dim=1),","+                \"w2_weight_packed\": w2_packed,","+                \"w13_weight_global_scale\": torch.stack(","+                    (w1_global_scale, w3_global_scale), dim=1","+                ),","+                \"w2_weight_global_scale\": w2_global_scale,","+                \"w13_input_global_scale\": torch.ones_like(","+                    torch.stack((w1_global_scale, w3_global_scale), dim=1)","+                ),","+                \"w2_input_global_scale\": torch.ones_like(w2_global_scale),","+            }","+        )","+    else:","+        tensors.update(","+            {","+                \"w13_weight\": torch.cat((w1_packed, w3_packed), dim=1),","+                \"w2_weight\": w2_packed,","+                \"w13_weight_scale_2\": 1.0","+                / torch.stack((w1_global_scale, w3_global_scale), dim=1),","+                \"w2_weight_scale_2\": 1.0 / w2_global_scale,","+                (","+                    \"w13_input_scale_2\"","+                    if source_format == \"quark\"","+                    else \"w13_input_scale\"","+                ): torch.ones_like(","+                    torch.stack((w1_global_scale, w3_global_scale), dim=1)","+                ),","+                (","+                    \"w2_input_scale_2\" if source_format == \"quark\" else \"w2_input_scale\"","+                ): torch.ones_like(w2_global_scale),","+            }","+        )","+    return tensors, torch.cat((w1_reference, w3_reference), dim=1), w2_reference"," ","-    with pytest.raises(","-        NotImplementedError,","-        match=\"Requantizing checkpoint-quantized MoE layers is not supported\",","+","+@pytest.mark.skip_global_cleanup","+@pytest.mark.parametrize(\"tp_rank\", [0, 1])","+@pytest.mark.parametrize(\"projection\", [\"column\", \"row\", \"merged\"])","+@pytest.mark.parametrize(\"source_format\", [\"modelopt_mxfp8\"])","+def test_weight_loading_requantization(","+    source_format: str,","+    projection: str,","+    tp_rank: int,","+    default_vllm_config,","+    monkeypatch,","+) -> None:","+    \"\"\"Checkpoint sources retain parameter-specific loaders under online overrides.\"\"\"","+    default_vllm_config.model_config = SimpleNamespace(dtype=torch.bfloat16)","+    for module in (","+        \"vllm.model_executor.layers.linear\",","+        \"vllm.model_executor.parameter\",","     ):","-        FusedMoEFactory(","-            num_experts=4,","-            top_k=2,","-            hidden_size=32,","-            intermediate_size=64,","+        monkeypatch.setattr(f\"{module}.get_tensor_model_parallel_rank\", lambda: tp_rank)","+        monkeypatch.setattr(f\"{module}.get_tensor_model_parallel_world_size\", lambda: 2)","+    if source_format == \"modelopt_mxfp8\":","+        monkeypatch.setattr(","+            \"vllm.model_executor.layers.quantization.modelopt.init_mxfp8_linear_kernel\",","+            lambda **kwargs: Mock(),","+        )","+        config = _fully_quantized_modelopt_mxfp8_config()","+        expected_source_cls = ModelOptLinearMethod","+    else:","+        pytest.fail(f\"Unsupported checkpoint source: {source_format}\")","+    config.online_quantization_config = OnlineQuantizationConfig(","+        quant_config_args(linear=\"fp8_per_channel\")","+    )","+    kwargs = dict(","+        input_size=128,","+        bias=False,","+        params_dtype=torch.bfloat16,","+        quant_config=config,","+        prefix=\"model.layers.0.self_attn.o_proj\",","+    )","+    if projection == \"merged\":","+        layer = MergedColumnParallelLinear(output_sizes=[64, 64], **kwargs)","+    elif projection == \"row\":","+        layer = RowParallelLinear(output_size=64, **kwargs)","+    else:","+        layer = ColumnParallelLinear(output_size=64, **kwargs)","+    target = layer.quant_method","+    # Online processing must remain assigned to the requested target.","+    assert isinstance(target, Fp8PtpcOnlineLinearMethod)","+    source = target.requantization_source","+    # Checkpoint parameters must belong to the selected source method.","+    assert isinstance(source, expected_source_cls)","+    for name in (\"weight\", \"weight_scale\"):","+        # Source registration must choose V2 rather than the online target's loader.","+        assert getattr(layer, name).weight_loader == layer.weight_loader_v2","+","+    torch.manual_seed(11)","+    rows = 128 if projection == \"merged\" else 64","+    if source_format == \"modelopt_mxfp8\":","+        checkpoint = {","+            \"weight\": torch.randn(rows, 128, dtype=torch.bfloat16).to(","+                MXFP8_VALUE_DTYPE","+            ),","+            \"weight_scale\": torch.randint(124, 131, (rows, 4), dtype=MXFP8_SCALE_DTYPE),","+        }","+    else:","+        pytest.fail(f\"Unsupported checkpoint source: {source_format}\")","+    expected = {}","+    for name, tensor in checkpoint.items():","+        param = getattr(layer, name)","+        if projection == \"merged\":","+            for shard, part in enumerate(tensor.chunk(2, dim=0)):","+                param.weight_loader(param, part, shard)","+            expected[name] = torch.cat(","+                [part.chunk(2, dim=0)[tp_rank] for part in tensor.chunk(2, dim=0)]","+            )","+        else:","+            param.weight_loader(param, tensor)","+            expected[name] = tensor.chunk(2, dim=1 if projection == \"row\" else 0)[","+                tp_rank","+            ]","+        # TP loading must preserve each source weight/scale shard exactly.","+        torch.testing.assert_close(param.cpu(), expected[name], rtol=0, atol=0)","+    actual_weight = source.dequantize_weight(layer)","+    reference = source.dequantize_weight(SimpleNamespace(**expected))","+    # Loaded source shards must dequantize identically to their checkpoint slices.","+    torch.testing.assert_close(actual_weight.cpu(), reference.cpu(), rtol=0, atol=0)","+    # Source loading must leave the online processing method attached.","+    assert layer.quant_method is target","+","+","+@pytest.mark.skip_global_cleanup","+@pytest.mark.parametrize(","+    \"source_format\",","+    [","+        pytest.param(\"compressed_tensors\", id=\"compressed_tensors_nvfp4\"),","+        pytest.param(\"modelopt\", id=\"modelopt_nvfp4\"),","+        pytest.param(\"quark\", id=\"quark_nvfp4\"),","+    ],","+)","+def test_weight_loading_requantization_moe(","+    source_format: str, default_vllm_config, monkeypatch","+) -> None:","+    \"\"\"Online re-quantization uses the original quant method for loading.\"\"\"","+    from tests.kernels.moe.utils import make_dummy_moe_config","+","+    # Loading local experts needs parameter TP metadata, not a process group.","+    monkeypatch.setattr(","+        \"vllm.model_executor.parameter.get_tensor_model_parallel_rank\", lambda: 0","+    )","+    monkeypatch.setattr(","+        \"vllm.model_executor.parameter.get_tensor_model_parallel_world_size\", lambda: 1","+    )","+    default_vllm_config.model_config = SimpleNamespace(dtype=torch.bfloat16)","+    monkeypatch.setattr(","+        \"vllm.model_executor.layers.quantization.online.fp8.select_fp8_moe_backend\",","+        lambda **kwargs: (None, None),","+    )","+    config = make_dummy_moe_config(num_experts=2, hidden_dim=32, intermediate_size=64)","+    source = _make_nvfp4_moe_source(source_format, config, monkeypatch)","+    quant_config = Mock()","+    quant_config.packed_modules_mapping = {}","+    quant_config.get_name.return_value = source_format","+    quant_config.get_quant_method.return_value = source","+    quant_config.online_quantization_config = OnlineQuantizationConfig(","+        quant_config_args(moe=\"fp8_per_tensor\")","+    )","+    prefix = \"model.layers.0.mlp.experts\"","+    layer = RoutedExperts(","+        prefix,","+        torch.bfloat16,","+        config,","+        quant_config,","+        expert_map_manager=SimpleNamespace(","+            local_num_experts=2,","+            num_fused_shared_experts=0,","+            placement_strategy=\"linear\",","+            expert_map=None,","+            expert_mask=None,","+            routing_tables=None,","+            map_global_to_local=lambda index: index,","+        ),","+    )","+    target = layer.quant_method","+    # Construction must select the override, not execute the checkpoint method.","+    assert isinstance(target, Fp8PerTensorOnlineMoEMethod)","+    # Source allocation and loading must use the original checkpoint method.","+    assert target.requantization_source is source","+    # Requantization requires a checkpoint source for dequantization.","+    assert source is not None","+    torch.manual_seed(11)","+    w1 = torch.randn(2, 64, 32, dtype=torch.bfloat16)","+    w3 = torch.randn_like(w1)","+    w2 = torch.randn(2, 32, 64, dtype=torch.bfloat16)","+    tensors, expected_w13, expected_w2 = _nvfp4_moe_checkpoint_tensors(","+        source_format,","+        w1,","+        w3,","+        w2,","+        torch.tensor([96.0, 160.0]),","+        torch.tensor([40.0, 72.0]),","+        torch.tensor([128.0, 56.0]),","+    )","+    # Distinct input scales expose gate/up overwrites independently of dequantization.","+    # Quark's existing input-scale loader broadcasts each shard across both slots.","+    input_name = {","+        \"compressed_tensors\": \"w13_input_global_scale\",","+        \"modelopt\": \"w13_input_scale\",","+        \"quark\": \"w13_input_scale_2\",","+    }[source_format]","+    tensors[input_name] = torch.tensor(","+        [[0.25, 0.25], [0.75, 0.75]]","+        if source_format == \"quark\"","+        else [[0.25, 0.5], [0.75, 1.0]]","+    )","+    checkpoint = []","+    for name, tensor in tensors.items():","+        stem, suffix = name.split(\"_\", 1)","+        projections = (\"gate_proj\", \"up_proj\") if stem == \"w13\" else (\"down_proj\",)","+        for expert in range(2):","+            parts = (","+                tensor[expert].chunk(2, dim=0) if stem == \"w13\" else (tensor[expert],)","+            )","+            for projection, part in zip(projections, parts, strict=True):","+                checkpoint.append((f\"{expert}.{projection}.{suffix}\", part))","+    loaded = set(layer.load_weights(checkpoint))","+","+    # Every source parameter must be reached through checkpoint-name mapping.","+    assert loaded == set(tensors)","+","+    for name, expected in tensors.items():","+        # Public loading must preserve all packed weights and scale conventions.","+        torch.testing.assert_close(getattr(layer, name).cpu(), expected, rtol=0, atol=0)","+    actual_w13, actual_w2 = source.dequantize_weight(layer)","+","+    # Gate/up ordering and distinct global scales must survive source loading.","+    torch.testing.assert_close(actual_w13.cpu(), expected_w13, rtol=0, atol=0)","+    # Down-projection block and global scales must survive source loading.","+    torch.testing.assert_close(actual_w2.cpu(), expected_w2, rtol=0, atol=0)","+","+    # Source-aware loading must not replace the target used for processing/inference.","+    assert layer.quant_method is target","+","+","+@pytest.mark.parametrize(\"is_act_and_mul\", [False, True])","+@pytest.mark.parametrize(","+    \"target_hidden,target_intermediate,has_bias,error\",","+    [","+        pytest.param(16, 32, False, None, id=\"unpadded\"),","+        pytest.param(24, 48, False, None, id=\"padded\"),","+        pytest.param(24, 48, True, NotImplementedError, id=\"bias-with-padding\"),","+        pytest.param(8, 32, False, ValueError, id=\"shrinking-hidden\"),","+        pytest.param(16, 16, False, ValueError, id=\"shrinking-intermediate\"),","+    ],","+)","+def test_online_requantized_moe_padding(","+    is_act_and_mul: bool,","+    target_hidden: int,","+    target_intermediate: int,","+    has_bias: bool,","+    error: type[Exception] | None,","+) -> None:","+    \"\"\"Preserve logical expert weights and shard boundaries when padding.\"\"\"","+    num_shards = 2 if is_act_and_mul else 1","+    w13 = torch.arange(","+        2 * num_shards * 32 * 16, device=\"cpu\", dtype=torch.float32","+    ).reshape(2, num_shards * 32, 16)","+    w2 = torch.arange(2 * 16 * 32, device=\"cpu\", dtype=torch.float32).reshape(2, 16, 32)","+    method = Fp8PerTensorOnlineMoEMethod.__new__(Fp8PerTensorOnlineMoEMethod)","+    method.moe = SimpleNamespace(","+        w13_num_shards=num_shards, is_act_and_mul=is_act_and_mul, has_bias=has_bias","+    )","+    method.requantization_source = Mock()","+    method.requantization_source.dequantize_weight.return_value = (w13, w2)","+    layer = SimpleNamespace(","+        local_num_experts=2,","+        moe_config=SimpleNamespace(","+            hidden_dim_unpadded=16,","+            intermediate_size_per_partition_unpadded=32,","+            hidden_dim=target_hidden,","+            intermediate_size_per_partition=target_intermediate,","+        ),","+        w13_bias=torch.zeros(2, num_shards * 32, device=\"cpu\") if has_bias else None,","+        w2_bias=torch.zeros(2, 16, device=\"cpu\") if has_bias else None,","+    )","+    if error is not None:","+        message = \"biases is unsupported\" if has_bias else \"cannot shrink weights\"","+        # Unsupported padding must fail explicitly rather than truncate weights.","+        with pytest.raises(error, match=message):","+            method.get_weights_for_quantization(layer)","+        return","+","+    padded_w13, padded_w2 = method.get_weights_for_quantization(layer)","+    if (target_hidden, target_intermediate) == (16, 32):","+        # Unpadded w13 must not allocate a replacement tensor.","+        assert padded_w13 is w13","+        # Unpadded w2 must not allocate a replacement tensor.","+        assert padded_w2 is w2","+","+    expected_w13 = w13.new_zeros(2, num_shards * target_intermediate, target_hidden)","+","+    for shard in range(num_shards):","+        start = shard * target_intermediate","+        expected_w13[:, start : start + 32, :16] = w13[:, shard * 32 : (shard + 1) * 32]","+","+    expected_w2 = w2.new_zeros(2, target_hidden, target_intermediate)","+    expected_w2[:, :16, :32] = w2","+","+    # Preserve each gate/up shard and zero all added rows and columns.","+    torch.testing.assert_close(padded_w13, expected_w13, rtol=0, atol=0)","+","+    # Preserve the logical down projection and zero both padding dimensions.","+    torch.testing.assert_close(padded_w2, expected_w2, rtol=0, atol=0)","+","+","+@pytest.mark.skipif(","+    not (current_platform.is_cuda() or current_platform.is_rocm())","+    or not is_quant_method_supported(\"fp8\"),","+    reason=\"Requires FP8 support on CUDA or ROCm.\",","+)","+@pytest.mark.skip_global_cleanup","+@pytest.mark.parametrize(\"source_format\", [\"compressed_tensors\", \"modelopt\", \"quark\"])","+@pytest.mark.parametrize(","+    \"online_target\",","+    [","+        \"fp8_per_tensor\",","+        \"fp8_per_block\",","+        \"fp8_per_channel\",","+        \"mxfp4\",","+        \"mxfp8\",","+        \"int8\",","+    ],","+)","+def test_online_requantized_moe_reload(","+    source_format: str,","+    online_target: str,","+    default_vllm_config,","+    monkeypatch,","+) -> None:","+    \"\"\"Reload each online target in place and match a fres