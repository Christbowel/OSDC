raphql-language-service\": \"^6.0.0\",","     \"lru-cache\": \"^11.5.2\",","     \"node-abort-controller\": \"^3.0.1\","],"additions":2,"deletions":2,"truncated":false},{"path":"packages/graphql-language-service-server/src/MessageProcessor.ts","lines":["@@ -216,7 +216,6 @@ export class MessageProcessor {","       : this._rootPath;","     if (settings?.dotEnvPath) {","       require('dotenv').config({","-        quiet: true,","         path: path.resolve(rootDir, settings.dotEnvPath),","       });","     }"],"additions":0,"deletions":1,"truncated":false},{"path":"packages/graphql-language-service-server/src/__tests__/dotenv.test.ts","lines":["@@ -0,0 +1,53 @@","+import { afterEach, expect, it, vi } from 'vitest';","+import { MockProject } from './__utils__/MockProject';","+","+let project: MockProject | undefined;","+","+afterEach(() => {","+  project?.dispose();","+  project = undefined;","+  vi.unstubAllEnvs();","+  vi.restoreAllMocks();","+});","+","+it('loads dotEnvPath without changing literal hashes, overriding existing values or writing to LSP stdout', async () => {","+  const env = {","+    GRAPHIQL_TEST_DOTENV_HASH: undefined,","+    GRAPHIQL_TEST_DOTENV_SPACED_HASH: undefined,","+    GRAPHIQL_TEST_DOTENV_QUOTED: undefined,","+    GRAPHIQL_TEST_DOTENV_EMPTY: undefined,","+    GRAPHIQL_TEST_DOTENV_EXISTING: 'host value',","+  };","+  for (const [key, value] of Object.entries(env)) {","+    vi.stubEnv(key, value);","+  }","+  project = new MockProject({","+    settings: { dotEnvPath: './environment.env' },","+    files: [","+      ['graphql.config.json', '{\"schema\":\"./schema.graphql\"}'],","+      ['schema.graphql', 'type Query { hello: String }'],","+      ['query.graphql', '{ hello }'],","+      [","+        'environment.env',","+        [","+          'GRAPHIQL_TEST_DOTENV_HASH=secret#suffix',","+          'GRAPHIQL_TEST_DOTENV_SPACED_HASH=secret #suffix',","+          'GRAPHIQL_TEST_DOTENV_QUOTED=\"secret #suffix\"',","+          'GRAPHIQL_TEST_DOTENV_EMPTY=',","+          'GRAPHIQL_TEST_DOTENV_EXISTING=file value',","+        ].join('\\n'),","+      ],","+    ],","+  });","+  const stdout = vi.spyOn(process.stdout, 'write');","+","+  const result = await project.init();","+","+  expect(result.diagnostics).toEqual([]);","+  expect(process.env.GRAPHIQL_TEST_DOTENV_HASH).toBe('secret#suffix');","+  expect(process.env.GRAPHIQL_TEST_DOTENV_SPACED_HASH).toBe('secret #suffix');","+  expect(process.env.GRAPHIQL_TEST_DOTENV_QUOTED).toBe('secret #suffix');","+  expect(process.env.GRAPHIQL_TEST_DOTENV_EMPTY).toBe('');","+  expect(process.env.GRAPHIQL_TEST_DOTENV_EXISTING).toBe('host value');","+  expect(stdout).not.toHaveBeenCalled();","+});"],"additions":53,"deletions":0,"truncated":false},{"path":"packages/graphql-language-service-server/src/__tests__/glob-compat.test.ts","lines":["@@ -0,0 +1,50 @@","+import { mkdtemp, mkdir, rm, writeFile } from 'node:fs/promises';","+import { tmpdir } from 'node:os';","+import { dirname, join } from 'node:path';","+import { loadConfig } from 'graphql-config';","+import { expect, it } from 'vitest';","+import { GraphQLCache } from '../GraphQLCache';","+import { NoopLogger } from '../Logger';","+import { parseDocument } from '../parseDocument';","+","+it('discovers nested GraphQL documents with brace patterns while excluding generated and dependency files', async () => {","+  const directory = await mkdtemp(","+    join(tmpdir(), 'graphql glob compatibility-'),","+  );","+  try {","+    const files = {","+      'graphql.config.json': JSON.stringify({","+        schema: './schema.graphql',","+        documents: './**/*.{graphql,gql}',","+      }),","+      'schema.graphql': 'type Query { hello: String }',","+      'operations/root.graphql': 'fragment RootFields on Query { hello }',","+      'operations/nested/other.gql': 'fragment NestedFields on Query { hello }',","+      'operations/__generated__/ignored.graphql':","+        'fragment GeneratedFields on Query { hello }',","+      'node_modules/ignored.graphql':","+        'fragment DependencyFields on Query { hello }',","+    };","+    for (const [filename, contents] of Object.entries(files)) {","+      const filepath = join(directory, filename);","+      await mkdir(dirname(filepath), { recursive: true });","+      await writeFile(filepath, contents);","+    }","+    const config = await loadConfig({","+      filepath: join(directory, 'graphql.config.json'),","+    });","+    const cache = new GraphQLCache({","+      configDir: directory,","+      config: config!,","+      parser: parseDocument,","+      logger: new NoopLogger(),","+    });","+    const fragments = await cache.getFragmentDefinitions(config!.getDefault());","+    expect([...fragments.keys()].sort()).toEqual([","+      'NestedFields',","+      'RootFields',","+    ]);","+  } finally {","+    await rm(directory, { recursive: true, force: true });","+  }","+});"],"additions":50,"deletions":0,"truncated":false},{"path":"packages/vscode-graphql-execution/package.json","lines":["@@ -103,9 +103,9 @@","     \"@urql/core\": \"^6.0.1\",","     \"capitalize\": \"2.0.4\",","     \"cosmiconfig-toml-loader\": \"^1.0.0\",","-    \"dotenv\": \"^18.0.9\",","+    \"dotenv\": \"10.0.0\",","     \"graphql\": \"^16.14.2\",","-    \"graphql-config\": \"^5.1.6\",","+    \"graphql-config\": \"^5.1.8\",","     \"graphql-ws\": \"6.4.1\",","     \"node-fetch\": \"^3.3.2\",","     \"nullthrows\": \"1.1.1\","],"additions":2,"deletions":2,"truncated":false},{"path":"pnpm-lock.yaml","lines":["@@ -65,8 +65,8 @@ importers:","         specifier: ^3.0.3","         version: 3.0.3","       '@types/codemirror':","-        specifier: ^5.60.18","-        version: 5.60.18","+        specifier: ^0.0.90","+        version: 0.0.90","       '@types/copy':","         specifier: ^0.3.1","         version: 0.3.5","@@ -535,8 +535,8 @@ importers:","   packages/codemirror-graphql:","     dependencies:","       '@types/codemirror':","-        specifier: ^5.60.18","-        version: 