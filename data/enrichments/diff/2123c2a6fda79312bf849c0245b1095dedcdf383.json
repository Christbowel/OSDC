20.2.9","+","   yargs@18.0.0:","     dependencies:","       cliui: 9.0.1"],"additions":63,"deletions":25,"truncated":false},{"path":"scripts/check-package-consumers.mts","lines":["@@ -0,0 +1,154 @@","+import assert from 'node:assert/strict';","+import { execFile } from 'node:child_process';","+import {","+  cp,","+  mkdtemp,","+  readFile,","+  readdir,","+  rm,","+  writeFile,","+} from 'node:fs/promises';","+import { tmpdir } from 'node:os';","+import { join } from 'node:path';","+import { fileURLToPath } from 'node:url';","+import { promisify } from 'node:util';","+","+const exec = promisify(execFile);","+const root = fileURLToPath(new URL('../', import.meta.url));","+const temporary = await mkdtemp(join(tmpdir(), 'graphiql-package-consumers-'));","+const selected = new Set([","+  'graphiql',","+  '@graphiql/toolkit',","+  'codemirror-graphql',","+  'monaco-graphql',","+  'graphql-language-service',","+  'graphql-language-service-server',","+  'graphql-language-service-cli',","+]);","+const packages = new Map<","+  string,","+  { directory: string; dependencies?: Record<string, string> }","+>();","+const environment = Object.fromEntries(","+  Object.entries(process.env).filter(","+    ([key]) => !/^(npm_config_|pnpm_)/i.test(key),","+  ),","+);","+","+async function run(command: string, args: string[], cwd: string) {","+  try {","+    return await exec(command, args, {","+      cwd,","+      timeout: 180_000,","+      maxBuffer: 10 * 1024 * 1024,","+      env: { ...environment, NODE_PATH: '' },","+    });","+  } catch (error) {","+    const output = error as { stdout?: string; stderr?: string };","+    process.stderr.write(output.stdout ?? '');","+    process.stderr.write(output.stderr ?? '');","+    throw error;","+  }","+}","+","+try {","+  for (const entry of await readdir(join(root, 'packages'), {","+    withFileTypes: true,","+  })) {","+    if (!entry.isDirectory()) {","+      continue;","+    }","+    const directory = join(root, 'packages', entry.name);","+    const filepath = join(directory, 'package.json');","+    const manifest = JSON.parse(await readFile(filepath, 'utf8'));","+    if (!manifest.private) {","+      packages.set(manifest.name, {","+        directory,","+        dependencies: manifest.dependencies,","+      });","+    }","+  }","+  for (const name of selected) {","+    const manifest = packages.get(name);","+    assert.ok(manifest, `Missing workspace package ${name}`);","+    for (const dependency of Object.keys(manifest.dependencies ?? {})) {","+      if (packages.has(dependency)) {","+        selected.add(dependency);","+      }","+    }","+  }","+","+  const packed: Record<string, string> = {};","+  for (const name of selected) {","+    const { stdout } = await run(","+      'npm',","+      ['pack', '--ignore-scripts', '--json', '--pack-destination', temporary],","+      packages.get(name)!.directory,","+    );","+    const [{ filename }] = JSON.parse(stdout);","+    packed[name] = `file:${join(temporary, filename)}`;","+  }","+","+  for (const react of ['18.3.1', '19.3.1']) {","+    for (const graphql of ['16.14.2', '17.0.2']) {","+      console.info(","+        `Checking packed packages: Node ${process.versions.node}, React ${react}, GraphQL ${graphql}`,","+      );","+      const directory = join(temporary, `react-${react}-graphql-${graphql}`);","+      await cp(","+        new URL('./fixtures/package-consumer/', import.meta.url),","+        directory,","+        { recursive: true },","+      );","+      await cp(","+        new URL('./fixtures/codemirror-consumer.ts', import.meta.url),","+        join(directory, 'codemirror-consumer.ts'),","+      );","+      await writeFile(","+        join(directory, 'package.json'),","+        JSON.stringify({","+          private: true,","+          dependencies: { ...packed, react, 'react-dom': react, graphql },","+          devDependencies: {","+            typescript: '5.9.3',","+            '@types/react': react.startsWith('18') ? '^18.3.0' : '^19.0.0',","+            '@types/react-dom': react.startsWith('18') ? '^18.3.0' : '^19.0.0',","+          },","+          overrides: Object.fromEntries(","+            [...selected].map(name => [name, `$${name}`]),","+          ),","+        }),","+      );","+      await run(","+        'npm',","+        [","+          'install',","+          '--ignore-scripts',","+          '--no-audit',","+          '--no-fund',","+          '--engine-strict',","+          '--prefer-online',","+          '--include=dev',","+        ],","+        directory,","+      );","+      await run(","+        process.execPath,","+        ['node_modules/typescript/bin/tsc', '-p', 'tsconfig.json'],","+        directory,","+      );","+      await run(process.execPath, ['consumer.mjs'], directory);","+      const cli = 'node_modules/graphql-language-service-cli/bin/graphql.js';","+      const help = await run(process.execPath, [cli, '--help'], directory);","+      assert.match(help.stdout, /autocomplete/);","+      const validation = await run(","+        process.execPath,","+        [cli, 'validate', '--text', '{ __typename }'],","+        directory,","+      );","+      assert.equal(validation.stdout, '{}');","+    }","+  }","+} finally {","+  await rm(temporary, { recursive: true, force: true });","+}"],"additions":154,"deletions":0,"truncated":false},{"path":"scripts/execution-config.spec.mts","lines":["@@ -0,0 +1,80 @@","+import assert from 'node:assert/strict';","+import { mkdtemp, rm, writeFile } from 'node:fs/promises';","+import { createServer } from 'node:http';","+import { createRequire } from 'node:module';","+import { tmpdir } from 'node:os';","+import { join } from 'node:path';","+import test from 'node:test';","+","+const requireFromExtension = createRequire(","+  new URL('../packages/vscode-graphql-execution/package.json', import.meta.url),","+);","+const { loadConfig } = requireFromExtension('graphql-config');","+const { buildSchema, graphql } = requireFromExtension('graphql');","+","+test(","+  'execution config loads remote schemas and local fragments',","+  { timeout: 15_000 },","+  async context => {","+    const directory = await mkdtemp(","+      join(tmpdir(), 'graphiql-execution-config-'),","+    );","+    const schema = buildSchema('type Query { greeting: String }');","+    const headers: unknown[] = [];","+    const server = createServer(async (request, response) => {","+      let body = '';","+      for await (const chunk of request) {","+        body += chunk;","+      }","+      const operation = JSON.parse(body);","+      headers.push(request.headers['x-schema-test']);","+      const result = await graphql({","+        schema,","+        source: operation.query,","+        variableValues: operation.variables,","+      });","+      response.setHeader('content-type', 'application/json');","+      response.end(JSON.stringify(result));","+    });","+    context.after(async () => {","+      server.closeAllConnections();","+      await new Promise<void>(resolve => server.close(() => resolve()));","+      await rm(directory, { recursive: true, force: true });","+    });","+    await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));","+    const address = server.address();","+    assert.ok(address && typeof address !== 'string');","+    const url = `http://127.0.0.1:${address.port}/graphql`;","+    const filepath = join(directory, 'graphql.config.json');","+    await writeFile(","+      filepath,","+      JSON.stringify({","+        schema: {","+          [url]: { headers: { 'x-schema-test': 'runtime-compatibility' } },","+        },","+        documents: './*.graphql',","+      }),","+    );","+    await writeFile(","+      join(directory, 'operation.graphql'),","+      'fragment GreetingFields on Query { greeting }\\nquery Greeting { ...GreetingFields }',","+    );","+","+    const config = await loadConfig({ filepath });","+    assert.ok(config);","+    const project = config.getDefault();","+    const loadedSchema = await project.getSchema();","+    assert.ok(loadedSchema.getQueryType()?.getFields().greeting);","+    assert.ok(headers.length > 0);","+    assert.ok(headers.every(header => header === 'runtime-compatibility'));","+","+    const documents = await project.getDocuments();","+    assert.equal(documents.length, 1);","+    assert.deepEqual(","+      documents[0].document.definitions.map(","+        (definition: { name?: { value: string } }) => definition.name?.value,","+      ),","+      ['GreetingFields', 'Greeting'],","+    );","+  },","+);"],"additions":80,"deletions":0,"truncated":false},{"path":"scripts/fixtures/codemirror-consumer.ts","lines":["@@ -0,0 +1,14 @@","+import CodeMirror = require('codemirror');","+import 'codemirror-graphql/lint';","+import type { GraphQLJumpOptions } from 'codemirror-graphql/jump';","+","+export const annotations: CodeMirror.Annotation[] = [","+  {","+    from: CodeMirror.Pos(0, 0),","+    to: CodeMirror.Pos(0, 5),","+    message: 'Unknown field',","+    severity: 'warning',","+  },","+];","+","+export const jumpOptions: GraphQLJumpOptions = { onClick() {} };"],"additions":14,"deletions":0,"truncated":false},{"path":"scripts/fixtures/package-consumer/consumer.mjs","lines":["@@ -0,0 +1,54 @@","+import assert from 'node:assert/strict';","+import { createRequire } from 'node:module';","+import { createElement } from 'react';","+import { renderToStaticMarkup } from 'react-dom/server';","+import { Button } from '@graphiql/react';","+import { GraphiQL } from 'graphiql';","+import { createTransport } from '@graphiql/toolkit';","+import { buildSchema } from 'graphql';","+import { getDiagnostics } from 'graphql-language-service';","+","+const require = createRequire(import.meta.url);","+const schema = buildSchema('type Query { hello: String }');","+assert.deepEqual(getDiagnostics('{ hello }', schema), []);","+assert.ok(getDiagnostics('{ unknown }', schema).length > 0);","+assert.deepEqual(","+  require('graphql-language-service').getDiagnostics('{ hello }', schema),","+  [],","+);","+assert.equal(","+  typeof require('graphql-language-service-server').startServer,","+  'function',","+);","+assert.match(","+  renderToStaticMarkup(createElement(Button, null, 'Consumer')),"],"additions":24,"deletions":0,"truncated":false}],"additions":479,"deletions":64,"truncated":true,"file_count":22},"error":null,"fetched_at":"2026-11-02T17:24:56.076159+00:00"}