etCILogonConfig } from \"@/lib/cilogon\";"," import type { CILogonConfig } from \"@/lib/cilogon\";"," import { useSession } from \"@/lib/session\";","@@ -11,6 +12,7 @@ import { useSession } from \"@/lib/session\";"," export default function LoginPage() {","   const { token, signIn } = useSession();","   const router = useRouter();","+  const brand = useBrand();","   // undefined while the server is asked whether CILogon sign-in is configured.","   const [cilogon, setCILogon] = useState<CILogonConfig | null | undefined>(undefined);","   const [redirecting, setRedirecting] = useState(false);","@@ -69,7 +71,7 @@ export default function LoginPage() {","     <div className=\"center\">","       <div className=\"card\" style={{ width: \"min(460px, 100%)\" }}>","         <div className=\"card-head\">","-          <h2>Sign in to Airavata</h2>","+          <h2>Sign in to {brand.name}</h2>","         </div>","         <div className=\"card-body form\">","           {cilogon === undefined ? ("],"additions":3,"deletions":1,"truncated":false},{"path":"dashboard/src/components/Shell.tsx","lines":["@@ -3,6 +3,7 @@"," import Link from \"next/link\";"," import { usePathname, useRouter } from \"next/navigation\";"," import { Fragment, useEffect, useState } from \"react\";","+import { useBrand } from \"@/lib/branding\";"," import { useInteractiveAuth } from \"@/lib/interactive-auth\";"," import { useSession } from \"@/lib/session\";"," import { AiravataMark, Icon, type IconName } from \"./Icons\";","@@ -70,6 +71,7 @@ const CONNECTION_LABEL = {"," export function Shell({ children }: { children: React.ReactNode }) {","   const { token, me, isAdmin, active, signOut } = useSession();","   const { current, connection } = useInteractiveAuth();","+  const brand = useBrand();","   const pathname = usePathname();","   const router = useRouter();","   const onLogin = pathname.startsWith(\"/login\");","@@ -128,9 +130,14 @@ export function Shell({ children }: { children: React.ReactNode }) {","   return (","     <div className={`shell${collapsed ? \" collapsed\" : \"\"}`}>","       <aside className=\"rail\">","-        <Link href=\"/\" className=\"rail-logo\" aria-label=\"Apache Airavata home\">","-          <AiravataMark size={30} />","-          <span>Airavata</span>","+        <Link href=\"/\" className=\"rail-logo\" aria-label={`${brand.name} home`}>","+          {brand.logoUrl ? (","+            // eslint-disable-next-line @next/next/no-img-element","+            <img className=\"rail-logo-img\" src={brand.logoUrl} alt=\"\" />","+          ) : (","+            <AiravataMark size={30} />","+          )}","+          <span>{brand.name}</span>","         </Link>","         <nav className=\"rail-nav\" aria-label=\"Main\">","           {NAV_GROUPS.map((g) => ("],"additions":10,"deletions":3,"truncated":false},{"path":"dashboard/src/lib/branding.tsx","lines":["@@ -0,0 +1,65 @@","+\"use client\";","+","+import { createContext, useContext, useEffect, useState } from \"react\";","+","+// Branding: the name shown beside the logo and the logo image itself.","+//","+// Two layers, the second overriding the first:","+//   - Build time: NEXT_PUBLIC_AIRAVATA_BRAND_NAME and NEXT_PUBLIC_AIRAVATA_BRAND_LOGO_URL.","+//   - Deployment time: a branding.json beside the exported pages (dashboard/out/branding.json","+//     for a stock build), read by the browser on load, so a deployment can be rebranded","+//     without rebuilding. Fields: {\"name\": \"...\", \"logoUrl\": \"...\"}; either may be omitted.","+//","+// A logo URL that is absolute (http:, https:, data:) or starts with \"/\" is used as is; any","+// other value is a file inside the dashboard, e.g. \"logo.svg\" is served at /dashboard/logo.svg.","+// With no logo configured the Airavata mark is shown.","+","+export interface Brand {","+  name: string;","+  logoUrl: string;","+}","+","+const BASE_PATH = \"/dashboard\";","+","+export const DEFAULT_BRAND: Brand = {","+  name: process.env.NEXT_PUBLIC_AIRAVATA_BRAND_NAME || \"Airavata\",","+  logoUrl: resolveLogo(process.env.NEXT_PUBLIC_AIRAVATA_BRAND_LOGO_URL ?? \"\"),","+};","+","+function resolveLogo(url: string): string {","+  const u = url.trim();","+  if (!u || /^(https?:|data:|\\/)/i.test(u)) return u;","+  return `${BASE_PATH}/${u}`;","+}","+","+const BrandContext = createContext<Brand>(DEFAULT_BRAND);","+","+export function BrandProvider({ children }: { children: React.ReactNode }) {","+  const [brand, setBrand] = useState<Brand>(DEFAULT_BRAND);","+","+  useEffect(() => {","+    let cancelled = false;","+    // A missing file answers with the dashboard's HTML 404 page, so anything that is not","+    // JSON is ignored, as is a file that fails to parse.","+    fetch(`${BASE_PATH}/branding.json`, { cache: \"no-cache\" })","+      .then((r) => (r.ok && r.headers.get(\"content-type\")?.includes(\"json\") ? r.json() : null))","+      .then((cfg: Partial<Brand> | null) => {","+        if (cancelled || !cfg || typeof cfg !== \"object\") return;","+        const name = typeof cfg.name === \"string\" && cfg.name.trim() ? cfg.name.trim() : undefined;","+        const logoUrl = typeof cfg.logoUrl === \"string\" ? resolveLogo(cfg.logoUrl) : undefined;","+        setBrand((b) => ({ name: name ?? b.name, logoUrl: logoUrl ?? b.logoUrl }));","+      })","+      .catch(() => {});","+    return () => {","+      cancelled = true;","+    };","+  }, []);","+","+  useEffect(() => {","+    document.title = `${brand.name} Dashboard`;","+  }, [brand.name]);","+","+  return <BrandContext.Provider value={brand}>{children}</BrandContext.Provider>;","+}","+","+export const useBrand = () => useContext(BrandContext);",""],"additions":65,"deletions":0,"truncated":false}],"additions":117,"deletions":10,"truncated":false,"file_count":8},"error":null,"fetched_at":"2026-11-13T17:04:45.948104+00:00"}