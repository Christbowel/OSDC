 +31,7 @@ const PLATFORM_METHODS: Record<MfaPlatform, readonly MfaMethod[]> = {","   extension: ['email_otp'],"," };"," ","-const isMethodSupported = (method: MfaMethod, platform: MfaPlatform) =>","+export const isMethodSupported = (method: MfaMethod, platform: MfaPlatform) =>","   PLATFORM_METHODS[platform].includes(method);"," "," const sortByCost = (methods: Iterable<MfaMethod>): MfaMethod[] => {"],"additions":1,"deletions":1,"truncated":false},{"path":"ui/hooks/identity/mfa/removeMfaCredential.test.ts","lines":["@@ -0,0 +1,9 @@","+import { removeMfaCredential } from './removeMfaCredential';","+","+describe('removeMfaCredential', () => {","+  it('rejects until the server supports removal', async () => {","+    await expect(","+      removeMfaCredential({ type: 'passkey', status: 'active' }),","+    ).rejects.toThrow('Removing MFA methods is not supported yet');","+  });","+});"],"additions":9,"deletions":0,"truncated":false},{"path":"ui/hooks/identity/mfa/removeMfaCredential.ts","lines":["@@ -0,0 +1,19 @@","+import type {","+  EnrolledCredential,","+  VerificationToken,","+} from '@metamask/profile-sync-controller/sdk';","+","+/**","+ * Removes one of the profile's methods, with a fresh verification token","+ * proven with another one. The server and `AuthenticationController` don't","+ * offer removal yet, so for now it always rejects.","+ *","+ * @param _credential - The method to remove.","+ * @param _token - A verification token from `verifyOrEnroll`.","+ */","+export const removeMfaCredential = async (","+  _credential: EnrolledCredential,","+  _token?: VerificationToken,","+): Promise<void> => {","+  throw new Error('Removing MFA methods is not supported yet');","+};"],"additions":19,"deletions":0,"truncated":false},{"path":"ui/pages/settings/mfa-settings/mfa-email-details.test.tsx","lines":["@@ -0,0 +1,213 @@","+import React from 'react';","+import { act, fireEvent, screen } from '@testing-library/react';","+import configureMockStore from 'redux-mock-store';","+import thunk from 'redux-thunk';","+import type { EnrolledCredential } from '@metamask/profile-sync-controller/sdk';","+import mockState from '../../../../test/data/mock-state.json';","+import { renderWithProvider } from '../../../../test/lib/render-helpers-navigate';","+// eslint-disable-next-line import-x/no-restricted-paths","+import messages from '../../../../app/_locales/en/messages.json';","+import { MFA_SETTINGS_ROUTE } from '../../../helpers/constants/routes';","+import { toast } from '../../../components/ui/toast/toast';","+import { MfaFlowError } from '../../../hooks/identity/mfa/engine/errors';","+import { startMfaFlow } from '../../../hooks/identity/mfa/engine/activeFlow';","+import { extensionMfaControllerAdapter } from '../../../hooks/identity/mfa/bindings';","+import { isMethodSupported } from '../../../hooks/identity/mfa/engine/planner';","+import { removeMfaCredential } from '../../../hooks/identity/mfa/removeMfaCredential';","+import { MfaSettingsTestIds } from './test-ids';","+import MfaEmailDetails from './mfa-email-details';","+","+const mockNavigate = jest.fn();","+jest.mock('react-router-dom', () => ({","+  ...jest.requireActual('react-router-dom'),","+  useNavigate: () => mockNavigate,","+}));","+","+jest.mock('../../../components/ui/toast/toast', () => ({","+  toast: { success: jest.fn(), error: jest.fn() },","+}));","+","+jest.mock('../../../hooks/identity/mfa/engine/activeFlow', () => ({","+  startMfaFlow: jest.fn(),","+}));","+","+jest.mock('../../../hooks/identity/mfa/bindings', () => ({","+  extensionMfaControllerAdapter: { refreshEnrolledCredentials: jest.fn() },","+}));","+","+jest.mock('../../../hooks/identity/mfa/engine/planner', () => ({","+  ...jest.requireActual('../../../hooks/identity/mfa/engine/planner'),","+  isMethodSupported: jest.fn(),","+}));","+","+jest.mock('../../../hooks/identity/mfa/removeMfaCredential', () => ({","+  removeMfaCredential: jest.fn(),","+}));","+","+const mockStartMfaFlow = jest.mocked(startMfaFlow);","+const mockRefresh = jest.mocked(","+  extensionMfaControllerAdapter.refreshEnrolledCredentials,","+);","+const mockRemove = jest.mocked(removeMfaCredential);","+","+const token = {","+  accessToken: 'token',","+  expiresIn: 900,","+  obtainedAt: 0,","+  claims: { sub: 'profile', amr: ['passkey'], exp: 0 },","+};","+const email: EnrolledCredential = {","+  type: 'email_otp',","+  status: 'active',","+  email: 'a@b.co',","+  verified: true,","+  enrolledAt: new Date(2026, 8, 17, 11, 23).getTime(),","+};","+const passkey: EnrolledCredential = { type: 'passkey', status: 'active' };","+","+const renderDetails = (enrolledCredentials: EnrolledCredential[]) =>","+  renderWithProvider(","+    <MfaEmailDetails />,","+    configureMockStore([thunk])({","+      ...mockState,","+      metamask: { ...mockState.metamask, enrolledCredentials },","+    }),","+  );","+","+const confirmRemoval = async () => {","+  fireEvent.click(screen.getByTestId(MfaSettingsTestIds.REMOVE_BUTTON));","+  await act(async () => {","+    fireEvent.click(screen.getByTestId(MfaSettingsTestIds.CONFIRM_BUTTON));","+  });","+};","+","+describe('MfaEmailDetails', () => {","+  beforeEach(() => {","+    jest.clearAllMocks();","+    mockStartMfaFlow.mockResolvedValue({ credentials: [], token });","+    mockRefresh.mockResolvedValue([]);","+    mockRemove.mockResolvedValue();","+    // Passkeys don't run on the extension yet; most tests assume they do.","+    jest.mocked(isMethodSupported).mockReturnValue(true);","+  });","+","+  it('describes the email and what it protects', () => {","+    renderDetails([email]);","+","+    expect(screen.getByText('a•••@b.co')).toBeInTheDocument();","+    expect(","+      screen.getByText('Added Sep 17, 2026 at 11:23 AM'),","+    ).toBeInTheDocument();","+    expect(","+      screen.getByText(messages.mfaSettingsUsedForMoney.message),","+    ).toBeInTheDocument();","+  });","+","+  it('names an email listed without its address', () => {","+    renderDetails([{ type: 'email_otp', status: 'active', verified: true }]);","+","+    expect(","+      screen.getByText(messages.mfaMethodEmail.message),","+    ).toBeInTheDocument();","+  });","+","+  it('renders nothing without an active email', () => {","+    renderDetails([passkey]);","+","+    expect(","+      screen.queryByTestId(MfaSettingsTestIds.EMAIL_DETAILS),","+    ).not.toBeInTheDocument();","+  });","+","+  it('refuses to remove the last method', () => {","+    renderDetails([email]);","+","+    fireEvent.click(screen.getByTestId(MfaSettingsTestIds.REMOVE_BUTTON));","+    expect(","+      screen.getByText(messages.mfaSettingsLastEmailTitle.message),","+    ).toBeInTheDocument();","+","+    fireEvent.click(screen.getByText(messages.gotIt.message));","+    expect(","+      screen.queryByTestId(MfaSettingsTestIds.LAST_METHOD_MODAL),","+    ).not.toBeInTheDocument();","+    expect(mockStartMfaFlow).not.toHaveBeenCalled();","+  });","+","+  it('sends the user to mobile when no other method runs here', () => {","+    jest.mocked(isMethodSupported).mockReturnValue(false);","+    renderDetails([email, passkey]);","+","+    fireEvent.click(screen.getByTestId(MfaSettingsTestIds.REMOVE_BUTTON));","+    expect(","+      screen.getByText(messages.mfaSettingsRemoveElsewhereTitle.message),","+    ).toBeInTheDocument();","+    expect(","+      screen.queryByTestId(MfaSettingsTestIds.CONFIRM_BUTTON),","+    ).not.toBeInTheDocument();","+    expect(mockStartMfaFlow).not.toHaveBeenCalled();","+  });","+","+  it('closes the confirmation on cancel', () => {","+    renderDetails([email, passkey]);","+","+    fireEvent.click(screen.getByTestId(MfaSettingsTestIds.REMOVE_BUTTON));","+    fireEvent.click(screen.getByText(messages.cancel.message));","+","+    expect(","+      screen.queryByTestId(MfaSettingsTestIds.CONFIRM_MODAL),","+    ).not.toBeInTheDocument();","+    expect(mockStartMfaFlow).not.toHaveBeenCalled();","+  });","+","+  it('removes the email after a fresh verification with the other methods', async () => {","+    renderDetails([email, passkey, { ...passkey }]);","+","+    await confirmRemoval();","+","+    expect(mockStartMfaFlow).toHaveBeenCalledWith(","+      expect.objectContaining({","+        request: expect.objectContaining({","+          kind: 'verifyOrEnroll',","+          methods: ['passkey'],","+          verifyWith: ['passkey'],","+        }),","+        reason: { operation: 'settings.removeEmail' },","+      }),","+    );","+    expect(mockRemove).toHaveBeenCalledWith(email, token);","+    expect(mockRefresh).toHaveBeenCalledTimes(1);","+    expect(toast.success).toHaveBeenCalledWith(","+      messages.mfaSettingsEmailRemoved.message,","+    );","+    expect(mockNavigate).toHaveBeenCalledWith(MFA_SETTINGS_ROUTE, {","+      replace: true,","+    });","+  });","+","+  it('stays quiet when the verification is cancelled', async () => {","+    mockStartMfaFlow.mockRejectedValue(new MfaFlowError('flow_cancelled'));","+    renderDetails([email, passkey]);","+","+    await confirmRemoval();","+","+    expect(mockRemove).not.toHaveBeenCalled();","+    expect(toast.error).not.toHaveBeenCalled();","+    expect(mockNavigate).not.toHaveBeenCalled();","+  });","+","+  it('says so when the removal fails', async () => {","+    mockRemove.mockRejectedValue(new Error('not supported'));","+    renderDetails([email, passkey]);","+","+    await confirmRemoval();","+","+    expect(toast.error).toHaveBeenCalledWith(","+      messages.mfaSettingsRemoveFailed.message,","+    );","+    expect(mockNavigate).not.toHaveBeenCalled();","+    expect(","+      screen.getByTestId(MfaSettingsTestIds.REMOVE_BUTTON),","+    ).toBeInTheDocument();","+  });","+});"],"additions":213,"deletions":0,"truncated":false},{"path":"ui/pages/settings/mfa-settings/mfa-email-details.tsx","lines":["@@ -0,0 +1,246 @@","+import React, { useState } from 'react';","+import { useSelector } from 'react-redux';","+import { useNavigate } from 'react-router-dom';","+import { ENROLLMENT_MAX_SESSION_AGE_MS } from '@metamask/profile-sync-controller/auth';","+import {","+  AvatarIcon,","+  Box,","+  BoxAlignItems,","+  BoxFlexDirection,","+  BoxJustifyContent,","+  Button,","+  ButtonSize,","+  ButtonVariant,","+  IconAlert,","+  IconAlertSeverity,","+  IconName,","+  Modal,","+  ModalContent,","+  ModalFooter,","+  ModalHeader,","+  ModalOverlay,","+  Text,","+  TextColor,","+  TextVariant,","+} from '@metamask/design-system-react';","+import { MFA_SETTINGS_ROUTE } from '../../../helpers/constants/routes';","+import { formatDate } from '../../../helpers/utils/util';","+import { getIsSocialLoginFlow } from '../../../selectors';","+import { transitionBack } from '../../../components/ui/transition';","+import { toast } from '../../../components/ui/toast/toast';","+import { useI18nContext } from '../../../hooks/useI18nContext';","+import { useMfa } from '../../../hooks/identity/mfa';","+import { extensionMfaControllerAdapter } from '../../../hooks/identity/mfa/bindings';","+import { MfaFlowError } from '../../../hooks/identity/mfa/engine/errors';","+import { isMethodSupported } from '../../../hooks/identity/mfa/engine/planner';","+import { maskEmail } from '../../../hooks/identity/mfa/mask-email';","+import { removeMfaCredential } from '../../../hooks/identity/mfa/removeMfaCredential';","+import { getMfaUsedFor } from './mfa-used-for';","+import { MfaSettingsTestIds } from './test-ids';","+","+const MODALS = {","+  confirm: {","+    title: 'mfaSettingsRemoveEmail',","+    description: 'mfaSettingsRemoveEmailDescription',","+    testId: MfaSettingsTestIds.CONFIRM_MODAL,","+  },","+  lastMethod: {","+    title: 'mfaSettingsLastEmailTitle',","+    description: 'mfaSettingsLastEmailDescription',","+    testId: MfaSettingsTestIds.LAST_METHOD_MODAL,","+  },","+  elsewhere: {","+    title: 'mfaSettingsRemoveElsewhereTitle',","+    description: 'mfaSettingsRemoveElsewhereDescription',","+    testId: MfaSettingsTestIds.ELSEWHERE_MODAL,","+  },","+};","+","+/**","+ * The email method: when it was added, what it protects, and its removal.","+ * Removing the last method is refused, and so is removing it here when the","+ * other methods only run on mobile; otherwise the user confirms, then proves","+ * it's them with another method.","+ */","+const MfaEmailDetails = () => {","+  const t = useI18nContext();","+  const navigate = useNavigate();","+  const { credentials, verifyOrEnroll } = useMfa();","+  const isSocialLogin = useSelector(getIsSocialLoginFlow);","+  const [modal, setModal] = useState<'confirm' | 'lastMethod' | 'elsewhere'>();","+  const [isRemoving, setIsRemoving] = useState(false);","+","+  const active = credentials.filter(({ status }) => status === 'active');","+  const email = active.find(({ type }) => type === 'email_otp');","+  const others = active.filter((other) => other !== email);","+  // Only methods this client can run may prove it's the user.","+  const verifyWith = [...new Set(others.map(({ type }) => type))].filter(","+    (method) => isMethodSupported(method, 'extension'),","+  );","+","+  if (email?.type !== 'email_otp') {","+    return null;","+  }","+","+  const remove = async () => {","+    setModal(undefined);","+    setIsRemoving(true);","+    try {","+      const { token } = await verifyOrEnroll({","+        methods: verifyWith,","+        verifyWith,","+        maxSessionAgeMs: ENROLLMENT_MAX_SESSION_AGE_MS,","+        reason: { operation: 'settings.removeEmail' },","+      });","+      await removeMfaCredential(email, token);","+      await extensionMfaControllerAdapter","+        .refreshEnrolledCredentials()","+        .catch(() => undefined);","+      toast.success(t('mfaSettingsEmailRemoved'));","+      transitionBack(() => navigate(MFA_SETTINGS_ROUTE, { replace: true }));","+    } catch (error) {","+      // The kit has already shown its own errors, or the user backed out.","+      if (!(error instanceof MfaFlowError)) {","+        toast.error(t('mfaSettingsRemoveFailed'));","+      }","+    } finally {","+      setIsRemoving(false);","+    }","+  };","+","+  const openRemoval = () => {","+    if (others.length === 0) {","+      setModal('lastMethod');","+      return;","+    }","+    setModal(verifyWith.length ? 'confirm' : 'elsewhere');","+  };","+","+  const isConfirm = modal === 'confirm';","+","+  return (","+    <Box","+      flexDirection={BoxFlexDirection.Column}","+      justifyContent={BoxJustifyContent.Between}","+      gap={6}","+      padding={4}","+      className=\"h-full min-h-0\"","+      data-testid={MfaSettingsTestIds.EMAIL_DETAILS}","+    >","+      <Box flexDirection={BoxFlexDirection.Column} gap={6}>","+        <Box","+          flexDirection={BoxFlexDirection.Row}","+          alignItems={BoxAlignItems.Center}","+          gap={4}","+          padding={4}","+          className=\"rounded-2xl border border-muted\"","+        >","+          <AvatarIcon iconName={IconName.Mail} />","+          <Box flexDirection={BoxFlexDirection.Column}>","+            <Text variant={TextVariant.BodyMd}>","+              {email.email ? maskEmail(email.email) : t('mfaMethodEmail')}","+            </Text>","+            {email.enrolledAt ? (","+              <Text","+                variant={TextVariant.BodySm}","+                color={TextColor.TextAlternative}","+              >","+                {t('mfaSettingsAddedOn', [","+                  formatDate(email.enrolledAt, \"LLL d, y 'at' h:mm a\"),","+                ])}","+              </Text>","+            ) : null}","+          </Box>","+        </Box>","+        <Box flexDirection={BoxFlexDirection.Column} gap={4}>","+          <Text variant={TextVariant.HeadingSm}>{t('mfaSettingsUsedFor')}</Text>","+          {getMfaUsedFor('email_otp', { isSocialLogin }).map(","+            ({ key, icon, label }) => (","+              <Box","+                key={key}","+                flexDirection={BoxFlexDirection.Row}","+                alignItems={BoxAlignItems.Center}","+                gap={4}","+     