TextConverter.toText(d));","     }"," ","+    /**","+     * Returns the value as Excel sees it, as an exact decimal: the 15 significant digits of","+     * {@link #approxValue(double)}, so that decimal arithmetic on it (rounding to a number of","+     * places, or to a multiple of a step) gives the answer Excel gives. {@code 0.1*3} is","+     * {@code 0.3} rather than {@code 0.30000000000000004}, and {@code 2.675} is exactly","+     * that rather than {@code 2.67499999999999982236431605997495353221893310546875}.","+     *","+     * @param d a finite double","+     * @throws NumberFormatException if d is NaN or infinite","+     * @since 6.0.0","+     */","+    public static BigDecimal toBigDecimal(double d) {","+        return new BigDecimal(NumberToTextConverter.toText(d));","+    }","+","     /**","      * Truncates towards zero on the 15-digit view of the value, which is what Excel does with","      * the non-integer arguments of QUOTIENT, GCD, LCM, FACT, FACTDOUBLE, COMBIN, ISEVEN, ISODD"],"additions":17,"deletions":0,"truncated":false},{"path":"poi/src/test/java/org/apache/poi/ss/formula/atp/TestMRound.java","lines":["@@ -91,6 +91,9 @@ void testRoundsOnExcelsFifteenDigitView() throws IOException {","             confirm(evaluator, cell, \"MROUND(-2.5, -1)\", -3);","             confirm(evaluator, cell, \"MROUND(2.4999999999999996, 1)\", 3);","             confirm(evaluator, cell, \"MROUND(2.49999999999999, 1)\", 2);","+            // and on the 15-digit view of the multiple: 0.1*3 is 0.3, so 0.45/0.3 is exactly 1.5","+            confirm(evaluator, cell, \"MROUND(0.45, 0.1*3)\", 0.6);","+            confirm(evaluator, cell, \"MROUND(1.2, 0.7+0.1)\", 1.6);","         }","     }"," "],"additions":3,"deletions":0,"truncated":false},{"path":"poi/src/test/java/org/apache/poi/ss/formula/functions/TestCeiling.java","lines":["@@ -99,6 +99,10 @@ void testCeilingActsOnExcelsFifteenDigitView() throws IOException {","             assertDouble(fe, cell, \"CEILING(2.5,1)\", 3