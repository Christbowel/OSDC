tainer = $this->getRawContainer();","+        $container->getExtension('security')->addUserProviderFactory(new TestEntityProviderFactory());","+","+        $container->loadFromExtension('security', [","+            'providers' => $providers,","+            'firewalls' => ['main' => $firewall],","+        ]);","+","+        $container->compile();","+","+        $this->assertSame($expectedUserClass, $container->getDefinition('security.listener.user_not_found_password_check.main')->getArgument(1));","+    }","+","+    public static function provideUserClassesOfTheDefaultProvider(): iterable","+    {","+        yield 'memory' => [","+            ['default' => ['memory' => ['users' => ['bob' => ['password' => 'x']]]]],","+            ['http_basic' => true],","+            InMemoryUser::class,","+        ];","+","+        yield 'entity' => [","+            ['default' => ['entity' => ['class' => 'App\\Entity\\Customer']]],","+            ['http_basic' => true],","+            'App\\Entity\\Customer',","+        ];","+","+        yield 'id' => [","+            ['default' => ['id' => 'app.user_provider']],","+            ['http_basic' => true],","+            PasswordAuthenticatedUserInterface::class,","+        ];","+","+        yield 'chain' => [","+            [","+                'default' => ['chain' => ['providers' => ['users', 'customers']]],","+                'users' => ['memory' => ['users' => ['bob' => ['password' => 'x']]]],","+                'customers' => ['entity' => ['class' => 'App\\Entity\\Customer']],","+            ],","+            ['provider' => 'default', 'http_basic' => true],","+            InMemoryUser::class,","+        ];","+","+        yield 'chain starting with a provider of unknown class' => [","+            [","+                'default' => ['chain' => ['providers' => ['ids', 'customers']]],","+                'ids' => ['id' => 'app.user_provider'],","+                'customers' => ['entity' => ['class' => 'App\\Entity\\Customer']],","+            ],","+            ['provider' => 'default', 'http_basic' => true],","+            'App\\Entity\\Customer',","+        ];","+","+        yield 'chain of providers of unknown class' => [","+            [","+                'default' => ['chain' => ['providers' => ['ids']]],","+                'ids' => ['id' => 'app.user_provider'],","+            ],","+            ['provider' => 'default', 'http_basic' => true],","+            PasswordAuthenticatedUserInterface::class,","+        ];","+","+        yield 'no default provider' => [","+            [","+                'users' => ['memory' => ['users' => ['bob' => ['password' => 'x']]]],","+                'customers' => ['entity' => ['class' => 'App\\Entity\\Customer']],","+            ],","+            ['http_basic' => ['provider' => 'users']],","+            PasswordAuthenticatedUserInterface::class,","+        ];","+    }","+","+    #[TestWith(['none', true])]","+    #[TestWith(['account_status', true])]","+    #[TestWith(['all', false])]","+    public function testUserNotFoundPasswordCheckListenerIsRegisteredUnlessAllSecurityErrorsAreExposed(string $exposeSecurityErrors, bool $registered)","+    {","+        $container = $this->getRawContainer();","+","+        $container->loadFromExtension('security', [","+            'expose_security_errors' => $exposeSecurityErrors,","+            'providers' => ['default' => ['memory' => ['users' => ['bob' => ['password' => 'x']]]]],","+            'firewalls' => ['main' => ['http_basic' => true]],","+        ]);","+","+        $container->compile();","+","+        $this->assertSame($registered, $container->hasDefinition('security.listener.user_not_found_password_check.main'));","+    }","+","+    #[TestWith([true])]","+    #[TestWith([false])]","+    public function testLdapUsersOnlyHashesThePasswordOfLdapLogins(bool $ldapUsersOnly)","+    {","+        if (!property_exists(LdapAuthenticator::class, 'ldapUsersOnly')) {","+            $this->markTestSkipped('symfony/ldap 8.2 is required.');","+        }","+","+        $container = $this->getRawContainer();","+        $container->register('Symfony\\\\Component\\\\Ldap\\\\Ldap', Ldap::class)->addTag('ldap');","+        $container->loadFromExtension('security', [","+            'providers' => [","+                'directory' => ['ldap' => ['service' => 'Symfony\\\\Component\\\\Ldap\\\\Ldap', 'base_dn' => 'dc=example,dc=com']],","+                'local' => ['memory' => ['users' => ['bob' => ['password' => 'x']]]],","+                'chain' => ['chain' => ['providers' => ['directory', 'local']]],","+            ],","+            'firewalls' => [","+                'main' => [","+                    'provider' => 'chain',","+                    'form_login_ldap' => [","+                        'service' => 'Symfony\\\\Component\\\\Ldap\\\\Ldap',","+                        'ldap_users_only' => $ldapUsersOnly,","+                    ],","+                ],","+            ],","+        ]);","+        $container->compile();","+","+        $userNotFoundListener = $container->getDefinition('security.listener.user_not_found_password_check.main');","+        $this->assertSame(InMemoryUser::class, $userNotFoundListener->getArgument(1));","+        $this->assertSame($ldapUsersOnly, $userNotFoundListener->getArgument(2));","+        $this->assertSame($ldapUsersOnly, $container->getDefinition('security.listener.user_checker.main')->getArgument(2));","+","+        $ldapListener = $container->getDefinition('security.listener.form_login_ldap.main');","+        if ($ldapUsersOnly) {","+            $this->assertEquals([new Reference('security.ldap_locator'), new Reference('security.password_hasher_factory'), InMemoryUser::class], $ldapListener->getArguments());","+        } else {","+            $this->assertEquals([new Reference('security.ldap_locator')], $ldapListener->getArguments());","+        }","+    }","+","+    public function testLdapUsersOnlyHashesThePasswordInEveryLdapListenerOfTheFirewall()"