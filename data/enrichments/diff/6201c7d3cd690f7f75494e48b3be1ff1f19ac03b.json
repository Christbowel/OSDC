{"id":"6201c7d3cd690f7f75494e48b3be1ff1f19ac03b","axis":"silent","repo":"vllm-project/vllm","sha":"6201c7d3cd690f7f75494e48b3be1ff1f19ac03b","parsed":{"files":[{"path":"examples/disaggregated/lmcache/README.md","lines":["@@ -17,6 +17,35 @@ LMCache integrates with vLLM v1 in two ways:","   distributed KV storage and for sharing KV cache across instances. See the","   [LMCache docs](https://docs.lmcache.ai) for the full MP setup."," ","+### MP mode with the extensible KV cache","+","+vLLM's extensible KV cache (`--enable-extensible-kv-cache`) allocates the KV","+cache through the CUDA VMM API, which legacy CUDA IPC cannot share.","+`LMCacheMPConnector` declares legacy CUDA IPC by default, which keeps the","+extensible KV cache off. With `\"lmcache.mp.use_vmm_api\": true` in its","+`kv_connector_extra_config`, also as a `MultiConnector` child, it declares","+POSIX file descriptor export instead: vLLM allocates the KV cache exportable,","+and the LMCache server imports each layer through a file descriptor. vLLM","+refuses to start if the extensible KV cache is then off, e.g. with","+`kv_cache_memory_bytes`.","+","+Next to `NixlConnector` in a `MultiConnector`, on a host with an IMEX channel","+(e.g., GB200/GB300) the KV cache gets a FABRIC handle only, and the LMCache server imports it","+through FABRIC instead; this is not yet verified, and the server needs an IMEX","+channel too. Without an IMEX channel, NIXL's transfers within a host fall back","+to TCP.","+","+It requires:","+","+- an LMCache release that includes the file descriptor channel","+  ([LMCache/LMCache#6266](https://github.com/LMCache/LMCache/pull/6266)) and","+  declares `kv_cache_access`","+  ([LMCache/LMCache#6487](https://github.com/LMCache/LMCache/pull/6487)),","+- a CUDA GPU, with vLLM and the LMCache server on the same host, running as the","+  same user and sharing `/dev/shm` (`--ipc host` for containers),","+- a TCP server URL (`\"lmcache.mp.host\": \"tcp://...\"` and `\"lmcache.mp.port\"`),","+  from whose port the file descriptor socket path is derived.","+"," ## 1. CPU offload (in-process)"," "," - `python cpu_offload_lmcache.py` - CPU offloading with `LMCacheConnectorV1`"],"additions":29,"deletions":0,"truncated":false},{"path":"tests/utils_/test_extensible_tensor.py","lines":["@@ -230,6 +230,53 @@ def test_release_physical_keeps_addresses() -> None:","         et.free()"," "," ","+@pytest.mark.skipif(torch.version.hip is not None, reason=\"CUDA driver export\")","+@pytest.mark.parametrize(\"posix_fd_importer\", [False, True])","+@create_new_process_for_each_test(\"spawn\")","+def test_only_posix_fd_importers_get_a_posix_fd(posix_fd_importer: bool) -> None:","+    \"\"\"LMCache MP imports the committed memory through POSIX file descriptors;","+    every other extensible tensor keeps the driver's default handle types.\"\"\"","+    _skip_unless_vmm()","+    import ctypes","+    import os","+","+    from vllm.utils.vmm_driver import (","+        MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR,","+        get_vmm_driver,","+    )","+","+    driver = get_vmm_driver()","+    et = ExtensibleTensor(","+        4096,","+        device=\"cuda\",","+        export_handle_types=(","+            MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR if posix_fd_importer else 0","+        ),","+    )","+    try:","+        et.resize_per_segment_(4096)","+        handle = ctypes.c_ulonglong()","+        assert (","+            driver._lib.cuMemRetainAllocationHandle(","+                ctypes.byref(handle), ctypes.c_void_p(et.base_ptr)","+            )","+            == 0","+        )","+        fd = ctypes.c_int(-1)","+        result = driver._lib.cuMemExportToShareableHandle(","+            ctypes.byref(fd),","+            handle,","+            ctypes.c_int(MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR),","+            ctypes.c_ulonglong(0),","+        )","+        driver.release(handle.value)","+        if result == 0:","+            os.close(fd.value)","+        assert (result == 0) is posix_fd_importer","+    finally:","+        et.free()","+","+"," class _FailingDriver:","     \"\"\"Delegates to the real driver, recording access grants and failing the","     n-th physical allocation with an error `_map_chunk_at` does not retry.\"\"\"","@@ -246,11 +293,11 @@ def __init__(self, driver, fail_on_create: int) -> None:","     def __getattr__(self, name):","         return getattr(self._driver, name)"," ","-    def create(self, size: int, device_index: int) -> int:","+    def create(self, size: int, device_index: int, export_handle_types: int = 0) -> int:","         self.creates += 1","         if self.creates == self._fail_on_create:","             raise self.Failure(\"simulated allocation failure\")","-        return self._driver.create(size, device_index)","+        return self._driver.create(size, device_index, export_handle_types)"," ","     def set_access(self, ptr: int, size: int, device_index: int) -> None:","         self.access_grants.append((ptr, size))"],"additions":49,"deletions":2,"truncated":false},{"path":"tests/utils_/test_vmm_driver.py","lines":["@@ -8,7 +8,8 @@"," import torch"," "," from vllm.utils.vmm_driver import (","-    _MEM_HANDLE_TYPE_FABRIC,","+    MEM_HANDLE_TYPE_FABRIC,","+    MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR,","     CudaVmmDriver,","     _find_loaded_library,","     imex_channel_available,","@@ -146,12 +147,24 @@ def fake_cdll(name: str) -> str:","     assert opened == [\"libamdhip64.so.7\"]"," "," ","+_FD = MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR","+_FABRIC = MEM_HANDLE_TYPE_FABRIC","+","+"," @pytest.mark.parametrize(","-    \"device_support, imex_channel, requested\",","-    [(True, True, _MEM_HANDLE_TYPE_FABRIC), (True, False, 0), (False, True, 0)],","+    \"device_support, imex_channel, export_handle_types, requested\",","+    [","+        (True, True, 0, _FABRIC),","+        (True, False, 0, 0),","+        (False, True, 0, 0),","+        # POSIX fds are only requested alone: with FABRIC, FABRIC wins.","+        (True, True,