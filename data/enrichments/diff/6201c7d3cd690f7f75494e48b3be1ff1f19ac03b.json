r:","     The reservation is divided into contiguous segments whose committed bytes","     form a prefix of each; num_segments equal segments by default, or the","     explicit segment_capacities (in bytes, summing to max_num_bytes).","+    Other processes can import the memory through `export_handle_types` (see","+    `VmmDriver.create`).","     \"\"\""," ","     def __init__(","@@ -252,6 +257,7 @@ def __init__(","         device: torch.device | str | int | None = None,","         num_segments: int = 1,","         segment_capacities: Sequence[int] | None = None,","+        export_handle_types: int = 0,","     ) -> None:","         if max_num_bytes < 0:","             raise ValueError(\"max_num_bytes must be non-negative.\")","@@ -289,7 +295,9 @@ def __init__(","             itertools.accumulate([0, *self._segment_capacities[:-1]])","         )","         self._committed: list[int] = [0] * len(self._segment_capacities)","-        self._buffer: _VirtualBuffer = _VirtualBuffer(max_num_bytes, self._device_index)","+        self._buffer: _VirtualBuffer = _VirtualBuffer(","+            max_num_bytes, self._device_index, export_handle_types","+        )"," ","     def full_view(self) -> torch.Tensor:","         \"\"\"Uint8 view spanning the whole reservation.\"\"\""],"additions":12,"deletions":4,"truncated":false},{"path":"vllm/utils/vmm_driver.py","lines":["@@ -26,9 +26,10 @@"," _MEM_ALLOC_GRANULARITY_MINIMUM = 0"," _MEM_ACCESS_FLAGS_PROT_READWRITE = 3"," _MEM_ALLOCATION_COMP_NONE = 0","+MEM_HANDLE_TYPE_POSIX_FILE_DESCRIPTOR = 1"," _DEVICE_ATTRIBUTE_GPU_DIRECT_RDMA_WITH_CUDA_VMM_SUPPORTED = 110"," _DEVICE_ATTRIBUTE_HANDLE_TYPE_FABRIC_SUPPORTED = 128","-_MEM_HANDLE_TYPE_FABRIC = 0x8","+MEM_HANDLE_TYPE_FABRIC = 0x8"," _IMEX_CHANNELS = \"/dev/nvidia-caps-imex-channels/channel*\""," "," DevicePtr = ctypes.c_ulonglong","@@ -189,12 +190,17 @@ def _check(self, result: int) -> None:","             return","         raise RuntimeError(f\"GPU driver error {result}: {self.error_str