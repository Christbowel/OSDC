e_mla(","     with set_default_torch_dtype(torch.bfloat16):","         backend = _amd_attention(num_local_heads)._resolve_sink_backend(kv_cache_dtype)"," ","-    assert backend is ROCMAiterMLASparseBackend","+    assert issubclass(backend, ROCMAiterMLASparseBackend)","     assert backend.supports_sink()"," "," "],"additions":4,"deletions":3,"truncated":false},{"path":"tests/models/hy_v4/test_sequence_parallel.py","lines":["@@ -8,6 +8,7 @@"," from tests.models.utils import check_logprobs_close"," from vllm import SamplingParams"," from vllm.outputs import CompletionOutput","+from vllm.platforms import current_platform"," from vllm.transformers_utils.configs.hy_v4 import HYV4Config"," "," ","@@ -70,14 +71,25 @@ def test_ihc_shards_rows_and_preserves_generation("," ):","     \"\"\"Shard iHC rows with and without ShardQ and preserve generation.\"\"\"","     monkeypatch.setenv(\"VLLM_ALLOW_INSECURE_SERIALIZATION\", \"1\")","+    backend = \"FLASHMLA_SPARSE\"","+    num_heads = 32","+    if current_platform.is_rocm():","+        from vllm.platforms.rocm import on_gfx950","+","+        if not on_gfx950():","+            pytest.skip(\"fp8_ds_mla sparse MLA requires gfx950\")","+        monkeypatch.setenv(\"VLLM_ROCM_USE_AITER\", \"1\")","+        backend = \"ROCM_AITER_MLA_SPARSE\"","+        # ROCm ShardQ needs fewer than 16 heads per rank.","+        num_heads = 16","     config = HYV4Config(","         vocab_size=1024,","         hidden_size=256,","         intermediate_size=512,","         moe_intermediate_size=256,","         num_hidden_layers=2,","-        num_attention_heads=32,","-        num_key_value_heads=32,","+        num_attention_heads=num_heads,","+        num_key_value_heads=num_heads,","         q_lora_rank=128,","         n_routed_experts=4,","         n_shared_experts=1,","@@ -113,7 +125,7 @@ def test_ihc_shards_rows_and_preserves_generation(","             block_size=64,","             kv_cache_dtype=\"fp8_ds_mla\",","             attention_config={","-                \"backend\": \"FLASHMLA_SPARSE\",","+                \"backend\": backend,","                 \"sparse_mla_shard_q\": use_shardq,","                 \"sparse_mla_shard_q_min_tokens\": 64,","             },"],"additions":15,"deletions":3,"truncated":false},{"path":"tests/models/hy_v4/test_shardq_sinks.py","lines":["@@ -1,11 +1,14 @@"," # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project"," ","+from types import SimpleNamespace","+"," import pytest"," import torch"," import torch.multiprocessing as mp"," "," from vllm.config import (","+    AttentionConfig,","     CacheConfig,","     ModelConfig,","     ParallelConfig,","@@ -28,8 +31,113 @@"," from vllm.utils.torch_utils import set_default_torch_dtype"," from vllm.v1.worker.workspace import init_workspace_manager, reset_workspace_manager"," ","+_SINK_CASES = [(1, 64, False), (2, 32, True), (8, 64, False)]","+if current_platform.is_rocm():","+    # TP2 at 32 heads checks the head-tile gate; 16 keeps ShardQ on at TP2.","+    _SINK_CASES.append((2, 16, True))","+","+","+def _rocm_sink_check(layer, rank, world, device):","+    \"\"\"Returns a check that the real `forward_mqa` applies this rank's sinks to","+    local heads and, from a graph captured once, the reloaded full sinks to","+    ShardQ's all-head query.\"\"\"","+    from vllm import _custom_ops as ops","+    from vllm.models.hy_v4.amd.aiter_mla_sparse import HYV4ShardQAiterMLASparseImpl","+","+    impl = layer.mla_attn.impl","+    assert isinstance(impl, HYV4ShardQAiterMLASparseImpl)","+    num_heads = impl.num_heads * world","+    block_size, num_slots, rank_dim = 64, 128, impl.kv_lora_rank","+    gen = torch.Generator(device).manual_seed(0)","+    kv_c = torch.randn(num_slots, rank_dim, device=device, generator=gen) * 0.5","+    k_pe = torch.randn(num_slots, 64, device=device, generator=gen) * 0.5","+    cache = torch.zeros(num_slots // block_size, block_size, 656, dtype=torch.uint8)","+    ops.concat_and_cache_mla(","+        kv_c.bfloat16(),","+        k_pe.bfloat16(),","+        cache,","+        torch.arange(num_slots),","+        kv_cache_dtype=\"fp8_ds_mla\",","+        scale=torch.ones(1),","+    )","+    rows = cache.view(num_slots, 656)","+    nope = rows[:, :rank_dim].contiguous().view(torch.float8_e4m3fn).float()","+    scales = rows[:, rank_dim : rank_dim + 16].contiguous().view(torch.float32)","+    rope = rows[:, rank_dim + 16 :].contiguous().view(torch.bfloat16).float()","+    keys = torch.cat((nope * scales.repeat_interleave(128, dim=1), rope), dim=1)","+","+    # Few live keys keep the sink's share above BF16 noise.","+    live_counts = [64, 1, 64, 17]","+    num_tokens = len(live_counts)","+    topk = impl.topk_indices_buffer","+    assert topk is not None","+    topk[:num_tokens] = -1","+    for i, count in enumerate(live_counts):","+        topk[i, :count] = torch.randperm(num_slots, device=device)[:count]","+    live = [topk[i, :count].long() for i, count in enumerate(live_counts)]","+    metadata = SimpleNamespace(","+        num_actual_tokens=num_tokens,","+        num_prefills=0,","+        topk_start=0,","+        topk_tokens=topk.shape[1],","+        block_size=block_size,","+        block_table=torch.tensor([[0, 1]], dtype=torch.int32),","+        req_id_per_token=torch.zeros(num_tokens, dtype=torch.int32),","+        paged_kv_indptr=torch.tensor([0, *live_counts]).cumsum(0).int(),","+        paged_kv_indices=torch.zeros(num_tokens * topk.shape[1], dtype=torch.int32),","+        attn_out_dtype=torch.bfloat16,","+        remapped_buf=None,","+        remapped_epoch=-1,","+    )","+    full_q = torch.randn(num_tokens, num_heads, 576, device=device, generator=gen)","+    full_q = (full_q * 0.5).bfloat16()","+    heads = slice(rank * impl.num_heads, (rank + 1) * impl.num_heads)","+    local_q = full_q[:, heads].contiguous()","+","+    def reference(q, sinks):","+        out = torch.empty(q.shape[:2] + (rank_dim,))","+        for i, slots in enumerate(live):","+            scores = q[i].float() @ keys[slots].T * impl.scale","+            lse = torch.logsumexp(torch.cat((scores, sinks[:, None]), dim=1), dim=1)","+            out[i] = (torch.exp(scores - lse[:, None]) @ keys[slots, :rank_dim]).cpu()","+        return out","+","+    graph = None","+    graph_out = None","+","+    def check(checkpoint_sinks):","+        nonlocal graph, graph_out","+        local = impl._attn_sink(local_q)","+        assert local is not None","+        torch.testing.assert_close(local, checkpoint_sinks[heads])","+        full = impl._attn_sink(full_q)","+        assert full is not None","+        torch.testing.assert_close(full, checkpoint_sinks)","+        with torch.no_grad():","+            out, _ = impl.forward_mqa(local_q, cache, metadata, layer.mla_attn)","+            if graph is None:","+                impl.forward_mqa(full_q, cache, metadata, layer.mla_attn)","+                graph = torch.cuda.CUDAGraph()","+                with torch.cuda.graph(graph):","+                    graph_out, _ = impl.forward_mqa(","+                        full_q, cache, metadata, layer.mla_attn","+                    )","+            graph.replay()","+        tol = dict(atol=2e-2, rtol=2e-2)","+        expected = reference(local_q, checkpoint_sinks[heads])","+        torch.testing.assert_close(out.float().cpu(), expected, **tol)","+        expected = reference(full_q, checkpoint_sinks)","+        torch.testing.assert_close(graph_out.float().cpu(), expected, **tol)","+","+    return check","+"," "," def _check_sinks(rank, world, num_heads, offload, port, model_path):","+    attention_cls = HYV4MLAAttention","+    if current_platform.is_rocm():","+        from vllm.models.hy_v4.amd.attention import HYV4MLAAttention as AMDAttention","+","+        attention_cls = AMDAttention","     torch.accelerator.set_device_index(rank)","     device = torch.device(\"cuda\", rank)","     config = VllmConfig(","@@ -37,6 +145,7 @@ def _c