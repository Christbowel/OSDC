ts UNC share, either","+    // of which would otherwise leak into the user-visible store path.","+    let Ok(pkg_root) = pnpm_fs::canonicalize_preserving_mapped_drive(pkg_root) else {","         return home_default;","     };"," "],"additions":4,"deletions":3,"truncated":false},{"path":"pnpm/crates/fs/Cargo.toml","lines":["@@ -37,9 +37,11 @@ libc = { workspace = true }"," junction = { workspace = true }"," same-file = { workspace = true }"," windows-sys = { workspace = true, features = [","+  \"Win32_Globalization\",","   \"Win32_Storage_FileSystem\",","   \"Win32_System_Com\",","   \"Win32_System_Console\",","+  \"Win32_NetworkManagement_WNet\",","   \"Win32_UI_Shell\","," ] }"," "],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/fs/src/lib.rs","lines":["@@ -25,6 +25,7 @@ pub use is_not_found::is_not_found;"," pub use is_subdir::is_subdir;"," pub use lexical_normalize::{lexical_normalize, lexical_normalize_posix};"," pub use lock_mode::LockMode;","+pub use mapped_drive_path::canonicalize_preserving_mapped_drive;"," pub use open_dir::OpenDir;"," #[cfg(unix)]"," pub use pending_temp::die_from_signal;","@@ -74,6 +75,7 @@ mod is_not_found;"," mod is_subdir;"," mod lexical_normalize;"," mod lock_mode;","+mod mapped_drive_path;"," mod open_dir;"," mod pending_temp;"," mod private_named_tempfile;"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/fs/src/mapped_drive_path.rs","lines":["@@ -0,0 +1,153 @@","+use std::path::{Path, PathBuf};","+","+#[cfg(all(windows, test))]","+#[path = \"mapped_drive_path/tests.rs\"]","+mod tests;","+","+/// [`dunce::canonicalize`], except that a path on a mapped Windows network","+/// drive keeps its drive letter instead of turning into the share's UNC form.","+///","+/// Only the drive `path` itself names is restored. A path given in UNC form","+/// stays UNC: mapping it onto some drive could cut off ancestors that lie","+/// above that drive's root, such as the workspace root.","+pub fn canonicalize_preserving_mapped_drive(path: &Path) -> std::io::Result<PathBuf> {","+    let absolute =","+        if path.is_absolute() { path.to_path_buf() } else { std::env::current_dir()?.join(path) };","+    let canonical = dunce::canonicalize(&absolute)?;","+    #[cfg(windows)]","+    if is_unc_path(&canonical)","+        && let Some(drive) = drive_letter(&absolute)","+        && let Some(remote) = mapped_drive(drive)","+        && let Some(mapped) = mapped_drive_path(&canonical, drive, &remote)","+    {","+        return Ok(mapped);","+    }","+    Ok(canonical)","+}","+","+#[cfg(windows)]","+fn is_unc_path(path: &Path) -> bool {","+    use std::path::Prefix;","+","+    matches!(","+        path.components().next(),","+        Some(std::path::Component::Prefix(prefix))","+            if matches!(prefix.kind(), Prefix::UNC(..) | Prefix::VerbatimUNC(..)),","+    )","+}","+","+#[cfg(windows)]","+fn drive_letter(path: &Path) -> Option<char> {","+    match path.components().next()? {","+        std::path::Component::Prefix(prefix) => match prefix.kind() {","+            std::path::Prefix::Disk(letter) | std::path::Prefix::VerbatimDisk(letter) => {","+                Some((letter as char).to_ascii_uppercase())","+            }","+            _ => None,","+        },","+        _ => None,","+    }","+}","+","+#[cfg(windows)]","+fn mapped_drive(letter: char) -> Option<PathBuf> {","+    use std::{ffi::OsString, os::windows::ffi::OsStringExt};","+    use windows_sys::Win32::{","+        Foundation::ERROR_MORE_DATA, NetworkManagement::WNet::WNetGetConnectionW,","+    };","+","+    let drive_name = [letter as u16, u16::from(b':'), 0];","+    let mut remote_name = vec![0u16; 512];","+    let mut length = remote_name.len() as u32;","+    // SAFETY: The buffers are writable for the lengths passed to WNetGetConnectionW.","+    let mut result = unsafe {","+        WNetGetConnectionW(drive_name.as_ptr(), remote_name.as_mut_ptr(), &raw mut length)","+    };","+    if result == ERROR_MORE_DATA {","+        remote_name.resize(length as usize, 0);","+        // SAFETY: The resized buffer and length pointer are writable for this call.","+        result = unsafe {","+            WNetGetConnectionW(drive_name.as_ptr(), remote_name.as_mut_ptr(), &raw mut length)","+        };","+    }","+    if result != 0 {","+        return None;","+    }","+    let remote_length = remote_name","+        .iter()","+        .position(|unit| *unit == 0)?;","+    Some(PathBuf::from(OsString::from_wide(&remote_name[..remote_length])))","+}","+","+#[cfg(windows)]","+fn mapped_drive_path(path: &Path, drive: char, remote: &Path) -> Option<PathBuf> {","+    let suffix = mapped_path_suffix(&remove_verbatim_unc_prefix(path), remote)?;","+    Some(PathBuf::from(format!(r\"{drive}:\\\")).join(suffix))","+}","+","+#[cfg(windows)]","+fn mapped_path_suffix(path: &Path, remote: &Path) -> Option<PathBuf> {","+    use std::os::windows::ffi::{OsStrExt as _, OsStringExt as _};","+    use windows_sys::Win32::Globalization::{CSTR_EQUAL, CompareStringOrdinal};","+","+    let path: Vec<u16> = path.as_os_str().encode_wide().collect();","+    let mut remote: Vec<u16> = remote","+        .as_os_str()","+        .encode_wide()","+        .collect();","+    while remote","+        .last()","+        .is_some_and(|unit| matches!(*unit, 0x2f | 0x5c))","+    {","+        remote.pop();","+    }","+    if path.len() < remote.len()","+        || (path.len() > remote.len() && !matches!(path[remote.len()], 0x2f | 0x5c))","+    {","+        return None;","+    }","+    // SAFETY: Both pointers address initialized UTF-16 slices for the lengths passed.","+    let equal = unsafe {","+        CompareStringOrdinal(","+            path.as_ptr(),","+            remote.len() as i32,","+            remote.as_ptr(),","+            remote.len() as i32,","+            1,","+        )","+    };","+    if equal != CSTR_EQUAL {","+        return None;","+    }","+    let mut suffix = remote.len();","+    while path","+        .get(suffix)","+        .is_some_and(|unit| matches!(*unit, 0x2f | 0x5c))","+    {","+        suffix += 1;","+    }","+    Some(PathBuf::from(std::ffi::OsString::from_wide(&path[suffix..])))","+}","+","+#[cfg(windows)]","+fn remove_verbatim_unc_prefix(path: &Path) -> PathBuf {","+    use std::os::windows::ffi::{OsStrExt as _, OsStringExt as _};","+","+    let wide: Vec<u16> = path.as_os_str().encode_wide().collect();","+    let prefix = [","+        u16::from(b'\\\\'),","+        u16::from(b'\\\\'),","+        u16::from(b'?'),","+        u16::from(b'\\\\'),","+        u16::from(b'U'),","+        u16::from(b'N'),","+        u16::from(b'C'),","+        u16::from(b'\\\\'),","+    ];","+    if wide.len() < prefix.len() || wide[..prefix.len()] != prefix {","+        return path.to_path_buf();","+    }","+    let mut unc = vec![u16::from(b'\\\\'), u16::from(b'\\\\')];","+    unc.extend_from_slice(&wide[prefix.len()..]);","+    PathBuf::from(std::ffi::OsString::from_wide(&unc))","+}"],"additions":153,"deletions":0,"truncated":false},{"path":"pnpm/crates/fs/src/mapped_drive_path/tests.rs","lines":["@@ -0,0 +1,74 @@","+use super::mapped_drive_path;","+use std::path::{Path, PathBuf};","+","+#[test]","+fn mapped_unc_path_uses_its_original_drive() {","+    assert_eq!(","+        mapped_drive_path(","+            Path::new(r\"\\\\server\\share\\project\\node_modules\"),","+            'H',","+            Path::new(r\"\\\\server\\share\"),","+        ),","+        Some(PathBuf::from(r\"H:\\project\\node_modules\")),","+    );","+}","+","+#[test]","+fn mapped_verbatim_unc_path_uses_its_original_drive() {","+    assert_eq!(","+        mapped_drive_path(","+            Path::new(r\"\\\\?\\UNC\\server\\share\\project\"),","+            'H',","+            Path::new(r\"\\\\server\\share\")","+        ),","+        Some(PathBuf::from(r\"H:\\project\")),","+    );","+}","+","+#[test]","+fn mapped_unc_share_root_maps_to_the_drive_root() {","+    assert_eq!(","+        mapped_drive_path(Path::new(r\"\\\\server\\share\"), 'H', Path::new(r\"\\\\server\\share\\\")),","+        Some(PathBuf::from(r\"H:\\\")),","+    );","+}","+","+#[test]","+fn mapped_unc_path_under_a_nested_share_maps_below_the_drive_root() {","+    assert_eq!(","+        mapped_drive_path(","+            Path::new(r\"\\\\server\\share\\nested\\project\"),","+            'J',","+            Path::new(r\"\\\\server\\share\\nested\"),","+        ),","+        Some(PathBuf::from(r\"J:\\project\")),","+    );","+}","+","+#[test]","+fn mapped_unc_path_matches_share_names_without_case_sensitivity() {","+    assert_eq!(","+        mapped_drive_path(Path::new(r\"\\\\SERVER\\SHARE\\project\"), 'H', Path::new(r\"\\\\server\\share\")),","+        Some(PathBuf::from(r\"H:\\project\")),","+    );","+}","+","+#[test]","+fn mapped_unc_path_does_not_match_a_partial_share_name() {","+    assert_eq!(","+        mapped_drive_path(","+            Path::new(r\"\\\\server\\share-other\\project\"),","+            'H',","+            Path::new(r\"\\\\server\\share\")","+        ),","+        None,","+    );","+}","+","+#[test]","+fn mapped_unc_path_does_not_match_a_path_shorter_than_the_share() {","+    assert_eq!(","+        mapped_drive_path(Path::new(r\"\\\\server\\share\"), 'H', Path::new(r\"\\\\server\\share\\nested\")),","+        None,","+    );","+}"],"additions":74,"deletions":0,"truncated":false},{"path":"pnpm/crates/workspace/src/inventory.rs","lines":["@@ -5,7 +5,7 @@ use miette::Diagnostic;"," use std::{","     collections::{BTreeMap, BTreeSet},","     ffi::OsStr,","-    fs, io,","+    io,","     path::{Path, PathBuf},"," };"," use wax::Program as _;","@@ -138,7 +138,7 @@ fn find_workspace_inventory_with("," }"," "," fn canonical_workspace_root(workspace_root: &Path) -> Result<PathBuf, FindWorkspaceInventoryError> {","-    fs::canonicalize(workspace_root)","+    std::fs::canonicalize(workspace_root)","         .map_err(|source| FindWorkspaceInventoryError::ReadDirectory {","             path: workspace_root.to_path_buf(),","             source,","@@ -172,11 +172,22 @@ fn ignored_paths_under(","     workspace_root: &Path,","     canonical_root: &Path,","     ignored_directories: &[PathBuf],","+) -> Result<BTreeSet<PathBuf>, FindWorkspaceInventoryError> {","+    ignored_paths_under_with(workspace_root, canonical_root, ignored_directories, |path| {","+        std::fs::canonicalize(path)","+    })","+}","+","+fn ignored_paths_under_with(","+    workspace_root: &Path,","+    canonical_root: &Path,","+    ignored_directories: &[PathBuf],","+    mut canonicalize: impl FnMut(&Path) -> io::Result<PathBuf>,"," ) -> Result<BTreeSet<PathBuf>, FindWorkspaceInventoryError> {","     let mut paths = BTreeSet::new();","     for path in ignored_directories {","         let path = workspace_root.join(path);","-        let canonical = match fs::canonicalize(&path) {","+        let canonical = match canonicalize(&path) {","             Ok(path) => path,","             Err(error) if error.kind() == io::ErrorKind::NotFound => continue,","             Err(source) => {"],"additions":14,"deletions":3,"truncated":false},{"path":"pnpm/crates/workspace/src/inventory/tests.rs","lines":["@@ -3,6 +3,11 @@ use pnpm_fs::symlink_dir as symlink;"," use pretty_assertions::assert_eq;"," use std::fs;"," ","+#[cfg(windows)]","+use super::ignored_paths_under_with;","+#[cfg(windows)]","+use std::path::{Path, PathBuf};","+"," #[test]"," fn discovers_multiple_manifest_kinds_in_one_inventory() {","     let workspace = tempfile::tempdir().unwrap();","@@ -189,6 +194,35 @@ fn prunes_managed_paths_before_opening_without_excluding_matching_project_names(","     }"," }"," ","+#[cfg(windows)]","+#[test]","+fn ignores_mapped_aliases_without_ignoring_paths_outside_the_root() {","+    let ignored = ignored_paths_under_with(","+        Path::new(r\"H:\\repo\"),","+        Path::new(r\"\\\\?\\UNC\\server\\share\\repo\"),","+        &[","+            PathBuf::from(r\"J:\\repo\\cache\"),","+            PathBuf::from