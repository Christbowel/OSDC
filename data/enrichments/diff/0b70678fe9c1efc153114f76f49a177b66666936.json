{"id":"0b70678fe9c1efc153114f76f49a177b66666936","axis":"silent","repo":"systemd/systemd","sha":"0b70678fe9c1efc153114f76f49a177b66666936","parsed":{"files":[{"path":"man/systemd-vmspawn.xml","lines":["@@ -219,8 +219,14 @@"," ","           <para>Unless confidential computing is enabled, a virtio-balloon device is attached to the","           virtual machine. Free page reporting is enabled on it, so memory the guest frees is returned","-          to the host, and the guest is permitted to deflate the balloon on its own when it runs out","-          of memory. The balloon is not inflated by <command>systemd-vmspawn</command> itself at this time.</para>","+          to the host. The guest's memory may be shrunk and grown again at runtime, up to","+          <replaceable>BYTES</replaceable>, via the <function>SetMemory()</function> method of the","+          <literal>io.systemd.MachineInstance</literal> Varlink interface on the machine's control","+          socket. <function>Describe()</function> reports the requested and the current size. Resizing","+          is asynchronous, the guest may follow only partially, and it is permitted to deflate the","+          balloon on its own when it runs out of memory. The requested size persists across guest","+          reboots: a freshly booted guest inflates its balloon to it again.","+          <xi:include href=\"version-info.xml\" xpointer=\"v263\"/></para>"," ","           <xi:include href=\"version-info.xml\" xpointer=\"v255\"/>","           </listitem>"],"additions":8,"deletions":2,"truncated":false},{"path":"src/vmspawn/vmspawn-memory.c","lines":["@@ -1,9 +1,12 @@"," /* SPDX-License-Identifier: LGPL-2.1-or-later */"," "," #include \"sd-json.h\"","+#include \"sd-varlink.h\""," "," #include \"alloc-util.h\"","+#include \"json-util.h\""," #include \"log.h\"","+#include \"memory-util.h\""," #include \"qmp-client.h\""," #include \"string-util.h\""," #include \"vmspawn-memory.h\"","@@ -58,6 +61,42 @@ static int on_query_balloon_complete(","         return 0;"," }"," ","+typedef struct SetTargetRequest {","+        VmspawnMemory *m;","+        sd_varlink *link;       /* ref'd */","+        uint64_t bytes;","+} SetTargetRequest;","+","+static SetTargetRequest* set_target_request_free(SetTargetRequest *req) {","+        if (!req)","+                return NULL;","+","+        sd_varlink_unref(req->link);","+        return mfree(req);","+}","+","+DEFINE_TRIVIAL_CLEANUP_FUNC(SetTargetRequest*, set_target_request_free);","+","+static int on_balloon_complete(","+                QmpClient *client,","+                sd_json_variant *result,","+                const char *error_desc,","+                int error,","+                void *userdata) {","+","+        _cleanup_(set_target_request_freep) SetTargetRequest *req = ASSERT_PTR(userdata);","+","+        assert(client);","+","+        if (error < 0)","+                return vmspawn_qmp_reply_error(req->link, error_desc, error);","+","+        req->m->target = req->bytes;","+        log_debug(\"Requested guest memory size %\" PRIu64 \" KiB.\", req->bytes / U64_KB);","+","+        return sd_varlink_reply(req->link, NULL);","+}","+"," static int memory_refresh(VmspawnMemory *m) {","         assert(m);","         assert(m->bridge);","@@ -73,6 +112,52 @@ static int memory_refresh(VmspawnMemory *m) {","                                  m);"," }"," ","+int vmspawn_memory_set_target(VmspawnMemory *m, sd_varlink *link, uint64_t bytes) {","+        _cleanup_(set_target_request_freep) SetTargetRequest *req = NULL;","+        _cleanup_(sd_json_variant_unrefp) sd_json_variant *args = NULL;","+        int r;","+","+        assert(m);","+        assert(m->bridge);","+        assert(link);","+","+        if (!m->balloon)","+                return -EOPNOTSUPP;","+        if (bytes == 0 || bytes > m->configured)","+                return -ERANGE;","+","+        /* The balloon counts 4 KiB pages, but the guest rounds that count up to its own page size, which","+         * is 64 KiB at most on Linux. Round up to that, so that the guest can settle exactly on the","+         * target instead of below it. Boot RAM is MiB-aligned, so this stays within range. */","+        bytes = ALIGN_TO_U64(bytes, 64 * U64_KB);","+","+        r = sd_json_buildo(&args, SD_JSON_BUILD_PAIR_UNSIGNED(\"value\", bytes));","+        if (r < 0)","+                return r;","+","+        req = new(SetTargetRequest, 1);","+        if (!req)","+                return -ENOMEM;","+","+        *req = (SetTargetRequest) {","+                .m = m,","+                .link = sd_varlink_ref(link),","+                .bytes = bytes,","+        };","+","+        r = qmp_client_invoke(m->bridge->qmp,","+                              /* ret_slot= */ NULL,","+                              \"balloon\",","+                              QMP_CLIENT_ARGS(args),","+                              on_balloon_complete,","+                              req);","+        if (r < 0)","+                return r;","+","+        TAKE_PTR(req);","+        return 0;","+}","+"," int vmspawn_memory_setup(VmspawnQmpBridge *bridge, uint64_t configured, bool balloon) {","         _cleanup_(vmspawn_memory_freep) VmspawnMemory *m = NULL;","         int r;","@@ -109,3 +194,14 @@ int vmspawn_memory_dispatch_balloon_change(VmspawnMemory *m, sd_json_variant *da"," ","         return memory_update_actual(m, data);"," }","+","+int vmspawn_memory_build_json(VmspawnMemory *m, sd_json_variant **ret) {","+        assert(m);","+        assert(ret);","+","+        return sd_json_buildo(","+                        ret,","+                        SD_JSON_BUILD_PAIR_UNSIGNED(\"configuredBytes\", m->configured),","+                        SD_JSON_BUILD_PAIR_UNSIGNED(\"targetBytes\", m->target),","+                        JSON_BUILD_PAIR_UNSIGNED_NON_ZERO(\"actualBytes\", m->actual));","+}"],"additions":96,"deletions":0,"truncated":false},{"path":"src/vmspawn/vmspawn-memory.h","lines":["@@ -19,9 +19,1