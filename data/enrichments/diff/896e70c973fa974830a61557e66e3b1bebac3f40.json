ectedStatusCode, w.Code)","+\t\t\tassert.Equal(t, test.expectedBody, strings.TrimSpace(w.Body.String()))","+\t\t})","+\t}","+}","+"," func TestGenRevisionHasChanged(t *testing.T) {"," \tt.Parallel()"," \ttype args struct {","@@ -850,18 +918,24 @@ func fakeAppWithMatrixAndPullRequestGeneratorWithPluginGenerator(name, namespace"," }"," "," func newFakeClient(ns string) *kubefake.Clientset {","-\ts := runtime.NewScheme()","-\ts.AddKnownTypes(v1alpha1.SchemeGroupVersion, &v1alpha1.ApplicationSet{})","+\treturn newFakeClientWithSettings(ns, nil, nil)","+}","+","+// newFakeClientWithSettings returns a clientset holding argocd-cm and argocd-secret","+// with the given extra data.","+func newFakeClientWithSettings(ns string, cmData map[string]string, secretData map[string][]byte) *kubefake.Clientset {","+\tdata := map[string][]byte{","+\t\t\"server.secretkey\": nil,","+\t}","+\tmaps.Copy(data, secretData)"," \treturn kubefake.NewClientset(&corev1.ConfigMap{Name: \"argocd-cm\", Namespace: ns, Labels: map[string]string{"," \t\t\"app.kubernetes.io/part-of\": \"argocd\",","-\t}}, &corev1.Secret{","+\t}, Data: cmData}, &corev1.Secret{"," \t\tName:      common.ArgoCDSecretName,"," \t\tNamespace: ns,"," \t\tLabels: map[string]string{"," \t\t\t\"app.kubernetes.io/part-of\": \"argocd\","," \t\t},","-\t\tData: map[string][]byte{","-\t\t\t\"server.secretkey\": nil,","-\t\t},","+\t\tData: data,"," \t})"," }"],"additions":80,"deletions":6,"truncated":false},{"path":"docs/operator-manual/applicationset/Generators-Git.md","lines":["@@ -509,6 +509,27 @@ URL configured in the Git provider should use the `/api/webhook` endpoint of you"," (e.g. `https://applicationset.example.com/api/webhook`). If you wish to use a shared secret, input an"," arbitrary value in the secret. This value will be used when configuring the webhook in the next step."," ","+To limit the impact of unauthenticated webhook events, the ApplicationSet webhook rejects payloads","+larger than the `webhook.maxPayloadSizeMB` value in the `argocd-cm` ConfigMap. This is the same","+setting the [API server webhook](../webhook.md) uses, and the default is 50MB:","+","+```yaml","+apiVersion: v1","+kind: ConfigMap","+metadata:","+  name: argocd-cm","+  namespace: argocd","+  labels:","+    app.kubernetes.io/name: argocd-cm","+    app.kubernetes.io/part-of: argocd","+data:","+  webhook.maxPayloadSizeMB: \"50\"","+```","+","+> [!NOTE]","+> The ApplicationSet controller reads `webhook.maxPayloadSizeMB` when it starts. Restart the","+> controller after changing the value.","+"," ![Add Webhook](../../assets/applicationset/webhook-config.png \"Add Webhook\")"," "," > [!NOTE]"],"additions":21,"deletions":0,"truncated":false},{"path":"docs/operator-manual/upgrading/3.6-3.7.md","lines":["@@ -0,0 +1,25 @@","+# v3.6 to 3.7","+","+## Breaking Changes","+","+<!-- Any breaking behavior change:","+Any removal or change of default behavior that requires user action -->","+","+## Behavioral Improvements / Fixes","+","+### ApplicationSet webhook responses now match the API server webhook","+","+The ApplicationSet controller's webhook endpoint now handles requests the same way as the API","+server's `/api/webhook` endpoint:","+","+- Payloads larger than the `webhook.maxPayloadSizeMB` value in the `argocd-cm` ConfigMap (default","+  50MB) are rejected with `400 Bad Request`. Previously, the ApplicationSet webhook had no payload","+  size limit.","+- A GHCR event that fails signature verification is rejected with `401 Unauthorized` instead of","+  `400 Bad Request`.","+- When a payload cannot be parsed, the response body is a generic `Webhook processing failed`","+  message. The parser error is logged by the ApplicationSet controller instead of being returned to","+  the caller.","+","+If you monitor the ApplicationSet webhook's response codes or bodies, update any checks that relied","+on the previous behavior."],"additions":25,"deletions":0,"truncated":false},{"path":"docs/operator-manual/upgrading/overview.md","lines":["@@ -39,6 +39,7 @@ kubectl apply -n argocd --server-side --force-conflicts -f https://raw.githubuse"," "," <hr/>"," ","+- [v3.6 to v3.7](./3.6-3.7.md)"," - [v3.5 to v3.6](./3.5-3.6.md)"," - [v3.4 to v3.5](./3.4-3.5.md)"," - [v3.3 to v3.4](./3.3-3.4.md)"],"additions":1,"deletions":0,"truncated":false},{"path":"docs/operator-manual/webhook.md","lines":["@@ -27,7 +27,7 @@ URL configured in the Git provider should use the `/api/webhook` endpoint of you"," (e.g. `https://argocd.example.com/api/webhook`). If you wish to use a shared secret, input an"," arbitrary value in the secret. This value will be used when configuring the webhook in the next step."," ","-To prevent DDoS attacks with unauthenticated webhook events (the `/api/webhook` endpoint currently lacks rate limiting protection), it is recommended to limit the payload size. You can achieve this by configuring the `argocd-cm` ConfigMap with the `webhook.maxPayloadSizeMB` attribute. The default value is 50MB.","+To prevent DDoS attacks with unauthenticated webhook events (the `/api/webhook` endpoint currently lacks rate limiting protection), it is recommended to limit the payload size. You can achieve this by configuring the `argocd-cm` ConfigMap with the `webhook.maxPayloadSizeMB` attribute. The default value is 50MB. The same setting also limits the payload size of the [ApplicationSet webhook](applicationset/Generators-Git.md#webhook-configuration)."," "," ### Github"," "],"additions":1,"deletions":1,"truncated":false},{"path":"mkdocs.yml","lines":["@@ -150,6 +150,7 @@ nav:","     - operator-manual/server-commands/additional-configuration-method.md","   - Upgrading:","     - operator-manual/upgrading/overview.md","+    - operator-manual/upgrading/3.6-3.7.md","     - operator-manual/upgrading/3.5-3.6.md","     - operator-manual/upgrading/3.4-3.5.md","     - operator-manual/upgrading/3.3-3.4.md"],"additions":1,"deletions":0,"truncated":false},{"path":"util/webhook/scm.go","lines":["@@ -2,6 +2,7 @@ package webhook"," "," import ("," \t\"errors\"","+\t\"fmt\""," \t\"net/http\""," \t\"sync\""," ","@@ -125,6 +126,56 @@ func Dispatch(parsers []Extractor, r *http.Request) (any, bool, error) {"," \treturn nil, false, nil"," }"," ","+// HandleRequest parses a webhook request with the first parser that can handle","+// it and queues the payload for the handler's workers, writing the HTTP","+// response. Request bodies larger than maxPayloadSizeB are rejected.","+func HandleRequest(w http.ResponseWriter, r *http.Request, parsers []Extractor, maxPayloadSizeB int64, queue chan<- any) {","+\tr.Body = http.MaxBytesReader(w, r.Body, maxPayloadSizeB)","+\tpayload, handled, err := Dispatch(parsers, r)","+\tif !handled {","+\t\thttp.Error(w, \"Unknown webhook event\", http.StatusBadRequest)","+\t\treturn","+\t}","+\tif err != nil {","+\t\tif errors.Is(err, ErrHMACVerificationFailed) || errors.Is(err, ErrSecretVerificationFailed) {","+\t\t\tlog.WithField(common.SecurityField, common.SecurityHigh).Info(\"Registry webhook authentication failed\")","+\t\t\thttp.Error(w, \"Unauthorized\", http.StatusUnauthorized)","+\t\t\treturn","+\t\t}","+","+\t\t// If the error is due to a large payload, return a more user-friendly error message","+\t\tif isParsingPayloadError(err) {","+\t\t\tlog.WithField(common.SecurityField, common.SecurityHigh).Warnf(\"Webhook processing failed: payload too large or corrupted (limit %v MB): %v\", maxPayloadSizeB/1024/1024, err)","+\t\t\thttp.Error(w, fmt.Sprintf(\"Webhook processing failed: payload must be valid JSON under %v MB\", maxPayloadSizeB/1024/1024), http.StatusBadRequest)","+\t\t\treturn","+\t\t}","+","+\t\tstatus := http.StatusBadRequest","+\t\tif r.Method != http.MethodPost {","+\t\t\tstatus = http.StatusMethodNotAllowed","+\t\t}","+\t\tlog.Infof(\"Webhook processing failed: %v\", err)","+\t\thttp.Error(w, \"Webhook processing failed\", status)","+\t\treturn","+\t}","+","+\t// Parser claimed the request but produced no payload (e.g. GHCR event that","+\t// was intentionally skipped). Acknowledge with 200 and skip the queue.","+\tif payload == nil {","+\t\tw.WriteHeader(http.StatusOK)","+\t\treturn","+\t}","+","+\tselect {","+\tcase queue <- payload:","+\tdefault:","+\t\tlog.Info(\"Queue is full, discarding webhook payload\")","+\t\thttp.Error(w, \"Queue is full, discarding webhook payload\", http.StatusServiceUnavailable)","+\t\treturn","+\t}","+\tw.WriteHeader(http.StatusOK)","+}","+"," // StartWorkers starts count goroutines, tracked by wg, that pass each payload"," // read from queue to handle until the queue is closed. A panic in handle is"," // logged with panicMsg and the worker moves on to the next payload.","@@ -139,6 +190,16 @@ func StartWorkers(wg *sync.WaitGroup, count int, queue <-chan any, handle func(a"," \t}"," }"," ","+// isParsingPayloadError returns a bool if the error is parsing payload error","+func isParsingPayloadError(err error) bool {","+\treturn errors.Is(err, github.ErrParsingPayload) ||","+\t\terrors.Is(err, gitlab.ErrParsingPayload) ||","+\t\terrors.Is(err, gogs.ErrParsingPayload) ||","+\t\terrors.Is(err, bitbucket.ErrParsingPayload) ||","+\t\terrors.Is(err, bitbucketserver.ErrParsingPayload) ||","+\t\terrors.Is(err, azuredevops.ErrParsingPayload)","+}","+"," type azureDevOpsParser struct {"," \twebhook *azuredevops.Webhook"," \tevents  []azuredevops.Event"],"additions":61,"deletions":0,"truncated":false},{"path":"util/webhook/scm_test.go","lines":["@@ -91,6 +91,111 @@ func TestDispatch(t *testing.T) {"," \t})"," }"," ","+func TestHandleRequest(t *testing.T) {","+\tconst maxPayloadSizeB = 1024 * 1024","+","+\ttests := []struct {","+\t\tname         string","+\t\tgithubSecret string","+\t\tmethod       string","+\t\tevent        string","+\t\tbody         string","+\t\tqueueFull    bool","+\t\twantStatus   int","+\t\twantBody     string","+\t\twantQueued   bool","+\t}{","+\t\t{","+\t\t\tname:       \"unknown webhook event is rejected\",","+\t\t\tbody:       `{}`,","+\t\t\twantStatus: http