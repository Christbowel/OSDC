{"id":"d8ef077f569ed1b66a4b086c07466f333bf72ba4","axis":"silent","repo":"pycqa/isort","sha":"d8ef077f569ed1b66a4b086c07466f333bf72ba4","parsed":{"files":[{"path":"docs/configuration/options.md","lines":["@@ -44,10 +44,10 @@ py_version=39"," "," ## Force To Top"," ","-Force specific imports to the top of their appropriate section.","+Force specific imports to the top of their appropriate section. The order of specified modules is preserved at the top of the section."," "," **Type:** List of Strings  ","-**Default:** `frozenset()`  ","+**Default:** `()`"," **Config default:** `[]`  "," **Python & Config File Name:** force_to_top  "," **CLI Flags:**","@@ -55,6 +55,28 @@ Force specific imports to the top of their appropriate section."," - -t"," - --top"," ","+**Examples:**","+","+### Example `.isort.cfg`","+","+```","+[settings]","+force_to_top=torch,tensorflow","+","+```","+","+### Example `pyproject.toml`","+","+```","+[tool.isort]","+force_to_top = [\"torch\", \"tensorflow\"]","+","+```","+","+### Example cli usage","+","+`isort -t torch -t tensorflow`","+"," ## Skip"," "," Files that isort should skip over. If you want to skip multiple files you should specify twice: `--skip file1 --skip file2`. Values can be file names, directory names or file paths. To skip all files in a nested path, use [`--skip-glob`](#skip-glob). To even skip matching files that have been specified on the command line, use [`--filter-files`](#filter-files)."],"additions":24,"deletions":2,"truncated":false},{"path":"isort/settings.py","lines":["@@ -128,7 +128,7 @@ class _Config:","     \"\"\""," ","     py_version: str = \"3\"","-    force_to_top: frozenset[str] = frozenset()","+    force_to_top: tuple[str, ...] = ()","     skip: frozenset[str] = DEFAULT_SKIP","     extend_skip: frozenset[str] = frozenset()","     skip_glob: frozenset[str] = frozenset()"],"additions":1,"deletions":1,"truncated":false},{"path":"isort/sorting.py","lines":["@@ -48,7 +48,11 @@ def module_key(","         or str(section_name).lower() in config.length_sort_sections","     )","     _length_sort_maybe = (str(len(module_name)) + \":\" + module_name) if length_sort else module_name","-    return f\"{(module_name in config.force_to_top and 'A') or 'B'}{prefix}{_length_sort_maybe}\"","+    if module_name in config.force_to_top:","+        top_prefix = f\"A{config.force_to_top.index(module_name):05d}_\"","+    else:","+        top_prefix = \"B\"","+    return f\"{top_prefix}{prefix}{_length_sort_maybe}\""," "," "," def section_key(line: str, config: Config) -> str:","@@ -73,8 +77,9 @@ def section_key(line: str, config: Config) -> str:","     if config.sort_relative_in_force_sorted_sections:","         sep = \" \" if config.reverse_relative else \"_\"","         line = re.sub(r\"^(\\.+)\", rf\"\\1{sep}\", line)","-    if line.split(\" \")[0] in config.force_to_top:","-        section = \"A\"","+    module_name = line.split(\" \")[0]","+    if module_name in config.force_to_top:","+        section = f\"A{config.force_to_top.index(module_name):05d}_\"","     # * If honor_case_in_force_sorted_sections is true, and case_sensitive and","     #   order_by_type are different, only ignore case in part of the line.","     # * Otherwise, let order_by_type decide the sorting of the whole line. This"],"additions":8,"deletions":3,"truncated":false},{"path":"scripts/build_config_option_docs.py","lines":["@@ -133,10 +133,20 @@ def __str__(self):","     \"indented_import_headings\": \"If `True` isort will apply import headings to indented imports the same way it does unindented ones.\",","     \"import_headings\": \"A mapping of import sections to import heading comments that should show above them.\",","     \"import_footers\": \"A mapping of import sections to import footer comments that should show below them.\",","+    \"force_to_top\": \"Force specific imports to the top of their appropriate section. The order of specified modules is preserved at the top of the section.\","," }"," "," example_mapping: dict[str, Example]"," example_mapping = {","+    \"force_to_top\": Example(","+        cfg=\"\"\"","+force_to_top=torch,tensorflow","+\"\"\",","+        pyproject_toml=\"\"\"","+force_to_top = [\"torch\", \"tensorflow\"]","+\"\"\",","+        cli=\"isort -t torch -t tensorflow\",","+    ),","     \"skip\": Example(","         cfg=\"\"\""," skip=.gitignore,.dockerignore\"\"\","],"additions":10,"deletions":0,"truncated":false},{"path":"tests/unit/test_ticketed_features.py","lines":["@@ -10,7 +10,7 @@"," import pytest"," "," import isort","-from isort import Config, exceptions","+from isort import Config, exceptions, main"," "," "," def test_semicolon_ignored_for_dynamic_lines_after_import_issue_1178() -> None:","@@ -1263,3 +1263,143 @@ def test_comment_not_duplicated_across_from_imports_2282() -> None:"," from foo import c as d"," \"\"\"","     assert isort.code(code) == code","+","+","+def test_force_to_top_preserves_user_specified_order_issue_2130() -> None:","+    \"\"\"Ensure force_to_top preserves the user-specified ordering when multiple modules are provided.","+","+    See: https://github.com/PyCQA/isort/issues/2130","+    \"\"\"","+    # 1. Original torch then tensorflow example","+    assert (","+        isort.code(\"import tensorflow\\nimport torch\\n\", force_to_top=[\"torch\", \"tensorflow\"])","+        == \"import torch\\nimport tensorflow\\n\"","+    )","+","+    # 2. Three modules in deliberately non-alphabetical order","+    assert (","+        isort.code(","+            \"import a_mod\\nimport m_mod\\nimport z_mod\\n\",","+            force_to_top=[\"z_mod\", \"m_mod\", \"a_mod\"],","+        )","+        == \"import z_mod\\nimport m_mod\\nimport a_mod\\n\"","+    )","+","+    # 3. Forced modules remaining above unforced modules","+    assert (","+        isort.code(","+            \"import b_mod\\nimport z_mod\\nimport a_mod\\nimport m_mod\\n\",","+            force_to_top=[\"z_mod\", \"a_mod\"],","+        )","+        == \"import z_mod\\nimport a_mod\\nimport b_mod\\nimport m_mod\\n\"","+    )","+","+    # 4. force_sort_within_sections=True including both import and from imports","+    test_within_sections = (","+        \"import tensorflow\\nfrom torch import Tensor\\nfrom tensorflow import keras\\nimport torch\\n\"","+    )","+    expected_within_sections = (","+        \"import torch\\nfrom torch import Tensor\\nimport tensorflow\\nfrom tensorflow import keras\\n\"","+    )","+    assert (","+        isort.code(","+            test_within_sections,","+            force_to_top=[\"torch\", \"tensorflow\"],","+            force_sort_within_sections=True,","+        )","+        == expected_within_sections","+    )","+","+    # 5. length_sort=True respects user-specified ordering","+    assert (","+        isort.code(","+            \"import short\\nimport long_module_name\\n\",","+            force_to_top=[\"long_module_name\", \"short\"],","+            length_sort=True,","+        )","+        == \"import long_module_name\\nimport short\\n\"","+    )","+","+    # 6. Both natural and native sorting modes","+    assert (","+        isort.code(","+            \"import tensorflow\\nimport torch\\n\",","+            force_to_top=[\"torch\", \"tensorflow\"],","+            sort_order=\"native\",","+        )","+        == \"import torch\\nimport tensorflow\\n\"","+    )","+    assert (","+        isort.code(","+            \"import tensorflow\\nimport torch\\n\",","+            force_to_top=[\"torch\", \"tensorflow\"],","+            sort_order=\"natural\",","+        )","+        == \"import torch\\nimport tensorflow\\n\"","+    )","+","+","+def test_force_to_top_preserves_order_from_config_file_issue_2130(tmp_path: Path) -> None:","+    \"\"\"Ensure force_to_top ordering survives config file parsing.","+","+    See: https://github.com/PyCQA/isort/issues/2130","+    \"\"\"","+    config_file = tmp_path / \"pyproject.toml\"","+    config_file.write_text(","+        '[tool.isort]\\nforce_to_top = [\"torch\", \"tensorflow\"]\\n',","+        encoding=\"utf-8\",","+    )","+    config = Config(settings_path=str(tmp_path))","+    assert config.force_to_top == (\"torch\", \"tensorflow\")","+    assert (","+        isort.code(\"import tensorflow\\nimport torch\\n\", config=config)","+        == \"import torch\\nimport tensorflow\\n\"","+    )","+","+","+def test_force_to_top_preserves_order_from_isort_cfg_issue_2130(tmp_path: Path) -> None:","+    \"\"\"Ensure comma-separated force_to_top ordering survives .isort.cfg parsing.","+","+    See: https://github.com/PyCQA/isort/issues/2130","+    \"\"\"","+    config_file = tmp_path / \".isort.cfg\"","+    config_file.write_text(","+        \"[settings]\\nforce_to_top=torch,tensorflow\\n\",","+        encoding=\"utf-8\",","+    )","+    config = Config(settings_path=str(tmp_path))","+    assert config.force_to_top == (\"torch\", \"tensorflow\")","+    assert (","+        isort.code(\"import tensorflow\\nimport torch\\n\", config=config)","+        == \"import torch\\nimport tensorflow\\n\"","+    )","+","+    # Also verify with 3 non-alphabetical modules","+    config_file.write_text(","+        \"[settings]\\nforce_to_top=z_mod,m_mod,a_mod\\n\",","+        encoding=\"utf-8\",","+    )","+    config = Config(settings_path=str(tmp_path))","+    assert config.force_to_top == (\"z_mod\", \"m_mod\", \"a_mod\")","+    assert (","+        isort.code(\"import a_mod\\nimport m_mod\\nimport z_mod\\n\", config=config)","+        == \"import z_mod\\nimport m_mod\\nimport a_mod\\n\"","+    )","+","+","+def test_force_to_top_preserves_order_from_cli_issue_2130(tmp_path: Path) -> None:","+    \"\"\"Ensure repeated --top / -t CLI flags preserve user-specified order in formatted output.","+","+    See: https://github.com/PyCQA/isort/issues/2130","+    \"\"\"","+    python_file = tmp_path / \"test_file.py\"","+    python_file.write_text(\"import tensorflow\\nimport torch\\n\", encoding=\"utf-8\")","+","+    # Short flag -t","+    main.main([str(python_file), \"-t\", \"torch\", \"-t\", \"tensorflow\"])","+    assert python_file.read_text(encoding=\"utf-8\") == \"import torch\\nimport tensorflow\\n\"","+","+    # Long flag --top with non-alphabetical ordering","+    python_file.write_text(\"import a_mod\\nimport m_mod\\nimport z_mod\\n\", encoding=\"utf-8\")","+    main.main([str(python_file), \"--top\", \"z_mod\", \"--top\", \"m_mod\", \"--top\", \"a_mod\"])","+    assert python_file.read_text(encoding=\"utf-8\") == \"import z_mod\\nimport m_mod\\nimport a_mod\\n\"",""],"additions":141,"deletions":1,"truncated":false}],"additions":184,"deletions":7,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-16T17:23:07.618912+00:00"}