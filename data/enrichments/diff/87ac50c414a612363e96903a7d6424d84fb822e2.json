(\"wrong prefix\");","+           process.send(\"ok\");","+         } catch (e) {","+           process.send(\"caught:\" + (e.code || e.name));","+         }`,","+      ],","+      env: bunEnv,","+      stdout: \"ignore\",","+      stderr: \"ignore\",","+      ipc(message) {","+        messages.push(String(message));","+        if (message === \"entering\") entering.resolve();","+        else done.resolve();","+      },","+      serialization: \"json\",","+    });","+","+    // The abort is a synchronous capacity check that fires instantly; past it","+    // the child squeezes 2 GiB of output, which is too slow in debug to await.","+    // Give it a short window after reaching the call site, then stop it.","+    await Promise.race([entering.promise, proc.exited]);","+    await Promise.race([done.promise, proc.exited, Bun.sleep(2000)]);","+    proc.kill(\"SIGKILL\");","+","+    const exitCode = await proc.exited;","+","+    expect(messages[0]).toBe(\"entering\");","+    expect(proc.signalCode).not.toBe(\"SIGABRT\");","+    if (proc.signalCode === null) {","+      expect(messages[1]).toMatch(/^(ok|caught:\\S+)$/);","+      expect(exitCode).toBe(0);","+    } else {","+      expect(proc.signalCode).toBe(\"SIGKILL\");","+    }","+  });","+});","+"," describe(\"crypto.getCurves\", () => {","   it(\"should return an array of strings\", () => {","     expect(Array.isArray(crypto.getCurves())).toBe(true);",""],"additions":69,"deletions":1,"truncated":false}],"additions":84,"deletions":10,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-08-19T08:07:21.195398+00:00"}