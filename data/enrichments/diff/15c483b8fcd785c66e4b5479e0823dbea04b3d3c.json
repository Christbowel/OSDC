options));","+  }","+","+  /**","+   * Returns whether the table has a unique key (a unique constraint, a unique index, or the primary key) on exactly the given column.","+   *","+   * Both the unique constraints and the indexes of the table are checked, because depending on the dialect,","+   * a unique key can be a unique index without a unique constraint.","+   * Snowflake does not report which columns its unique constraints are on, so they are never found there.","+   *","+   * @param tableName The table that contains the column","+   * @param columnName The name of the column, as it is in the database","+   * @param options Query options","+   */","+  async hasUniqueKey(","+    tableName: TableOrModel,","+    columnName: string,","+    options?: QueryRawOptions,","+  ): Promise<boolean> {","+    const queryInterface = this.#sequelize.queryInterface;","+","+    // unquoted identifiers are case-insensitive","+    const normalize = this.#sequelize.options.quoteIdentifiers","+      ? (name: string) => name","+      : (name: string) => name.toLowerCase();","+    const isOnColumn = (columnNames: readonly string[] | undefined) =>","+      columnNames?.length === 1 && normalize(columnNames[0]) === normalize(columnName);","+","+    const constraints = await queryInterface.showConstraints(tableName, {","+      ...options,","+      constraintType: 'UNIQUE',","+    });","+","+    if (constraints.some(constraint => isOnColumn(constraint.columnNames))) {","+      return true;","+    }","+","+    const indexes = await queryInterface.showIndex(tableName, options);","+","+    return indexes.some(","+      index =>","+        (index.unique || index.primary) && isOnColumn(index.fields.map(field => field.attribute)),","+    );","+  }","+","+  /**","+   * Runs the query that changes the column, then adds a unique key on the column.","+   * {@link AbstractQueryInterface#changeColumn} uses this in dialects where the ALTER COLUMN query cannot add the unique key","+   * (`dialect.supports.alterColumn.unique` is false).","+   *","+   * Dialects where schema changes are transactional can override this method to do both in one transaction.","+   *","+   * @param tableName The table that contains the column","+   * @param columnName The name of the column, as it is in the database","+   * @param changeColumnSql The query that changes the column","+   * @param options Query options","+   */","+  async changeColumnAndAddUniqueKey(","+    tableName: TableOrModel,","+    columnName: string,","+    changeColumnSql: string,","+    options?: QueryRawOptions,","+  ): Promise<unknown> {","+    const result = await this.#sequelize.queryRaw(changeColumnSql, options);","+    await this.addUniqueKey(tableName, columnName, options);","+","+    return result;","+  }","+","+  /**","+   * Adds a unique constraint on the column, or a unique index if the dialect cannot add constraints to existing tables.","+   *","+   * @param tableName The table that contains the column","+   * @param columnName The name of the column, as it is in the database","+   * @param options Query options","+   */","+  async addUniqueKey(","+    tableName: TableOrModel,","+    columnName: string,","+    options?: QueryRawOptions,","+  ): Promise<void> {","+    if (!this.#dialect.supports.constraints.add) {","+      await this.addUniqueIndex(tableName, columnName, options);","+","+      return;","+    }","+","+    await this.#sequelize.queryInterface.addConstraint(tableName, {","+      ...options,","+      type: 'UNIQUE',","+      fields: [columnName],","+    });","+  }","+","+  /**","+   * Adds a unique index on the column.","+   *","+   * @param tableName The table that contains the column","+   * @param columnName The name of the column, as it is in the database","+   * @param options Query options","+   */","+  async addUniqueIndex(","+    tableName: TableOrModel,","+    columnName: string,","+    options?: QueryRawOptions,","+  ): Promise<void> {","+    await this.#sequelize.queryInterface