que keys.","+   *","    * @param {string} tableName          Table name to change from","    * @param {string} attributeName      Column name","    * @param {object} dataTypeOrOptions  Attribute definition for new column","@@ -225,14 +230,30 @@ export class AbstractQueryInterface extends AbstractQueryInterfaceTypeScript {","   async changeColumn(tableName, attributeName, dataTypeOrOptions, options) {","     options ||= {};"," ","-    const column = this.normalizeAttribute(dataTypeOrOptions);","-    const columns = { [column.field || column.columnName || attributeName]: column };","+    const { unique, ...column } = this.normalizeAttribute(dataTypeOrOptions);","+    const columnName = column.field || column.columnName || attributeName;","+","+    // Adding \"unique\" every time would add a new unique key each time changeColumn is called","+    const addUniqueKey = await this.#internals.needsUniqueKey(","+      tableName,","+      columnName,","+      unique,","+      options,","+    );","+    // Adding it in the same query as the column change applies both, or neither","+    const addUniqueKeyInQuery = addUniqueKey && this.sequelize.dialect.supports.alterColumn.unique;","+","+    const columns = { [columnName]: addUniqueKeyInQuery ? { ...column, unique: true } : column };","     const query = this.queryGenerator.attributesToSql(columns, {","       context: 'changeColumn',","       tableOrModel: tableName,","     });","     const sql = this.queryGenerator.changeColumnQuery(tableName, query, columns);"," ","+    if (addUniqueKey && !addUniqueKeyInQuery) {","+      return this.#internals.changeColumnAndAddUniqueKey(tableName, columnName, sql, options);","+    }","+","     return this.sequelize.queryRaw(sql, options);","   }"," "],"additions":23,"deletions":2,"truncated":false},{"path":"packages/core/test/integration/model/sync.test.js","lines":["@@ -1,7 +1,8 @@"," 'use strict';"," "," const { expect } = require('chai');","-const { DataTypes, Deferrable, Model } = requir