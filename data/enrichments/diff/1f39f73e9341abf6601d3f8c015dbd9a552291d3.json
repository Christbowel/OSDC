or new templates)","+//\t(logged-on users)  → Client.EnumLoggedOnUsers (WKSSVC; not in nmap list)","+//","+// Not implemented here (by design — do not add):","+//","+//\tsmb-flood          — DoS; harmful, no scanner value (nmap categories: dos)","+//\tsmb-mbenum         — Master Browser / mailslots; obsolete NetBIOS surface","+//\tsmb-print-text     — writes to printer spooler; intrusive niche","+//\tsmb-protocols / unauth discovery — nuclei/smb"," //"," // All host arguments are validated against the per-execution network policy"," // before any traffic is sent. The actual TCP dial is performed via goimpacket's","@@ -28,6 +45,7 @@ import ("," \tgpsmbexec \"github.com/Mzack9999/goimpacket/pkg/smbexec\""," \t\"github.com/projectdiscovery/goja\""," ","+\t\"github.com/projectdiscovery/nuclei/v3/pkg/js/libs/smbsession\""," \t\"github.com/projectdiscovery/nuclei/v3/pkg/js/utils\""," \t\"github.com/projectdiscovery/nuclei/v3/pkg/protocols/common/protocolstate\""," )","@@ -399,11 +417,12 @@ func (c *Client) SmbListShares() ([]string, error) {"," \tif err := c.connect(); err != nil {"," \t\treturn nil, err"," \t}","-\treturn c.smb.ListShares()","+\treturn smbsession.FromClient(c.smb).ListShares()"," }"," "," // SmbCat reads the contents of a single file from the given share. The path"," // is interpreted relative to the share root (use forward slashes).","+// Prefer nuclei/smb.ReadFile for new templates; this remains for dcerpc sessions."," //"," // @example"," // ```javascript","@@ -417,13 +436,11 @@ func (c *Client) SmbCat(share, file string) (string, error) {"," \tif err := c.connect(); err != nil {"," \t\treturn \"\", err"," \t}","-\tif err := c.smb.UseShare(share); err != nil {","-\t\treturn \"\", fmt.Errorf(\"use share %s: %w\", share, err)","-\t}","-\treturn c.smb.Cat(file)","+\treturn smbsession.FromClient(c.smb).ReadFile(share, file, smbsession.DefaultMaxReadBytes)"," }"," "," // SmbLs lists files under dir on the given share. dir = \"\" lists the root.","+// Prefer nuclei/smb.ListDir for new templates."," //"," // @example"," // ```javascript","@@ -431,29 +448,14 @@ func (c *Client) SmbCat(share, file string) (string, error) {"," // const entries = c.SmbLs('backup', '');"," // for (const e of entries) { log(e.Name + (e.IsDir ? '/' : '')); }"," // ```","-type FileEntry struct {","-\tName  string `json:\"name\"`","-\tSize  int64  `json:\"size\"`","-\tIsDir bool   `json:\"is_dir\"`","-}","+type FileEntry = smbsession.Entry"," "," func (c *Client) SmbLs(share, dir string) ([]FileEntry, error) {"," \tc.nj.Require(share != \"\", \"share cannot be empty\")"," \tif err := c.connect(); err != nil {"," \t\treturn nil, err"," \t}","-\tif err := c.smb.UseShare(share); err != nil {","-\t\treturn nil, fmt.Errorf(\"use share %s: %w\", share, err)","-\t}","-\tinfos, err := c.smb.Ls(dir)","-\tif err != nil {","-\t\treturn nil, err","-\t}","-\tout := make([]FileEntry, 0, len(infos))","-\tfor _, fi := range infos {","-\t\tout = append(out, FileEntry{Name: fi.Name(), Size: fi.Size(), IsDir: fi.IsDir()})","-\t}","-\treturn out, nil","+\treturn smbsession.FromClient(c.smb).ListDir(share, dir)"," }"," "," // LsaLookupSids resolves an array of SIDs to (domain, name, type) triples"],"additions":25,"deletions":23,"truncated":false},{"path":"pkg/js/libs/dcerpc/enum.go","lines":["@@ -0,0 +1,250 @@","+package dcerpc","+","+import (","+\t\"fmt\"","+","+\tgpsrvsvc \"github.com/Mzack9999/goimpacket/pkg/dcerpc/srvsvc\"","+\tgpsvcctl \"github.com/Mzack9999/goimpacket/pkg/dcerpc/svcctl\"","+\twinstation \"github.com/Mzack9999/goimpacket/pkg/dcerpc/tsts\"","+\tgpwkssvc \"github.com/Mzack9999/goimpacket/pkg/dcerpc/wkssvc\"","+\t\"github.com/projectdiscovery/nuclei/v3/pkg/protocols/common/protocolstate\"","+)","+","+// ServiceEntry is a flat SVCCTL service record suitable for JS templates","+// (nmap smb-enum-services).","+type ServiceEntry struct {","+\tName        string `json:\"name\"`","+\tDisplayName string `json:\"display_name\"`","+\tState       string `json:\"state\"`","+\tStateCode   uint32 `json:\"state_code\"`","+\tControls    uint32 `json:\"controls,omitempty\"`","+}","+","+// SessionEntry is a flat SRVSVC session record (nmap smb-enum-sessions).","+type SessionEntry struct {","+\tClient   string `json:\"client\"`","+\tUsername string `json:\"username\"`","+\tActive   uint32 `json:\"active_seconds\"`","+\tIdle     uint32 `json:\"idle_seconds\"`","+}","+","+// ProcessEntry is a running process from the Terminal Services Legacy API","+// (nmap smb-enum-processes analogue; nmap uses winreg perf counters, we use WinStation).","+type ProcessEntry struct {","+\tName           string `json:\"name\"`","+\tPID            uint32 `json:\"pid\"`","+\tSessionID      uint32 `json:\"session_id\"`","+\tWorkingSetSize uint32 `json:\"working_set_size,omitempty\"`","+\tSID            string `json:\"sid,omitempty\"`","+}","+","+// LoggedOnUser is a WKSSVC workstation user record (interactive / network logons","+// known to the target). Useful companion to SamrEnumerateUsers / EnumSessions.","+type LoggedOnUser struct {","+\tUsername    string `json:\"username\"`","+\tLogonDomain string `json:\"logon_domain\"`","+\tOthDomains  string `json:\"other_domains,omitempty\"`","+\tLogonServer string `json:\"logon_server,omitempty\"`","+}","+","+// EnumServices lists Win32 services on the target via SVCCTL","+// (nmap: smb-enum-services). Requires an authenticated session with rights","+// to open the Service Control Manager.","+//","+// @example","+// ```javascript","+// const dcerpc = require('nuclei/dcerpc');","+// const c = new dcerpc.Client('dc01.acme.local', 'acme.local', 'admin', 'P@ssw0rd');","+// const services = c.EnumServices();","+//","+//\tfor (const s of services) {","+//\t  if (s.State === 'RUNNING') { log(s.Name + ' => ' + s.DisplayName); }","+//\t}","+//","+// ```","+func (c *Client) EnumServices() ([]ServiceEntry, error) {","+\tif !protocolstate.IsHostAllowed(c.nj.ExecutionId(), c.Host) {","+\t\treturn nil, protocolstate.ErrHostDenied.Msgf(c.Host)","+\t}","+\trpc, err := c.rpcOverNamedPipe(\"svcctl\", gpsvcctl.UUID, gpsvcctl.MajorVersion, gpsvcctl.MinorVersion)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tdefer func() {","+\t\t_ = rpc.Transport.Close()","+\t}()","+","+\tsc, err := gpsvcctl.NewServiceController(rpc)","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"svcctl open scm: %w\", err)","+\t}","+\tdefer sc.Close()","+","+\tconst serviceWin32 = gpsvcctl.SERVICE_WIN32_OWN_PROCESS | gpsvcctl.SERVICE_WIN32_SHARE_PROCESS","+\traw, err := sc.EnumServicesStatus(serviceWin32, gpsvcctl.SERVICE_STATE_ALL)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\treturn mapServiceEntries(raw), nil","+}","+","+// EnumSessions lists SMB sessions known to the server via SRVSVC","+// (nmap: smb-enum-sessions). Often requires administrative rights.","+//","+// @example","+// ```javascript","+// const dcerpc = require('nuclei/dcerpc');","+// const c = new dcerpc.Client('fs01.acme.local', 'acme.local', 'admin', 'P@ssw0rd');","+// const sessions = c.EnumSessions();","+//","+//\tfor (const s of sessions) {","+//\t  log(s.Username + '@' + s.Client + ' active=' + s.Active + 's');","+//\t}","+//","+// ```","+func (c *Client) EnumSessions() ([]SessionEntry, error) {","+\tif !protocolstate.IsHostAllowed(c.nj.ExecutionId(), c.Host) {","+\t\treturn nil, protocolstate.ErrHostDenied.Msgf(c.Host)","+\t}","+\trpc, err := c.rpcOverNamedPipe(\"srvsvc\", gpsrvsvc.UUID, gpsrvsvc.MajorVersion, gpsrvsvc.MinorVersion)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tdefer func() {","+\t\t_ = rpc.Transport.Close()","+\t}()","+","+\traw, err := gpsrvsvc.NetrSessionEnum(rpc)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\treturn mapSessionEntries(raw), nil","+}","+","+// EnumProcesses lists running processes via the Terminal Services Legacy API","+// (Ctx_WinStation_API_service). This is the goimpacket-backed analogue of","+// nmap smb-enum-processes (which reads winreg performance counters). Requires","+// rights to open the WinStation server handle; TermService should be running.","+//","+// @example","+// ```javascript","+// const dcerpc = require('nuclei/dcerpc');","+// const c = new dcerpc.Client('dc01.acme.local', 'acme.local', 'admin', 'P@ssw0rd');","+// const procs = c.EnumProcesses();","+//","+//\tfor (const p of procs) {","+//\t  log(p.PID + ' ' + p.Name + ' session=' + p.SessionID);","+//\t}","+//","+// ```","+func (c *Client) EnumProcesses() ([]ProcessEntry, error) {","+\tif !protocolstate.IsHostAllowed(c.nj.ExecutionId(), c.Host) {","+\t\treturn nil, protocolstate.ErrHostDenied.Msgf(c.Host)","+\t}","+\trpc, err := c.rpcOverNamedPipe(winstation.PipeCtxWinStation, winstation.LegacyAPIUUID, winstation.MajorVersion, winstation.MinorVersion)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tdefer func() {","+\t\t_ = rpc.Transport.Close()","+\t}()","+","+\tlegacy := winstation.NewLegacyClient(rpc)","+\thandle, err := legacy.OpenServer()","+\tif err != nil {","+\t\treturn nil, fmt.Errorf(\"winstation OpenServer: %w\", err)","+\t}","+\tdefer func() {","+\t\t_ = legacy.CloseServer(handle)","+\t}()","+","+\traw, err := legacy.GetAllProcesses(handle)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\treturn mapProcessEntries(raw), nil","+}","+","+// EnumLoggedOnUsers lists users currently known to the workstation service","+// via WKSSVC NetrWkstaUserEnum. Complements SamrEnumerateUsers (domain DB)","+// and EnumSessions (SMB sessions).","+//","+// @example","+// ```javascript","+// const dcerpc = require('nuclei/dcerpc');","+// const c = new dcerpc.Client('ws01.acme.local', 'acme.local', 'admin', 'P@ssw0rd');","+// const users = c.EnumLoggedOnUsers();","+// for (const u of users) { log(u.LogonDomain + '\\\\' + u.Username); }","+// ```","+func (c *Client) EnumLoggedOnUsers() ([]LoggedOnUser, error) {","+\tif !protocolstate.IsHostAllowed(c.nj.ExecutionId(), c.Host) {","+\t\treturn nil, protocolstate.ErrHostDenied.Msgf(c.Host)","+\t}","+\trpc, err := c.rpcOverNamedPipe(\"wkssvc\", gpwkssvc.UUID, gpwkssvc.MajorVersion, gpwkssvc.MinorVersion)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\tdefer func() {","+\t\t_ = rpc.Transport.Close()","+\t}()","+","+\traw, err := gpwkssvc.NetrWkstaUserEnum(rpc)","+\tif err != nil {","+\t\treturn nil, err","+\t}","+\treturn mapLoggedOnUsers(raw), nil","+}","+","+func mapServiceEntries(raw []gpsvcctl.EnumServiceEntry) []ServiceEntry {","+\tout := make([]ServiceEntry, 0, len(raw))","+\tfor _, e := range raw {","+\t\tout = append(out, ServiceEntry{","+\t\t\tName:        e.ServiceName,","+\t\t\tDisplayName: e.DisplayName,","+\t\t\tState:       gpsvcctl.GetServiceState(e.Status.CurrentState),","+\t\t\tStateCode:   e.Status.CurrentState,","+\t\t\tControls:    e.Status.ControlsAccepted,","+\t\t})","+\t}","+\treturn out","+}","+","+func mapSessionEntries(raw []gpsrvsvc.SessionInfo10) []SessionEntry {","+\tout := make([]SessionEntry, 0, len(raw))","+\tfor _, e := range raw {","+\t\tout = append(out, SessionEntry{","+\t\t\tClient:   e.Cname,","+\t\t\tUsername: e.Username,","+\t\t\tActive:   e.ActiveTime,","+\t\t\tIdle:     e.IdleTime,","+\t\t})","+\t}","+\treturn out","+}","+","+func mapProcessEntries(raw []winstation.ProcessInfo) []ProcessEntry {","+\tout := make([]ProcessEntry, 0, len(raw))","+\tfor _, e := range raw {","+\t\tout = append(out, ProcessEntry{","+\t\t\tName:           e.ImageName,","+\t\t\tPID:            e.UniqueProcessId,","+\t\t\tSessionID:      e.SessionId,","+\t\t\tWorkingSetSize: e.WorkingSetSize,","+\t\t\tSID:            e.SID,","+\t\t})","+\t}","+\treturn out","+}","+","+func mapLoggedOnUsers(raw []gpwkssvc.WkstaUserInfo1) []LoggedOnUser {","+\tout := make([]LoggedOnUser, 0, len(raw))","+\tfor _, e := range raw {","+\t\tout = append(out, LoggedOnUser{","+\t\t\tUsername:    e.Username,","+\t\t\tLogonDomain: e.LogonDomain,","+\t\t\tOthDomains:  e.OthDomains,","+\t\t\tLogonServer: e.LogonServer,","+\t\t})","+\t}","+\treturn out","+}"],"additions":250,"deletions":0,"truncated":false},{"path":"pkg/js/libs/dcerpc/enum_policy_test.go","lines":["@@ -0,0 +1,57 @@","+package dcerpc","+","+import (","+\t\"testing\"","+","+\t\"github.com/projectdiscovery/goja\"","+\t\"github.com/projectdiscovery/nuclei/v3/pkg/js/utils\"","+\t\"github.com/projectdiscovery/nuclei/v3/pkg/protocols/common/protocolstate\"","+\t\"github.com/projectdiscovery/nuclei/v3/pkg/types\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+const enumDeniedHost = \"203.0.113.51\"","+","+func newDeniedEnumClient(t *testing.T, executionID string) *Client {","+\tt.Helper()","+\trequire.NoError(t, protocolstate.Init(&types.Options{","+\t\tExecutionId:    executionID,","+\t\tExcludeTargets: []string{enumDeniedHost},","+\t}))","+\tt.Cleanup(func() { protocolstate.Close(executionID) })","+","+\truntime := goja.New()","+\truntime.SetContextValue(\"executionId\", executionID)","+\treturn &Client{","+\t\tHost: enumDeniedHost,","+\t\tnj:   utils.NewNucleiJS(runtime),","+\t}","+}","+","+func TestEnumServicesDeniesHostBeforeDial(t *testing.T) {","+\tc := newDeniedEnumClient(t, \"dcerpc-enum-services-deny\")","+\t_, err := c.EnumServices()","+\trequire.Error(t, err)","+\trequire.Contains(t, err.Error(), enumDeniedHost)","+}","+","+func TestEnumSessionsDeniesHostBeforeDial(t *testing.T) {","+\tc := newDeniedEnumClient(t, \"dcerpc-enum-sessions-deny\")","+\t_, err := c.EnumSessions()","+\trequire.Error(t, err)","+\trequire.Contains(t, err.Error(), enumDeniedHost)","+}","+","+func TestEnumProcessesDeniesHostBeforeDial(t *testing.T) {","+\tc := newDeniedEnumClient(t, \"dcerpc-enum-processes-deny\")","+\t_, err := c.EnumProcesses()","+\trequire.Error(t, err)","+\trequire.Contains(t, err.Error(), enumDeniedHost)","+}","+","+func TestEnumLoggedOnUsersDeniesHostBeforeDial(t *testing.T) {","+\tc := newDeniedEnumClient(t, \"dcerpc-enum-loggedon-deny\")","+\t_, err := c.EnumLoggedOnUsers()","+\trequire.Error(t, err)","+\trequire.Contains(t, err.Error(), enumDeniedHost)","+}"],"additions":57,"deletions":0,"truncated":false},{"path":"pkg/js/libs/dcerpc/enum_test.go","lines":["@@ -0,0 +1,78 @@","+package dcerpc","+","+import (","+\t\"testing\"","+","+\tgpsrvsvc \"github.com/Mzack9999/goimpacket/pkg/dcerpc/srvsvc\"","+\tgpsvcctl \"github.com/Mzack9999/goimpacket/pkg/dcerpc/svcctl\"","+\twinstation \"github.com/Mzack9999/goimpacket/pkg/dcerpc/tsts\"","+\tgpwkssvc \"github.com/Mzack9999/goimpacket/pkg/dcerpc/wkssvc\"","+\t\"github.com/stretchr/testify/require\"","+)","+","+func TestMapServiceEntries(t *testing.T) {","+\traw := []gpsvcctl.EnumServiceEntry{","+\t\t{","+\t\t\tServiceName: \"Spooler\",","+\t\t\tDisplayName: \"Print Spooler\",","+\t\t\tStatus:      gpsvcctl.ServiceStatus{CurrentState: gpsvcctl.SERVICE_RUNNING, ControlsAccepted: 1},","+\t\t},","+\t\t{","+\t\t\tServiceName: \"StoppedSvc\",","+\t\t\tDisplayName: \"Stopped\",","+\t\t\tStatus:      gpsvcctl.ServiceStatus{CurrentState: gpsvcctl.SERVICE_STOPPED},","+\t\t},","+\t}","+\tgot := mapServiceEntries(raw)","+\trequire.Len(t, got, 2)","+\trequire.Equal(t, \"Spooler\", got[0].Name)","+\trequire.Equal(t, \"Print Spooler\", got[0].DisplayName)","+\trequire.Equal(t, \"RUNNING\", got[0].State)","+\trequire.Equal(t, uint32(gpsvcctl.SERVICE_RUNNING), got[0].StateCode)","+\trequire.Equal(t, \"STOPPED\", got[1].State)","+}","+","+func TestMapSessionEntries(t *testing.T) {","+\traw := []gpsrvsvc.SessionInfo10{","+\t\t{Cname: `\\\\client1`, Username: \"alice\", ActiveTime: 10, IdleTime: 2},","+\t\t{Cname: `\\\\client2`, Username: \"bob\", ActiveTime: 0, IdleTime: 99},","+\t}","+\tgot := mapSessionEntries(raw)","+\trequire.Len(t, got, 2)","+\trequire.Equal(t, `\\\\client1`, got[0].Client)","+\trequire.Equal(t, \"alice\", got[0].Username)","+\trequire.Equal(t, uint32(10), got[0].Active)","+\trequire.Equal(t, uint32(2), got[0].Idle)","+\trequire.Equal(t, \"bob\", got[1].Username)","+}","+","+func TestMapProcessEntries(t *testing.T) {","+\traw := []winstation.ProcessInfo{","+\t\t{ImageName: 