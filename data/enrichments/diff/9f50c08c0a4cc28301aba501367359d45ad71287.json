eException( 'Listener failed.' );","+\t\t\t}","+\t\t);","+","+\t\t$exception = null;","+","+\t\ttry {","+\t\t\twp_set_secret( 'myplugin/api-key', 'a-plaintext-value-that-must-not-leak' );","+\t\t} catch ( RuntimeException $e ) {","+\t\t\t$exception = $e;","+\t\t}","+","+\t\t$this->assertInstanceOf( RuntimeException::class, $exception );","+","+\t\t$string_args = array();","+\t\tforeach ( $exception->getTrace() as $frame ) {","+\t\t\tforeach ( $frame['args'] ?? array() as $arg ) {","+\t\t\t\tif ( is_string( $arg ) ) {","+\t\t\t\t\t$string_args[] = $arg;","+\t\t\t\t}","+\t\t\t}","+\t\t}","+","+\t\t$this->assertContains( 'myplugin/api-key', $string_args, 'The trace should include the other arguments.' );","+\t\t$this->assertNotContains( 'a-plaintext-value-that-must-not-leak', $string_args );","+\t}","+","+\t/**","+\t * @ticket 66414","+\t *","+\t * @requires PHP 8.2","+\t *","+\t * @dataProvider data_parameters_that_receive_a_secret_value","+\t *","+\t * @param callable-string|array{0: class-string, 1: string} $target    The function or method.","+\t * @param string                                             $parameter The parameter name.","+\t */","+\tpublic function test_parameters_that_receive_a_secret_value_are_sensitive( $target, string $parameter ): void {","+\t\t$reflection = is_array( $target ) ? new ReflectionMethod( $target[0], $target[1] ) : new ReflectionFunction( $target );","+","+\t\tforeach ( $reflection->getParameters() as $reflection_parameter ) {","+\t\t\tif ( $parameter === $reflection_parameter->getName() ) {","+\t\t\t\t$this->assertNotEmpty( $reflection_parameter->getAttributes( SensitiveParameter::class ) );","+\t\t\t\treturn;","+\t\t\t}","+\t\t}","+","+\t\t$this->fail( \"Parameter \\${$parameter} not found.\" );","+\t}","+","+\t/**","+\t * @return array<string, array{0: callable-string|array{0: class-string, 1: string}, 1: string}>","+\t */","+\tpublic static function data_parameters_that_receive_a_secret_value(): array {","+\t\treturn array(","