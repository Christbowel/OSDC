de_ptr);"," \tunique_ptr<NodeStatistics> PropagateStatistics(LogicalGet &op, unique_ptr<LogicalOperator> &node_ptr);"," \tunique_ptr<NodeStatistics> PropagateStatistics(LogicalJoin &op, unique_ptr<LogicalOperator> &node_ptr);","@@ -131,6 +135,15 @@ class StatisticsPropagator {"," \toptional_ptr<LogicalOperator> root;"," \t//! The map of ColumnBinding -> statistics for the various nodes"," \tcolumn_binding_map_t<unique_ptr<BaseStatistics>> statistics_map;","+\t//! The statistics of a materialized CTE definition, which hold for every reference to it","+\tstruct CTEStatistics {","+\t\t//! Statistics of the columns emitted by the definition, by position","+\t\tvector<unique_ptr<BaseStatistics>> column_stats;","+\t\t//! Cardinality of the definition","+\t\tunique_ptr<NodeStatistics> node_stats;","+\t};","+\t//! The map of CTE index -> statistics of its definition","+\tunordered_map<TableIndex, CTEStatistics> cte_stats_map;"," \t//! Node stats for the current node"," \tunique_ptr<NodeStatistics> node_stats;"," };"],"additions":13,"deletions":0,"truncated":false},{"path":"src/optimizer/statistics/operator/CMakeLists.txt","lines":["@@ -3,6 +3,7 @@ add_library_unity(","   OBJECT","   propagate_aggregate.cpp","   propagate_cross_product.cpp","+  propagate_cte.cpp","   propagate_filter.cpp","   propagate_get.cpp","   propagate_limit.cpp"],"additions":1,"deletions":0,"truncated":false},{"path":"src/optimizer/statistics/operator/propagate_cte.cpp","lines":["@@ -0,0 +1,63 @@","+#include \"duckdb/optimizer/statistics_propagator.hpp\"","+#include \"duckdb/planner/operator/logical_cteref.hpp\"","+#include \"duckdb/planner/operator/logical_materialized_cte.hpp\"","+","+namespace duckdb {","+","+unique_ptr<NodeStatistics> StatisticsPropagator::PropagateStatistics(LogicalMaterializedCTE &op,","+                                                                     unique_ptr<LogicalOperator> &node_ptr) {","+\t// the CTE is evaluated once, so the statistics of its definition hold for every reference to it","+\tauto definition_node_stats = PropagateStatistics(op.children[0]);","+","+\tauto definition_bindings = op.children[0]->GetColumnBindings();","+\tauto column_count = MinValue<idx_t>(op.column_count, definition_bindings.size());","+","+\tCTEStatistics cte_stats;","+\tcte_stats.column_stats.reserve(column_count);","+\tfor (idx_t i = 0; i < column_count; i++) {","+\t\tauto entry = statistics_map.find(definition_bindings[i]);","+\t\tif (entry == statistics_map.end() || !entry->second) {","+\t\t\tcte_stats.column_stats.push_back(nullptr);","+\t\t\tcontinue;","+\t\t}","+\t\tcte_stats.column_stats.push_back(entry->second->ToUnique());","+\t}","+\tif (definition_node_stats) {","+\t\tcte_stats.node_stats = make_uniq<NodeStatistics>(*definition_node_stats);","+\t}","+\tcte_stats_map[op.table_index] = std::move(cte_stats);","+","+\t// the operator emits whatever the query referencing the CTE emits","+\treturn PropagateStatistics(op.children[1]);","+}","+","+unique_ptr<NodeStatistics> StatisticsPropagator::PropagateStatistics(LogicalCTERef &op,","+                                                                     unique_ptr<LogicalOperator> &node_ptr) {","+\tif (op.is_recurring) {","+\t\t// the recurring table is filled during execution - the definition does not describe it","+\t\treturn nullptr;","+\t}","+\tauto entry = cte_stats_map.find(op.cte_index);","+\tif (entry == cte_stats_map.end()) {","+\t\treturn nullptr;","+\t}","+\tauto &cte_stats = entry->second;","+","+\tauto bindings = op.GetColumnBindings();","+\tauto column_count = MinValue<idx_t>(bindings.size(), cte_stats.column_stats.size());","+\tfor (idx_t i = 0; i < column_count; i++) {","+\t\tauto &column_stats = cte_stats.column_stats[i];","+\t\tif (!column_stats || column_stats->GetType() != op.chunk_types[i]) {","+\t\t\tcontinue;","+\t\t}","+\t\tstatistics_map[bindings[i]] = column_stats->ToUnique();","+\t}","+","+\t// a reference scans the whole CTE, so it emits exactly as many rows as the definition","+\tif (!cte_stats.node_stats) {","+\t\treturn nullptr;","+\t}","+\treturn make_uniq<NodeStatistics>(*cte_stats.node_stats);","+}","+","+} // namespace duckdb"],"additions":63,"deletions":0,"truncated":false},{"path":"src/optimizer/statistics_propagator.cpp","lines":["@@ -10,10 +10,12 @@"," #include \"duckdb/planner/operator/logical_aggregate.hpp\""," #include \"duckdb/planner/operator/logical_copy_to_file.hpp\""," #include \"duckdb/planner/operator/logical_cross_product.hpp\"","+#include \"duckdb/planner/operator/logical_cteref.hpp\""," #include \"duckdb/planner/operator/logical_empty_result.hpp\""," #include \"duckdb/planner/operator/logical_filter.hpp\""," #include \"duckdb/planner/operator/logical_get.hpp\""," #include \"duckdb/planner/operator/logical_join.hpp\"","+#include \"duckdb/planner/operator/logical_materialized_cte.hpp\""," #include \"duckdb/planner/operator/logical_order.hpp\""," #include \"duckdb/planner/operator/logical_positional_join.hpp\""," #include \"duckdb/planner/operator/logical_projection.hpp\"","@@ -52,6 +54,12 @@ unique_ptr<NodeStatistics> StatisticsPropagator::PropagateStatistics(LogicalOper"," \tcase LogicalOperatorType::LOGICAL_CROSS_PRODUCT:"," \t\tresult = PropagateStatistics(node.Cast<LogicalCrossProduct>(), node_ptr);"," \t\tbreak;","+\tcase LogicalOperatorType::LOGICAL_CTE_REF:","+\t\tresult = PropagateStatistics(node.Cast<LogicalCTERef>(), node_ptr);","+\t\tbreak;","+\tcase LogicalOperatorType::LOGICAL_MATERIALIZED_CTE:","+\t\tresult = PropagateStatistics(node.Cast<LogicalMaterializedCTE>(), node_ptr);","+\t\tbreak;"," \tcase LogicalOperatorType::LOGICAL_FILTER:"," \t\tresult = PropagateStatistics(node.Cast<LogicalFilter>(), node_ptr);"," \t\tbreak;"],"additions":8,"deletions":0,"truncated":false},{"path":"src/optimizer/topn_window_elimination.cpp","lines":["@@ -363,18 +363,16 @@ TopNWindowElimination::CreateAggregateOperator(LogicalWindow &window, vector<uni"," \taggregate->children.push_back(std::move(window.children[0]));"," \taggregate->ResolveOperatorTypes();"," ","-\t// Add group statistics to allow for perfect hash aggregation if applicable","+\t// Add group statistics to allow for perfect hash aggregation if applicable.","+\t// The partition statistics describe the window input, i.e. exactly what this aggregate reads.","+\t// The global statistics map cannot be used here: its entries are narrowed by operators above the window.","+\tauto &partitions_stats = window_expr.PartitionsStats();"," \taggregate->group_stats.resize(aggregate->groups.size());","-\tfor (idx_t i = 0; i < aggregate->groups.size(); i++) {","-\t\tauto &group = aggregate->groups[i];","-\t\tif (group->GetExpressionType() == ExpressionType::BOUND_COLUMN_REF) {","-\t\t\tauto &column_ref = group->Cast<BoundColumnRefExpression>();","-\t\t\tauto group_stats = stats->find(column_ref.Binding());","-\t\t\tif (group_stats == stats->end()) {","-\t\t\t\tcontinue;","-\t\t\t}","-\t\t\taggregate->group_stats[i] = group_stats->second->ToUnique();","+\tfor (idx_t i = 0; i < MinValue<idx_t>(aggregate->groups.size(), partitions_stats.size()); i++) {","+\t\tif (!partitions_stats[i]) {","+\t\t\tcontinue;"," \t\t}","+\t\taggregate->group_stats[i] = partitions_stats[i]->ToUnique();"," \t}"," "," \treturn unique_ptr<LogicalOperator>(std::move(aggregate));"],"additions":8,"deletions":10,"truncated":false},{"path":"test/optimizer/cte_statistics_propagation.test","lines":["@@ -0,0 +1,100 @@","+# name: test/optimizer/cte_statistics_propagation.test","+# description: Statistics of a materialized CTE definition are propagated to references to it","+# group: [optimizer]","+","+statement ok","+CREATE TABLE t(i INTEGER, j INTEGER);","+","+statement ok","+INSERT INTO t VALUES (1, 10), (2, 20), (3, 30);","+","+statement ok","+CREATE TABLE nullable(i INTEGER, j INTEGER);","+","+statement ok","+INSERT INTO nullable VALUES (1, 10), (NULL, 20);","+","+statement ok","+PRAGMA explain_output = OPTIMIZED_ONLY","+","+# the CTE definition cannot produce NULL, so the join condition is always true","+query II","+EXPLAIN WITH c AS MATERIALIZED (SELECT * FROM t) SELECT * FROM t l JOIN c ON l.i + c.i IS NOT NULL","+----","+logical_opt\t<!REGEX>:.*IS NOT NULL.*","+","+# ... but only if it really cannot produce NULL","+query II","+EXPLAIN WITH c AS MATERIALIZED (SELECT * FROM nullable) SELECT * FROM t l JOIN c ON l.i + c.i IS NOT NULL","+----","+logical_opt\t<REGEX>:.*IS NOT NULL.*","+","+# min/max are propagated as well: no row can match, so the comparison folds to false","+query II","+EXPLAIN WITH c AS MATERIALIZED (SELECT * FROM t) SELECT * FROM t l JOIN c ON l.i + c.i > 1000","+----","+logical_opt\t<!REGEX>:.*1000.*","+","+query I","+WITH c AS MATERIALIZED (SELECT * FROM t) SELECT count(*) FROM t l JOIN c ON l.i + c.i > 1000","+----","+0","+","+# the cardinality of the definition reaches the reference, which is what lets sum() prove it cannot","+# overflow an int64 and switch to sum_no_overflow. The plan assertions for that rewrite live in","+# test/optimizer/test_aggregate_function_rewrite.test; here we only check that the results stay correct","+# on either side of the overflow boundary.","+statement ok","+CREATE TABLE small_vals(v BIGINT);","+","+statement ok","+INSERT INTO small_vals SELECT (i * 1000000000)::BIGINT FROM range(1000) s(i);","+","+query I","+WITH c AS MATERIALIZED (SELECT v FROM small_vals) SELECT sum(v) FROM c","+----","+499500000000000","+","+statement ok","+CREATE TABLE big_vals(v BIGINT);","+","+statement ok","+INSERT INTO big_vals SELECT 4000000000000000000::BIGINT FROM range(5) s(i);","+","+query I","+WITH c AS MATERIALIZED (SELECT v FROM big_vals) SELECT sum(v) FROM c","+----","+20000000000000000000","+","+# the same holds for the duplicate-eliminated CTE that decorrelation generates for a lateral join","+query II","+EXPLAIN SELECT * FROM t l, LATERAL (SELECT * FROM t r WHERE r.i + l.i IS NOT NULL ORDER BY r.i + l.i LIMIT 2)","+----","+logical_opt\t<!REGEX>:.*IS NOT NULL.*","+","+query III","+SELECT l.i, r.i, r.j FROM t l, LATERAL (SELECT * FROM t r WHERE r.i + l.i IS NOT NULL ORDER BY r.i + l.i LIMIT 2) r","+ORDER BY l.i, r.i","+----","+1\t1\t10","+1\t2\t20","+2\t1\t10","+2\t2\t20","+3\t1\t10","+3\t2\t20","+","+# the recurring table of a recursive CTE grows during execution, so the anchor statistics do not describe it","+query I","+WITH RECURSIVE r(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM r WHERE i < 10) SELECT i FROM r WHERE i > 5 ORDER BY i","+----","+6","+7","+8","+9","+10","+","+query I","+WITH RECURSIVE r(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM r WHERE i < 10)","+SELECT count(*) FROM r WHERE i IS NOT NULL","+----","+10"],"additions":100,"deletions":0,"truncated":false},{"path":"test/optimizer/test_aggregate_function_rewrite.test","lines":["@@ -50,6 +50,40 @@ EXPLAIN SELECT SUM(i + 1), SUM(2 + i), SUM(i + 3), SUM(4 + i) FROM integers"," ----"," logical_opt\t<REGEX>:.*sum_no_overflow\\(i\\).*"," ","+query II","+EXPLAIN WITH d AS MATERIALIZED (SELECT i FROM integers) SELECT SUM(i) FROM d","+----","+logical_opt\t<REGEX>:.*sum_no_overflow\\(i\\).*","+","+query II","+EXPLAIN WITH d AS MATERIALIZED (SELECT i FROM integers) SELECT COUNT(i) FROM d","+----","+logical_opt\t<REGEX>:.*count_star\\(\\).*","+","+# the rewrite needs the cardinality of the CTE definition, so it only fires when the sum provably","+# fits in an int64","+statement ok","+CREATE TABLE small_vals(v BIGINT);","+","+statement ok","+INSERT INTO small_vals SELECT (i * 1000000000)::BIGINT FROM range(1000) s(i);","+","+query II","+EXPLAIN WITH c AS MATERIALIZED (SELECT v FROM small_vals) SELECT sum(v) FROM c","+----","+logical_opt\t<REGEX>:.*sum_no_overflow\\(v\\).*","+","+statement ok","+CREATE TABLE big_vals(v BIGINT);","+","+statement ok","+INSERT INTO big_vals SELECT 4000000000000000000::BIGINT FROM range(5) s(i);","+","+query II","+EXPLAIN WITH c AS MATERIALIZED (SELECT v FROM big_vals) SELECT sum(v) FROM c","+----","+logical_opt\t<!REGEX>:.*sum_no_overflow.*","+"," # test rewrite with HUGEINT"," statement ok"," CREATE TABLE T(a HUGEINT);"],"additions":34,"deletions":0,"truncated":false},{"path":"test/optimizer/topn_window_elimination_group_stats.test","lines":["@@ -0,0 +1,34 @@","+# name: test/optimizer/topn_window_elimination_group_stats.test","+# description: The aggregate replacing a top-N window must use statistics of the window input","+# group: [optimizer]","+","+statement ok","+CREATE TABLE w(g INTEGER, v INTEGER);","+","+statement ok","+INSERT INTO w SELECT (range * 7) % 40, range FROM range(400);","+","+statement ok","+CREATE TABLE k(k INTEGER);","+","+statement ok","+INSERT INTO k VALUES (0), (1), (2), (3);","+","+# The join above the window narrows the statistics of g to [0, 3], but the aggregate that replaces","+# the window sits below the join and still sees all 40 partitions","+query I","+SELECT count(*) FROM (","+\tSELECT g, v, row_number() OVER (PARTITION BY g ORDER BY v) AS rn FROM w","+) t JOIN k ON t.g = k.k WHERE t.rn = 1","+----","+4","+","+query II","+SELECT t.g, t.v FROM (","+\tSELECT g, v, row_number() OVER (PARTITION BY g ORDER BY v) AS rn FROM w","+) t JOIN k ON t.g = k.k WHERE t.rn = 1 ORDER BY t.g","+----","+0\t0","+1\t23","+2\t6","+3\t29"],"additions":34,"deletions":0,"truncated":false},{"path":"test/sql/optimizer/test_fd_derived_groups.test","lines":["@@ -115,11 +115,11 @@ logical_opt\t<REGEX>:.*\"Groups\":\\s*\\[\\s*\"[^\"]*\"\\s*,\\s*\".*"," "," # Multiple grouping sets: positional groups must not collapse. This can appear either as a"," # single aggregate with two positional groups, or as a grouping-sets rewrite with separate","-# singleton aggregate branches.","+# singleton aggregate branches. The singleton groups may be wrapped by compressed materialization."," query II"," EXPLAIN (FORMAT JSON) SELECT x, x-1, count(*) FROM t GROUP BY GROUPING SETS ((x), (x-1));"," ----","-logical_opt\t<REGEX>:.*(\"Groups\":\\s*\\[\\s*\"[^\"]*\"\\s*,\\s*\"|CTE.*UNION.*\"Groups\":\\s*\"x\".*\"Groups\":\\s*\"\\(x - 1\\)\").*","+logical_opt\t<REGEX>:.*(\"Groups\":\\s*\\[\\s*\"[^\"]*\"\\s*,\\s*\"|CTE.*UNION.*\"Groups\":\\s*\"[^\"]*x[^\"]*\".*\"Groups\":\\s*\"[^\"]*\\(x - 1\\)[^\"]*\").*"," "," # No raw-column base: synthesising one would need an injectivity proof per derived."," query II",""],"additions":2,"deletions":2,"truncated":false}],"additions":294,"deletions":14,"truncated":false,"file_count":10},"error":null,"fetched_at":"2026-08-15T07:57:59.050194+00:00"}