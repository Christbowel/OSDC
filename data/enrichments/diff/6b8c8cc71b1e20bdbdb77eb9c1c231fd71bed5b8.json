{"id":"6b8c8cc71b1e20bdbdb77eb9c1c231fd71bed5b8","axis":"silent","repo":"duckdb/duckdb","sha":"6b8c8cc71b1e20bdbdb77eb9c1c231fd71bed5b8","parsed":{"files":[{"path":"extension/core_functions/scalar/array/array_functions.cpp","lines":["@@ -2,6 +2,7 @@"," #include \"core_functions/scalar/array_functions.hpp\""," #include \"core_functions/array_kernels.hpp\""," #include \"duckdb/planner/expression/bound_function_expression.hpp\"","+#include \"duckdb/storage/statistics/array_stats.hpp\""," "," namespace duckdb {"," ","@@ -202,6 +203,32 @@ static void ArrayGenericFold(DataChunk &args, ExpressionState &state, Vector &re"," \t}"," }"," ","+static auto ArrayGenericFoldStats(ClientContext &context, FunctionStatisticsInput &input)","+    -> unique_ptr<BaseStatistics> {","+\t// Propagate validity","+\tconst auto &lhs_stats = input.child_stats[0];","+\tconst auto &rhs_stats = input.child_stats[1];","+\tauto new_stats = NumericStats::CreateUnknown(input.expr.GetReturnType());","+","+\tauto &lhs_child_stats = ArrayStats::GetChildStats(lhs_stats);","+\tauto &rhs_child_stats = ArrayStats::GetChildStats(rhs_stats);","+","+\tconst auto has_any_nulls = lhs_child_stats.CanHaveNull() || rhs_child_stats.CanHaveNull();","+","+\tif (has_any_nulls) {","+\t\t// We will throw an error if the child arrays have nulls, so don't propagate any stats","+\t\treturn new_stats.ToUnique();","+\t}","+","+\t// If the child has no nulls, we won't throw.","+\tinput.expr.FunctionMutable().GetProperties().SetErrorMode(FunctionErrors::CANNOT_ERROR);","+","+\t// Forward the validity","+\tnew_stats.CombineValidity(lhs_stats, rhs_stats);","+","+\treturn new_stats.ToUnique();","+}","+"," //------------------------------------------------------------------------------"," // Function Registration"," //------------------------------------------------------------------------------","@@ -213,11 +240,13 @@ template <class OP>"," static void AddArrayFoldFunction(ScalarFunctionSet &set, const LogicalType &type) {"," \tcon