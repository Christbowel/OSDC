{"id":"2f15a850c4243c990936c5d54812545063fdf0f3","axis":"silent","repo":"PrefectHQ/prefect","sha":"2f15a850c4243c990936c5d54812545063fdf0f3","parsed":{"files":[{"path":".github/workflows/image-ca-trust.yaml","lines":["@@ -0,0 +1,32 @@","+name: Image CA trust tests","+","+on:","+  pull_request:","+    paths:","+      - Dockerfile","+      - client/Dockerfile","+      - scripts/check_image_ca_trust.py","+      - scripts/refresh_pip_ca_bundle.py","+      - scripts/tests/**","+      - .github/workflows/image-ca-trust.yaml","+  workflow_dispatch:","+","+permissions:","+  contents: read","+","+jobs:","+  trust-stores:","+    runs-on: ubuntu-latest","+    strategy:","+      matrix:","+        python: [\"3.11\", \"3.12\", \"3.13\", \"3.14\", \"3.15\"]","+    steps:","+      - uses: actions/checkout@v7","+      - uses: astral-sh/setup-uv@v10.0.1","+        with:","+          version: \"0.13.4\"","+          python-version: ${{ matrix.python }}","+      - run: >-","+          uv run --no-project --python ${{ matrix.python }}","+          --with certifi==2026.10.19 --with pip==26.2.2","+          python -m unittest discover -s scripts/tests -v"],"additions":32,"deletions":0,"truncated":false},{"path":"Dockerfile","lines":["@@ -111,6 +111,11 @@ RUN uv export --frozen --no-dev --all-extras --no-emit-project --no-hashes -o di"," # Setup a base final image from miniconda"," FROM continuumio/miniconda3:26.7.1 AS prefect-conda"," ","+RUN --mount=from=ghcr.io/astral-sh/uv:0.13.4,source=/uv,target=/tmp/uv \\","+    /tmp/uv pip install --python /opt/conda/bin/python --upgrade \\","+        \"certifi>=2026.10.19\" \"pip>=26.2.2\" && \\","+    conda update --name base --yes ca-certificates","+"," # Create a new conda environment with our required Python version"," ARG PYTHON_VERSION"," RUN conda create \\","@@ -159,6 +164,7 @@ RUN echo 'Acquire::Retries \"3\";' > /etc/apt/apt.conf.d/80-retries && \\","     apt-get install --no-install-recommends -y \\","     tini=0.19.* \\","     build-essential \\","+    ca-certificates \\","     && apt-get clean && rm -rf /var/lib/apt/lists/*"," "," # Install git - for Bookworm, we need to use Trixie sources since git >= 2.47.3 is required","@@ -187,6 +193,9 @@ RUN ldconfig"," # Install UV from official image - pin to specific version for build caching"," COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /bin/uv"," ","+RUN --mount=type=cache,target=/root/.cache/uv \\","+    uv pip install --upgrade \"pip>=26.2.2\"","+"," # Extras to include during installation"," ARG PREFECT_EXTRAS=[redis,client,otel]"," ","@@ -213,6 +222,10 @@ RUN --mount=type=cache,target=/root/.cache/uv \\","     [ -z \"${EXTRA_PIP_PACKAGES:-\"\"}\" ] || UV_COMPILE_BYTECODE=1 uv pip install \"${EXTRA_PIP_PACKAGES}\""," "," # Smoke test","+RUN --mount=type=bind,source=scripts/check_image_ca_trust.py,target=/tmp/check_image_ca_trust.py \\","+    python /tmp/check_image_ca_trust.py && \\","+    if [ -x /opt/conda/bin/python ]; then /opt/conda/bin/python /tmp/check_image_ca_trust.py; fi","+"," RUN prefect version"," "," # Setup entrypoint"],"additions":13,"deletions":0,"truncated":false},{"path":"client/Dockerfile","lines":["@@ -62,6 +62,7 @@ WORKDIR /opt/prefect"," # Install system requirements"," RUN apt-get update && \\","     apt-get install --no-install-recommends -y \\","+    ca-certificates \\","     git=1:2.* \\","     && apt-get clean && rm -rf /var/lib/apt/lists/*"," ","@@ -80,12 +81,15 @@ COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /bin/uv"," # whiteout on top of that layer, so the archive still ships in the pushed image."," RUN --mount=type=cache,target=/root/.cache/uv \\","     --mount=type=bind,from=python-builder,source=/opt/prefect/dist,target=/dist \\","-    UV_COMPILE_BYTECODE=1 uv pip install \"/dist/prefect_client.tar.gz\"","+    UV_COMPILE_BYTECODE=1 uv pip install \"/dist/prefect_client.tar.gz\" \"pip>=26.2.2\""," "," # Remove setuptools"," RUN uv pip uninstall setuptools"," "," # Smoke test","+RUN --mount=type=bind,source=scripts/check_image_ca_trust.py,target=/tmp/check_image_ca_trust.py \\","+    python /tmp/check_image_ca_trust.py","+"," RUN python -c \"import prefect; print(prefect.__version__)\""," "," # Setup entrypoint"],"additions":5,"deletions":1,"truncated":false},{"path":"scripts/check_image_ca_trust.py","lines":["@@ -0,0 +1,64 @@","+\"\"\"Check the system, application, and installer trust stores in a built image.\"\"\"","+","+from __future__ import annotations","+","+import hashlib","+import os","+import pathlib","+import re","+import ssl","+import sys","+","+import certifi","+from pip._vendor import certifi as pip_certifi","+","+COMPROMISED_ROOTS = {","+    \"7dd78d5f4f13459a83dff9abbba62edbaf6f2d102bf257fd712f4d9f2746ed8d\": \"emSign Root TLS CA - G3\",","+    \"f2edaaff3d9b701fb4d14c9f285f8c0bad90fc3bcc1fa07d47f4718edaba34a5\": \"emSign Root CS CA - G3\",","+    \"d7a7a0fb5d7e2731d771e9484ebcdef71d5f0c3e0a2948782bc83ee0ea699ef4\": \"AAA Certificate Services\",","+    \"86a1ecba089c4a8d3bbe2734c612ba341d813e043cf9e8a862cd5c57a36bbe6b\": \"emSign ECC Root CA - G3\",","+}","+","+","+def compromised_roots(context: ssl.SSLContext) -> set[str]:","+    \"\"\"Return affected roots that the supplied TLS context actually trusts.\"\"\"","+    fingerprints = {","+        hashlib.sha256(certificate).hexdigest()","+        for certificate in context.get_ca_certs(binary_form=True)","+    }","+    return {","+        COMPROMISED_ROOTS[digest] for digest in fingerprints & COMPROMISED_ROOTS.keys()","+    }","+","+","+def system_context() -> ssl.SSLContext:","+    \"\"\"Include hashed directory roots that OpenSSL otherwise loads lazily.\"\"\"","+    context = ssl.create_default_context()","+    capath = ssl.get_default_verify_paths().capath","+    for directory in capath.split(os.pathsep) if capath else []:","+        for certificate in pathlib.Path(directory).iterdir():","+            if re.fullmatch(r\"[0-9a-fA-F]{8}\\.\\d+\", certificate.name):","+                context.load_verify_locations(cafile=str(certificate))","+    return context","+","+","+def main() -> int:","+    \"\"\"Fail the image build if any shipped default trust store is affected.\"\"\"","+    contexts = {","+        \"system\": system_context(),","+        \"certifi\": ssl.create_default_context(cafile=certifi.where()),","+        \"pip\": ssl.create_default_context(cafile=pip_certifi.where()),","+    }","+    failed = False","+    for name, context in contexts.items():","+        roots = compromised_roots(context)","+        if roots:","+            print(f\"{name} still trusts: {', '.join(sorted(roots))}\", file=sys.stderr)","+            failed = True","+        else:","+            print(f\"{name}: affected CA roots are not trusted\")","+    return int(failed)","+","+","+if __name__ == \"__main__\":","+    sys.exit(main())"],"additions":64,"deletions":0,"truncated":false},{"path":"scripts/tests/test_image_ca_trust.py","lines":["@@ -0,0 +1,152 @@","+\"\"\"Exercise the image trust check against the published incident chains.\"\"\"","+","+import importlib.util","+import os","+import pathlib","+import shutil","+import ssl","+import subprocess","+import sys","+import tempfile","+import unittest","+","+import certifi","+import pip","+from pip._vendor import certifi as pip_certifi","+","+ROOT = pathlib.Path(__file__).resolve().parents[2]","+FIXTURES = pathlib.Path(__file__).with_name(\"tls\")","+SPEC = importlib.util.spec_from_file_location(","+    \"check_image_ca_trust\", ROOT / \"scripts\" / \"check_image_ca_trust.py\"","+)","+CHECK = importlib.util.module_from_spec(SPEC)","+SPEC.loader.exec_module(CHECK)","+","+","+class ImageTrustTests(unittest.TestCase):","+    def run_check(self, bundle, directory):","+        return subprocess.run(","+            [sys.executable, str(ROOT / \"scripts\" / \"check_image_ca_trust.py\")],","+            env={","+                **os.environ,","+                \"SSL_CERT_FILE\": str(bundle),","+                \"SSL_CERT_DIR\": str(directory),","+            },","+            capture_output=True,","+            text=True,","+            check=False,","+        )","+","+    def test_detects_actual_compromised_trust_anchors(self):","+        context = ssl.create_default_context(","+            cafile=str(FIXTURES / \"compromised-roots.pem\")","+        )","+        self.assertEqual(","+            CHECK.compromised_roots(context),","+            {","+                \"emSign Root TLS CA - G3\",","+                \"emSign Root CS CA - G3\",","+                \"AAA Certificate Services\",","+                \"emSign ECC Root CA - G3\",","+            },","+        )","+","+    def test_accepts_patched_certifi_bundle(self):","+        context = ssl.create_default_context(cafile=certifi.where())","+        self.assertEqual(CHECK.compromised_roots(context), set())","+","+    def test_cli_rejects_compromised_system_bundle(self):","+        with tempfile.TemporaryDirectory() as directory:","+            result = self.run_check(FIXTURES / \"compromised-roots.pem\", directory)","+        self.assertEqual(result.returncode, 1, result.stdout + result.stderr)","+        self.assertIn(\"system still trusts\", result.stderr)","+","+    def test_cli_accepts_patched_stores(self):","+        with tempfile.TemporaryDirectory() as directory:","+            result = self.run_check(certifi.where(), directory)","+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)","+","+    def test_cli_rejects_compromised_application_and_installer_bundles(self):","+        for name, module, bundle in [","+            (\"certifi\", certifi, certifi.where()),","+            (\"pip\", pip, pip_certifi.where()),","+        ]:","+            with self.subTest(store=name), tempfile.TemporaryDirectory() as directory:","+                source = pathlib.Path(module.__file__).parent","+                package = pathlib.Path(directory, name)","+                shutil.copytree(source, package)","+                shutil.copyfile(","+                    FIXTURES / \"compromised-roots.pem\",","+                    package / pathlib.Path(bundle).relative_to(source),","+                )","+                result = subprocess.run(","+                    [sys.executable, str(ROOT / \"scripts/check_image_ca_trust.py\")],","+                    env={","+                        **os.environ,","+                        \"PYTHONPATH\": directory,","+                        \"SSL_CERT_FILE\": certifi.where(),","+                        \"SSL_CERT_DIR\": directory,","+                    },","+                    capture_output=True,","+                    text=True,","+                    check=False,","+                )","+                self.assertEqual(result.returncode, 1, result.stdout + result.stderr)","+                self.assertIn(name + \" still trusts\", result.stderr)","+","+    def test_cli_rejects_lazily_loaded_directory_roots(self):","+        digest = subprocess.check_output(","+            [","+                \"openssl\",","+                \"x509\",","+                \"-hash\",","+                \"-noout\",","+                \"-in\",","+                str(FIXTURES / \"compromised-roots.pem\"),","+            ],","+            text=True,","+        ).strip()","+        with tempfile.TemporaryDirectory() as directory:","+            pathlib.Path(directory, digest + \".0\").write_bytes(","+                (FIXTURES / \"compromised-roots.pem\").read_bytes()","+            )","+            result = self.run_check(certifi.where(), directory)","+        self.assertEqual(result.returncode, 1, result.stdout + result.stderr)","+        self.assertIn(\"system still trusts\", result.stderr)","+","+    def test_incident_chains_verify_only_with_compromised_roots(self):","+        for chain in sorted(FIXTURES.glob(\"*-emudhra.we-have-a-problem.com.pem\")):","+            for bundle, expected in [","+                (str(FIXTURES / \"compromised-roots.pem\"), 0),","+                (certifi.where(), 2),","+            ]:","+                with self.subTest(chain=chain.name, bundle=bundle):","+                    result = subprocess.run(","+                        [","+                            \"openssl\",","+                            \"verify\",","+                            \"-attime\",","+                            \"1792540800\",","+                            \"-purpose\",","+                            \"sslserver\",","+                            \"-verify_hostname\",","+                            chain.stem,","+                            \"-trusted\",","+                            bundle,","+                            \"-untrusted\",","+                            str(chain),","+                            str(chain),","+                        ],","+                        capture_output=True,","+                        text=True,","+                        check=False,","+                    )","+                    self.assertEqual(","+                        result.returncode, expected, result.stdout + result.stderr","+                    )","+                    if expected:","+                        self.assertIn(\"unable to get local issuer\", result.stderr)","+","+","+if __name__ == \"__main__\":","+    unittest.main()"],"additions":152,"deletions":0,"truncated":false},{"path":"scripts/tests/tls/README.md","lines":["@@ -0,0 +1,6 @@","+These public test certificates come from the [eMudhra incident disclosure](https://emudhra.we-have-a-problem.com/):","+","+- `compromised-roots.pem` contains the four certificates in `roots.json`.","+- The two chain files come from `chains.zip` and cover the emSign and AAA cross-signed paths.","+","+Retrieved on October 21, 2026. Offline verification fixes the time to October 21, 2026, at 00:00 UTC so certificate expiration cannot masquerade as distrust. Each chain must verify against the deliberately vulnerable fixture and fail with an issuer error against patched certifi."],"additions":6,"deletion