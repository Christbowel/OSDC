{"id":"586a82a81697b143e702e93060cd7995c715b549","axis":"silent","repo":"aiogram/aiogram","sha":"586a82a81697b143e702e93060cd7995c715b549","parsed":{"files":[{"path":"CHANGES/1966.bugfix.rst","lines":["@@ -0,0 +1,7 @@","+Sped up parsing of incoming Bot API responses by roughly 1.5x by letting pydantic read the","+response body directly instead of decoding it into a dict first.","+:code:`BaseSession(json_loads=...)` now defaults to :code:`None`, which selects that path;","+passing a decoder keeps the previous two-step behaviour. Without a decoder a malformed body","+reports pydantic's :code:`json_invalid` inside :class:`aiogram.exceptions.ClientDecodeError`","+instead of :code:`json.JSONDecodeError`, and :code:`ClientDecodeError.data` now always holds","+the raw response body instead of the decoded object."],"additions":7,"deletions":0,"truncated":false},{"path":"CHANGES/1966.removal.rst","lines":["@@ -0,0 +1,5 @@","+Removed :code:`TelegramObject.remove_unset` and :code:`TelegramMethod.remove_unset`.","+They stripped the :code:`UNSET` sentinel before field validation, which stopped reaching model","+initialization in #1392 when bot-wide defaults moved to :code:`Default(...)`. Running as a","+:code:`model_validator(mode=\"before\")` on every model also stopped pydantic from reading a","+payload without an intermediate dict."],"additions":5,"deletions":0,"truncated":false},{"path":"aiogram/client/session/base.py","lines":["@@ -54,14 +54,15 @@ class BaseSession(abc.ABC):","     def __init__(","         self,","         api: TelegramAPIServer = PRODUCTION,","-        json_loads: _JsonLoads = json.loads,","+        json_loads: _JsonLoads | None = None,","         json_dumps: _JsonDumps = json.dumps,","         timeout: float = DEFAULT_TIMEOUT,","     ) -> None:","         \"\"\""," ","         :param api: Telegram Bot API URL patterns","-        :param json_loads: JSON loader","+        :param json_loads: JSON loader; when omitted, pydantic reads the response body","+            itself instead of decoding it into a dict first","         :param json_dumps: JSON dumper","         :param timeout: Session scope request timeout","         \"\"\"","@@ -82,21 +83,30 @@ def check_response(","         \"\"\"","         Check response status","         \"\"\"","+        response_type = Response[method.__returning__]  # type: ignore","         try:","-            json_data = self.json_loads(content)","-        except Exception as e:  # noqa: BLE001","-            # Handled error type can't be classified as specific error","-            # in due to decoder can be customized and raise any exception","+            if self.json_loads:","+                try:","+                    json_data = self.json_loads(content)","+                except Exception as e:  # noqa: BLE001","+                    # Handled error type can't be classified as specific error","+                    # in due to decoder can be customized and raise any exception"," ","-            msg = \"Failed to decode object\"","-            raise ClientDecodeError(msg, e, content) from e","+                    msg = \"Failed to decode object\"","+                    raise ClientDecodeError(msg, e, content) from e"," ","-        try:","-            response_type = Response[method.__returning__]  # type: ignore","-            response = response_type.model_validate(json_data, context={\"bot\": bot})","+                response = response_type.model_validate(json_data, context={\"bot\": bot})","+            else:","+                # Let pydantic read the payload straight into the model instead of","+                # building an intermediate dict first.","+                response = response_type.model_validate_json(content, context={\"bot\": bot})","         except ValidationError as e:","-            msg = \"Failed to deserialize object\"","-            raise ClientDecodeError(msg, e, json_data) from e","+            msg = (","+                \"Failed to decode object\"","+                if any(error[\"type\"].startswith(\"json_\") for error in e.errors())","+                else \"Failed to deserialize object\"","+            )","+            raise ClientDecodeError(msg, e, content) from e"," ","         if HTTPStatus.OK <= status_code <= HTTPStatus.IM_USED and response.ok:","             return response"],"additions":23,"deletions":13,"truncated":false},{"path":"aiogram/methods/base.py","lines":["@@ -11,12 +11,10 @@"," )"," "," from pydantic import BaseModel, ConfigDict","-from pydantic.functional_validators import model_validator"," "," from aiogram.client.context_controller import BotContextController"," "," from ..types import InputFile, ResponseParameters","-from ..types.base import UNSET_TYPE"," "," if TYPE_CHECKING:","     from ..client.bot import Bot","@@ -48,21 +46,6 @@ class TelegramMethod(BotContextController, BaseModel, Generic[TelegramType], ABC","         arbitrary_types_allowed=True,","     )"," ","-    @model_validator(mode=\"before\")","-    @classmethod","-    def remove_unset(cls, values: dict[str, Any]) -> dict[str, Any]:","-        \"\"\"","-        Remove UNSET before fields validation.","-","-        We use UNSET as a sentinel value for `parse_mode` and replace it to real value later.","-        It isn't a problem when it's just default value for a model field,","-        but UNSET might be passing to a model initialization from `Bot.method_name`,","-        so we must take care of it and remove it before fields validation.","-        \"\"\"","-        if not isinstance(values, dict):","-            return values","-        return {k: v for k, v in values.items() if not isinstance(v, UNSET_TYPE)}","-","     if TYPE_CHECKING:","         __returning__: ClassVar[Any]","         __api_method__: ClassVar[str]"],"additions":0,"deletions":17,"truncated":false},{"path":"aiogram/types/base.py","lines":["@@ -1,7 +1,7 @@"," from typing import Any"," from unittest.mock import sentinel"," ","-from pydantic import BaseModel, ConfigDict, model_validator","+from pydantic import BaseModel, ConfigDict"," "," from aiogram.client.context_controller import BotContextController"," from aiogram.client.default import Default","@@ -19,21 +19,6 @@ class TelegramObject(BotContextController, BaseModel):","         protected_namespaces=(),","     )"," ","-    @model_validator(mode=\"before\")","-    @classmethod","-    def remove_unset(cls, values: dict[str, Any]) -> dict[str, Any]:","-        \"\"\"","-        Remove UNSET before fields validation.","-","-        We use UNSET as a sentinel value for `parse_mode` and replace it to real value later.","-        It isn't a problem when it's just default value for a model field,","-        but UNSET might be passed to a model initialization from `Bot.method_name`,","-        so we must take care of it and remove it before fields validation.","-        \"\"\"","-        if not isinstance(values, dict):","-            return values","-        return {k: v for k, v in values.items() if not isinstance(v, UNSET_TYPE)}","-"," "," class MutableTelegramObject(TelegramObject):","     model_config = ConfigDict("],"additions":1,"deletions":16,"truncated":false},{"path":"aiogram/webhook/aiohttp_server.py","lines":["@@ -1,4 +1,5 @@"," import asyncio","+import json"," import secrets"," from abc import ABC, abstractmethod"," from asyncio import Transport","@@ -145,7 +146,7 @@ async def _handle_request_background(self, bot: Bot, request: web.Request) -> we","         feed_update_task = asyncio.create_task(","             self._background_feed_update(","                 bot=bot,","-                update=await request.json(loads=bot.session.json_loads),","+                update=await request.json(loads=bot.session.json_loads or json.loads),","             ),","         )","         self._background_feed_update_tasks.add(feed_update_task)","@@ -192,7 +193,7 @@ def _build_response_writer(","     async def _handle_request(self, bot: Bot, request: web.Request) -> web.Response:","         result: TelegramMethod[Any] | None = await self.dispatcher.feed_webhook_update(","             bot,","-            await request.json(loads=bot.session.json_loads),","+            await request.json(loads=bot.session.json_loads or json.loads),","             **self.data,","         )","         return web.Response(body=self._build_response_writer(bot=bot, result=result))"],"additions":3,"deletions":2,"truncated":false},{"path":"tests/test_api/test_client/test_session/test_base_session.py","lines":["@@ -69,7 +69,8 @@ def test_init_api(self):","     def test_default_props(self):","         session = CustomSession()","         assert session.api == PRODUCTION","-        assert session.json_loads == json.loads","+        # No decoder by default: pydantic reads the response body itself","+        assert session.json_loads is None","         assert session.json_dumps == json.dumps"," ","         def custom_loads(*_):","@@ -203,18 +204,67 @@ def test_check_response(self, status_code, content, error):","             if error.url:","                 assert error.url in string"," ","-    def test_check_response_json_decode_error(self):","+    # An empty body is the malformed payload most likely to reach check_response","+    # in practice, so it is covered next to the garbage one.","+    @pytest.mark.parametrize(\"content\", [\"is not a JSON object\", \"\", \" \"])","+    def test_check_response_json_decode_error(self, content: str):","         session = CustomSession()","         bot = MockedBot()","         method = DeleteMessage(chat_id=42, message_id=42)"," ","-        with pytest.raises(ClientDecodeError, match=\"JSONDecodeError\"):","+        # The default decoder lets pydantic parse the payload, so a malformed","+        # body surfaces as pydantic's json_invalid rather than JSONDecodeError.","+        with pytest.raises(ClientDecodeError, match=\"Failed to decode object\") as exc_info:","+            session.check_response(","+                bot=bot,","+                method=method,","+                status_code=200,","+                content=content,","+            )","+        assert \"json_invalid\" in str(exc_info.value)","+        assert exc_info.value.data == content","+","+    def test_check_response_json_decode_error_custom_loads(self):","+        session = CustomSession()","+        bot = MockedBot()","+        method = DeleteMessage(chat_id=42, message_id=42)","+","+        def failing_loads(value):","+            raise ValueError(\"nope\")","+","+        session.json_loads = failing_loads","+","+        with pytest.raises(ClientDecodeError, match=\"ValueError\") as exc_info:","             session.check_response(","                 bot=bot,","                 method=method,","                 status_code=200,","                 content=\"is not a JSON object\",","             )","+        assert \"Failed to decode object\" in str(exc_info.value)","+        # The raw body is reported, not the decoder's (absent) output.","+        assert exc_info.value.data == \"is not a JSON object\"","+","+    def test_check_response_custom_loads_is_honoured(self):","+        session = CustomSession()","+        bot = MockedBot()","+        method = DeleteMessage(chat_id=42, message_id=42)","+        calls = []","+","+        def counting_loads(value):","+            calls.append(value)","+            return json.loads(value)","+","+        session.json_loads = counting_loads","+        response = session.check_response(","+            bot=bot,","+            method=method,","+            status_code=200,","+            content='{\"ok\": true, \"result\": true}',","+        )","+","+        assert response.result is True","+        assert calls == ['{\"ok\": true, \"result\": true}']"," ","     def test_check_response_validation_error(self):","         session = CustomSession()"],"additions":53,"deletions":3,"truncated":false},{"path":"tests/test_api/test_methods/test_base.py","lines":["@@ -1,29 +1,33 @@","-from unittest.mo