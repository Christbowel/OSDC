Y_SIZE, &key),","+        WC_NO_ERR_TRACE(NO_VALID_DEVID));","+    wc_ed25519_free(&key);","+","+    ExpectIntEQ(wc_ed25519_init_label(&key, \"dev-key\", NULL, devId), 0);","+    ExpectIntEQ(wc_ed25519_make_key(&rng, ED25519_KEY_SIZE, &key),","+        WC_NO_ERR_TRACE(NO_VALID_DEVID));","+    wc_ed25519_free(&key);","+","+#if !defined(WOLF_CRYPTO_CB_ONLY_ED25519) && \\","+    !defined(WOLF_CRYPTO_CB_ONLY_SHA512)","+    /* Without a registered device the key stays in software. */","+    ExpectIntEQ(wc_ed25519_init_id(&key, id, (int)sizeof(id), NULL,","+        devId + 100), 0);","+    ExpectIntEQ(wc_ed25519_make_key(&rng, ED25519_KEY_SIZE, &key), 0);","+    wc_ed25519_free(&key);","+","+    ExpectIntEQ(wc_ed25519_init_ex(&key, NULL, devId), 0);","+    ExpectIntEQ(wc_ed25519_make_key(&rng, ED25519_KEY_SIZE, &key), 0);","+    wc_ed25519_free(&key);","+#endif","+","+    wc_CryptoCb_UnRegisterDevice(devId);","+    DoExpectIntEQ(wc_FreeRng(&rng), 0);","+#endif","+    return EXPECT_RESULT();","+}"],"additions":62,"deletions":0,"truncated":false},{"path":"tests/api/test_ed25519.h","lines":["@@ -46,6 +46,7 @@ int test_wc_ed25519_check_key_edgecases(void);"," int test_wc_ed25519_import_variants(void);"," int test_wc_ed25519_make_public_argchecks(void);"," int test_wc_ed25519_make_public_dev_key(void);","+int test_wc_ed25519_make_key_id_dev(void);"," "," #define TEST_ED25519_DECLS                                          \\","     TEST_DECL_GROUP(\"ed25519\", test_wc_ed25519_make_key),           \\","@@ -69,6 +70,7 @@ int test_wc_ed25519_make_public_dev_key(void);","     TEST_DECL_GROUP(\"ed25519\", test_wc_ed25519_import_variants),     \\","     TEST_DECL_GROUP(\"ed25519\", test_wc_ed25519_make_public_argchecks), \\","     TEST_DECL_GROUP(\"ed25519\", test_wc_ed25519_make_public_dev_key), \\","-    TEST_DECL_GROUP(\"ed25519\", test_wc_Ed25519PrivateKeyDecode_ex)","+    TEST_DECL_GROUP(\"ed25519\", test_wc_Ed25519PrivateKeyDecode_ex),  \\","+    TEST_DECL_GROUP(\"ed25519\", te