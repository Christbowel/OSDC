ons` is set (a static array or a function that may return a promise), the form switches to an exclusive dropdown picker for that type. The function receives `projectId`, `dataset`, `getClient`, and the type key, and is resolved when a surface needs the list, not during studio boot. Condition keys must be unique across types."," "," - each row is two select-like `MenuButton`s (`ConditionMenuButton`): the key, then its value"," - menu rows follow the workspace switcher (`MenuItem` with icon, title, and description as subtitle); the current choice is checked"],"additions":2,"deletions":2,"truncated":false},{"path":"packages/sanity/src/core/variants/components/dialog/__tests__/CreateVariantDialog.test.tsx","lines":["@@ -558,7 +558,7 @@ describe('CreateVariantDialog mapped conditions', () => {","         beta: {","           variants: {","             enabled: true,","-            conditions,","+            types: {variant: {conditions}},","           },","         },","       },"],"additions":1,"deletions":1,"truncated":false},{"path":"packages/sanity/src/core/variants/components/dialog/__tests__/VariantDialog.test.tsx","lines":["@@ -202,13 +202,17 @@ describe('VariantDialog', () => {","         beta: {","           variants: {","             enabled: true,","-            conditions: [","-              {","-                name: 'audience',","-                title: 'Audience',","-                values: [{value: 'loyal', title: 'Loyal customers'}],"],"additions":0,"deletions":5,"truncated":false}],"additions":313,"deletions":101,"truncated":true,"file_count":16},"error":null,"fetched_at":"2026-09-25T13:32:04.433349+00:00"}