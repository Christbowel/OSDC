IN ANALYZE SELECT count(*)","+FROM read_parquet('{DATA_DIR}/parquet-testing/encryption/parquet_mr_uniform_encryption_bloom_filter.parquet',","+    encryption_config={footer_key: 'arrow_key_generated_files'})","+WHERE id = 15;","+----","+analyzed_plan\t<REGEX>:(?s).*Row Groups Scanned: 0 / 3.*","+","+# same for the string column (column ordinal 1 in the bloom filter module AAD)","+query II","+EXPLAIN ANALYZE SELECT count(*)","+FROM read_parquet('{DATA_DIR}/parquet-testing/encryption/parquet_mr_uniform_encryption_bloom_filter.parquet',","+    encryption_config={footer_key: 'arrow_key_generated_files'})","+WHERE name = 'name_15';","+----","+analyzed_plan\t<REGEX>:(?s).*Row Groups Scanned: 0 / 3.*","+","+query I","+SELECT count(*)","+FROM read_parquet('{DATA_DIR}/parquet-testing/encryption/parquet_mr_uniform_encryption_bloom_filter.parquet',","+    encryption_config={footer_key: 'arrow_key_generated_files'})","+WHERE name = 'name_20150';","+----","+1",""],"additions":55,"deletions":0,"truncated":false}],"additions":107,"deletions":29,"truncated":false,"file_count":9},"error":null,"fetched_at":"2026-11-27T19:04:44.144964+00:00"}