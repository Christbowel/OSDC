           ),","+            (Outlines, StructuralTag(_)) => unsupported(","+                \"Outlines structured outputs backend does not support structural_tag \\","+                 specifications\",","+            ),","+            (LmFormatEnforcer, Grammar(_)) => unsupported(","+                \"LM Format Enforcer structured outputs backend does not support grammar \\","+                 specifications\",","+            ),","+            (LmFormatEnforcer, StructuralTag(_)) => unsupported(","+                \"LM Format Enforcer structured outputs backend does not support structural_tag \\","+                 specifications\",","+            ),","+            _ => Ok(()),","+        }","+    }","+}","+","+/// Whether a structural tag uses the legacy `structures`/`triggers` shape, the","+/// only one the guidance backend reads.","+fn is_legacy_structural_tag(tag: &str) -> bool {","+    serde_json::from_str::<Value>(tag)","+        .is_ok_and(|tag| tag.get(\"structures\").is_some() && tag.get(\"triggers\").is_some())","+}","+"," /// The single structured-output constraint selected for a request."," #[derive(Debug, Clone, PartialEq, EnumAsInner)]"," pub enum StructuredOutputConstraint {","@@ -66,12 +134,6 @@ pub struct StructuredOutputOptions {"," pub struct StructuredOutputsParams {","     pub constraint: StructuredOutputConstraint,","     pub options: StructuredOutputOptions,","-    /// Structured-output backend, mirroring Python's internal `_backend`.","-    ///","-    /// User-supplied values are ignored during deserialization. This matches","-    /// Python's request boundary, where `_backend` is set by validation rather","-    /// than accepted as a request-level backend selector.","-    pub backend: StructuredOutputBackend,"," }"," "," impl StructuredOutputsParams {","@@ -105,7 +167,6 @@ impl StructuredOutputsParams {","         Self {","             constraint,","             options: StructuredOutputOptions::default(),","-            backend: Structure