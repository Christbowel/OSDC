ons":2,"deletions":0,"truncated":false},{"path":"torch/csrc/profiler/kineto/libkineto/src/RocprofLogger.cpp","lines":["@@ -25,6 +25,7 @@"," #include <ctime>"," #include <mutex>"," #include <new>","+#include <thread>"," #include <type_traits>"," #include <unordered_map>"," #include <vector>","@@ -429,6 +430,19 @@ int RocprofLogger::toolInit(","         api_callback,","         nullptr));"," ","+    // Learn every kernel dispatch at enqueue (including each kernel of a graph","+    // launch and runtime-internal blits), so stopLogging() knows which","+    // dispatch records are still owed.","+    auto dispatch_ops = std::vector<rocprofiler_tracing_operation_t>{","+        ROCPROFILER_KERNEL_DISPATCH_ENQUEUE};","+    ROCPROF_CALL_THROW(rocprofiler_configure_callback_tracing_service(","+        globalContext.context,","+        ROCPROFILER_CALLBACK_TRACING_KERNEL_DISPATCH,","+        dispatch_ops.data(),","+        dispatch_ops.size(),","+        dispatch_callback,","+        nullptr));","+","     // Collect async ops via buffers","     constexpr auto buffer_size_bytes = 0x40000;","     constexpr auto buffer_watermark_bytes = buffer_size_bytes / 2;","@@ -849,6 +863,25 @@ void RocprofLogger::api_callback(","   } // ROCPROFILER_CALLBACK_TRACING_HIP_RUNTIME_API"," }"," ","+void RocprofLogger::dispatch_callback(","+    rocprofiler_callback_tracing_record_t record,","+    [[maybe_unused]] rocprofiler_user_data_t* user_data,","+    [[maybe_unused]] void* callback_data) {","+  // Registered before the packet is submitted, so it always precedes the","+  // dispatch's buffer record.","+  if (record.kind != ROCPROFILER_CALLBACK_TRACING_KERNEL_DISPATCH ||","+      record.operation != ROCPROFILER_KERNEL_DISPATCH_ENQUEUE ||","+      record.phase != ROCPROFILER_CALLBACK_PHASE_ENTER) {","+    return;","+  }","+  auto* data =","+      static_cast<rocprofiler_callback_tracing_kernel_dispatch_data_t*>(","+          record.payload);","+  auto& dis = singleton();","+  std::lock_guard<std::mutex> lock(dis.pendingDispatchesMutex_);","+  dis.pendingDispatches_.insert(data->dispatch_info.dispatch_id);","+}","+"," void RocprofLogger::buffer_callback(","     [[maybe_unused]] rocprofiler_context_id_t context,","     [[maybe_unused]] rocprofiler_buffer_id_t buffer_id,","@@ -866,6 +899,12 @@ void RocprofLogger::buffer_callback(","                 header->payload));","         auto& dispatch = record.dispatch_info;"," ","+        {","+          auto& dis = singleton();","+          std::lock_guard<std::mutex> lock(dis.pendingDispatchesMutex_);","+          dis.pendingDispatches_.erase(dispatch.dispatch_id);","+        }","+","         // Safe access to agents map with default value","         auto& globalContext = getGlobalContext();","         auto agent_it = globalContext.agents.find(dispatch.agent_id);","@@ -958,6 +997,10 @@ void RocprofLogger::setPerThreadBuffers(bool enabled) {","   perThreadBuffers_.store(enabled, std::memory_order_relaxed);"," }"," ","+void RocprofLogger::setDispatchRecordWait(std::chrono::milliseconds wait) {","+  dispatchRecordWait_ = wait;","+}","+"," void RocprofLogger::ensureRegistered() {","   int status = 0;","   rocprofiler_is_initialized(&status);","@@ -982,6 +1025,11 @@ void RocprofLogger::startLogging() {","   }"," ","   externalCorrelationEnabled_.store(true, std::memory_order_relaxed);","+  {","+    // Dispatches given up on by an earlier stop must not stall this session.","+    std::lock_guard<std::mutex> lock(pendingDispatchesMutex_);","+    pendingDispatches_.clear();","+  }","   // start_context is idempotent (it returns SUCCESS for an already-active","   // context), so there is no need to query context state first.","   ROCPROF_CALL(rocprofiler_start_context(globalContext.context));","@@ -1012,6 +1060,34 @@ void RocprofLogger::stopLogging() {","   // to the contexts active at enqueue, and its record is still written to","   // this buffer when the kernel completes after the stop.","   ROCPROF_CALL(rocprofiler_flush_buffer(globalContext.buffer));","+","+  // The SDK writes a dispatch record from its own completion handler, which","+  // can run after the application has already seen the kernel finish (e.g.","+  // hipDeviceSynchronize returned). Such a record would miss the flush above","+  // and be dropped as out of range in the next session, so re-flush until","+  // every dispatch of this session has its record. The wait is bounded because","+  // some dispatches never produce a usable one: a dispatch the SDK could not","+  // time has no record, and a kernel still running at stop ends outside this","+  // session's window, so its record is dropped even if the wait sees it.","+  auto pendingCount = [this] {","+    std::lock_guard<std::mutex> lock(pendingDispatchesMutex_);","+    return pendingDispatches_.size();","+  };","+  const auto deadline = std::chrono::steady_clock::now() + dispatchRecordWait_;","+  size_t pending = pendingCount();","+  while (pending > 0 && std::chrono::steady_clock::now() < deadline) {","+    std::this_thread::sleep_for(std::chrono::microseconds(50));","+    ROCPROF_CALL(rocprofiler_flush_buffer(globalContext.buffer));","+    pending = pendingCount();","+  }","+  if (pending > 0 && dispatchRecordWait_.count() > 0) {","+    LOG_FIRST_N(WARNING, 10)","+        << \"Stopped waiting for \" << pending","+        << \" kernel dispatch record(s) after \" << dispatchRecordWait_.count()","+        << \" ms; their GPU events are missing from this trace. Kernels still \"","+        << \"running when profiling stopped cannot be recorded; for kernels \"","+        << \"that had finished, raise ROCPROF_DISPATCH_RECORD_WAIT_MSECS.\";","+  }"," }"," "," //"],"additions":76,"deletions":0,"truncated":false},{"path":"torch/csrc/profiler/kineto/libkineto/src/RocprofLogger.h","lines":["@@ -9,6 +9,7 @@"," #pragma once"," "," #include <atomic>","+#include <chrono>"," #include <deque>"," #include <functional>"," #include <list>","@@ -18,6 +19,7 @@"," #include <set>"," #incl