{"id":"48c90094d98cb5f194ce7bf0f4e7458921f4a45a","axis":"silent","repo":"supabase/supabase","sha":"48c90094d98cb5f194ce7bf0f4e7458921f4a45a","parsed":{"files":[{"path":"apps/studio/components/interfaces/Auth/Overview/OverviewTable.tsx","lines":["@@ -2,7 +2,7 @@ import { Loader2Icon } from 'lucide-react'"," import { ReactNode } from 'react'"," import { cn, Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from 'ui'"," ","-import NoDataPlaceholder from '@/components/ui/Charts/NoDataPlaceholder'","+import { NoDataPlaceholder } from '@/components/ui/Charts/NoDataPlaceholder'"," "," export type OverviewTableColumn<T> = {","   key: keyof T | string"],"additions":1,"deletions":1,"truncated":false},{"path":"apps/studio/components/interfaces/Explorer/QueryEditor/QueryResultChart.tsx","lines":["@@ -3,7 +3,7 @@ import { cn, type ChartConfig as ChartSeriesConfig } from 'ui'"," import { Chart, ChartBar, ChartCard, ChartContent, ChartLine } from 'ui-patterns/Chart'"," "," import { type QueryResult } from '../types'","-import NoDataPlaceholder from '@/components/ui/Charts/NoDataPlaceholder'","+import { NoDataPlaceholder } from '@/components/ui/Charts/NoDataPlaceholder'"," import {","   computeYAxisWidth,","   formatLogTick,"],"additions":1,"deletions":1,"truncated":false},{"path":"apps/studio/components/interfaces/Observability/ObservabilityOverview.tsx","lines":["@@ -13,7 +13,7 @@ import { useObservabilityOverviewData } from './ObservabilityOverview.utils'"," import { ObservabilityOverviewFooter } from './ObservabilityOverviewFooter'"," import { ServiceHealthTable } from './ServiceHealthTable'"," import { useSlowQueriesCount } from './useSlowQueriesCount'","-import ReportHeader from '@/components/interfaces/Reports/ReportHeader'","+import { ReportHeader } from '@/components/interfaces/Reports/ReportHeader'"," import { ReportPadding } from '@/components/interfaces/Reports/ReportPadding'"," import {","   buildUnifiedLogsUrl,"],"additions":1,"deletions":1,"truncated":false},{"path":"apps/studio/components/interfaces/Observability/Warehouse/WarehouseMetricsReport.platform.test.tsx","lines":["@@ -0,0 +1,150 @@","+import { QueryClient } from '@tanstack/react-query'","+import { screen } from '@testing-library/react'","+import type { platformComponents as components } from 'api-types'","+import { HttpResponse } from 'msw'","+import { beforeEach, expect, test, vi } from 'vitest'","+","+import { WarehouseMetricsReport } from './WarehouseMetricsReport'","+import { organizationKeys } from '@/data/organizations/keys'","+import { projectKeys } from '@/data/projects/keys'","+import type { WarehouseMetricsResponse } from '@/data/warehouse/warehouse-metrics-api-types'","+import { customRender } from '@/tests/lib/custom-render'","+import { addAPIMock, type APIErrorBody } from '@/tests/lib/msw'","+","+type Setup = components['schemas']['WarehouseSetupStatusResponse_Output']","+const setup: Setup = {","+  setup_status: 'complete',","+  steps: [],","+  tables: [],","+  fdw_status: {","+    extension_available: true,","+    extension_installed: true,","+    foreign_schema_imported: true,","+    schema_created: true,","+    server_configured: true,","+    wrapper_installed: true,","+  },","+}","+const mockSetup = (status: Setup['setup_status'] = 'complete') =>","+  addAPIMock({","+    method: 'get',","+    path: '/platform/warehouse/:ref/setup-status',","+    response: () => HttpResponse.json<Setup>({ ...setup, setup_status: status }),","+  })","+const response = (value: number | null): WarehouseMetricsResponse => ({","+  metrics: [","+    {","+      project_ref: 'default',","+      metric: 'query_rate',","+      unit: 'per_second',","+      aggregation: 'rate',","+      definition: 'Query rate',","+      requested: { metric: 'query_rate', start: 1794877200, end: 1794877260, step: 60 },","+      effective: { start: 1794877200, end: 1794877260, step: 60, rate_window_seconds: 300 },","+      scrape_interval_seconds: 60,","+      last_sample_at: 1794877260,","+      availability: value === null ? 'no_data' : 'ok',","+      series: [","+        {","+          labels: {},","+          coverage: { returned_points: 2, expected_points: 2 },","+          points: [","+            { timestamp: 1794877200, value: null },","+            { timestamp: 1794877260, value },","+          ],","+        },","+      ],","+    },","+  ],","+})","+const mockMetrics = (value: number | null) =>","+  addAPIMock({","+    method: 'get',","+    path: '/platform/warehouse/:ref/metrics',","+    response: () => HttpResponse.json<WarehouseMetricsResponse>(response(value)),","+  })","+const renderReport = (enabled = true) => {","+  const queryClient = new QueryClient({","+    defaultOptions: { queries: { retry: false, staleTime: Infinity } },","+  })","+  queryClient.setQueryData(projectKeys.detail('default'), { organization_id: 1 })","+  queryClient.setQueryData(organizationKeys.list(), [{ id: 1, slug: 'warehouse-org' }])","+  queryClient.setQueryData(","+    ['warehouse-configcat-flag', 'default'],","+    enabled ? ['warehouse-org'] : []","+  )","+  return customRender(<WarehouseMetricsReport />, { queryClient })","+}","+","+beforeEach(() => {","+  mockSetup()","+  addAPIMock({","+    method: 'get',","+    path: '/platform/projects/:ref',","+    response: () => HttpResponse.json<APIErrorBody>({ message: 'Not found' }, { status: 404 }),","+  })","+})","+test('shows an explicit last-hour empty state', async () => {","+  mockMetrics(null)","+  renderReport()","+  expect(await screen.findByText('No data in the last 60 minutes')).toBeInTheDocument()","+  expect(screen.getByRole('status')).toHaveTextContent(","+    'Warehouse report: No data in the last 60 minutes'","+  )","+})","+test('renders measured zero as query activity', async () => {","+  mockMetrics(0)","+  renderReport()","+  expect(","+    await screen.findByText('Queries started per second. Not a count of SQL statements.')","+  ).toBeInTheDocument()","+  expect(screen.queryByText('No data in the last 60 minutes')).not.toBeInTheDocument()","+})","+test.each(['not_started', 'disabled'] as const)(","+  'offers setup when Warehouse is %s',","+  async (status) => {","+    mockSetup(status)","+    mockMetrics(null)","+    renderReport()","+    expect(await screen.findByRole('link', { name: 'Set up Warehouse' })).toHaveAttribute(","+      'href',","+      '/project/default/integrations/warehouse/overview'","+    )","+  }","+)","+test('shows a request failure rather than a no-data state', async () => {","+  addAPIMock({","+    method: 'get',","+    path: '/platform/warehouse/:ref/metrics',","+    response: () => HttpResponse.json<APIErrorBody>({ message: 'Failed' }, { status: 400 }),","+  })","+  renderReport()","+  expect(await screen.findByText('Failed to retrieve Warehouse metrics')).toBeInTheDocument()","+})","+","+test('does not request Warehouse data without access', async () => {","+  const setupRequest = vi.fn(() => HttpResponse.json<Setup>(setup))","+  const metricsRequest = vi.fn(() => HttpResponse.json<WarehouseMetricsResponse>(response(null)))","+  addAPIMock({","+    method: 'get',","+    path: '/platform/warehouse/:ref/setup-status',","+    response: setupRequest,","+  })","+  addAPIMock({ method: 'get', path: '/platform/warehouse/:ref/metrics', response: metricsRequest })","+  renderReport(false)","+  expect(await screen.findByText('Warehouse metrics are unavailable')).toBeInTheDocument()","+  expect(screen.queryByRole('link', { name: 'Set up Warehouse' })).not.toBeInTheDocument()","+  expect(setupRequest).not.toHaveBeenCalled()","+  expect(metricsRequest).not.toHaveBeenCalled()","+})","+","+test('shows setup status failures when metrics cannot establish activity', async () => {","+  addAPIMock({","+    method: 'get',","+    path: '/platform/warehouse/:ref/setup-status',","+    response: () => HttpResponse.json<APIErrorBody>({ message: 'Failed' }, { status: 400 }),","+  })","+  mockMetrics(null)","+  renderReport()","+  expect(await screen.findByText('Failed to retrieve Warehouse status')).toBeInTheDocument()","+})"],"additions":150,"deletions":0,"truncated":false},{"path":"apps/studio/components/interfaces/Observability/Warehouse/WarehouseMetricsReport.tsx","lines":["@@ -0,0 +1,202 @@","+import { useQuery } from '@tanstack/react-query'","+import { useParams } from 'common'","+import dayjs from 'dayjs'","+import { WarehouseIcon } from 'lucide-react'","+import { useState } from 'react'","+import { Button, Card, CardContent } from 'ui'","+import { Admonition } from 'ui-patterns/Admonition'","+import { ChartLine } from 'ui-patterns/Chart'","+import { EmptyStatePresentational } from 'ui-patterns/EmptyStatePresentational'","+import { GenericSkeletonLoader } from 'ui-patterns/ShimmeringLoader'","+","+import {","+  getEmptyMessage,","+  getReportStatus,","+  getReportView,","+  getSetupPrompt,","+  hasAnyValues,","+  toChartPoints,","+  type ReportView,","+} from './WarehouseMetricsReport.utils'","+import { ReportHeader } from '@/components/interfaces/Reports/ReportHeader'","+import { AlertError } from '@/components/ui/AlertError'","+import { NoDataPlaceholder } from '@/components/ui/Charts/NoDataPlaceholder'","+import { InlineLink } from '@/components/ui/InlineLink'","+import { warehouseMetricsQueryOptions } from '@/data/warehouse/warehouse-metrics-query'","+import { useWarehouseSetupStatusQuery } from '@/data/warehouse/warehouse-setup-status-query'","+import { useIsWarehouseEnabled } from '@/hooks/misc/useIsWarehouseEnabled'","+import { IS_PLATFORM } from '@/lib/constants'","+","+export const WarehouseMetricsReport = () => {","+  const isWarehouseEnabled = useIsWarehouseEnabled()","+","+  return (","+    <>","+      <ReportHeader title=\"Warehouse\" showDatabaseSelector={false} />","+      {!isWarehouseEnabled ? (","+        <Admonition layout=\"responsive\" title=\"Warehouse metrics are unavailable\" />","+      ) : (","+        <WarehouseMetricsReportContent />","+      )}","+    </>","+  )","+}","+","+const WarehouseMetricsReportContent = () => {","+  const { ref } = useParams()","+  const [range] = useState(() => {","+    const end = dayjs().startOf('minute')","+    return { startDate: end.subtract(1, 'hour').toISOString(), endDate: end.toISOString() }","+  })","+","+  const setup = useWarehouseSetupStatusQuery({ projectRef: ref }, { enabled: IS_PLATFORM })","+","+  const query = useQuery(","+    warehouseMetricsQueryOptions({","+      projectRef: ref,","+      attributes: ['query_rate'],","+      ...range,","+      interval: '1m',","+    })","+  )","+  const metric = query.data?.metrics.find((item) => item.metric === 'query_rate')","+  const hasLiveTables = setup.data?.tables.some((table) => table.state === 'live') ?? false","+  const hasValues = hasAnyValues(metric)","+  const points = toChartPoints(metric)","+  const hasChartValues = points.some((point) => typeof point.value === 'number')","+  const emptyMessage = getEmptyMessage(metric)","+","+  const view = getReportView({","+    isPlatform: IS_PLATFORM,","+    isLoading: query.isPending || (setup.isPending && !hasValues),","+    setupError: setup.isError && !hasValues ? setup.error : null,","+    setupPrompt: getSetupPrompt({","+      setupStatus: setup.data?.setup_status,","+      hasLiveTables,","+      hasValues,","+    }),","+    metricsError: query.isError ? query.error : null,","+    hasChartValues,","+  })","+","+  return (","+    <>","+      <p className=\"text-sm text-foreground-light\">Query activity in the last 60 minutes.</p>","+      <div className=\"relative\">","+        <p role=\"status\" className=\"sr-only\">","+          {getReportStatus(view, emptyMessage)}","+        </p>","+        <WarehouseMetricsBody","+          view={view}","+          projectRef={ref}","+          points={points}","+          emptyMessage={emptyMessage}","+          isPartial={metric?.availability === 'partial'}","+        />","+      </div>","+    </>","+  )","+}","+","+const WarehouseMetricsBody = ({","+  view,","+  projectRef,","+  points,","+  emptyMessage,","+  isPartial,","+}: {","+  view: ReportView","+  projectRef?: string","+  points: Record<string, string | number>[]","+  emptyMessage: string","+  isPartial: boolean","+}) => {","+  switch (view.kind) {","+    case 'unsupported':","+      return (","+        <Admonition","+          layout=\"responsive\"","+          title=\"Warehouse metrics are unavailable\"","+          description=\"Warehouse metrics are only available on the Supabase platform.\"","+        />","+      )","+    case 'loading':","+      return <GenericSkeletonLoader aria-label=\"Loading Warehouse report\" />","+    case 'setup-error':","+      return (","+        <AlertError","+          projectRef={projectRef}","+          error={view.error}","+          subject=\"Failed to retrieve Warehouse status\"","+        />","+      )","+    case 'setup': {","+      const isDisabled = view.prompt === 'disabled'","+      return (","+        <EmptyStatePresentational","+          icon={WarehouseIcon}","+          title={isDisabled ? 'Warehouse is disabled' : 'Warehouse is not set up'}","+          description={","+            isDisabled","+              ? 'Set up Warehouse again to query a replicated copy of your data and monitor its latency, failures, and capacity here.'","+              : 'Run analytical queries on a replicated copy of your data, then monitor query latency, failures, and capacity here.'","+          }","+        >","+          <Button asChild variant=\"default\">","+            <InlineLink","+              className=\"no-underline\"","+              href={`/project/${projectRef}/integrations/warehouse/overview`}","+            >","+              Set up Warehouse","+            </InlineLink>","+          </Button>","+        </EmptyStatePresentational>","+      )","+    }","+    case 'metrics-error':","+      return (","+        <AlertError","+          projectRef={projectRef}","+          error={view.error}","+          subject=\"Failed to retrieve Warehouse metrics\"","+        />","+      )","+    case 'ready':","+      return (","+        <Card>","+          <CardContent className=\"space-y-4 p-4\">","+            {view.hasChartValues ? (","+              <>","+                <h2 className=\"text-sm\">Query rate</h2>","+                <p className=\"text-xs text-foreground-light\">","+                  Queries started per second. Not a count of SQL statements.","+                </p>","+                <ChartLine","+                  className=\"h-64\"","+                  isFullHeight","+                  data={points}","+                  xKey=\"timestamp\"","+                  dataKey=\"value\"","+                  config={{ value: { label: 'Queries/s', color: 'var(--chart-1)' } }}","+                  color=\"var(--chart-1)\"","+                  DateTimeFormat=\"MMM D, HH:mm\"","+                  showHighlightArea={false}","+                  tooltipDetails={(_, __, value) => `${value}/s`}","+                />","+              </>","+            ) : (","+              <NoDataPlaceholder","+                attribute=\"Query rate\"","+                size=\"normal\"","+                hideTotalPlaceholder","+                message={emptyMessage}","+              />","+            )}","+            {view.hasChartValues && isPartial && (","+              <p className=\"text-xs text-foreground-light\">Partial data</p>","+            )}","+          </CardContent>","+        </Card>","+      )","+  }","+}"],"additions":202,"deletions":0,"truncated":false},{"path":"apps/studio/components/interfaces/Observability/Warehouse/WarehouseMetricsReport.utils.test.ts","lines":["@@ -0,0 +1,108 @@","+import { describe, expect, it } from 'vitest'","+","+import {","+  getReportStatus,","+  getReportView,","+  getSetupPrompt,","+  hasAnyValues,","+  toChartPoints,","+} from './WarehouseMetricsReport.utils'","+import type { WarehouseMetric } from '@/data/warehouse/warehouse-metrics-api-types'","+","+const makeMetric = (seriesPoints: { timestamp: number; value: number | null }[][]) =>","+  ({","+    metric: 'query_rate',","+    availability: 'available',","+    series: seriesPoints.map((points) => ({ points })),","+  }) as unknown as WarehouseMetric","+","+describe('getReportView', () => {","+  const base = {","+    isPlatform: true,","+    isLoading: false,","+    setupError: null,","+    setupPrompt: undefined,","+    metricsError: null,","+    hasChartValues: true,","+  }","+  const error = { message: 'boom' }","+","+  it.each([","+    ['not on platform', { isPlatform: false, isLoading: true }, 'unsupported'],","+    ['loading', { isLoading: true, setupError: error }, 'loading'],","+    [","+      'setup error',","+      { setupError: error, setupPrompt: 'disabled', metricsError: error },","+      'setup-error',","+    ],","+    ['setup prompt', { setupPrompt: 'not_started', metricsError: error }, 'setup'],","+    ['metrics error', { metricsError: error }, 'metrics-error'],","+    ['ready', {}, 'ready'],","+  ] as const)('%s wins over later states', (_, overrides, kind) => {","+    expect(getReportView({ ...base, ...overrides }).kind).toBe(kind)","+  })","+})","+","+describe('getReportStatus', () => {","+  it('announces the empty message when there is nothing to chart', () => {","+    const view = getReportView({","+      isPlatform: true,","+      isLoading: false,","+      setupError: null,","+      setupPrompt: undefined,","+      metricsError: null,","+      hasChartValues: false,","+    })","+    expect(getReportStatus(view, 'No recent data')).toBe('Warehouse report: No recent data')","+  })","+","+  it('distinguishes disabled from not set up', () => {","+    expect(getReportStatus({ kind: 'setup', prompt: 'disabled' }, '')).toBe('Warehouse is disabled')","+    expect(getReportStatus({ kind: 'setup', prompt: 'not_started' }, '')).toBe(","+      'Warehouse is not set up'","+    )","+  })","+})","+","+describe('getSetupPrompt', () => {","+  it.each([","+    ['not_started', false, false, 'not_started'],","+    ['disabled', false, false, 'disabled'],","+    ['not_started', true, false, undefined],","+    ['disabled', false, true, undefined],","+    ['enabled', false, false, undefined],","+  ] as const)(","+    '%s, liveTables=%s, hasValues=%s → %s',","+    (setupStatus, hasLiveTables, hasValues, expected) => {","+      expect(getSetupPrompt({ setupStatus, hasLiveTables, hasValues })).toBe(expected)","+    }","+  )","+})","+","+describe('toChartPoints / hasAnyValues', () => {","+  it('drops non-finite values but keeps the timestamp row', () => {","+    const metric = makeMetric([","+      [","+        { timestamp: 60, value: 1.5 },","+        { timestamp: 120, value: null },","+        { timestamp: 180, value: Number.NaN },","+      ],","+    ])","+    expect(toChartPoints(metric)).toEqual([","+      { timestamp: '1970-01-01T00:01:00.000Z', value: 1.5 },","+      { timestamp: '1970-01-01T00:02:00.000Z' },","+      { timestamp: '1970-01-01T00:03:00.000Z' },","+    ])","+  })","+","+  it('only charts a single series, but counts values across all series', () => {","+    const metric = makeMetric([[{ timestamp: 60, value: 1 }], [{ timestamp: 60, value: 2 }]])","+    expect(toChartPoints(metric)).toEqual([])","+    expect(hasAnyValues(metric)).toBe(true)","+  })","+","+  it('reports no values for missing or all-null metrics', () => {","+    expect(hasAnyValues(undefined)).toBe(false)","+    expect(hasAnyValues(makeMetric([[{ timestamp: 60, value: null }]]))).toBe(false)","+  })","+})"],"additions":108,"deletions":0,"truncated":false},{"path":"apps/studio/components/interfaces/Observability/Warehouse/WarehouseMetricsReport.utils.ts","lines":["@@ -0,0 +1,107 @@","+import type { WarehouseMetric } from '@/data/warehouse/warehouse-metrics-api-types'","+","+type ErrorLike = { message: string }","+","+export type SetupPrompt = 'not_started' | 'disabled'","+","+export type ReportView =","+  | { kind: 'unsupported' }","+  | { kind: 'loading' }","+  | { kind: 'setup-error'; error: ErrorLike }","+  | { kind: 'setup'; prompt: SetupPrompt }","+  | { kind: 'metrics-error'; error: ErrorLike }","+  | { kind: 'ready'; hasChartValues: boolean }","+","+const isValidValue = (value: number | null | undefined): value is number =>","+  value !== null && value !== undefined && Number.isFinite(value)","+","+export function hasAnyValues(metric?: WarehouseMetric) {","+  return (","+    metric?.series.some((series) => series.points.some((point) => isValidValue(point.value))) ??","+    false","+  )","+}","+","+// Only a single series is charted; multiple series are treated as unavailable.","+export function toChartPoints(metric?: WarehouseMetric): Record<string, string | number>[] {","+  if (metric?.series.length !== 1) return []","+  return metric.series[0].points.map((point) => {","+    const row: Record<string, string | number> = {","+      timestamp: new Date(point.timestamp * 1000).toISOString(),","+    }","+    if (isValidValue(point.value)) row.value = point.value","+    return row","+  })","+}","+","+export function getSetupPrompt({","+  setupStatus,","+  hasLiveTables,","+  hasValues,","+}: {","+  setupStatus?: string","+  hasLiveTables: boolean","+  hasValues: boolean","+}): SetupPrompt | undefined {","+  if (hasValues || hasLiveTables) return undefined","+  if (setupStatus === 'disabled') return 'disabled'","+  if (setupStatus === 'not_started') return 'not_started'","+  return undefined","+}","+","+// Order matters: the first matching state wins.","+export function getReportView({","+  isPlatform,","+  isLoading,","+  setupError,","+  setupPrompt,","+  metricsError,","+  hasChartValues,","+}: {","+  isPlatform: boolean","+  isLoading: boolean","+  setupError: ErrorLike | null","+  setupPrompt: SetupPrompt | undefined","+  metricsError: ErrorLike | null","+  hasChartValues: boolean","+}): ReportView {","+  if (!isPlatform) return { kind: 'unsupported' }","+  if (isLoading) return { kind: 'loading' }","+  if (setupError) return { kind: 'setup-error', error: setupError }","+  if (setupPrompt) return { kind: 'setup', prompt: setupPrompt }","+  if (metricsError) return { kind: 'metrics-error', error: metricsError }","+  return { kind: 'ready', hasChartValues }","+}","+","+export function getReportStatus(view: ReportView, emptyMessage: string) {","+  switch (view.kind) {","+    case 'unsupported':","+      return 'Warehouse metrics are unavailable'","+    case 'loading':","+      return 'Loading Warehouse report'","+    case 'setup-error':","+      return 'Could not load Warehouse setup status'","+    case 'setup':","+      return view.prompt === 'disabled' ? 'Warehouse is disabled' : 'Warehouse is not set up'","+    case 'metrics-error':","+      return 'Could not load Warehouse metrics'","+    case 'ready':","+      return view.hasChartValues ? 'Warehouse report loaded' : `Warehouse report: ${emptyMessage}`","+  }","+}","+","+export function getEmptyMessage(metric?: WarehouseMetric) {","+  if (!metric || metric.series.length > 1) return 'Metrics are temporarily unavailable'","+  switch (metric.availability) {","+    case 'stale':","+      return 'No recent data'","+    case 'insufficient_data':","+      return 'Not enough data yet'","+    case 'unavailable':","+    case 'disabled':","+    case 'not_provisioned':","+      return 'Metrics are temporarily unavailable'","+    default:","+      return 'No data in the last 60 minutes'","+  }","+}"],"additions":107,"deletions":0,"truncated":false},{"path":"apps/studio/components/interfaces/ProjectHome/ProjectUsageSection.tsx","lines":["@@ -14,7 +14,7 @@ import {","   buildUnifiedLogsUrl,","   type UnifiedLogType,"," } from '@/components/interfaces/UnifiedLogs/UnifiedLogs.utils'","-import NoDataPlaceholder from '@/components/ui/Charts/NoDataPlaceholder'","+import { NoDataPlaceholder } from '@/components/ui/Charts/NoDataPlaceholder'"," import { ChartIntervalDropdown } from '@/components/ui/Logs/ChartIntervalDropdown'"," import { C