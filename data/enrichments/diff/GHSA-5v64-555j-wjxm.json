{"id":"GHSA-5v64-555j-wjxm","axis":"advisories","repo":"rack/rack","sha":"244e75a840cee0823f86d5d01dc374505a8abed8","parsed":{"files":[{"path":"lib/rack/multipart/parser.rb","lines":["@@ -494,6 +494,7 @@ def handle_mime_head","           # buffering. Note that the actual limit is the higher of 64KB and the buffer size (1MB by default)","           raise Error, \"multipart mime part header too large\" if @sbuf.rest.bytesize > MIME_HEADER_BYTESIZE_LIMIT"," ","+          @sbuf.string = @sbuf.rest","           return :want_read","         end","       end","@@ -514,8 +515,8 @@ def handle_mime_body","             update_retained_size(body.bytesize) if @body_retained","             @collector.on_mime_body @mime_index, body","             @sbuf.pos += delta","-            @sbuf.string = @sbuf.rest","           end","+          @sbuf.string = @sbuf.rest","           :want_read","         end","       end"],"additions":2,"deletions":1,"truncated":false},{"path":"test/spec_multipart.rb","lines":["@@ -414,6 +414,27 @@ def rd.rewind; end","     Rack::Multipart.parse_multipart(env).keys.must_equal([\"a\", \"b\", \"c\"])","   end"," ","+  { \"inside a MIME head\" => 10, \"at the start of a MIME body\" => 0 }.each do |position, offset|","+    it \"does not retain parsed parts when reads end #{position}\" do","+      boundary = \"AaB03x\"","+      bufsize = 1024","+      delimiter = \"\\r\\n--#{boundary}\\r\\n\"","+      names = (\"a00\"..\"a63\").to_a","+      heads = names.map { |name| %(content-disposition: form-data; name=\"#{name}\"\\r\\n\\r\\n) }","+      body = \"0\" * (bufsize - delimiter.bytesize - heads.first.bytesize)","+","+      # Each part is one read long, so each read ends `offset` bytes before a body","+      data = \"x\" * (bufsize - delimiter.bytesize - heads.first.bytesize + offset)","+      heads.each { |head| data << delimiter << head << body }","+      data << \"\\r\\n--#{boundary}--\\r\\n\"","+","+      parser = Rack::Multipart::Parser.new(boundary, Rack::Multipart::Parser::TEMPFILE_FACTORY, bufsize, Rack::Utils.default_query_parser)","+      parser.parse(StringIO.new(data))","+      parser.result.params.keys.must_equal names","+      parser.instance_variable_get(:@sbuf).string.bytesize.must_be :<, 2 * bufsize","+    end","+  end","+","   it \"rejects excessive buffered mime data size in a single parameter\" do","     rd, wr = IO.pipe","     def rd.rewind; end",""],"additions":21,"deletions":0,"truncated":false}],"additions":23,"deletions":1,"truncated":false,"file_count":2},"error":null,"fetched_at":"2026-11-11T15:37:32.003091+00:00"}