ntainerd/nri/pkg/api\""," \t\"github.com/containerd/nri/pkg/stub\"","+\t\"github.com/spf13/afero\""," \t\"github.com/vishvananda/netlink\""," \tkube_types \"k8s.io/apimachinery/pkg/types\""," "," \t\"github.com/cilium/cilium/pkg/datapath/linux/safenetlink\"","+\t\"github.com/cilium/cilium/pkg/datapath/linux/sysctl\""," \t\"github.com/cilium/cilium/pkg/defaults\""," \t\"github.com/cilium/cilium/pkg/logging/logfields\""," \t\"github.com/cilium/cilium/pkg/netns\"","@@ -204,6 +206,10 @@ func (driver *Driver) RunPodSandbox(ctx context.Context, podSandbox *api.PodSand"," \t\t\t\t\treturn err"," \t\t\t\t}"," ","+\t\t\t\tif err := driver.configureSysctl(l, a.Config); err != nil {","+\t\t\t\t\treturn fmt.Errorf(\"failed to configure sysctl for device %s: %w\", l.Attrs().Name, err)","+\t\t\t\t}","+"," \t\t\t\treturn nil"," \t\t\t}); err != nil {"," \t\t\t\tlog.ErrorContext(ctx, \"failed to configure device\",","@@ -382,6 +388,18 @@ func configureIfName(l netlink.Link, newIfName string) (netlink.Link, error) {"," \treturn l, nil"," }"," ","+// configureSysctl applies the device config's interface-scoped sysctl","+// settings inside the current (pod) netns. Must run after the interface has","+// its final pod-facing name. Per-netns sysctls are torn down with the","+// namespace, so StopPodSandbox has no corresponding revert.","+func (driver *Driver) configureSysctl(l netlink.Link, cfg types.DeviceConfig) error {","+\tsettings := buildSysctlSettings(cfg, l.Attrs().Name)","+\tif len(settings) == 0 {","+\t\treturn nil","+\t}","+\treturn sysctl.NewDirectSysctl(afero.NewOsFs(), driver.hostProcPath).ApplySettings(settings)","+}","+"," // validateInterfaceNames checks if a pod's set of allocated devices"," // contain valid interface names, that dont collide with interfaces in the pod namespace."," func validateInterfaceNames(alloc []allocation) error {"],"additions":18,"deletions":0,"truncated":false},{"path":"pkg/networkdriver/prepare_test.go","lines":["@@ -613,6 +613,28 @@ func TestPrepare(t *testing.T) {"," \t\trequireNoAllocations(t, driver)"," \t})"," ","+\tt.Run(\"test invalid interface sysctl leaf is not set up\", func(t *testing.T) {","+\t\tcs, _ := k8sClient.NewFakeClientset(tlog)","+\t\tdev := &trackedDevice{name: prepTestDev0}","+","+\t\trawParam, _ := json.Marshal(map[string]any{","+\t\t\t\"interfaceSysctlIPv4\": map[string]string{","+\t\t\t\t\"arp filter\": \"1\", // invalid character","+\t\t\t},","+\t\t})","+\t\tclaim := buildPrepClaim(prepTestDev0)","+\t\tclaim.Status.Allocation.Devices.Config[0].Opaque.Parameters = runtime.RawExtension{Raw: rawParam}","+\t\tcreatePrepClaim(t, cs, claim)","+","+\t\tdriver := buildPrepDriver(t, cs, dev)","+\t\tresult := prepOne(t, driver, claim)","+\t\trequire.Error(t, result.Err)","+","+\t\trequire.EqualValues(t, 0, dev.setupCalls.Load(),","+\t\t\t\"Setup must not be called when interfaceSysctl validation fails\")","+\t\trequireNoAllocations(t, driver)","+\t})","+"," \tt.Run(\"wrong reservedFor length in claim, we only allow one claim consumer\", func(t *testing.T) {"," \t\tcs, _ := k8sClient.NewFakeClientset(tlog)"," \t\tdev := &trackedDevice{name: prepTestDev0}"],"additions":22,"deletions":0,"truncated":false},{"path":"pkg/networkdriver/sysctl.go","lines":["@@ -0,0 +1,58 @@","+// SPDX-License-Identifier: Apache-2.0","+// Copyright Authors of Cilium","+","+package networkdriver","+","+import (","+\t\"fmt\"","+\t\"strings\"","+","+\t\"github.com/cilium/cilium/pkg/datapath/linux/sysctl\"","+\t\"github.com/cilium/cilium/pkg/datapath/tables\"","+\t\"github.com/cilium/cilium/pkg/networkdriver/types\"","+)","+","+// validateInterfaceSysctl validates a device config's interface-scoped","+// sysctl leaves at claim preparation time: pure, no I/O. Only the leaf","+// (e.g. \"arp_filter\") is user-controlled; the net.<family>.conf.<interface>.","+// prefix is added later, in buildSysctlSettings, once the allocated","+// interface's final name is known.","+func validateInterfaceSysctl(cfg types.DeviceConfig) error {","+\tif err := validateSysctlLeaves(cfg.InterfaceSysctlIPv4); err != nil {","+\t\treturn fmt.Errorf(\"ipv4: %w\", err)","+\t}","+\tif err := validateSysctlLeaves(cfg.InterfaceSysctlIPv6); err != nil {","+\t\treturn fmt.Errorf(\"ipv6: %w\", err)","+\t}","+\treturn nil","+}","+","+func validateSysctlLeaves(leaves map[string]string) error {","+\tfor leaf, val := range leaves {","+\t\tif err := sysctl.ValidateParameter(strings.Split(leaf, \".\")); err != nil {","+\t\t\treturn fmt.Errorf(\"%w: %q: %w\", errInvalidSysctlLeaf, leaf, err)","+\t\t}","+\t\tif val == \"\" {","+\t\t\treturn fmt.Errorf(\"%w: %q\", errEmptySysctlValue, leaf)","+\t\t}","+\t}","+\treturn nil","+}","+","+// buildSysctlSettings expands a device config's interface-scoped sysctl","+// leaves into tables.Sysctl, ready to apply inside the pod netns once the","+// interface has its final name. ifName is kept as a single path segment so","+// names containing dots (e.g. \"eth0.100\") are handled unambiguously.","+func buildSysctlSettings(cfg types.DeviceConfig, ifName string) []tables.Sysctl {","+\tsettings := appendSysctlSettings(nil, \"ipv4\", ifName, cfg.InterfaceSysctlIPv4)","+\tsettings = appendSysctlSettings(settings, \"ipv6\", ifName, cfg.InterfaceSysctlIPv6)","+\treturn settings","+}","+","+func appendSysctlSettings(settings []tables.Sysctl, family, ifName string, leaves map[string]string) []tables.Sysctl {","+\tfor leaf, val := range leaves {","+\t\tname := append([]string{\"net\", family, \"conf\", ifName}, strings.Split(leaf, \".\")...)","+\t\tsettings = append(settings, tables.Sysctl{Name: name, Val: val})","+\t}","+\treturn settings","+}"],"additions":58,"deletions":0,"truncated":false},{"path":"pkg/networkdriver/sysctl_test.go","lines":["@@ -0,0 +1,91 @@","+// SPDX-License-Identifier: Apache-2.0","+// Copyright Authors of Cilium","+","+package networkdriver","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/cilium/cilium/pkg/datapath/tables\"","+\t\"github.com/cilium/cilium/pkg/networkdriver/types\"","+)","+","+func TestValidateInterfaceSysctl(t *testing.T) {","+\ttests := []struct {","+\t\tname    string","+\t\tipv4    map[string]string","+\t\tipv6    map[string]string","+\t\twantErr bool","+\t}{","+\t\t{","+\t\t\tname: \"empty\",","+\t\t},","+\t\t{","+\t\t\tname: \"valid leaves both families\",","+\t\t\tipv4: map[string]string{\"arp_filter\": \"1\"},","+\t\t\tipv6: map[string]string{\"disable_ipv6\": \"0\"},","+\t\t},","+\t\t{","+\t\t\tname:    \"invalid ipv4 leaf character\",","+\t\t\tipv4:    map[string]string{\"arp filter\": \"1\"},","+\t\t\twantErr: true,","+\t\t},","+\t\t{","+\t\t\tname:    \"invalid ipv6 leaf character\",","+\t\t\tipv6:    map[string]string{\"disable ipv6\": \"0\"},","+\t\t\twantErr: true,","+\t\t},","+\t\t{","+\t\t\tname:    \"empty ipv4 value\",","+\t\t\tipv4:    map[string]string{\"arp_filter\": \"\"},","+\t\t\twantErr: true,","+\t\t},","+\t\t{","+\t\t\tname:    \"empty ipv6 value\",","+\t\t\tipv6:    map[string]string{\"disable_ipv6\": \"\"},","+\t\t\twantErr: true,","+\t\t},","+\t}","+","+\tfor _, tc := range tests {","+\t\tt.Run(tc.name, func(t *testing.T) {","+\t\t\tcfg := types.DeviceConfig{InterfaceSysctlIPv4: tc.ipv4, InterfaceSysctlIPv6: tc.ipv6}","+\t\t\terr := validateInterfaceSysctl(cfg)","+\t\t\tif tc.wantErr {","+\t\t\t\trequire.Error(t, err)","+\t\t\t} else {","+\t\t\t\trequire.NoError(t, err)","+\t\t\t}","+\t\t})","+\t}","+}","+","+func TestBuildSysctlSettings(t *testing.T) {","+\tt.Run(\"empty config yields nil\", func(t *testing.T) {","+\t\trequire.Nil(t, buildSysctlSettings(types.DeviceConfig{}, \"eth0\"))","+\t})","+","+\tt.Run(\"leaves scoped to the live interface name for both families\", func(t *testing.T) {","+\t\tcfg := types.DeviceConfig{","+\t\t\tInterfaceSysctlIPv4: map[string]string{\"arp_filter\": \"1\"},","+\t\t\tInterfaceSysctlIPv6: map[string]string{\"disable_ipv6\": \"0\"},","+\t\t}","+\t\tgot := buildSysctlSettings(cfg, \"net1\")","+\t\trequire.ElementsMatch(t, []tables.Sysctl{","+\t\t\t{Name: []string{\"net\", \"ipv4\", \"conf\", \"net1\", \"arp_filter\"}, Val: \"1\"},","+\t\t\t{Name: []string{\"net\", \"ipv6\", \"conf\", \"net1\", \"disable_ipv6\"}, Val: \"0\"},","+\t\t}, got)","+\t})","+","+\tt.Run(\"interface name with dots is kept as a single segment\", func(t *testing.T) {","+\t\tcfg := types.DeviceConfig{","+\t\t\tInterfaceSysctlIPv4: map[string]string{\"arp_filter\": \"1\"},","+\t\t}","+\t\tgot := buildSysctlSettings(cfg, \"eth0.100\")","+\t\trequire.Equal(t, []tables.Sysctl{","+\t\t\t{Name: []string{\"net\", \"ipv4\", \"conf\", \"eth0.100\", \"arp_filter\"}, Val: \"1\"},","+\t\t}, got)","+\t})","+}"],"additions":91,"deletions":0,"truncated":false},{"path":"pkg/networkdriver/types/types.go","lines":["@@ -191,10 +191,20 @@ type DeviceManager interface {"," type DeviceConfig struct {"," \tPodIfName string `json:\"podIfName,omitempty\"` // Custom interface name for the pod namespace"," \tVlan      int32  `json:\"vlan,omitempty\"`      // VLAN ID to assign to the device (0 = untagged / no change)","+","+\t// InterfaceSysctlIPv4/IPv6 hold leaf sysctl parameters (e.g.","+\t// \"arp_filter\") applied under net.<family>.conf.<interface>. for the","+\t// interface this claim allocates. Applied once, inside the pod netns,","+\t// when the interface is brought up; not reverted on Free (the","+\t// namespace is destroyed with the pod).","+\tInterfaceSysctlIPv4 map[string]string `json:\"interfaceSysctlIPv4,omitempty\"`","+\tInterfaceSysctlIPv6 map[string]string `json:\"interfaceSysctlIPv6,omitempty\"`"," }"," "," func (d *DeviceConfig) Empty() bool {","-\treturn d == nil || *d == DeviceConfig{}","+\treturn d == nil ||","+\t\t(d.PodIfName == \"\" && d.Vlan == 0 &&","+\t\t\tlen(d.InterfaceSysctlIPv4) == 0 && len(d.InterfaceSysctlIPv6) == 0)"," }"," "," type SerializedDevice struct {",""],"additions":11,"deletions":1,"truncated":false}],"additions":237,"deletions":9,"truncated":false,"file_count":11}