pp-key', 'hello');","+        $latestVersion = 'v2';","+","+        $this->assertSame('hello', $kms->decrypt($ciphertext));","+        $this->assertSame(self::VAULT.'keys/app-key/v1/decrypt?api-version=7.4', $urls[1]);","+    }","+","+    public function testWrappedDataKeyStaysUnwrappableAfterTheKeyIsRotated()","+    {","+        $latestVersion = 'v1';","+        $urls = [];","+        $wrapped = [];","+        $client = new MockHttpClient(static function (string $method, string $url, array $options) use (&$latestVersion, &$urls, &$wrapped): MockResponse {","+            $urls[] = $url;","+            $version = self::addressedVersion($url, $latestVersion);","+            $value = json_decode($options['body'], true)['value'];","+","+            if (str_contains($url, '/wrapkey?')) {","+                $wrapped[$version] = $value;","+","+                return new MockResponse(json_encode(['kid' => self::VAULT.'keys/app-key/'.$version, 'value' => 'wrapped-under-'.$version]));","+            }","+","+            if ('wrapped-under-'.$version !== $value) {","+                return new MockResponse(json_encode(['error' => ['message' => 'the wrapped key was produced by another key version']]), ['http_code' => 400]);","+            }","+","+            return new MockResponse(json_encode(['value' => $wrapped[$version]]));","+        }, self::VAULT);","+","+        $kms = new AzureKeyVault($client, $this->staticToken('T'));","+        $dataKey = $kms->generateDataKey('app-key');","+        $latestVersion = 'v2';","+","+        $this->assertSame($dataKey->use(static fn (string $key): string => $key), $kms->unwrapDataKey($dataKey->wrapped)->use(static fn (string $key): string => $key));","+        $this->assertSame(self::VAULT.'keys/app-key/v1/unwrapkey?api-version=7.4', $urls[1]);","+    }","+","+    public function testTheRecordedKeyIdKeepsTheRequestedNameAndAddsTheReportedVersion()","+    {","+        $client = new MockHttpClient(new MockResponse(json_encode(['kid' => self::VAULT.'keys/App-Key/abc123', 'value' => 'ciphertext'])), self::VAULT);","+","+        $ciphertext = (new AzureKeyVault($client, $this->staticToken('T')))->encrypt('app-key', 'hello');","+","+        $this->assertSame('app-key/abc123', $ciphertext->keyId);","+    }","+","+    public function testTheRecordedKeyIdOfAPinnedRequestKeepsItsSpelling()","+    {","+        $client = new MockHttpClient(new MockResponse(json_encode(['kid' => 'https://MY-VAULT.VAULT.AZURE.NET/KEYS/APP-KEY/V1', 'value' => 'ciphertext'])), self::VAULT);","+","+        $ciphertext = (new AzureKeyVault($client, $this->staticToken('T')))->encrypt('app-key/v1', 'hello');","+","+        $this->assertSame('app-key/v1', $ciphertext->keyId);","+    }","+","+    public static function provideUnusableOperationKeyIds(): iterable","+    {","+        yield 'missing' => [null];","+        yield 'non-string' => [123];","+        yield 'versionless' => [self::VAULT.'keys/app-key'];","+        yield 'unexpected path' => [self::VAULT.'secrets/app-key/v1'];","+        yield 'extra segment' => [self::VAULT.'keys/app-key/v1/extra'];","+        yield 'malformed version' => [self::VAULT.'keys/app-key/v_1'];","+    }","+","+    #[DataProvider('provideUnusableOperationKeyIds')]","+    public function testEncryptFailsWhenAVersionlessRequestGetsNoUsableKeyId(mixed $kid)","+    {","+        $client = new MockHttpClient(new MockResponse(json_encode(['kid' => $kid, 'value' => 'ciphertext'])), self::VAULT);","+","+        $this->expectException(RuntimeException::class);","+        $this->expectExceptionMessage('Azure Key Vault did not report the version of the key it used.');","+        (new AzureKeyVault($client, $this->staticToken('T')))->encrypt('app-key', 'hello');","+    }","+","+    #[DataProvider('provideUnusableOperationKeyIds')]","+    public function testGenerateDataKeyFailsWhenAVersionlessRequestGetsNoUsableKeyId(mixed $kid)","+    {","+        $client = new MockHttpClient(new MockResponse(json_encode(['kid' => $kid, 'value' => 'wrapped'])), self::VAULT);","+","+        $this->expectException(RuntimeException::class);","+        $this->expectExceptionMessage('Azure Key Vault did not report the version of the key it used.');","+        (new AzureKeyVault($client, $this->staticToken('T')))->generateDataKey('app-key');","+    }","+","+    #[DataProvider('provideUnusableOperationKeyIds')]","+    public function testEncryptKeepsAPinnedRequestWhenItGetsNoUsableKeyId(mixed $kid)","+    {","+        $client = new MockHttpClient(new MockResponse(json_encode(['kid' => $kid, 'value' => 'ciphertext'])), self::VAULT);","+","+        $ciphertext = (new AzureKeyVault($client, $this->staticToken('T')))->encrypt('app-key/abc123', 'hello');","+","+        $this->assertSame('app-key/abc123', $ciphertext->keyId);","+    }","+","+    #[DataProvider('provideUnusableOperationKeyIds')]","+    public function testGenerateDataKeyKeepsAPinnedRequestWhenItGetsNoUsableKeyId(mixed $kid)","+    {","+        $client = new MockHttpClient(new MockResponse(json_encode(['kid' => $kid, 'value' => 'wrapped'])), self::VAULT);","+","+        $dataKey = (new AzureKeyVault($client, $this->staticToken('T')))->generateDataKey('app-key/abc123');","+","+        $this->assertSame('app-key/abc123', $dataKey->wrapped->keyId);","+    }","+","+    public static function provideMismatchedOperationKeyIds(): iterable","+    {","+        yield 'another key' => [self::VAULT.'keys/other/v1', 'app-key'];","+        yield 'another key, pinned request' => [self::VAULT.'keys/other/v1', 'app-key/v1'];","+        yield 'another version' => [self::VAULT.'keys/app-key/v2', 'app-key/v1'];","+    }","+","+    #[DataProvider('provideMismatchedOperationKeyIds')]","+    public function testEncryptRejectsAKeyIdNamingAnotherKeyOrVersion(string $kid, string $requestedKeyId)","+    {","+        $client = new MockHttpClient(new MockResponse(json_encode(['kid' => $kid, 'value' => 'ciphertext'])), self::VAULT);","+","+        $this->expectException