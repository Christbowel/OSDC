:"src/vs/server/test/node/webClientServer.test.ts","lines":["@@ -0,0 +1,182 @@","+/*---------------------------------------------------------------------------------------------","+ *  Copyright (c) Microsoft Corporation. All rights reserved.","+ *  Licensed under the MIT License. See License.txt in the project root for license information.","+ *--------------------------------------------------------------------------------------------*/","+","+import assert from 'assert';","+import { createHash } from 'crypto';","+import { promises } from 'fs';","+import { FileAccess } from '../../../base/common/network.js';","+import { htmlAttributeEncodeValue } from '../../../base/common/strings.js';","+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../base/test/common/utils.js';","+import { createNlsUrl, createScriptNonce, createWorkbenchContentSecurityPolicy, isSafeBasePath, renderWorkbenchTemplate } from '../../node/webClientServer.js';","+","+/**","+ * Decodes the five entities produced by `htmlAttributeEncodeValue`, the same way a browser","+ * does when reading a quoted attribute value back via `getAttribute()`.","+ */","+function decodeHtmlAttribute(value: string): string {","+\treturn value.replace(/&(lt|gt|quot|apos|amp);/g, (_, entity) => {","+\t\tswitch (entity) {","+\t\t\tcase 'lt': return '<';","+\t\t\tcase 'gt': return '>';","+\t\t\tcase 'quot': return '\"';","+\t\t\tcase 'apos': return '\\'';","+\t\t\tcase 'amp': return '&';","+\t\t}","+\t\treturn _;","+\t});","+}","+","+function getAttributeValue(html: string, elementId: string): string {","+\tconst match = new RegExp(`<meta id=\"${elementId}\" data-settings=\"([^\"]*)\"`).exec(html);","+\tassert.ok(match, `expected a data-settings attribute on ${elementId}`);","+\treturn match[1];","+}","+","+async function readWorkbenchTemplate(): Promise<string> {","+\tconst templatePath = FileAccess.asFileUri('vs/code/browser/workbench/workbench.html').fsPath;","+\treturn (await promises.readFile(templatePath)).toString();","+}","+","+suite('WebClientServer', () => {","+\tensureNoDisposablesAreLeakedInTestSuite();","+","+\ttest('escapes workbench template substitutions', async () => {","+\t\tconst template = await readWorkbenchTemplate();","+\t\tconst forwardedPrefix = `/'); alert(document.cookie); new URL('x`;","+\t\tconst localeUrl = `https://example.com/fr\"><script>alert(document.cookie)</script><x/nls.messages.js`;","+\t\tconst values = {","+\t\t\tWORKBENCH_WEB_CONFIGURATION: JSON.stringify({ serverBasePath: forwardedPrefix }),","+\t\t\tWORKBENCH_AUTH_SESSION: '',","+\t\t\tWORKBENCH_WEB_BASE_URL: forwardedPrefix,","+\t\t\tWORKBENCH_NLS_URL: localeUrl,","+\t\t\tWORKBENCH_NLS_FALLBACK_URL: '/static/out/nls.messages.js',","+\t\t\tWORKBENCH_SCRIPT_NONCE: createScriptNonce()","+\t\t};","+","+\t\tconst rendered = renderWorkbenchTemplate(template, values);","+","+\t\tassert.deepStrictEqual({","+\t\t\tscriptElementCount: rendered.match(/<script(?:\\s|>)/g)?.length,","+\t\t\tinlineScriptWithoutNonceCount: rendered.match(/<script(?![^>]*\\bsrc=)(?![^>]*\\bnonce=)[^>]*>/g)?.length ?? 0,","+\t\t\tcontainsRawForwardedPrefix: rendered.includes(forwardedPrefix),","+\t\t\tcontainsRawLocaleUrl: rendered.includes(localeUrl),","+\t\t\tcontainsEncodedForwardedPrefix: rendered.includes(htmlAttributeEncodeValue(forwardedPrefix)),","+\t\t\tcontainsEncodedLocaleUrl: rendered.includes(htmlAttributeEncodeValue(localeUrl))","+\t\t}, {","+\t\t\tscriptElementCount: 6,","+\t\t\tinlineScriptWithoutNonceCount: 0,","+\t\t\tcontainsRawForwardedPrefix: false,","+\t\t\tcontainsRawLocaleUrl: false,","+\t\t\tcontainsEncodedForwardedPrefix: true,","+\t\t\tcontainsEncodedLocaleUrl: true","+\t\t});","+\t});","+","+\ttest('round-trips the workbench configuration through attribute encoding', async () => {","+\t\tconst template = await readWorkbenchTemplate();","+\t\tconst configuration = {","+\t\t\tremoteAuthority: 'localhost:3000',","+\t\t\tserverBasePath: '/proxy&a=1',","+\t\t\tfolderUri: { scheme: 'vscode-remote', path: '/it\\'s/a \"folder\"/<x>' }","+\t\t};","+\t\tconst baseUrl = '/proxy&a=1/stable/static';","+","+\t\tconst rendered = renderWorkbenchTemplate(template, {","+\t\t\tWORKBENCH_WEB_CONFIGURATION: JSON.stringify(configuration),","+\t\t\tWORKBENCH_AUTH_SESSION: '',","+\t\t\tWORKBENCH_WEB_BASE_URL: baseUrl,","+\t\t\tWORKBENCH_NLS_URL: '',","+\t\t\tWORKBENCH_NLS_FALLBACK_URL: `${baseUrl}/out/nls.messages.js`,","+\t\t\tWORKBENCH_SCRIPT_NONCE: createScriptNonce()","+\t\t});","+","+\t\tassert.deepStrictEqual({","+\t\t\tconfiguration: JSON.parse(decodeHtmlAttribute(getAttributeValue(rendered, 'vscode-workbench-web-configuration'))),","+\t\t\tbaseUrl: decodeHtmlAttribute(getAttributeValue(rendered, 'vscode-workbench-web-base-url'))","+\t\t}, {","+\t\t\tconfiguration,","+\t\t\tbaseUrl","+\t\t});","+\t});","+","+\ttest('authorizes exactly the rendered inline scripts via the request nonce', async () => {","+\t\tconst template = await readWorkbenchTemplate();","+\t\tconst scriptNonce = createScriptNonce();","+","+\t\tconst rendered = renderWorkbenchTemplate(template, {","+\t\t\tWORKBENCH_WEB_CONFIGURATION: '{}',","+\t\t\tWORKBENCH_AUTH_SESSION: '',","+\t\t\tWORKBENCH_WEB_BASE_URL: '/static',","+\t\t\tWORKBENCH_NLS_URL: '',","+\t\t\tWORKBENCH_NLS_FALLBACK_URL: '/static/out/nls.messages.js',","+\t\t\tWORKBENCH_SCRIPT_NONCE: scriptNonce","+\t\t});","+\t\tconst policy = createWorkbenchContentSecurityPolicy(scriptNonce, undefined, 'localhost:3000', false);","+","+\t\tassert.deepStrictEqual({","+\t\t\trenderedNonces: [...new Set(Array.from(rendered.matchAll(/nonce=\"([^\"]*)\"/g), match => match[1]))],","+\t\t\tpolicyAuthorizesRenderedNonce: policy.includes(`'nonce-${scriptNonce}'`)","+\t\t}, {","+\t\t\trenderedNonces: [scriptNonce],","+\t\t\tpolicyAuthorizesRenderedNonce: true","+\t\t});","+\t});","+","+\ttest('uses a unique nonce without hashing rendered scripts', () => {","+\t\tconst firstNonce = createScriptNonce();","+\t\tconst secondNonce = createScriptNonce();","+\t\tconst injectedScriptHash = `'sha256-${createHash('sha256').update('alert(document.cookie)').digest('base64')}'`;","+\t\tconst policy = createWorkbenchContentSecurityPolicy(firstNonce, 'https://example.com/nls/', 'localhost:3000', false);","+","+\t\tassert.deepStrictEqual({","+\t\t\tnoncesDiffer: firstNonce !== secondNonce,","+\t\t\thasRequestNonce: policy.includes(`'nonce-${firstNonce}'`),","+\t\t\thasStaticNonce: policy.includes('nonce-1nline-m4p'),","+\t\t\thasInjectedScriptHash: policy.includes(injectedScriptHash)","+\t\t}, {","+\t\t\tnoncesDiffer: true,","+\t\t\thasRequestNonce: true,","+\t\t\thasStaticNonce: false,","+\t\t\thasInjectedScriptHash: false","+\t\t});","+\t});","+","+\ttest('encodes the locale as one NLS URL path segment', () => {","+\t\tconst locale = `fr\"><script>alert(document.cookie)</script><x`;","+","+\t\tassert.strictEqual(","+\t\t\tcreateNlsUrl('https://example.com/nls/', 'commit', '1.0.0', locale),","+\t\t\t'https://example.com/nls/commit/1.0.0/fr%22%3E%3Cscript%3Ealert(document.cookie)%3C%2Fscript%3E%3Cx/nls.messages.js'","+\t\t);","+\t});","+","+\ttest('only accepts absolute paths as a forwarded base path', () => {","+\t\tconst basePaths = [","+\t\t\t'/',","+\t\t\t'/proxy',","+\t\t\t'/user/123/vscode',","+\t\t\t'//evil.com',","+\t\t\t'/\\\\evil.com',","+\t\t\t'https://evil.com',","+\t\t\t'evil.com',","+\t\t\t'/proxy?next=https://evil.com',","+\t\t\t'/proxy#fragment',","+\t\t\t'/proxy\\r\\nLocation: https://evil.com'","+\t\t];","+","+\t\tassert.deepStrictEqual(basePaths.map(isSafeBasePath), [","+\t\t\ttrue,","+\t\t\ttrue,","+\t\t\ttrue,","+\t\t\tfalse,","+\t\t\tfalse,","+\t\t\tfalse,","+\t\t\tfalse,","+\t\t\tfalse,","+\t\t\tfalse,","+\t\t\tfalse","+\t\t]);","+\t});","+});",""],"additions":182,"deletions":0,"truncated":false}],"additions":250,"deletions":32,"truncated":false,"file_count":4},"error":null,"fetched_at":"2026-08-27T18:53:33.209172+00:00"}