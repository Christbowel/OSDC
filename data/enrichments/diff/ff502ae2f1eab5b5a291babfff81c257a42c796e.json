om the imported extension list, TER could not be asked: {reason}',","+                ['extensionKey' => $extensionKey, 'reason' => $e->getMessage(), 'exception' => $e]","+            );","+            return null;","+        }","+    }","+","+    /**","+     * A dependency may name the composer package instead of the extension key.","+     * The search filter of TER matches composer names, among others, so only","+     * an exact match counts.","+     *","+     * @throws ApiRequestFailedException","+     */","+    private function findExtensionKeyOfComposerNameOnTer(string $composerName): ?string","+    {","+        foreach ($this->terApiClient->query($composerName, 0, 1, 50)->extensions as $remoteExtension) {","+            if (strcasecmp($remoteExtension->composerName, $composerName) === 0) {","+                return $remoteExtension->key;","+            }","+        }","+        return null;","+    }","+","+    /**","+     * @param Extension[] $extensions","+     */","+    private function findVersion(array $extensions, string $version): ?Extension","+    {","+        foreach ($extensions as $extension) {","+            if ($extension->version === $version) {","+                return $extension;","+            }","+        }","+        return null;","+    }"," }"],"additions":134,"deletions":1,"truncated":false},{"path":"typo3/sysext/extensionmanager/Classes/Remote/TerApiClient.php","lines":["@@ -45,6 +45,8 @@ class TerApiClient","     private const BASE_URL = 'https://extensions.typo3.org/api/v1';","     private const UNAVAILABLE_CACHE_IDENTIFIER = 'ter_api_unavailable';","     private const UNAVAILABLE_LIFETIME = 300;","+    private const NOT_FOUND = 'not_found';","+    private const NOT_FOUND_LIFETIME = 300;"," ","     public function __construct(","         protected readonly RequestFactory $requestFactory,","@@ -138,6 +140,9 @@ protected function requestJson(string $path, array $query = []): ?array","         if (is_array($cached)) {","             return