nsionKey);","+        self::assertSame('1.0.0', $extension->version);","+        self::assertSame('ter', $extension->remote);","+        self::assertSame(str_repeat('a', 64), $extension->artifactSha256);","+        self::assertTrue($extension->resolvedFromRemote);","+    }","+","+    #[Test]","+    public function terIsPreferredOverAnOutdatedImportedList(): void","+    {","+        $this->createRemoteExtensionRecord('news', '1.0.0');","+        TerApiFake::register([","+            'news' => [","+                ['number' => '1.0.0'],","+                ['number' => '2.0.0'],","+            ],","+        ]);","+        $repository = $this->get(ExtensionRepository::class);","+","+        self::assertSame('2.0.0', $repository->findHighestAvailableVersion('news')?->version);","+        self::assertSame(['2.0.0', '1.0.0'], $this->versionsOf($repository->findByExtensionKeyOrderedByVersion('news')));","+        self::assertSame(['2.0.0'], $this->versionsOf($repository->findByVersionRangeAndExtensionKeyOrderedByVersion('news', 1000000, 0, false)));","+        self::assertNotNull($repository->findOneByExtensionKeyAndVersion('news', '2.0.0'));","+    }","+","+    #[Test]","+    public function insecureVersionsOnTerAreNotPickedForInstallationButFoundWhenAskedFor(): void","+    {","+        TerApiFake::register([","+            'news' => [","+                ['number' => '1.0.0'],","+                ['number' => '2.0.0', 'review_state' => -1],","+            ],","+        ]);","+        $repository = $this->get(ExtensionRepository::class);","+","+        self::assertSame('1.0.0', $repository->findHighestAvailableVersion('news')?->version);","+        self::assertSame(['1.0.0'], $this->versionsOf($repository->findByExtensionKeyOrderedByVersion('news')));","+        self::assertSame(['1.0.0'], $this->versionsOf($repository->findByVersionRangeAndExtensionKeyOrderedByVersion('news')));","+        self::assertSame(-1, $repository->findOneByExtensionKeyAndVersion('news', '2.0.0')?->reviewState);","+    }","+","+    #[Test]","+    public function theImportedListAnswersWhenTerCanNotBeAsked(): void","+    {","+        $this->createRemoteExtensionRecord('news', '1.0.0');","+        TerApiFake::register(['news' => [['number' => '2.0.0']]], true);","+","+        self::assertSame('1.0.0', $this->get(ExtensionRepository::class)->findHighestAvailableVersion('news')?->version);","+    }","+","+    #[Test]","+    public function terIsNotAskedInOfflineMode(): void","+    {","+        $this->createRemoteExtensionRecord('news', '1.0.0');","+        TerApiFake::register(['news' => [['number' => '2.0.0']]]);","+        $GLOBALS['TYPO3_CONF_VARS']['EXTENSIONS']['extensionmanager']['offlineMode'] = true;","+","+        self::assertSame('1.0.0', $this->get(ExtensionRepository::class)->findHighestAvailableVersion('news')?->version);","+    }","+","+    #[Test]","+    public function terIsNotAskedForAPackageOfAnotherRemote(): void","+    {","+        $this->createRemoteExtensionRecord('news', '1.0.0', ['remote' => 'mirror']);","+        TerApiFake::register(['news' => [['number' => '1.0.0']]]);","+","+        $extension = $this->get(ExtensionRepository::class)","+            ->findOneByPackageIdentifier(new PackageIdentifier('news', '1.0.0', 'mirror'));","+","+        self::assertSame('mirror', $extension?->remote);","+    }","+","+    #[Test]","+    public function aComposerNameIsResolvedThroughTer(): void","+    {","+        TerApiFake::register(","+            [","+                'content_blocks' => [['number' => '1.0.0'], ['number' => '2.0.0']],","+                'content_blocks_gui' => [['number' => '1.0.0']],","+            ],","+            false,","+            [","+                'content_blocks' => 'friendsoftypo3/content-blocks',","+                'content_blocks_gui' => 'friendsoftypo3/content-blocks-gui',","+            ]","+        );","+        $repository = $this->get(ExtensionRepository::class);","+","+        $extensions = $repository->findByExtensionKeyOrderedByVersion('friendsoftypo3/content-blocks');","+        self::assertSame(['2.0.0', '1.0.0'], $this->versionsOf($extensions));","+        self::assertSame('content_blocks', $extensions[0]->extensionKey);","+        self::assertSame(","+            ['1.0.0'],","+            $this->versionsOf($repository->findByVersionRangeAndExtensionKeyOrderedByVersion('friendsoftypo3/content-blocks', 1000000, 1999999))","+        );","+    }","+","+    #[Test]","+    public function aComposerNameTerDoesNotKnowIsResolvedFromTheImportedList(): void","+    {","+        $this->createRemoteExtensionRecord('content_blocks', '5.0.0', ['composer_name' => 'friendsoftypo3/content-blocks']);","+        TerApiFake::register(","+            ['content_blocks_gui' => [['number' => '1.0.0']]],","+            false,","+            ['content_blocks_gui' => 'friendsoftypo3/content-blocks-gui']","+        );","+","+        $extensions = $this->get(ExtensionRepository::class)","+            ->findByExtensionKeyOrderedByVersion('friendsoftypo3/content-blocks');","+","+        self::assertSame(['5.0.0'], $this->versionsOf($extensions));","+        self::assertSame('content_blocks', $extensions[0]->extensionKey);","+    }","+","     #[Test]","     public function getByPackageIdentifierThrowsExceptionForUnknownRecord(): void","     {","@@ -200,6 +336,27 @@ public function findByVersionRangeAndExtensionKeyOrderedByVersionResolvesCompose","         self::assertSame('content_blocks', $extensions[0]->extensionKey);","     }"," ","+    #[Test]","+    public function findHighestAvailableVersionResolvesComposerNameFromTheImportedList(): void","+    {","+        $this->createRemoteExtensionRecord('content_blocks', '5.0.0', ['composer_name' => 'friendsoftypo3/content-blocks']);","+","+        $extension = $this->get(ExtensionRepository::class)","+            ->findHighestAvailableVersion('friendsoftypo3/content-blocks');","+","+        self::assertSame('content_blocks', $extension?->extensionKey);","+        self::assertSame('5.0.0', $extension->version);","+    }","+","+    /**","+     * @param Extension[] $extensions","+     * @return string[]","+     */","+    private function versionsOf(array $extensions): array","+    {","+        return array_map(static fn(Extension $extension): string => $extension->version, $extensions);","+    }","+","     /**","      * @param Extension[] $extensions","      * @return string[]"],"additions":157,"deletions":0,"truncated":false},{"path":"typo3/sysext/extensionmanager/Tests/Functional/Fixtures/TerApiFake.php","lines":["@@ -0,0 +1,138 @@","+<?php","+","+declare(strict_types=1);","+","+/*","+ * This file is part of the TYPO3 CMS project.","+ *","+ * It is free software; you can redistribute it and/or modify it under","+ * the terms of the GNU General Public License, either version 2","+ * of the License, or any later version.","+ *","+ * For the full copyright and license information, please read the","+ * LICENSE.txt file that was distributed with this source code.","+ *","+ * The TYPO3 project - inspiring people to share!","+ */","+","+namespace TYPO3\\CMS\\Extensionmanager\\Tests\\Functional\\Fixtures;","+","+use GuzzleHttp\\Promise\\Create;","+use GuzzleHttp\\Psr7\\Response;","+use Psr\\Http\\Message\\RequestInterface;","+use TYPO3\\CMS\\Core\\Cache\\Backend\\TransientMemoryBackend;","+use TYPO3\\CMS\\Core\\Cache\\Frontend\\VariableFrontend;","+","+/**","+ * Answers the requests to the TER REST API from a list of extensions, as a","+ * Guzzle handler middleware, so no test talks to extensions.typo3.org.","+ *","+ * Extensions are given as key => list of versions, each version in the shape","+ * of the \"version\" schema of the API. Every other request is answered with a","+ * 404, and with $unavailable set, every request fails with a 503.","+ * $composerNames maps an extension key to its composer name, which the","+ * search filter matches, as it does the extension key.","+ */","+final class TerApiFake","+{","+    private const BASE_PATH = '/api/v1/extension';","+","+    /**","+     * @param array<string, list<array<string, mixed>>> $extensions","+     * @param array<string, string> $composerNames","+     */","+    public static function register(array $extensions, bool $unavailable = false, array $composerNames = []): void","+    {","+        $GLOBALS['TYPO3_CONF_VARS']['HTTP']['handler']['ter_api_fake'] = static fn(): \\Closure => static function (RequestInterface $request) use ($extensions, $unavailable, $composerNames) {","+            return Create::promiseFor(self::answer($request, $extensions, $unavailable, $composerNames));","+        };","+    }","+","+    /**","+     * Cache configuration for the test instance, so responses of one test are","+     * not answered from the cache in the next one.","+     */","+    public static function cacheConfiguration(): array","+    {","+        return [","+            'SYS' => [","+                'caching' => [","+                    'cacheConfigurations' => [","+                        'extensionmanager_ter_api' => [","+                            'frontend' => VariableFrontend::class,","+                            'backend' => TransientMemoryBackend::class,","+                        ],","+                    ],","+                ],","+            ],","+        ];","+    }","+","+    /**","+     * @param array<string, list<array<string, mixed>>> $extensions","+     * @param array<string, string> $composerNames","+     */","+    private static function answer(RequestInterface $request, array $extensions, bool $unavailable, array $composerNames): Response","+    {","+        if ($unavailable) {","+            return new Response(503);","+        }","+        $path = $request->getUri()->getPath();","+        if ($path === self::BASE_PATH) {","+            parse_str($request->getUri()->getQuery(), $query);","+            $search = (string)($query['filter']['search'] ?? '');","+            $found = [];","+            foreach ($extensions as $extensionKey => $versions) {","+                $composerName = $composerNames[$extensionKey] ?? '';","+                if ($search !== '' && (str_contains($extensionKey, $search) || str_contains($composerName, $search))) {","+                    $found[] = self::extension($extensionKey, self::completeVersions($versions), $composerName);","+                }","+            }","+            return self::json(['results' => count($found), 'extensions' => $found]);","+        }","+        if (!preg_match('#^' . self::BASE_PATH . '/([^/]+)(/versions)?$#', $path, $matches)) {","+            return new Response(404);","+        }","+        $versions = $extensions[rawurldecode($matches[1])] ?? null;","+        if ($versions === null) {","+            return new Response(404);","+        }","+        $versions = self::completeVersions($versions);","+        if (($matches[2] ?? '') === '/versions') {","+            return self::json([$versions]);","+        }","+        $extensionKey = rawurldecode($matches[1]);","+        return self::json([self::extension($extensionKey, $versions, $composerNames[$extensionKey] ?? '')]);","+    }","+","+    /**","+     * @param list<array<string, mixed>> $versions","+     * @return list<array<string, mixed>>","+     */","+    private static function completeVersions(array $versions): array","+    {","+        return array_map(","+            static fn(array $version): array => $version + ['review_state' => 0, 'state' => 'stable', 'category' => 'misc'],","+            $versions","+        );","+    }","+","+    /**","+     * @param list<array<string, mixed>> $versions","+     */","+    private static function extension(string $extensionKey, array $versions, string $composerName): array","+    {","+        usort($versions, static fn(array $a, array $b): int => version_compare($b['number'], $a['number']));","+        return [","+            'key' => $extensionKey,","+            'owner' => 'some-user',","+            'meta' => ['composer_name' => $composerName],","+            'current_version' => $versions[0],","+        ];","+    }","+","+    private static function json(array $data): Response","+    {","+        return new Response(200, ['Content-Type' => 'application/json'], json_encode($data, JSON_THROW_ON_ERROR));","+    }","+}"],"additions":138,"deletions":0,"truncated":false},{"path":"typo3/sysext/extensionmanager/Tests/Functional/Utility/ListUtilityTest.php","lines":["@@ -21,6 +21,7 @@"," use TYPO3\\CMS\\Core\\Database\\ConnectionPool;"," use TYPO3\\CMS\\Core\\Information\\Typo3Version;"," use TYPO3\\CMS\\Extensionmanager\\Domain\\Model\\DownloadQueue;","+use TYPO3\\CMS\\Extensionmanager\\Tests\\Functional\\Fixtures\\TerApiFake;"," use TYPO3\\CMS\\Extensionmanager\\Utility\\ListUtility;"," use TYPO3\\TestingFramework\\Core\\Functional\\FunctionalTestCase;"," ","@@ -36,6 +37,13 @@ final class ListUtilityTest extends FunctionalTestCase","         'typo3/sysext/extensionmanager/Tests/Functional/Fixtures/Extensions/deepltranslate_core',","     ];"," ","+    protected function setUp(): void","+    {","+        $this->configurationToUseInTestInstance = TerApiFake::cacheConfiguration();","+        parent::setUp();","+        TerApiFake::register([]);","+    }","+","     #[Test]","     public function getAvailableAndInstalledExtensionsReturnsExpectedResultForComplexExtensionDependencyChainConstellation(): void"],"additions":8,"deletions":0,"truncated":false}],"additions":460,"deletions":5,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-11-09T17:51:56.031102+00:00"}