rray<string, string>>                         $types              The names of the encrypted types, by key and by the type they wrap","      * @param (EnvelopeEncrypterInterface&EnvelopeDecrypterInterface)|null $automaticEnvelopes Store-backed encrypter for columns whose key is omitted","+     * @param CacheItemPoolInterface|null                                  $cache              Keeps the types of the columns whose key is omitted, by entity manager","      */","     public function __construct(","         private readonly array $types,","         private readonly (EnvelopeEncrypterInterface&EnvelopeDecrypterInterface)|null $automaticEnvelopes = null,","+        private readonly ?CacheItemPoolInterface $cache = null,","     ) {","     }"," ","@@ -81,25 +92,73 @@ public function loadClassMetadata(LoadClassMetadataEventArgs $event): void","             }","         }"," ","-        $this->registerAutomaticTypes($metadata, $event->getEntityManager());","+        $this->registerAutomaticTypes($this->automaticTypes($metadata, $event->getEntityManager()), $event->getEntityManager());","     }"," ","     /**","      * Registers automatically scoped types from resolved metadata, including cached mappings.","+     *","+     * Finding these types loads the metadata of every mapped class.","+     * With a cache, the types found are saved under the name of the entity manager, and the next calls load no metadata.","+     *","+     * The metadata is loaded with a factory of its own, so the factory of the manager stays empty.","+     * The metadata cache warmer of DoctrineBundle requires this.","+     * When a listener added after this one renamed a table or a column, the metadata cache has names that aren't the final ones.","+     * The types are then not cached, and the metadata of the manager is loaded to fix the names in it.","+     *","+     * @param string $name The name of the entity manager, which keys its types in the cache","      */","-    public function register(EntityManagerInterface $manager): void","+    public function register(EntityManagerInterface $manager, string $name = 'default'): void","     {","-        foreach ($manager->getMetadataFactory()->getAllMetadata() as $metadata) {","-            $this->registerAutomaticTypes($metadata, $manager);","+        $item = $this->cache?->getItem('automatic_types.'.hash('xxh128', $name));","+","+        if ($item?->isHit()) {","+            $this->registerAutomaticTypes($item->get(), $manager);","+","+            return;","         }","+","+        $configuration = $manager->getConfiguration();","+        $this->factory = new ($configuration->getClassMetadataFactoryName())();","+        $this->factory->setEntityManager($manager);","+        if (null !== $metadataCache = $configuration->getMetadataCache()) {","+            $this->factory->setCache($metadataCache);","+        }","+","+        $types = [];","+        $renamed = false;","+        try {","+            foreach ($this->factory->getAllMetadata() as $metadata) {","+                $types += $this->automaticTypes($metadata, $manager, $renamed);","+            }","+        } finally {","+            $this->factory = null;","+        }","+","+        if ($renamed) {","+            $types = [];","+            foreach ($manager->getMetadataFactory()->getAllMetadata() as $metadata) {","+                $types += $this->automaticTypes($metadata, $manager);","+            }","+        } elseif (null !== $item) {","+            $this->cache->save($item->set($types));","+        }","+","+        $this->registerAutomaticTypes($types, $manager);","     }"," ","-    private function registerAutomaticTypes(ClassMetadata $metadata, EntityManagerInterface $manager): void","+    /**","+     * @param bool $renamed Set to true when a column had another type name, computed before a table or a column was renamed","+     *","+     * @return array<string, array{type: string, key: string}>","+     */","+    private function automaticTypes(ClassMetadata $metadata, EntityManagerInterface $manager, bool &$renamed = false): array","     {","         if ($metadata->isMappedSuperclass || $metadata->isEmbeddedClass) {","-            return;","+            return [];","         }"," ","+        $types = [];","         foreach ($metadata->fieldMappings as $mapping) {","             $property = new \\ReflectionProperty($mapping->originalClass ?? $mapping->declared ?? $metadata->getName(), $mapping->originalField ?? $mapping->fieldName);","             $attribute = $property->getAttributes(Encrypted::class)[0] ?? null;","@@ -112,7 +171,7 @@ private function registerAutomaticTypes(ClassMetadata $metadata, EntityManagerIn","                 throw new \\LogicException(\\sprintf('The encrypted column \"%s::$%s\" omits its key and needs a data key store: configure \"key_management.store\", or set an explicit key.', $metadata->getName(), $mapping->fieldName));","             }"," ","-            $owner = $metadata->isInheritanceTypeJoined() && isset($mapping->inherited) ? $manager->getClassMetadata($mapping->inherited) : $metadata;","+            $owner = $metadata->isInheritanceTypeJoined() && isset($mapping->inherited) ? ($this->factory ?? $manager->getMetadataFactory())->getMetadataFor($mapping->inherited) : $metadata;","             $hash = hash('sha256', serialize([$owner->getSchemaName(), $owner->getTableName(), $mapping->columnName]));","             $scope = 'orm:'.$hash;","             $parent = $mapping->type;","@@ -126,8 +185,21 @@ private function registerAutomaticTypes(ClassMetadata $metadata, EntityManagerIn","             }"," ","             $name = self::AUTOMATIC_TYPE_PREFIX.base64_encode($parent).'.'.$hash;","-            (new EncryptedTypes($this->automaticEnvelopes, [$name => ['type' => $parent, 'key' => $scope]]))->register($manager->getConnection());","+            $types[$name] = ['type' => $parent, 'key' => $scope];","+            $renamed = $renamed || $name !== $mapping->type;","             $mapping->type = $name;","         }","+","+        return $types;","+    }","+","+    /**","+     * @param array<string, array{type: string, key: string}> $types","+     */","+    private function registerAutomaticTypes(array $types, EntityManagerInterface $manager): void","+    {","+        if ($types) {","+            (new EncryptedTypes($this->automaticEnvelopes, $types))->register($manager->getConnection());","+        }","     }"," }"],"additions":80,"deletions":8,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/Bridge/DoctrineOrm/README.md","lines":["@@ -82,7 +82,15 @@ Only a null key selects the automatic scope; explicit `''` and `'0'` remain expl"," Omitting the key without a store fails, since a self-contained encrypter has no default master key."," "," With DoctrineBundle, the bundle registers these automatic types after constructing each entity manager, including when metadata is cached.","-This loads all mapped metadata at manager creation when the container finds any omitted-key attribute.","+To find them, it loads the metadata of every mapped class once, and keeps the types in the `cache.key_management.encrypted_columns` pool, a child of `cache.system`.","+The next entity managers register the types from that pool and load no metadata.","+In debug mode, the bundle doesn't define that pool, so that a change to the mapping is seen without clearing the cache.","+The metadata is loaded with a metadata factory of its own, so the factory of the entity manager stays empty.","+The metadata cache warmer of DoctrineBundle requires this.","+","+The listener runs after the other `loadClassMetadata` listeners, so it computes each scope from the final table and column names.","+When a listener that runs later still renames a table or a column, the types aren't cached.","+Each entity manager then loads all the metadata again, to fix the names in it."," Applications using only explicit keys keep registration at connection creation."," The connection's type provider must be a writable `TypeRegistry`."," Generated automatic type names use an internal namespace, `key_management_auto_v1_<base64-parent>.<64-hex-hash>`.","@@ -91,12 +99,17 @@ Don't use that full name format for your own parent aliases."," Without DoctrineBundle, give the listener a store-backed encrypter and register after constructing the manager:"," "," ```php","-$listener = new EncryptedColumnListener($explicitTypes, $storedEnvelopeEncrypter);","+$listener = new EncryptedColumnListener($explicitTypes, $storedEnvelopeEncrypter, $cache);"," $eventManager->addEventListener(Events::loadClassMetadata, $listener);"," $entityManager = new EntityManager($connection, $configuration, $eventManager);","-$listener->register($entityManager);","+$listener->register($entityManager, 'default');"," ```"," ","+`register()` loads the metadata of every mapped class to find the types.","+With a cache, it does so once and saves the types under the name of the entity manager, `default` here.","+Clear that cache when the mapping changes, like the metadata cache.","+Add the listener after the listeners that rename tables or columns.","+"," In a Symfony application, the `KeyManagementBundle` registers explicit-key types when DoctrineBundle creates a connection."," When the container is compiled, the bundle finds the `#[Encrypted]` columns and collects one type per explicit key and type."," It looks for these columns in the entities, embeddables and mapped superclasses found in the `resource` directories of your services."],"additions":16,"deletions":3,"truncated":false},{"path":"src/Symfony/Component/KeyManagement/Bridge/DoctrineOrm/Tests/AutomaticEncryptedColumnTest.php","lines":["@@ -330,6 +330,104 @@ public function convertToPHPValue(mixed $value, AbstractPlatform $platform): mix","         $reader->find(AutomaticRecord::class, 1);","     }"," ","+    #[TestWith([false], 'global registry')]","+    #[TestWith([true], 'connection registry')]","+    public function testCachedTypesAreRegisteredWithoutLoadingMetadata(bool $connectionRegistry)","+    {","+        if ($connectionRegistry && !method_exists($this->connection->getConfiguration(), 'setTypeProvider')) {","+            $this->markTestSkipped('doctrine/dbal < 4.6 cannot replace the type provider of a connection.');","+        }","+","+        $metadataCache = new ArrayAdapter(0, true);","+        $queryCache = new ArrayAdapter(0, true);","+        $typesCache = new ArrayAdapter(0, true);","+        $dql = 'SELECT r.first FROM '.AutomaticRecord::class.' r';","+        $manager = $this->manager([AutomaticRecord::class], $metadataCache, null, new EncryptedColumnListener([], new StoredEnvelopeEncrypter($this->store), $typesCache));","+        $manager->getConfiguration()->setQueryCache($queryCache);","+        $metadata = $manager->getClassMetadata(AutomaticRecord::class);","+        (new SchemaTool($manager))->createSchema([$metadata]);","+        $record = new AutomaticRecord();","+        $record->first = 'first secret';","+        $manager->persist($record);","+        $manager->flush();","+        $this->assertSame([['first' => 'first secret']], $manager->createQuery($dql)->getArrayResult());","+        if ($connectionRegistry) {","+            $this->connection->getConfiguration()->setTypeProvider(new TypeRegistry());","+        } else {","+            $this->registry()->override($metadata->getTypeOfField('first'), new StringType());","+        }","+        $this->store->forget();","+","+        $reader = $this->manager([AutomaticRecord::class], $metadataCache, null, new EncryptedColumnListener([], new StoredEnvelopeEncrypter($this->store), $typesCache), true);","+        $reader->getConfiguration()->setQueryCache($queryCache);","+","+        $this->assertSame([], $reader->getMetadataFactory()->getLoadedMetadata());","+        $this->assertSame([['first' => 'first secret']], $reader->createQuery($dql)->getArrayResult());","+        $this->assertSame([], $reader->getMetadataFactory()->getLoadedMetadata());","+        $this->assertSame('first secret', $reader->find(AutomaticRecord::class, 1)->first);","+    }","+","+    #[TestWith([false], 'without a types cache')]","+    #[TestWith([true], 'with a types cache')]","+    public function testFindingTheTypesLeavesTheMetadataOfTheManagerUnloaded(bool $typesCache)","+    {","+        $listener = new EncryptedColumnListener([], new StoredEnvelopeEncrypter($this->store), $typesCache ? new ArrayAdapter(0, true) : null);","+        $manager = $this->manager([JoinedRecord::class, JoinedChild::class], new ArrayAdapter(0, true), null, $listener);","+","+        $this->assertSame([], $manager->getMetadataFactory()->getLoadedMetadata());","+","+        (new SchemaTool($manager))->createSchema([$manager->getClassMetadata(JoinedRecord::class), $manager->getClassMetadata(JoinedChild::class)]);","+        $record = new JoinedChild();","+        $record->rootValue = 'root secret';","+        $record->childValue = 'child secret';","+        $manager->persist($record);","+        $manager->flush();","+        $manager->clear();","+        $read = $manager->find(JoinedChild::class, 1);","+","+        $this->assertSame('root secret', $read->rootValue);","+        $this->assertSame('child secret', $read->childValue);","+    }","+","+    public function testAListenerRenamingColumnsAfterThisOneKeepsValuesReadableFromWarmCaches()","+    {","+        $metadataCache = new ArrayAdapter(0, true);","+        $typesCache = new ArrayAdapter(0, true);","+        $writer = $this->renamingManager($metadataCache, $typesCache, false);","+        (new SchemaTool($writer))->createSchema([$writer->getClassMetadata(AutomaticRecord::class)]);","+        $record = new AutomaticRecord();","+        $record->first = 'first secret';","+        $record->second = 'second secret';","+        $writer->persist($record);","+        $writer->flush();","+        $this->store->forget();","+","+        $reader = $this->renamingManager($metadataCache, $typesCache, false);","+","+        $this->assertSame('first secret', $reader->find(AutomaticRecord::class, 1)->first);","+        $this->assertSame('second secret', $this->manager([MutatedRecord::class])->find(MutatedRecord::class, 1)->second);","+    }","+","+    public function testAListenerRenamingColumnsBeforeThisOneLetsTheTypesBeCached()","+    {","+        $metadataCache = new ArrayAdapter(0, true);","+        $typesCache = new ArrayAdapter(0, true);","+        $writer = $this->renamingManager($metadataCache, $typesCache, true);","+        (new SchemaTool($writer))->createSchema([$writer->getClassMetadata(AutomaticRecord::class)]);","+        $record = new AutomaticRecord();","+        $record->first = 'first secret';","+        $record->second = 'second secret';","+        $writer->persist($record);","+        $writer->flush();","+        $this->store->forget();","+","+        $reader = $this->renamingManager($metadataCache, $typesCache, true);","+","+        $this->assertSame([], $reader->getMetadataFactory()->getLoadedMetadata());","+        $this->assertSame('first secret', $reader->find(AutomaticRecord::class, 1)->first);","+        $this->assertSame('second secret', $this->manager([MutatedRecord::class])->find(MutatedRecord::class, 1)->second);","+    }","+","     public function testOmittingTheKeyWithoutAStoreExplainsTheMissingConfiguration()","     {","         $this->expectException(\\LogicException::class);","@@ -427,7 +525,7 @@ public function testTheConfiguratorRunsThePreviousCallbackBeforeRegisteringTypes","         $events->addEventListener(Events::loadClassMetadata, $listener);","         $manager = new EntityManager($this->connection, $this->configuration([AutomaticRecord::class]), $events);","         $called = false;","-        $configure = new ConfigureEncryptedColumns($listener, function (EntityManagerInterface $configured) use ($manager, &$called): void {","+        $configure = new ConfigureEncryptedColumns($listener, 'default', function