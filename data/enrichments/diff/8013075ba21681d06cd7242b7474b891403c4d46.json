agement', ['clients' => ['app' => 'sodium://?keys[app]=AAAA']]);","+        });","+","+        $pool = $container->getDefinition('cache.key_management.encrypted_columns');","+        $this->assertInstanceOf(ChildDefinition::class, $pool);","+        $this->assertSame('cache.system', $pool->getParent());","+        $this->assertTrue($pool->hasTag('cache.pool'));","+","+        $container = $this->createContainerFromClosure(static function (ContainerBuilder $container) {","+            $container->loadFromExtension('key_management', ['clients' => ['app' => 'sodium://?keys[app]=AAAA']]);","+        });","+","+        $this->assertFalse($container->hasDefinition('cache.key_management.encrypted_columns'));","+    }","+","+    public function testTheTypesOfAutomaticColumnsAreNotCachedInDebugMode()","+    {","+        if (!class_exists(EncryptedColumnListener::class)) {"],"additions":27,"deletions":1,"truncated":false}],"additions":278,"deletions":21,"truncated":true,"file_count":10},"error":null,"fetched_at":"2026-10-26T14:32:21.126318+00:00"}