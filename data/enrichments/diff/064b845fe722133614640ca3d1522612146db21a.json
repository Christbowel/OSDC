rializer/serialization_traits.hpp\""," #include \"duckdb/common/identifier.hpp\"","@@ -28,6 +30,10 @@ class Deserializer {"," \tbool deserialize_enum_from_string = false;"," \tSerializationData data;"," ","+private:","+\t//! Without a policy, no identifiers are blocked.","+\toptional<DeserializationPolicy> policy;","+"," public:"," \tvirtual ~Deserializer() {"," \t}","@@ -57,6 +63,18 @@ class Deserializer {"," public:"," \tvirtual bool CanDeserializeProperty(const field_id_t field_id, const char *tag) = 0;"," ","+\tvoid SetPolicy(const DeserializationPolicy &policy_p) {","+\t\tpolicy = policy_p;","+\t}","+","+\t//! Reject identifiers disallowed by the active policy.","+\ttemplate <class T>","+\tvoid CheckAllowed(T value) const {","+\t\tif (policy && !policy->IsAllowed(value)) {","+\t\t\tthrow SerializationException(\"Deserialization of %s is not allowed\", EnumUtil::ToString(value));","+\t\t}","+\t}","+"," \t// Read into an existing value"," \ttemplate <typename T>"," \tinline void ReadProperty(const field_id_t field_id, const char *tag, T &ret) {"],"additions":18,"deletions":0,"truncated":false},{"path":"src/include/duckdb/storage/serialization/nodes.json","lines":["@@ -1344,6 +1344,9 @@","     \"methods\": {","       \"Verify\": []","     },","+    \"finalize_deserialization\": [","+      \"deserializer.CheckAllowed(result.kind);\"","+    ],","     \"pointer_type\": \"none\"","   },","   {"],"additions":3,"deletions":0,"truncated":false},{"path":"src/storage/serialization/serialize_nodes.cpp","lines":["@@ -436,6 +436,7 @@ Literal Literal::Deserialize(Deserializer &deserializer) {"," \tdeserializer.ReadProperty<LiteralKind>(100, \"kind\", result.kind);"," \tdeserializer.ReadPropertyWithDefault<string>(101, \"text\", result.text);"," \tresult.Verify();","+\tdeserializer.CheckAllowed(result.kind);"," \treturn result;"," }"," "],"additions":1,"deletions":0,"truncated":false},{"path":"test/sql/json/test_json_deserialize_pointer.test","lines":["@@ -0,0 +1,68 @@","+# name: test/sql/json/test_json_deserialize_pointer.test","+# description: Serialized SQL cannot introduce process-local pointers","+# group: [json]","+","+require json","+","+statement ok","+CREATE MACRO pointer_sql(representation) AS","+    '{\"error\":false,\"statements\":[{\"node\":{\"type\":\"SELECT_NODE\",\"cte_map\":{},\"select_list\":[{\"class\":\"CONSTANT\",\"type\":\"VALUE_CONSTANT\",' ||","+    CASE representation","+        WHEN 'literal' THEN '\"literal\":{\"kind\":\"POINTER\",\"text\":\"0x2a\"}'","+        ELSE '\"value\":{\"type\":{\"id\":\"POINTER\"},\"is_null\":false,\"value\":42}'","+    END ||","+    '}],\"aggregate_handling\":\"STANDARD_HANDLING\"}}]}';","+","+# Both constant representations are rejected by the scalar and table functions","+foreach representation literal value","+","+statement error","+SELECT json_deserialize_sql(pointer_sql('{representation}'));","+----","+Deserialization of POINTER is not allowed","+","+statement error","+SELECT * FROM json_execute_serialized_sql(pointer_sql('{representation}'));","+----","+Deserialization of POINTER is not allowed","+","+endloop","+","+# The pragma uses the same restriction","+statement error","+PRAGMA json_execute_serialized_sql('{\"error\":false,\"statements\":[{\"node\":{\"type\":\"SELECT_NODE\",\"cte_map\":{},\"select_list\":[{\"class\":\"CONSTANT\",\"type\":\"VALUE_CONSTANT\",\"literal\":{\"kind\":\"POINTER\",\"text\":\"0x2a\"}}],\"aggregate_handling\":\"STANDARD_HANDLING\"}}]}');","+----","+Deserialization of POINTER is not allowed","+","+statement error","+PRAGMA json_execute_serialized_sql('{\"error\":false,\"statements\":[{\"node\":{\"type\":\"SELECT_NODE\",\"cte_map\":{},\"select_list\":[{\"class\":\"CONSTANT\",\"type\":\"VALUE_CONSTANT\",\"value\":{\"type\":{\"id\":\"POINTER\"},\"is_null\":false,\"value\":42}}],\"aggregate_handling\":\"STANDARD_HANDLING\"}}]}');","+----","+Deserialization of POINTER is not allowed","+","+# Nested literals and legacy values must also be rejected","+statement error","+SELECT json_deserialize_sql('{\"error\":false,\"statements\":[{\"node\":{\"type\":\"SELECT_NODE\",\"cte_map\":{},\"select_list\":[{\"class\":\"OPERATOR\",\"type\":\"OPERATOR_IS_NULL\",\"children\":[{\"class\":\"CONSTANT\",\"type\":\"VALUE_CONSTANT\",\"literal\":{\"kind\":\"POINTER\",\"text\":\"0x2a\"}}]}],\"aggregate_handling\":\"STANDARD_HANDLING\"}}]}');","+----","+Deserialization of POINTER is not allowed","+","+statement error","+SELECT json_deserialize_sql('{\"error\":false,\"statements\":[{\"node\":{\"type\":\"SELECT_NODE\",\"cte_map\":{},\"select_list\":[{\"class\":\"CONSTANT\",\"type\":\"VALUE_CONSTANT\",\"value\":{\"type\":{\"id\":\"LIST\",\"type_info\":{\"type\":\"LIST_TYPE_INFO\",\"child_type\":{\"id\":\"ANY\"}}},\"is_null\":false,\"value\":{\"children\":[{\"type\":{\"id\":\"POINTER\"},\"is_null\":false,\"value\":42}]}}}],\"aggregate_handling\":\"STANDARD_HANDLING\"}}]}');","+----","+Deserialization of POINTER is not allowed","+","+# Reject pointer types even when the value is NULL or the container is empty","+statement error","+SELECT json_deserialize_sql('{\"error\":false,\"statements\":[{\"node\":{\"type\":\"SELECT_NODE\",\"cte_map\":{},\"select_list\":[{\"class\":\"CONSTANT\",\"type\":\"VALUE_CONSTANT\",\"value\":{\"type\":{\"id\":\"POINTER\"},\"is_null\":true}}],\"aggregate_handling\":\"STANDARD_HANDLING\"}}]}');","+----","+Deserialization of POINTER is not allowed","+","+statement error","+SELECT json_deserialize_sql('{\"error\":false,\"statements\":[{\"node\":{\"type\":\"SELECT_NODE\",\"cte_map\":{},\"select_list\":[{\"class\":\"CONSTANT\",\"type\":\"VALUE_CONSTANT\",\"value\":{\"type\":{\"id\":\"LIST\",\"type_info\":{\"type\":\"LIST_TYPE_INFO\",\"child_type\":{\"id\":\"POINTER\"}}},\"is_null\":false,\"value\":{\"children\":[]}}}],\"aggregate_handling\":\"STANDARD_HANDLING\"}}]}');","+----","+Deserialization of POINTER is not allowed","+","+# Ordinary constants and strings that mention pointers are unaffected","+query IT","+SELECT * FROM json_execute_serialized_sql(json_serialize_sql('SELECT 42, ''POINTER 0x2a'''));","+----","+42\tPOINTER 0x2a",""],"additions":68,"deletions":0,"truncated":false}],"additions":143,"deletions":0,"truncated":false,"file_count":7},"error":null,"fetched_at":"2026-11-06T17:02:16.328234+00:00"}