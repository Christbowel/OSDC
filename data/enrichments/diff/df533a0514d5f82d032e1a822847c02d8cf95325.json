   return git(['ls-tree', '-r', '--name-only', '-z', 'main'], repo)","+        .split('\\0')","+        .filter(Boolean);","+    }","+","+    it('moves files into the destination', () => {","+      mkdirSync(join(repo, 'src'));","+      writeFileSync(join(repo, 'src/index.ts'), 'index');","+      writeFileSync(join(repo, 'README.md'), 'readme');","+      git(['add', '-A'], repo);","+      git(['commit', '-m', 'initial'], repo);","+","+      filter('', 'libs/inventory');","+","+      expect(trackedFiles().sort()).toEqual([","+        'libs/inventory/README.md',","+        'libs/inventory/src/index.ts',","+      ]);","+    });","+","+    it('moves a sub-directory into the destination', () => {","+      mkdirSync(join(repo, 'packages/a/src'), { recursive: true });","+      writeFileSync(join(repo, 'packages/a/src/index.ts'), 'a');","+      git(['add', '-A'], repo);","+      git(['commit', '-m', 'initial'], repo);","+","+      filter('packages/a', 'libs/a');","+","+      expect(trackedFiles()).toEqual(['libs/a/src/index.ts']);","+    });","+","+    it('moves a sub-directory to the repository root', () => {","+      mkdirSync(join(repo, 'packages/a/src'), { recursive: true });","+      writeFileSync(join(repo, 'packages/a/src/index.ts'), 'a');","+      writeFileSync(join(repo, 'packages/a/package.json'), '{}');","+      git(['add', '-A'], repo);","+      git(['commit', '-m', 'initial'], repo);","+","+      filter('packages/a', '');","+","+      expect(trackedFiles().sort()).toEqual(['package.json', 'src/index.ts']);","+    });","+","+    it('moves a source path that was a file in an earlier commit', () => {","+      mkdirSync(join(repo, 'packages'));","+      writeFileSync(join(repo, 'packages/a'), 'file');","+      git(['add', '-A'], repo);","+      git(['commit', '-m', 'file'], repo);","+      rmSync(join(repo, 'packages/a'));","+      mkdirSync(join(repo, 'packages/a'));","+      writeFileSync(join(repo, 'packages/a/index.ts'), 'a');","+      git(['add', '-A'], repo);