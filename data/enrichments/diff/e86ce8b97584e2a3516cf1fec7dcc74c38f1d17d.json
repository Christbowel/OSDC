  return true;","+    default:","+      return false;","+  }","+}","+","+std::optional<size_t> GetEncodedRdnCount(const X509_NAME* name) {","+  const unsigned char* der = nullptr;","+  size_t der_length = 0;","+  if (X509_NAME_get0_der(name, &der, &der_length) != 1 || der == nullptr ||","+      der_length > static_cast<size_t>(LONG_MAX)) {","+    return std::nullopt;","+  }","+","+  const unsigned char* cursor = der;","+  ASN1SequencePointer rdns(d2i_ASN1_SEQUENCE_ANY(","+      nullptr, &cursor, static_cast<long>(der_length)));  // NOLINT(runtime/int)","+  if (!rdns || cursor != der + der_length) return std::nullopt;","+","+  const OPENSSL_SIZE_T count = sk_ASN1_TYPE_num(rdns.get());","+  for (OPENSSL_SIZE_T i = 0; i < count; i++) {","+    const ASN1_TYPE* rdn = sk_ASN1_TYPE_value(rdns.get(), i);","+    if (rdn == nullptr || ASN1_TYPE_get(rdn) != V_ASN1_SET) {","+      return std::nullopt;","+    }","+  }","+  return static_cast<size_t>(count);","+}","+","+std::optional<X509NameInspection> InspectName(const X509_NAME* name) {","+  if (name == nullptr) return std::nullopt;","+  const int count = X509_NAME_entry_count(name);","+  if (count < 0) return std::nullopt;","+  const auto encoded_rdn_count = GetEncodedRdnCount(name);","+  if (!encoded_rdn_count.has_value()) return std::nullopt;","+","+  X509NameInspection output;","+  output.reserve(static_cast<size_t>(count));","+  int previous_set = -1;","+  for (int i = 0; i < count; i++) {","+    const X509_NAME_ENTRY* entry = X509_NAME_get_entry(name, i);","+    if (entry == nullptr) return std::nullopt;","+","+    const ASN1_OBJECT* object = X509_NAME_ENTRY_get_object(entry);","+    const ASN1_STRING* value = X509_NAME_ENTRY_get_data(entry);","+    auto oid = ObjectToText(object, true);","+    const int set = X509_NAME_ENTRY_set(entry);","+    if (!oid.has_value() || value == nullptr || set < 0 ||","+        (set != previous_set &&","+         (previous_set == INT_MAX || set != previous_set + 1))) {","+      return std::nullopt;","+    }","+    previous_set = set;","+","+    X509NameAttribute attribute{","+        .set = set,","+        .oid = std::move(oid.value()),","+    };","+    if (CanConvertNameValueToUtf8(value)) {","+      unsigned char* data = nullptr;","+      const int length = ASN1_STRING_to_UTF8(&data, value);","+      DataPointer owned(data, length > 0 ? static_cast<size_t>(length) : 0);","+      if (length < 0 || (length > 0 && !owned)) return std::nullopt;","+      attribute.value =","+          length == 0 ? std::string()","+                      : std::string(reinterpret_cast<const char*>(owned.get()),","+                                    static_cast<size_t>(length));","+    }","+    output.push_back(std::move(attribute));","+  }","+  const size_t inspected_rdn_count =","+      previous_set < 0 ? 0 : static_cast<size_t>(previous_set) + 1;","+  if (inspected_rdn_count != encoded_rdn_count.value()) return std::nullopt;","+  return output;","+}","+","+std::optional<std::vector<X509RawExtension>> InspectExtensions(","+    const X509* certificate) {","+  if (certificate == nullptr) return std::nullopt;","+  const int count = X509_get_ext_count(certificate);","+  if (count < 0) return std::nullopt;","+","+  std::vector<X509RawExtension> output;","+  output.reserve(static_cast<size_t>(count));","+  for (int i = 0; i < count; i++) {","+    const X509_EXTENSION* extension = X509_get_ext(certificate, i);","+    if (extension == nullptr) return std::nullopt;","+","+    auto* mutable_extension = const_cast<X509_EXTENSION*>(extension);","+    auto oid = ObjectToText(X509_EXTENSION_get_object(mutable_extension), true);","+    const ASN1_OCTET_STRING* value = X509_EXTENSION_get_data(mutable_extension);","+    if (!oid.has_value() || value == nullptr) return std::nullopt;","+","+    X509RawExtension inspected{","+        .oid = std::move(oid.value()),","+        .critical = X509_EXTENSION_get_critical(mutable_extension) != 0,","+    };","+    if (!CopyStringBytes(value, &inspected.value)) return std::nullopt;","+    output.push_back(std::move(inspected));","+  }","+  return output;","+}","+}  // namespace","+","+std::optional<int64_t> X509View::getVersion() const {","+  MarkPopErrorOnReturn mark_pop_error_on_return;","+  if (cert_ == nullptr) return std::nullopt;","+  const long version = X509_get_version(cert_);  // NOLINT(runtime/int)","+  if (version < 0 || version > 2) return std::nullopt;","+  return static_cast<int64_t>(version) + 1;","+}","+","+std::optional<X509NameInspection> X509View::inspectSubjectName() const {","+  MarkPopErrorOnReturn mark_pop_error_on_return;","+  if (cert_ == nullptr) return std::nullopt;","+  return InspectName(X509_get_subject_name(cert_));","+}","+","+std::optional<X509NameInspection> X509View::inspectIssuerName() const {","+  MarkPopErrorOnReturn mark_pop_error_on_return;","+  if (cert_ == nullptr) return std::nullopt;","+  return InspectName(X509_get_issuer_name(cert_));","+}","+","+std::optional<std::vector<X509RawExtension>> X509View::inspectExtensions()","+    const {","+  MarkPopErrorOnReturn mark_pop_error_on_return;","+  return InspectExtensions(cert_);","+}","+"," bool X509View::isIssuedBy(const X509View& issuer) const {","   MarkPopErrorOnReturn mark_pop_error_on_return;","   if (cert_ == nullptr || issuer.cert_ == nullptr) return false;"],"additions":167,"deletions":0,"truncated":false},{"path":"deps/ncrypto/ncrypto.h","lines":["@@ -61,6 +61,15 @@"," "," #define NCRYPTO_USE_LEGACY_KEY_TYPES NCRYPTO_USE_BORINGSSL"," ","+// OpenSSL 4 makes ASN1_STRING opaque and provides a checked BIT STRING length","+// accessor. Earlier OpenSSL releases and pinned BoringSSL expose the decoded","+// unused-bit count through ASN1_STRING::flags.","+#if !NCRYPTO_USE_BORINGSSL && OPENSSL_VERSION_PREREQ(4, 0)","+#define NCRYPTO_HAS_ASN1_BIT_STRING_GET_LENGTH 1","+#else","+#define NCRYPTO_HAS_ASN1_BIT_STRING_GET_LENGTH 0","+#endif","+"," #if NCRYPTO_USE_OPENSSL_PROVIDER"," #include <openssl/core_names.h>"," #include <openssl/encoder.h>","@@ -1648,6 +1657,20 @@ class X509Name final {","   int total_;"," };"," ","+struct X509NameAttribute final {","+  int set = 0;","+  std::string oid;","+  std::optional<std::string> value;","+};","+","+using X509NameInspection = std::vector<X509NameAttribute>;","+","+struct X509RawExtension final {","+  std::string oid;","+  bool critical = false;","+  std::vector<unsigned char> value;","+};","+"," class X509View final {","  public:","   static X509View From(const SSLPointer& ssl);","@@ -1685,6 +1708,11 @@ class X509View final {","   Result<EVPKeyPointer, int> getPublicKey() const;","   StackOfASN1 getKeyUsage() const;"," ","+  std::optional<int64_t> getVersion() const;","+  std::optional<X509NameInspection> inspectSubjectName() const;","+  std::optional<X509NameInspection> inspectIssuerName() const;","+  std::optional<std::vector<X509RawExtension>> inspectExtensions() const;","+","   bool isCA() const;","   bool isIssuedBy(const X509View& other) const;","   bool checkPrivateKey(const EVPKeyPointer& pkey) const;"],"additions":28,"deletions":0,"truncated":false},{"path":"doc/api/crypto.md","lines":["@@ -3152,6 +3152,47 @@ added: v15.6.0"," Checks whether the public key for this certificate is consistent with"," the given private key."," ","+### `x509.extensions`","+","+<!-- YAML","+added: REPLACEME","+-->","+","+* Type: {Object\\[]}","+  * `oid` {string} The canonical dotted-decimal extension OID.","+  * `critical` {boolean} Whether the extension is critical.","+  * `value` {Buffer} The bytes contained in the extension's `extnValue` OCTET","+    STRING. The OCTET STRING tag and length are not included.","+","+One entry is returned for every extension, in the order in which it appears in","+the certificate. Unknown extensions and repeated OIDs are included. The","+contents of `value` are not decoded according to `oid`. A certificate with no","+extensions produces an empty array.","+","+Unlike [`x509.subjectAltName`][], [`x509.infoAccess`][], and","+[`x509.keyUsage`][] (Extended Key Usage), which decode or format selected","+extension types, this property exposes raw extension contents. `value` contains","+the exact extension value bytes, not a complete encoded `Extension` record.","+The extension-specific syntax is not validated.","+","+Each access returns a new array containing new objects and `Buffer`s. Modifying","+them does not affect the certificate or later accesses.","+","+For example, a Basic Constraints extension allowing a certificate to act as a","+CA can appear as:","+","+```js","+console.log(x509.extensions[0]);","+// {","+//   oid: '2.5.29.19',","+//   critical: true,","+//   value: <Buffer 30 03 01 01 ff>","+// }","+```","+","+Accessing this property throws `ERR_CRYPTO_INVALID_X509_CERTIFICATE` if the","+extensions cannot be inspected.","+"," ### `x509.fingerprint`"," "," <!-- YAML","@@ -3243,6 +3284,46 @@ added: v15.9.0"," The issuer certificate or `undefined` if the issuer certificate is not"," available."," ","+### `x509.issuerName`","+","+<!-- YAML","+added: REPLACEME","+-->","+","+* Type: {Object}","+  * `raw` {Buffer} The complete DER-encoded `Name`.","+  * `rdns` {Array\\<Object\\[]>} The relative distinguished name sequence.","+    * `oid` {string} The canonical dotted-decimal object identifier.","+    * `value` {string} A UTF-8 representation of the attribute value. This","+      property is omitted when the ASN.1 value type is not supported for text","+      conversion.","+","+The issuer distinguished name, also exposed as a formatted string by","+[`x509.issuer`][]. The outer `rdns` array contains the relative distinguished","+names in encoded order. Each inner array represents one relative distinguished","+name and contains its attributes in encoded order. A valid empty name has an","+empty `rdns` array.","+","+`rdns` is a decoded view and does not include ASN.1 value types. Use `raw` for a","+lossless representation of the complete name, including attribute values whose","+`value` property is omitted from `rdns`.","+","+Each access returns newly allocated objects, arrays, and a `Buffer`.","+Modifying them does not affect the certificate or later accesses.","+","+For example:","+","+```js","+console.log(x509.issuerName.rdns);","+// [","+//   [ { oid: '2.5.4.6', value: 'US' } ],","+//   [ { oid: '2.5.4.10', value: 'Example CA' } ]","+// ]","+```","+","+Accessing this property throws `ERR_CRYPTO_INVALID_X509_CERTIFICATE` if the","+issuer name cannot be inspected.","+"," ### `x509.keyUsage`"," "," <!-- YAML","@@ -3329,6 +3410,70 @@ For backward compatibility, Node.js only uses JSON string literals within this"," property when necessary to avoid ambiguity. Third-party code should be prepared"," to handle both possible entry formats."," ","+### `x509.subjectName`","+","+<!-- YAML","+added: REPLACEME","+-->","+","+* Type: {Object}","+  * `raw` {Buffer} The complete DER-encoded `Name`.","+  * `rdns` {Array\\<Object\\[]>} The relative distinguished name sequence.","+    * `oid` {string} The canonical dotted-decimal object identifier.","+    * `value` {string} A UTF-8 representation of the attribute value. This","+      property is omitted when the ASN.1 value type is not supported for text","+      conversion.","+","+The subject distinguished name, also exposed as a formatted string by","+[`x509.subject`][]. The outer `rdns` array contains the relative distinguished","+names in encoded order. Each inner array represents one relative distinguished","+name and contains its attributes in encoded order. A valid empty name has an","+empty `rdns` array.","+","+`rdns` is a decoded view and does not include ASN.1 value types. Use `raw` for a","+lossless representation of the complete name, including attribute values whose","+`value` property is omitted from `rdns`.","+","+Each access returns newly allocated objects, arrays, and a `Buffer`.","+Modifying them does not affect the certificate or later accesses.","+","+For example, attributes in the same inner array belong to one multi-valued","+relative distinguished name:","+","+```js","+console.log(x509.subjectName.rdns);","+// [","+//   [ { oid: '2.5.4.6', value: 'US' } ],","+//   [","+//     { oid: '2.5.4.11', value: 'Security' },","+//     { oid: '2.5.4.10', value: 'Example Corp' }","+//   ],","+//   [ { oid: '2.5.4.3', value: 'example.com' } ]","+// ]","+```","+","+Accessing this property throws `ERR_CRYPTO_INVALID_X509_CERTIFICATE` if the","+subject name cannot be inspected.","+","+### `x509.tbs`","+","+<!-- YAML","+added: REPLACEME","+-->","+","+* Type: {Buffer}","+","+Unlike [`x509.raw`][], which contains the whole certificate, this property","+contains only the complete encoded `TBSCertificate`: the exact bytes covered","+by the certificate's signature. They are copied from the certificate encoding,","+not reconstructed from decoded fields.","+","+Each access returns a new `Buffer`. Modifying it does not affect the certificate","+or later accesses.","+","+Accessing this property throws `ERR_CRYPTO_INVALID_X509_CERTIFICATE` if the","+`TBSCertificate` cannot be inspected.","+"," ### `x509.toJSON()`"," "," <!-- YAML","@@ -3406,6 +3551,50 @@ added:"," "," The date/time until which this certificate is valid, encapsulated in a `Date` object."," ","+### `x509.signature`","+","+<!-- YAML","+added: REPLACEME","+-->","+","+* Type: {Object}","+  * `algorithm` {Object} The certificate-level `signatureAlgorithm` paired with","+    the `signatureValue`.","+    * `oid` {string} The canonical dotted-decimal algorithm OID.","+    * `parameters` {Buffer} The complete DER-encoded ASN.1 parameters. This","+      property is omitted when the parameters are absent.","+  * `value` {Buffer} The signature octets contained in the certificate's","+    `signatureValue` BIT STRING.","+","+`algorithm.oid` identifies the same certificate-level algorithm as","+[`x509.signatureAlgorithmOid`][]. In addition to the algorithm identification","+provided by that property and [`x509.signatureAlgorithm`][], this property","+exposes the algorithm parameters and signature bytes.","+","+The parameters are DER-encoded independently; the complete encoded","+`AlgorithmIdentifier` and BIT STRING wrappers are not returned. Accessing this","+property does not verify the signature.","+","+Each access returns new outer and `algorithm` objects, with new `Buffer`s for","+`value` and `parameters` when present. Modifying them does not affect the","+certificate or later accesses.","+","+For example, a certificate signed using RSA with SHA-256 can produce:","+","+```js","+console.log(x509.signature);","+// {","+//   algorithm: {","+//     oid: '1.2.840.113549.1.1.11',","+//     parameters: <Buffer 05 00>","+//   },","+//   value: <Buffer ...>","+// }","+```","+","+Accessing this property throws `ERR_CRYPTO_INVALID_X509_CERTIFICATE` if the","+signature cannot be inspected.","+"," ### `x509.signatureAlgorithm`"," "," <!-- YAML","@@ -3426,6 +3615,17 @@ added: v24.9.0"," "," The OID of the algorithm used to sign the certificate."," ","+### `x509.version`","+","+<!-- YAML","+added: REPLACEME","+-->","+","+* Type: {number}","+","+The certificate version: `1` for X.509 v1, `2` for X.509 v2, or `3` for X.509","+v3. A certificate with no encoded version field has version `1`.","+"," ### `x509.verify(publicKey)`"," "," <!-- YAML","@@ -7637,6 +7837,14 @@ See the [list of SSL OP Flags][] for details."," [`verify.update()`]: #verifyupdatedata-inputencoding"," [`verify.verify()`]: #verifyverifykey-signature-signatureencoding"," [`x509.fingerprint256`]: #x509fingerprint256","+[`x509.infoAccess`]: #x509infoaccess","+[`x509.issuer`]: #x509issuer","+[`x509.keyUsage`]: #x509keyusage","+[`x509.raw`]: #x509raw","+[`x509.signatureAlgorithmOid`]: #x509signaturealgorithmoid","+[`x509.signatureAlgorithm`]: #x509signaturealgorithm","+[`x509.subjectAltName`]: #x509subjectaltname","+[`x509.subject`]: #x509subject"," [`x509.verify(publicKey)`]: #x509verifypublickey"," [argon2]: https://www.rfc-editor.org/r