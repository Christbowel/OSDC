ne, str | No","         owner, _, name = from_env.rpartition(\"/\")","         return owner, name"," ","+    remote = _origin_url(project_dir)","+    parsed = parse_owner_and_repo(remote) if remote else None","+    return parsed if parsed else (None, None)","+","+","+def discover_git_provider(project_dir: str) -> str | None:","+    \"\"\"``\"github\"`` or ``\"gitlab\"``, or None when it can't be told.","+","+    Taken from the CI system when there is one, since a self-hosted GitLab's","+    hostname need not mention GitLab; otherwise from the origin remote's host.","+    \"\"\"","+    if os.environ.get(\"GITLAB_CI\"):","+        return \"gitlab\"","+    if os.environ.get(\"GITHUB_ACTIONS\"):","+        return \"github\"","+","+    remote = _origin_url(project_dir)","+    host = _remote_host(remote) if remote else \"\"","+    if \"gitlab\" in host:","+        return \"gitlab\"","+    if \"github\" in host:","+        return \"github\"","+    return None","+","+","+def _origin_url(project_dir: str) -> str | None:","     repo = _open_repo(project_dir)","     if repo is None:","-        return None, None","+        return None","     from git import GitCommandError"," ","     try:","-        remote = repo.remote(\"origin\").url","+        return repo.remote(\"origin\").url","     except (ValueError, GitCommandError):","-        return None, None","-    parsed = parse_owner_and_repo(remote)","-    return parsed if parsed else (None, None)","+        return None","+","+","+def _remote_host(remote_url: str) -> str:","+    if \"://\" in remote_url:","+        return (urlparse(remote_url).hostname or \"\").lower()","+    # scp-like syntax, e.g. git@gitlab.com:acme/proj.git","+    return remote_url.rpartition(\"@\")[2].partition(\":\")[0].lower()"," "," "," def _github_default_branch() -> str | None:","@@ -124,3 +156,13 @@ def discover_base_branch(project_dir: str) -> str | None:","         # No origin/HEAD, or it isn't symbolic.","         return None","     return target.remote_head if isinstance(target, RemoteReference) else None","+","+","+def discover_repo_root(project_dir: str) -> str | None:","+    \"\"\"The checkout root, which a project directory may sit below.","+","+    The binding's defs path is repo-relative, and in a workspace the project","+    root is a subdirectory of the repo, so the two differ.","+    \"\"\"","+    repo = _open_repo(project_dir)","+    return str(repo.working_tree_dir) if repo and repo.working_tree_dir else None"],"additions":47,"deletions":5,"truncated":false},{"path":"python_modules/libraries/dagster-cloud-cli/dagster_cloud_cli/core/workspace.py","lines":["@@ -13,7 +13,7 @@"," # The repo fields are skipped when unset so deploy data from CLIs that don't"," # report them serializes exactly as before."," @whitelist_for_serdes(","-    skip_when_none_fields={\"repo_owner\", \"repo_name\", \"base_branch\", \"defs_base_path\"}","+    skip_when_none_fields={\"repo_owner\", \"repo_name\", \"base_branch\", \"defs_base_path\", \"provider\"}"," )"," @record(kw_only=False)"," class GitMetadata:","@@ -27,6 +27,7 @@ class GitMetadata:","     repo_name: str | None = None","     base_branch: str | None = None","     defs_base_path: str | None = None","+    provider: str | None = None  # \"github\" / \"gitlab\""," "," "," @whitelist_for_serdes"],"additions":2,"deletions":1,"truncated":false},{"path":"python_modules/libraries/dagster-cloud-cli/dagster_cloud_cli_tests/core_tests/test_git_repo_context.py","lines":["@@ -138,3 +138,42 @@ def test_reads_a_checkout(monkeypatch, tmp_path):"," ","     assert git_repo_context.discover_repo_owner_and_name(str(project_dir)) == (\"acme\", \"proj\")","     assert git_repo_context.discover_base_branch(str(project_dir)) == \"main\"","+","+","+_PROVIDER_ENV_VARS = (\"GITLAB_CI\", \"GITHUB_ACTIONS\")","+","+","+@pytest.mark.parametrize(","+    \"env_var,expected\",","+    [(\"GITLAB_CI\", \"gitlab\"), (\"GITHUB_ACTIONS\", \"github\")],","+)","+def test_provider_comes_from_the_ci_system(monkeypatch, tmp_path, env_var, expected):","+    for name in _PROVIDER_ENV_VARS:","+        monkeypatch.delenv(name, raising=False)","+    monkeypatch.setenv(env_var, \"true\")","+    assert git_repo_context.discover_git_provider(str(tmp_path)) == expected","+","+","+# A local deploy has no CI variables, and is often run without --git-url.","+@pytest.mark.parametrize(","+    \"remote,expected\",","+    [","+        (\"git@gitlab.com:acme/team/proj.git\", \"gitlab\"),","+        (\"https://gitlab.example.com/acme/proj.git\", \"gitlab\"),","+        (\"git@github.com:acme/proj.git\", \"github\"),","+        (\"ssh://git@github.com/acme/proj.git\", \"github\"),","+        # A self-hosted host that doesn't name its provider can't be told apart.","+        (\"git@git.example.com:acme/proj.git\", None),","+    ],","+)","+def test_provider_falls_back_to_the_origin_remote(monkeypatch, tmp_path, remote, expected):","+    for name in _PROVIDER_ENV_VARS:","+        monkeypatch.delenv(name, raising=False)","+    Repo.init(tmp_path).create_remote(\"origin\", remote)","+    assert git_repo_context.discover_git_provider(str(tmp_path)) == expected","+","+","+def test_provider_reports_nothing_outside_a_checkout(monkeypatch, tmp_path):","+    for name in _PROVIDER_ENV_VARS:","+        monkeypatch.delenv(name, raising=False)","+    assert git_repo_context.discover_git_provider(str(tmp_path)) is None"],"additions":39,"deletions":0,"truncated":false},{"path":"python_modules/libraries/dagster-cloud-cli/dagster_cloud_cli_tests/test_ci_commands.py","lines":["@@ -123,6 +123,7 @@ def test_ci_init_local_branch_deployment(monkeypatch, mocker, empty_config) -> N","                     \"git_url\": \"http://some-git-url\",","                     # Discovery finds nothing: the project dir is a temp dir, not","                     # a checkout, and no CI environment variables are set.","+                    \"git_provider\": None,","                     \"repo_owner\": None,","                 