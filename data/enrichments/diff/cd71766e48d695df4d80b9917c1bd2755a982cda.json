{"id":"cd71766e48d695df4d80b9917c1bd2755a982cda","axis":"silent","repo":"tensorflow/tensorflow","sha":"cd71766e48d695df4d80b9917c1bd2755a982cda","parsed":{"files":[{"path":"third_party/xla/xla/backends/gpu/transforms/BUILD","lines":["@@ -2921,6 +2921,60 @@ cc_library(","     ],"," )"," ","+cc_library(","+    name = \"ragged_dot_cudnn_support\",","+    srcs = [\"ragged_dot_cudnn_support.cc\"],","+    hdrs = [\"ragged_dot_cudnn_support.h\"],","+    tags = [","+        \"cuda-only\",","+        \"gpu\",","+    ],","+    deps = [","+        \":cudnn_fusion_compiler\",","+        \":ragged_dot_fusion_rewriter\",","+        \"//xla:shape_util\",","+        \"//xla:xla_proto_cc\",","+        \"//xla/hlo/ir:hlo\",","+        \"//xla/service:decision\",","+        \"//xla/service/gpu:cudnn_support_utils\",","+        \"//xla/stream_executor:device_description\",","+        \"//xla/stream_executor:dnn\",","+        \"//xla/stream_executor:stream_executor_h\",","+        \"//xla/tools:hlo_decomposer_lib\",","+        \"@com_google_absl//absl/base:nullability\",","+        \"@com_google_absl//absl/log\",","+        \"@com_google_absl//absl/status\",","+        \"@com_google_absl//absl/status:statusor\",","+    ],","+)","+","+xla_test(","+    name = \"ragged_dot_cudnn_support_test\",","+    srcs = [\"ragged_dot_cudnn_support_test.cc\"],","+    backends = [","+        \"a100\",","+        \"h100\",","+        \"b200\",","+    ],","+    tags = [","+        \"cuda-only\",","+        \"no_mac\",","+    ],","+    deps = [","+        \":ragged_dot_cudnn_support\",","+        \"//xla/backends/gpu/tests:hlo_pjrt_gpu_test_base\",","+        \"//xla/hlo/ir:hlo\",","+        \"//xla/service:decision\",","+        \"//xla/stream_executor:platform_manager\",","+        \"//xla/stream_executor:semantic_version\",","+        \"//xla/stream_executor:stream_executor_h\",","+        \"@com_google_absl//absl/log:check\",","+        \"@com_google_absl//absl/status:statusor\",","+        \"@com_google_absl//absl/strings:string_view\",","+        \"@com_google_googletest//:gtest_main\",","+    ],","+)","+"," xla_test(","     name = \"ragged_dot_fusion_rewriter_test\",","     srcs = [\"ragged_dot_fusion_rewriter_test.cc\"],"],"additions":54,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/transforms/cudnn_fusion_compiler.cc","lines":["@@ -1375,6 +1375,8 @@ absl::StatusOr<se::gpu::CudnnGraph> HloFusionToCuDnnGraph(","             \"moe_grouped_matmul_bwd requires cuDNN frontend 1.22.1+.\");"," #endif  // CUDNN_FRONTEND_VERSION >= 12201","       } else {","+        // On cuDNN < 9.15 the frontend returns GRAPH_NOT_SUPPORTED from","+        // build_operation_graph(), which CudnnGraph::Prepare propagates.","         auto moe_grouped_matmul_attr =","             graph::Moe_grouped_matmul_attributes()","                 .set_mode(fe::MoeGroupedMatmulMode_t::NONE)"],"additions":2,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/transforms/ragged_dot_cudnn_support.cc","lines":["@@ -0,0 +1,122 @@","+/* Copyright 2026 The OpenXLA Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+==============================================================================*/","+","+#include \"xla/backends/gpu/transforms/ragged_dot_cudnn_support.h\"","+","+#include <memory>","+","+#include \"absl/base/nullability.h\"","+#include \"absl/log/log.h\"","+#include \"absl/status/status.h\"","+#include \"absl/status/statusor.h\"","+#include \"xla/backends/gpu/transforms/cudnn_fusion_compiler.h\"","+#include \"xla/backends/gpu/transforms/ragged_dot_fusion_rewriter.h\"","+#include \"xla/hlo/ir/hlo_casting_utils.h\"","+#include \"xla/hlo/ir/hlo_computation.h\"","+#include \"xla/hlo/ir/hlo_instruction.h\"","+#include \"xla/hlo/ir/hlo_instructions.h\"","+#include \"xla/hlo/ir/hlo_module.h\"","+#include \"xla/hlo/ir/hlo_opcode.h\"","+#include \"xla/layout_util.h\"","+#include \"xla/service/decision.h\"","+#include \"xla/service/gpu/cudnn_support_utils.h\"","+#include \"xla/stream_executor/device_description.h\"","+#include \"xla/stream_executor/dnn.h\"","+#include \"xla/stream_executor/stream_executor.h\"","+#include \"xla/tools/hlo_decomposer.h\"","+#include \"xla/xla.pb.h\"","+","+namespace xla {","+namespace gpu {","+","+Decision IsRaggedDotSupportedByCuDnn(","+    const HloInstruction& ragged_dot,","+    const stream_executor::DeviceDescription& device_description,","+    stream_executor::StreamExecutor* absl_nullable stream_exec) {","+  const DebugOptions& debug_options =","+      ragged_dot.GetModule()->config().debug_options();","+","+  // Resolve the cuDNN handle the same way CuDnnFusionCompiler will: this honors","+  // xla_gpu_cudnn_deviceless_compilation_mode (e.g. forced deviceless) and","+  // returns nullptr for deviceless compilation.","+  absl::StatusOr<stream_executor::dnn::DnnSupport* absl_nullable> dnn_support =","+      ResolveCudnnSupport(debug_options, stream_exec,","+                          device_description.dnn_version());","+  if (!dnn_support.ok()) {","+    VLOG(1) << \"Ragged dot cuDNN probe: cannot resolve cuDNN support: \"","+            << dnn_support.status();","+    return Decision::Forbid(\"cannot resolve cuDNN support: \")","+           << dnn_support.status().message();","+  }","+","+  // ExtractInstructionIntoNewModule() uses a default module config, so carry","+  // over the debug options: RaggedDotFusionRewriter and CuDnnFusionCompiler","+  // both read them.","+  std::unique_ptr<HloModule> probe_module =","+      ExtractInstructionIntoNewModule(ragged_dot);","+  probe_module->mutable_config().set_debug_options(debug_options);","+","+  // This runs before layout assignment, so `ragged_dot` may still carry","+  // arbitrary layouts. GpuLayoutAssignment pins the operands and the result of","+  // a ragged dot (and of a cuDNN fusion) to the default layout, so normalize","+  // the probe the same way to match the fusion cuDNN will actually see.","+  HloComputation* probe_entry = probe_module->entry_computation();","+  for (HloInstruction* instr : probe_entry->instructions()) {","+    LayoutUtil::SetToDefaultLayout(instr->mutable_shape());","+  }","+  probe_module->mutable_config().SetComputationLayoutIfExists(","+      probe_entry->ComputeProgramShape());","+","+  // Build the fusion that the real pipeline would hand to cuDNN, by running","+  // RaggedDotFusionRewriter on the scratch module. This is not recursive: the","+  // rewriter does not consult this support check (that happens earlier, in","+  // RaggedDotRewriter, via the callback), it unconditionally converts every","+  // ragged dot it sees. We reuse the rewriter rather than hand-building a","+  // fusion because its output depends on its rewrites (wgrad K/N padding for","+  // TMA alignment, padding-tail masking, cumulative-sum group offsets), and","+  // cuDNN support must be probed on that form. The scratch module keeps those","+  // in-place rewrites away from the module being compiled.","+  absl::StatusOr<bool> changed =","+      RaggedDotFusionRewriter().Run(probe_module.get());","+  if (!changed.ok()) {","+    VLOG(1) << \"Ragged dot cuDNN probe: fusion rewrite failed: \"","+            << changed.status();","+    return Decision::Forbid(\"fusion rewrite failed: \")","+           << changed.status().message();","+  }","+  for (const HloInstruction* instr : probe_entry->instructions()) {","+    if (instr->opcode() != HloOpcode::kFusion) {","+      continue;","+    }","+    // A null DnnSupport means deviceless: cuDNN answers from the device","+    // description alone.","+    absl::StatusOr<int> plan_count = CuDnnFusionCompiler::GetAvailablePlanCount(","+        *dnn_support, device_description, *Cast<HloFusionInstruction>(instr));","+    if (!plan_count.ok()) {","+      VLOG(1) << \"Ragged dot cuDNN probe: plan count failed: \"","+              << plan_count.status();","+      return Decision::Forbid(\"plan count failed: \")","+             << plan_count.status().message();","+    }","+    if (*plan_count <= 0) {","+      return Decision::Forbid(\"cuDNN reports no available plans\");","+    }","+    return Decision::Allow();","+  }","+  return Decision::Forbid(\"ragged dot did not produce a cuDNN fusion\");","+}","+","+}  // namespace gpu","+}  // namespace xla"],"additions":122,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/transforms/ragged_dot_cudnn_support.h","lines":["@@ -0,0 +1,51 @@","+/* Copyright 2026 The OpenXLA Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+==============================================================================*/","+","+#ifndef XLA_BACKENDS_GPU_TRANSFORMS_RAGGED_DOT_CUDNN_SUPPORT_H_","+#define XLA_BACKENDS_GPU_TRANSFORMS_RAGGED_DOT_CUDNN_SUPPORT_H_","+","+#include \"absl/base/nullability.h\"","+#include \"xla/hlo/ir/hlo_instruction.h\"","+#include \"xla/service/decision.h\"","+#include \"xla/stream_executor/device_description.h\"","+#include \"xla/stream_executor/stream_executor.h\"","+","+namespace xla {","+namespace gpu {","+","+// Returns an allowed Decision iff cuDNN positively reports an execution plan","+// for the cuDNN fusion that RaggedDotFusionRewriter would build for","+// `ragged_dot` on `device_description`. The ragged dot is cloned into a scratch","+// module (with the debug options of its module) and RaggedDotFusionRewriter is","+// run on it, then cuDNN is asked for the plan count","+// (CuDnnFusionCompiler::GetAvailablePlanCount). The cuDNN handle is resolved","+// with ResolveCudnnSupport, like CuDnnFusionCompiler does: it uses the live","+// handle of `stream_exec`, or deviceless cuDNN when there is no `stream_exec`","+// or when xla_gpu_cudnn_deviceless_compilation_mode forces it.","+// Anything but a positive answer -- no plans, a probe failure, or no way to","+// probe -- returns a forbidden Decision with the reason, so the caller falls","+// back to the regular dense expansion.","+//","+// The probe normalizes all layouts to the default layout, matching what","+// GpuLayoutAssignment later assigns to the ragged dot / cuDNN fusion.","+Decision IsRaggedDotSupportedByCuDnn(","+    const HloInstruction& ragged_dot,","+    const stream_executor::DeviceDescription& device_description,","+    stream_executor::StreamExecutor* absl_nullable stream_exec = nullptr);","+","+}  // namespace gpu","+}  // namespace xla","+","+#endif  // XLA_BACKENDS_GPU_TRANSFORMS_RAGGED_DOT_CUDNN_SUPPORT_H_"],"additions":51,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/backends/gpu/transforms/ragged_dot_cudnn_support_test.cc","lines":["@@ -0,0 +1,106 @@","+/* Copyright 2026 The OpenXLA Authors.","+","+Licensed under the Apache License, Version 2.0 (the \"License\");","+you may not use this file except in compliance with the License.","+You may obtain a copy of the License at","+","+    http://www.apache.org/licenses/LICENSE-2.0","+","+Unless required by applicable law or agreed to in writing, software","+distributed under the License is distributed on an \"AS IS\" BASIS,","+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","+See the License for the specific language governing permissions and","+limitations under the License.","+==============================================================================*/","+","+#include \"xla/backends/gpu/transforms/ragged_dot_cudnn_support.h\"","+","+#include <memory>","+#include <utility>","+","+#include <gtest/gtest.h>","+#include \"absl/log/check.h\"","+#include \"absl/status/statusor.h\"","+#include \"absl/strings/string_view.h\"","+#include \"xla/backends/gpu/tests/hlo_pjrt_gpu_test_base.h\"","+#include \"xla/hlo/ir/hlo_instruction.h\"","+#include \"xla/hlo/ir/hlo_module.h\"","+#include \"xla/service/decision.h\"","+#include \"xla/stream_executor/platform_manager.h\"","+#include \"xla/stream_executor/semantic_version.h\"","+#include \"xla/stream_executor/stream_executor.h\"","+","+namespace xla {","+namespace gpu {","+namespace {","+","+class RaggedDotCuDnnSupportTest : public HloPjRtGpuTestBase {","+ protected:","+  se::StreamExecutor* stream_executor() const {","+    auto platform =","+        se::PlatformManager::PlatformWithId(stream_executor_platform_id());","+    CHECK_OK(platform);","+    absl::StatusOr<se::StreamExecutor*> executor =","+        (*platform)->ExecutorForDevice(0);","+    CHECK_OK(executor);","+    return *executor;","+  }","+","+  Decision Probe(absl::string_view hlo) {","+    absl::StatusOr<std::unique_ptr<HloModule>> module =","+        ParseAndReturnVerifiedModule(hlo);","+    CHECK_OK(module);","+    module_ = *std::move(module);","+    module_->mutable_config()","+        .mutable_debug_options()","+        .set_xla_gpu_experimental_use_ragged_dot_fusion(true);","+    return IsRaggedDotSupportedByCuDnn(","+        *module_->entry_computation()->root_instruction(), device_description(),","+        stream_executor());","+  }","+","+  std::unique_ptr<HloModule> module_;","+};","+","+TEST_F(RaggedDotCuDnnSupportTest, SupportedRaggedDotIsAllowed) {","+  if (!device_description().cuda_compute_capability().IsAtLeastAmpere()) {","+    GTEST_SKIP() << \"cuDNN ragged dot fusion requires Ampere or newer.\";","+  }","+  if (device_description().dnn_version() < se::SemanticVersion{9, 22, 0}) {","+    GTEST_SKIP() << \"cuDNN ragged dot fusion requires cuDNN >= 9.22.\";","+  }","+  Decision decision = Probe(R\"(","+    HloModule test","+","+    ENTRY main {","+      p0 = bf16[128,512]{1,0} parameter(0)","+      p1 = bf16[16,512,256]{2,1,0} parameter(1)","+      p2 = s32[16]{0} parameter(2)","+      ROOT rd = bf16[128,256]{1,0} ragged-dot(p0, p1, p2),","+          lhs_contracting_dims={1}, rhs_contracting_dims={1},","+          lhs_ragged_dims={0}, rhs_group_dims={0}","+    })\");","+  EXPECT_TRUE(decision.IsAllowed()) << decision.Explain();","+}","+","+// cuDNN has no engine for mixed token/weight dtypes, so the probe must report","+// a forbidden decision (the caller then expands to a dense dot).","+TEST_F(RaggedDotCuDnnSupportTest, UnsupportedRaggedDotIsForbidden) {","+  Decision decision = Probe(R\"(","+    HloModule test","+","+    ENTRY main {","+      p0 = bf16[128,512]{1,0} parameter(0)","+      p1 = f16[16,512,256]{2,1,0} parameter(1)","+      p2 = s32[16]{0} parameter(2)","+      ROOT rd = bf16[128,256]{1,0} ragged-dot(p0, p1, p2),","+          lhs_contracting_dims={1}, rhs_contracting_dims={1},","+          lhs_ragged_dims={0}, rhs_group_dims={0}","+    })\");","+  EXPECT_TRUE(decision.IsForbidden());","+  EXPECT_FALSE(decision.Explain().empty());","+}","+","+}  // namespace","+}  // namespace gpu","+}  // namespace xla"],"additions":106,"deletions":0,"truncated":false},{"path":"third_party/xla/xla/hlo/transforms/expanders/BUILD","lines":["@@ -474,6 +474,7 @@ cc_library(","         \"//xla:xla_data_proto_cc\",","         \"//xla/hlo/ir:hlo\",","         \"//xla/hlo/pass:hlo_pass\",","+        \"//xla/service:decision\",","         \"//xla/service/gpu:backend_configs_cc\",","         \"//xla/service/gpu:ir_emission_utils\",","         \"//xla/stream_executor:device_description\",","@@ -501,12 +502,12 @@ xla_cc_test(","         \":ragged_dot_rewriter\",","         \"//xla/hlo/ir:hlo\",","         \"//xla/hlo/testlib:hlo_hardware_independent_test_base\",","+        \"//xla/service:decision\",","         \"//xla/stream_executor:device_description\",","         \"//xla/stream_executor:dnn\",","         \"//xla/stream_executor:semantic_version\",","         \"//xla/stream_executor/cuda:cuda_compute_capability\",","         \"//xla/stream_executor/rocm:rocm_compute_capability\",","-        \"//xla/tsl/platform:statusor\",","         \"@com_google_absl//absl/strings:string_view\",","         \"@com_google_googletest//:gtest\",","         \"@com_google_googletest//:gtest_main\",  # fixdeps: keep"],"additions":2,"deletions":1,"truncated":false},{"path":"third_party/xla/xla/hlo/transforms/expanders/ragged_dot_rewriter.cc","lines":["@@ -39,6 +39,7 @@ limitations under the License."," #include \"xla/hlo/ir/hlo_instructions.h\""," #include \"xla/hlo/ir/hlo_opcode.h\""," #include \"xla/literal_util.h\"","+#include \"xla/service/decision.h\""," #include \"xla/service/gpu/backend_configs.pb.h\""," #include \"xla/service/gpu/ir_emission_utils.h\""," #include \"xla/shape.h\"","@@ -461,19 +462,39 @@ bool CanBeHandledByCuDNNFusion(","   const HloRaggedDotInstruction* ragged_dot =","       DynCast<HloRaggedDotInstruction>(instruction);","   const auto& ragged_dims = ragged_dot->ragged_dot_dimension_numbers();","-  if (ragged_dims.lhs_ragged_dimensions().size() != 1 ||","+  const DotDimensionNumbers& dnums = ragged_dims.dot_dimension_numbers();","+  // RaggedDotFusionRewriter / RaggedDotDimensionAdapter only support","+  // unbatched dots with exactly one contracting dimension per operand, a 2D","+  // lhs and 1D group sizes. The rhs rank depends on the ragged mode (checked","+  // below).","+  if (!dnums.lhs_batch_dimensions().empty() ||","+      !dnums.rhs_batch_dimensions().empty() ||","+      dnums.lhs_contracting_dimensions().size() != 1 ||","+      dnums.rhs_contracting_dimensions().size() != 1 ||","+      ragged_dot->operand_count() != 3 ||","+      ragged_dot->operand(0)->shape().dimensions().size() != 2 ||","+      ragged_dot->operand(2)->shape().dimensions().size() != 1 ||","+      ragged_dot->operand(0)->shape().element_type() !=","+          ragged_dot->shape().element_type() ||","+      ragged_dot->operand(1)->shape().element_type() !=","+          ragged_dot->shape().element_type() ||","+      ragged_dims.lhs_ragged_dimensions().size() != 1 ||","       (ragged_dot->shape().element_type() != F16 &&","        ragged_dot->shape().element_type() != BF16)) {","     return false;","   }","+  const int64_t rhs_rank = ragged_dot->operand(1)->shape().dimensions().size();","   int lhs_ragged_dim = ragged_dims.lhs_ragged_dimensions(0);","   RaggedDotMode mode =","       GetRaggedDotMode(lhs_ragged_dim, ragged_dims.dot_dimension_numbers());","   if (mode == RaggedDotMode::kRaggedContracting) {","-    return SupportsCudnnRaggedDotWgrad(gpu_compute_capability, cudnn_version,","+    // Wgrad: 2D rhs.","+    return rhs_rank == 2 &&","+           SupportsCudnnRaggedDotWgrad(gpu_compute_capability, cudnn_version,","                                        toolkit_version);","   }","-  return mode == RaggedDotMode::kRaggedNonContracting;","+  // Ragged non-contracting: 3D rhs (group dim + 2 matrix dims).","+  return mode == RaggedDotMode::kRaggedNonContracting && rhs_rank == 3;"," }"," "," bool CanBeHandledByGpublasltGroupGemm(","@@ -516,6 +537,9 @@ absl::StatusOr<bool> RaggedDotRewriter::RunImpl(","       module->config()","           .debug_options()","           .xla_gpu_experimental_use_ragged_dot_fusion() &&","+      !module->config()","+           .debug_options()","+           .xla_gpu_experimental_disable_binary_libraries() &&","       cudnn_version_ >= kMinCudnnVersionForRaggedDotFusion &&","       cuda_cc != nullptr && cuda_cc->IsAtLeastAmpere();"," ","@@ -529,8 +553,14 @@ absl::StatusOr<bool> RaggedDotRewriter::RunImpl(","       if (instruction->opcode() == HloOpcode::kRaggedDot) {","         if (ragged_dot_fusion_enabled &&","             CanBeHandledByCuDNNFusion(instruction, gpu_compute_capability_,","-                                      cudnn_version_, toolkit_version_)) {","-          continue;","+                                      cudnn_version_, toolkit_version_) &&","+            is_supported_by_cudnn_fusion_ != nullptr) {","+          Decision decision = is_supported_by_cudnn_fusion_(instruction);","+          if (decision.IsAllowed()) {","+            continue;","+          }","+          VLOG(3) << \"Expanding \" << instruction->name()","+                  << \" instead of using cuDNN fusion: \" << decision.Explain();","         }","         if (has_grouped_gemm && CanBeHandledByGpublasltGroupGemm(","                                     gpu_compute_capability_, instruction)) {"],"additions":35,"deletions":5,"truncated":false},{"path":"third_party/xla/xla/hlo/transforms/expanders/ragged_dot_rewriter.h","lines":["@@ -16,11 +16,16 @@ limitations under the License."," #ifndef XLA_HLO_TRANSFORMS_EXPANDERS_RAGGED_DOT_REWRITER_H_"," #define XLA_HLO_TRANSFORMS_EXPANDERS_RAGGED_DOT_REWRITER_H_"," ","+#include <functional>","+#include <utility>","+"," #include \"absl/container/flat_hash_set.h\""," #include \"absl/status/statusor.h\""," #include \"absl/strings/string_view.h\"","+#include \"xla/hlo/ir/hlo_instruction.h\""," #include \"xla/hlo/ir/hlo_module.h\""," #include \"xla/hlo/pass/hlo_pass_interface.h\"","+#include \"xla/service/decision.h\""," #include \"xla/stream_executor/device_description.h\""," #include \"xla/stream_executor/dnn.h\""," #include \"xla/stream_executor/semantic_version.h\"","@@ -46,14 +51,24 @@ bool SupportsCudnnRaggedDotWgrad("," // RaggedDotRewriter converts ragged dots to general dots through expansion."," class RaggedDotRewriter : public HloModulePass {","  public:","+  // `is_supported_by_cudnn_fusion` is consulted for every ragged dot that","+  // passes the version/dtype/mode gates; a ragged dot is left for the cuDNN","+  // fusion only if it is set and returns an allowed Decision. If unset, nothing","+  // vouches for cuDNN support, so the ragged dot is expanded. The callback","+  // lets the caller probe cuDNN (which does call into cuDNN) without this pass","+  // depending on cuDNN targets.","   explicit RaggedDotRewriter(","       se::GpuComputeCapability gpu_compute_capability,","       stream_executor::dnn::VersionInfo cudnn_version =","           stream_executor::dnn::VersionInfo(),","-      stream_executor::SemanticVersion toolkit_version = {0, 0, 0})","+      stream_executor::SemanticVersion toolkit_version = {0, 0, 0},","+      std::function<Decision(const HloInstruction*)>","+          is_supported_by_cudnn_fusion = nullptr)","       : gpu_compute_capability_(gpu_compute_capability),","         cudnn_version_(cudnn_version),","-        toolkit_version_(toolkit_version) {}","+        toolkit_version_(toolkit_version),","+        is_supported_by_cudnn_fusion_(std::move(is_supported_by_cudnn_fusion)) {","+  }"," ","   absl::string_view name() const override { return \"ragged_dot_rewriter\"; }"," ","@@ -66,6 +81,7 @@ class RaggedDotRewriter : public HloModulePass {","   stream_executor::GpuComputeCapability gpu_compute_capability_;","   stream_executor::dnn::VersionInfo cudnn_version_;","   stream_executor::SemanticVersion toolkit_version_;","+  std::function<Decision(const HloInstruction*)> is_supported_by_cudnn_fusion_;"," };"," "," }  // namespace xla"],"additions":18,"deletions":2,"truncated":false},{"path":"third_party/xla/xla/hlo/transforms/expanders/ragged_dot_rewriter_test.cc","lines":["@@ -21,14 +21,15 @@ limitations under the License."," #include <gmock/gmock.h>"," #include <gtest/gtest.h>"," #include \"absl/strings/string_vi