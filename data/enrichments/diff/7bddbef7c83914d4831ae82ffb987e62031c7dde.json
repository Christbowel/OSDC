{"id":"7bddbef7c83914d4831ae82ffb987e62031c7dde","axis":"silent","repo":"pnpm/pnpm","sha":"7bddbef7c83914d4831ae82ffb987e62031c7dde","parsed":{"files":[{"path":".changeset/null-task-entry-hint.md","lines":["@@ -0,0 +1,7 @@","+---","+\"@pnpm/config.reader\": patch","+\"pnpm\": patch","+\"pacquet\": patch","+---","+","+A `tasks` entry with no value in `pnpm-workspace.yaml`, such as `build:`, now fails with a hint. The hint suggests writing `{}` for a task with no settings, or removing the entry to keep the default `dependsOn: ['^<task>']`."],"additions":7,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/sections.rs","lines":["@@ -455,7 +455,9 @@ struct RawTaskSettings {"," "," impl<'de> Deserialize<'de> for TaskSettings {","     fn deserialize<De: Deserializer<'de>>(deserializer: De) -> Result<Self, De::Error> {","-        let raw = RawTaskSettings::deserialize(deserializer)?;","+        use serde::de::Error as _;","+        let raw = Option::<RawTaskSettings>::deserialize(deserializer)?","+            .ok_or_else(|| De::Error::custom(EMPTY_TASK_ENTRY_ERROR))?;","         let concurrency = raw.concurrency.as_ref().and_then(serde_json::Value::as_i64);","         let invalid_concurrency = raw.concurrency.filter(|value| value.as_i64().is_none());","         let priority = raw.priority.as_ref().and_then(json_i32);","@@ -477,6 +479,10 @@ impl<'de> Deserialize<'de> for TaskSettings {","     }"," }"," ","+const EMPTY_TASK_ENTRY_ERROR: &str = \"a `tasks` entry must be a mapping. \\","+    Write `{}` for a task with no settings, or remove the entry to keep the default \\","+    `dependsOn: ['^<task>']`\";","+"," fn json_i32(value: &serde_json::Value) -> Option<i32> {","     value","         .as_i64()"],"additions":7,"deletions":1,"truncated":false},{"path":"pnpm/crates/config/src/workspace_yaml/tests/configuration_parses_common_settings_from.rs","lines":["@@ -863,6 +863,18 @@ fn a_report_names_only_the_first_unrecognized_task_settings() {","     assert_eq!(reported.total, NAMED_UNRECOGNIZED_SETTINGS + 3);"," }"," ","+#[test]","+fn rejects_a_task_entry_without_a_value_with_a_hint() {","+    for entry in [\"build:\", \"build: null\"] {","+        let dir = tempfile::tempdir().unwrap();","+        fs::write(dir.path().join(WORKSPACE_MANIFEST_FILENAME), format!(\"tasks:\\n  {entry}\\n\"))","+            .unwrap();","+","+        let error = WorkspaceSettings::load_at(dir.path()).unwrap_err().to_string();","+        assert!(error.contains(\"Write `{}` for a task with no settings\"), \"{entry}: {error}\");","+    }","+}","+"," #[test]"," fn rejects_fractional_task_concurrency_as_an_invalid_setting() {","     let dir = tempfile::tempdir().unwrap();"],"additions":12,"deletions":0,"truncated":false},{"path":"pnpm11/config/reader/src/getOptionsFromRootManifest.ts","lines":["@@ -195,6 +195,11 @@ function assertValidTasks (tasks: unknown): asserts tasks is NonNullable<PnpmSet"," }"," "," function assertValidTask (taskPath: string, task: unknown): void {","+  if (task == null) {","+    throw new PnpmError('INVALID_SETTING', `The \"${taskPath}\" setting has no value.`, {","+      hint: 'Write {} for a task with no settings, or remove the entry to keep the default dependsOn: [\\'^<task>\\'].',","+    })","+  }","   assertObjectSetting(task, taskPath)","   assertNoMisspelledTaskFields(taskPath, task as Record<string, unknown>)","   const concurrency = (task as { concurrency?: unknown }).concurrency"],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm11/config/reader/test/getOptionsFromRootManifest.test.ts","lines":["@@ -864,6 +864,15 @@ test('getOptionsFromPnpmSettings() passes a valid tasks section through', () =>","   })"," })"," ","+test('getOptionsFromPnpmSettings() rejects a task entry without a value with a hint', () => {","+  expect(() => getOptionsFromPnpmSettings(process.cwd(), {","+    tasks: { build: null } as never,","+  })).toThrow(expect.objectContaining({","+    message: 'The \"tasks[\\'build\\']\" setting has no value.',","+    hint: expect.stringContaining('Write {} for a task with no settings'),","+  }))","+})","+"," test('getOptionsFromPnpmSettings() rejects a tasks entry that is not an object', () => {","   expect(() => getOptionsFromPnpmSettings(process.cwd(), {","     tasks: { build: ['^build'] } as never,",""],"additions":9,"deletions":0,"truncated":false}],"additions":40,"deletions":1,"truncated":false,"file_count":5},"error":null,"fetched_at":"2026-11-21T16:31:51.800736+00:00"}