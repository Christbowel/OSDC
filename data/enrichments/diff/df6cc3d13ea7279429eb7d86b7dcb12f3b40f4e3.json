module.id;"],"additions":1,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/optimization/compat-hashed-module-ids/index.js","lines":["@@ -0,0 +1,8 @@","+it(\"should assign identifier-safe module ids with compat-hashed\", () => {","+\tconst ids = [require(\"./a\"), require(\"./b\"), require(\"./c\")];","+","+\texpect(new Set(ids).size).toBe(ids.length);","+\tfor (const id of ids) {","+\t\texpect(id).toMatch(/^[A-Za-z][A-Za-z0-9]*$/);","+\t}","+});"],"additions":8,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/optimization/compat-hashed-module-ids/min-length.js","lines":["@@ -0,0 +1,64 @@","+const ids = [","+\trequire(\"./a?0\"),","+\trequire(\"./a?1\"),","+\trequire(\"./a?2\"),","+\trequire(\"./a?3\"),","+\trequire(\"./a?4\"),","+\trequire(\"./a?5\"),","+\trequire(\"./a?6\"),","+\trequire(\"./a?7\"),","+\trequire(\"./a?8\"),","+\trequire(\"./a?9\"),","+\trequire(\"./a?10\"),","+\trequire(\"./a?11\"),","+\trequire(\"./a?12\"),","+\trequire(\"./a?13\"),","+\trequire(\"./a?14\"),","+\trequire(\"./a?15\"),","+\trequire(\"./a?16\"),","+\trequire(\"./a?17\"),","+\trequire(\"./a?18\"),","+\trequire(\"./a?19\"),","+\trequire(\"./a?20\"),","+\trequire(\"./a?21\"),","+\trequire(\"./a?22\"),","+\trequire(\"./a?23\"),","+\trequire(\"./a?24\"),","+\trequire(\"./a?25\"),","+\trequire(\"./a?26\"),","+\trequire(\"./a?27\"),","+\trequire(\"./a?28\"),","+\trequire(\"./a?29\"),","+\trequire(\"./a?30\"),","+\trequire(\"./a?31\"),","+\trequire(\"./a?32\"),","+\trequire(\"./a?33\"),","+\trequire(\"./a?34\"),","+\trequire(\"./a?35\"),","+\trequire(\"./a?36\"),","+\trequire(\"./a?37\"),","+\trequire(\"./a?38\"),","+\trequire(\"./a?39\"),","+\trequire(\"./a?40\"),","+\trequire(\"./a?41\"),","+\trequire(\"./a?42\"),","+\trequire(\"./a?43\"),","+\trequire(\"./a?44\"),","+\trequire(\"./a?45\"),","+\trequire(\"./a?46\"),","+\trequire(\"./a?47\"),","+\trequire(\"./a?48\"),","+\trequire(\"./a?49\"),","+\trequire(\"./a?50\"),","+\trequire(\"./a?51\"),","+\trequire(\"./a?52\"),","+];","+","+it(\"should extend compat-hashed module ids only when shorter prefixes collide\", () => {","+\texpect(new Set(ids).size).toBe(ids.length);","+\texpect(ids.some(id => id.length === 1)).toBe(true);","+\texpect(ids.some(id => id.length > 1)).toBe(true);","+\tfor (const id of ids) {","+\t\texpect(id).toMatch(/^[A-Za-z][A-Za-z0-9]*$/);","+\t}","+});"],"additions":64,"deletions":0,"truncated":false},{"path":"tests/rspack-test/configCases/optimization/compat-hashed-module-ids/rspack.config.js","lines":["@@ -0,0 +1,17 @@","+const rspack = require('@rspack/core');","+","+/** @type {import(\"@rspack/core\").Configuration[]} */","+module.exports = [","+  {","+    optimization: {","+      moduleIds: 'compat-hashed',","+    },","+  },","+  {","+    entry: './min-length',","+    optimization: {","+      moduleIds: false,","+    },","+    plugins: [new rspack.ids.CompatHashedModuleIdsPlugin({ minLength: 1 })],","+  },","+];"],"additions":17,"deletions":0,"truncated":false},{"path":"website/docs/en/config/optimization.mdx","lines":["@@ -338,7 +338,7 @@ export default {"," ## optimization.moduleIds"," "," <PropertyType","-  type=\"false | 'natural' | 'named' | 'deterministic' | 'hashed'\"","+  type=\"false | 'natural' | 'named' | 'deterministic' | 'compat-hashed' | 'hashed'\"","   defaultValueList={[","     { defaultValue: \"'deterministic'\", mode: 'production' },","     { defaultValue: \"'named'\", mode: 'development' },","@@ -354,6 +354,7 @@ The following string values are supported:"," | `natural`       | Use numeric ids in order of usage.                                                                                             |"," | `named`         | Use meaningful, easy-to-debug content as id.                                                                                   |"," | `deterministic` | Use the hashed module identifier as the id to benefit from long-term caching. By default a minimum length of 3 digits is used. |","+| `compat-hashed` | Use the shortest available prefix of a stable alphanumeric hash.                                                               |"," | `hashed`        | Use hashed module identifiers as ids. Equivalent to using `HashedModuleIdsPlugin` with default options (md4, base64, 4 chars). |"," | `false`         | Disable Rspack's built-in module id algorithm, allowing a custom plugin to provide module ids.                                 |"," ","@@ -367,6 +368,8 @@ export default {"," "," The `deterministic` option is useful for long term caching, and results in smaller bundles compared to hashed. Length of the numeric value is chosen to fill a maximum of 80% of the id space. By default a minimum length of 3 digits is used when `optimization.moduleIds` is set to `deterministic`."," ","+The `compat-hashed` option uses the shortest available prefix of a stable alphanumeric hash as the module id, balancing long-term caching, bundle size, and runtime performance.","+"," ## optimization.nodeEnv"," "," - **Type:** `string | false`"],"additions":4,"deletions":1,"truncated":false},{"path":"website/docs/en/plugins/index.mdx","lines":["@@ -13,6 +13,7 @@ Rspack provides several high-performance built-in plugins. They can serve as dro"," Including:"," "," - [CircularCheckRspackPlugin](/plugins/rspack/circular-check-rspack-plugin): Flags circular imports","+- [CompatHashedModuleIdsPlugin](/plugins/rspack/compat-hashed-module-ids-plugin): Assigns compact, stable module ids using alphanumeric hash prefixes"," - [CopyRspackPlugin](/plugins/rspack/copy-rspack-plugin): Copies files or directories to the build output"," - [CssChunkingPlugin](/plugins/rspack/css-chunking-plugin): Splits CSS while preserving import order to avoid style issues"," - [CssExtractRspackPlugin](/plugins/rspack/css-extract-rspack-plugin): Extracts styles into standalone CSS files"],"additions":1,"deletions":0,"truncated":false},{"path":"website/docs/en/plugins/rspack/compat-hashed-module-ids-plugin.mdx","lines":["@@ -0,0 +1,34 @@","+---","+description: 'CompatHashedModuleIdsPlugin assigns compact ids using the shortest available prefixes of stable alphanumeric hashes to shrink bundles and speed runtime indexing'","+---","+","+# CompatHashedModuleIdsPlugin","+","+`CompatHashedModuleIdsPlugin` hashes module identifiers and assigns the shortest available prefix of each encoded hash. Compared with `deterministic`, it produces more compact ids that preserve stability while reducing bundle size and improving runtime indexing performance. The first character uses `a-zA-Z`, and subsequent characters use `a-zA-Z0-9`. An id is extended only when its shorter prefix is already used.","+","+`optimization.moduleIds: 'compat-hashed'` uses this plugin internally. Use the plugin directly when you need to customize the minimum encoded id length.","+","+```js title=\"rspack.config.mjs\"","+import rspack from '@rspack/core';","+","+export default {","+  optimization: {","+    moduleIds: false,","+  },","+  plugins: [","+    new rspack.ids.CompatHashedModuleIdsPlugin({","+      minLength: 1,","+    }),","+  ],","+};","+```","+","+## Options","+","+### minLength","+","+- **Type:** `number`","+- **Default:** `1`","+- **Range:** Integer from `1` to `11`","+","+The minimum encoded id length. Rspack extends an id one character at a time when its hash prefix is already used. Increasing `minLength` expands the initial id space, reducing prefix collisions and making generated output and caching more stable. The tradeoff is that module ids become longer."],"additions":34,"deletions":0,"truncated":false},{"path":"website/docs/zh/config/optimization.mdx","lines":["@@ -338,7 +338,7 @@ export default {"," ## optimization.moduleIds"," "," <PropertyType","-  type=\"false | 'natural' | 'named' | 'deterministic' | 'hashed'\"","+  type=\"false | 'natural' | 'named' | 'deterministic' | 'compat-hashed' | 'hashed'\"","   defaultValueList={[","     { defaultValue: \"'deterministic'\", mode: 'production' },","     { defaultValue: \"'named'\", mode: 'development' },","@@ -354,6 +354,7 @@ export default {"," | `natural`       | 根据模块加载的顺序使用自增数字作为模块 id。                                                                   |"," | `named`         | 使用有意义、方便调试的内容当作模块 id。                                                                       |"," | `deterministic` | 使用对模块标识符哈希后的数字当作模块 id，有益于长期缓存。默认使用 3 位数字。                                  |","+| `compat-hashed` | 使用稳定字母数字 hash 的最短可用前缀。                                                                        |"," | `hashed`        | 使用模块标识符的哈希值作为模块 id。等同于使用默认选项（md4、base64、4 字符）的 `HashedModuleIdsPlugin` 插件。 |"," | `false`         | 禁用 Rspack 内置的模块 id 算法，允许自定义插件提供模块 id。                                                   |"," ","@@ -365,6 +366,8 @@ export default {"," };"," ```"," ","+`compat-hashed` 选项使用稳定字母数字 hash 的最短可用前缀作为模块 id，兼顾长期缓存、产物体积和运行时性能。","+"," ## optimization.nodeEnv"," "," - **类型：** `string | false`"],"additions":4,"deletions":1,"truncated":false},{"path":"website/docs/zh/plugins/index.mdx","lines":["@@ -13,6 +13,7 @@ Rspack 内置了一些高性能的插件，它们可以用于替代 webpack 生"," 包括："," "," - [CircularCheckRspackPlugin](/plugins/rspack/circular-check-rspack-plugin)：检测循环依赖","+- [CompatHashedModuleIdsPlugin](/plugins/rspack/compat-hashed-module-ids-plugin)：使用字母数字 hash 前缀生成紧凑、稳定的模块 id"," - [CopyRspackPlugin](/plugins/rspack/copy-rspack-plugin)：将文件或目录复制到构建产物"," - [CssChunkingPlugin](/plugins/rspack/css-chunking-plugin)：按导入顺序切分 CSS，避免样式顺序问题"," - [CssExtractRspackPlugin](/plugins/rspack/css-extract-rspack-plugin)：把样式抽取为独立 CSS 文件"],"additions":1,"deletions":0,"truncated":false},{"path":"website/docs/zh/plugins/rspack/compat-hashed-module-ids-plugin.mdx","lines":["@@ -0,0 +1,34 @@","+---","+description: 'CompatHashedModuleIdsPlugin 使用稳定字母数字 hash 的最短可用前缀生成紧凑模块 id，兼顾长期缓存、产物体积和运行时索引性能'","+---","+","+# CompatHashedModuleIdsPlugin","+","+`CompatHashedModuleIdsPlugin` 会对模块标识符计算 hash，并分配编码后 hash 的最短可用前缀。与 `deterministic` 相比，它生成的 id 更紧凑，在保持稳定性的同时，可以减小产物体积并提升运行时索引性能。首字符使用 `a-zA-Z`，后续字符使用 `a-zA-Z0-9`。只有较短前缀已被使用时，才会延长 id。","+","+`optimization.moduleIds: 'compat-hashed'` 内部会使用该插件。只有在需要自定义编码后 id 的最小长度时，才需要直接使用该插件。","+","+```js title=\"rspack.config.mjs\"","+import rspack from '@rspack/core';","+","+export default {","+  optimization: {","+    moduleIds: false,","+  },","+  plugins: [","+    new rspack.ids.CompatHashedModuleIdsPlugin({","+      minLength: 1,","+    }),","+  ],","+};","+```","+","+## 选项","+","+### minLength","+","+- **类型：** `number`","+- **默认值：** `1`","+- **取值范围：** `1` 到 `11` 的整数","+","+编码后 id 的最小长度。如果 hash 前缀已经被使用，Rspack 会逐个字符延长该 id。增大 `minLength` 会扩大初始 id 空间，降低前缀冲突的概率，使产物和缓存更加稳定；相应地，模块 id 也会变长。",""],"additions":34,"deletions":0,"truncated":false}],"additions":390,"deletions":11,"truncated":false,"file_count":25},"error":null,"fetched_at":"2026-08-22T08:18:36.769367+00:00"}