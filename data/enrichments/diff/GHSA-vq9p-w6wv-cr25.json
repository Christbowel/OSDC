{"id":"GHSA-vq9p-w6wv-cr25","axis":"advisories","repo":"pgEdge/control-plane","sha":"88659f7388fc6c86125e60475aa83810171145b7","parsed":{"files":[{"path":"e2e/pg_hba_test.go","lines":["@@ -4,6 +4,8 @@ package e2e"," "," import ("," \t\"context\"","+\t\"fmt\"","+\t\"strings\""," \t\"testing\""," \t\"time\""," ","@@ -21,8 +23,9 @@ import ("," // applied with a reload rather than a restart."," //"," // The exact position of the user zone within pg_hba.conf is covered by the","-// generator golden tests; connection allow/deny behavior and replication are","-// covered elsewhere, so this test stays intentionally small.","+// generator golden tests; local-access allow/deny enforcement is covered by","+// TestPgHbaLocalAccessEnforcement below, so this test stays intentionally","+// small."," func TestPgHbaPgIdentUserConfig(t *testing.T) {"," \tt.Parallel()"," ","@@ -156,6 +159,95 @@ func TestPgHbaPgIdentUserConfig(t *testing.T) {"," \t})"," }"," ","+// TestPgHbaLocalAccessEnforcement verifies that the local-access defaults are","+// actually enforced at connection time, not just reflected in the generated","+// file (which the golden tests already cover). It runs psql as two different","+// local OS users, directly on the instance itself: the OS user Postgres runs","+// as, which must still reach the pgedge role over the Unix socket, and an","+// unrelated OS user, which must be denied outright.","+func TestPgHbaLocalAccessEnforcement(t *testing.T) {","+\tt.Parallel()","+","+\thost1 := fixture.HostIDs()[0]","+\tusername := \"admin\"","+\tpassword := \"password\"","+","+\tctx := t.Context()","+","+\ttLog(t, \"creating a single-node database\")","+\tdb := fixture.NewDatabaseFixture(ctx, t, &api.CreateDatabaseRequest{","+\t\tSpec: &api.DatabaseSpec{","+\t\t\tDatabaseName: \"test_pg_hba_enforce\",","+\t\t\tDatabaseUsers: []*api.DatabaseUserSpec{","+\t\t\t\t{","+\t\t\t\t\tUsername:   username,","+\t\t\t\t\tPassword:   pointerTo(password),","+\t\t\t\t\tDbOwner:    pointerTo(true),","+\t\t\t\t\tAttributes: []string{\"LOGIN\", \"SUPERUSER\"},","+\t\t\t\t},","+\t\t\t},","+\t\t\tPort:        pointerTo(0),","+\t\t\tPatroniPort: pointerTo(0),","+\t\t\tNodes: []*api.DatabaseNodeSpec{","+\t\t\t\t{","+\t\t\t\t\tName:    \"n1\",","+\t\t\t\t\tHostIds: []api.Identifier{api.Identifier(host1)},","+\t\t\t\t},","+\t\t\t},","+\t\t},","+\t})","+","+\tinstance := db.Instances[0]","+","+\thost, err := fixture.Client.GetHost(ctx, &api.GetHostPayload{","+\t\tHostID: api.Identifier(instance.HostID),","+\t})","+\trequire.NoError(t, err)","+","+\ttLog(t, \"confirming an unrelated local OS account is denied over the socket\")","+\t_, err = runLocalPsql(t, host, instance, \"nobody\", \"select 1;\")","+\trequire.Error(t, err,","+\t\t\"an unrelated local OS account should not be able to connect as pgedge\")","+","+\ttLog(t, \"confirming the OS user Postgres runs as still reaches pgedge over the socket\")","+\tout, err := runLocalPsql(t, host, instance, \"postgres\", \"select current_user;\")","+\trequire.NoError(t, err,","+\t\t\"the postgres OS user should still authenticate as pgedge via peer\")","+\trequire.Contains(t, out, \"pgedge\")","+}","+","+// runLocalPsql runs `psql -U pgedge -d postgres -c <sql>` as the given local","+// OS user, directly against the instance's own Postgres process over the","+// Unix socket -- the same path pgBackRest and manual local psql use. Works","+// for both orchestrators: swarm execs into the instance's own container;","+// systemd execs on the host directly, since Postgres runs there natively.","+func runLocalPsql(t testing.TB, host *api.Host, instance *api.Instance, osUser, sql string) (string, error) {","+\tt.Helper()","+","+\tpsqlCmd := fmt.Sprintf(\"psql -U pgedge -d postgres -c %q\", sql)","+","+\tswitch host.Orchestrator {","+\tcase \"swarm\":","+\t\tcontainerName, err := fixture.RunCmdOnHost(instance.HostID, fmt.Sprintf(","+\t\t\t\"docker ps --filter label=pgedge.instance.id=%s --format '{{.Names}}'\", instance.ID))","+\t\tif err != nil {","+\t\t\treturn \"\", fmt.Errorf(\"failed to find postgres container: %w\", err)","+\t\t}","+\t\tcontainerName = strings.TrimSpace(containerName)","+\t\tif containerName == \"\" {","+\t\t\treturn \"\", fmt.Errorf(\"no postgres container found for instance %s\", instance.ID)","+\t\t}","+\t\treturn fixture.RunCmdOnHost(instance.HostID, fmt.Sprintf(","+\t\t\t\"docker exec --user %s %s %s\", osUser, containerName, psqlCmd))","+\tcase \"systemd\":","+\t\t// RunCmdOnHost already runs as root on systemd hosts (it's SSH-based),","+\t\t// so this becomes a (harmless) nested sudo, re-execing as osUser.","+\t\treturn fixture.RunCmdOnHost(instance.HostID, fmt.Sprintf(\"sudo -u %s %s\", osUser, psqlCmd))","+\tdefault:","+\t\treturn \"\", fmt.Errorf(\"unsupported orchestrator %q\", host.Orchestrator)","+\t}","+}","+"," // userRuleAddresses returns the addresses of the active pg_hba rules for"," // myapp_user, ordered by their position in the file."," func userRuleAddresses(ctx context.Context, t testing.TB, conn *pgx.Conn) []string {"],"additions":94,"deletions":2,"truncated":false},{"path":"server/internal/api/apiv1/validate.go","lines":["@@ -24,23 +24,6 @@ import ("," \t\"github.com/pgEdge/control-plane/server/internal/validation\""," )"," ","-// validateAuthFileGUCs rejects postgresql_conf settings that would make","-// user-supplied pg_hba_conf/pg_ident_conf entries ineffective. When hba_file","-// or ident_file is set, Patroni ignores the pg_hba/pg_ident arrays it manages,","-// so the control-plane-generated file (including user entries) would never be","-// written. GUC names are case-insensitive in PostgreSQL, so we compare lower.","-func validateAuthFileGUCs(conf map[string]any, path validation.Path) []error {","-\tvar errs []error","-\tfor key := range conf {","-\t\tswitch strings.ToLower(strings.TrimSpace(key)) {","-\t\tcase \"hba_file\", \"ident_file\":","-\t\t\terr := fmt.Errorf(\"%q is not allowed: it overrides the control-plane-managed pg_hba.conf/p