ailure_threshold']) || isset($v['delay']) || isset($v['multiplier']) || isset($v['max_delay']) || isset($v['jitter']))) {","+                                            throw new \\InvalidArgumentException('The \"service\" cannot be used along with the other \"cooldown_strategy\" options.');","+                                        }","+","+                                        return $v;","+                                    })","+                                ->end()","+                                ->children()","+                                    ->scalarNode('service')->defaultNull()->info('Service id to override the cooldown strategy entirely.')->end()","+                                    ->integerNode('failure_threshold')->defaultValue(5)->min(1)->info('Number of failures in a row that start a cooldown.')->end()","+                                    ->integerNode('delay')->defaultValue(1000)->min(0)->info('Duration in ms of the first cooldown (or the initial value when multiplier is used).')->end()","+                                    ->floatNode('multiplier')->defaultValue(2)->min(1)->info('If greater than 1, the cooldown will grow exponentially for each further failure in a row: this delay = (delay * (multiplier ^ (failures - failure_threshold))).')->end()","+                                    ->integerNode('max_delay')->defaultValue(60000)->min(0)->info('Max duration in ms of a cooldown (0 = infinite).')->end()","+                                    ->floatNode('jitter')->defaultValue(0.1)->min(0)->max(1)->info('Randomness to apply to the duration (between 0 and 1).')->end()","+                                ->end()","+                            ->end()","                             ->scalarNode('rate_limiter')","                                 ->defaultNull()","                                 ->info('Rate limiter name to use when processing messages.')","@@ -579,6 +604,7 @@ public function loadExtension(array $config, ContainerConfig