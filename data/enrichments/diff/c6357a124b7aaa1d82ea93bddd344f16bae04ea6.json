{"id":"c6357a124b7aaa1d82ea93bddd344f16bae04ea6","axis":"silent","repo":"symfony/symfony","sha":"c6357a124b7aaa1d82ea93bddd344f16bae04ea6","parsed":{"files":[{"path":"src/Symfony/Component/Messenger/CHANGELOG.md","lines":["@@ -66,6 +66,8 @@ CHANGELOG","  * Add `InboxInterface`, `InboxMiddleware` and the `inbox` option of transports to skip the handlers of the messages that the inbox of their transport recorded already","  * Make `DispatchAfterCurrentBusMiddleware` dispatch at once the messages sent only to outboxes, and refuse the other ones, while an inbox records the current message","  * Make the `messenger:setup-transports` command set up the inboxes of the transports","+ * Add the `cooldown_strategy` option of transports, `CooldownStrategyInterface`, `CooldownStatus`, `MultiplierCooldownStrategy` and `WorkerTransportCoolingDownEvent` to stop consuming a transport for a while after messages received from it fail or fetching from it fails","+ * Add the `$cooldownStrategies` argument to `Worker` and the `$cooldownStrategyLocator` argument to `ConsumeMessagesCommand`"," "," 8.1"," ---"],"additions":2,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Messenger/Command/ConsumeMessagesCommand.php","lines":["@@ -63,6 +63,7 @@ public function __construct(","         private ?ContainerInterface $rateLimiterLocator = null,","         private ?array $signals = null,","         private string $console = '',","+        private ?ContainerInterface $cooldownStrategyLocator = null,","     ) {","         parent::__construct();","     }","@@ -123,7 +124,8 @@ protected function configure(): void"," ","                 Use the <info>--stop-when-empty</info> option to handle the messages that are already in the","                 transports and exit instead of waiting for new ones. Delayed messages, including failed","-                messages that wait for their retry delay, are left in the transports:","+                messages that wait for their retry delay, are left in the transports, and so are the","+                messages of the transports cooling down after failures:"," ","                     <info>php %command.full_name% <receiver-name> --stop-when-empty</info>"," ","@@ -219,6 +221,7 @@ protected function execute(InputInterface $input, OutputInterface $output): int"," ","         $receivers = [];","         $rateLimiters = [];","+        $cooldownStrategies = [];","         if ($input->getOption('all')) {","             $receiverNames = $this->receiverNames;","         } else {","@@ -264,6 +267,10 @@ protected function execute(InputInterface $input, OutputInterface $output): int","             if ($this->rateLimiterLocator?->has($receiverName)) {","                 $rateLimiters[$receiverName] = $this->rateLimiterLocator->get($receiverName);","             }","+","+            if ($this->cooldownStrategyLocator?->has($receiverName)) {","+                $cooldownStrategies[$receiverName] = $this->cooldownStrategyLocator->get($receiverName);","+            }","         }"," ","         $resetInterval = match ($resetInterval = $input->getOption('no-reset')) {","@@ -363,7 +370,7 @@ protected function execute(InputInterface $input, OutputInterface $output): int","             }","         }"," ","-        $this->worker = new Worker($receivers, $bus, $eventDispatcher, $this->logger, $rateLimiters, new Clock(), $messageExecutionStrategy);","+        $this->worker = new Worker($receivers, $bus, $eventDispatcher, $this->logger, $rateLimiters, new Clock(), $messageExecutionStrategy, $cooldownStrategies);","         $options = [","             'sleep' => $input->getOption('sleep') * 1000000,","             'time_limit' => null !== $timeLimit ? (int) $timeLimit : null,"],"additions":9,"deletions":2,"truncated":false},{"path":"src/Symfony/Component/Messenger/Cooldown/CooldownStatus.php","lines":["@@ -0,0 +1,55 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\Messenger\\Cooldown;","+","+/**","+ * Tells whether a transport is cooling down, and until when if that is known.","+ */","+final class CooldownStatus","+{","+    private function __construct(","+        private bool $coolingDown,","+        private ?\\DateTimeImmutable $end = null,","+    ) {","+    }","+","+    public static function inactive(): self","+    {","+        return new self(false);","+    }","+","+    public static function until(\\DateTimeImmutable $end): self","+    {","+        return new self(true, $end);","+    }","+","+    /**","+     * The transport is cooling down, until a time that is not known.","+     */","+    public static function indefinite(): self","+    {","+        return new self(true);","+    }","+","+    public function isCoolingDown(): bool","+    {","+        return $this->coolingDown;","+    }","+","+    /**","+     * Returns when the cooldown ends, or null when the transport is not cooling down or the end is not known.","+     */","+    public function getEnd(): ?\\DateTimeImmutable","+    {","+        return $this->end;","+    }","+}"],"additions":55,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Messenger/Cooldown/CooldownStrategyInterface.php","lines":["@@ -0,0 +1,40 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\Messenger\\Cooldown;","+","+use Symfony\\Component\\Messenger\\Envelope;","+use Symfony\\Component\\Messenger\\Event\\WorkerMessageFailedEvent;","+","+/**","+ * Decides when a worker stops consuming a transport for a while, after messages received from it failed or fetching from it failed.","+ *","+ * The failed messages are retried or sent to the failure transport as usual. The cooldown keeps the worker","+ * from handling the next messages while the cause of the failures would make them fail too.","+ */","+interface CooldownStrategyInterface","+{","+    /**","+     * Checks whether the transport is cooling down.","+     *","+     * The worker calls it once, right before each fetch from the transport, and skips the transport while it is cooling down.","+     * This is where the strategy decides, so it may change its state, to grant a trial call for example. As a fetch can find","+     * no message, no recordSuccess() or recordFailure() call is guaranteed to follow.","+     */","+    public function checkStatus(string $transportName): CooldownStatus;","+","+    public function recordSuccess(string $transportName, Envelope $envelope): void;","+","+    /**","+     * @param Envelope|null $envelope The failed message, with the stamps added by the listeners of {@see WorkerMessageFailedEvent}, or null when fetching messages from the transport failed","+     */","+    public function recordFailure(string $transportName, ?Envelope $envelope, \\Throwable $throwable): void;","+}"],"additions":40,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Messenger/Cooldown/MultiplierCooldownStrategy.php","lines":["@@ -0,0 +1,161 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\Messenger\\Cooldown;","+","+use Psr\\Log\\LoggerInterface;","+use Symfony\\Component\\Clock\\Clock;","+use Symfony\\Component\\Clock\\ClockInterface;","+use Symfony\\Component\\Messenger\\Envelope;","+use Symfony\\Component\\Messenger\\Exception\\InvalidArgumentException;","+use Symfony\\Component\\Messenger\\Exception\\RecoverableExceptionInterface;","+use Symfony\\Component\\Messenger\\Exception\\RejectRedeliveredMessageException;","+use Symfony\\Component\\Messenger\\Exception\\UnrecoverableExceptionInterface;","+use Symfony\\Component\\Messenger\\Middleware\\RejectRedeliveredMessageMiddleware;","+use Symfony\\Component\\Messenger\\Retry\\RetryDecider;","+","+/**","+ * Cools a transport down once messages received from it, or fetching from it, failed a number of times in a row.","+ *","+ * For example, with $failureThreshold=3, $delayMilliseconds=1000 and $multiplier=2:","+ *      * 3 failures in a row: the transport cools down for 1 second","+ *      * 4 failures in a row: 2 seconds (1000 * 2 = 2000)","+ *      * 5 failures in a row: 4 seconds (2000 * 2 = 4000)","+ *","+ * A cooldown lasts at least the retry delay that the failure asks for through {@see RecoverableExceptionInterface::getRetryDelay()}, up to the maximum duration.","+ *","+ * A message handled successfully resets the count. Some failures are not counted:","+ *      * the ones that forbid a retry, as an {@see UnrecoverableExceptionInterface} does, because the message itself caused them","+ *      * the redeliveries rejected by {@see RejectRedeliveredMessageMiddleware}, because no handler ran","+ *      * the ones during a cooldown, because their messages were in flight when it started","+ *","+ * The count and the cooldowns are kept in memory, so each worker counts its own failures and cools down on its own.","+ */","+final class MultiplierCooldownStrategy implements CooldownStrategyInterface","+{","+    /**","+     * @var array<string, int>","+     */","+    private array $failureCounts = [];","+    /**","+     * @var array<string, float>","+     */","+    private array $cooldownEnds = [];","+","+    /**","+     * @param int   $failureThreshold     Number of failures in a row that start a cooldown","+     * @param int   $delayMilliseconds    Duration of the first cooldown (or the initial value when multiplier is used)","+     * @param float $multiplier           Multiplier to apply to the duration for each further failure in a row","+     * @param int   $maxDelayMilliseconds Maximum duration to allow (0 means no maximum)","+     * @param float $jitter               Randomness to apply to the duration (between 0 and 1)","+     */","+    public function __construct(","+        private int $failureThreshold = 5,","+        private int $delayMilliseconds = 1000,","+        private float $multiplier = 2,","+        private int $maxDelayMilliseconds = 60000,","+        private float $jitter = 0.1,","+        private ?LoggerInterface $logger = null,","+        private ClockInterface $clock = new Clock(),","+    ) {","+        if ($failureThreshold < 1) {","+            throw new InvalidArgumentException(\\sprintf('Failure threshold must be greater than zero: \"%s\" given.', $failureThreshold));","+        }","+","+        if ($delayMilliseconds < 0) {","+            throw new InvalidArgumentException(\\sprintf('Delay must be greater than or equal to zero: \"%s\" given.', $delayMilliseconds));","+        }","+","+        if ($multiplier < 1) {","+            throw new InvalidArgumentException(\\sprintf('Multiplier must be greater than or equal to one: \"%s\" given.', $multiplier));","+        }","+","+        if ($maxDelayMilliseconds < 0) {","+            throw new InvalidArgumentException(\\sprintf('Max delay must be greater than or equal to zero: \"%s\" given.', $maxDelayMilliseconds));","+        }","+","+        if ($jitter < 0 || $jitter > 1) {","+            throw new InvalidArgumentException(\\sprintf('Jitter must be between 0 and 1: \"%s\" given.', $jitter));","+        }","+    }","+","+    public function checkStatus(string $transportName): CooldownStatus","+    {","+        if (null === $end = $this->findCooldownEnd($transportName)) {","+            unset($this->cooldownEnds[$transportName]);","+","+            return CooldownStatus::inactive();","+        }","+","+        return CooldownStatus::until(\\DateTimeImmutable::createFromTimestamp($end));","+    }","+","+    public function recordSuccess(string $transportName, Envelope $envelope): void","+    {","+        unset($this->failureCounts[$transportName]);","+    }","+","+    public function recordFailure(string $transportName, ?Envelope $envelope, \\Throwable $throwable): void","+    {","+        if ($throwable instanceof RejectRedeliveredMessageException || false === RetryDecider::decideFromException($throwable) || null !== $this->findCooldownEnd($transportName)) {","+            return;","+        }","+","+        $failureCount = $this->failureCounts[$transportName] = ($this->failureCounts[$transportName] ?? 0) + 1;","+","+        if ($failureCount < $this->failureThreshold) {","+            return;","+        }","+","+        if (0 >= $delay = $this->getDelay($failureCount - $this->failureThreshold, $throwable)) {","+            return;","+        }","+","+        $this->cooldownEnds[$transportName] = $this->now() + $delay / 1000;","+","+        $this->logger?->warning('Transport {transport} cools down for {delay} ms after {count} failure(s) in a row.', [","+            'transport' => $transportName,","+            'delay' => $delay,","+            'count' => $failureCount,","+        ]);","+    }","+","+    private function getDelay(int $furtherFailures, \\Throwable $throwable): int","+    {","+        $delay = $this->delayMilliseconds * $this->multiplier ** $furtherFailures;","+","+        if ($this->jitter > 0) {","+            $randomness = (int) min(\\PHP_INT_MAX, $delay * $this->jitter);","+            $delay += random_int(-$randomness, +$randomness);","+        }","+","+        // the retry delay asked by the failure, like the \"Retry-After\" header of an API, is a minimum","+        $delay = max($delay, RetryDecider::getDelayFromException($throwable) ?? 0);","+","+        if ($delay > $this->maxDelayMilliseconds && 0 !== $this->maxDelayMilliseconds) {","+            return $this->maxDelayMilliseconds;","+        }","+","+        return (int) min(\\PHP_INT_MAX, ceil($delay));","+    }","+","+    private function findCooldownEnd(string $transportName): ?float","+    {","+        return ($this->cooldownEnds[$transportName] ?? 0) > $this->now() ? $this->cooldownEnds[$transportName] : null;","+    }","+","+    private function now(): float","+    {","+        $now = $this->clock->now();","+","+        return \\PHP_INT_SIZE >= 8 ? $now->getTimestamp() + $now->getMicrosecond() / 1e6 : (float) $now->format('U.u');","+    }","+}"],"additions":161,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Messenger/Event/WorkerTransportCoolingDownEvent.php","lines":["@@ -0,0 +1,39 @@","+<?php","+","+/*","+ * This file is part of the Symfony package.","+ *","+ * (c) Fabien Potencier <fabien@symfony.com>","+ *","+ * For the full copyright and license information, please view the LICENSE","+ * file that was distributed with this source code.","+ */","+","+namespace Symfony\\Component\\Messenger\\Event;","+","+use Symfony\\Component\\Messenger\\Cooldown\\CooldownStatus;","+","+/**","+ * Dispatched when the worker starts skipping a transport because its cooldown strategy says it is cooling down.","+ *","+ * It is dispatched once each time the worker starts skipping the transport, not for each fetch it skips, so a cooldown","+ * that ends before the worker gets back to the transport is not reported.","+ */","+final class WorkerTransportCoolingDownEvent","+{","+    public function __construct(","+        private string $transportName,","+        private CooldownStatus $status,","+    ) {","+    }","+","+    public function getTransportName(): string","+    {","+        return $this->transportName;","+    }","+","+    public function getStatus(): CooldownStatus","+    {","+        return $this->status;","+    }","+}"],"additions":39,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Messenger/EventListener/SendFailedMessageForRetryListener.php","lines":["@@ -18,8 +18,6 @@"," use Symfony\\Component\\Messenger\\Envelope;"," use Symfony\\Component\\Messenger\\Event\\WorkerMessageFailedEvent;"," use Symfony\\Component\\Messenger\\Event\\WorkerMessageRetriedEvent;","-use Symfony\\Component\\Messenger\\Exception\\HandlerFailedException;","-use Symfony\\Component\\Messenger\\Exception\\RecoverableExceptionInterface;"," use Symfony\\Component\\Messenger\\Exception\\RuntimeException;"," use Symfony\\Component\\Messenger\\Retry\\RetryDecider;"," use Symfony\\Component\\Messenger\\Retry\\RetryStrategyInterface;","@@ -115,25 +113,7 @@ public static function getSubscribedEvents(): array"," ","     private function getWaitingTime(Envelope $envelope, \\Throwable $throwable, RetryStrategyInterface $retryStrategy): int","     {","-        $delay = null;","-        if ($throwable instanceof RecoverableExceptionInterface) {","-            $delay = $throwable->getRetryDelay();","-        }","-","-        if ($throwable instanceof HandlerFailedException) {","-            foreach ($throwable->getWrappedExceptions() as $nestedException) {","-                if (!$nestedException instanceof RecoverableExceptionInterface","-                    || 0 > $retryDelay = $nestedException->getRetryDelay() ?? -1","-                ) {","-                    continue;","-                }","-                if ($retryDelay < ($delay ?? \\PHP_INT_MAX)) {","-                    $delay = $retryDelay;","-                }","-            }","-        }","-","-        return $delay ?? $retryStrategy->getWaitingTime($envelope, $throwable);","+        return RetryDecider::getDelayFromException($throwable) ?? $retryStrategy->getWaitingTime($envelope, $throwable);","     }"," ","     private function getRetryStrategyForTransport(string $alias): ?RetryStrategyInterface"],"additions":1,"deletions":21,"truncated":false},{"path":"src/Symfony/Component/Messenger/MessengerBundle.php","lines":["@@ -21,6 +21,7 @@"," us