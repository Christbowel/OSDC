                       ])","+                        ->addTag('monolog.logger', ['channel' => 'messenger']));","+","+                    $transportCooldownReferences[$name] = new Reference($cooldownServiceId);","+                }","+            }","+","             if ($transport['rate_limiter']) {","                 if (!interface_exists(LimiterInterface::class)) {","                     throw new LogicException('Rate limiter cannot be used within Messenger as the RateLimiter component is not installed. Try running \"composer require symfony/rate-limiter\".');","@@ -767,6 +816,9 @@ public function loadExtension(array $config, ContainerConfigurator $configurator","         $container->getDefinition('messenger.retry_strategy_locator')","             ->replaceArgument(0, $transportRetryReferences);"," ","+        $container->getDefinition('messenger.cooldown_strategy_locator')","+            ->replaceArgument(0, $transportCooldownReferences);","+","         $failureTransportsByTransportNameServiceLocator = ServiceLocatorTagPass::register($container, $failureTransportReferencesByTransportName);","         $container->getDefinition('messenger.transport.sync.factory')","             ->replaceArgument(2, $failureTransportsByTransportNameServiceLocator);"],"additions":52,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Messenger/Resources/config/console.php","lines":["@@ -35,6 +35,7 @@","                 service('messenger.rate_limiter_locator')->nullOnInvalid(),","                 null,","                 param('kernel.project_dir').'/bin/console',","+                service('messenger.cooldown_strategy_locator'),","             ])","             ->tag('console.command')","             ->tag('monolog.logger', ['channel' => 'messenger'])"],"additions":1,"deletions":0,"truncated":false},{"path":"src/Symfony/Component/Messenger/Resources/config/messenger.php","lines":["@@ -302,6 +302,11 @@ class_exists(LazyString::class, false) ? service_closure('.messenger.s