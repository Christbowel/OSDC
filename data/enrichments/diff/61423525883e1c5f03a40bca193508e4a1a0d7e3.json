dKey serialized_key = serializeKey(key);","   absl::WriterMutexLock lock(mu_);","-  entries_.erase(key);","+  entries_.erase(serialized_key);"," }"," "," void SimpleHttpCache::updateHeaders(Event::Dispatcher&, const Key& key,","                                     const Http::ResponseHeaderMap& updated_headers,","                                     const ResponseMetadata& updated_metadata) {","+  const SerializedKey serialized_key = serializeKey(key);","   absl::WriterMutexLock lock(mu_);","-  auto it = entries_.find(key);","+  auto it = entries_.find(serialized_key);","   if (it == entries_.end()) {","     return;","   }","@@ -203,9 +206,10 @@ void SimpleHttpCache::insert(Event::Dispatcher&, Key key, Http::ResponseHeaderMa","                              std::shared_ptr<CacheProgressReceiver> progress) {","   auto entry = std::make_shared<Entry>(Http::createHeaderMap<Http::ResponseHeaderMapImpl>(*headers),","                                        std::move(metadata));","+  SerializedKey serialized_key = serializeKey(key);","   {","     absl::WriterMutexLock lock(mu_);","-    entries_.emplace(key, entry);","+    entries_.emplace(std::move(serialized_key), entry);","   }","   if (source) {","     progress->onHeadersInserted(std::make_unique<SimpleHttpCacheReader>(entry), std::move(headers),"],"additions":8,"deletions":4,"truncated":false},{"path":"source/extensions/http/cache_v2/simple_http_cache/simple_http_cache.h","lines":["@@ -1,6 +1,5 @@"," #pragma once"," ","-#include \"source/common/protobuf/utility.h\""," #include \"source/extensions/filters/http/cache_v2/http_cache.h\""," "," #include \"absl/base/thread_annotations.h\"","@@ -54,8 +53,7 @@ class SimpleHttpCache : public HttpCache {","               std::shared_ptr<CacheProgressReceiver> progress) override;"," ","   absl::Mutex mu_;","-  absl::flat_hash_map<Key, std::shared_ptr<Entry>, MessageUtil, MessageUtil>","-      entries_ ABSL_GUARDED_BY(mu_);","+  absl::flat_hash_map<SerializedKey, std::shared_ptr<Entry>> entries_ ABSL_GUARDED_BY(mu_);"," };"," "," } // namespace CacheV2"],"additions":1,"deletions":3,"truncated":false},{"path":"test/extensions/filters/http/cache_v2/cache_sessions_test.cc","lines":["@@ -306,6 +306,72 @@ TEST_F(CacheSessionsTest, CacheSessionsEntriesExpireOnAdjacentLookup) {","   EXPECT_THAT(captured_lookup_callbacks_.size(), Eq(3));"," }"," ","+TEST_F(CacheSessionsTest, CacheSessionsEntryExpiresOnLookupsOfOtherResources) {","+  const std::vector<std::string> paths{\"/a\", \"/b\", \"/c\", \"/d\", \"/e\", \"/f\", \"/g\", \"/h\"};","+  for (const std::string& path : paths) {","+    // Each path is looked up in the cache when its entry is created, and again when the entry is","+    // created after it expired.","+    EXPECT_CALL(*mock_http_cache_, lookup(LookupHasPath(path), _)).Times(2);","+    EXPECT_CALL(*mock_http_cache_, touch(KeyHasPath(path), _)).Times(2 * paths.size());","+    cache_sessions_->lookup(testLookupRequest(path), [](ActiveLookupResultPtr) {});","+  }","+  pumpDispatcher();","+  auto entries = mock_factory_context_.server_factory_context_.store_.findGaugeByString(","+      \"cache.cache_sessions_entries.cache_label.mock_cache\");","+  ASSERT_TRUE(entries.has_value());","+  EXPECT_EQ(entries.value().get().value(), paths.size());","+  // Each path takes a turn as the only expired entry, so the test does not depend on where the","+  // table puts any one entry.","+  for (const std::string& stale : paths) {","+    SCOPED_TRACE(stale);","+    advanceTime(std::chrono::minutes(4));","+    for (const std::string& path : paths) {","+      if (path != stale) {","+        cache_sessions_->lookup(testLookupRequest(path), [](ActiveLookupResultPtr) {});","+      }","+    }","+    // Entries expire 5 minutes after their last request, so only the stale one has expired.","+    advanceTime(std::chrono::minutes(2));","+    // Each request removes the entry after the one it touches if that entry has expired.","+    for (const std::string& path : paths) {","+      if (path != stale) {","+        cache_sessions_->lookup(testLookupRequest(path), [](ActiveLookupResultPtr) {});","+      }","+    }","+    EXPECT_EQ(entries.value().get().value(), paths.size() - 1);","+    pumpDispatcher();","+    const size_t lookups = captured_lookup_callbacks_.size();","+    // The expired entry was removed, so this request has a new lookup.","+    cache_sessions_->lookup(testLookupRequest(stale), [](ActiveLookupResultPtr) {});","+    pumpDispatcher();","+    EXPECT_EQ(captured_lookup_callbacks_.size(), lookups + 1);","+    EXPECT_EQ(entries.value().get().value(), paths.size());","+  }","+}","+","+TEST_F(CacheSessionsTest, CacheSessionsEntryExpiresOnLookupOfNewResource) {","+  constexpr size_t lookups = 9;","+  for (size_t i = 0; i < lookups; i++) {","+    const std::string path = absl::StrCat(\"/\", i);","+    EXPECT_CALL(*mock_http_cache_, lookup(LookupHasPath(path), _));","+    EXPECT_CALL(*mock_http_cache_, touch(KeyHasPath(path), _));","+  }","+  auto entries = mock_factory_context_.server_factory_context_.store_.findGaugeByString(","+      \"cache.cache_sessions_entries.cache_label.mock_cache\");","+  ASSERT_TRUE(entries.has_value());","+  cache_sessions_->lookup(testLookupRequest(\"/0\"), [](ActiveLookupResultPtr) {});","+  // Each request creates a new entry after the previous one expired. In a table of two entries","+  // the entry after the new one is always the old one, so each request removes it.","+  for (size_t i = 1; i < lookups; i++) {","+    SCOPED_TRACE(i);","+    advanceTime(std::chrono::minutes(6));","+    cache_sessions_->lookup(testLookupRequest(absl::StrCat(\"/\", i)), [](ActiveLookupResultPtr) {});","+    EXPECT_EQ(entries.value().get().value(), 1U);","+  }","+  pumpDispatcher();","+  EXPECT_THAT(captured_lookup_callbacks_.size(), Eq(lookups));","+}","+"," TEST_F(CacheSessionsTest, CacheDeletionDuringLookupStillCompletesLookup) {","   EXPECT_CALL(*mock_http_cache_, lookup(LookupHasPath(\"/a\"), _));","   EXPECT_CALL(*mock_http_cache_, touch(KeyHasPath(\"/a\"), _));",""],"additions":66,"deletions":0,"truncated":false}],"additions":130,"deletions":35,"truncated":false,"file_count":16},"error":null,"fetched_at":"2026-11-23T19:31:50.055476+00:00"}