{"id":"b104ce8feff8918fd40d6e51825a5a85f81c73a8","axis":"silent","repo":"pnpm/pnpm","sha":"b104ce8feff8918fd40d6e51825a5a85f81c73a8","parsed":{"files":[{"path":".changeset/read-ca-array-entries-in-npmrc.md","lines":["@@ -0,0 +1,5 @@","+---","+\"pnpm\": patch","+---","+","+pnpm now trusts the certificate authorities listed with `ca[]=` in `.npmrc`, the array form the `ca` setting documents. They were ignored, so requests to a registry with a private certificate authority failed with `invalid peer certificate: UnknownIssuer`."],"additions":5,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/npmrc_auth/ini.rs","lines":["@@ -181,6 +181,8 @@ impl NpmrcAuth {","             else {","                 continue;","             };","+            // npm reads `ca[]=` as one entry of the `ca` array.","+            let key = if key == \"ca[]\" { \"ca\".to_string() } else { key };"," ","             // Capture every auth/scoped/per-registry key verbatim for","             // `pnpm config get` / `list`, independent of the structured"],"additions":2,"deletions":0,"truncated":false},{"path":"pnpm/crates/config/src/npmrc_auth/tests/behavior.rs","lines":["@@ -400,6 +400,30 @@ fn parses_inline_ca_from_ini() {","     assert_eq!(auth.tls.ca.len(), 1, \"auth.tls.ca={:?}\", auth.tls.ca);"," }"," ","+#[test]","+fn ca_array_entries_are_trusted_like_ca() {","+    let auth = NpmrcAuth::from_ini::<NoEnv>(\"ca[]=first-ca\\nca[]=second-ca\\n\", Path::new(\"\"));","+    let mut config = Config::new();","+    auth.apply_to::<NoEnv>(&mut config);","+    assert_eq!(config.tls.ca, vec![\"first-ca\", \"second-ca\"]);","+}","+","+#[test]","+fn ca_array_entry_is_shown_as_ca_by_config_get() {","+    let auth = NpmrcAuth::from_ini::<NoEnv>(\"ca[]=only-ca\\n\", Path::new(\"\"));","+    assert_eq!(auth.raw_ini_config.get(\"ca\").map(String::as_str), Some(\"only-ca\"));","+    assert!(!auth.raw_ini_config.contains_key(\"ca[]\"));","+}","+","+#[test]","+fn ca_and_ca_array_entries_accumulate_in_file_order() {","+    let auth =","+        NpmrcAuth::from_ini::<NoEnv>(\"ca=first-ca\\nca[]=second-ca\\nca=third-ca\\n\", Path::new(\"\"));","+    let mut config = Config::new();","+    auth.apply_to::<NoEnv>(&mut config);","+    assert_eq!(config.tls.ca, vec![\"first-ca\", \"second-ca\", \"third-ca\"]);","+}","+"," #[test]"," fn parses_strict_ssl_true_and_false() {","     assert_eq!(",""],"additions":24,"deletions":0,"truncated":false}],"additions":31,"deletions":0,"truncated":false,"file_count":3},"error":null,"fetched_at":"2026-11-27T19:03:05.378159+00:00"}