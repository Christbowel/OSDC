{"id":"2bd8848f1763436bf89c674ddd530e02e914c645","axis":"silent","repo":"strapi/strapi","sha":"2bd8848f1763436bf89c674ddd530e02e914c645","parsed":{"files":[{"path":"docs/docs/packages/core/content-type-builder/index.md","lines":["@@ -32,7 +32,7 @@ After the files are written, CTB emits `content-type.create|update|delete` and `"," "," ### Reload after a write"," ","-After a successful update, the `schema` controller sets `strapi.reload.isWatching` to `false` and calls `strapi.reload()` in a `setImmediate`. The reloader sends a `reload` message to the parent process of `strapi develop`, which restarts the server. The route `GET /update-schema-status` returns `isUpdating`. The admin polls it with `useServerRestartWatcher` until the server is back.","+After a successful update, the `schema` controller sets `strapi.reload.isWatching` to `false` and calls `strapi.reload()` in a `setImmediate`. The reloader sends a `reload` message to the parent process of `strapi develop`, which restarts the server. The route `GET /update-schema-status` returns `isUpdating`. The admin polls it with `useServerRestartWatcher` until the server is back. When the update throws, the server does not restart. The controller calls `strapi.reload.resumeWatching()`, so file edits restart the server again, and sets `isUpdating` back to `false`. The other write controllers (`content-types`, `components`, `component-categories`) do the same. Do not set `isWatching` back to `true` instead: going from `false` to `true` makes the reloader skip the next `strapi.reload()`, so the next successful save would not restart the server."," "," ### Development-only writes"," "],"additions":1,"deletions":1,"truncated":false},{"path":"packages/core/content-type-builder/server/src/controllers/__tests__/reloader.test.utils.ts","lines":["@@ -0,0 +1,49 @@","+import { vi } from 'vitest';","+","+/**","+ * Reproduces `createReloader` from `@strapi/core` (`packages/core/core/src/services/reloader.ts`),","+ * including the skip that the `isWatching` setter queues when it goes from `false` to `true`.","+ * `send` stands for `process.send('reload')`, which restarts the server.","+ */","+export const createReloader = () => {","+  const send = vi.fn();","+  const state = { shouldReload: 0, isWatching: true };","+","+  const reload = Object.assign(","+    vi.fn(() => {","+      if (state.shouldReload > 0) {","+        state.shouldReload -= 1;","+        return;","+      }","+","+      send('reload');","+    }),","+    {","+      isReloading: false,","+      isWatching: true,","+      resumeWatching: vi.fn(() => {","+        state.isWatching = true;","+      }),","+    }","+  );","+","+  Object.defineProperty(reload, 'isWatching', {","+    set(value: boolean) {","+      if (state.isWatching === false && value === true) {","+        state.shouldReload += 1;","+      }","+      state.isWatching = value;","+    },","+    get() {","+      return state.isWatching;","+    },","+  });","+","+  return { reload, send };","+};","+","+// Controllers schedule the reload in a `setImmediate` after a successful write","+export const flushReload = () =>","+  new Promise((resolve) => {","+    setImmediate(resolve);","+  });"],"additions":49,"deletions":0,"truncated":false},{"path":"packages/core/content-type-builder/server/src/controllers/__tests__/schema.vitest.test.ts","lines":["@@ -0,0 +1,91 @@","+import { describe, it, expect, vi, beforeEach } from 'vitest';","+import type { Context } from 'koa';","+","+import createSchemaController from '../schema';","+import { createReloader, flushReload } from './reloader.test.utils';","+","+const schemaService = vi.hoisted(() => ({","+  updateSchema: vi.fn(),","+}));","+","+const validateUpdateSchema = vi.hoisted(() => vi.fn());","+","+vi.mock('../../utils', () => ({ getService: vi.fn(() => schemaService) }));","+vi.mock('../validation/schema', () => ({ validateUpdateSchema }));","+","+const data = {","+  components: [],","+  contentTypes: [{ action: 'update', uid: 'api::article.article', attributes: [] }],","+  contentStructure: undefined,","+};","+","+const createContext = () =>","+  ({","+    request: { body: { data } },","+    send: vi.fn(),","+    conflict: vi.fn(),","+  }) as unknown as Context;","+","+describe('schema controller', () => {","+  let reloader: ReturnType<typeof createReloader>;","+","+  beforeEach(() => {","+    vi.clearAllMocks();","+    validateUpdateSchema.mockResolvedValue({ data });","+    reloader = createReloader();","+    (global as any).strapi = { reload: reloader.reload };","+  });","+","+  describe('updateSchema', () => {","+    it('turns the file watcher back on when the update is refused', async () => {","+      schemaService.updateSchema.mockRejectedValueOnce(new Error('refused'));","+      const controller = createSchemaController();","+      const ctx = createContext();","+","+      await controller.updateSchema(ctx);","+","+      expect(ctx.send).toHaveBeenCalledWith({ error: 'refused' }, 400);","+      expect(reloader.reload.isWatching).toBe(true);","+    });","+","+    it('restarts the server after a valid update that follows a refused one', async () => {","+      schemaService.updateSchema.mockRejectedValueOnce(new Error('refused'));","+      const controller = createSchemaController();","+","+      await controller.updateSchema(createContext());","+      const ctx = createContext();","+      await controller.updateSchema(ctx);","+      await flushReload();","+","+      expect(ctx.conflict).not.toHaveBeenCalled();","+      expect(schemaService.updateSchema).toHaveBeenCalledTimes(2);","+      expect(reloader.send).toHaveBeenCalledWith('reload');","+    });","+","+    it('keeps the watcher off until the server restarts after a successful update', async () => {","+      schemaService.updateSchema.mockResolvedValueOnce(undefined);","+      const controller = createSchemaController();","+      const ctx = createContext();","+","+      await controller.updateSchema(ctx);","+      await flushReload();","+","+      expect(ctx.body).toEqual({});","+      expect(reloader.reload.isWatching).toBe(false);","+      expect(reloader.send).toHaveBeenCalledTimes(1);","+    });","+","+    it('leaves the watcher alone when the payload is invalid', async () => {","+      reloader.reload.isWatching = false;","+      validateUpdateSchema.mockRejectedValueOnce(new Error('invalid'));","+      const controller = createSchemaController();","+      const ctx = createContext();","+","+      await controller.updateSchema(ctx);","+","+      expect(ctx.send).toHaveBeenCalledWith({ error: 'invalid' }, 400);","+      expect(schemaService.updateSchema).not.toHaveBeenCalled();","+      expect(reloader.reload.isWatching).toBe(false);","+    });","+  });","+});"],"additions":91,"deletions":0,"truncated":false},{"path":"packages/core/content-type-builder/server/src/controllers/__tests__/write-controllers.vitest.test.ts","lines":["@@ -0,0 +1,151 @@","+import { describe, it, expect, vi, beforeEach } from 'vitest';","+import type { Context } from 'koa';","+","+import contentTypesController from '../content-types';","+import componentsController from '../components';","+import componentCategoriesController from '../component-categories';","+import { createReloader, flushReload } from './reloader.test.utils';","+","+const services = vi.hoisted(() => ({","+  'content-types': {","+    createContentType: vi.fn(),","+    editContentType: vi.fn(),","+    deleteContentType: vi.fn(),","+  },","+  components: {","+    createComponent: vi.fn(),","+    editComponent: vi.fn(),","+    deleteComponent: vi.fn(),","+  },","+  'component-categories': {","+    editCategory: vi.fn(),","+    deleteCategory: vi.fn(),","+  },","+}));","+","+vi.mock('../../utils', () => ({","+  getService: vi.fn((name: keyof typeof services) => services[name]),","+}));","+vi.mock('../validation/content-type', () => ({","+  validateContentTypeInput: vi.fn(),","+  validateUpdateContentTypeInput: vi.fn(),","+  validateKind: vi.fn(),","+}));","+vi.mock('../validation/component', () => ({","+  validateComponentInput: vi.fn(),","+  validateUpdateComponentInput: vi.fn(),","+}));","+vi.mock('../validation/component-category', () => ({ default: vi.fn() }));","+","+const createContext = (params: Record<string, string> = {}) =>","+  ({","+    params,","+    request: { body: {} },","+    send: vi.fn(),","+  }) as unknown as Context;","+","+type Case = {","+  name: string;","+  run: (ctx: Context) => Promise<unknown>;","+  params: Record<string, string>;","+  write: ReturnType<typeof vi.fn>;","+  success: unknown;","+};","+","+const cases: Case[] = [","+  {","+    name: 'createContentType',","+    run: (ctx) => contentTypesController.createContentType(ctx),","+    params: {},","+    write: services['content-types'].createContentType,","+    success: { uid: 'api::article.article', kind: 'collectionType' },","+  },","+  {","+    name: 'updateContentType',","+    run: (ctx) => contentTypesController.updateContentType(ctx),","+    params: { uid: 'api::article.article' },","+    write: services['content-types'].editContentType,","+    success: { uid: 'api::article.article' },","+  },","+  {","+    name: 'deleteContentType',","+    run: (ctx) => contentTypesController.deleteContentType(ctx),","+    params: { uid: 'api::article.article' },","+    write: services['content-types'].deleteContentType,","+    success: { uid: 'api::article.article' },","+  },","+  {","+    name: 'createComponent',","+    run: (ctx) => componentsController.createComponent(ctx),","+    params: {},","+    write: services.components.createComponent,","+    success: { uid: 'default.seo' },","+  },","+  {","+    name: 'updateComponent',","+    run: (ctx) => componentsController.updateComponent(ctx),","+    params: { uid: 'default.seo' },","+    write: services.components.editComponent,","+    success: { uid: 'default.seo' },","+  },","+  {","+    name: 'deleteComponent',","+    run: (ctx) => componentsController.deleteComponent(ctx),","+    params: { uid: 'default.seo' },","+    write: services.components.deleteComponent,","+    success: { uid: 'default.seo' },","+  },","+  {","+    // A refused category write throws to the error middleware","+    name: 'editCategory',","+    run: (ctx) => componentCategoriesController.editCategory(ctx).catch(() => {}),","+    params: { name: 'default' },","+    write: services['component-categories'].editCategory,","+    success: 'renamed',","+  },","+  {","+    name: 'deleteCategory',","+    run: (ctx) => componentCategoriesController.deleteCategory(ctx).catch(() => {}),","+    params: { name: 'default' },","+    write: services['component-categories'].deleteCategory,","+    success: undefined,","+  },","+];","+","+describe('content-type-builder write controllers', () => {","+  let reloader: ReturnType<typeof createReloader>;","+","+  beforeEach(() => {","+    vi.clearAllMocks();","+    reloader = createReloader();","+    (global as any).strapi = {","+      reload: reloader.reload,","+      contentTypes: { 'api::article.article': {} },","+      components: { 'default.seo': {} },","+      apis: {},","+      log: { error: vi.fn() },","+      telemetry: { send: vi.fn(() => Promise.resolve()) },","+    };","+  });","+","+  describe.each(cases)('$name', ({ run, params, write, success }) => {","+    it('turns the file watcher back on when the write is refused', async () => {","+      write.mockRejectedValueOnce(new Error('refused'));","+","+      await run(createContext(params));","+","+      expect(reloader.reload.isWatching).toBe(true);","+      expect(reloader.send).not.toHaveBeenCalled();","+    });","+","+    it('restarts the server after a valid write that follows a refused one', async () => {","+      write.mockRejectedValueOnce(new Error('refused')).mockResolvedValueOnce(success);","+","+      await run(createContext(params));","+      await run(createContext(params));","+      await flushReload();","+      // createContentType waits for telemetry before it reloads","+      await vi.waitFor(() => expect(reloader.send).toHaveBeenCalledWith('reload'));","+    });","+  });","+});"],"additions":151,"deletions":0,"truncated":false},{"path":"packages/core/content-type-builder/server/src/controllers/component-categories.ts","lines":["@@ -18,11 +18,17 @@ export default {"," ","     const componentCategoryService = getService('component-categories');"," ","-    const newName = await componentCategoryService.editCategory(name, body);","+    try {","+      const newName = await componentCategoryService.editCategory(name, body);"," ","-    setImmediate(() => strapi.reload());","+      setImmediate(() => strapi.reload());"," ","-    ctx.send({ name: newName });","+      ctx.send({ name: newName });","+    } catch (error) {","+      // The server will not restart, so hand file changes back to the watcher","+      strapi.reload.resumeWatching();","+      throw error;","+    }","   },"," ","   async deleteCategory(ctx: Context) {","@@ -32,10 +38,16 @@ export default {"," ","     const componentCategoryService = getService('component-categories');"," ","-    await componentCategoryService.deleteCategory(name);","+    try {","+      await componentCategoryService.deleteCategory(name);"," ","-    setImmediate(() => strapi.reload());","+      setImmediate(() => strapi.reload());"," ","-    ctx.send({ name });","+      ctx.send({ name });","+    } catch (error) {","+      // The server will not restart, so hand file changes back to the watcher","+      strapi.reload.resumeWatching();","+      throw error;","+    }","   },"," };"],"additions":18,"deletions":6,"truncated":false},{"path":"packages/core/content-type-builder/server/src/controllers/components.ts","lines":["@@ -73,6 +73,10 @@ export default {","       ctx.send({ data: { uid: component.uid } }, 201);","     } catch (error) {","       strapi.log.error(error);","+","+      // The server will not restart, so hand file changes back to the watcher","+      strapi.reload.resumeWatching();","+","       ctx.send({ error: (error as any)?.message || 'Unknown error' }, 400);","     }","   },","@@ -112,6 +116,9 @@ export default {","     } catch (error) {","       strapi.log.error(error);"," ","+      // The server will not restart, so hand file changes back to the watcher","+      strapi.reload.resumeWatching();","+","       ctx.send({ error: (error as any)?.message || 'Unknown error' }, 400);","     }","   },","@@ -140,6 +147,10 @@ export default {","       ctx.send({ data: { uid: component.uid } });","     } catch (error) {","       strapi.log.error(error);","+","+      // The server will not restart, so hand file changes back to the watcher","+      strapi.reload.resumeWatching();","+","       ctx.send({ error: (error as any)?.message || 'Unknown error' }, 400);","     }","   },"],"additions":11,"deletions":0,"truncated":false},{"path":"packages/core/content-type-builder/server/src/controllers/content-types.ts","lines":["@@ -112,6 +112,10 @@ export default {","       ctx.send({ data: { uid: contentType.uid } }, 201);","     } catch (err) {","       strapi.log.error(err);","+","+      // The server will not restart, so hand file changes back to the watcher","+      strapi.reload.resumeWatching();","+","       strapi.telemetry","         .send('didNotCreateContentType', {","           eventProperties: { error: (err as Error).message || err },","@@ -150,6 +154,10 @@ export default {","       ctx.send({ data: { uid: component.uid } }, 201);","     } catch (error) {","       strapi.log.error(error);","+","+      // The server will not restart, so hand file changes back to the watcher","+      strapi.reload.resumeWatching();","+","       ctx.send({ error: (error as Error)?.message || 'Unknown error' }, 400);","     }","   },","@@ -173,6 +181,10 @@ export default {","       ctx.send({ data: { uid: component.uid } });","     } catch (error) {","       strapi.log.error(error);","+","+      // The server will not restart, so hand file changes back to the watcher","+      strapi.reload.resumeWatching();","+","       ctx.send({ error: (error as Error)?.message || 'Unknown error' }, 400);","     }","   },"],"additions":12,"deletions":0,"truncated":false},{"path":"packages/core/content-type-builder/server/src/controllers/schema.ts","lines":["@@ -46,6 +46,11 @@ export default () => {"," ","         ctx.body = {};","       } catch (error) {","+        // The server will not restart, so hand file changes back to the watcher","+        if (internals.isUpdating === true) {","+          strapi.reload.resumeWatching();","+        }","+","         internals.isUpdating = false;","         const errorMessage = error instanceof Error ? error.message : String(error);","         return ctx.send({ error: errorMessage }, 400);"],"additions":5,"deletions":0,"truncated":false},{"path":"packages/core/core/src/services/__tests__/reloader.vitest.test.ts","lines":["@@ -0,0 +1,70 @@","+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';","+import type { Core } from '@strapi/types';","+","+import { createReloader } from '../reloader';","+","+const createStrapi = () =>","+  ({","+    config: { get: vi.fn((key: string) => key === 'autoReload') },","+  }) as unknown as Core.Strapi;","+","+describe('reloader', () => {","+  const originalSend = process.send;","+  let send: ReturnType<typeof vi.fn>;","+","+  beforeEach(() => {","+    send = vi.fn();","+    process.send = send as unknown as typeof process.send;","+  });","+","+  afterEach(() => {","+    process.send = originalSend;","+  });","+","+  it('sends a reload message to the parent process', () => {","+    const reload = createReloader(createStrapi());","+","+    reload();","+","+    expect(send).toHaveBeenCalledWith('reload');","+  });","+","+  it('skips the next reload when watching is set back to true', () => {","+    const reload = createReloader(createStrapi());","+","+    reload.isWatching = false;","+    reload.isWatching = true;","+    reload();","+","+    expect(send).not.toHaveBeenCalled();","+","+    reload();","+","+    expect(send).toHaveBeenCalledTimes(1);","+  });","+","+  describe('resumeWatching', () => {","+    it('turns watching back on', () => {","+      const reload = createReloader(createStrapi());","+","+      reload.isWatching = false;","+      reload.resumeWatching();","+","+      expect(reload.isWatching).toBe(true);","+    });","+","+    it('does not skip the next reload', () => {","+      const reload = createReloader(createStrapi());","+","+      // A refused write turns watching off, then back on","+      reload.isWatching = false;","+      reload.resumeWatching();","+","+      // The next accepted write turns watching off, then reloads","+      reload.isWatching = false;","+      reload();","+","+      expect(send).toHaveBeenCalledWith('reload');","+    });","+  });","+});"],"additions":70,"deletions":0,"truncated":false},{"path":"packages/core/core/src/services/reloader.ts","lines":["@@ -34,6 +34,12 @@ export const createReloader = (strapi: Core.Strapi) => {","     },","   });"," ","+  // Turn watching back on without skipping the next reload.","+  // Use it when the write that turned watching off was refused, so no restart is pending.","+  reload.resumeWatching = () => {","+    state.isWatching = true;","+  };","+","   reload.isReloading = false;","   reload.isWatching = true;"," "],"additions":6,"deletions":0,"truncated":false},{"path":"packages/core/types/src/core/strapi.ts","lines":["@@ -194,6 +194,11 @@ export interface Strapi extends Container {"," export interface Reloader {","   isReloading: boolean;","   isWatching: boolean;","+  /**","+   * Turns file watching back on without skipping the next reload.","+   * Setting `isWatching` from `false` to `true` skips the next `reload()` call instead.","+   */","+  resumeWatching(): void;","   (): void;"," }"," ",""],"additions":5,"deletions":0,"truncated":false}],"additions":419,"deletions":7,"truncated":false,"file_count":11},"error":null,"fetched_at":"202