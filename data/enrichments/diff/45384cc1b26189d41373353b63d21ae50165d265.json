s,","+  VAULT_SHARE_VALUATION_CACHE_LIMIT,","+  writeCachedVaultShareValuations,","+} from './vault-share-valuation-cache';","+import type { VaultShareValuationCacheEntry } from './vault-share-valuations';","+","+jest.mock('../storage-helpers', () => ({","+  getStorageItem: jest.fn(),","+  setStorageItem: jest.fn(),","+}));","+","+const getStorageItemMock = jest.mocked(getStorageItem);","+const setStorageItemMock = jest.mocked(setStorageItem);","+","+const entry = (index: number): VaultShareValuationCacheEntry => ({","+  account: '0xaccount',","+  chainId: 143,","+  vaultAddress: '0xvault',","+  txHash: `0x${index.toString(16).padStart(64, '0')}`,","+  valuations: [","+    {","+      type: 'transfer_out',","+      blockNumber: index,","+      sharesWei: '1000000',","+      assetsWei: '1000000',","+      assetDecimals: 6,","+    },","+  ],","+});","+","+describe('readCachedVaultShareValuations', () => {","+  beforeEach(() => {","+    jest.clearAllMocks();","+  });","+","+  it('returns the cached entries for a valid document', async () => {","+    getStorageItemMock.mockResolvedValue({","+      version: 1,","+      entries: [entry(1)],","+    });","+","+    await expect(readCachedVaultShareValuations()).resolves.toStrictEqual([","+      entry(1),","+    ]);","+  });","+","+  it('returns an empty list when nothing is cached', async () => {","+    getStorageItemMock.mockResolvedValue(undefined);","+","+    await expect(readCachedVaultShareValuations()).resolves.toStrictEqual([]);","+  });","+","+  it('returns an empty list for a different document version', async () => {","+    getStorageItemMock.mockResolvedValue({ version: 2, entries: [entry(1)] });","+","+    await expect(readCachedVaultShareValuations()).resolves.toStrictEqual([]);","+  });","+","+  it('returns an empty list for a malformed document', async () => {","+    getStorageItemMock.mockResolvedValue({ version: 1, entries: [{}] });","+","+    await expect(readCachedVaultShareValuations()).resolves.toStrictEqual([]);","+  });","+","+  it('returns an empty list when a cached amount is not numeric', async () => {","+    getStorageItemMock.mockResolvedValue({","+      version: 1,","+      entries: [","+        {","+          ...entry(1),","+          valuations: [{ ...entry(1).valuations[0], sharesWei: 'abc' }],","+        },","+      ],","+    });","+","+    await expect(readCachedVaultShareValuations()).resolves.toStrictEqual([]);","+  });","+});","+","+describe('writeCachedVaultShareValuations', () => {","+  beforeEach(() => {","+    jest.clearAllMocks();","+    getStorageItemMock.mockResolvedValue(undefined);","+  });","+","+  it('writes a versioned document', async () => {","+    await writeCachedVaultShareValuations([entry(1)]);","+","+    expect(setStorageItemMock).toHaveBeenLastCalledWith(","+      'money.activity.vault-share-valuations.v1',","+      { version: 1, entries: [entry(1)] },","+    );","+  });","+","+  it('merges with the entries already stored', async () => {","+    getStorageItemMock.mockResolvedValue({","+      version: 1,","+      entries: [entry(1)],","+    });","+","+    await writeCachedVaultShareValuations([entry(2)]);","+","+    expect(setStorageItemMock).toHaveBeenLastCalledWith(","+      'money.activity.vault-share-valuations.v1',","+      { version: 1, entries: [entry(2), entry(1)] },","+    );","+  });","+","+  it('caps the cache at the entry limit and keeps the newest activity', async () => {","+    const entries = Array.from(","+      { length: VAULT_SHARE_VALUATION_CACHE_LIMIT + 1 },","+      (_, index) => entry(index),","+    );","+","+    await writeCachedVaultShareValuations(entries);","+","+    expect(setStorageItemMock).toHaveBeenLastCalledWith(","+      'money.activity.vault-share-valuations.v1',","+      { version: 1, entries: [...entries.slice(1)].reverse() },","+    );","+  });","+});"],"additions":124,"deletions":0,"truncated":false},{"path":"shared/lib/money/vault-share-valuation-cache.ts","lines":["@@ -0,0 +1,86 @@","+import {","+  array,","+  define,","+  enums,","+  is,","+  literal,","+  number,","+  string,","+  type,","+} from '@metamask/superstruct';","+import { getStorageItem, setStorageItem } from '../storage-helpers';","+import {","+  entriesByIdentity,","+  type VaultShareValuationCacheEntry,","+} from './vault-share-valuations';","+","+const CACHE_VERSION = 1;","+const CACHE_KEY = `money.activity.vault-share-valuations.v${CACHE_VERSION}`;","+export const VAULT_SHARE_VALUATION_CACHE_LIMIT = 500;","+","+const DigitsStruct = define<string>(","+  'digits',","+  (value) => typeof value === 'string' && /^\\d+$/u.test(value),","+);","+","+const CachedValuationStruct = type({","+  type: enums(['transfer_in', 'transfer_out']),","+  blockNumber: number(),","+  sharesWei: DigitsStruct,","+  assetsWei: DigitsStruct,","+  assetDecimals: number(),","+});","+","+const CachedEntryStruct = type({","+  account: string(),","+  chainId: number(),","+  vaultAddress: string(),","+  txHash: string(),","+  valuations: array(CachedValuationStruct),","+});","+","+const CacheDocumentStruct = type({","+  version: literal(CACHE_VERSION),","+  entries: array(CachedEntryStruct),","+});","+","+export async function readCachedVaultShareValuations(): Promise<","+  VaultShareValuationCacheEntry[]","+> {","+  const parsed = await getStorageItem<unknown>(CACHE_KEY);","+  return is(parsed, CacheDocumentStruct) ? parsed.entries : [];","+}","+","+function latestBlockNumber(entry: VaultShareValuationCacheEntry): number {","+  return entry.valuations.reduce(","+    (latest, valuation) => Math.max(latest, valuation.blockNumber),","+    0,","+  );","+}","+","+function mergeEntries(","+  current: readonly VaultShareValuationCacheEntry[],","+  incoming: readonly VaultShareValuationCacheEntry[],","+): VaultShareValuationCacheEntry[] {","+  return [...entriesByIdentity([...current, ...incoming]).values()]","+    .sort((left, right) => latestBlockNumber(right) - latestBlockNumber(left))","+    .slice(0, VAULT_SHARE_VALUATION_CACHE_LIMIT);","+}","+","+let writeQueue = Promise.resolve();","+","+export function writeCachedVaultShareValuations(","+  entries: readonly VaultShareValuationCacheEntry[],","+): Promise<void> {","+  const write = writeQueue","+    .then(async () => {","+      const current = await readCachedVaultShareValuations();","+      await setStorageItem(CACHE_KEY, {","+        version: CACHE_VERSION,","+        entries: mergeEntries(current, entries),","+      });","+    })","+    .catch(() => undefined);","+  writeQueue = write;","+  return write;","+}"],"additions":86,"deletions":0,"truncated":false},{"path":"shared/lib/money/vault-share-valuations.test.ts","lines":["@@ -0,0 +1,162 @@","+/* eslint-disable @typescript-eslint/naming-convention -- API response fixtures use snake_case */","+import type {","+  VaultShareValuation,","+  VaultShareValuationsResponse,","+} from '@metamask/money-account-api-data-service';","+import {","+  cacheEntriesFromResponse,","+  entriesByIdentity,","+  getVaultShareValuationCacheIdentity,","+  getVaultShareVaultKey,","+  toCachedVaultShareValuation,","+  type VaultShareValuationCacheEntry,","+} from './vault-share-valuations';","+","+const ACCOUNT = '0xbF4bC559f929cE3994Ba12D71d564737357bC8C2';","+const VAULT = '0xb4563bcD3B7764CCBf497f515585f70B6C3EA5Ae';","+const TX_HASH =","+  '0x2b45bda071d8feff265c541e251a5e035e5f55270f8ad288dcd80f6740793847';","+","+const valuation: VaultShareValuation = {","+  vault_address: VAULT,","+  vault_key: 'standard',","+  asset_symbol: 'mUSD',","+  asset_decimals: 6,","+  type: 'transfer_out',","+  log_index: 3,","+  block_number: 123456,","+  timestamp: '2026-06-04T11:53:51.000Z',","+  shares_wei: '951755696',","+  assets_wei: '968399999',","+  rate: '1.017488',","+  source: 'cash_flows',","+};","+","+const response = {","+  address: ACCOUNT,","+  chain_id: 143,","+  results: [{ tx_hash: TX_HASH, found: true, valuations: [valuation] }],","+  as_of_block: 123457,","+  as_of_timestamp: '2026-06-04T11:54:00.000Z',","+  data_freshness: 'live',","+  indexer_lag_seconds: 0,","+} satisfies VaultShareValuationsResponse;","+","+describe('toCachedVaultShareValuation', () => {","+  it('keeps a valid mUSD valuation', () => {","+    expect(toCachedVaultShareValuation(valuation)).toStrictEqual({","+      type: 'transfer_out',","+      blockNumber: 123456,","+      sharesWei: '951755696',","+      assetsWei: '968399999',","+      assetDecimals: 6,","+    });","+  });","+","+  // @ts-expect-error This is missing from the Mocha type definitions","+  it.each([","+    ['a non-mUSD asset', { asset_symbol: 'vmUSD' }],","+    ['an unknown transfer type', { type: 'transfer' }],","+    ['a missing block number', { block_number: null }],","+    ['a fractional block number', { block_number: 1.5 }],","+    ['negative decimals', { asset_decimals: -1 }],","+    ['fractional shares', { shares_wei: '1.5' }],","+    ['missing shares', { shares_wei: null }],","+    ['non-numeric assets', { assets_wei: 'abc' }],","+  ])('rejects %s', (_case: string, overrides: Partial<VaultShareValuation>) => {","+    expect(","+      toCachedVaultShareValuation({ ...valuation, ...overrides }),","+    ).toBeUndefined();","+  });","+});","+","+describe('cacheEntriesFromResponse', () => {","+  it('builds one entry per account, chain, vault, and transaction', () => {","+    expect(","+      cacheEntriesFromResponse({","+        response,","+        account: ACCOUNT,","+        chainId: '0x8f',","+        vaultAddresses: [VAULT],","+      }),","+    ).toStrictEqual([","+      {","+        account: ACCOUNT.toLowerCase(),","+        chainId: 143,","+        vaultAddress: VAULT.toLowerCase(),","+        txHash: TX_HASH.toLowerCase(),","+        valuations: [","+          {","+            type: 'transfer_out',","+            blockNumber: 123456,","+            sharesWei: '951755696',","+            assetsWei: '968399999',","+            assetDecimals: 6,","+          },","+        ],","+      },","+    ]);","+  });","+","+  it('ignores a response for another chain', () => {","+    expect(","+      cacheEntriesFromResponse({","+        response: { ...response, chain_id: 1 },","+        account: ACCOUNT,","+        chainId: '0x8f',","+        vaultAddresses: [VAULT],","+      }),","+    ).toStrictEqual([]);","+  });","+","+  it('ignores unknown vaults, missing results, and malformed hashes', () => {","+    expect(","+      cacheEntriesFromResponse({","+        response: {","+          ...response,","+          results: [","+            { ...response.results[0], found: false },","+            { ...response.results[0], tx_hash: '0x1234' },","+            {","+              ...response.results[0],","+              valuations: [{ ...valuation, vault_address: ACCOUNT }],","+            },","+          ],","+        },","+        account: ACCOUNT,","+        chainId: '0x8f',","+        vaultAddresses: [VAULT],","+      }),","+    ).toStrictEqual([]);","+  });","+});","+","+describe('cache identities', () => {","+  const entry: VaultShareValuationCacheEntry = {","+    account: ACCOUNT,","+    chainId: 143,","+    vaultAddress: VAULT,","+    txHash: TX_HASH,","+    valuations: [],","+  };","+","+  it('lowercases every address in the identity', () => {","+    expect(getVaultShareValuationCacheIdentity(entry)).toBe(","+      `${ACCOUNT.toLowerCase()}:143:${VAULT.toLowerCase()}:${TX_HASH.toLowerCase()}`,","+    );","+  });","+","+  it('indexes entries by identity', () => {","+    expect(","+      entriesByIdentity([entry]).get(","+        getVaultShareValuationCacheIdentity(entry),","+      ),","+    ).toBe(entry);","+  });","+","+  it('builds a vault key from the chain and vault address', () => {","+    expect(getVaultShareVaultKey('0x8F', VAULT)).toBe(","+      `0x8f:${VAULT.toLowerCase()}`,","+    );","+  });","+});"],"additions":162,"deletions":0,"truncated":false},{"path":"shared/lib/money/vault-share-valuations.ts","lines":["@@ -0,0 +1,134 @@","+import type {","+  VaultShareValuation,","+  VaultShareValuationsResponse,","+} from '@metamask/money-account-api-data-service';","+import { hexToNumber, type Hex } from '@metamask/utils';","+import { isEqualCaseInsensitive } from '../string-utils';","+","+const AMOUNT_PATTERN = /^\\d+$/u;","+const TX_HASH_PATTERN = /^0x[0-9a-f]{64}$/iu;","+","+export type VaultShareToken = {","+  chainId: Hex;","+  address: Hex;","+};","+","+export type CachedVaultShareValuation = {","+  type: 'transfer_in' | 'transfer_out';","+  blockNumber: number;","+  sharesWei: string;","+  assetsWei: string;","+  assetDecimals: number;","+};","+","+export type VaultShareValuationCacheKey = {","+  account: string;","+  chainId: number;","+  vaultAddress: string;","+  txHash: string;","+};","+","+export type VaultShareValuationCacheEntry = {","+  valuations: CachedVaultShareValuation[];","+} & VaultShareValuationCacheKey;","+","+export function getVaultShareValuationCacheIdentity(","+  key: VaultShareValuationCacheKey,","+): string {","+  return [","+    key.account.toLowerCase(),","+    key.chainId,","+    key.vaultAddress.toLowerCase(),","+    key.txHash.toLowerCase(),","+  ].join(':');","+}","+","+export function entriesByIdentity(","+  entries: readonly VaultShareValuationCacheEntry[],","+): Map<string, VaultShareValuationCacheEntry> {","+  return new Map(","+    entries.map((entry) => [getVaultShareValuationCacheIdentity(entry), entry]),","+  );","+}","+","+export function getVaultShareVaultKey(","+  chainId: Hex,","+  vaultAddress: string,","+): string {","+  return `${chainId.toLowerCase()}:${vaultAddress.toLowerCase()}`;","+}","+","+export function toCachedVaultShareValuation(","+  valuation: VaultShareValuation,","+): CachedVaultShareValuation | undefined {","+  if (","+    valuation.asset_symbol !== 'mUSD' ||","+    (valuation.type !== 'transfer_in' && valuation.type !== 'transfer_out') ||","+    typeof valuation.block_number !== 'number' ||","+    !Number.isInteger(valuation.block_number) ||","+    valuation.block_number < 0 ||","+    !Number.isInteger(valuation.asset_decimals) ||","+    valuation.asset_decimals < 0 ||","+    typeof valuation.shares_wei !== 'string' ||","+    !AMOUNT_PATTERN.test(valuation.shares_wei) ||","+    !AMOUNT_PATTERN.test(valuation.assets_wei)","+  ) {","+    return undefined;","+  }","+","+  return {","+    type: valuation.type,","+    blockNumber: valuation.block_number,","+    sharesWei: valuation.shares_wei,","+    assetsWei: valuation.assets_wei,","+    assetDecimals: valuation.asset_decimals,","+  };","+}","+","+export function cacheEntriesFromResponse({","+  response,","+  account,","+  chainId,","+  vaultAddresses,","+}: {","+  response: VaultShareValuationsResponse;","+  account: string;","+  chainId: Hex;","+  vaultAddresses: readonly Hex[];","+}): VaultShareValuationCacheEntry[] {","+  const numericChainId = hexToNumber(chainId);","+  if (response.chain_id !== numericChainId) {","+    return [];","+  }","+","+  const entries = new Map<string, VaultShareValuationCacheEntry>();","+","+  for (const result of response.results) {","+    if (!result.found || !TX_HASH_PATTERN.test(result.tx_hash)) {","+      continue;","+    }","+","+    for (const valuation of result.valuations) {","+      const cached = toCachedVaultShareValuation(valuation);","+      const vaultAddress = vaultAddresses.find((address) =>","+        isEqualCaseInsensitive(address, valuation.vault_address),","+      );","+      if (!cached || !vaultAddress) {","+        continue;","+      }","+","+      const key: VaultShareValuationCacheKey = {","+        account: account.toLowerCase(),","+        chainId: numericChainId,","+        vaultAddress: vaultAddress.toLowerCase(),","+        txHash: result.tx_hash.toLowerCase(),","+      };","+      const identity = getVaultShareValuationCacheIdentity(key);","+      const entry = entries.get(identity) ?? { ...key, valuations: [] };","+      entry.valuations.push(cached);","+      entries.set(identity, entry);","+    }","+  }","+","+  return [...entries.values()];","+}"],"additions":134,"deletions":0,"truncated":false},{"path":"shared/lib/trace.ts","lines":["@@ -123,6 +123,9 @@ export enum TraceName {","   MusdConversionConfirm = 'mUSD Conversion Confirm',","   BatchSellModal = 'Batch Sell Modal',","   StatePersist = 'State Persist',","+  // Money","+  MoneyActivityVaultShareValuationsFetch = 'Money Activity Vault Share Valuations Fetch',","+  MoneyActivityValuationsReady = 'Money Activity Valuations Ready',","   // Perps","   PerpsOpenPosition = 'Perps Open Position',","   PerpsClosePosition = 'Perps Close Position',","@@ -190,6 +193,8 @@ export enum TraceOperation {","   StateWrite = 'state.write',","   BridgeScreenPerformance = 'bridge.screen.performance',","   BridgeDataFetch = 'bridge.data_fetch',","+  // Money","+  MoneyAccountDataFetch = 'money.account.data_fetch',","   // Perps","   PerpsOperation = 'perps.operation',"," }"],"additions":5,"deletions":0,"truncated":false},{"path":"test/e2e/feature-flags/feature-flag-registry.ts","lines":["@@ -3573,6 +3573,17 @@ export const FEATURE_FLAG_REGISTRY: Record<string, FeatureFlagRegistryEntry> = {","     type: FeatureFlagType.Remote,","   },"," ","+  moneyEnableHistoricalVaultShareValuations: {","+    inProd: false,","+    name: 'moneyEnableHistoricalVaultShareValuations',","+    productionDefault: {","+      enabled: false,","+      minimumVersion: '0.0.0',","+    },","+    status: FeatureFlagStatus.Active,","+    type: FeatureFlagType.Remote,","+  },","+","   moneyEnableMoneyAccount: {","     inProd: true,","     name: 'moneyEnableMoneyAccount',"],"additions":11,"deletions":0,"truncated":false},{"path":"ui/hooks/money/use-money-account-api-activity.integration.test.tsx","lines":["@@ -2,10 +2,17 @@ import React from 'react';"," import { renderHook, waitFor } from '@testing-library/react';"," import { QueryClient, QueryClientProvider } from '@tanstack/react-query';"," import { apiClient } from '../../helpers/api-client';","-import { selectMoneyActivityMockData