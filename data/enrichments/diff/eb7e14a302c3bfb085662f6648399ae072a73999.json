le implements IAgent {"," \t\t\t\tclient,"," \t\t\t\tsessionId: sdkSessionId,"," \t\t\t\tisEphemeral: provisional.isEphemeral,","+\t\t\t\thasScopedEditSurface: provisional.hasScopedEditSurface,"," \t\t\t\tworkingDirectory,"," \t\t\t\tadditionalDirectories: this._additionalCustomizationDirectories(resolvedWorkingDirectories),"," \t\t\t\tresolvedAgentName: resolvedAgent?.name,"],"additions":4,"deletions":0,"truncated":false},{"path":"src/vs/platform/agentHost/node/copilot/copilotAgentSession.ts","lines":["@@ -3283,8 +3283,10 @@ export class CopilotAgentSession extends Disposable {"," \t\t\t// (`requestSandboxBypass`) are an elevation of privilege and must"," \t\t\t// fall through to the normal confirmation flow — otherwise enabling"," \t\t\t// `sandbox.allowBypass` would let the model escape the sandbox with no","-\t\t\t// prompt at all.","-\t\t\tif (!managedApprovalRequired && isShellRequest && !requestSandboxBypass && await this._isShellSandboxedByDefault()) {","+\t\t\t// prompt at all. A file-scoped surface (editor inline chat) is","+\t\t\t// likewise excluded: the sandbox contains a command to the workspace,","+\t\t\t// not to that surface's one file, so it can still edit other files.","+\t\t\tif (!managedApprovalRequired && !this._launchPlan.hasScopedEditSurface && isShellRequest && !requestSandboxBypass && await this._isShellSandboxedByDefault()) {"," \t\t\t\t// Session may have been disposed while we awaited the engine"," \t\t\t\t// check; if so the deferred has already been settled and"," \t\t\t\t// removed, so leave it alone."],"additions":4,"deletions":2,"truncated":false},{"path":"src/vs/platform/agentHost/node/copilot/copilotSessionLauncher.ts","lines":["@@ -213,6 +213,12 @@ interface ICopilotSessionLaunchBase {"," \treadonly sessionId: string;"," \t/** Whether this launch is for a transient session that skips durable-only provider work. */"," \treadonly isEphemeral?: boolean;","+\t/**","+\t * Whether the owning chat surface is scoped to editing a single file, so","+\t * blanket shell auto-approvals must not apply. See","+\t * {@link IAgentCreateChatOptions.hasScopedEditSurface}.","+\t */","+\treadonly hasScopedEditSurface?: boolean;"," \treadonly workingDirectory: URI | undefined;"," \t/**"," \t * The additional working directories beyond the primary process root"],"additions":6,"deletions":0,"truncated":false},{"path":"src/vs/platform/agentHost/node/sessionPermissions.ts","lines":["@@ -273,6 +273,34 @@ export class SessionPermissionManager extends Disposable {"," \t\t\treturn ToolCallConfirmationReason.Setting;"," \t\t}"," ","+\t\t// 3.5 Surface edit scope. A session created by a file-bound surface","+\t\t// (editor inline chat) is scoped to the one document it was invoked on.","+\t\t// The user opened chat *on* that file, so reading and writing it needs no","+\t\t// further consent even when it sits outside the working directory. Every","+\t\t// other write -- and every shell command, which can write anywhere and","+\t\t// carries no inspectable destination -- falls through to a confirmation","+\t\t// prompt. Reads of other files keep the normal rules below so routine","+\t\t// context gathering stays silent.","+\t\t//","+\t\t// This runs after the explicit opt-ins above: a user who turned on","+\t\t// global or session auto-approve asked for that everywhere, and inline","+\t\t// chat does not override it.","+\t\tconst surfaceScope = this._getSurfaceEditScope(sessionKey);","+\t\tif (surfaceScope) {","+\t\t\tif ((e.permissionKind === 'write' || e.permissionKind === 'read')","+\t\t\t\t&& e.permissionPath","+\t\t\t\t&& surfaceScope.target","+\t\t\t\t&& extUriBiasedIgnorePathCase.isEqual(URI.file(e.permissionPath), surfaceScope.target)","+\t\t\t) {","+\t\t\t\tthis._logService.trace(`[SessionPermissionManager] Auto-approving in-scope surface ${e.permissionKind} of ${e.permissionPath}`);","+\t\t\t\treturn ToolCallConfirmationReason.NotNeeded;","+\t\t\t}","+\t\t\tif (e.permissionKind === 'write' || e.permissionKind === 'shell') {","+\t\t\t\tthis._logService.trace(`[SessionPermissionManager] Requiring confirmation for out-of-scope surface ${e.permissionKind}`);","+\t\t\t\treturn undefined;","+\t\t\t}","+\t\t}","+"," \t\t// 4. Read auto-approval"," \t\tif (e.permissionKind === 'read' && e.permissionPath) {"," \t\t\tconst sessionUri = URI.parse(isAhpChatChannel(sessionKey) ? parseRequiredSessionUriFromChatUri(sessionKey) : sessionKey);","@@ -325,6 +353,31 @@ export class SessionPermissionManager extends Disposable {"," \t\treturn undefined;"," \t}"," ","+\t/**","+\t * The edit scope of a session created by a file-bound chat surface, or","+\t * `undefined` for surfaces that are not file-bound.","+\t *","+\t * Returning a scope whose `target` is `undefined` is deliberate and fails","+\t * closed: an inline-chat session that did not record a usable target must","+\t * not fall back to unscoped editing, so no write auto-approves for it.","+\t */","+\tprivate _getSurfaceEditScope(sessionKey: ProtocolURI): { readonly target: URI | undefined } | undefined {","+\t\tconst session = isAhpChatChannel(sessionKey) ? parseRequiredSessionUriFromChatUri(sessionKey) : sessionKey;","+\t\tconst surface = this._stateManager.getSessionSurfaceMeta(session);","+\t\tif (surface?.surface !== 'editorInline') {","+\t\t\treturn undefined;","+\t\t}","+\t\tif (surface.targetUri === undefined) {","+\t\t\treturn { target: undefined };","+\t\t}","+\t\ttry {","+\t\t\treturn { target: URI.parse(surface.targetUri) };","+\t\t} catch {","+\t\t\tthis._logService.warn(`[SessionPermissionManager] Ignoring malformed inline chat target ${surface.targetUri}`);","+\t\t\treturn { target: undefined };","+\t\t}","+\t}","+"," \t/**"," \t * Whether a write targets a file under the session attachments directory. Those files are"," \t * host-created **read-only snapshots** of client/derived content (pasted text/images, unsaved"],"additions":53,"deletions":0,"truncated":false},{"path":"src/vs/platform/agentHost/test/common/agentMetaRead