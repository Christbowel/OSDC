{"id":"81d307065dc21ccdfca83e697468489dcd2caa29","axis":"silent","repo":"payloadcms/payload","sha":"81d307065dc21ccdfca83e697468489dcd2caa29","parsed":{"files":[{"path":"packages/codemod/README.md","lines":["@@ -84,6 +84,7 @@ The tool loads your project via [ts-morph](https://ts-morph.com/), using your `t"," "," - `migrate-list-view-select-api`: Removes `admin.enableListViewSelectAPI` from Collection Configs. The List View's Select API is the default in v4."," - `migrate-disabled-fields`: migrates `field.admin.disableListColumn`, `disableListFilter`, `disableGroupBy`, `disableBulkEdit` and their equivalents on `imageSize.admin` into the consolidated `disabled` object form.","+- `migrate-displayed-field-value-args`: converts direct `getDisplayedFieldValue(cellData, field, i18n)` calls imported from `@payloadcms/ui/utilities/getDisplayedFieldValue` to the object argument form. Handles named, aliased, and namespace imports. Indirect references and unsupported argument shapes are reported for manual migration."," - `globals-components-edit`: Globals: rename `admin.components.elements` to `admin.components.edit` and hoist `Description` to top-level `admin.components.Description` to match Collection conventions."," - `migrate-force-select`: migrates `forceSelect: { ... }` on Collection/Global configs to a `select` function that augments the caller's `select` when present and returns `undefined` (preserving full-document reads) when not. Shallow values become a spread (`{ ...select, ... }`); nested values use `deepMergeSimple` from `payload/shared` (auto-imported) to preserve the previous deep-merge semantics. Non-literal values, sibling `select` already present, and unsupported member kinds are surfaced as notes for manual review."," - `migrate-field-component-types`: replaces field component aliases—including concrete fields, canonical generics, labels, descriptions, errors, diffs, and block row labels—with the corresponding props types wrapped in `React.FC`. Generic arguments are preserved. Explicit class components, re-exports, namespace references, and inline imports are left unchanged with notes for manual migration."],"additions":1,"deletions":0,"truncated":false},{"path":"packages/codemod/src/registry.ts","lines":["@@ -12,6 +12,7 @@ import { migrateBlockReferencesToBlocks } from './transforms/migrate-block-refer"," import { migrateBuildScript } from './transforms/migrate-build-script/index.js'"," import { migrateDbTypesSubpath } from './transforms/migrate-db-types-subpath/index.js'"," import { migrateDisabledFields } from './transforms/migrate-disabled-fields/index.js'","+import { migrateDisplayedFieldValueArgs } from './transforms/migrate-displayed-field-value-args/index.js'"," import { migrateDocumentTitleContext } from './transforms/migrate-document-title-context/index.js'"," import { migrateFieldComponentTypes } from './transforms/migrate-field-component-types/index.js'"," import { migrateForceSelect } from './transforms/migrate-force-select/index.js'","@@ -44,6 +45,7 @@ export const transforms: Transform[] = [","   globalsComponentsEdit,","   migrateListViewSelectAPI,","   migrateDisabledFields,","+  migrateDisplayedFieldValueArgs,","   migrateForceSelect,","   migrateFieldComponentTypes,","   renameDiffValueProps,"],"additions":2,"deletions":0,"truncated":false},{"path":"packages/codemod/src/transforms/migrate-displayed-field-value-args/basic.input.ts","lines":["@@ -0,0 +1,3 @@","+import { getDisplayedFieldValue as display } from '@payloadcms/ui/utilities/getDisplayedFieldValue'","+","+const result = display(fileSize, field, i18n)"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/codemod/src/transforms/migrate-displayed-field-value-args/basic.output.ts","lines":["@@ -0,0 +1,3 @@","+import { getDisplayedFieldValue as display } from '@payloadcms/ui/utilities/getDisplayedFieldValue'","+","+const result = display({ cellData: fileSize, field: field, i18n: i18n })"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/codemod/src/transforms/migrate-displayed-field-value-args/index.spec.ts","lines":["@@ -0,0 +1,62 @@","+import { readFile } from 'node:fs/promises'","+import { dirname, join } from 'node:path'","+import { fileURLToPath } from 'node:url'","+import { Project } from 'ts-morph'","+import { describe, expect, it } from 'vitest'","+","+import { runTransform } from '../../utils/test-helpers.js'","+import { migrateDisplayedFieldValueArgs } from './index.js'","+","+const here = dirname(fileURLToPath(import.meta.url))","+const fixture = (name: string) => readFile(join(here, name), 'utf8')","+","+describe('migrate-displayed-field-value-args', () => {","+  it('should migrate an aliased named import', async () => {","+    const input = await fixture('basic.input.ts')","+    const output = await fixture('basic.output.ts')","+","+    expect(await runTransform({ source: input, transform: migrateDisplayedFieldValueArgs })).toBe(","+      output,","+    )","+  })","+","+  it('should migrate a namespace import', async () => {","+    const input = await fixture('namespace.input.ts')","+    const output = await fixture('namespace.output.ts')","+","+    expect(await runTransform({ source: input, transform: migrateDisplayedFieldValueArgs })).toBe(","+      output,","+    )","+  })","+","+  it('should be idempotent', async () => {","+    const output = await fixture('basic.output.ts')","+","+    expect(await runTransform({ source: output, transform: migrateDisplayedFieldValueArgs })).toBe(","+      output,","+    )","+  })","+","+  it('should leave unrelated imports unchanged', async () => {","+    const input = await fixture('no-match.input.ts')","+    const output = await fixture('no-match.output.ts')","+","+    expect(await runTransform({ source: input, transform: migrateDisplayedFieldValueArgs })).toBe(","+      output,","+    )","+  })","+","+  it('should report calls it cannot safely migrate', async () => {","+    const project = new Project({ useInMemoryFileSystem: true })","+    const file = project.createSourceFile(","+      '/fixture.ts',","+      \"import { getDisplayedFieldValue } from '@payloadcms/ui/utilities/getDisplayedFieldValue'\\ngetDisplayedFieldValue(...args)\\n\",","+    )","+","+    const result = await migrateDisplayedFieldValueArgs.apply({ packageJsons: [], project })","+","+    expect(result.filesChanged).toEqual([])","+    expect(result.notes).toEqual([expect.stringContaining('migrate manually')])","+    expect(file.getFullText()).toContain('getDisplayedFieldValue(...args)')","+  })","+})"],"additions":62,"deletions":0,"truncated":false},{"path":"packages/codemod/src/transforms/migrate-displayed-field-value-args/index.ts","lines":["@@ -0,0 +1,114 @@","+import type { CallExpression, Identifier } from 'ts-morph'","+","+import { Node } from 'ts-morph'","+","+import type { Transform } from '../../types.js'","+","+const moduleName = '@payloadcms/ui/utilities/getDisplayedFieldValue'","+const functionName = 'getDisplayedFieldValue'","+","+export const migrateDisplayedFieldValueArgs: Transform = {","+  name: 'migrate-displayed-field-value-args',","+  apply: ({ project }) => {","+    const filesChanged: string[] = []","+    const notes: string[] = []","+","+    for (const file of project.getSourceFiles()) {","+      const calls = new Set<CallExpression>()","+","+      for (const declaration of file.getImportDeclarations()) {","+        if (declaration.getModuleSpecifierValue() !== moduleName) {","+          continue","+        }","+","+        for (const specifier of declaration.getNamedImports()) {","+          if (specifier.getName() !== functionName || specifier.isTypeOnly()) {","+            continue","+          }","+","+          const localName = specifier.getAliasNode() ?? specifier.getNameNode()","+","+          if (Node.isIdentifier(localName)) {","+            collectCalls({ calls, localName, notes })","+          }","+        }","+","+        const namespace = declaration.getNamespaceImport()","+","+        if (namespace) {","+          collectCalls({ calls, isNamespace: true, localName: namespace, notes })","+        }","+      }","+","+      const original = file.getFullText()","+","+      for (const call of [...calls].sort((a, b) => b.getStart() - a.getStart())) {","+        const args = call.getArguments()","+","+        if (args.length === 1 && Node.isObjectLiteralExpression(args[0])) {","+          continue","+        }","+","+        if (args.length !== 3 || args.some(Node.isSpreadElement)) {","+          notes.push(","+            `${file.getFilePath()}:${call.getStartLineNumber()}: ${call.getText()} has unsupported arguments; migrate manually.`,","+          )","+          continue","+        }","+","+        call.replaceWithText(","+          `${call.getExpression().getText()}({ cellData: ${args[0]!.getText()}, field: ${args[1]!.getText()}, i18n: ${args[2]!.getText()} })`,","+        )","+      }","+","+      if (file.getFullText() !== original) {","+        filesChanged.push(file.getFilePath())","+      }","+    }","+","+    return { filesChanged, ...(notes.length > 0 ? { notes } : {}) }","+  },","+  description:","+    'Migrates `getDisplayedFieldValue(cellData, field, i18n)` calls imported from `@payloadcms/ui/utilities/getDisplayedFieldValue` to object arguments.',","+}","+","+function collectCalls({","+  calls,","+  isNamespace = false,","+  localName,","+  notes,","+}: {","+  calls: Set<CallExpression>","+  isNamespace?: boolean","+  localName: Identifier","+  notes: string[]","+}): void {","+  for (const reference of localName.findReferencesAsNodes()) {","+    if (reference === localName) {","+      continue","+    }","+","+    const parent = reference.getParent()","+    const expression = isNamespace","+      ? Node.isPropertyAccessExpression(parent) &&","+        parent.getExpression() === reference &&","+        parent.getName() === functionName","+        ? parent","+        : undefined","+      : reference","+","+    if (!expression) {","+      continue","+    }","+","+    const call = expression.getParent()","+","+    if (Node.isCallExpression(call) && call.getExpression() === expression) {","+      calls.add(call)","+    } else {","+      notes.push(","+        `${reference.getSourceFile().getFilePath()}:${reference.getStartLineNumber()}: ${expression.getText()} is referenced without a direct call; migrate manually.`,","+      )","+    }","+  }","+}"],"additions":114,"deletions":0,"truncated":false},{"path":"packages/codemod/src/transforms/migrate-displayed-field-value-args/namespace.input.ts","lines":["@@ -0,0 +1,3 @@","+import * as display from '@payloadcms/ui/utilities/getDisplayedFieldValue'","+","+const result = display.getDisplayedFieldValue(fileSize, field, i18n)"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/codemod/src/transforms/migrate-displayed-field-value-args/namespace.output.ts","lines":["@@ -0,0 +1,3 @@","+import * as display from '@payloadcms/ui/utilities/getDisplayedFieldValue'","+","+const result = display.getDisplayedFieldValue({ cellData: fileSize, field: field, i18n: i18n })"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/codemod/src/transforms/migrate-displayed-field-value-args/no-match.input.ts","lines":["@@ -0,0 +1,3 @@","+import { getDisplayedFieldValue } from './local-display.js'","+","+const result = getDisplayedFieldValue(fileSize, field, i18n)"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/codemod/src/transforms/migrate-displayed-field-value-args/no-match.output.ts","lines":["@@ -0,0 +1,3 @@","+import { getDisplayedFieldValue } from './local-display.js'","+","+const result = getDisplayedFieldValue(fileSize, field, i18n)"],"additions":3,"deletions":0,"truncated":false},{"path":"packages/payload/src/uploads/formatFilesize.spec.ts","lines":["@@ -0,0 +1,16 @@","+import { describe, expect, it } from 'vitest'","+","+import { formatFilesize } from './formatFilesize.js'","+","+describe('formatFilesize', () => {","+  it(