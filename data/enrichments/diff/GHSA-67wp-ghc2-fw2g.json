/src/Internal/HttpConnectionManager.cs","lines":["@@ -9,6 +9,7 @@"," using System.IO;"," using System.IO.Pipelines;"," using System.Net.WebSockets;","+using System.Security.Claims;"," using System.Security.Cryptography;"," using System.Threading;"," using System.Threading.Tasks;","@@ -75,13 +76,32 @@ public HttpConnectionContext CreateConnection()","         /// Creates a connection without Pipes setup to allow saving allocations until Pipes are needed.","         /// </summary>","         /// <returns></returns>","-        public HttpConnectionContext CreateConnection(PipeOptions transportPipeOptions, PipeOptions appPipeOptions)","+        public HttpConnectionContext CreateConnection(","+            PipeOptions transportPipeOptions,","+            PipeOptions appPipeOptions)","+        {","+            return CreateConnection(transportPipeOptions, appPipeOptions, negotiatedUser: null, hasNegotiatedUser: false);","+        }","+","+        internal HttpConnectionContext CreateConnection(","+            PipeOptions transportPipeOptions,","+            PipeOptions appPipeOptions,","+            ClaimsPrincipal negotiatedUser)","+        {","+            return CreateConnection(transportPipeOptions, appPipeOptions, negotiatedUser, hasNegotiatedUser: true);","+        }","+","+        private HttpConnectionContext CreateConnection(","+            PipeOptions transportPipeOptions,","+            PipeOptions appPipeOptions,","+            ClaimsPrincipal negotiatedUser,","+            bool hasNegotiatedUser)","         {","             var id = MakeNewConnectionId();"," ","             Log.CreatedNewConnection(_logger, id);","             var connectionTimer = HttpConnectionsEventSource.Log.ConnectionStart(id);","-            var connection = new HttpConnectionContext(id, _connectionLogger);","+            var connection = new HttpConnectionContext(id, _connectionLogger, negotiatedUser, hasNegotiatedUser);","             var pair = DuplexPipe.CreateConnectionPair(transportPipeOptions, appPipeOptions);","             connection.Transport = pair.Application;","             connection.Application = pair.Transport;"],"additions":22,"deletions":2,"truncated":false},{"path":"src/SignalR/common/Http.Connections/src/Internal/UserIdentitySnapshot.cs","lines":["@@ -0,0 +1,187 @@","+// Copyright (c) .NET Foundation. All rights reserved.","+// Licensed under the Apache License, Version 2.0. See License.txt in the project root for license information.","+","+using System;","+using System.Collections.Generic;","+using System.Security.Claims;","+","+namespace Microsoft.AspNetCore.Http.Connections.Internal","+{","+    internal sealed class UserIdentitySnapshot","+    {","+        private static readonly string[] _preferredClaimTypes =","+            new[] { \"sub\", ClaimTypes.NameIdentifier, ClaimTypes.Upn };","+","+        private readonly string _preferredClaimType;","+        private readonly string _preferredClaimValue;","+        private readonly string _preferredClaimIssuer;","+        private readonly string[] _allAuthenticatedClaims;","+        private readonly string _name;","+","+        private UserIdentitySnapshot(Claim preferredClaim)","+        {","+            _preferredClaimType = preferredClaim.Type;","+            _preferredClaimValue = preferredClaim.Value;","+            _preferredClaimIssuer = preferredClaim.Issuer;","+        }","+","+        private UserIdentitySnapshot(string[] allAuthenticatedClaims)","+        {","+            _allAuthenticatedClaims = allAuthenticatedClaims;","+        }","+","+        private UserIdentitySnapshot(string name)","+        {","+            _name = name;","+        }","+","+        public static UserIdentitySnapshot Capture(ClaimsPrincipal user)","+        {","+            if (user == null)","+            {","+                return null;","+            }","+","+            var preferredClaim = GetUserIdentityClaim(user);","+            if (preferredClaim != null)","+            {","+                return new UserIdentitySnapshot(preferredClaim);","+            }","+","+            ClaimsIdentity firstAuthenticatedIdentity = null;","+            List<Claim> authenticatedClaims = null;","+            foreach (var identity in user.Identities)","+            {","+                if (!identity.IsAuthenticated)","+                {","+                    continue;","+                }","+","+                if (firstAuthenticatedIdentity == null)","+                {","+                    firstAuthenticatedIdentity = identity;","+                }","+","+                foreach (var claim in identity.Claims)","+                {","+                    if (authenticatedClaims == null)","+                    {","+                        authenticatedClaims = new List<Claim>();","+                    }","+","+                    authenticatedClaims.Add(claim);","+                }","+            }","+","+            if (authenticatedClaims == null)","+            {","+                var name = firstAuthenticatedIdentity?.Name;","+                return string.IsNullOrEmpty(name) ? null : new UserIdentitySnapshot(name);","+            }","+","+            authenticatedClaims.Sort((a, b) =>","+            {","+                var result = string.CompareOrdinal(a.Type, b.Type);","+                if (result != 0)","+                {","+                    return result;","+                }","+","+                result = string.CompareOrdinal(a.Value, b.Value);","+                return result != 0 ? result : string.CompareOrdinal(a.Issuer, b.Issuer);","+            });","+","+            var parameters = new string[authenticatedClaims.Count * 3];","+            for (var i = 0; i < authenticatedClaims.Count; i++)","+            {","+                var claim = authenticatedClaims[i];","+                parameters[i * 3] = claim.Type;","+                parameters[(i * 3) + 1] = claim.Value;","+                parameters[(i * 3) + 2] = claim.Issuer;","+            }","+","+            return new UserIdentitySnapshot(parameters);","+        }","+","+        public static string GetUserIdentityValue(ClaimsPrincipal user)","+        {","+            if (user == null)","+            {","+                return null;","+            }","+","+            var claim = GetUserIdentityClaim(user);","+            return claim?.Value;","+        }","+","+        public static bool Matches(UserIdentitySnapshot current, UserIdentitySnapshot incoming)","+        {","+            if (current == null || incoming == null)","+            {","+                return current == null && incoming == null;","+            }","+","+            if (current._preferredClaimType != null || incoming._preferredClaimType != null)","+            {","+                return string.Equals(current._preferredClaimType, incoming._preferredClaimType, StringComparison.Ordinal)","+                    && string.Equals(current._preferredClaimValue, incoming._preferredClaimValue, StringComparison.Ordinal)","+                    && string.Equals(current._preferredClaimIssuer, incoming._preferredClaimIssuer, StringComparison.Ordinal);","+            }","+","+            if (current._allAuthenticatedClaims != null || incoming._allAuthenticatedClaims != null)","+            {","+                if (current._allAuthenticatedClaims == null","+                    || incoming._allAuthenticatedClaims == null","+                    || current._allAuthenticatedClaims.Length != incoming._allAuthenticatedClaims.Length)","+                {","+                    return false;","+                }","+","+                for (var i = 0; i < current._allAuthenticatedClaims.Length; i++)","+                {","+                    if (!string.Equals(current._allAuthenticatedClaims[i], incoming._allAuthenticatedClaims[i], StringComparison.Ordinal))","+                    {","+                        return false;","+                    }","+                }","+","+                return true;","+            }","+","+            var comparison = IsHttpUri(incoming._name)","+                ? StringComparison.Ordinal","+                : StringComparison.OrdinalIgnoreCase;","+            return string.Equals(current._name, incoming._name, comparison);","+        }","+","+        private static bool IsHttpUri(string value)","+        {","+            return value != null","+                && (value.StartsWith(\"http://\", StringComparison.OrdinalIgnoreCase)","+                    || value.StartsWith(\"https://\", StringComparison.OrdinalIgnoreCase));","+        }","+","+        private static Claim GetUserIdentityClaim(ClaimsPrincipal user)","+        {","+            foreach (var identity in user.Identities)","+            {","+                if (!identity.IsAuthenticated)","+                {","+                    continue;","+                }","+","+                foreach (var claimType in _preferredClaimTypes)","+                {","+                    var claim = identity.FindFirst(candidate =>","+                        string.Equals(candidate.Type, claimType, StringComparison.Ordinal));","+                    if (claim != null && !string.IsNullOrEmpty(claim.Value))","+                    {","+                        return claim;","+                    }","+                }","+            }","+","+            return null;","+        }","+    }","+}"],"additions":187,"deletions":0,"truncated":false},{"path":"src/SignalR/common/Http.Connections/test/HttpConnectionDispatcherTests.ConnectionBinding.cs","lines":["@@ -0,0 +1,554 @@","+// Copyright (c) .NET Foundation. All rights reserved.","+// Licensed under the Apache License, Version 2.0. See License.txt in the project root for license information.","+","+using System;","+using System.Buffers;","+using System.IO;","+using System.IO.Pipelines;","+using System.Security.Claims;","+using System.Security.Principal;","+using System.Text;","+using System.Threading.Tasks;","+using Microsoft.AspNetCore.Http.Connections.Internal;","+using Microsoft.AspNetCore.SignalR.Tests;","+using Microsoft.Extensions.Logging;","+using Newtonsoft.Json;","+using Newtonsoft.Json.Linq;","+using Xunit;","+","+namespace Microsoft.AspNetCore.Http.Connections.Tests","+{","+    public partial class HttpConnectionDispatcherTests","+    {","+        [Theory]","+        [InlineData(HttpTransportType.LongPolling)]","+        [InlineData(HttpTransportType.ServerSentEvents)]","+        [InlineData(HttpTransportType.WebSockets)]","+        public async Task NegotiatedConnectionRejectsDifferentUserOnFirstGet(HttpTransportType transportType)","+        {","+            await AssertFirstGetStatusAsync(","+                transportType,","+                MakeUser(\"alice\"),","+                MakeUser(\"mallory\"),","+                StatusCodes.Status403Forbidden);","+        }","+","+        [Theory]","+        [InlineData(HttpTransportType.LongPolling)]","+        [InlineData(HttpTransportType.ServerSentEvents)]","+        public async Task NegotiatedConnectionAllowsSameUserOnFirstGet(HttpTransportType transportType)","+        {","+            await AssertFirstGetStatusAsync(","+                transportType,","+                MakeUser(\"alice\"),","+                MakeUser(\"alice\"),","+                StatusCodes.Status200OK);","+        }","+","+        [Fact]","+        public async Task NegotiatedConnectionAllowsSameGenericIdentityUserOnFirstGet()","+        {","+            await AssertFirstGetStatusAsync(","+                HttpTransportType.LongPolling,","+                MakeGenericIdentityUser(\"alice\"),","+                MakeGenericIdentityUser(\"alice\"),","+                StatusCodes.Status200OK);","+        }","+","+        [Fact]","+        public async Task NegotiatedConnectionRejectsDifferentGenericIdentityUserOnFirstGet()","+        {","+            await AssertFirstGetStatusAsync(","+                HttpTransportType.LongPolling,","+                MakeGenericIdentityUser(\"alice\"),","+                MakeGenericIdentityUser(\"mallory\"),","+                StatusCodes.Status403Forbidden);","+        }","+","+        [Fact]","+        public async Task NegotiatedConnectionFallbackIgnoresAuthenticatedClaimOrdering()","+        {","+            var negotiated = new ClaimsPrincipal(new ClaimsIdentity(","+                new[] { new Claim(\"employeeId\", \"1\"), new Claim(\"department\", \"eng\") },","+                \"Test\"));","+            var connecting = new ClaimsPrincipal(new ClaimsIdentity(","+                new[] { new Claim(\"department\", \"eng\"), new Claim(\"employeeId\", \"1\") },","+                \"Test\"));","+","+            await AssertFirstGetStatusAsync(","+                HttpTransportType.LongPolling,","+                negotiated,","+                connecting,","+                StatusCodes.Status200OK);","+        }","+","+        [Fact]","+        public async Task NegotiatedConnectionRejectsAuthenticatedUserAfterAnonymousNegotiate()","+        {","+            await AssertFirstGetStatusAsync(","+                HttpTransportType.LongPolling,","+                new ClaimsPrincipal(new ClaimsIdentity()),","+                MakeUser(\"alice\"),","+                StatusCodes.Status403Forbidden);","+        }","+","+        [Fact]","+        public async Task NegotiatedConnectionAllowsSameUserSendBeforeFirstTransport()","+        {","+            using (StartVerifiableLog(out var loggerFactory, LogLevel.Debug))","+            {","+                var manager = CreateConnectionManager(loggerFactory);","+                var alice = MakeUser(\"alice\");","+                var connection = manager.CreateConnection(PipeOptions.Default, PipeOptions.Default, alice);","+                var dispatcher = new HttpConnectionDispatcher(manager, loggerFactory);","+                var context = MakeRequest(\"/foo\", connection);","+                context.Request.Method = HttpMethods.Post;","+                context.Request.Body = new MemoryStream(Encoding.UTF8.GetBytes(\"payload-before-first-transport\"));","+                context.User = alice;","+","+                await dispatcher.ExecuteAsync(","+                    context,","+                    new HttpConnectionDispatcherOptions(),","+                    _ => Task.CompletedTask).OrTimeout();","+","+                Assert.Equal(StatusCodes.Status200OK, context.Response.StatusCode);","+                Assert.True(connection.Transport.Input.TryRead(out var result));","+                Assert.Equal(","+                    \"payload-before-first-transport\",","+                    Encoding.UTF8.GetString(result.Buffer.ToArray()));","+                connection.Transport.Input.AdvanceTo(result.Buffer.End);","+                Assert.Equal(HttpTransportType.None, connection.TransportType);","+                Assert.True(connection.HasNegotiatedUser);","+                Assert.Null(connection.User);","+            }","+        }","+","+        [Fact]","+        public async Task NegotiatedConnectionRejectsDifferentUserSendBeforeFirstTransport()","+        {","+            using (StartVerifiableLog(out var loggerFactory, LogLevel.Debug))","+            {","+                var manager = CreateConnectionManager(loggerFactory);","+                var alice = MakeUser(\"alice\");","+                var connection = manager.CreateConnection(PipeOptions.Default, PipeOptions.Default, alice);","+                var dispatcher = new HttpConnectionDispatcher(manager, loggerFactory);","+                var context = MakeRequest(\"/foo\", connection);","+                context.Request.Method = HttpMethods.Post;","+                context.Request.Body = new MemoryStream(Encoding.UTF8.GetBytes(\"payload-before-first-transport\"));","+                context.User = MakeUser(\"mallory\");","+","+                await dispatcher.ExecuteAsync(","+                    context,","+                    new HttpConnectionDispatcherOptions(),","+                    _ => Task.CompletedTask).OrTimeout();","+","+                Assert.Equal(StatusCodes.Status403Forbidden, context.Response.StatusCode);","+                Assert.False(connection.Transport.Input.TryRead(out var result));","+                Assert.Equal(HttpTransportType.None, connection.TransportType);","+                Assert.True(connection.HasNegotiatedUser);","+                Assert.Null(connection.User);","+            }","+        }","+","+        [Fact]","+        public async Task NegotiatedConnectionAllowsDifferentUserOnSubsequentLongPollingRequest()","+        {","+            using (StartVerifiableLog(out var loggerFactory, LogLevel.Debug))","+            {","+                var manager = CreateConnectionManager(loggerFactory);","+                var alice = MakeUser(\"alice\");","+                var mallory = MakeUser(\"mallory\");","+                var connection = manager.CreateConnection(PipeOptions.Default, PipeOptions.Default, alice);","+                var dispatcher = new HttpConnectionDispatcher(manager, loggerFactory);","+                var options = new HttpConnectionDispatcherOptions();","+                var applicationTcs = new TaskCompletionSource<object>(TaskCreationOptions.RunContinuationsAsynchronously);","+","+                try","+                {","+                    var firstContext = MakeRequest(\"/foo\", connection);","+                    firstContext.User = alice;","+","+                    await dispatcher.ExecuteAsync(","+                        firstContext,","+                        options,","+                        _ => applicationTcs.Task).OrTimeout();","+","+                    Assert.Equal(StatusCodes.Status200OK, firstContext.Response.StatusCode);","+                    Assert.Equal(HttpTransportType.LongPolling, connection.TransportType);","+                    Assert.False(connection.HasNegotiatedUser);","+                    Assert.Same(alice, connection.User);","+                    Assert.Equal(","+                        \"alice\",","+                        connection.User.FindFirst(ClaimTypes.NameIdentifier).Value);","+","+                    var laterContext = MakeRequest(\"/foo\", connection);","+                    laterContext.User = mallory;","+                    var pollTask = dispatcher.ExecuteAsync(","+                        laterContext,","+                        options,","+                        _ => applicationTcs.Task);","+","+                    await connection.Transport.Output","+                        .WriteAsync(Encoding.UTF8.GetBytes(\"payload-from-subsequent-long-poll\"))","+                        .AsTask()","+                        .OrTimeout();","+                    await pollTask.OrTimeout();","+","+                    Assert.Equal(StatusCodes.Status200OK, laterContext.Response.StatusCode);","+                    Assert.Equal(","+                        \"payload-from-subsequent-long-poll\",","+                        Encoding.UTF8.GetString(((MemoryStream)laterContext.Response.Body).ToArray()));","+                    Assert.False(connection.HasNegotiatedUser);","+                    Assert.Same(mallory, connection.User);","+                    Assert.Equal(","+                        \"mallory\",","+                        connection.User.FindFirst(ClaimTypes.NameIdentifier).Value);","+                }","+                finally","+                {","+                    applicationTcs.TrySetResult(null);","+                }","+            }","+        }","+","+        [Fact]","+        public async Task NegotiatedConnectionAllowsDifferentUserSendAfterFirstTransport()","+        {","+            using (StartVerifiableLog(out var loggerFactory, LogLevel.Debug))","+            {","+                var manager = CreateConnectionManager(loggerFactory);","+                var alice = MakeUser(\"alice\");","+                var connection = manager.CreateConnection(PipeOptions.Default, PipeOptions.Default, alice);","+                var dispatcher = new HttpConnectionDispatcher(manager, loggerFactory);","+                var options = new HttpConnectionDispatcherOptions();","+                var firstContext = MakeRequest(\"/foo\", connection);","+                firstContext.User = alice;","+","+                await dispatcher.ExecuteAsync(","+                    firstContext,","+                    options,","+                    _ => Task.CompletedTask).OrTimeout();","+","+                Assert.Equal(StatusCodes.Status200OK, firstContext.Response.StatusCode);","+                Assert.Equal(HttpTransportType.LongPolling, connection.TransportType);","+                Assert.False(connection.HasNegotiatedUser);","+                Assert.Same(alice, connection.User);","+                Assert.Equal(","+                    \"alice\",","+                    connection.User.FindFirst(ClaimTypes.NameIdentifier).Value);","+","+                var context = MakeRequest(\"/foo\", connection);","+                context.Request.Method = HttpMethods.Post;","+                context.Request.Body = new MemoryStream(Encoding.UTF8.GetBytes(\"payload-after-release\"));","+                context.User = MakeUser(\"mallory\");","+","+                await dispatcher.ExecuteAsync(","+                    context,","+                    options,","+                    _ => Task.CompletedTask).OrTimeout();","+","+                Assert.Equal(StatusCodes.Status200OK, context.Response.StatusCode);"],"additions":250,"deletions":0,"truncated":false}],"additions":571,"deletions":4,"truncated":true,"file_count":6},"error":null,"fetched_at":"2026-11-11T15:37:23.213581+00:00"}