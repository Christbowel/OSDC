neData(\"%zz+x\", \"%zz x\")]","+    [InlineData(\"%25\", \"%\")]","+    [InlineData(\"%2520\", \"%20\")]","+    public void DecodeToStringDecodesPlusAndPercentEncoding(string encoded, string expected)","+    {","+        Assert.Equal(expected, QueryStringDecoder.DecodeToString(encoded.AsMemory()));","+    }","+","+    [Theory]","+    [InlineData(\"value\")]","+    [InlineData(\"a+b\")]","+    [InlineData(\"a%20b\")]","+    [InlineData(\"a+%2B%20b%\")]","+    [InlineData(\"%C3%BC+%F0%9F%98%80\")]","+    public void DecodeToStringMatchesExistingDecode(string encoded)","+    {","+        var count = 0;","+        foreach (var pair in new QueryStringEnumerable(\"?\" + encoded + \"=\" + encoded))","+        {","+            Assert.Equal(pair.DecodeName().ToString(), QueryStringDecoder.DecodeToString(pair.EncodedName));","+            Assert.Equal(pair.DecodeValue().ToString(), QueryStringDecoder.DecodeToString(pair.EncodedValue));","+            count++;","+        }","+","+        Assert.Equal(1, count);","+    }","+","+    [Theory]","+    [InlineData(255)]","+    [InlineData(256)]","+    [InlineData(257)]","+    [InlineData(5000)]","+    public void DecodeToStringDecodesLongValues(int length)","+    {","+        var encoded = \"%2B\" + new string('+', length - 7) + \"a%20\";","+        var expected = \"+\" + new string(' ', length - 7) + \"a \";","+","+        Assert.Equal(length, encoded.Length);","+        Assert.Equal(expected, QueryStringDecoder.DecodeToString(encoded.AsMemory()));","+    }","+","+    [Fact]","+    public void DecodeToStringDecodesSliceOfLargerString()","+    {","+        var query = \"x=a+b%20c&y=1\";","+","+        Assert.Equal(\"a b c\", QueryStringDecoder.DecodeToString(query.AsMemory(2, 7)));","+    }","+","+    [Fact]","+    public void DecodeToMemoryReturnsInputWhenNothingToDecode()","+    {","+        var query = \"x=value&y=1\";","+        var encoded = query.AsMemory(2, 5);","+","+        var decoded = QueryStringDecoder.DecodeToMemory(encoded);","+","+        Assert.True(decoded.Equals(encoded));","+    }","+","+    [Theory]","+    [InlineData(\"a+b\", \"a b\")]","+    [InlineData(\"a%20b\", \"a b\")]","+    [InlineData(\"a+%2B+b\", \"a + b\")]","+    [InlineData(\"%C3%BC+%F0%9F%98%80\", \"\\u00FC \\U0001F600\")]","+    [InlineData(\"%zz+x\", \"%zz x\")]","+    public void DecodeToMemoryDecodesPlusAndPercentEncoding(string encoded, string expected)","+    {","+        Assert.Equal(expected, QueryStringDecoder.DecodeToMemory(encoded.AsMemory()).ToString());","+    }","+}"],"additions":96,"deletions":0,"truncated":false},{"path":"src/SignalR/clients/csharp/Http.Connections.Client/src/Microsoft.AspNetCore.Http.Connections.Client.csproj","lines":["@@ -20,6 +20,7 @@","     <Compile Include=\"$(SharedSourceRoot)ThrowHelpers\\ObjectDisposedThrowHelper.cs\" LinkBase=\"Shared\" />","     <Compile Include=\"$(SharedSourceRoot)CallerArgument\\CallerArgumentExpressionAttribute.cs\" LinkBase=\"Shared\" />","     <Compile Include=\"$(SharedSourceRoot)QueryStringEnumerable.cs\" LinkBase=\"Shared\" />","+    <Compile Include=\"$(SharedSourceRoot)QueryStringDecoder.cs\" LinkBase=\"Shared\" />","   </ItemGroup>"," ","   <ItemGroup>",""],"additions":1,"deletions":0,"truncated":false}],"additions":299,"deletions":27,"truncated":false,"file_count":14},"error":null,"fetched_at":"2026-11-12T17:14:44.697285+00:00"}