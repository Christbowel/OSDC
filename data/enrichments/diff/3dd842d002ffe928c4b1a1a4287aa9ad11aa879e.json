       return chars;","+        }","+","+        var buffer = new char[source.Length];","+        var written = Decode(source, buffer);","+        return buffer.AsMemory(0, written);","+#else","+        if (source.IndexOf('%') < 0 && source.IndexOf('+') < 0)","+        {","+            return chars;","+        }","+","+        return Uri.UnescapeDataString(chars.ToString().Replace('+', ' ')).AsMemory();","+#endif","+    }","+","+#if NET","+    private const int StackAllocThreshold = 256;","+","+    /// <summary>","+    /// Decodes an encoded query string name or value ('+' as space, then percent-decoding) directly into a string.","+    /// </summary>","+    public static string DecodeToString(ReadOnlyMemory<char> chars)","+    {","+        var source = chars.Span;","+        if (!source.ContainsAny('%', '+'))","+        {","+            return chars.ToString();","+        }","+","+        char[]? rented = null;","+        var buffer = source.Length <= StackAllocThreshold","+            ? stackalloc char[StackAllocThreshold]","+            : (rented = ArrayPool<char>.Shared.Rent(source.Length));","+","+        var written = Decode(source, buffer);","+        var result = new string(buffer[..written]);","+","+        if (rented is not null)","+        {","+            ArrayPool<char>.Shared.Return(rented);","+        }","+","+        return result;","+    }","+","+    /// <summary>","+    /// Decodes <paramref name=\"source\"/> ('+' as space, then percent-decoding) into <paramref name=\"destination\"/>,","+    /// which must be at least as long as <paramref name=\"source\"/>.","+    /// </summary>","+    /// <returns>The number of characters written to <paramref name=\"destination\"/>.</returns>","+    public static int Decode(ReadOnlySpan<char> source, Span<char> destination)","+    {","+        Debug.Assert(destination.Length >= source.Length);","+","+        source.Replace(destination, '+', ' ');","+        var success = Uri.TryUnescapeDataString(destination[..source.Length], destination, out var written);","+        Debug.Assert(success);","+        return written;","+    }","+#endif","+}"],"additions":85,"deletions":0,"truncated":false},{"path":"src/Shared/QueryStringEnumerable.cs","lines":["@@ -3,7 +3,6 @@"," "," using System;"," using System.Buffers;","-using System.Diagnostics;"," using System.Runtime.CompilerServices;"," using System.Runtime.InteropServices;"," #if NET","@@ -82,36 +81,14 @@ internal EncodedNameValuePair(ReadOnlyMemory<char> encodedName, ReadOnlyMemory<c","         /// </summary>","         /// <returns>Characters representing the decoded name.</returns>","         public ReadOnlyMemory<char> DecodeName()","-            => Decode(EncodedName);","+            => Microsoft.AspNetCore.Internal.QueryStringDecoder.DecodeToMemory(EncodedName);"," ","         /// <summary>","         /// Decodes the value from this name/value pair.","         /// </summary>","         /// <returns>Characters representing the decoded value.</returns>","         public ReadOnlyMemory<char> DecodeValue()","-            => Decode(EncodedValue);","-","-        private static ReadOnlyMemory<char> Decode(ReadOnlyMemory<char> chars)","-        {","-            ReadOnlySpan<char> source = chars.Span;","-#if NET","-            if (!source.ContainsAny('%', '+'))","-            {","-                return chars;","-            }","-            var buffer = new char[source.Length];","-            source.Replace(buffer, '+', ' ');","-            var success = Uri.TryUnescapeDataString(buffer, buffer, out var unescapedLength);","-            Debug.Assert(success);","-            return buffer.AsMemory(0, unescapedLength);","-#else","-            if (source.IndexOf('%') < 0 && source.IndexOf('+') < 0)","-            {","-                return chars;","-            }","-            return Uri.UnescapeDataString(chars.ToString().Replace('+', ' ')).AsMemory();","-#endif","-        }","+            => Microsoft.AspNetCore.Internal.QueryStringDeco