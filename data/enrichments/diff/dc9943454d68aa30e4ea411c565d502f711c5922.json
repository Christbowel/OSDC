 \"dc1\",","+\t\tNode:       \"node-1\",","+\t\tAddress:    \"127.0.0.1\",","+\t\tService: &structs.NodeService{","+\t\t\tID:      \"web-1\",","+\t\t\tService: \"web\",","+\t\t\tPorts:   ports,","+\t\t},","+\t}","+\tvar registerResp struct{}","+\trequire.NoError(t, msgpackrpc.CallWithCodec(codec, \"Catalog.Register\", &registerReq, &registerResp))","+","+\tt.Run(\"Catalog.ServiceNodes\", func(t *testing.T) {","+\t\treq := structs.ServiceSpecificRequest{Datacenter: \"dc1\", ServiceName: \"web\"}","+\t\tvar resp structs.IndexedServiceNodes","+\t\trequire.NoError(t, msgpackrpc.CallWithCodec(codec, \"Catalog.ServiceNodes\", &req, &resp))","+\t\trequire.Len(t, resp.ServiceNodes, 1)","+\t\trequire.Equal(t, 8080, resp.ServiceNodes[0].ServicePort)","+\t\trequire.Equal(t, ports, resp.ServiceNodes[0].ServicePorts)","+\t})","+","+\tt.Run(\"Catalog.NodeServices\", func(t *testing.T) {","+\t\treq := structs.NodeSpecificRequest{Datacenter: \"dc1\", Node: \"node-1\"}","+\t\tvar resp structs.IndexedNodeServices","+\t\trequire.NoError(t, msgpackrpc.CallWithCodec(codec, \"Catalog.NodeServices\", &req, &resp))","+\t\trequire.NotNil(t, resp.NodeServices)","+\t\trequire.Equal(t, 8080, resp.NodeServices.Services[\"web-1\"].Port)","+\t\trequire.Equal(t, ports, resp.NodeServices.Services[\"web-1\"].Ports)","+\t})","+","+\tt.Run(\"Catalog.NodeServiceList\", func(t *testing.T) {","+\t\treq := structs.NodeSpecificRequest{Datacenter: \"dc1\", Node: \"node-1\"}","+\t\tvar resp structs.IndexedNodeServiceList","+\t\trequire.NoError(t, msgpackrpc.CallWithCodec(codec, \"Catalog.NodeServiceList\", &req, &resp))","+\t\trequire.Len(t, resp.NodeServices.Services, 1)","+\t\trequire.Equal(t, 8080, resp.NodeServices.Services[0].Port)","+\t\trequire.Equal(t, ports, resp.NodeServices.Services[0].Ports)","+\t})","+","+\tt.Run(\"Health.ServiceNodes\", func(t *testing.T) {","+\t\treq := structs.ServiceSpecificRequest{Datacenter: \"dc1\", ServiceName: \"web\"}","+\t\tvar resp structs.IndexedCheckServiceNodes","