{"id":"dc9943454d68aa30e4ea411c565d502f711c5922","axis":"silent","repo":"hashicorp/consul","sha":"dc9943454d68aa30e4ea411c565d502f711c5922","parsed":{"files":[{"path":".changelog/23833.txt","lines":["@@ -0,0 +1,3 @@","+```release-note:bug","+catalog: Fix missing legacy scalar `Port` field in RPC and streaming subscription responses for multiport services. Older agents that cannot decode `NodeService.Ports` now correctly receive the default port value. The backfill logic is applied at RPC and subscription adapter boundaries via the shared multiport adapter so it is used consistently across `Catalog`, `Health`, `PreparedQuery`, and streaming subscription responses.","+```"],"additions":3,"deletions":0,"truncated":false},{"path":"agent/catalog_endpoint.go","lines":["@@ -413,19 +413,11 @@ func (s *HTTPHandlers) catalogServiceNodes(resp http.ResponseWriter, req *http.R"," \t\tout.ServiceNodes = make(structs.ServiceNodes, 0)"," \t}"," \tfor i, s := range out.ServiceNodes {","-\t\tvar clone = *s","-"," \t\tif s.ServiceTags == nil {","+\t\t\tclone := *s"," \t\t\tclone.ServiceTags = make([]string, 0)","+\t\t\tout.ServiceNodes[i] = &clone"," \t\t}","-","-\t\tif clone.ServicePort == 0 && len(clone.ServicePorts) > 0 {","-\t\t\t// Populate `port` with default port for backward compatibility","-\t\t\tclone.ServicePort = clone.ToNodeService().DefaultPort()","-\t\t}","-","-\t\tout.ServiceNodes[i] = &clone","-"," \t}"," \tmetrics.IncrCounterWithLabels([]string{\"client\", \"api\", \"success\", \"catalog_service_nodes\"}, 1,"," \t\ts.nodeMetricsLabels())"],"additions":2,"deletions":10,"truncated":false},{"path":"agent/consul/adapter/multiport_adapter.go","lines":["@@ -0,0 +1,32 @@","+// Copyright IBM Corp. 2024, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package adapter","+","+import \"github.com/hashicorp/consul/agent/structs\"","+","+// PopulateLegacyNodeServicePort sets the legacy scalar port from the default","+// named port. Older agents do not decode NodeService.Ports from RPC responses,","+// so the compatibility value must be populated before the response is sent.","+func PopulateLegacyNodeServicePort(service *structs.NodeService) {","+\tif service != nil && service.Port == 0 && len(service.Ports) > 0 {","+\t\tservice.Port = service.DefaultPort()","+\t}","+}","+","+// PopulateLegacyServiceNodePorts sets the legacy scalar port on service nodes.","+func PopulateLegacyServiceNodePorts(services structs.ServiceNodes) {","+\tfor _, service := range services {","+\t\tif service != nil && service.ServicePort == 0 && len(service.ServicePorts) > 0 {","+\t\t\tservice.ServicePort = service.ToNodeService().DefaultPort()","+\t\t}","+\t}","+}","+","+// PopulateLegacyCheckServiceNodePorts sets the legacy scalar port on the","+// services contained in check-service nodes.","+func PopulateLegacyCheckServiceNodePorts(nodes structs.CheckServiceNodes) {","+\tfor i := range nodes {","+\t\tPopulateLegacyNodeServicePort(nodes[i].Service)","+\t}","+}"],"additions":32,"deletions":0,"truncated":false},{"path":"agent/consul/adapter/multiport_adapter_test.go","lines":["@@ -0,0 +1,24 @@","+// Copyright IBM Corp. 2024, 2026","+// SPDX-License-Identifier: BUSL-1.1","+","+package adapter","+","+import (","+\t\"testing\"","+","+\t\"github.com/stretchr/testify/require\"","+","+\t\"github.com/hashicorp/consul/agent/structs\"","+)","+","+func TestPopulateLegacyNodeServicePort_PreservesExplicitPort(t *testing.T) {","+\tservice := &structs.NodeService{","+\t\tPort: 7000,","+\t\tPorts: structs.ServicePorts{","+\t\t\t{Name: \"http\", Port: 8080, Default: true},","+\t\t},","+\t}","+","+\tPopulateLegacyNodeServicePort(service)","+\trequire.Equal(t, 7000, service.Port)","+}"],"additions":24,"deletions":0,"truncated":false},{"path":"agent/consul/catalog_endpoint.go","lines":["@@ -10,18 +10,19 @@ import ("," \t\"strings\""," \t\"time\""," ","-\t\"github.com/hashicorp/go-metrics\"","-\t\"github.com/hashicorp/go-metrics/prometheus\""," \thashstructure_v2 \"github.com/mitchel