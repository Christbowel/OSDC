p\"","+\t\tif err = os.WriteFile(tmp, data, 0o644); err == nil {","+\t\t\terr = os.Rename(tmp, ds.path)","+\t\t}","+\t}","+\tif err != nil {","+\t\tds.logger.Error(fmt.Sprintf(\"leet: failed to save %s: %v\", ds.path, err))","+\t}","+}"],"additions":106,"deletions":0,"truncated":false},{"path":"core/internal/leet/model.go","lines":["@@ -64,9 +64,6 @@ type Model struct {"," \t// schemes, sidebar visibility, etc.)."," \tconfig *ConfigManager"," ","-\t// filters are the filters remembered for the wandb directory.","-\tfilters *dirFilters","-"," \tlogger *observability.CoreLogger"," }"," ","@@ -92,8 +89,8 @@ type ModelParams struct {"," //   - RunFile is empty + StartupModeSingleRunLatest → resolve the \"latest-run\""," //     symlink and start in single-run view."," //   - RunFile is empty + StartupModeWorkspaceLatest (default) → start in","-//     workspace view; the workspace will auto-select the latest run once","-//     the directory poll completes.","+//     workspace view; once the directory poll completes, the workspace","+//     selects the runs selected last time and the latest run if it is new."," func NewModel(params ModelParams) *Model {"," \tif params.Config == nil {"," \t\tparams.Config = NewConfigManager(leetConfigPath(), params.Logger)","@@ -114,14 +111,12 @@ func NewModel(params ModelParams) *Model {"," \t\tworkspace: NewWorkspace(params.WandbDir, params.Config, params.Logger),"," \t\thelp:      NewHelp(),"," \t\tconfig:    params.Config,","-\t\tfilters:   loadDirFilters(params.WandbDir, params.Logger),"," \t\tlogger:    params.Logger,"," \t}","-\tm.workspace.attachFilters(m.filters)"," "," \tif params.RunParams != nil {"," \t\tm.run = NewRun(params.RunParams, params.Config, params.Logger)","-\t\tm.run.attachFilters(m.filters)","+\t\tm.run.attachFilters(m.workspace.dirState)"," \t\tm.mode = viewModeRun"," \t}"," ","@@ -438,7 +433,7 @@ func (m *Model) enterRunView() tea.Cmd {"," \t}"," "," \tm.run = NewRun(&RunParams{RunFile: wandbFile}, m.config, m.log